                   "confirm", " ", "that", " ", "all", " ", "zero", " ", 
                    "roots", " ", "are", " ", "identified"}], 
                   "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
                  RowBox[{"If", "[", 
