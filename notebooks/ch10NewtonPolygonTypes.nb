Cell["getManipulatePlot", "Subsection",
 CellChangeTimes->{{3.9059565116628213`*^9, 
  3.90595651709348*^9}},ExpressionUUID->"cd55c158-628f-4d67-ba92-\
66fef12f1600"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"getManipulatePlot", "[", 
      RowBox[{"theF_", ",", "theK_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "wRules", ",", "zRules", ",", "polygonPoints", ",", "maxX", ",", 
         "maxY", ",", "hullIndexes", ",", "hullPoints", ",", "hullMin", ",", 
         "minPos", ",", " ", "lowLegFound", ",", "index", ",", "lowLegPoints",
          ",", "currentX", ",", "nextX", ",", "currentY", ",", "slope", ",", 
         "yIntercept", ",", "polygonPointsG", ",", "convexHullG", ",", 
         "hullPointsG", ",", "rotatedPoints", ",", "legArray", ",", 
         "currentLeg", ",", "legIndex", ",", "totalPts", ",", "colorArray", 
         ",", "finalLegIndexes", ",", "finalLegPoints", ",", "legIndexes", 
         ",", " ", "finalLegPointsG", ",", "lineG", " ", ",", " ", 
         "dashPlots", ",", "pData", ",", "pPoint", ",", "pSlope", ",", "theY",
          ",", "xStop", " ", ",", "subReturn", ",", "linePoints", ",", 
         "slopeLegendData", ",", "slopeColorData", ",", "thePlotLegend", ",", 
         "legendPlot", ",", "tableData", ",", "wCoef"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", "\[IndentingNewLine]", " ", 
        RowBox[{
        "requires", " ", "function", " ", "to", " ", "be", " ", 
         "normalized"}], "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]",
        "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"wCoef", "=", 
         RowBox[{
          RowBox[{"CoefficientRules", "[", 
           RowBox[{"theF", ",", "w", ",", "\"\<NegativeLexicographic\>\""}], 
           "]"}], "//", "N"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"tableData", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", 
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "}"}], "&"}], "/@", " ", 
          "wCoef"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", "\[IndentingNewLine]", " ", 
         RowBox[{
         "get", " ", "Newton", " ", "polygon", " ", "and", " ", "lower", " ", 
          "Newton", " ", "legs"}], "\[IndentingNewLine]", "*)"}], " ", 
        "\[IndentingNewLine]", 
        RowBox[{"wRules", "=", 
         RowBox[{"CoefficientRules", "[", 
          RowBox[{"theF", ",", "w", ",", "\"\<NegativeLexicographic\>\""}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"zRules", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"CoefficientRules", "[", 
            RowBox[{"#", ",", "z", ",", "\"\<NegativeLexicographic\>\""}], 
            "]"}], "&"}], "/@", " ", 
          RowBox[{"wRules", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "2"}], "]"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
          "for", " ", "each", " ", "coefficient", " ", "of", " ", "z"}], ",", 
          " ", 
          RowBox[{"save", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"power", " ", "of", " ", "w"}], ",", " ", 
             RowBox[{"power", " ", "of", " ", "z"}], ",", " ", 
             RowBox[{"coefficient", " ", "of", " ", "z"}]}], " ", "}"}], " ", 
           "in", " ", "polygonPoints"}]}], "\[IndentingNewLine]", "*)"}], " ",
         "\[IndentingNewLine]", 
        RowBox[{"polygonPoints", "=", 
         RowBox[{"MapThread", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"#1", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", "1"}], "]"}], "]"}], ",", 
              RowBox[{"#2", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", "1", ",", "1"}], "]"}], "]"}], ",", 
              RowBox[{"#2", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", "2"}], "]"}], "]"}]}], "}"}], "&"}], ",", 
           RowBox[{"{", 
            RowBox[{"wRules", ",", "zRules"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{"$getSegmentDataFlag", ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{
               RowBox[{"Style", "[", 
                RowBox[{
                "\"\<polygonPoints after MapThread: \>\"", ",", "Red"}], 
                "]"}], ",", 
               RowBox[{"polygonPoints", "//", "N"}]}], "]"}], ";"}]}], 
           "\[IndentingNewLine]", "]"}], ";"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"maxX", "=", 
         RowBox[{"Max", "@", 
          RowBox[{"polygonPoints", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "1"}], "]"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"maxY", "=", 
         RowBox[{"Max", "@", 
          RowBox[{"polygonPoints", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "2"}], "]"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"hullIndexes", "=", 
         RowBox[{"ConvexHull", "[", 
          RowBox[{"polygonPoints", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", 
             RowBox[{"{", 
              RowBox[{"1", ",", "2"}], "}"}]}], "]"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"hullPoints", "=", 
         RowBox[{"polygonPoints", "[", 
          RowBox[{"[", "hullIndexes", "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"polygonPointsG", "=", 
         RowBox[{"Graphics", "@", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"PointSize", "[", "0.01", "]"}], ",", "Black", ",", 
            RowBox[{"Point", "@", 
             RowBox[{"polygonPoints", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", 
                RowBox[{"{", 
                 RowBox[{"1", ",", "2"}], "}"}]}], "]"}], "]"}]}]}], 
           "}"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"convexHullG", "=", 
         RowBox[{"Graphics", "@", 
          RowBox[{"{", 
           RowBox[{"Line", "@", 
            RowBox[{"Append", "[", 
             RowBox[{
              RowBox[{"polygonPoints", "[", 
               RowBox[{"[", 
                RowBox[{"hullIndexes", ",", 
                 RowBox[{"{", 
                  RowBox[{"1", ",", "2"}], "}"}]}], "]"}], "]"}], ",", 
              RowBox[{"polygonPoints", "[", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{"hullIndexes", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"1", ",", "2"}], "}"}]}], "]"}], "]"}]}], "]"}]}], 
           "}"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"hullPointsG", "=", 
         RowBox[{"Graphics", "@", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"PointSize", "[", "0.02", "]"}], ",", "Black", ",", 
            RowBox[{"Point", "@", 
             RowBox[{"hullPoints", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", 
                RowBox[{"{", 
                 RowBox[{"1", ",", "2"}], "}"}]}], "]"}], "]"}]}]}], 
           "}"}]}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"hullMin", "=", 
         RowBox[{"Min", "@", 
          RowBox[{"hullPoints", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "1"}], "]"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"minPos", "=", 
         RowBox[{
          RowBox[{"Position", "[", 
           RowBox[{"hullPoints", ",", 
            RowBox[{"{", 
             RowBox[{"hullMin", ",", "_", ",", "_"}], "}"}]}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"rotatedPoints", "=", 
         RowBox[{"RotateLeft", "[", 
          RowBox[{"hullPoints", ",", 
           RowBox[{"minPos", "-", "1"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"lowLegFound", "=", "False"}], ";", "\[IndentingNewLine]", 
        RowBox[{"index", "=", "0"}], ";", "\[IndentingNewLine]", 
        RowBox[{"lowLegPoints", "=", 
         RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"subReturn", "=", 
         RowBox[{"Plot", "[", 
          RowBox[{"x", ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", "0", ",", "1"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", "subReturn"}]}], "\[IndentingNewLine]", 
      "\[IndentingNewLine]", " ", "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.9059565006958466`*^9, 3.9059565011661634`*^9}, {
  3.9059565355215797`*^9, 3.9059565832693443`*^9}, {3.9059566507272673`*^9, 
