Cell["getySingularRange", "Subsection",
 CellChangeTimes->{{3.8967774079083*^9, 
  3.896777411672883*^9}},ExpressionUUID->"9bc57d6c-de4d-4c1d-8e39-\
379156b1b2e4"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"getSingularRange", "[", 
      RowBox[{"y_", ",", "z_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "return", "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"y", "===", 
           RowBox[{"-", "1"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"return", "=", 
            RowBox[{"Range", "[", 
             RowBox[{"1", ",", 
              RowBox[{"Length", "@", "$theSingularList"}]}], "]"}]}], ";"}], 
          "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Length", "@", "y"}], ">", "0"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"return", "=", "y"}], ";"}], "\[IndentingNewLine]", ",",
              "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"z", "==", 
                 RowBox[{"-", "1"}]}], ",", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"return", "=", 
                  RowBox[{"{", "y", "}"}]}], ";"}], "\[IndentingNewLine]", 
                ",", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"return", "=", 
                  RowBox[{"Range", "[", 
                   RowBox[{"y", ",", "z"}], "]"}]}], ";"}]}], 
               "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", 
            "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
        "\[IndentingNewLine]", "return"}]}], "\[IndentingNewLine]", "]"}]}], 
    ";"}], "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.896809272327367*^9, 3.8968094285244656`*^9}, {
   3.896809475763322*^9, 3.8968095716158524`*^9}, {3.896809621855517*^9, 
   3.896809631400302*^9}, 3.896809662143046*^9, {3.89680969870617*^9, 
   3.8968097672679577`*^9}, {3.8968098025721035`*^9, 
   3.8968098093673563`*^9}, {3.8968098681875296`*^9, 
