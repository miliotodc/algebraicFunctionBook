                  RowBox[{"{", 
                   RowBox[{"index", ",", 
                    RowBox[{"index", "+", "1"}], ",", 
                    RowBox[{"-", "slope"}], ",", "yIntercept"}], "}"}]}], 
                 "]"}], ";"}], "\[IndentingNewLine]", ",", 
