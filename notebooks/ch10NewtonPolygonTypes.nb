Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"identifyPolygonZeros", "[", 
    RowBox[{"f_", ",", "cVal_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "f2", ",", "wTerms", ",", "theCTerms", ",", "cTermVals", ",", 
       "theZeroList", ",", "cTemp", ",", "cKey", ",", "cKeyValue", ",", "i", 
       ",", "j", ",", "adjustedTolerance", ",", "zeroTermList", ",", 
       "posList", ",", "newF", ",", "zeroTermListExp", ",", "toleranceLimit", 
       ",", "minExpList", ",", "zList", ",", "zListExp"}], "}"}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{"$saveFIterateFlag", ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
         "Print", "[", "\"\<     appending fIterate to $fIterates...\>\"", 
          "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"$fIterates", ",", 
           RowBox[{"{", 
            RowBox[{"cVal", ",", "f"}], "}"}]}], "]"}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
