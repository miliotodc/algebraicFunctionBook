 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"createpBar", "[", 
     RowBox[{"pval_", ",", "denom_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "wsum", ",", "zsum", ",", "wexplist", ",", "myzlist", ",", "zexplist", 
        ",", "i", ",", "j"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"wsum", "=", "0"}], ";", "\[IndentingNewLine]", 
       RowBox[{"zsum", "=", "0"}], ";", "\[IndentingNewLine]", 
       RowBox[{"wexplist", "=", 
        RowBox[{"Exponent", "[", 
         RowBox[{"pval", ",", "w", ",", "List"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"i", "=", "1"}], ",", 
         RowBox[{"i", "\[LessEqual]", 
          RowBox[{"Length", "[", "wexplist", "]"}]}], ",", 
         RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"myzlist", "=", 
           RowBox[{"Coefficient", "[", 
            RowBox[{"pval", ",", "w", ",", 
             RowBox[{"wexplist", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"zexplist", "=", 
           RowBox[{"Exponent", "[", 
            RowBox[{"myzlist", ",", "z", ",", "List"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"zsum", "=", "0"}], ";", "\[IndentingNewLine]", 
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"j", "=", "1"}], ",", 
            RowBox[{"j", "\[LessEqual]", 
             RowBox[{"Length", "[", "zexplist", "]"}]}], ",", 
            RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"zsum", "+=", 
              RowBox[{
               RowBox[{"Coefficient", "[", 
                RowBox[{"myzlist", ",", "z", ",", 
                 RowBox[{"zexplist", "[", 
                  RowBox[{"[", "j", "]"}], "]"}]}], "]"}], 
               RowBox[{"z", "^", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"zexplist", "[", 
                   RowBox[{"[", "j", "]"}], "]"}], " ", "denom"}], 
                 ")"}]}]}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"wsum", "+=", 
           RowBox[{"zsum", " ", 
            RowBox[{"w", "^", 
             RowBox[{"wexplist", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}]}]}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", "wsum"}]}], 
