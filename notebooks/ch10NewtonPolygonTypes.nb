            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"Re", "[", "z", "]"}], "+", 
               RowBox[{"Re", "[", "baseSingularPoint", "]"}]}], ",", 
              RowBox[{
               RowBox[{"Im", "[", "z", "]"}], "+", 
               RowBox[{"Im", "[", "baseSingularPoint", "]"}]}], ",", 
              RowBox[{"type", "[", 
               RowBox[{"f", "[", 
