               RowBox[{"rootMatrix", "[", 
                RowBox[{"[", 
                 RowBox[{"k", ",", "j"}], "]"}], "]"}]}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"i", "==", "j"}], ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"result", "=", 
                RowBox[{"Style", "[", 
                 RowBox[{"1", ",", "Bold", ",", "Black"}], "]"}]}], ";"}], 
              "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Ceiling", "@", 
                   RowBox[{"Precision", "@", "val"}]}], "<=", 
                  "lowDifferential"}], ",", "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"result", "=", 
                   RowBox[{"Style", "[", 
