               RowBox[{"N", "[", 
                RowBox[{"myBasePoints", ",", "15"}], "]"}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"Print", "[", 
              RowBox[{"\"\<     minVal:       \>\"", ",", 
               RowBox[{"N", "[", 
                RowBox[{"minVal", ",", "15"}], "]"}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"Abort", "[", "]"}], ";"}]}], "\[IndentingNewLine]", 
           "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"baseNDZ", "=", 
           RowBox[{"baseSol", "[", 
            RowBox[{"[", 
             RowBox[{"baseLocArray", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", "1"}], "]"}], "]"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"myNextPoints", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"EuclideanDistance", "[", 
              RowBox[{"p1", ",", "#"}], "]"}], "&"}], "/@", "nextSol"}]}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"minVal", "=", 
           RowBox[{"Min", "@", "myNextPoints"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"nextLocArray", "=", 
             RowBox[{"Position", "[", 
              RowBox[{"myNextPoints", ",", 
               RowBox[{"x_", "/;", 
                RowBox[{
                 RowBox[{"Abs", "[", 
                  RowBox[{"x", "-", "minVal"}], "]"}], "<", 
                 RowBox[{"10", "^", 
                  RowBox[{"-", 
                   RowBox[{"(", 
                    RowBox[{
                    "theSolvePrec", "-", "$accuracyComparisonFactor"}], 
                    ")"}]}]}]}]}]}], "]"}]}], ";"}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"difArray", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"minVal", "-", "#"}], "]"}], "&"}], "/@", " ", 
            "myNextPoints"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"nextLocArray", "=", 
           RowBox[{"Position", "[", 
            RowBox[{"difArray", ",", 
             RowBox[{"Min", "@", "difArray"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "@", "nextLocArray"}], "!=", "1"}], ",", 
