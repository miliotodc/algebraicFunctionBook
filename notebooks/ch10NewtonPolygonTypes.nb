                "N"}]}], "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"Print", "[", 
              RowBox[{"\"\<     Roots: \>\"", ",", 
               RowBox[{"charRootList", "//", "N"}]}], "]"}], ";", 
