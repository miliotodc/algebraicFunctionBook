                RowBox[{"{", 
                 RowBox[{"x_", ",", "y_List"}], "}"}], "/;", 
                RowBox[{
                 RowBox[{"Length", "@", "y"}], "!=", "0"}]}]}], "]"}]}]}], 
           ";", "\[IndentingNewLine]", 
           RowBox[{"(*", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"remove", " ", "from", " ", "oneCyclePos"}], ",", " ", 
             RowBox[{"any", " ", "pole", " ", "positions", " ", "analyPos"}], 
             ",", "oneTable", ",", "zDeriv", ",", "numZero", ",", 
             "removeFlag"}], "\[IndentingNewLine]", "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{"analyPos", "=", 
            RowBox[{"Complement", "[", 
             RowBox[{"oneCyclePos", ",", "polePos"}], "]"}]}], ";", " ", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{"diagFlag", ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Print", "[", 
               RowBox[{"\"\<analyPos: \>\"", ",", "analyPos"}], "]"}], 
              ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Length", "@", "analyPos"}], ">", "0"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{"diagFlag", ",", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"Print", "[", 
                  RowBox[{"\"\<analyPos: \>\"", ",", "analyPos"}], "]"}], 
                 ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"(*", "\[IndentingNewLine]", " ", 
               RowBox[{
                RowBox[{
                "now", " ", "analyPos", " ", "are", " ", "the", " ", "non"}], 
                "-", 
                RowBox[{"pole", " ", "1"}], "-", 
                RowBox[{"cycles", " ", "in", " ", "this", " ", "set"}]}], 
               "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
              RowBox[{"oneTable", "=", 
               RowBox[{"Table", "[", "\[IndentingNewLine]", 
