    RowBox[{"minSheetSeparation", "[", "wVals_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"nearestList", ",", "nearestDist", ",", "minVal"}], "}"}], ",",
       "\[IndentingNewLine]", " ", 
      RowBox[{
       RowBox[{"nearestList", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"NearestTo", "[", 
              RowBox[{"#1", ",", "2"}], "]"}], "[", "wVals", "]"}], "&"}], "/@",
            " ", "wVals"}], ")"}], "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"nearestDist", "=", 
        RowBox[{"MapThread", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"#1", "-", "#2"}], "]"}], "&"}], ",", 
          RowBox[{"{", 
           RowBox[{"wVals", ",", "nearestList"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Min", "@", "nearestDist"}]}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}]], "Input",
