Cell[CellGroupData[{

Cell["Manual search of higher-ramified residual", "Subsubsection",
 CellChangeTimes->{{3.9459596290685434`*^9, 
  3.945959641206438*^9}},ExpressionUUID->"71d7578b-1e8c-4f5a-a479-\
533322176d95"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{"wMax", "=", 
    RowBox[{"RandomInteger", "[", 
     RowBox[{"{", 
      RowBox[{"4", ",", "18"}], "}"}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{"zMax", "=", 
    RowBox[{"RandomInteger", "[", 
     RowBox[{"{", 
      RowBox[{"3", ",", "8"}], "}"}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{"wExpList", "=", 
    RowBox[{"Sort", "@", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"RandomSample", "[", 
        RowBox[{
         RowBox[{"Range", "[", 
          RowBox[{"1", ",", "wMax"}], "]"}], ",", 
         RowBox[{"RandomInteger", "[", 
          RowBox[{"{", 
           RowBox[{"1", ",", "wMax"}], "}"}], "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"wMax", "+", 
          RowBox[{"RandomInteger", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"wMax", "+", "2"}], ",", 
             RowBox[{"wMax", "+", "5"}]}], "}"}], "]"}]}]}], "}"}]}], 
      "]"}]}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"zMax", ">", "0"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"zExpList", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"RandomSample", "[", 
           RowBox[{
            RowBox[{"Range", "[", 
             RowBox[{"1", ",", "zMax"}], "]"}], ",", 
            RowBox[{"RandomInteger", "[", 
             RowBox[{"{", 
              RowBox[{"1", ",", "zMax"}], "}"}], "]"}]}], "]"}], ",", 
          RowBox[{"{", "wExpList", "}"}]}], "]"}]}], ";"}], 
      "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"zExpList", "=", 
        RowBox[{"{", "0", "}"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"$theFunction", "=", 
     RowBox[{"Plus", "@@", 
      RowBox[{"Table", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"aCoef", "=", 
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"RandomInteger", "[", 
                RowBox[{"{", 
                 RowBox[{"1", ",", "10"}], "}"}], "]"}], 
               RowBox[{"z", "^", "#"}]}], "&"}], "/@", " ", 
             RowBox[{"zExpList", "[", 
              RowBox[{"[", "j", "]"}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"RandomChoice", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{"-", "1"}], "/", "2"}], ",", "0", ",", "3"}], "}"}], 
              "]"}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Plus", "@@", "aCoef"}], " ", 
          RowBox[{"w", "^", 
           RowBox[{"wExpList", "[", 
            RowBox[{"[", "j", "]"}], "]"}]}]}]}], " ", ",", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"j", ",", "1", ",", 
          RowBox[{"Length", "@", "wExpList"}]}], "}"}]}], 
       "\[IndentingNewLine]", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"aForm", "[", "$theFunction", "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wExp", "=", 
     RowBox[{"Exponent", "[", 
      RowBox[{"$theFunction", ",", "w", ",", "List"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"functionDegree", "=", 
    RowBox[{"Last", "@", "wExp"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"!", 
      RowBox[{"IrreduciblePolynomialQ", "@", "$theFunction"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Print", "[", "\"\<Function is reducible\>\"", "]"}], ";"}]}], 
    "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
