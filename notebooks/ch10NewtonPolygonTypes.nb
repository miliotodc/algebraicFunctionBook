      RowBox[{"{", 
       RowBox[{"0", ",", "5"}], "}"}], "]"}]}]}], 
   ";"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"getWPower", "[", "n_", "]"}], ":=", " ", 
