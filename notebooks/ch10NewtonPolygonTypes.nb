Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"$workingPrecision", "=", "1000"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"$theTestCase", "=", "\"\<tempTestCase001\>\""}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"at", "=", 
     RowBox[{"AbsoluteTiming", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "theSingularList", ",", "poleIndexes", ",", "minRadiusArray", ",", 
          "res", ",", "zeroIndexes", ",", "nearestDistArray", ",", 
          "rNormArray"}], "}"}], "=", 
        RowBox[{"getSingularPoints", "[", 
         RowBox[{"$theFunction", ",", "$workingPrecision", ",", "True"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"theSingularList", "==", "\"\<-1\>\""}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"Style", "[", 
            RowBox[{
            "\"\<Encountered error with getSingular Points!\>\"", ",", 
             "Red"}], "]"}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"Abort", "[", "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], 
       ";"}], "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Total singular points: \>\"", ",", 
      RowBox[{"Length", "@", "theSingularList"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"singPrec", "=", 
     RowBox[{"Floor", "@", 
      RowBox[{"Precision", "@", "theSingularList"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"theSingularList", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "]"}], "<", 
       RowBox[{"10", "^", 
        RowBox[{"(", 
         RowBox[{"-", 
          RowBox[{"(", 
           RowBox[{"singPrec", "-", "$acf"}], ")"}]}], ")"}]}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"Style", "[", 
         RowBox[{
         "\"\<Zero is a singular point\>\"", ",", "Bold", ",", "Red"}], "]"}],
         "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "@", "theSingularList"}], ">", "1"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"minSingSeparation", "=", 
        RowBox[{
         RowBox[{"3", 
          RowBox[{"Min", "@", "minRadiusArray"}]}], "//", "N"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"minSingAccFactor", "=", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{
           RowBox[{"MantissaExponent", "[", "minSingSeparation", "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], "+", "5"}]}], ";"}]}], 
     "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{"Export", "[", 
     RowBox[{
      RowBox[{"singularDataFileName", "[", "$theTestCase", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{
       "theSingularList", ",", "poleIndexes", ",", "minRadiusArray", ",", 
        "res", ",", "zeroIndexes", ",", "nearestDistArray", ",", 
        "rNormArray"}], "}"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Export", "[", 
     RowBox[{
      RowBox[{"resultantFileName", "[", "$theTestCase", "]"}], ",", "res"}], 
     "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"reformFlags", "=", 
     RowBox[{"{", 
      RowBox[{"False", ",", "False", ",", "False"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"reformedWRules", ",", "theReformedIndexes"}], "}"}], "=", 
     RowBox[{"getReformedIndexes", "[", 
      RowBox[{
      "$theFunction", ",", "theSingularList", ",", "zeroIndexes", ",", 
       "poleIndexes", ",", "reformFlags"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"singularIndex", ",", 
     RowBox[{"reformedFunction", "  ", "returned"}]}], " ", "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"genericIndexes", "=", 
     RowBox[{"Complement", "[", 
      RowBox[{
       RowBox[{"Range", "[", 
        RowBox[{"1", ",", 
         RowBox[{"Length", "@", "theSingularList"}]}], "]"}], ",", 
       RowBox[{"DeleteDuplicates", "[", "theReformedIndexes", "]"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"reformedFunctionTable", "=", 
     RowBox[{"getReformedFunctionTable", "[", 
