  RowBox[{
   RowBox[{"$theFunction", "=", 
    RowBox[{"$theFunction", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"2", " ", "z"}], "-", 
