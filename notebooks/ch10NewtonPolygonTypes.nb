             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "==", 
              RowBox[{"{", "}"}]}], "&"}]}], "]"}], "//", "Flatten"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{"diagFlag", ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{
            "\"\<oneCycleNonPolePos: \>\"", ",", "oneCycleNonPolePos"}], 
            "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", "\[IndentingNewLine]", " ", 
         RowBox[{
          RowBox[{
          "compute", " ", "the", " ", "value", " ", "of", " ", "all", " ", 
           "1"}], "-", 
          RowBox[{"cycle", " ", "non"}], "-", 
          RowBox[{
          "poles", " ", "at", " ", "zero", " ", "and", " ", "make", " ", 
           "array", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"index1", ",", "wval1"}], "}"}], ",", 
