                 RowBox[{
                  RowBox[{"charEqns", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], "/.", 
                  RowBox[{"x", "->", "#"}]}], ")"}], "]"}], "&"}], "/@", " ", 
              RowBox[{"charRootList", "[", 
