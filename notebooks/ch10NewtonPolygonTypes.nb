Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{"getNewtonIterations", "[", 
    RowBox[{
    "theFunction_", ",", "puiseuxSaveTable_", ",", "theSingularList_", ",", 
     "conjBaseSheetIndexes_", ",", "puiseuxTableIndex_", ",", "seriesSize_", 
     ",", "diagFlag_", ",", "getSeriesFlag_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "currentSing", ",", "theSheets", ",", "conjClassBaseSeries", ",", 
       "sIndex", ",", "at1", ",", "baseReport", ",", "cGroup", ",", "iTab", 
       ",", "cLinks", ",", "theEnd", ",", "theRange", ",", "j", ",", 
       "finalConjList", ",", "at2", ",", "sheetSeries", ",", 
       "currentCycleSize", ",", "myF1", ",", "theexp", ",", "theNum", ",", 
       "clist", ",", "f", ",", "rTable", ",", "pSeries", ",", "expList", ",", 
       "posExpList", ",", "den", ",", "num", ",", "lcmList", ",", "minExp", 
       ",", "cycleMetric", ",", "pole", ",", "poleStatus", ",", "poleList", 
       ",", "removableStatus", ",", "baseNearestList", ",", 
       "singularSequence", " ", ",", "baseSingularIndex", ",", "classIndexes",
        ",", "baseRadius", ",", "smIVPVal", ",", "seriesCrossReferences", ",",
        "poleIndexes"}], "}"}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"baseSingularIndex", "=", 
       RowBox[{"puiseuxSaveTable", "[", 
        RowBox[{"[", 
         RowBox[{"puiseuxTableIndex", ",", "3"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"currentSing", "=", 
       RowBox[{"theSingularList", "[", 
        RowBox[{"[", "baseSingularIndex", "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{
         "\"\<Processing singular point index: \>\"", ",", "Black", ",", 
          "Bold", ",", "14"}], "]"}], ",", "baseSingularIndex", ",", 
        "\"\< sing pt: \>\"", ",", 
        RowBox[{
         RowBox[{"$theSingularList", "[", 
          RowBox[{"[", "baseSingularIndex", "]"}], "]"}], "//", "N"}]}], 
       "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"theSheets", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", 
           RowBox[{"#", "[", 
            RowBox[{"[", 
             RowBox[{"2", ",", "1"}], "]"}], "]"}]}], "}"}], "&"}], "/@", " ", 
        RowBox[{"conjBaseSheetIndexes", "[", 
         RowBox[{"[", "puiseuxTableIndex", "]"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"theSheets", " ", 
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"cycle", " ", "size"}], ",", " ", 
           RowBox[{"generator", " ", "index"}]}], "}"}], "}"}]}], " ", "*)"}],
       "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{
       "\"\<theSheets in getNewtonIterations: \>\"", ",", "theSheets"}], 
       "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"at1", "=", 
       RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"conjClassBaseSeries", "=", 
          RowBox[{"Table", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{"diagFlag", ",", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"Print", "[", 
                 RowBox[{
                  RowBox[{"Style", "[", 
                   RowBox[{
                   "\"\<Analyzing table index \>\"", ",", "Purple", ",", 
                    "Bold", ",", "14"}], "]"}], ",", "inum"}], "]"}], ";"}]}],
               "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"sIndex", "=", 
              RowBox[{"theSheets", "[", 
               RowBox[{"[", 
                RowBox[{"inum", ",", "2"}], "]"}], "]"}]}], ";", " ", 
             RowBox[{"(*", " ", 
              RowBox[{
              "get", " ", "series", " ", "only", " ", "for", " ", "generator",
                " ", "for", " ", "branch"}], " ", "*)"}], " ", 
             "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{"diagFlag", ",", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"Print", "[", 
                 RowBox[{
                 "\"\<     Analyzing generator index \>\"", ",", "sIndex"}], 
                 "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
             "\[IndentingNewLine]", " ", 
             RowBox[{"getSingleSeries", "[", 
              RowBox[{
               RowBox[{"puiseuxSaveTable", "[", 
                RowBox[{"[", 
                 RowBox[{"puiseuxTableIndex", ",", "1"}], "]"}], "]"}], ",", 
               "sIndex", ",", 
               RowBox[{"puiseuxSaveTable", "[", 
                RowBox[{"[", 
                 RowBox[{"puiseuxTableIndex", ",", "2"}], "]"}], "]"}], ",", 
               "seriesSize", ",", "getSeriesFlag"}], "]"}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{"inum", ",", "1", ",", 
              RowBox[{"Length", "@", "theSheets"}]}], "}"}]}], 
           "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
        "]"}]}], ";", "\[IndentingNewLine]", " ", 
      RowBox[{"(*", " ", 
       RowBox[{"getSingleSeries", " ", "return", " ", 
        RowBox[{"{", 
         RowBox[{"cycleSize", ",", "series"}], "}"}]}], " ", "*)"}], " ", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{"diagFlag", ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"\"\<time to compute \>\"", ",", 
           RowBox[{"Length", "@", "theSheets"}], ",", 
           "\"\< base series at \>\"", ",", 
           RowBox[{"Precision", "@", "conjClassBaseSeries"}], ",", 
           "\"\< digit precision: \>\"", ",", 
           RowBox[{"at1", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{"\"\<series lengths: \>\"", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "@", "#"}], "&"}], "/@", " ", 
            RowBox[{"conjClassBaseSeries", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "2"}], "]"}], "]"}]}]}], "]"}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", "\[IndentingNewLine]", " ", 
       RowBox[{
        RowBox[{"now", " ", "get", " ", "cLinks", " ", "and", " ", 
         RowBox[{"finalConjList", ":", " ", "baseReport"}]}], ",", "cGroup", 
        ",", "iTab", ",", "cLinks", ",", "theEnd", ",", "theRange", ",", "j", 
        ",", "finalConjList"}], "\[IndentingNewLine]", "*)"}], "\n", 
      RowBox[{"baseReport", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", 
              RowBox[{"2", ",", 
               RowBox[{"1", ";;", "4"}]}], "]"}], "]"}], "//", "N"}]}], "}"}],
          "&"}], "/@", " ", "conjClassBaseSeries"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"cGroup", "=", " ", 
       RowBox[{"baseReport", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"iTab", "=", "1"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", "\[IndentingNewLine]", " ", 
       RowBox[{"cLinks", " ", "become", " ", "the", " ", "baseConjLinks"}], 
       "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"cLinks", "=", 
       RowBox[{"Table", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"theEnd", "=", 
           RowBox[{"iTab", "+", 
            RowBox[{"cGroup", "[", 
             RowBox[{"[", "j", "]"}], "]"}], "-", "1"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"theRange", "=", 
           RowBox[{"Range", "[", 
            RowBox[{"iTab", ",", "theEnd"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"iTab", "=", 
           RowBox[{"theEnd", "+", "1"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"cGroup", "[", 
             RowBox[{"[", "j", "]"}], "]"}], ",", "theRange"}], "}"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"j", ",", "1", ",", 
           RowBox[{"Length", "@", "cGroup"}]}], "}"}]}], 
        "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", "\[IndentingNewLine]", " ", 
       RowBox[{"finalConjList", " ", "is", " ", "the", " ", "baseConjList"}], 
       "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"finalConjList", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"Length", "@", 
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}], "&"}], "/@", 
         " ", "cLinks"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{"diagFlag", ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"\"\<conjList: \>\"", ",", "finalConjList"}], "]"}], 
         ";"}]}], "\[IndentingNewLine]", "]"}], ";", "\n", 
      RowBox[{"(*", "\[IndentingNewLine]", " ", 
       RowBox[{
        RowBox[{
        "generate", " ", "all", " ", "conjugate", " ", "class", " ", 
         "members", " ", "from", " ", "each", " ", "conjugate", " ", "class", 
         " ", "base", " ", 
         RowBox[{"sheet", ":", " ", "at2"}]}], ",", "sheetSeries", ",", 
        "currentCycleSize", ",", "myF1", ",", "theexp", ",", "theNum", ",", 
        "clist", ",", "f", ",", "rTable"}], "\[IndentingNewLine]", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"minSheetLengths", "=", 
         RowBox[{"{", "}"}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"at2", "=", 
       RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"sheetSeries", "=", 
          RowBox[{"Flatten", "[", 
           RowBox[{
            RowBox[{"Table", "[", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"currentCycleSize", "=", 
                RowBox[{"conjClassBaseSeries", "[", 
                 RowBox[{"[", 
                  RowBox[{"sIndex", ",", "1"}], "]"}], "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"myF1", "[", "z_", "]"}], "=", 
                RowBox[{"conjClassBaseSeries", "[", 
                 RowBox[{"[", 
                  RowBox[{"sIndex", ",", "2"}], "]"}], "]"}]}], ";", 
               "\[IndentingNewLine]", " ", 
               RowBox[{"theexp", "=", 
                RowBox[{"Exponent", "[", 
                 RowBox[{
                  RowBox[{"myF1", "[", "z", "]"}], ",", "z", ",", "List"}], 
                 "]"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"theNum", "=", 
                RowBox[{"Numerator", "@", "theexp"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"clist", "=", 
                RowBox[{"Coefficient", "[", 
                 RowBox[{
                  RowBox[{"myF1", "[", "z", "]"}], ",", "z", ",", "theexp"}], 
                 "]"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"f", "[", 
                 RowBox[{"z_", ",", "k_"}], "]"}], ":=", 
                RowBox[{"Sum", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"clist", "[", 
                    RowBox[{"[", "n", "]"}], "]"}], " ", 
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{"Exp", "[", 
                    RowBox[{"2", " ", "k", " ", "\[Pi]", " ", 
                    RowBox[{"\[ImaginaryI]", "/", "currentCycleSize"}]}], 
                    "]"}], ")"}], "^", 
                    RowBox[{"(", 
                    RowBox[{"currentCycleSize", " ", 
                    RowBox[{"theexp", "[", 
                    RowBox[{"[", "n", "]"}], "]"}]}], ")"}]}], " ", 
                   RowBox[{"z", "^", 
                    RowBox[{"theexp", "[", 
                    RowBox[{"[", "n", "]"}], "]"}]}]}], ",", 
                  RowBox[{"{", 
                   RowBox[{"n", ",", "1", ",", 
                    RowBox[{"Length", "[", "clist", "]"}]}], "}"}]}], "]"}]}],
                ";", "\[IndentingNewLine]", 
               RowBox[{"rTable", "=", 
                RowBox[{"Table", "[", "\[IndentingNewLine]", 
                 RowBox[{"(*", 
                  RowBox[{
                   RowBox[{"AppendTo", "[", 
                    RowBox[{"minSheetLengths", ",", "currentMinLength"}], 
                    "]"}], ";"}], "*)"}], "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"f", "[", 
                   RowBox[{"z", ",", "n"}], "]"}], ",", "\[IndentingNewLine]", 
                  RowBox[{"{", 
                   RowBox[{"n", ",", "0", ",", 
                    RowBox[{"currentCycleSize", "-", "1"}]}], "}"}]}], 
                 "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
               "rTable"}], ",", "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{"sIndex", ",", "1", ",", 
                RowBox[{"Length", "@", "theSheets"}]}], "}"}]}], 
             "\[IndentingNewLine]", "]"}], ",", "1"}], "]"}]}], ";"}], 
        "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", " ", 
      RowBox[{"(*", " ", "\[IndentingNewLine]", "  ", 
       RowBox[{
        RowBox[{"save", " ", "data", " ", "to", " ", 
         RowBox[{"file", ":", " ", "minR"}]}], ",", "pSeries", ",", "expList",
         ",", "posExpList", ",", "den", ",", "num", ",", "lcmList", ",", 
        "minExp", ",", "cycleMetric", ",", "pole", ",", "poleStatus"}], 
       "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"currentSing", "=", 
       RowBox[{"$theSingularList", "[", 
        RowBox[{"[", "baseSingularIndex", "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"pSeries", "=", "sheetSeries"}], ";", "\[IndentingNewLine]", 
      RowBox[{"expList", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Exponent", "[", 
          RowBox[{"#", ",", "z", ",", "List"}], "]"}], "&"}], "/@", " ", 
        "pSeries"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"poleIndexes", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"MemberQ", "[", 
            RowBox[{"#", ",", 
             RowBox[{"-", "1"}]}], "]"}], "&"}], "/@", " ", "expList"}]}], 
        ";"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"poleIndexes", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"AnyTrue", "[", 
          RowBox[{"#", ",", 
           RowBox[{
            RowBox[{"#", "<", "0"}], "&"}]}], "]"}], "&"}], "/@", " ", 
        "expList"}]}], ";", "\n", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"posExpList", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"DeleteCases", "[", 
          RowBox[{"#", ",", "0"}], "]"}], "&"}], "/@", " ", "expList"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"den", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Denominator", "@", "#"}], "&"}], "/@", " ", 
        "posExpList"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"num", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Numerator", "@", "#"}], "&"}], "/@", " ", "posExpList"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"lcmList", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"LCM", "[", 
          RowBox[{"Sequence", "@@", "#"}], "]"}], "&"}], "/@", " ", "den"}]}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"minExp", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Min", "@", "#"}], "&"}], " ", "/@", " ", "posExpList"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{"\"\<     minExp: \>\"", ",", "minExp"}], "]"}], ";"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"cycleMetric", "=", 
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"#2", ",", 
            RowBox[{
             FractionBox["#2", 
              RowBox[{"Denominator", "@", "#1"}]], " ", 
             RowBox[{"Numerator", "@", "#1"}]}]}], "}"}], "&"}], ",", 
         RowBox[{"{", 
          RowBox[{"minExp", ",", "lcmList"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"poleList", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Element", "[", 
          RowBox[{"#", ",", "NegativeIntegers"}], "]"}], "&"}], "/@", " ", 
        RowBox[{"(", 
         RowBox[{"Numerator", "@", "minExp"}], ")"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"poleStatus", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "1"}], ",", 
        RowBox[{"i", "<=", 
         RowBox[{"Length", "@", "poleIndexes"}]}], ",", 
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"poleIndexes", "[", 
            RowBox[{"[", "i", "]"}], "]"}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"AppendTo", "[", 
             RowBox[{"poleStatus", ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", 
                RowBox[{"cycleMetric", "[", 
                 RowBox[{"[", "i", "]"}], "]"}]}], "}"}]}], "]"}], ";"}], 
           "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"AppendTo", "[", 
             RowBox[{"poleStatus", ",", 
              RowBox[{"{", 
