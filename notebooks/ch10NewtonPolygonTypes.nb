                 RowBox[{"i", "-", "1"}]}], "]"}], "]"}]}], "}"}], "/.", 
            RowBox[{"z", "\[Rule]", 
             RowBox[{"r", " ", 
              RowBox[{"Exp", "[", 
               RowBox[{"\[ImaginaryI]", " ", "t"}], "]"}]}]}]}], ",", 
           RowBox[{"{", 
            RowBox[{"r", ",", "startR", ",", "endR"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", 
             RowBox[{"-", "\[Pi]"}], ",", "\[Pi]"}], "}"}], ",", 
           RowBox[{"BoxRatios", "\[Rule]", 
            RowBox[{"{", 
             RowBox[{"1", ",", "1", ",", "1"}], "}"}]}], ",", 
           RowBox[{"PlotStyle", "->", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Opacity", "[", "0.55", "]"}], ",", 
              RowBox[{"colors", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], "}"}]}], ",", 
           RowBox[{"PlotRange", "->", "All"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "cycleSize"}], "}"}]}], "]"}]}]}], 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", 
