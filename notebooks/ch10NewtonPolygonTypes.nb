Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"convertToNormalForm", "[", "theF_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "wRules", ",", "wKeys", ",", "zRules", ",", "theOrders", ",", 
        "positiveOrders", ",", "fDegree", ",", "normalEqn", ",", 
        "normalConstraints", ",", "eqnA", ",", "i", ",", "minData", ",", 
        "currentmu", ",", "mylambda", ",", "thepoly", ",", "\[Mu]", ",", 
        "\[Lambda]", ",", "lVal", ",", "mVal"}], "}"}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", " ", 
      RowBox[{
       RowBox[{"wRules", "=", 
        RowBox[{"CoefficientRules", "[", 
         RowBox[{"theF", ",", "w", ",", "\"\<NegativeLexicographic\>\""}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"wKeys", "=", 
        RowBox[{"wRules", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"zRules", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "1"}], "]"}], "]"}], ",", 
            RowBox[{"CoefficientRules", "[", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}], ",", "z", ",", 
              "\"\<NegativeLexicographic\>\""}], "]"}]}], "}"}], "&"}], "/@", 
         " ", "wRules"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"theOrders", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{"#", "[", 
             RowBox[{"[", 
              RowBox[{"2", ",", "1", ",", "1", ",", "1"}], "]"}], "]"}]}], 
           "}"}], "&"}], "/@", " ", "zRules"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"positiveOrders", "=", 
        RowBox[{"Select", "[", 
         RowBox[{"theOrders", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ">", "0"}], "&"}]}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"fDegree", "=", 
        RowBox[{"Max", "@", 
         RowBox[{"Exponent", "[", 
          RowBox[{"theF", ",", "w", ",", "List"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"normalEqn", "=", 
        RowBox[{
         RowBox[{"\[Mu]", "+", 
          RowBox[{"positiveOrders", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"-", "1"}], ",", "2"}], "]"}], "]"}]}], "==", 
         RowBox[{"fDegree", " ", "\[Lambda]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"normalConstraints", "=", 
        RowBox[{"Table", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"eqnA", "=", 
            RowBox[{
             RowBox[{"\[Mu]", "+", 
              RowBox[{"positiveOrders", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "2"}], "]"}], "]"}]}], ">=", 
             RowBox[{
              RowBox[{"positiveOrders", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "1"}], "]"}], "]"}], " ", "\[Lambda]"}]}]}],
            ";", "\[IndentingNewLine]", "eqnA"}], ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{
             RowBox[{"Length", "[", "positiveOrders", "]"}], "-", "1"}]}], 
           "}"}]}], "\[IndentingNewLine]", "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"minData", "=", 
        RowBox[{"Minimize", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\[Lambda]", ",", 
            RowBox[{"normalEqn", " ", "&&", 
             RowBox[{"(", 
              RowBox[{"And", "@@", "normalConstraints"}], ")"}], "&&", " ", 
             RowBox[{"Element", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"\[Mu]", ",", "\[Lambda]"}], "}"}], ",", 
               "PositiveIntegers"}], "]"}]}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"\[Mu]", ",", "\[Lambda]"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"currentmu", ",", "mylambda"}], "}"}], "=", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\[Mu]", ",", "\[Lambda]"}], "}"}], "/.", 
         RowBox[{"minData", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"thepoly", "=", 
        RowBox[{"Expand", "[", 
         RowBox[{
          RowBox[{"z", "^", "currentmu"}], 
          RowBox[{"(", 
           RowBox[{"theF", "/.", 
            RowBox[{"w", "\[Rule]", 
             RowBox[{"w", "/", 
              RowBox[{"(", 
               RowBox[{"z", "^", "mylambda"}], ")"}]}]}]}], ")"}]}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{"$showNormalizedConstants", ",", "\[IndentingNewLine]", 
         RowBox[{"(*", "\[IndentingNewLine]", " ", 
          RowBox[{"now", " ", "check", " ", "against", " ", "getNormalVals"}],
           "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"\"\<the eta: \>\"", ",", "mylambda"}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<the mu: \>\"", ",", "currentmu"}], "]"}], ";"}]}], 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"lVal", ",", "mVal"}], "}"}], "=", 
           RowBox[{"getNormalVals", "[", "theF", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{
          "Print", "[", "\"\<Normal vals from getNormalVals:\>\"", "]"}], ";",
           "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<mu: \>\"", ",", "lVal"}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<eta:     \>\"", ",", "mVal"}], "]"}], ";"}], "*)"}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"thepoly", ",", "mylambda", ",", "currentmu"}], "}"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
