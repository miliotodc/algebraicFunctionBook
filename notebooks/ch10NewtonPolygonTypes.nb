 RowBox[{
  RowBox[{"sparseVal", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"randomNum", "[", "n_", "]"}], ":=", " ", 
   RowBox[{"RandomChoice", "[", 
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{"0", ",", 
        RowBox[{"{", "n", "}"}]}], "]"}], ",", 
      RowBox[{"{", "1", "}"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"getZPower", "[", "n_", "]"}], ":=", 
    RowBox[{
     RowBox[{"randomNum", "[", "sparseVal", "]"}], 
