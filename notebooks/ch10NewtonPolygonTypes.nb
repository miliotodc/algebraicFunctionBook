               "\"\<getIntegrationData::Did not find next point \
location!\>\"", ",", "Red"}], "]"}], "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"Print", "[", 
              RowBox[{"\"\<     myNextPoints: \>\"", ",", 
               RowBox[{"N", "[", 
                RowBox[{"myNextPoints", ",", "45"}], "]"}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"Print", "[", 
              RowBox[{"\"\<     minVal:       \>\"", ",", 
               RowBox[{"N", "[", 
                RowBox[{"minVal", ",", "45"}], "]"}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"Abort", "[", "]"}], ";"}]}], "\[IndentingNewLine]", 
           "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"nextNDZ", "=", 
