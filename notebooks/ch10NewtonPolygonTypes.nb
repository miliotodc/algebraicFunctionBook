             "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{
           "(*", "\[IndentingNewLine]", " ", "now", "\[IndentingNewLine]", 
            "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"zTerms", "=", 
