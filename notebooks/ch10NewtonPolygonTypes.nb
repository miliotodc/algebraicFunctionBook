              RowBox[{
               RowBox[{"Print", "[", 
                RowBox[{
                 RowBox[{"Style", "[", 
                  RowBox[{"\"\<getNewtonData found  \>\"", ",", "Red"}], 
                  "]"}], ",", 
                 RowBox[{"Style", "[", 
                  RowBox[{
                   RowBox[{"Length", "@", "$puiseuxSave"}], ",", "Red"}], 
                  "]"}], ",", 
                 RowBox[{"Style", "[", 
                  RowBox[{"\"\< sheets out of \>\"", ",", "Red"}], "]"}], ",", 
                 RowBox[{"Style", "[", 
                  RowBox[{"functionDegree", ",", "Red"}], "]"}], ",", 
                 "\"\< at singular index \>\"", ",", "mIndex"}], "]"}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"sheetFlag", "=", "False"}], ";"}]}], 
             "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
            RowBox[{"(*", "\[IndentingNewLine]", " ", 
             RowBox[{
              RowBox[{"check", " ", "for", " ", "non"}], "-", 
              RowBox[{"minimal", " ", "ramification"}]}], 
             "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
            RowBox[{"cycleList", "=", 
             RowBox[{"$puiseuxSave", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "3"}], "]"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{"$getSegmentDataFlag", ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"Print", "[", 
                RowBox[{"\"\<Cycle list: \>\"", ",", "cycleList"}], "]"}], 
               ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"posArray", "=", 
             RowBox[{"Position", "[", 
              RowBox[{"cycleList", ",", 
               RowBox[{"x_", "/;", 
                RowBox[{"x", ">", "2"}]}]}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Length", "@", "posArray"}], ">", "0"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"MemberQ", "[", 
                  RowBox[{"$poleIndexes", ",", "mIndex"}], "]"}], ",", 
                 "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"poleIndexTally", "++"}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"Print", "[", 
                   RowBox[{
                    RowBox[{"Style", "[", 
                    RowBox[{
                    "\"\<Found higher ramifications for pole index \>\"", ",",
                     "Red"}], "]"}], ",", 
                    RowBox[{"Style", "[", 
                    RowBox[{"mIndex", ",", "Red"}], "]"}], ",", "\"\<: \>\"", 
                    ",", "cycleList"}], "]"}], ";"}], "\[IndentingNewLine]", 
                 ",", "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{"MemberQ", "[", 
                    RowBox[{"$zeroIndexes", ",", "mIndex"}], "]"}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"zeroIndexTally", "++"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"Print", "[", 
                    RowBox[{
                    RowBox[{"Style", "[", 
                    RowBox[{
                    "\"\<Found higher ramifications for zero index \>\"", ",",
                     "Blue"}], "]"}], ",", 
                    RowBox[{"Style", "[", 
                    RowBox[{"mIndex", ",", "Blue"}], "]"}], ",", "\"\<: \>\"",
                     ",", "cycleList"}], "]"}], ";"}], "\[IndentingNewLine]", 
                    ",", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"Print", "[", 
                    RowBox[{
                    "\"\<Found higher ramifications for singular index \>\"", 
                    ",", "mIndex", ",", "\"\<: \>\"", ",", "cycleList"}], 
                    "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]}], 
                "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", 
             "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{"baseData", ",", "$puiseuxSave", ",", "mIndex", ",", 
              RowBox[{"$fNewton", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", "normalExp", ",", 
              "currentmu"}], "}"}]}], ",", "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"mIndex", ",", "segList"}], "}"}]}], 
          "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"sheetFlag", "==", "True"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"Style", "[", 
             RowBox[{
             "\"\<All branch sheets accounted for!\>\"", ",", "Bold", ",", 
              "Black"}], "]"}], "]"}], ";"}], "\[IndentingNewLine]", ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"Style", "[", 
             RowBox[{
             "\"\<Branch sheet errors!\>\"", ",", "Bold", ",", "Red"}], "]"}],
             "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
        "\[IndentingNewLine]", "$puiseuxSaveTable"}]}], "\[IndentingNewLine]",
       "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "\[IndentingNewLine]"}]}]], "Input",
