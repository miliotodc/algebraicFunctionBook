          RowBox[{"baseSeries", "[", 
           RowBox[{"[", "oneCycleNonPolePos", "]"}], "]"}], "/.", 
          RowBox[{"z", "->", "0"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"oneCycleWArray", "=", 
