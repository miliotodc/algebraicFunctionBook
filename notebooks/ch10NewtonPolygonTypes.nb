Cell[CellGroupData[{

Cell["checkContinuationFiles", "Subsection",
 CellChangeTimes->{{3.938016700219343*^9, 
  3.938016704624425*^9}},ExpressionUUID->"5bfe28ba-9064-43b9-8119-\
a02847675881"],

Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{
   RowBox[{"checkContinuationFiles", "[", 
    RowBox[{
    "singularIndex_", ",", "rootTestArray_", ",", "singularSequence_"}], 
    "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "estCLSPs", ",", "clspList", ",", "clspPos", ",", "maxCLSPIndex", ",", 
       "comparisonSequence", ",", "fileNames"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"estCLSPs", "=", 
       RowBox[{"rootTestArray", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "6"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"clspList", "=", 
       RowBox[{"DeleteDuplicates", "[", "estCLSPs", "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"clspPos", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Position", "[", 
           RowBox[{"singularSequence", ",", 
            RowBox[{"x_", "/;", 
             RowBox[{"x", "==", "#"}]}]}], "]"}], "&"}], "/@", " ", 
         "clspList"}], " ", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"maxCLSPIndex", "=", 
       RowBox[{"Max", "@", "clspPos"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"maxCLSPIndex", "<=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"Length", "@", "$theSingularList"}], ")"}], "-", "5"}]}], 
        ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"comparisonSequence", "=", 
          RowBox[{"singularSequence", "[", 
           RowBox[{"[", 
            RowBox[{"1", ";;", 
             RowBox[{"maxCLSPIndex", "+", "5"}]}], "]"}], "]"}]}], ";"}], 
        "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"comparisonSequence", "=", "singularSequence"}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Comparison sequence: \>\"", ",", "comparisonSequence"}],
          "]"}], ";"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", "\[IndentingNewLine]", " ", 
       RowBox[{
       "now", " ", "check", " ", "if", " ", "all", " ", "files", " ", 
        "needed", " ", "for", " ", "continuation", " ", "are", " ", "on", " ",
         "disc"}], "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{
       "\"\<Checking for series files \>\"", ",", "comparisonSequence"}], 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"fileNames", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"seriesFileName", "[", "#", "]"}], "&"}], "/@", " ", 
        "comparisonSequence"}]}], ";", "\[IndentingNewLine]", " ", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"MemberQ", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"FileExistsQ", "@", "#"}], "&"}], "/@", " ", "fileNames"}],
          "]"}], ",", "False", ",", "\[IndentingNewLine]", "False", 
        "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Print", "[", "\"\<All files found\>\"", "]"}], ";", 
         "\[IndentingNewLine]", "True"}]}], "\[IndentingNewLine]", "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}]}]], "Input",
 CellChangeTimes->{{3.938016692768031*^9, 3.938016693143118*^9}, {
   3.9380757908655343`*^9, 3.9380757911468945`*^9}, {3.9380812153604717`*^9, 
   3.9380812761581154`*^9}, {3.9388534824362245`*^9, 3.9388534828028173`*^9}, 
   3.952092544056788*^9},
 CellLabel->
  "In[156]:=",ExpressionUUID->"99b7784a-60a5-488c-bcc3-fcf643c2cfab"]
}, Closed]],

