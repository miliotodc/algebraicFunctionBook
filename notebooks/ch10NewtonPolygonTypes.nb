Cell[BoxData[
 RowBox[{
  RowBox[{"polyForm", "[", 
   RowBox[{"poly_", ",", "var_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
