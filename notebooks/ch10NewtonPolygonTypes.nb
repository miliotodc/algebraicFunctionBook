            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{"Style", "[", 
               RowBox[{
               "\"\<getIntegrationData::solve \
precision<$minSolvePrecision\>\"", ",", "Red", ",", "14", ",", "Bold"}], 
               "]"}], "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"Abort", "[", "]"}], ";"}]}], "\[IndentingNewLine]", 
           "]"}], ";", "\[IndentingNewLine]", "\n", "          ", 
          RowBox[{"baseSol", "=", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"x", ",", "y"}], "}"}], "/.", 
            RowBox[{"NSolve", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"baseEqn", ",", "eqn3"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"x", ",", "y"}], "}"}], ",", 
              RowBox[{"WorkingPrecision", "->", "theSolvePrec"}]}], "]"}]}]}],
           ";", "\[IndentingNewLine]", 
          RowBox[{"nextSol", "=", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"x", ",", "y"}], "}"}], "/.", 
            RowBox[{"NSolve", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"nextEqn", ",", "eqn3"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"x", ",", "y"}], "}"}], ",", 
              RowBox[{"WorkingPrecision", "->", "theSolvePrec"}]}], "]"}]}]}],
           ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"myBasePoints", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"EuclideanDistance", "[", 
              RowBox[{"p2", ",", "#"}], "]"}], "&"}], "/@", "baseSol"}]}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"minVal", "=", 
           RowBox[{"Min", "@", "myBasePoints"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"difArray", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"minVal", "-", "#"}], "]"}], "&"}], "/@", " ", 
            "myBasePoints"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"baseLocArray", "=", 
             RowBox[{"Position", "[", 
              RowBox[{"myBasePoints", ",", 
               RowBox[{"x_", "/;", 
                RowBox[{
                 RowBox[{"Abs", "[", 
                  RowBox[{"x", "-", "minVal"}], "]"}], "<", 
                 RowBox[{"10", "^", 
                  RowBox[{"-", 
                   RowBox[{"(", 
                    RowBox[{
                    "theSolvePrec", "-", "$accuracyComparisonFactor"}], 
                    ")"}]}]}]}]}]}], "]"}]}], ";"}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"baseLocArray", "=", 
           RowBox[{"Position", "[", 
            RowBox[{"difArray", ",", 
             RowBox[{"Min", "[", "difArray", "]"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "@", "baseLocArray"}], "!=", "1"}], ",", 
