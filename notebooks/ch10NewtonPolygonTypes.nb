Cell["Search singular files for removable singular points", "Subsection",
 CellChangeTimes->{{3.927380781793708*^9, 
  3.927380792369323*^9}},ExpressionUUID->"43a9b1e4-2848-4dac-b525-\
47eaaa29ebcc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
   "find", " ", "list", " ", "of", " ", "removable", " ", "singular", " ", 
    "points"}], "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"PrintTemporary", "[", 
     RowBox[{"\"\<File index: \>\"", ",", 
      RowBox[{"Dynamic", "@", "fIndex"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"removableTable", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"fIndex", "=", "cIndex"}], ";", "\[IndentingNewLine]", 
        RowBox[{"nextIndex", "=", 
         RowBox[{"theSequence", "[", 
          RowBox[{"[", "cIndex", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"TrueQ", "@", 
           RowBox[{"FileExistsQ", "@", 
            RowBox[{"seriesFileName", "[", "nextIndex", "]"}]}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
             "newSingularIndex", ",", "nextSing", ",", "nextCycleMetric", ",",
               "nextPoleList", ",", "nextConjList", ",", "removableList", ",",
               "nextSeries", ",", "nextSheetLinks", ",", "nextSingSequence", 
              ",", "baseBranchTypeArray"}], "}"}], "=", 
            RowBox[{"Import", "[", 
             RowBox[{"seriesFileName", "[", "nextIndex", "]"}], "]"}]}], 
           ";"}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"seriesFileName", "[", "nextIndex", "]"}], "<>", 
               "\"\< not found during import.\>\""}], ",", "Red"}], "]"}], 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Abort", "[", "]"}], ";"}]}], "\[IndentingNewLine]", "]"}],
         ";", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"nextIndex", ",", "removableList"}], "}"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"cIndex", ",", "1", ",", "2"}], "}"}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"removableSingularFlag", "=", "False"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "@", 
        RowBox[{"Flatten", "@", 
         RowBox[{"removableTable", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2"}], "]"}], "]"}]}]}], ">", "0"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Print", "[", "\"\<found removable singular points\>\"", "]"}],
        ";", "\[IndentingNewLine]", 
       RowBox[{"removableSingularFlag", "=", "True"}], ";"}], 
      "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
      RowBox[{
      "Print", "[", "\"\<No removable singular points found\>\"", "]"}]}], 
     "\[IndentingNewLine]", "]"}], ";"}], "\n"}]}]], "Input",
 CellChangeTimes->{{3.9273806638837147`*^9, 3.9273807129658937`*^9}, {
  3.9273807638448143`*^9, 3.9273807649539104`*^9}, {3.927381207367062*^9, 
