Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"getInitialSegmentsAtInfinity", "[", "$theFunction_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "$puiseuxSaveTable", ",", "mIndex", ",", "normalExp", ",", 
         "currentmu", ",", "theK", ",", "baseData", ",", "cycleList", ",", 
         "posArray", ",", "sheetFlag", ",", "minExp", ",", "residueFactor", 
         ",", "reformedFunctionIndexTable", ",", "reformedFunction", ",", 
         "reformedFunctionIndex", ",", "reformedFunctionTableIndex", ",", 
         "singAccuracy", ",", "segList", ",", "wCoef", ",", "tableData", ",", 
         "cResidueFactor", ",", "aTerms", ",", "aRules", ",", "cTable", ",", 
         "zRules"}], "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"segList", "=", 
         RowBox[{"{", "1", "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"sheetFlag", "=", "True"}], ";", "\[IndentingNewLine]", 
        RowBox[{"singAccuracy", "=", "900"}], ";", "\[IndentingNewLine]", 
        RowBox[{"$puiseuxSaveTable", "=", 
         RowBox[{"Table", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"theIndex", "=", "mIndex"}], ";", "\[IndentingNewLine]", 
            RowBox[{"$puiseuxSave", "=", 
             RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"minExp", "=", 
             RowBox[{"getMinValidExp", "[", "mIndex", "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"cResidueFactor", "=", "$removeCSubResidueFactor"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"minExp", "<", 
               RowBox[{"-", "50"}]}], ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"cResidueFactor", "=", 
                RowBox[{
                 RowBox[{"-", "minExp"}], "+", "$removeCSubResidueFactor"}]}],
                ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"cResidueFactor", ">", 
               RowBox[{
                RowBox[{"8", "/", "10"}], " ", "singAccuracy"}]}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"Print", "[", 
                RowBox[{"Style", "[", 
                 RowBox[{
                 "\"\<cResidueFactor is greater than 8/10 of the singular \
accuracy!\>\"", ",", "Red", ",", "14", ",", "Bold"}], "]"}], "]"}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"Abort", "[", "]"}], ";"}]}], "\[IndentingNewLine]", 
             "]"}], ";", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{"$printCResidueKeyFlag", ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"Print", "[", 
                RowBox[{
                "\"\<Smallest exponentr after z->z+s_p: \>\"", ",", "minExp", 
                 ",", "\"\<c-form residue factor: \>\"", ",", 
                 RowBox[{"-", "cResidueFactor"}], ",", "\"\< for index \>\"", 
                 ",", "mIndex"}], "]"}], ";"}]}], "\[IndentingNewLine]", 
             "]"}], ";", "\[IndentingNewLine]", 
            RowBox[{"(*", "\[IndentingNewLine]", " ", 
             RowBox[{"new", " ", "routine", " ", "here"}], 
             "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{"$useReformedFunctionFlag", ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"MemberQ", "[", 
                  RowBox[{
                   RowBox[{"reformedFunctionTable", "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", "mIndex"}], 
                  "]"}], ",", "\[IndentingNewLine]", 
                 RowBox[{"(*", 
                  RowBox[{
                   RowBox[{"If", "[", 
                    RowBox[{
                    "$getInitialSegmentFlag", ",", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"Print", "[", 
                    RowBox[{"Style", "[", 
                    RowBox[{
                    "\"\<Using reformed function\>\"", ",", "Blue", ",", 
                    "Bold"}], "]"}], "]"}], ";"}]}], "\[IndentingNewLine]", 
                    "]"}], ";"}], "*)"}], "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"reformedFunctionTableIndex", "=", 
                   RowBox[{"Position", "[", 
                    RowBox[{
                    RowBox[{"reformedFunctionTable", "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", 
                    RowBox[{"x_", "/;", 
                    RowBox[{"x", "==", "mIndex"}]}]}], "]"}]}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"Length", "@", "reformedFunctionTableIndex"}], "!=",
                     "1"}], ",", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"Print", "[", 
                    RowBox[{"Style", "[", 
                    RowBox[{
                    "\"\<Error finding position in \
reformedFunctiontTable\>\"", ",", "Red"}], "]"}], "]"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"Abort", "[", "]"}], ";"}]}], 
                   "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
                  RowBox[{"reformedFunctionIndex", "=", 
                   RowBox[{"reformedFunctionTableIndex", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"reformedFunction", "=", 
                   RowBox[{"reformedFunctionTable", "[", 
                    RowBox[{"[", 
                    RowBox[{"reformedFunctionIndex", ",", "2"}], "]"}], 
                    "]"}]}], ";", "\[IndentingNewLine]", 
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{"MemberQ", "[", 
                    RowBox[{"$poleIndexes", ",", "mIndex"}], "]"}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{"(*", " ", 
                    RowBox[{
                    RowBox[{
                    "If", " ", "this", " ", "is", " ", "a", " ", "pole"}], 
                    ",", " ", 
                    RowBox[{
                    "need", " ", "to", " ", "normalize", " ", "it"}]}], " ", 
                    "*)"}], "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"$fNewton", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", "normalExp", ",", 
                    "currentmu"}], "}"}], "=", 
                    RowBox[{"convertToNormalForm", "[", 
                    RowBox[{"Expand", "[", 
                    RowBox[{"reformedFunction", "/.", 
                    RowBox[{"s", "->", "0"}]}], "]"}], "]"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"If", "[", 
                    RowBox[{"$getPoleDataFlag", ",", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"Print", "[", 
                    RowBox[{"\"\<$theFunction= \>\"", ",", 
                    RowBox[{"aForm", "[", "$theFunction", "]"}]}], "]"}], ";",
                     "\[IndentingNewLine]", 
                    RowBox[{
                    "Print", "[", 
                    "\"\<Transformed function \!\(\*SubscriptBox[\(f\), \
\(t\)]\) initial terms for a pole: \>\"", "]"}], ";", "\[IndentingNewLine]", 
                    RowBox[{"wCoef", "=", 
                    RowBox[{
                    RowBox[{"CoefficientRules", "[", " ", 
                    RowBox[{
                    RowBox[{"Expand", "[", 
                    RowBox[{"reformedFunction", "/.", 
                    RowBox[{"s", "->", "0"}]}], "]"}], ",", "w", ",", 
                    "\"\<NegativeLexicographic\>\""}], "]"}], "//", "N"}]}], 
                    ";", "\[IndentingNewLine]", 
                    RowBox[{"cTable", "=", 
                    RowBox[{"Table", "[", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"zRules", "=", 
                    RowBox[{"CoefficientRules", "[", 
                    RowBox[{
                    RowBox[{"wCoef", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "2"}], "]"}], "]"}], ",", "z", ",", 
                    "\"\<NegativeLexicographic\>\""}], "]"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"wCoef", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", 
                    RowBox[{"FromCoefficientRules", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"zRules", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "}"}], ",", "z"}], 
                    "]"}]}], "}"}]}], ",", "\[IndentingNewLine]", 
                    RowBox[{"{", 
                    RowBox[{"i", ",", "1", ",", 
                    RowBox[{"Length", "@", "wCoef"}]}], "}"}]}], 
                    "\[IndentingNewLine]", "]"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"Print", "[", 
                    RowBox[{"Grid", "[", 
                    RowBox[{"cTable", ",", 
                    RowBox[{"Alignment", "->", "Left"}]}], "]"}], "]"}], ";", 
                    "\[IndentingNewLine]", "\[IndentingNewLine]", 
                    RowBox[{"Print", "[", 
                    RowBox[{"\"\<\[Mu]: \>\"", ",", "currentmu"}], "]"}], ";",
                     "\[IndentingNewLine]", 
                    RowBox[{"Print", "[", 
                    RowBox[{"\"\<\[Lambda]: \>\"", ",", "normalExp"}], "]"}], 
                    ";", "\[IndentingNewLine]", 
                    RowBox[{"wCoef", "=", 
                    RowBox[{
                    RowBox[{"CoefficientRules", "[", " ", 
                    RowBox[{
                    RowBox[{"$fNewton", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", "w", ",", 
                    "\"\<NegativeLexicographic\>\""}], "]"}], "//", "N"}]}], 
                    ";", "\[IndentingNewLine]", 
                    RowBox[{"cTable", "=", 
                    RowBox[{"Table", "[", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"zRules", "=", 
                    RowBox[{"CoefficientRules", "[", 
                    RowBox[{
                    RowBox[{"wCoef", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "2"}], "]"}], "]"}], ",", "z", ",", 
                    "\"\<NegativeLexicographic\>\""}], "]"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"wCoef", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", 
                    RowBox[{"FromCoefficientRules", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"zRules", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "}"}], ",", "z"}], 
                    "]"}]}], "}"}]}], ",", "\[IndentingNewLine]", 
                    RowBox[{"{", 
                    RowBox[{"i", ",", "1", ",", 
                    RowBox[{"Length", "@", "wCoef"}]}], "}"}]}], 
                    "\[IndentingNewLine]", "]"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    "Print", "[", 
                    "\"\<Normal function \!\(\*SubscriptBox[\(f\), \(n\)]\) \
initial terms for a pole: \>\"", "]"}], ";", "\[IndentingNewLine]", 
                    RowBox[{"Print", "[", 
                    RowBox[{"Grid", "[", 
                    RowBox[{"cTable", ",", 
                    RowBox[{"Alignment", "->", "Left"}]}], "]"}], "]"}], 
                    ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], 
                    "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
                    RowBox[{"(*", " ", 
                    RowBox[{"not", " ", "a", " ", "pole"}], " ", "*)"}], 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"normalExp", "=", "0"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"currentmu", "=", "0"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"$fNewton", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "=", 
                    RowBox[{"reformedFunction", "/.", 
                    RowBox[{"s", "->", "0"}]}]}], ";"}]}], 
                   "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]",
                  ",", "\[IndentingNewLine]", 
                 RowBox[{"(*", " ", 
                  RowBox[{
                  "mIndex", " ", "is", " ", "not", " ", "in", " ", "the", " ",
                    "reformed", " ", "list"}], " ", "*)"}], 
                 "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"normalExp", "=", "0"}], ";", "\[IndentingNewLine]", 
                  RowBox[{"currentmu", "=", "0"}], ";", "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"$fNewton", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "=", 
                   RowBox[{"Expand", "[", "$theFunction", "]"}]}], ";"}]}], 
                "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
              ",", "\[IndentingNewLine]", 
              RowBox[{"(*", " ", 
               RowBox[{
                RowBox[{"use", " ", "un"}], "-", 
                RowBox[{"reformed", " ", "function"}]}], " ", "*)"}], 
              "\[IndentingNewLine]", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"$fNewton", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], ",", "normalExp", ",", 
                  "currentmu"}], "}"}], "=", 
                RowBox[{"convertToNormalForm", "[", 
                 RowBox[{"Expand", "[", "$theFunction", "]"}], "]"}]}], 
               ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
            "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"theK", "=", "1"}], ";", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"!", 
               RowBox[{"IrreduciblePolynomialQ", "[", 
                RowBox[{"$fNewton", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"{", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"Print", "[", 
                 RowBox[{"\"\<index: \>\"", ",", "mIndex"}], "]"}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"Print", "[", 
                 RowBox[{"Style", "[", 
                  RowBox[{"\"\<Function is reducible\>\"", ",", "Red"}], 
                  "]"}], "]"}], ";", "\[IndentingNewLine]", 
                RowBox[{"Abort", "[", "]"}], ";"}], "\[IndentingNewLine]", 
               "}"}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"getNewtonData", "[", 
                RowBox[{
                 RowBox[{"$fNewton", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], ",", "1", ",", "normalExp", 
                 ",", "cResidueFactor"}], "]"}], ";"}]}], 
             "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{"$getInitialSegmentFlag", ",", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"Print", "[", 
                  RowBox[{"\"\<function passed to get seg: \>\"", ",", 
                   RowBox[{
                    RowBox[{"$fNewton", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "//", "N"}]}], "]"}], 
                 ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], "*)"}], 
            "\[IndentingNewLine]", " ", 
            RowBox[{"baseData", "=", 
             RowBox[{"MapThread", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"#2", ",", "#1"}], "}"}], "&"}], ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Range", "[", 
                  RowBox[{"Length", "@", "$puiseuxSave"}], "]"}], ",", 
                 RowBox[{"$puiseuxSave", "[", 
                  RowBox[{"[", 
                   RowBox[{"All", ",", "3"}], "]"}], "]"}]}], "}"}]}], 
              "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"(*", "\[IndentingNewLine]", 
             RowBox[{
             "now", " ", "check", " ", "if", " ", "total", " ", "sheets", " ",
               "equal", " ", "to", " ", "degree", " ", "of", " ", 
              "function"}], "\[IndentingNewLine]", "*)"}], 
            "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Length", "@", "$puiseuxSave"}], "!=", 
