Cell[CellGroupData[{

Cell["getRandomRealPoly", "Subsection",
 CellChangeTimes->{{3.8893451765456877`*^9, 
  3.889345179544986*^9}},ExpressionUUID->"7042ae55-f94d-46a1-9fbd-\
6da4250d6c73"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"getRandomRealPoly", "[", 
      RowBox[{"wMax_", ",", "sparseVal_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "randomNum", ",", "getcoef", ",", "getZPower", ",", "totalLen", ",", 
         "zPolyTable", ",", "i", ",", "zPolyList", ",", "randomWIndex", ",", 
         "index", ",", "newFunction", ",", "reduceFlag"}], "}"}], ",", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"randomNum", "[", "n_", "]"}], ":=", " ", 
         RowBox[{"RandomChoice", "[", 
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{"0", ",", 
              RowBox[{"{", "n", "}"}]}], "]"}], ",", 
            RowBox[{"{", "1", "}"}]}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"getcoef", "[", 
          RowBox[{"a_", ",", "b_"}], "]"}], ":=", 
         RowBox[{
          RowBox[{"RandomInteger", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "a"}], ",", "a"}], "}"}], "]"}], "/", 
          RowBox[{"RandomInteger", "[", 
           RowBox[{"{", 
            RowBox[{"1", ",", "b"}], "}"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", " ", 
        RowBox[{
         RowBox[{"getZPower", "[", "n_", "]"}], ":=", 
         RowBox[{
          RowBox[{"randomNum", "[", "sparseVal", "]"}], 
          RowBox[{"RandomInteger", "[", 
           RowBox[{"{", 
            RowBox[{"0", ",", "n"}], "}"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"totalLen", "=", 
         RowBox[{"wMax", "+", "1"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"zPolyTable", "=", 
         RowBox[{"Table", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"getcoef", "[", 
             RowBox[{"8", ",", "5"}], "]"}], " ", 
            RowBox[{"z", "^", 
             RowBox[{"getZPower", "[", 
              RowBox[{"RandomInteger", "[", 
               RowBox[{"{", 
                RowBox[{"2", ",", "totalLen"}], "}"}], "]"}], "]"}]}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", "totalLen"}], "}"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"n", ",", "1", ",", 
             RowBox[{"RandomInteger", "[", 
              RowBox[{"{", 
               RowBox[{"2", ",", "totalLen"}], "}"}], "]"}]}], "}"}]}], 
          "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"zPolyList", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"Plus", "@@", "#"}], "&"}], "/@", " ", "zPolyTable"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"randomWIndex", "=", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"0", ",", "totalLen"}], "]"}]}], ";", "\[IndentingNewLine]",
         "\[IndentingNewLine]", 
        RowBox[{"index", "=", "0"}], ";", "\[IndentingNewLine]", 
        RowBox[{"reduceFlag", "=", "True"}], ";", "\[IndentingNewLine]", 
        RowBox[{"While", "[", 
         RowBox[{"reduceFlag", " ", ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"index", "++"}], ";", "\[IndentingNewLine]", 
           RowBox[{"randomWIndex", "=", 
            RowBox[{"RandomChoice", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"0", ",", "1"}], "}"}], ",", "totalLen"}], "]"}]}], 
           ";", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"randomWIndex", "[", 
               RowBox[{"[", 
                RowBox[{"-", "1"}], "]"}], "]"}], "==", "1"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"newFunction", "=", 
               RowBox[{"Plus", "@@", 
                RowBox[{"Table", "[", "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"randomWIndex", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "==", "1"}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"zPolyList", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], " ", 
                    RowBox[{"w", "^", 
                    RowBox[{"(", 
                    RowBox[{"i", "-", "1"}], ")"}]}]}], "\[IndentingNewLine]",
                     ",", "\[IndentingNewLine]", "0"}], "\[IndentingNewLine]",
                    "]"}], ",", "\[IndentingNewLine]", 
                  RowBox[{"{", 
                   RowBox[{"i", ",", "1", ",", 
                    RowBox[{"Length", "@", "randomWIndex"}]}], "}"}]}], 
                 "\[IndentingNewLine]", "]"}]}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"IrreduciblePolynomialQ", "[", "newFunction", "]"}], 
                ",", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"reduceFlag", "=", "False"}], ";"}]}], 
               "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", 
            "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", "newFunction"}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.8893451824193153`*^9, 3.8893451834503517`*^9}},
 CellLabel->
  "In[125]:=",ExpressionUUID->"82a3f928-16d4-47c5-8358-5f1354579f90"]
}, Closed]],

Cell[CellGroupData[{

Cell["strictPolynomialQ", "Subsection",
 CellChangeTimes->{{3.8893602934364414`*^9, 
  3.8893602965138407`*^9}},ExpressionUUID->"f7dda212-5d76-46d7-ba48-\
dc7e804d3425"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"strictPolynomialQ", "[", 
     RowBox[{"myPoly_", ",", 
      RowBox[{"{", 
       RowBox[{"x_", ",", "y_"}], "}"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"levels", ",", "cList", ",", "finalList", ",", "return"}], 
       "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"PolynomialQ", "[", 
          RowBox[{"myPoly", ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", "y"}], "}"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"levels", "=", 
           RowBox[{"Level", "[", 
            RowBox[{"myPoly", ",", 
             RowBox[{"{", 
              RowBox[{"-", "1"}], "}"}], ",", 
             RowBox[{"Heads", "->", "True"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Length", "@", 
               RowBox[{"Position", "[", 
                RowBox[{"levels", ",", "x"}], "]"}]}], ">", "0"}], " ", "&&", 
             " ", 
             RowBox[{
              RowBox[{"Length", "@", 
               RowBox[{"Position", "[", 
                RowBox[{"levels", ",", "y"}], "]"}]}], ">", "0"}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"cList", "=", 
              RowBox[{"Complement", "[", 
               RowBox[{"levels", ",", 
                RowBox[{"{", 
                 RowBox[{
                 "Plus", ",", "Power", ",", "Times", ",", "x", ",", "y"}], 
                 "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"finalList", "=", 
              RowBox[{"Complement", "[", 
               RowBox[{"cList", ",", 
                RowBox[{"Select", "[", 
                 RowBox[{"cList", ",", "NumberQ"}], "]"}]}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Length", "@", "finalList"}], ">", "0"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"Print", "[", 
                 RowBox[{
                  RowBox[{"Style", "[", 
                   RowBox[{
                   "\"\<expression is not strict polynomial in \>\"", ",", 
                    "Red"}], "]"}], ",", 
                  RowBox[{"Style", "[", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"x", ",", "y"}], "}"}], ",", "Red"}], "]"}]}], 
                 "]"}], ";", "\[IndentingNewLine]", 
                RowBox[{"return", "=", "False"}], ";"}], 
               "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"return", "=", "True"}], ";"}]}], 
              "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", ",",
             "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{
               RowBox[{"Style", "[", 
                RowBox[{
                "\"\<expression is not strict polynomial in \>\"", ",", 
                 "Red"}], "]"}], ",", 
               RowBox[{"Style", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"x", ",", "y"}], "}"}], ",", "Red"}], "]"}]}], 
              "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"return", "=", "False"}], ";"}]}], "\[IndentingNewLine]",
            "]"}], ";"}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"return", "=", "False"}], ";"}]}], "\[IndentingNewLine]", 
        "]"}], ";", "\[IndentingNewLine]", "return"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}]}]], "Input",
