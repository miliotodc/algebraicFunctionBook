Cell[BoxData[{
 RowBox[{"wVals", "=", 
  RowBox[{"w", "/.", 
   RowBox[{"NSolve", "[", 
    RowBox[{
     RowBox[{"$theFunction", "==", "0"}], "/.", 
     RowBox[{"z", "->", 
      RowBox[{"2", "+", 
       RowBox[{
        RowBox[{"1", "/", "4"}], " ", "I"}]}]}]}], 
    "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"w0", "=", 
   RowBox[{"3", "-", 
    RowBox[{
     RowBox[{"1", "/", "4"}], " ", "I"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"radius", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"integrationPath", "[", "t_", "]"}], ":=", 
   RowBox[{"radius", " ", 
    RowBox[{"Exp", "[", 
     RowBox[{"I", " ", "t"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"wDeriv", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"w", "'"}], "[", "t", "]"}], "\[Equal]", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"(", 
          FractionBox[
           RowBox[{"D", "[", 
            RowBox[{"$theFunction", ",", "z"}], "]"}], 
           RowBox[{"D", "[", 
            RowBox[{"$theFunction", ",", "w"}], "]"}]], ")"}]}], " ", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"integrationPath", "[", "t", "]"}], ",", "t"}], "]"}]}], 
       ")"}], "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"w", "\[Rule]", 
         RowBox[{"w", "[", "t", "]"}]}], ",", 
        RowBox[{"z", "\[Rule]", 
         RowBox[{"integrationPath", "[", "t", "]"}]}]}], "}"}]}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"startTheta", "=", "0"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"theSol", "=", 
    RowBox[{"NDSolveValue", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"wDeriv", ",", 
        RowBox[{
         RowBox[{"w", "[", "startTheta", "]"}], "\[Equal]", "w0"}]}], "}"}], 
      ",", "w", ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "startTheta", ",", 
        RowBox[{"startTheta", "+", 
         RowBox[{"8", " ", "Pi"}]}]}], "}"}], ",", 
      RowBox[{"MaxSteps", "\[Rule]", "2000000"}], ",", 
      RowBox[{"MaxStepSize", "\[Rule]", 
       RowBox[{"1", "/", "1000"}]}], ",", 
      RowBox[{"WorkingPrecision", "\[Rule]", "20"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"NIntegrate", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"theSol", "[", "t", "]"}], " ", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"integrationPath", "[", "t", "]"}], ",", "t"}], "]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "startTheta", ",", 
     RowBox[{"startTheta", "+", 
      RowBox[{"8", "Pi"}]}]}], "}"}]}], 
  "]"}], "\[IndentingNewLine]"}], "Input",
