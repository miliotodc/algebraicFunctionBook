Cell[CellGroupData[{

Cell["mIVPReferenceTable", "Subsection",
 CellChangeTimes->{{3.931708002650916*^9, 
  3.9317080064156866`*^9}},ExpressionUUID->"1a401518-903c-4fe3-81e1-\
6837c127add6"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"mIVPReferenceTable", "[", 
     RowBox[{
     "$theFunction_", ",", "singularPt_", ",", "relativeSMIVPVal_", ",", 
      "baseSeries_", ",", "baseSheetLinks_", ",", "wp_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "wVals", ",", "seriesVals", ",", "pIndexToMIVP", ",", "seriesIndex", 
        ",", "difArray", ",", "pos", ",", "index"}], "}"}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"wVals", "=", 
        RowBox[{"Sort", "[", 
         RowBox[{"w", "/.", 
          RowBox[{"NSolve", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"$theFunction", "==", "0"}], "/.", 
             RowBox[{"z", "->", 
              RowBox[{"singularPt", "+", "relativeSMIVPVal"}]}]}], ",", 
            RowBox[{"WorkingPrecision", "->", "wp"}]}], "]"}]}], "]"}]}], ";",
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"seriesVals", "=", 
        RowBox[{"baseSeries", "/.", 
         RowBox[{"z", "->", "relativeSMIVPVal"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"index", "=", "0"}], ";", "\[IndentingNewLine]", 
       RowBox[{"pIndexToMIVP", "=", 
        RowBox[{"Table", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"index", "++"}], ";", "\[IndentingNewLine]", 
           RowBox[{"seriesIndex", "=", 
            RowBox[{"baseSheetLinks", "[", 
             RowBox[{"[", 
              RowBox[{"baseLinks", ",", "2", ",", "sIndex"}], "]"}], "]"}]}], 
           ";", "\[IndentingNewLine]", 
           RowBox[{"difArray", "=", 
            RowBox[{
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{
                RowBox[{"seriesVals", "[", 
                 RowBox[{"[", "seriesIndex", "]"}], "]"}], "-", "#"}], "]"}], 
              "&"}], "/@", " ", "wVals"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"pos", "=", 
            RowBox[{
             RowBox[{"Position", "[", 
              RowBox[{"difArray", ",", 
               RowBox[{"Min", "@", "difArray"}]}], "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"index", ",", "pos"}], "}"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"baseLinks", ",", "1", ",", 
            RowBox[{"Length", "@", "baseSheetLinks"}]}], "}"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"sIndex", ",", "1", ",", 
            RowBox[{"Length", "@", 
             RowBox[{"baseSheetLinks", "[", 
              RowBox[{"[", 
               RowBox[{"baseLinks", ",", "2"}], "]"}], "]"}]}]}], "}"}]}], 
         "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Sort", "[", 
           RowBox[{
            RowBox[{"pIndexToMIVP", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "All", ",", "2"}], "]"}], "]"}], "//", 
            "Flatten"}], "]"}], "==", 
          RowBox[{"Range", "[", 
           RowBox[{"Length", "@", "baseSeries"}], "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", "\"\<Monodromy is consistent\>\"", "]"}], 
          ";"}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"Style", "[", 
            RowBox[{"\"\<Monodromy is not consistent!\>\"", ",", "Red"}], 
            "]"}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<     Computed monodromy: \>\"", ",", 
            RowBox[{"Sort", "[", 
             RowBox[{
              RowBox[{"pIndexToMIVP", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", "All", ",", "2"}], "]"}], "]"}], "//", 
              "Flatten"}], "]"}]}], "]"}], ";"}]}], "\[IndentingNewLine]", 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"#1", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", "#2"}], "}"}], "&"}], ",", 
         RowBox[{"{", 
          RowBox[{"baseSheetLinks", ",", "pIndexToMIVP"}], "}"}]}], "]"}]}]}],
      "\[IndentingNewLine]", "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.931707994246554*^9, 3.931707994605994*^9}, {
  3.9430003363039007`*^9, 3.94300035615841*^9}, {3.9521653815860105`*^9, 
  3.952165381591239*^9}},
 CellLabel->
  "In[149]:=",ExpressionUUID->"6218c918-d67d-4f5f-874f-d6e2c586798a"]
}, Closed]],

