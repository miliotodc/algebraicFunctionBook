       ";", "\[IndentingNewLine]", 
       RowBox[{"fDegree", "=", 
        RowBox[{"Max", "@", 
         RowBox[{"Exponent", "[", 
          RowBox[{"theF", ",", "w", ",", "List"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
