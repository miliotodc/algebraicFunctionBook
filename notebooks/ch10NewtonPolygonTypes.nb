Cell[BoxData[{
 RowBox[{
  RowBox[{"getCoefficientRules", "[", "a_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"expList", ",", "coefList"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"expList", "=", 
      RowBox[{"Exponent", "[", 
       RowBox[{"a", ",", "z", ",", "List"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"coefList", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Coefficient", "[", 
         RowBox[{"a", ",", "z", ",", "#"}], "]"}], "&"}], "/@", " ", 
       "expList"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"expList", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "}"}], "->", 
        RowBox[{"coefList", "[", 
         RowBox[{"[", "i", "]"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "@", "expList"}]}], "}"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetAttributes", "[", 
   RowBox[{"getCoefficientRules", ",", "Listable"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{" "}]}], "Input",
