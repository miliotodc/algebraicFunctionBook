                    "\"\< a0 points out of \>\"", ",", 
                    RowBox[{"Length", "@", "zIndexes"}], ",", 
                    "\"\< zero indexes.  May need to increase compareFactor\>\
\""}], "]"}], ";", "\[IndentingNewLine]", 
                    RowBox[{"Abort", "[", "]"}], ";"}]}], 
                   "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
                  RowBox[{"(*", "\[IndentingNewLine]", 
                   RowBox[{
                   "confirm", " ", "that", " ", "all", " ", "a_n", " ", 
