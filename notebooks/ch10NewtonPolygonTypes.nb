            RowBox[{"{", 
             RowBox[{
              RowBox[{"z", "->", "singPoint"}], ",", 
              RowBox[{"w", "->", "#"}]}], "}"}]}], "&"}], "/@", " ", 
          RowBox[{"oneCycleWArray", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "2"}], "]"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"wDerivPrec", "=", 
         RowBox[{"Floor", "@", 
          RowBox[{"Precision", "@", "wDerivs"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{"diagFlag", ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"\"\<{zDerivs,wDerivs}: \>\"", ",", 
             RowBox[{"MapThread", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"#1", ",", "#2"}], "}"}], "&"}], ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"zDerivs", "//", "N"}], ",", 
                 RowBox[{"wDerivs", "//", "N"}]}], "}"}]}], "]"}]}], "]"}], 
           ";", "\[IndentingNewLine]", 
           RowBox[{"resultGrid", "=", 
            RowBox[{"MapThread", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"#1", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], ",", 
