              RowBox[{"index2", ",", "wval2"}], "}"}], ",", 
             RowBox[{"{", "...", "}"}]}], "}"}]}]}], "\[IndentingNewLine]", 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{"oneCycleWVals", "=", 
