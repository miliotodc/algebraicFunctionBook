Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{"wMax", "=", 
    RowBox[{"RandomInteger", "[", 
     RowBox[{"{", 
      RowBox[{"4", ",", "5"}], "}"}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{"zMax", "=", 
    RowBox[{"RandomInteger", "[", 
     RowBox[{"{", 
      RowBox[{"3", ",", "6"}], "}"}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"higherOrderResidueFunctionList", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"foundIt", "=", "False"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"funIndex", "=", "1"}], ",", 
      RowBox[{"funIndex", "<=", "5"}], ",", 
      RowBox[{"funIndex", "++"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"\"\<funIndex: \>\"", ",", "funIndex"}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"wExpList", "=", 
        RowBox[{"Sort", "@", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"RandomSample", "[", 
            RowBox[{
             RowBox[{"Range", "[", 
              RowBox[{"1", ",", "wMax"}], "]"}], ",", 
             RowBox[{"RandomInteger", "[", 
              RowBox[{"{", 
               RowBox[{"1", ",", "wMax"}], "}"}], "]"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "wMax"}], 
            RowBox[{"(*", 
             RowBox[{"+", 
              RowBox[{"RandomInteger", "[", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"wMax", "+", "1"}], ",", 
                 RowBox[{"wMax", "+", "2"}]}], "}"}], "]"}]}], "*)"}], 
            "}"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"zMax", ">", "0"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"zExpList", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"RandomSample", "[", 
              RowBox[{
               RowBox[{"Range", "[", 
                RowBox[{"1", ",", "zMax"}], "]"}], ",", 
               RowBox[{"RandomInteger", "[", 
                RowBox[{"{", 
                 RowBox[{"1", ",", "zMax"}], "}"}], "]"}]}], "]"}], ",", 
             RowBox[{"{", "wExpList", "}"}]}], "]"}]}], ";"}], 
         "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"zExpList", "=", 
           RowBox[{"{", "0", "}"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"$theFunction", "=", 
        RowBox[{"Plus", "@@", 
         RowBox[{"Table", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"aCoef", "=", 
             RowBox[{"Join", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"RandomInteger", "[", 
                    RowBox[{"{", 
                    RowBox[{"1", ",", "10"}], "}"}], "]"}], "+", " ", 
                    RowBox[{"RandomInteger", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"-", "10"}], ",", "10"}], "}"}], "]"}]}], ")"}], 
                  RowBox[{"z", "^", "#"}]}], "&"}], "/@", " ", 
                RowBox[{"zExpList", "[", 
                 RowBox[{"[", "j", "]"}], "]"}]}], ",", 
               RowBox[{"{", 
                RowBox[{"RandomChoice", "[", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"-", "1"}], "/", "2"}], ",", "0", ",", "3"}], 
                  "}"}], "]"}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Plus", "@@", "aCoef"}], " ", 
             RowBox[{"w", "^", 
              RowBox[{"wExpList", "[", 
               RowBox[{"[", "j", "]"}], "]"}]}]}]}], " ", ",", 
           "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"j", ",", "1", ",", 
             RowBox[{"Length", "@", "wExpList"}]}], "}"}]}], 
          "\[IndentingNewLine]", "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"wExp", "=", 
        RowBox[{"Exponent", "[", 
         RowBox[{"$theFunction", ",", "w", ",", "List"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"functionDegree", "=", 
        RowBox[{"Last", "@", "wExp"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"IrreduciblePolynomialQ", "@", "$theFunction"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", "\"\<Function is reducible\>\"", "]"}], ";"}],
          "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
         RowBox[{"(*", "\[IndentingNewLine]", 
          RowBox[{"good", " ", "function", " ", "proce", " ", "it"}], 
          "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"\"\<Processing: \>\"", ",", 
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"aForm", "[", "$theFunction", "]"}], ",", "8"}], 
             "]"}]}], "]"}], ";", "\[IndentingNewLine]", " ", 
          RowBox[{"$workingPrecision", "=", "1000"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"$theTestCase", "=", "\"\<tempTestCase001\>\""}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"at", "=", 
           RowBox[{"AbsoluteTiming", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{
               "$theSingularList", ",", "$poleIndexes", ",", 
                "$minRadiusArray", ",", "res", ",", "$zeroIndexes", ",", 
                "$nearestDistArray", ",", "$rNormArray"}], "}"}], "=", 
              RowBox[{"getSingularPoints", "[", 
               RowBox[{
               "$theFunction", ",", "$workingPrecision", ",", "False"}], 
               "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"$theSingularList", "==", "\"\<-1\>\""}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"Print", "[", 
                 RowBox[{"Style", "[", 
                  RowBox[{
                  "\"\<Encountered error with getSingular Points!\>\"", ",", 
                   "Red"}], "]"}], "]"}], ";", "\[IndentingNewLine]", 
                RowBox[{"Abort", "[", "]"}], ";"}]}], "\[IndentingNewLine]", 
              "]"}], ";"}], "\[IndentingNewLine]", "]"}]}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"Print", "[", 
             RowBox[{"\"\<Total singular points: \>\"", ",", 
              RowBox[{"Length", "@", "$theSingularList"}]}], "]"}], ";"}], 
           "*)"}], "\[IndentingNewLine]", 
          RowBox[{"singPrec", "=", 
           RowBox[{"Floor", "@", 
            RowBox[{"Precision", "@", "$theSingularList"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Abs", "[", 
                RowBox[{"$theSingularList", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "]"}], "<", 
               RowBox[{"10", "^", 
                RowBox[{"(", 
                 RowBox[{"-", 
                  RowBox[{"(", 
                   RowBox[{"singPrec", "-", "$acf"}], ")"}]}], ")"}]}]}], ",",
               "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"Print", "[", 
                RowBox[{"Style", "[", 
                 RowBox[{
                 "\"\<Zero is a singular point\>\"", ",", "Bold", ",", 
                  "Red"}], "]"}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}]
             , ";"}], "*)"}], "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "@", "$theSingularList"}], ">", "1"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"minSingSeparation", "=", 
              RowBox[{
               RowBox[{"3", 
                RowBox[{"Min", "@", "$minRadiusArray"}]}], "//", "N"}]}], ";",
              "\[IndentingNewLine]", 
             RowBox[{"minSingAccFactor", "=", 
              RowBox[{
               RowBox[{"-", 
                RowBox[{
                 RowBox[{"MantissaExponent", "[", "minSingSeparation", "]"}], 
                 "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], "+", "5"}]}], ";"}]}], 
           "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", " ", 
          RowBox[{"Export", "[", 
           RowBox[{
            RowBox[{"singularDataFileName", "[", "$theTestCase", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{
             "$theSingularList", ",", "$poleIndexes", ",", "$minRadiusArray", 
              ",", "res", ",", "$zeroIndexes", ",", "$nearestDistArray", ",", 
              "$rNormArray"}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"Export", "[", 
           RowBox[{
            RowBox[{"resultantFileName", "[", "$theTestCase", "]"}], ",", 
            "res"}], "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"reformFlags", "=", 
           RowBox[{"{", 
            RowBox[{"False", ",", "False", ",", "False"}], "}"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"reformedWRules", ",", "theReformedIndexes"}], "}"}], "=", 
           RowBox[{"getReformedIndexes", "[", 
