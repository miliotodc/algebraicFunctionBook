Cell[CellGroupData[{

Cell["adjustF", "Subsection",
 CellChangeTimes->{{3.9062978592914524`*^9, 
  3.906297860931696*^9}},ExpressionUUID->"7014ceb4-1588-473f-8cd6-\
4f353afee39a"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"adjustF", "[", 
      RowBox[{"wCoef_", ",", "wpList_", ",", "eList_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "j", ",", "wPower", ",", "wPowerPos", ",", "zCoef", ",", "zPowerLast",
          ",", "newZPower", ",", "newZCoef", ",", "newAN", ",", "newWCoef"}], 
        "}"}], ",", " ", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"newWCoef", "=", "wCoef"}], ";", "\[IndentingNewLine]", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"j", "=", "1"}], ",", 
          RowBox[{"j", "<=", 
           RowBox[{"Length", "@", "eList"}]}], ",", 
          RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"wPower", "=", 
            RowBox[{"eList", "[", 
             RowBox[{"[", "j", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"wPowerPos", "=", 
            RowBox[{
             RowBox[{"Position", "[", 
              RowBox[{"wCoef", ",", 
               RowBox[{"x_", "/;", 
                RowBox[{"x", "==", 
                 RowBox[{"{", "wPower", "}"}]}]}]}], "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"zCoef", "=", 
            RowBox[{"CoefficientRules", "[", 
             RowBox[{
              RowBox[{"wCoef", "[", 
               RowBox[{"[", 
                RowBox[{"wPowerPos", ",", "2"}], "]"}], "]"}], ",", "z", ",", 
              "\"\<NegativeLexicographic\>\""}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"zPowerLast", "=", 
            RowBox[{
             RowBox[{"zCoef", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{"-", "1"}], ",", "1"}], "]"}], "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"newZPower", "=", 
            RowBox[{"wpList", "[", 
             RowBox[{"[", "j", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"newZCoef", "=", "zCoef"}], ";", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"newZCoef", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"-", "1"}], ",", "1"}], "]"}], "]"}], "=", 
            RowBox[{"{", "newZPower", "}"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"newAN", "=", 
            RowBox[{"FromCoefficientRules", "[", 
             RowBox[{"newZCoef", ",", "z"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"newWCoef", "[", 
             RowBox[{"[", 
              RowBox[{"wPowerPos", ",", "2"}], "]"}], "]"}], "=", "newAN"}], 
           ";"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
        "newWCoef"}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.9062978522616634`*^9, 3.906297852714725*^9}},
 CellLabel->
  "In[136]:=",ExpressionUUID->"9cc4330b-0b60-4b06-8ed3-505c4bed9932"]
}, Closed]],

