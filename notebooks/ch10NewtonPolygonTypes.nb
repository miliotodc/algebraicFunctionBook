       ";", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"thepoly", ",", "mylambda", ",", "currentmu"}], "}"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
