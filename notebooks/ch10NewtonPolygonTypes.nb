        RowBox[{"If", "[", 
         RowBox[{"diagFlag", ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"\"\<oneCycleWArray: \>\"", ",", 
             RowBox[{
              RowBox[{"oneCycleWArray", "//", "N"}], "//", "MatrixForm"}]}], 
            "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", "\[IndentingNewLine]", " ", 
         RowBox[{
          RowBox[{
          "now", " ", "compute", " ", "the", " ", "derivatives", " ", "at", 
           " ", "z"}], "=", 
