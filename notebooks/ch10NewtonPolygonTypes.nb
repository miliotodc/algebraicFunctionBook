Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"getCharRoots", "[", 
     RowBox[{
     "theLegArray_", ",", "thePolygonPoints_", ",", "theRotatedPoints_"}], 
     "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "charEqns", ",", "pointIndexes", ",", "charRootList", ",", "rootAcc", 
        ",", "nonZeroRootList", ",", "rootTallyList", ",", 
        "slopeInterceptList", ",", "charEqnsPrecision", ",", "netTolerance", 
        ",", "wp", ",", "attempts", ",", "charRootPrecision", ",", "difTable",
         ",", "charEqnsAccuracy", ",", "charRootAccuracy", ",", 
        "newRootTallyList"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{"$getCharRootFlag", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"Style", "[", 
            RowBox[{
            "\"\<Entering getCharRoots\>\"", ",", "Red", ",", "14", ",", 
             "Bold"}], "]"}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<     theLegArray: \>\"", ",", 
            RowBox[{"theLegArray", "//", "N"}]}], "]"}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{"$getCharRootFlag", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{
             "\"\<thePolygonPoints G= \>\"", ",", "Black", ",", "Bold"}], 
             "]"}], ",", 
            RowBox[{"thePolygonPoints", "//", "N"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{
             "\"\<characteristic points C= \>\"", ",", "Black", ",", "Bold"}],
              "]"}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{"#", "[", 
                  RowBox[{"[", "3", "]"}], "]"}], "//", "N"}], ",", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "1", "]"}], "]"}]}], "}"}], "&"}], "/@", " ", 
             "theRotatedPoints"}]}], "]"}], ";"}]}], "\[IndentingNewLine]", 
        "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"charEqns", "=", 
        RowBox[{"Table", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Length", "@", 
               RowBox[{"theLegArray", "[", 
                RowBox[{"[", "legIndex", "]"}], "]"}]}], "==", "1"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"pointIndexes", "=", 
               RowBox[{"theLegArray", "[", 
                RowBox[{"[", 
                 RowBox[{"legIndex", ",", "1", ",", 
                  RowBox[{"{", 
                   RowBox[{"1", ",", "2"}], "}"}]}], "]"}], "]"}]}], ";"}], 
             "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"pointIndexes", "=", 
               RowBox[{"DeleteDuplicates", "@", 
                RowBox[{"Flatten", "@", 
                 RowBox[{"theLegArray", "[", 
                  RowBox[{"[", 
                   RowBox[{"legIndex", ",", "All", ",", 
                    RowBox[{"{", 
                    RowBox[{"1", ",", "2"}], "}"}]}], "]"}], "]"}]}]}]}], ";",
               "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{"$getCharRootFlag", ",", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"Print", "[", 
                  RowBox[{
                  "\"\<       Deleted duplicates: \>\"", ",", 
                   "pointIndexes"}], "]"}], ";"}]}], "\[IndentingNewLine]", 
               "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{"$getCharRootFlag", ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Print", "[", 
               RowBox[{
                RowBox[{"Style", "[", 
                 RowBox[{
                 "\"\<pointIndexes: \>\"", ",", "Purple", ",", "Bold"}], 
                 "]"}], ",", 
                RowBox[{"pointIndexes", "//", "N"}]}], "]"}], ";"}]}], 
            "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"Plus", "@@", 
            RowBox[{"Table", "[", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"theRotatedPoints", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"pointIndexes", "[", 
                   RowBox[{"[", "pIndex", "]"}], "]"}], ",", "3"}], "]"}], 
                "]"}], " ", 
               RowBox[{"x", "^", 
                RowBox[{"theRotatedPoints", "[", 
                 RowBox[{"[", 
                  RowBox[{
                   RowBox[{"pointIndexes", "[", 
                    RowBox[{"[", "pIndex", "]"}], "]"}], ",", "1"}], "]"}], 
                 "]"}]}]}], ",", "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{"pIndex", ",", 
                RowBox[{"Length", "@", "pointIndexes"}]}], "}"}]}], 
             "\[IndentingNewLine]", "]"}]}]}], ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"legIndex", ",", "1", ",", 
            RowBox[{"Length", "@", "theLegArray"}]}], "}"}]}], 
         "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"charEqnsPrecision", "=", 
        RowBox[{"Floor", "@", 
         RowBox[{"Precision", "@", "charEqns"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"charEqnsPrecision", "<", "900"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"Style", "[", 
            RowBox[{
            "\"\<Characteristic precision is less than 900 digits\>\"", ",", 
             "Red", ",", "12"}], "]"}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"Abort", "[", "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"charEqnsAccuracy", "=", 
        RowBox[{"Floor", "@", 
         RowBox[{"Accuracy", "@", "charEqns"}]}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{"$getCharRootFlag", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{
             "\"\<char eqns: \>\"", ",", "Purple", ",", "Bold", ",", "14"}], 
             "]"}], ",", 
            RowBox[{"charEqns", "//", "N"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<charEqnsPrecision: \>\"", ",", "charEqnsPrecision"}], 
           "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"charEqnsPrecision", "\[Equal]", "\[Infinity]"}], " ", ",",
            "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"charEqnsPrecision", "=", 
             RowBox[{"Floor", "@", 
              RowBox[{"Precision", "@", "$theSingularList"}]}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{"$getCharRootFlag", ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"Print", "[", 
                RowBox[{
                "\"\<Reducing infinite precision of char eqns to \>\"", ",", 
                 "charEqnsPrecision"}], "]"}], ";"}]}], "\[IndentingNewLine]",
              "]"}], ";", "\[IndentingNewLine]", 
            RowBox[{"charEqns", "=", 
             RowBox[{"SetPrecision", "[", 
              RowBox[{"charEqns", ",", "charEqnsPrecision"}], "]"}]}], 
            ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{
         "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**",
           "**", "**"}], "*"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"charEqnsPrecision", "==", "\[Infinity]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"charEqnsPrecision", "=", 
           RowBox[{"Floor", "@", 
            RowBox[{"Precision", "@", "$theSingularList"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{"$getCharRootFlag", ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{
              "\"\<Reducing infinite precision of char eqns to \>\"", ",", 
               "charEqnsPrecision"}], "]"}], ";"}]}], "\[IndentingNewLine]", 
           "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"charEqns", "=", 
           RowBox[{"SetPrecision", "[", 
            RowBox[{"charEqns", ",", "charEqnsPrecision"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"charRootList", "=", 
           RowBox[{"Quiet", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"x", "/.", 
                RowBox[{"NSolve", "[", 
                 RowBox[{"#", ",", "x", ",", 
                  RowBox[{"WorkingPrecision", "->", "charEqnsPrecision"}]}], 
                 "]"}]}], ")"}], "&"}], "/@", " ", "charEqns"}], "]"}]}], ";",
           "\[IndentingNewLine]", 
          RowBox[{"charRootPrecision", "=", 
           RowBox[{"Floor", "@", 
            RowBox[{"Precision", "@", "charRootList"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{"$saveCharDataFlag", ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"AppendTo", "[", 
              RowBox[{"$charDataSave", ",", 
               RowBox[{"{", 
                RowBox[{"charEqns", ",", "charRootList"}], "}"}]}], "]"}], 
             ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"charRootPrecision", "<", 
             RowBox[{
              RowBox[{"1", "/", "3"}], " ", "$workingPrecision"}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{
               RowBox[{"Style", "[", 
                RowBox[{
                "\"\<Characteristic root precision is less than \>\"", ",", 
                 "Red"}], "]"}], ",", 
               RowBox[{
                RowBox[{
                 RowBox[{"1", "/", "3"}], " ", "$workingPrecision"}], "//", 
                "N"}]}], "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"Print", "[", 
              RowBox[{"\"\<Precision: \>\"", ",", "charRootPrecision"}], 
              "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"Print", "[", 
              RowBox[{"\"\<     Roots: \>\"", ",", 
               RowBox[{"charRootList", "//", "N"}]}], "]"}], ";"}]}], 
           "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"charRootAccuracy", "=", 
           RowBox[{"Floor", "@", 
            RowBox[{"Accuracy", "@", "charRootList"}]}]}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"(*", "\[IndentingNewLine]", " ", 
           RowBox[{
           "now", " ", "verify", " ", "root", " ", "to", " ", "desired", " ", 
            "accuracy"}], "\[IndentingNewLine]", "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"difTable", "=", 
           RowBox[{"Table", "[", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"Abs", "[", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"charEqns", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], "/.", 
                  RowBox[{"x", "->", "#"}]}], ")"}], "]"}], "&"}], "/@", " ", 
              RowBox[{"charRootList", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
             RowBox[{"{", 
              RowBox[{"i", ",", "1", ",", 
               RowBox[{"Length", "@", "charEqns"}]}], "}"}]}], 
            "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{"$getCharRootFlag", ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{
               RowBox[{"Style", "[", 
                RowBox[{
                "\"\<     current char root precision: \>\"", ",", "Blue"}], 
                "]"}], ",", "charRootPrecision"}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Max", "@", 
                 RowBox[{"(", 
                  RowBox[{"difTable", "//", "Flatten"}], ")"}]}], ">", 
                RowBox[{"10", "^", 
                 RowBox[{"-", 
                  RowBox[{"(", 
                   RowBox[{"charRootAccuracy", "-", "$charRootFactor"}], 
                   ")"}]}]}]}], ",", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"Print", "[", 
                 RowBox[{
                  RowBox[{"Style", "[", 
                   RowBox[{
                   "\"\<Root verify precision failed: \>\"", ",", "Red"}], 
                   "]"}], ",", 
                  RowBox[{"N", "[", 
                   RowBox[{"difTable", ",", "10"}], "]"}]}], "]"}], ";"}], 
               "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"Print", "[", 
                 RowBox[{"Style", "[", 
                  RowBox[{"\"\<Char root verify passed\>\"", ",", "Blue"}], 
                  "]"}], "]"}], ";", "\[IndentingNewLine]", 
                RowBox[{"Print", "[", 
                 RowBox[{"\"\<difTable: \>\"", ",", 
                  RowBox[{"N", "[", 
                   RowBox[{"difTable", ",", "10"}], "]"}]}], "]"}], ";"}]}], 
              "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", 
           "]"}], ";"}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
         RowBox[{"(*", " ", "\[IndentingNewLine]", 
          RowBox[{
          "char", " ", "root", " ", "precision", " ", "not", " ", 
           "infinity"}], "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"charRootList", "=", 
           RowBox[{"Quiet", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"x", "/.", 
                RowBox[{"NSolve", "[", 
                 RowBox[{"#", ",", "x"}], "]"}]}], ")"}], "&"}], "/@", " ", 
             "charEqns"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
