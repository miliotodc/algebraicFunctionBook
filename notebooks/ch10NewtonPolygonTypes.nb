             ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"charRootPrecision", "=", 
           RowBox[{"Floor", "@", 
            RowBox[{"Precision", "@", "charRootList"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"charRootPrecision", "<", 
