Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{
   RowBox[{
    RowBox[{"getReformedIndexes", "[", 
     RowBox[{
     "theFunction_", ",", "theSingularList_", ",", "zIndexes_", ",", 
      "pIndexes_", ",", "diagFlags_List", ",", "compareFactor_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "diag1", ",", "diag2", ",", "diag3", ",", "singularPrecision", ",", 
        "functionCoeffRules", ",", "functionCoeffRulesLen", ",", 
        "reformedWRules", ",", "wKey", ",", "keyValue", ",", "zTerms", ",", 
        "zTermLen", ",", "wp", ",", "zeroTable", ",", "zKey", ",", 
        "zKeyValue", ",", "zeroRule", ",", "aRoots", ",", "aPrec", ",", 
        "theZeroPos", ",", "return", ",", "removalKeys", ",", 
        "theReformedIndexes", ",", "i", ",", "singularAccuracy", ",", 
        "aAcc"}], "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"diag1", "=", 
        RowBox[{"diagFlags", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"diag2", "=", 
        RowBox[{"diagFlags", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"diag3", "=", 
        RowBox[{"diagFlags", "[", 
         RowBox[{"[", "3", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{"diag1", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"\"\<Function: \>\"", ",", 
            RowBox[{"polyForm", "[", 
             RowBox[{"theFunction", ",", "w"}], "]"}]}], "]"}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"singularPrecision", "=", 
        RowBox[{"Floor", "@", 
         RowBox[{"Precision", "@", "theSingularList"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"singularAccuracy", "=", 
        RowBox[{"Floor", "@", 
         RowBox[{"Accuracy", "@", "theSingularList"}]}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"functionCoeffRules", "=", 
        RowBox[{"CoefficientRules", "[", 
         RowBox[{
          RowBox[{"Expand", "[", 
           RowBox[{"theFunction", "/.", 
            RowBox[{"z", "->", 
             RowBox[{"z", "+", "s"}]}]}], "]"}], ",", "w", ",", 
          "\"\<NegativeLexicographic\>\""}], " ", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"functionCoeffRulesLen", "=", 
        RowBox[{"Length", "@", "functionCoeffRules"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{
          "\"\<function coeff rules length: \>\"", ",", 
           "functionCoeffRulesLen"}], "]"}], ";"}], "*)"}], 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"reformedWRules", "=", 
        RowBox[{"Table", "[", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"\"\<wVal term: \>\"", ",", 
             RowBox[{"functionCoeffRules", "[", 
              RowBox[{"[", "wValIndex", "]"}], "]"}]}], "]"}], ";"}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"wKey", "=", 
            RowBox[{"functionCoeffRules", "[", 
             RowBox[{"[", 
              RowBox[{"wValIndex", ",", "1"}], "]"}], "]"}]}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{
               RowBox[{"Style", "[", 
                RowBox[{
                "\"\<Processing wKey: \>\"", ",", "Bold", ",", "Blue"}], 
                "]"}], ",", "wKey"}], "]"}], ";"}], "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"wKey", "==", 
                RowBox[{"{", "0", "}"}]}], ",", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"Print", "[", "\"\<Processing zero key\>\"", "]"}], 
                ";"}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"wKey", "==", 
                   RowBox[{"{", "functionDegree", "}"}]}], ",", 
                  "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"Print", "[", "\"\<Processing poles\>\"", "]"}], 
                   ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]}], 
              "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
            "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"keyValue", "=", 
            RowBox[{"functionCoeffRules", "[", 
             RowBox[{"[", 
              RowBox[{"wValIndex", ",", "2"}], "]"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"zTerms", "=", 
            RowBox[{"CoefficientRules", "[", 
             RowBox[{
             "keyValue", ",", "z", ",", "\"\<NegativeLexicographic\>\""}], 
             " ", "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"zTermLen", "=", 
            RowBox[{"Length", "@", "zTerms"}]}], ";", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{"diag1", ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Print", "[", 
               RowBox[{"\"\< zTerms: \>\"", ",", "zTerms"}], "]"}], ";"}]}], 
            "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"(*", "\[IndentingNewLine]", " ", 
            RowBox[{
            "now", " ", "check", " ", "each", " ", "coefficient", " ", "if", 
             " ", "zero", " ", "for", " ", "a", " ", "singualr", " ", 
             "point"}], "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
           RowBox[{"zeroTable", "=", 
            RowBox[{"Table", "[", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"zKey", "=", 
                RowBox[{"zTerms", "[", 
                 RowBox[{"[", 
                  RowBox[{"zIndex", ",", "1"}], "]"}], "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"zKeyValue", "=", 
                RowBox[{"zTerms", "[", 
                 RowBox[{"[", 
                  RowBox[{"zIndex", ",", "2"}], "]"}], "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"zeroRule", "=", 
                RowBox[{"Normal", "@", 
                 RowBox[{"KeyTake", "[", 
                  RowBox[{"zTerms", ",", 
                   RowBox[{"{", 
                    RowBox[{"zKey", ",", "s"}], "}"}]}], "]"}]}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"If", "[", 
                RowBox[{"diag2", ",", "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"Print", "[", 
                   RowBox[{
                    RowBox[{"Style", "[", 
                    RowBox[{"\"\<  Zero Rule: \>\"", ",", "Bold"}], "]"}], 
                    ",", "zeroRule"}], "]"}], ";"}]}], "\[IndentingNewLine]", 
                "]"}], ";", "\[IndentingNewLine]", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"!", 
                  RowBox[{"NumberQ", "[", 
                   RowBox[{"zeroRule", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}], "]"}]}], ",", 
                 "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"wp", "=", 
                   RowBox[{"Precision", "@", 
                    RowBox[{"zeroRule", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}]}]}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{"wp", "==", "\[Infinity]"}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"wp", "=", 
                    RowBox[{
                    RowBox[{"7", "/", "10"}], " ", "singularPrecision"}]}], 
                    ";"}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"wp", "=", 
                    RowBox[{"Floor", "@", "wp"}]}], ";"}]}], 
                   "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
                  RowBox[{"If", "[", 
                   RowBox[{"diag1", ",", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"Print", "[", 
                    RowBox[{
                    RowBox[{"Style", "[", 
                    RowBox[{
                    "\"\<    Precision of zero rule: \>\"", ",", "Bold"}], 
                    "]"}], ",", "wp"}], "]"}], ";"}]}], "\[IndentingNewLine]",
                    "]"}], ";", "\[IndentingNewLine]", 
                  RowBox[{"(*", 
                   RowBox[{
                    RowBox[{"aRoots", "=", 
                    RowBox[{"DeleteDuplicates", "[", 
                    RowBox[{"s", "/.", 
                    RowBox[{"NSolve", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"SetPrecision", "[", 
                    RowBox[{
                    RowBox[{"zeroRule", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}], ",", "wp"}], "]"}],
                     "==", "0"}], ",", "s", ",", 
                    RowBox[{"WorkingPrecision", "->", "wp"}]}], "]"}]}], 
                    "]"}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
                  RowBox[{"aRoots", "=", 
                   RowBox[{"DeleteDuplicates", "[", 
                    RowBox[{"s", "/.", 
                    RowBox[{"NSolve", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Factor", "@", 
                    RowBox[{"zeroRule", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}]}], "==", "0"}], ",",
                     "s", ",", 
                    RowBox[{"WorkingPrecision", "->", "wp"}]}], "]"}]}], 
                    "]"}]}], ";", "\[IndentingNewLine]", 
                  "\[IndentingNewLine]", 
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"Floor", "@", 
                    RowBox[{"Accuracy", "@", "aRoots"}]}], "<", 
                    "$minimalWorkingAccuracy"}], ",", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"Print", "[", 
                    RowBox[{"Style", "[", 
                    RowBox[{
                    "\"\<getReformedIndexes::roots below minimal working \
accuracy!\>\"", ",", "Red", ",", "Bold", ",", "12"}], "]"}], "]"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"Abort", "[", "]"}], ";"}]}], 
                   "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
                  "\[IndentingNewLine]", 
                  RowBox[{"aPrec", "=", 
                   RowBox[{"Floor", "@", 
                    RowBox[{"Precision", "@", "aRoots"}]}]}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"aAcc", "=", 
                   RowBox[{"Floor", "@", 
                    RowBox[{"Accuracy", "@", "aRoots"}]}]}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{"aAcc", "==", "\[Infinity]"}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"aAcc", "=", "singularAccuracy"}], ";"}]}], 
                   "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
                  RowBox[{"(*", 
                   RowBox[{
                    RowBox[{"Print", "[", 
                    RowBox[{"\"\<aRoots precision: \>\"", ",", "aPrec"}], 
                    "]"}], ";"}], "*)"}], "\[IndentingNewLine]", 
                  "\[IndentingNewLine]", 
                  RowBox[{"If", "[", 
                   RowBox[{"diag2", ",", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"Print", "[", 
                    RowBox[{
                    RowBox[{"Style", "[", 
                    RowBox[{"\"\<    Zero rule roots: \>\"", ",", "Bold"}], 
                    "]"}], ",", 
                    RowBox[{"N", "[", 
                    RowBox[{"aRoots", ",", "10"}], "]"}]}], "]"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"Print", "[", 
                    RowBox[{
                    RowBox[{"Style", "[", 
                    RowBox[{
                    "\"\<    Zero rule root precision: \>\"", ",", "Bold"}], 
                    "]"}], ",", "aPrec"}], "]"}], ";"}]}], 
                   "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
                  "\[IndentingNewLine]", 
                  RowBox[{"theZeroPos", "=", 
                   RowBox[{"Sort", "@", 
                    RowBox[{"DeleteDuplicates", "[", 
                    RowBox[{"Flatten", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Position", "[", 
