Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{"aForm", "[", "fInfinity", "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"at", "=", 
     RowBox[{"AbsoluteTiming", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "$theSingularList", ",", "$poleIndexes", ",", "$minRadiusArray", ",",
           "res", ",", "$zeroIndexes", ",", "$nearestDistanceArray", ",", 
          "$rNormArray"}], "}"}], "=", 
        RowBox[{"getSingularPoints", "[", 
         RowBox[{"fInfinity", ",", "$workingPrecision", ",", "True"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"$theSingularList", "==", "\"\<-1\>\""}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
