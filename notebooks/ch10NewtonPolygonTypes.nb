Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"getReformedFunctionTable", "[", 
     RowBox[{
     "reformedWRules_", ",", "theReformedIndexes_", ",", "diagFlags_List"}], 
     "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "functionCoeffRules", ",", "functionCoeffRulesLen", ",", "diagA", ",", 
        "diagB", ",", "diagC", ",", "reformedFunctionTable", ",", 
        "currentSingIndex", ",", "newWRules", ",", "wKey", ",", "keyValue", 
        ",", "zTerms", ",", "currentReformedRule", ",", "removeIndexes", ",", 
        "reformedKeyRule", ",", "zTermLen", ",", "reformedFunction"}], "}"}], 
      ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"functionCoeffRules", "=", 
        RowBox[{"CoefficientRules", "[", 
         RowBox[{
          RowBox[{"Expand", "[", 
           RowBox[{"$theFunction", "/.", 
            RowBox[{"z", "->", 
             RowBox[{"z", "+", "s"}]}]}], "]"}], ",", "w", ",", 
          "\"\<NegativeLexicographic\>\""}], " ", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"functionCoeffRulesLen", "=", 
        RowBox[{"Length", "@", "functionCoeffRules"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{
          "\"\<function coeff rules length: \>\"", ",", 
           "functionCoeffRulesLen"}], "]"}], ";"}], "*)"}], 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"diagA", "=", 
        RowBox[{"diagFlags", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"diagB", "=", 
        RowBox[{"diagFlags", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"diagC", "=", 
        RowBox[{"diagFlags", "[", 
         RowBox[{"[", "3", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{"diagC", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"Style", "[", 
            RowBox[{
            "\"\<Creating reformedFunctionTable ...\>\"", ",", "16", ",", 
             "Bold", ",", "Purple"}], "]"}], "]"}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"reformedFunctionTable", "=", 
        RowBox[{"Table", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"currentSingIndex", "=", 
            RowBox[{"theReformedIndexes", "[", 
             RowBox[{"[", "rIndex", "]"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{"diagA", ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Print", "[", 
               RowBox[{
                RowBox[{"Style", "[", 
                 RowBox[{
                 "\"\<     Processing singular index: \>\"", ",", "Red", ",", 
                  "14", ",", "Bold"}], "]"}], ",", "currentSingIndex"}], 
               "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"MemberQ", "[", 
              RowBox[{"theReformedIndexes", ",", "currentSingIndex"}], "]"}], 
             ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"newWRules", "=", 
               RowBox[{
               "Table", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{
                  RowBox[{"wKey", "=", 
                   RowBox[{"functionCoeffRules", "[", 
                    RowBox[{"[", 
                    RowBox[{"wValIndex", ",", "1"}], "]"}], "]"}]}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"If", "[", 
                   RowBox[{"diagA", ",", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"Print", "[", 
                    RowBox[{
                    RowBox[{"Style", "[", 
                    RowBox[{
                    "\"\<      Processing wKey: \>\"", ",", "Bold", ",", 
                    "Black"}], "]"}], ",", "wKey"}], "]"}], ";"}]}], 
                   "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
                  "\[IndentingNewLine]", 
                  RowBox[{"keyValue", "=", 
                   RowBox[{"functionCoeffRules", "[", 
                    RowBox[{"[", 
                    RowBox[{"wValIndex", ",", "2"}], "]"}], "]"}]}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"zTerms", "=", 
                   RowBox[{"CoefficientRules", "[", 
                    RowBox[{
                    "keyValue", ",", "z", ",", 
                    "\"\<NegativeLexicographic\>\""}], " ", "]"}]}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"If", "[", 
                   RowBox[{"diagA", ",", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"Print", "[", 
                    RowBox[{"\"\<       zTerms: \>\"", ",", "zTerms"}], "]"}],
                     ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"currentReformedRule", "=", 
                   RowBox[{"reformedWRules", "[", 
                    RowBox[{"[", "wValIndex", "]"}], "]"}]}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"If", "[", 
                   RowBox[{"diagA", ",", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"Print", "[", 
                    RowBox[{
                    "\"\<       Reformed rule: \>\"", ",", 
                    "currentReformedRule"}], "]"}], ";"}]}], 
                   "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
                  RowBox[{"removeIndexes", "=", 
                   RowBox[{"Select", "[", 
                    RowBox[{
                    RowBox[{"currentReformedRule", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], ",", 
                    RowBox[{
                    RowBox[{"MemberQ", "[", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], ",", "currentSingIndex"}],
