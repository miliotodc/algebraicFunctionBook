Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"getSparsePoly", "[", 
    RowBox[{"zCoef_", ",", "wCoef_", ",", "a_", ",", "b_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "randomZ", ",", "randomW", ",", "randomCoef", ",", "wPowers", ",", 
       "reduceFlag", ",", "poly", ",", "strictPoly"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"reduceFlag", "=", "False"}], ";", "\[IndentingNewLine]", 
      RowBox[{"strictPoly", "=", "True"}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"randomZ", "[", "n_", "]"}], ":=", 
       RowBox[{"RandomChoice", "[", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "1"}], "}"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"randomW", "[", "n_", "]"}], ":=", " ", 
       RowBox[{"RandomInteger", "[", 
        RowBox[{"{", 
         RowBox[{"0", ",", "wCoef"}], "}"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"randomCoef", "[", "]"}], ":=", 
       RowBox[{
        RowBox[{"RandomInteger", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "a"}], ",", "a"}], "}"}], "]"}], "/", 
        RowBox[{"RandomInteger", "[", 
         RowBox[{"{", 
          RowBox[{"1", ",", "b"}], "}"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"While", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"!", "reduceFlag"}], " ", "&&", " ", "strictPoly"}], ",", 
        "\[IndentingNewLine]", " ", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"wPowers", "=", 
          RowBox[{"DeleteDuplicates", "@", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"randomW", "[", "10", "]"}], ",", 
             RowBox[{"{", "20", "}"}]}], "]"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"poly", "=", 
          RowBox[{"Plus", "@@", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"randomCoef", "[", "]"}], 
               RowBox[{"z", "^", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"randomZ", "[", "1", "]"}], "+", " ", 
                  RowBox[{"RandomInteger", "[", 
                   RowBox[{"{", 
                    RowBox[{"0", ",", "10"}], "}"}], "]"}]}], ")"}]}], " ", 
               RowBox[{"w", "^", 
                RowBox[{"wPowers", "[", 
                 RowBox[{"[", "i", "]"}], "]"}]}]}], ")"}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "1", ",", 
               RowBox[{"Length", "@", "wPowers"}]}], "}"}]}], "]"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"reduceFlag", "=", 
          RowBox[{"IrreduciblePolynomialQ", "[", "poly", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"strictPoly", "=", 
          RowBox[{"strictPolynomialQ", "[", 
           RowBox[{"poly", ",", 
            RowBox[{"{", 
             RowBox[{"z", ",", "w"}], "}"}]}], "]"}]}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", "poly"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
