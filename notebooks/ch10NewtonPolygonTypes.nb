Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"getRemovableIndexes", "[", 
      RowBox[{
      "$theFunction_", ",", "singPoint_", ",", "basePoleList_", ",", 
       "baseSeries_", ",", "newConjList_", ",", "diagFlag_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "wVals", ",", "oneCycleIndetPos", ",", "removableList", ",", 
         "oneCyclePos", ",", "oneCycleNonPolePos", ",", "oneCycleWVals", ",", 
         "oneCycleWArray", ",", "zDerivs", ",", "wDerivs", ",", "resultGrid", 
         ",", "oneCycleDerivSet", ",", "singAcc", ",", "singPrec", ",", 
         "zDerivPrec", ",", "wDerivPrec"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"singAcc", "=", 
         RowBox[{"Accuracy", "@", "singPoint"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"singPrec", "=", 
         RowBox[{"Floor", "@", 
          RowBox[{"Precision", "@", "singPoint"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"wVals", "=", "\[IndentingNewLine]", 
           RowBox[{"DeleteDuplicates", "[", 
            RowBox[{
             RowBox[{"w", "/.", 
              RowBox[{"NSolve", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"$theFunction", "==", "0"}], "/.", 
                 RowBox[{"z", "->", "singPoint"}]}], ",", "w", ",", 
                RowBox[{"WorkingPrecision", "->", 
                 RowBox[{"(", 
                  RowBox[{"singPrec", "-", "$mcf"}], ")"}]}]}], "]"}]}], ",", 
             RowBox[{
              RowBox[{
               RowBox[{"Abs", "[", "#", "]"}], "<", 
               RowBox[{"10", "^", 
                RowBox[{"-", 
                 RowBox[{"(", 
                  RowBox[{"singPrec", "-", "$mcf"}], ")"}]}]}]}], "&"}]}], 
            "]"}]}], ";"}], "\[IndentingNewLine]", "*)"}], 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", "\[IndentingNewLine]", " ", 
         RowBox[{
          RowBox[{"first", " ", "choose", " ", "1"}], "-", 
          RowBox[{
          "cycles", " ", "that", " ", "are", " ", "not", " ", "poles"}]}], 
         "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"oneCycleIndetPos", "=", 
         RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"removableList", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"n", ",", 
             RowBox[{"{", "}"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"n", ",", "1", ",", 
             RowBox[{"Length", "@", "baseSeries"}]}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"oneCyclePos", "=", 
         RowBox[{
          RowBox[{"Position", "[", 
           RowBox[{"newConjList", ",", 
            RowBox[{"x_", "/;", 
             RowBox[{"x", "==", "1"}]}]}], "]"}], "//", "Flatten"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{"diagFlag", ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"\"\<oneCyclePos: \>\"", ",", "oneCyclePos"}], "]"}], 
           ";"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", "\[IndentingNewLine]", " ", 
         RowBox[{
          RowBox[{"select", " ", "all", " ", "1"}], "-", 
          RowBox[{"cycle", " ", "non"}], "-", 
          RowBox[{"pole", " ", "series"}]}], " ", "\[IndentingNewLine]", 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{"oneCycleNonPolePos", "=", 
         RowBox[{
          RowBox[{"Select", "[", 
           RowBox[{
            RowBox[{"basePoleList", "[", 
             RowBox[{"[", "oneCyclePos", "]"}], "]"}], ",", 
