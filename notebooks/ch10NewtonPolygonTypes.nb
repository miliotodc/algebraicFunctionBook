                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"analyPos", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], ",", "currentSing", ",", 
                   RowBox[{
                    RowBox[{"theSeries", "[", 
                    RowBox[{"[", 
                    RowBox[{"analyPos", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], "/.", 
                    RowBox[{"z", "->", "0"}]}]}], "}"}], ",", 
                 "\[IndentingNewLine]", 
                 RowBox[{"{", 
                  RowBox[{"i", ",", "1", ",", 
                   RowBox[{"Length", "@", "analyPos"}]}], "}"}]}], 
                "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
              "\[IndentingNewLine]", 
              RowBox[{"zDeriv", "=", 
               RowBox[{
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", 
                   RowBox[{"Abs", "@", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"D", "[", 
                    RowBox[{"$theFunction", ",", "z"}], "]"}], "/.", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"z", "->", "currentSing"}], ",", 
                    RowBox[{"w", "->", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "3", "]"}], "]"}]}]}], "}"}]}], ")"}]}]}], 
                  "}"}], "&"}], "/@", " ", "oneTable"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"zDerivAcc", "=", 
               RowBox[{"Floor", "@", 
                RowBox[{"Accuracy", "@", "zDeriv"}]}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{"diagFlag", ",", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"Print", "[", 
                  RowBox[{"\"\<zDeriv vals: \>\"", ",", 
                   RowBox[{"zDeriv", "//", "N"}]}], "]"}], ";"}]}], 
               "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
              RowBox[{"numZero", "=", 
               RowBox[{"Flatten", "@", 
                RowBox[{"Position", "[", 
                 RowBox[{
                  RowBox[{"zDeriv", "[", 
                   RowBox[{"[", 
                    RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
                  RowBox[{"x_", "/;", 
                   RowBox[{
                    RowBox[{"Abs", "[", "x", "]"}], "<", 
                    RowBox[{"10", "^", 
                    RowBox[{"-", 
                    RowBox[{"(", 
                    RowBox[{"zDerivAcc", "-", "$mcf"}], ")"}]}]}]}]}]}], 
                 "]"}]}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"removeFlag", "=", "True"}], ";", "\[IndentingNewLine]",
               "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Length", "@", "numZero"}], "==", "0"}], ",", 
                "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"removeFlag", "=", "False"}], ";"}], 
                "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
                RowBox[{"(*", "\[IndentingNewLine]", " ", 
                 RowBox[{
                  RowBox[{"for", " ", "each", " ", "numZero"}], ",", " ", 
                  RowBox[{"check", " ", "wDeriv"}]}], "\[IndentingNewLine]", 
                 "*)"}], "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"wDeriv", "=", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", 
                    RowBox[{"Abs", "@", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"D", "[", 
                    RowBox[{"$theFunction", ",", "w"}], "]"}], "/.", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"z", "->", "currentSing"}], ",", 
                    RowBox[{"w", "->", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "3", "]"}], "]"}]}]}], "}"}]}], ")"}]}]}], 
                    "}"}], "&"}], "/@", " ", 
                   RowBox[{"oneTable", "[", 
                    RowBox[{"[", "numZero", "]"}], "]"}]}]}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"wDerivAcc", "=", 
                  RowBox[{"Floor", "@", 
                   RowBox[{"Accuracy", "@", "wDeriv"}]}]}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"If", "[", 
                  RowBox[{"diagFlag", ",", "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"Print", "[", 
                    RowBox[{"\"\<wZero vals: \>\"", ",", 
                    RowBox[{"wDeriv", "//", "N"}]}], "]"}], ";"}]}], 
                  "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
                 RowBox[{"wZero", "=", 
                  RowBox[{
                   RowBox[{"Position", "[", 
                    RowBox[{
                    RowBox[{"wDeriv", "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
                    RowBox[{"x_", "/;", 
                    RowBox[{
                    RowBox[{"Abs", "[", "x", "]"}], "<", 
                    RowBox[{"10", "^", 
                    RowBox[{"-", 
                    RowBox[{"(", 
                    RowBox[{"wDerivAcc", "-", "$mcf"}], ")"}]}]}]}]}]}], 
                    "]"}], "//", "Flatten"}]}], ";", "\[IndentingNewLine]", 
                 RowBox[{"Print", "[", 
                  RowBox[{"\"\<wZero: \>\"", ",", "wZero"}], "]"}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"Length", "@", "wZero"}], "==", "0"}], ",", 
                   "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"removeFlag", "=", "False"}], ";"}]}], 
                  "\[IndentingNewLine]", "]"}], ";"}]}], 
               "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{"removeFlag", ",", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"For", "[", 
                  RowBox[{
                   RowBox[{"i", "=", "1"}], ",", 
                   RowBox[{"i", "<=", 
                    RowBox[{"Length", "@", "wZero"}]}], ",", 
                   RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
