Cell[CellGroupData[{

Cell["getNormalVals using Max[ord(an)-ord(ai)/(n-1)]", "Subsection",
 CellChangeTimes->{{3.9050722328771076`*^9, 3.9050722346893744`*^9}, {
  3.9051650614090443`*^9, 
  3.905165085997493*^9}},ExpressionUUID->"d72afd26-a1eb-438e-8c2e-\
49f3ab06e7bc"],

Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{
   RowBox[{"getNormalVals", "[", "$theFunction_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "wExp", ",", "functionDegree", ",", "wCoef", ",", "orderList", ",", 
       "theLambda", ",", "theMu", ",", "lambdaList", ",", "theReturn"}], 
      "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"wExp", "=", 
       RowBox[{"Exponent", "[", 
        RowBox[{"$theFunction", ",", "w", ",", "List"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"functionDegree", "=", 
       RowBox[{"Last", "@", "wExp"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"wCoef", "=", 
       RowBox[{"CoefficientRules", "[", 
        RowBox[{
        "$theFunction", ",", "w", ",", "\"\<NegativeLexicographic\>\""}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "@", "wCoef"}], "<", "3"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"Style", "[", 
           RowBox[{
           "\"\<Function needs more than three terms to use \
getNormalVals!\>\"", ",", "Red", ",", "Bold"}], "]"}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"theReturn", "=", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", 
            RowBox[{"-", "1"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"orderList", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", "1"}], "]"}], "]"}], ",", 
              RowBox[{
               RowBox[{"Exponent", "[", 
                RowBox[{
                 RowBox[{"#", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], ",", "z", ",", "List"}], 
                "]"}], "//", "First"}]}], "}"}], "&"}], "/@", " ", 
           "wCoef"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"\"\<orderList: \>\"", ",", 
             RowBox[{"orderList", "[", 
              RowBox[{"[", 
               RowBox[{"2", ";;", 
                RowBox[{"-", "2"}]}], "]"}], "]"}]}], "]"}], ";"}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"lambdaList", "=", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             FractionBox[
              RowBox[{
               RowBox[{"orderList", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"-", "1"}], ",", "2"}], "]"}], "]"}], "-", 
               RowBox[{"#", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], 
              RowBox[{
               RowBox[{"orderList", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"-", "1"}], ",", "1"}], "]"}], "]"}], "-", 
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}]], "&"}], "/@", " ", 
            RowBox[{"orderList", "[", 
             RowBox[{"[", 
              RowBox[{"2", ";;", 
               RowBox[{"-", "2"}]}], "]"}], "]"}]}], ")"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"\"\<Lambda list: \>\"", ",", "lambdaList"}], "]"}], 
           ";"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"theLambda", "=", 
          RowBox[{"Max", "[", 
           RowBox[{"Ceiling", "@", "lambdaList"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"theMu", "=", 
          RowBox[{
           RowBox[{"theLambda", " ", "functionDegree"}], "-", 
           RowBox[{"orderList", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"-", "1"}], ",", "2"}], "]"}], "]"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"theReturn", "=", 
          RowBox[{"{", 
           RowBox[{"theLambda", ",", "theMu"}], "}"}]}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      "theReturn"}]}], "\[IndentingNewLine]", "]"}]}]}]], "Input",
 CellChangeTimes->{{3.905072224191885*^9, 3.905072225644436*^9}, {
   3.905610328055468*^9, 3.9056103758721666`*^9}, {3.9056104323282266`*^9, 
   3.905610433468581*^9}, {3.9056757554303813`*^9, 3.9056757727702227`*^9}, {
   3.905676247401864*^9, 3.9056762800821495`*^9}, {3.905677778920895*^9, 
   3.9056779186847706`*^9}, {3.9057678779071617`*^9, 3.905767882531036*^9}, {
   3.905767986381446*^9, 3.905768015530565*^9}, {3.9521653812845287`*^9, 
   3.952165381293453*^9}, 3.9526072305731087`*^9},
 CellLabel->"In[52]:=",ExpressionUUID->"ff971d05-cfb0-4f9b-8148-46655726fb4e"]
}, Closed]],

