                    "\[IndentingNewLine]", 
                    RowBox[{"Print", "[", 
                    RowBox[{
                    RowBox[{"Style", "[", 
                    RowBox[{"\"\<Appending to logLegPoints: \>\"", ",", 
                    RowBox[{"Darker", "@", "Green"}]}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"index", ",", 
                    RowBox[{"index", "+", "1"}]}], "}"}]}], "]"}], ";"}]}], 
                  "\[IndentingNewLine]", "]"}], ";"}], "*)"}], 
