Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"getCommonDenom", "[", 
     RowBox[{"k_", ",", "lam_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "mylambdas", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"mylambdas", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"lam", "[", 
           RowBox[{"[", "i", "]"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", "k"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"i", "=", "1"}], ",", 
         RowBox[{"i", "\[LessEqual]", 
          RowBox[{"Length", "[", "mylambdas", "]"}]}], ",", 
         RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"mylambdas", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "\[Equal]", "0"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"mylambdas", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "=", "1"}], ";"}]}], 
           "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Apply", "[", 
        RowBox[{"LCM", ",", 
         RowBox[{"Denominator", "[", "mylambdas", "]"}]}], "]"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}]], "Input",
 InitializationCell->True,
 InitializationGroup->True,
 CellChangeTimes->{{3.5608696380378585`*^9, 3.5608696491864963`*^9}, 
