                    RowBox[{"Length", "@", "pIndexes"}], ",", 
                    "\"\< pole indexes.  May need to increase \
compareFactor.\>\""}], "]"}], ";", "\[IndentingNewLine]", 
                    RowBox[{"Abort", "[", "]"}], ";"}]}], 
                   "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
                  "\[IndentingNewLine]", 
