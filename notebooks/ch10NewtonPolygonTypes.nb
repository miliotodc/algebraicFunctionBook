                    RowBox[{"Abs", "[", 
                    RowBox[{"#1", "-", "#2"}], "]"}], "&"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"$theSingularList", ",", "nearestSing"}], "}"}]}],
                     "]"}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
                    RowBox[{"For", "[", 
                    RowBox[{
                    RowBox[{"i", "=", "1"}], ",", 
                    RowBox[{"i", "<=", 
                    RowBox[{"Length", "@", "nearestDist"}]}], ",", 
