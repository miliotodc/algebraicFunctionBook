                    RowBox[{"Abs", "[", 
                    RowBox[{"x", "-", 
                    RowBox[{"aRoots", "[", 
                    RowBox[{"[", "#", "]"}], "]"}]}], "]"}], "<", 
                    RowBox[{"10", "^", 
                    RowBox[{"-", 
                    RowBox[{"(", 
                    RowBox[{"aAcc", "-", "compareFactor"}], ")"}]}]}]}]}]}], 
                    "]"}], "&"}], "/@", 
                    RowBox[{"Range", "[", 
                    RowBox[{"Length", "@", "aRoots"}], "]"}]}], "]"}], 
                    "]"}]}]}], ";", "\[IndentingNewLine]", 
                  RowBox[{"(*", "\[IndentingNewLine]", 
