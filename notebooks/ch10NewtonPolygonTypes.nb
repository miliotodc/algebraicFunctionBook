                    RowBox[{"{", "0", "}"}]}], " ", "&&", " ", 
                    RowBox[{"zIndex", "==", "1"}], " ", "&&", " ", 
                    RowBox[{
                    RowBox[{"Length", "@", "zIndexes"}], ">", "0"}], " ", "&&",
                     " ", 
                    RowBox[{
                    RowBox[{"Length", "@", "theZeroPos"}], "!=", 
