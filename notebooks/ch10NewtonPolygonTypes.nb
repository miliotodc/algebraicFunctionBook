Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"$theFunction", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"z", "^", 
         RowBox[{"(", "30", ")"}]}], "+", 
        RowBox[{"z", "^", 
         RowBox[{"(", "32", ")"}]}]}], ")"}], "+", 
      RowBox[{
       RowBox[{"(", 
