                    "]"}], "&"}], "/@", " ", "$theSingularList"}], ")"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"nearestDist", "=", 
                    RowBox[{"MapThread", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"1", "/", "3"}], 
                    RowBox[{"Abs", "[", 
                    RowBox[{"#1", "-", "#2"}], "]"}]}], "&"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"$theSingularList", ",", "nearestSing"}], "}"}]}],
                     "]"}]}], ";", "\[IndentingNewLine]", 
                    RowBox[{"(*", 
                    RowBox[{
                    RowBox[{"nearestSingDist", "=", 
                    RowBox[{"MapThread", "[", 
