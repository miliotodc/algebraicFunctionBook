               RowBox[{"endTerms", "=", 
                RowBox[{"Length", "@", "cTable"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"Print", "[", "\"\<test2\>\"", "]"}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"linearLine", "=", 
                RowBox[{
                 RowBox[{"c0", "+", 
                  RowBox[{"c1", " ", "x"}]}], "/.", " ", 
                 RowBox[{
                  RowBox[{"NMinimize", "[", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Total", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "-", 
                    RowBox[{"(", 
