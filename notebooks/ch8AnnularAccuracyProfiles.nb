Cell[CellGroupData[{

Cell["Check accuracy at constant radius as a function of order", "Subsection",
 CellChangeTimes->{{3.9404153056650066`*^9, 3.9404153146002455`*^9}, 
   3.944657203539954*^9},ExpressionUUID->"94a29c8d-f723-41de-b65a-\
46a5ccaae618"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"    ", 
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
   "check", " ", "accuracy", " ", "across", " ", "order", " ", "range"}], " ",
    "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"radiusIndex", "=", "13"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"theTheta", "=", "Pi"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"theRadius", "=", 
     RowBox[{"radiusStart", "+", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"radiusRatios", "[", 
         RowBox[{"[", "radiusIndex", "]"}], "]"}], " ", "radiusDif"}], 
       ")"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<theRadius: \>\"", ",", 
      RowBox[{"theRadius", "//", "N"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"zVal", "=", 
     RowBox[{"SetPrecision", "[", 
      RowBox[{
       RowBox[{"theRadius", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"I", " ", 
          RowBox[{"(", "theTheta", ")"}]}], "]"}]}], ",", "1000"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{"theOrderErrorTable", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Mod", "[", 
            RowBox[{"orderIndex", ",", "100"}], "]"}], "==", "0"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"\"\<index: \>\"", ",", "orderIndex"}], "]"}], ";"}]}], 
         "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"pVal", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"Plus", "@@", 
               RowBox[{"reducedAnalyticTerms", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ";;", 
                  RowBox[{"analyticOrderIndexList", "[", 
                   RowBox[{"[", 
                    RowBox[{"orderIndex", ",", "2"}], "]"}], "]"}]}], "]"}], 
                "]"}]}], ")"}], "+", 
             RowBox[{"(", 
              RowBox[{"Plus", "@@", 
               RowBox[{"theReformedSingularTerms", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ";;", 
                  RowBox[{"singularOrderIndexList", "[", 
                   RowBox[{"[", 
                    RowBox[{"orderIndex", ",", "2"}], "]"}], "]"}]}], "]"}], 
                "]"}]}], ")"}]}], "/.", 
            RowBox[{"z", "->", "zVal"}]}]}], ";"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"pVal", "=", 
         RowBox[{
          RowBox[{"seriesTable", "[", 
           RowBox[{"[", "orderIndex", "]"}], "]"}], "/.", 
          RowBox[{"z", "->", "zVal"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"wVals", "=", 
         RowBox[{"w", "/.", 
          RowBox[{"NSolve", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"$theFunction", "==", "0"}], "/.", 
             RowBox[{"z", "->", "zVal"}]}], ",", 
            RowBox[{"WorkingPrecision", "->", "100"}]}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"errTable", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"#", "-", "pVal"}], "]"}], "&"}], "/@", " ", "wVals"}]}], 
        ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"pos", "=", 
         RowBox[{
          RowBox[{"Position", "[", 
           RowBox[{"errTable", ",", 
            RowBox[{"Min", "[", "errTable", "]"}]}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"radiusRatios", "[", 
             RowBox[{"[", "n", "]"}], "]"}], ",", 
            RowBox[{
             RowBox[{"errTable", "[", 
              RowBox[{"[", "pos", "]"}], "]"}], "//", "N"}], ",", 
            RowBox[{"-", 
             RowBox[{
              RowBox[{"MantissaExponent", "[", 
               RowBox[{"errTable", "[", 
                RowBox[{"[", "pos", "]"}], "]"}], "]"}], "[", 
              RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], ","}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"orderIndex", ",", 
          RowBox[{
           RowBox[{"errTable", "[", 
            RowBox[{"[", "pos", "]"}], "]"}], "//", "N"}], ",", 
          RowBox[{"-", 
           RowBox[{"Log", "[", 
            RowBox[{"10", ",", 
             RowBox[{"errTable", "[", 
              RowBox[{"[", "pos", "]"}], "]"}]}], "]"}]}], ",", "theTheta"}], 
         "}"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"orderIndex", ",", "20", ",", "maxSeriesOrder"}], "}"}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"orderPointsPlot", "=", 
    RowBox[{"ListPlot", "[", 
     RowBox[{
      RowBox[{"theOrderErrorTable", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "3"}], "}"}]}], "]"}], "]"}], ",", 
      RowBox[{"Frame", "->", "True"}], ",", 
      RowBox[{"FrameLabel", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{
          "\"\<\[ScriptCapitalO]\>\"", ",", "16", ",", "Black", ",", "Bold"}],
           "]"}], ",", 
         RowBox[{"Rotate", "[", 
          RowBox[{
           RowBox[{"Style", "[", 
            RowBox[{
            "\"\<\!\(\*SubscriptBox[\(s\), \(a\)]\)\>\"", ",", "16", ",", 
             "Black", ",", "Bold"}], "]"}], ",", 
           RowBox[{
            RowBox[{"-", "90"}], " ", "Degree"}]}], "]"}]}], "}"}]}], ",", 
      RowBox[{"PlotStyle", "->", "Gray"}], ",", 
      RowBox[{"Joined", "->", "True"}], ",", 
      RowBox[{"FrameTicksStyle", "->", 
       RowBox[{"Directive", "[", 
        RowBox[{"Black", ",", "Bold", ",", "12"}], "]"}]}]}], "]"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pRange", "=", 
     RowBox[{"PlotRange", "@", "orderPointsPlot"}]}], ";"}], 
   "\[IndentingNewLine]"}]}]], "Input",
