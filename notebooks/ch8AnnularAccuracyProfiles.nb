                 RowBox[{"theSeries", "[", 
                  RowBox[{"[", 
                   RowBox[{"1", ";;", "index"}], "]"}], "]"}], "/.", 
                 RowBox[{"z", "->", "t"}]}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"theTestValue", "=", 
                RowBox[{"baseF2", "[", "newZ", "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"ePos", "[", 
                  RowBox[{"[", "index", "]"}], "]"}], ",", 
                 RowBox[{"SetPrecision", "[", 
                  RowBox[{
                   RowBox[{"type", "@", "theTestValue"}], ",", "wp"}], "]"}], 
                 ",", 
