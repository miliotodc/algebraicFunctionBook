                  RowBox[{"True", ",", "True", ",", 
                   RowBox[{"{", "False", "}"}], ",", "True"}], "}"}]}], 
                "}"}]}]}], "]"}], "]"}], ";"}], "\[IndentingNewLine]", "*)"}],
          "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "gives", " ", "index", " ", "into", " ", "annulusTable", " ", "for", 
          " ", "an", " ", "annulus"}], " ", "*)"}], " ", 
        RowBox[{"singTableAnnulusIndexes", "=", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Position", "[", 
             RowBox[{"annulusTable", ",", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                "a1_", ",", "a2_", ",", "a3_", ",", "a4_", ",", "a5_", ",", 
                 "a6_", ",", "a7_", ",", "a8_", ",", "a9_", ",", "a10_"}], 
                "}"}], "/;", 
               RowBox[{"a1", "==", "#"}]}]}], "]"}], "&"}], "/@", " ", 
           RowBox[{"Range", "[", 
            RowBox[{"1", ",", 
             RowBox[{"Length", "@", "theAnnuli"}]}], "]"}]}], "//", 
          "Flatten"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "singIndexs", " ", "gives", " ", "the", " ", "row", " ", "into", " ",
           "annulusTable", " ", "where", " ", "this", " ", "singular", " ", 
          "point", " ", "is", " ", "located"}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"singTableSingIndexes", "=", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Position", "[", 
             RowBox[{"annulusTable", ",", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                "x_", ",", "y_", ",", "z_", ",", "a_", ",", "b_", ",", "c_", 
                 ",", "d_", ",", "e_", ",", "f_", ",", "g_"}], "}"}], "/;", 
               RowBox[{"y", "==", "#"}]}]}], "]"}], "&"}], "/@", 
           RowBox[{"Range", "[", 
            RowBox[{"1", ",", 
             RowBox[{"Length", "@", "theSingularList"}]}], "]"}]}], "//", 
          "Flatten"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"plottingRadiiTable", "=", 
         RowBox[{"Table", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"newTable", "=", 
             RowBox[{"radiiTable", "[", 
              RowBox[{"[", "tableIndex", "]"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"newTable", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "=", 
             RowBox[{
              RowBox[{"newTable", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "+", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"newTable", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], "-", 
                 RowBox[{"newTable", "[", 
                  RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "/", "10"}]}]}], 
            ";", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"newTable", "[", 
              RowBox[{"[", 
               RowBox[{"-", "1"}], "]"}], "]"}], "=", 
             RowBox[{
              RowBox[{"newTable", "[", 
               RowBox[{"[", 
                RowBox[{"-", "1"}], "]"}], "]"}], "+", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"newTable", "[", 
                  RowBox[{"[", 
                   RowBox[{"-", "2"}], "]"}], "]"}], "-", 
                 RowBox[{"newTable", "[", 
                  RowBox[{"[", 
                   RowBox[{"-", "1"}], "]"}], "]"}]}], ")"}], "/", "10"}]}]}],
             ";", "\[IndentingNewLine]", "newTable"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"tableIndex", ",", "1", ",", 
             RowBox[{"Length", "@", "radiiTable"}]}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
         "theSingularList", ",", "argList", ",", "zeroIndexes", ",", 
          "poleIndexes", ",", "minRadiusArray", ",", "ringSizes", ",", 
          "theAnnuli", ",", "annularSizes", ",", "ringMemberSingularIndexes", 
          ",", "radiiTable", ",", "annularCenters", ",", 
          "singTableAnnulusIndexes", ",", "singTableSingIndexes", ",", 
          "plottingRadiiTable", ",", "annulusTable", ",", "annulusTableR"}], 
         "}"}]}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}], 
