Cell[CellGroupData[{

Cell["\<\
Section 5.2:  Generate accuracy plot at constant theta  and radius ratio as a \
function of order\
\>", "Subsection",
 CellChangeTimes->{{3.940413944420615*^9, 3.9404139600572047`*^9}, {
  3.9592534891719065`*^9, 3.9592534919678545`*^9}, {3.9737771935525475`*^9, 
  3.9737771939593782`*^9}, {3.9738435193439503`*^9, 3.973843522254133*^9}, {
  3.9811800234356704`*^9, 
  3.9811800236603804`*^9}},ExpressionUUID->"a919f4e0-1f9e-4284-abdd-\
c3f2a469418c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"plotColors", "=", 
     RowBox[{"{", 
      RowBox[{
      "Red", ",", "Blue", ",", "Yellow", ",", "Green", ",", "Orange", ",", 
       "Purple", ",", "Pink"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"theTheta", "=", 
     RowBox[{"SetPrecision", "[", 
      RowBox[{
       RowBox[{"thetaRange", "[", 
        RowBox[{"[", "35", "]"}], "]"}], ",", "1000"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rIndex", "=", "24"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<the radius ratio: \>\"", ",", 
      RowBox[{"radiusRatios", "[", 
       RowBox[{"[", "rIndex", "]"}], "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"theTheta", "=", 
     RowBox[{"SetPrecision", "[", 
      RowBox[{
       RowBox[{"Pi", "/", "4"}], ",", "1000"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"theRadius", "=", 
     RowBox[{"SetPrecision", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"radiusRange", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "+", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"radiusRatios", "[", 
           RowBox[{"[", "rIndex", "]"}], "]"}], "radiusDif"}], ")"}]}], ",", 
       "1000"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<theRadius: \>\"", ",", 
      RowBox[{"theRadius", "//", "N"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"zVal", "=", 
     RowBox[{"theRadius", " ", 
      RowBox[{"Exp", "[", 
       RowBox[{"I", " ", "theTheta"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<zVal: \>\"", ",", 
     RowBox[{
      RowBox[{"Abs", "@", "zVal"}], "//", "N"}]}], "]"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{"theOrderErrorTable", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"pVal", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"Plus", "@@", 
             RowBox[{"reducedAnalyticTerms", "[", 
              RowBox[{"[", 
               RowBox[{"1", ";;", 
                RowBox[{"analyticOrderIndexList", "[", 
                 RowBox[{"[", 
                  RowBox[{"oIndex", ",", "2"}], "]"}], "]"}]}], "]"}], 
              "]"}]}], ")"}], "+", 
           RowBox[{"(", 
            RowBox[{"Plus", "@@", 
             RowBox[{"theReformedSingularTerms", "[", 
              RowBox[{"[", 
               RowBox[{"1", ";;", 
                RowBox[{"singularOrderIndexList", "[", 
                 RowBox[{"[", 
                  RowBox[{"oIndex", ",", "2"}], "]"}], "]"}]}], "]"}], 
              "]"}]}], ")"}]}], "/.", 
          RowBox[{"z", "->", "zVal"}]}]}], ";"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"pVal", "=", 
         RowBox[{
          RowBox[{"seriesTable", "[", 
           RowBox[{"[", "oIndex", "]"}], "]"}], "/.", 
          RowBox[{"z", "->", "zVal"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"wVals", "=", 
         RowBox[{"w", "/.", 
          RowBox[{"NSolve", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"$theFunction", "==", "0"}], "/.", 
             RowBox[{"z", "->", "zVal"}]}], ",", 
            RowBox[{"WorkingPrecision", "->", "65"}]}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"errTable", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"#", "-", "pVal"}], "]"}], "&"}], "/@", " ", "wVals"}]}], 
        ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"pos", "=", 
         RowBox[{
          RowBox[{"Position", "[", 
           RowBox[{"errTable", ",", 
            RowBox[{"Min", "[", "errTable", "]"}]}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"radiusRatios", "[", 
             RowBox[{"[", "n", "]"}], "]"}], ",", 
            RowBox[{
             RowBox[{"errTable", "[", 
              RowBox[{"[", "pos", "]"}], "]"}], "//", "N"}], ",", 
            RowBox[{"-", 
             RowBox[{
              RowBox[{"MantissaExponent", "[", 
               RowBox[{"errTable", "[", 
                RowBox[{"[", "pos", "]"}], "]"}], "]"}], "[", 
              RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], ","}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"oIndex", ",", 
          RowBox[{
           RowBox[{"errTable", "[", 
            RowBox[{"[", "pos", "]"}], "]"}], "//", "N"}], ",", 
          RowBox[{"-", 
           RowBox[{"Log", "[", 
            RowBox[{"10", ",", 
             RowBox[{"errTable", "[", 
              RowBox[{"[", "pos", "]"}], "]"}]}], "]"}]}]}], "}"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"oIndex", ",", "10", ",", "maxSeriesOrder"}], "}"}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"ListPlot", "[", 
    RowBox[{
     RowBox[{"theOrderErrorTable", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "3"}], "}"}]}], "]"}], "]"}], ",", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{"\"\<O\>\"", ",", "16", ",", "Black", ",", "Bold"}], "]"}], 
        ",", 
        RowBox[{"Rotate", "[", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{"\"\<A\>\"", ",", "16", ",", "Black", ",", "Bold"}], "]"}],
           ",", 
          RowBox[{
           RowBox[{"-", "90"}], " ", "Degree"}]}], "]"}]}], "}"}]}]}], "]"}], 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.9213975699488945`*^9, 3.9213978038214345`*^9}, {
