Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{" ", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"$theAnnulus", "//", "N"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"thetaRange", "=", 
     RowBox[{"Array", "[", 
      RowBox[{
       RowBox[{"#", "&"}], ",", "100", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "Pi"}], ",", "Pi"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"if", " ", "outer", " ", "annulus"}], ",", " ", 
     RowBox[{"can", " ", "try", " ", "larger", " ", "domains"}]}], " ", 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"radiusRange", "=", 
     RowBox[{"Array", "[", 
      RowBox[{
       RowBox[{"#", "&"}], ",", "80", ",", "$theAnnulus"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"radiusRatios", "=", 
     RowBox[{"Array", "[", 
      RowBox[{
       RowBox[{"#", "&"}], ",", "100", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "/", "100"}], ",", 
         RowBox[{"99", "/", "100"}]}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"radiusStart", "=", 
     RowBox[{"$theAnnulus", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"radiusDif", "=", 
     RowBox[{
      RowBox[{"radiusRange", "[", 
       RowBox[{"[", 
        RowBox[{"-", "1"}], "]"}], "]"}], "-", 
      RowBox[{"radiusRange", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"finalReducedSeries", "[", "z_", "]"}], "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"Plus", "@@", "analyticTerms"}], ")"}], "+", 
      RowBox[{"(", 
       RowBox[{"Plus", "@@", "singularTerms"}], ")"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Max order: \>\"", ",", "maxSeriesOrder"}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"seriesTable", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"Plus", "@@", 
          RowBox[{"analyticTerms", "[", 
           RowBox[{"[", 
            RowBox[{"1", ";;", 
             RowBox[{"analyticOrderList", "[", 
              RowBox[{"[", 
               RowBox[{"orderIndex", ",", "2"}], "]"}], "]"}]}], "]"}], 
           "]"}]}], ")"}], "+", 
        RowBox[{"(", 
         RowBox[{"Plus", "@@", 
          RowBox[{"singularTerms", "[", 
           RowBox[{"[", 
            RowBox[{"1", ";;", 
             RowBox[{"singularOrderList", "[", 
              RowBox[{"[", 
               RowBox[{"orderIndex", ",", "2"}], "]"}], "]"}]}], "]"}], 
           "]"}]}], ")"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"orderIndex", ",", "1", ",", "maxSeriesOrder"}], "}"}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{"theexp", "=", 
     RowBox[{"Exponent", "[", 
      RowBox[{
       RowBox[{"finalReducedSeries", "[", "z", "]"}], ",", "z", ",", "List"}],
       "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"theNum", "=", 
     RowBox[{"Numerator", "@", "theexp"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"clist", "=", 
     RowBox[{"Coefficient", "[", 
      RowBox[{
       RowBox[{"finalReducedSeries", "[", "z", "]"}], ",", "z", ",", 
       "theexp"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"branchSheetF", "[", 
      RowBox[{"z_", ",", "k_"}], "]"}], ":=", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"clist", "[", 
         RowBox[{"[", "n", "]"}], "]"}], " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"Exp", "[", 
           RowBox[{"2", " ", "k", " ", "\[Pi]", " ", 
            RowBox[{"\[ImaginaryI]", "/", "$selectedBranchSize"}]}], "]"}], 
          ")"}], "^", 
         RowBox[{"(", 
          RowBox[{"$selectedBranchSize", " ", 
           RowBox[{"theexp", "[", 
            RowBox[{"[", "n", "]"}], "]"}]}], ")"}]}], " ", 
        RowBox[{"z", "^", 
         RowBox[{"theexp", "[", 
          RowBox[{"[", "n", "]"}], "]"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "1", ",", 
         RowBox[{"Length", "[", "clist", "]"}]}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]"}]}]], "Input",
