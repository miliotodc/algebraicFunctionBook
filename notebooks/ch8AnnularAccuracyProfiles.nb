              RowBox[{
               RowBox[{"seriesWChar", "[", 
                RowBox[{"[", "k", "]"}], "]"}], "=", 
               RowBox[{"Style", "[", 
                RowBox[{
                 RowBox[{"seriesWChar", "[", 
                  RowBox[{"[", "k", "]"}], "]"}], ",", "Red"}], "]"}]}], 
