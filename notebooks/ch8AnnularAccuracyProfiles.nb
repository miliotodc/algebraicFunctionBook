Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "select", " ", "annular", " ", "domain", " ", "and", " ", "branch", " ", 
    "position", " ", "in", " ", "finalBranchGrid"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"selectedAnnulus", "=", "$selectedAnnulus"}], 
   "\[IndentingNewLine]", 
   RowBox[{"selectedBranch", "=", "$selectedMonodromyIndex"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"annularExtensions", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{"#", "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", "All", ",", 
            RowBox[{"{", 
             RowBox[{"1", ",", "2", ",", "3"}], "}"}]}], "]"}], "]"}]}], 
        "}"}], "&"}], "/@", " ", "theFinalContinuationList"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"theAnnulusTable", "=", "annulusTable"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"selectedAnnulus", ">", 
        RowBox[{"Length", "@", "annularExtensions"}]}], " ", "||", " ", 
       RowBox[{"selectedBranch", ">", 
        RowBox[{"Length", "@", 
         RowBox[{"annularExtensions", "[", 
          RowBox[{"[", 
           RowBox[{"selectedAnnulus", ",", "2"}], "]"}], "]"}]}]}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"Style", "[", 
         RowBox[{
         "\"\<Selected branch or annulus out of range\>\"", ",", "Red"}], 
         "]"}], "]"}], ";"}], "\[IndentingNewLine]", ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "theBranchMonodromy", ",", "extendedDomain", ",", "theBranchSet"}], 
         "}"}], "=", 
        RowBox[{"getExtendedBranchPlot", "[", 
         RowBox[{
         "theAnnulusTable", ",", "$plotType", ",", "selectedAnnulus", ",", 
          "selectedBranch", ",", "$thetaV", ",", "annularExtensions", ",", 
          RowBox[{"\"\<radialSegments\>\"", "->", "25"}], ",", 
          RowBox[{"\"\<arcSegments\>\"", "->", "50"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", " ", 
       RowBox[{"branchPlot", "=", 
        RowBox[{"Table", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"rowA", "=", 
            RowBox[{
             RowBox[{"theBranchSet", "[", 
              RowBox[{"[", "k", "]"}], "]"}], "//", "N"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"rowB", "=", 
            RowBox[{
             RowBox[{"theBranchSet", "[", 
              RowBox[{"[", 
               RowBox[{"k", "+", "1"}], "]"}], "]"}], "//", "N"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"pTable", "=", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"Blue", ",", 
                RowBox[{"Opacity", "[", "0.25", "]"}], ",", 
                RowBox[{"Polygon", "[", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"rowA", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], ",", 
                   RowBox[{"rowA", "[", 
                    RowBox[{"[", 
                    RowBox[{"j", "+", "1"}], "]"}], "]"}], ",", 
                   RowBox[{"rowB", "[", 
                    RowBox[{"[", 
                    RowBox[{"j", "+", "1"}], "]"}], "]"}], ",", 
                   RowBox[{"rowB", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}], "}"}], "]"}]}], "}"}], 
              ",", 
              RowBox[{"{", 
               RowBox[{"j", ",", "1", ",", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"Length", "@", "rowA"}], ")"}], "-", "1"}]}], 
               "}"}]}], "]"}]}], ";", "pTable"}], ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"k", ",", "1", ",", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"Length", "@", "theBranchSet"}], ")"}], "-", "1"}]}], 
           "}"}]}], "\[IndentingNewLine]", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"theDifferentialPlot", "=", " ", 
        RowBox[{"Show", "[", 
         RowBox[{
          RowBox[{"Graphics3D", "@", 
