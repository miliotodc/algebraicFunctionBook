Cell["Section 5.6.1:  Create 3D accuracy points", "Subsubsection",
 CellChangeTimes->{{3.9826006063634872`*^9, 
  3.9826006161809735`*^9}},ExpressionUUID->"1e0cdfcc-585e-4f0f-98fd-\
acfd1a5fdcd0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{"check", " ", "accuracy", " ", "across", " ", "domain"}], " ", 
   "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"diagFlag", "=", "False"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"seriesType", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"theTheta", "=", 
     RowBox[{"SetPrecision", "[", 
      RowBox[{
       RowBox[{"thetaRange", "[", 
        RowBox[{"[", "20", "]"}], "]"}], ",", "1000"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"theTheta", "=", 
     RowBox[{"Arg", "[", 
      RowBox[{"$theSingularList", "[", 
       RowBox[{"[", "2", "]"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"theTheta", "=", 
     RowBox[{"SetPrecision", "[", 
      RowBox[{
       RowBox[{"Pi", "/", "3"}], ",", "1000"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"orderStart", "=", "20"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"orderEnd", "=", "maxSeriesOrder"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"plotTable", "=", 
