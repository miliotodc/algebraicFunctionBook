Cell[CellGroupData[{

Cell["convertToChar", "Subsection",
 CellChangeTimes->{{3.920724871443428*^9, 
  3.9207248734117117`*^9}},ExpressionUUID->"0ffdad67-6284-4f09-ad2f-\
55ccd09940d7"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"convertToChar", "[", "num_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"sTest", ",", "s1", ",", "newS", ",", "newS2"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"sTest", "=", 
       RowBox[{"ToString", "@", 
        RowBox[{"AccountingForm", "@", "num"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"s1", "=", 
       RowBox[{"StringTake", "[", 
        RowBox[{"sTest", ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"s1", "==", "\"\<(\>\""}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"newS", "=", 
          RowBox[{"StringReplacePart", "[", 
           RowBox[{"sTest", ",", "\"\<-\>\"", ",", 
            RowBox[{"{", 
             RowBox[{"1", ",", "1"}], "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"newS2", "=", 
          RowBox[{"StringDrop", "[", 
           RowBox[{"newS", ",", 
            RowBox[{"-", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"Characters", "@", "newS2"}]}], "\[IndentingNewLine]", ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Characters", "@", "sTest"}]}], "\[IndentingNewLine]", 
       "]"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 InitializationGroup->True,
 CellLabel->
  "In[112]:=",ExpressionUUID->"d208e769-4bfa-4afc-8ceb-971d8ead24c0"]
}, Closed]]
}, Closed]],

