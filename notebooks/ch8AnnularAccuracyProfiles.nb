Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"RealToHex32", "[", "x_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "tmp", "}"}], ",", 
     RowBox[{
      RowBox[{"tmp", "=", 
       RowBox[{"OpenTemporary", "[", 
        RowBox[{"BinaryFormat", "\[Rule]", "True"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"BinaryWrite", "[", 
       RowBox[{"tmp", ",", "x", ",", "\"\<Real32\>\""}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"tmp", "=", 
       RowBox[{"Close", "[", "tmp", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"BinaryRead", "[", 
         RowBox[{"tmp", ",", "\"\<UnsignedInteger8\>\""}], "]"}], ",", 
        RowBox[{"BinaryRead", "[", 
         RowBox[{"tmp", ",", "\"\<UnsignedInteger8\>\""}], "]"}], ",", 
        RowBox[{"BinaryRead", "[", 
         RowBox[{"tmp", ",", "\"\<UnsignedInteger8\>\""}], "]"}], ",", 
        RowBox[{"BinaryRead", "[", 
         RowBox[{"tmp", ",", "\"\<UnsignedInteger8\>\""}], "]"}]}], "}"}]}]}],
     "]"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"floatToBinary", "[", "inum_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "theSign", ",", "ival", ",", "theDigits", ",", "theexp", ",", 
        "mantissa", ",", "binExp", ",", "packedForm", ",", "packedArray"}], 
       "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"inum", "<", "0"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"theSign", "=", "1"}], ";"}], "\[IndentingNewLine]", ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"theSign", "=", "0"}], ";"}]}], "\[IndentingNewLine]", 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"ival", "=", 
        RowBox[{"RealDigits", "[", 
         RowBox[{"inum", ",", "2"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"theDigits", "=", 
        RowBox[{"PadRight", "[", 
         RowBox[{
          RowBox[{"ival", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", "32"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"theexp", "=", 
        RowBox[{"ival", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"mantissa", "=", 
        RowBox[{"theDigits", "[", 
         RowBox[{"[", 
          RowBox[{"2", ";;", "24"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"inum", "\[Equal]", "0"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"binExp", "=", 
           RowBox[{"IntegerDigits", "[", 
            RowBox[{"0", ",", "2", ",", "8"}], "]"}]}], ";"}], 
         "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"binExp", "=", 
           RowBox[{"IntegerDigits", "[", 
            RowBox[{
             RowBox[{"theexp", "-", "1", "+", "127"}], ",", "2", ",", "8"}], 
            "]"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"packedForm", "=", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"{", "theSign", "}"}], ",", "binExp", ",", "mantissa"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"packedArray", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"FromDigits", "[", 
           RowBox[{
            RowBox[{"packedForm", "[", 
             RowBox[{"[", 
              RowBox[{"25", ";;", "32"}], "]"}], "]"}], ",", "2"}], "]"}], 
          ",", 
          RowBox[{"FromDigits", "[", 
           RowBox[{
            RowBox[{"packedForm", "[", 
             RowBox[{"[", 
              RowBox[{"17", ";;", "24"}], "]"}], "]"}], ",", "2"}], "]"}], 
          ",", 
          RowBox[{"FromDigits", "[", 
           RowBox[{
            RowBox[{"packedForm", "[", 
             RowBox[{"[", 
              RowBox[{"9", ";;", "16"}], "]"}], "]"}], ",", "2"}], "]"}], ",", 
          RowBox[{"FromDigits", "[", 
           RowBox[{
            RowBox[{"packedForm", "[", 
             RowBox[{"[", 
              RowBox[{"1", ";;", "8"}], "]"}], "]"}], ",", "2"}], "]"}]}], 
         "}"}]}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
