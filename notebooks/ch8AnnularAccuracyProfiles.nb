      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"clist", "[", 
          RowBox[{"[", "n", "]"}], "]"}], " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"Exp", "[", 
            RowBox[{"2", " ", "k", " ", "\[Pi]", " ", 
             RowBox[{"\[ImaginaryI]", "/", "theCurrentBranchSize"}]}], "]"}], 
           ")"}], "^", 
          RowBox[{"(", 
