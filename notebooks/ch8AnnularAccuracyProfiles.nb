   RowBox[{"formatNumber", "[", "num_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "real", ",", "imag", ",", "realPart", ",", "imagPart", ",", "me", ",", 
       "return"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Precision", "@", 
           RowBox[{"Im", "@", "num"}]}], "<", "10"}], " ", "||", " ", 
         RowBox[{
          RowBox[{"Precision", "@", 
           RowBox[{"Re", "@", "num"}]}], "<", "10"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"return", "=", "\"\<E\>\""}], ";"}]}], "\[IndentingNewLine]",
        "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"real", "=", 
       RowBox[{"Re", "@", "num"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"imag", "=", 
       RowBox[{"Im", "@", "num"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Precision", "@", "real"}], ">", "10"}], " ", "&&", " ", 
         RowBox[{
          RowBox[{"Precision", "@", "imag"}], ">", "10"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"me", "=", 
          RowBox[{"MantissaExponent", "[", "real", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"realPart", "=", 
          RowBox[{
           RowBox[{"N", "[", 
            RowBox[{
             RowBox[{"10", " ", 
              RowBox[{"me", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], ",", "5"}], "]"}], " ", 
           RowBox[{"10", "^", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"me", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "-", "1"}], ")"}]}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"me", "=", 
          RowBox[{"MantissaExponent", "[", "imag", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"imagPart", "=", 
          RowBox[{
           RowBox[{"N", "[", 
            RowBox[{
             RowBox[{"10", " ", 
              RowBox[{"me", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], ",", "5"}], "]"}], " ", 
           RowBox[{"10", "^", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"me", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "-", "1"}], ")"}]}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"return", "=", 
          RowBox[{"realPart", "+", 
           RowBox[{"I", " ", "imagPart"}]}]}], ";"}], "\[IndentingNewLine]", 
        ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Precision", "@", "imag"}], "<", "10"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"me", "=", 
             RowBox[{"MantissaExponent", "[", "real", "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"realPart", "=", 
             RowBox[{
              RowBox[{"N", "[", 
               RowBox[{
                RowBox[{"10", " ", 
                 RowBox[{"me", "[", 
                  RowBox[{"[", "1", "]"}], "]"}]}], ",", "5"}], "]"}], " ", 
              RowBox[{"10", "^", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"me", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], "-", "1"}], ")"}]}]}]}], 
            ";", "\[IndentingNewLine]", 
            RowBox[{"return", "=", "realPart"}], ";"}], "\[IndentingNewLine]",
            ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Precision", "@", "real"}], "<", "10"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"me", "=", 
                RowBox[{"MantissaExponent", "[", "imag", "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"imagPart", "=", 
                RowBox[{
                 RowBox[{"N", "[", 
                  RowBox[{
                   RowBox[{"10", " ", 
                    RowBox[{"me", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], ",", "5"}], "]"}], " ", 
                 RowBox[{"10", "^", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"me", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "-", "1"}], ")"}]}]}]}], 
               ";", "\[IndentingNewLine]", 
               RowBox[{"return", "=", 
                RowBox[{"I", " ", "imagPart"}]}], ";"}], 
              "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
              RowBox[{"return", "=", "\"\<E\>\""}]}], "\[IndentingNewLine]", 
             "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", "return"}]}],
     "\[IndentingNewLine]", "]"}]}]}]], "Input",
