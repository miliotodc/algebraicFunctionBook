Cell[CellGroupData[{

Cell["\<\
Section 5.3:  Generate accuracy vs. radius at selected order and find max \
accuracy radius ratio\
\>", "Subsection",
 CellChangeTimes->{{3.9404141281550474`*^9, 3.9404141454789047`*^9}, {
  3.959254038373027*^9, 3.95925404326983*^9}, {3.9737771962561483`*^9, 
  3.973777196459344*^9}, {3.9811800251650066`*^9, 
  3.9811800253828125`*^9}},ExpressionUUID->"f0765640-a5aa-4536-bad1-\
8485b8d77de7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
   "plot", " ", "accuracy", " ", "at", " ", "a", " ", "select", " ", "theta", 
    " ", "and", " ", "order", " ", "over", " ", "radial", " ", "domain"}], 
   "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "\[IndentingNewLine]", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"orderIndex", "=", "90"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"orderIndex", "<=", " ", "maxSeriesOrder"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"theTheta", "=", 
        RowBox[{"SetPrecision", "[", 
         RowBox[{
          RowBox[{"thetaRange", "[", 
           RowBox[{"[", "35", "]"}], "]"}], ",", "1000"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"theTheta", "=", 
          RowBox[{"SetPrecision", "[", 
           RowBox[{
            RowBox[{"thetaRange", "[", 
             RowBox[{"[", "21", "]"}], "]"}], ",", "1000"}], "]"}]}], ";"}], 
        "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"theTheta", "=", 
        RowBox[{"SetPrecision", "[", 
         RowBox[{
          RowBox[{"Pi", "/", "4"}], ",", "1000"}], "]"}]}], ";", 
       "\[IndentingNewLine]", " ", 
       RowBox[{"theRatioErrorTable", "=", 
        RowBox[{
        "Table", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"theRadius", "=", 
            RowBox[{"Rationalize", "[", 
             RowBox[{"radiusStart", "+", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"radiusRatios", "[", 
                 RowBox[{"[", "n", "]"}], "]"}], " ", "radiusDif"}], ")"}]}], 
             "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{"theRadius", "=", 
              RowBox[{"Rationalize", "[", 
               RowBox[{
                RowBox[{"extendedRadiusStart", "+", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"radiusRatios", "[", 
                    RowBox[{"[", "n", "]"}], "]"}], "extendedRadiusDif"}], 
                  ")"}]}], ",", "0"}], "]"}]}], ";"}], "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{"zVal", "=", 
            RowBox[{"theRadius", " ", 
             RowBox[{"Exp", "[", 
              RowBox[{"I", " ", "theTheta"}], "]"}]}]}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"pVal", "=", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"Plus", "@@", 
                RowBox[{"analyticTerms", "[", 
                 RowBox[{"[", 
                  RowBox[{"1", ";;", 
                   RowBox[{"(", 
                    RowBox[{"analyticOrderList", "[", 
                    RowBox[{"[", 
                    RowBox[{"orderIndex", ",", "2"}], "]"}], "]"}], ")"}]}], 
                  "]"}], "]"}]}], ")"}], "+", 
              RowBox[{"(", 
               RowBox[{"Plus", "@@", 
                RowBox[{"singularTerms", "[", 
                 RowBox[{"[", 
                  RowBox[{"1", ";;", 
                   RowBox[{"(", 
                    RowBox[{"singularOrderList", "[", 
                    RowBox[{"[", 
                    RowBox[{"orderIndex", ",", "2"}], "]"}], "]"}], ")"}]}], 
                  "]"}], "]"}]}], ")"}]}], "/.", 
             RowBox[{"z", "->", "zVal"}]}]}], ";", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{"pVal", "=", 
              RowBox[{
               RowBox[{"seriesTable", "[", 
                RowBox[{"[", "orderIndex", "]"}], "]"}], "/.", 
               RowBox[{"z", "->", "zVal"}]}]}], ";"}], "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{"wVals", "=", 
            RowBox[{"w", "/.", 
             RowBox[{"NSolve", "[", 
              RowBox[{
               RowBox[{"$theFunction", "==", "0"}], "/.", 
               RowBox[{"z", "->", "zVal"}]}], "]"}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"errTable", "=", 
            RowBox[{
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{"#", "-", "pVal"}], "]"}], "&"}], "/@", " ", 
             "wVals"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"pos", "=", 
            RowBox[{
             RowBox[{"Position", "[", 
              RowBox[{"errTable", ",", 
               RowBox[{"Min", "[", "errTable", "]"}]}], "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"radiusRatios", "[", 
                RowBox[{"[", "n", "]"}], "]"}], ",", 
               RowBox[{
                RowBox[{"errTable", "[", 
                 RowBox[{"[", "pos", "]"}], "]"}], "//", "N"}], ",", 
               RowBox[{"-", 
                RowBox[{
                 RowBox[{"MantissaExponent", "[", 
                  RowBox[{"errTable", "[", 
                   RowBox[{"[", "pos", "]"}], "]"}], "]"}], "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], ","}], "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"radiusRatios", "[", 
              RowBox[{"[", "n", "]"}], "]"}], ",", 
             RowBox[{
              RowBox[{"errTable", "[", 
               RowBox[{"[", "pos", "]"}], "]"}], "//", "N"}], ",", 
             RowBox[{"-", 
              RowBox[{"Log", "[", 
               RowBox[{"10", ",", 
                RowBox[{"errTable", "[", 
                 RowBox[{"[", "pos", "]"}], "]"}]}], "]"}]}]}], "}"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"n", ",", "5", ",", 
            RowBox[{"Length", "@", "radiusRatios"}]}], "}"}]}], 
         "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"maximalAccuracy", "=", 
        RowBox[{
         RowBox[{"MaximalBy", "[", 
          RowBox[{
           RowBox[{"theRatioErrorTable", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", 
              RowBox[{"{", 
               RowBox[{"1", ",", "3"}], "}"}]}], "]"}], "]"}], ",", "Last"}], 
          "]"}], "//", "N"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"maxPointG", "=", 
        RowBox[{"Graphics", "@", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"PointSize", "[", "0.025", "]"}], ",", "Red", ",", 
           RowBox[{"Point", "@", 
            RowBox[{"maximalAccuracy", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}]}], "}"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"maxPoint3DG2", "=", 
        RowBox[{"Graphics3D", "@", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"PointSize", "[", "0.025", "]"}], ",", "Red", ",", 
           RowBox[{"Point", "@", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"maximalAccuracy", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", "1"}], "]"}], "]"}], ",", "orderIndex", ",", 
              RowBox[{"maximalAccuracy", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", "2"}], "]"}], "]"}]}], "}"}]}]}], "}"}]}]}],
        ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"radiusTicks", "[", "n_", "]"}], ":=", 
        RowBox[{
         RowBox[{"radiusRange", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "+", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"radiusRatios", "[", 
            RowBox[{"[", "n", "]"}], "]"}], "radiusDif"}], ")"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"maxRadiusRatio", "=", 
        RowBox[{"maximalAccuracy", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<maxRadiusRatio: \>\"", ",", 
         RowBox[{"maxRadiusRatio", "//", "N"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"nearRatio", "=", 
        RowBox[{
         RowBox[{"Nearest", "[", 
          RowBox[{"radiusRatios", ",", "maxRadiusRatio"}], "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"pos", "=", 
        RowBox[{
         RowBox[{"Position", "[", 
          RowBox[{"radiusRatios", ",", 
           RowBox[{"x_", "/;", 
            RowBox[{"x", "==", "nearRatio"}]}]}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Ratio index: \>\"", ",", "pos"}], "]"}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"maximumAccuracyRadius", "=", 
        RowBox[{"radiusStart", "+", 
         RowBox[{"(", 
          RowBox[{"maxRadiusRatio", " ", "radiusDif"}], ")"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Maximum accuracy radius: \>\"", ",", 
         RowBox[{"maximumAccuracyRadius", "//", "N"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Maximum accuracy: \>\"", ",", 
         RowBox[{"maximalAccuracy", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "2"}], "]"}], "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"ratioPointsPlot2", "=", 
        RowBox[{"ListPlot", "[", 
         RowBox[{
          RowBox[{"theRatioErrorTable", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", 
             RowBox[{"{", 
              RowBox[{"1", ",", "3"}], "}"}]}], "]"}], "]"}], ",", 
          RowBox[{"Frame", "->", "True"}], ",", 
          RowBox[{"FrameLabel", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Style", "[", 
              RowBox[{
              "\"\<\!\(\*SubscriptBox[\(r\), \(f\)]\)\>\"", ",", "16", ",", 
               "Black", ",", "Bold"}], "]"}], ",", 
             RowBox[{"Rotate", "[", 
              RowBox[{
               RowBox[{"Style", "[", 
                RowBox[{"\"\<A\>\"", ",", "16", ",", "Black", ",", "Bold"}], 
                "]"}], ",", 
               RowBox[{
                RowBox[{"-", "90"}], " ", "Degree"}]}], "]"}]}], "}"}]}], ",", 
          RowBox[{"FrameTicks", "->", 
           RowBox[{"{", 
            RowBox[{"Automatic", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"0.01", ",", 
                   OverscriptBox[
                    RowBox[{"N", "[", 
                    RowBox[{
                    RowBox[{"radiusTicks", "[", "1", "]"}], ",", "3"}], "]"}], 
                    RowBox[{"N", "[", 
                    RowBox[{
                    RowBox[{"1", "/", "100"}], ",", "2"}], "]"}]]}], "}"}], 
                 ",", 
                 RowBox[{"{", 
                  RowBox[{"0.2", ",", 
                   OverscriptBox[
                    RowBox[{"N", "[", 
                    RowBox[{
                    RowBox[{"radiusTicks", "[", "20", "]"}], ",", "3"}], 
                    "]"}], 
                    RowBox[{"N", "[", 
                    RowBox[{
                    RowBox[{"20", "/", "100"}], ",", "2"}], "]"}]]}], "}"}], 
                 ",", 
                 RowBox[{"{", 
                  RowBox[{"0.4", ",", 
                   OverscriptBox[
                    RowBox[{"N", "[", 
                    RowBox[{
                    RowBox[{"radiusTicks", "[", "40", "]"}], ",", "3"}], 
                    "]"}], 
                    RowBox[{"N", "[", 
                    RowBox[{
                    RowBox[{"40", "/", "100"}], ",", "2"}], "]"}]]}], "}"}], 
                 ",", 
                 RowBox[{"{", 
                  RowBox[{"0.6", ",", 
                   OverscriptBox[
                    RowBox[{"N", "[", 
                    RowBox[{
                    RowBox[{"radiusTicks", "[", "60", "]"}], ",", "3"}], 
                    "]"}], 
                    RowBox[{"N", "[", 
                    RowBox[{
                    RowBox[{"60", "/", "100"}], ",", "2"}], "]"}]]}], "}"}], 
                 ",", 
                 RowBox[{"{", 
                  RowBox[{"0.8", ",", 
                   OverscriptBox[
                    RowBox[{"N", "[", 
                    RowBox[{
                    RowBox[{"radiusTicks", "[", "80", "]"}], ",", "3"}], 
                    "]"}], 
                    RowBox[{"N", "[", 
                    RowBox[{
                    RowBox[{"80", "/", "100"}], ",", "2"}], "]"}]]}], "}"}], 
                 ",", 
                 RowBox[{"{", 
                  RowBox[{"1", ",", 
                   OverscriptBox[
                    RowBox[{"N", "[", 
                    RowBox[{
                    RowBox[{"radiusTicks", "[", "100", "]"}], ",", "3"}], 
                    "]"}], 
                    RowBox[{"N", "[", 
                    RowBox[{"1", ",", "2"}], "]"}]]}], "}"}]}], "}"}], ",", 
               "False"}], "}"}]}], "}"}]}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"Show", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"ratioPointsPlot2", ",", "maxPointG"}], "}"}], ",", 
          RowBox[{"FrameTicksStyle", "->", 
           RowBox[{"Directive", "[", 
            RowBox[{"Black", ",", "Bold"}], "]"}]}]}], "]"}], "]"}], ";"}], 
      "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"\"\<Order greater than max order \>\"", "<>", 
           RowBox[{"ToString", "@", "maxSeriesOrder"}]}], ",", "Red"}], "]"}],
         "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], 
