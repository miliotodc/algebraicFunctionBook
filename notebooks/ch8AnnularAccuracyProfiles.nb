                    RowBox[{"Print", "[", 
                    RowBox[{"\"\<Singular point: \>\"", ",", 
                    RowBox[{
                    RowBox[{"theSingularList", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "//", "N"}]}], "]"}], 
                    ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]}], 
                    "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}], 
                    ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]}], 
               "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", 
            "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", "theReturn"}]}], 
