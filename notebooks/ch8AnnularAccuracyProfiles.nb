Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{"generate", " ", "3", "D", " ", "plot"}], "\[IndentingNewLine]", 
   "*)"}], "\[IndentingNewLine]", " ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"extRadiusTicks", "[", "n_", "]"}], ":=", 
     RowBox[{
      RowBox[{"radiusRange", "[", 
       RowBox[{"[", "1", "]"}], "]"}], "+", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"radiusRatios", "[", 
         RowBox[{"[", "n", "]"}], "]"}], "radiusDif"}], ")"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", " ", 
   RowBox[{"orderGrids", "=", 
    RowBox[{"Array", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Floor", "@", "#"}], "&"}], ",", 
      RowBox[{"{", "5", "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"orderStart", ",", 
        RowBox[{"orderEnd", "-", "2"}]}], "}"}]}], "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"pointPlot3D", "=", 
