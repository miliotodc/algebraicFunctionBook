Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "getExtendedBranchPlot2", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<radialSegments\>\"", "->", "15"}], ",", 
      RowBox[{"\"\<arcSegments\>\"", "->", "24"}], ",", 
      RowBox[{"\"\<totalIntegrationSteps\>\"", "->", "2500000"}], ",", 
      RowBox[{"\"\<maxStepSize\>\"", "->", 
       RowBox[{"1", "/", "1000"}]}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"getExtendedBranchPlot2", "[", 
    RowBox[{
    "annulusTable_", ",", "thePlotType_", ",", "annularIndex_", ",", 
     "branchNum_", ",", "thetaV_", ",", "annularExtensions_", ",", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "newRadiiTable", ",", "rMin", ",", "rMax", ",", "aIndex", ",", "sIndex",
        ",", "currentAnnuli", ",", "currentMonodromyList", ",", "branchSize", 
       ",", "rootIndex", ",", "tStart", ",", "tEnd", ",", "zStart", ",", 
       "zThetaF", ",", "theRoots", ",", "wStart", ",", "wDeriv", ",", 
       "mdeialTrace", ",", "arcSegmentList", ",", "theBranchSet", ",", 
       "rStart", ",", "rEnd", ",", "zRadiusF", ",", "innerRadialTrace", ",", 
       "innerRValues", ",", "outerRadialTrace", ",", "outerRValues", ",", 
       "medialTrace", ",", "branchRecord", ",", "branchMonodromy", ",", 
       "extendedRange", ",", "selectedMonodromy", ",", "theRootIndex", ",", 
       "annularExtensionBranches", ",", "branchPosition", ",", 
       "extendedDomain", ",", "newMedialRadius", ",", "theZ", ",", 
       "radialTrace", ",", "oldRNorm", ",", "newRNorm", ",", "newWStart"}], 
      "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "get", " ", "annulus", " ", "index", " ", "into", " ", "annulusTable"}],
       " ", "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"aIndex", ",", "sIndex"}], "}"}], "=", 
       RowBox[{"getSingTableIndexes", "[", 
        RowBox[{"annulusTable", ",", "annularIndex"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"branchMonodromy", "=", 
       RowBox[{"annulusTable", "[", 
        RowBox[{"[", 
         RowBox[{"aIndex", ",", "6", ",", "branchNum"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<selectedMonodromy: \>\"", ",", "branchMonodromy"}], "]"}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"theRootIndex", "=", 
       RowBox[{"branchMonodromy", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"oldRNorm", "=", 
       RowBox[{"annulusTable", "[", 
        RowBox[{"[", 
         RowBox[{"aIndex", ",", "4"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", "\[IndentingNewLine]", " ", 
       RowBox[{
        RowBox[{
        "now", " ", "find", " ", "branch", " ", "in", " ", 
         "annularExtensions", " ", "table", " ", "annularExtensionBranches"}],
         ",", "branchPosition", ",", "extendedDomain", ",", 
        "newMedialRadius"}], "\[IndentingNewLine]", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<annularExtensions record: \>\"", ",", 
        RowBox[{
         RowBox[{"annularExtensions", "[", 
          RowBox[{"[", "annularIndex", "]"}], "]"}], "//", "N"}]}], "]"}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"annularExtensionBranches", "=", 
       RowBox[{"annularExtensions", "[", 
        RowBox[{"[", 
         RowBox[{"annularIndex", ",", "2", ",", "All", ",", "1"}], "]"}], 
        "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{
       "\"\<annularExtensionBranches: \>\"", ",", 
        "annularExtensionBranches"}], "]"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"branchPosition", "=", 
       RowBox[{
        RowBox[{"Position", "[", 
         RowBox[{"annularExtensionBranches", ",", 
          RowBox[{"x_", "/;", 
           RowBox[{"x", "==", "branchMonodromy"}]}]}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<branchPosition: \>\"", ",", "branchPosition"}], "]"}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"extendedDomain", "=", 
       RowBox[{"annularExtensions", "[", 
        RowBox[{"[", 
         RowBox[{"annularIndex", ",", "2", ",", "branchPosition", ",", "2"}], 
         "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<extendedDomain: \>\"", ",", 
        RowBox[{"extendedDomain", "//", "N"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<extended domain indexes: \>\"", ",", 
        RowBox[{"annularExtensions", "[", 
         RowBox[{"[", 
          RowBox[{"annularIndex", ",", "2", ",", "branchPosition", ",", "3"}],
           "]"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"annularExtensions", "[", 
          RowBox[{"[", 
           RowBox[{
           "annularIndex", ",", "2", ",", "branchPosition", ",", "3"}], "]"}],
           "]"}], "==", 
         RowBox[{"{", 
          RowBox[{"annularIndex", ",", 
           RowBox[{"annularIndex", "+", "1"}]}], "}"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"Style", "[", 
           RowBox[{
           "\"\<This branch is not analytically-continued\>\"", ",", "Blue"}],
            "]"}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", "\[IndentingNewLine]", " ", 
       RowBox[{
       "now", " ", "set", " ", "up", " ", "IVP", " ", "to", " ", "integrate", 
        " ", "from", " ", "mIVP", " ", "point", " ", "to", " ", "new", " ", 
        "medial", " ", "radius"}], "\[IndentingNewLine]", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"newMedialRadius", "=", 
       RowBox[{
        RowBox[{"extendedDomain", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"extendedDomain", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "-", 
           RowBox[{"extendedDomain", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "/", "2"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<oldNorm: \>\"", ",", 
        RowBox[{"N", "[", 
         RowBox[{"oldRNorm", ",", "10"}], "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<newMedialRadius: \>\"", ",", 
        RowBox[{"N", "[", 
         RowBox[{"newMedialRadius", ",", "10"}], "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"rStart", "=", "oldRNorm"}], ";", "\[IndentingNewLine]", 
      RowBox[{"rEnd", "=", "newMedialRadius"}], ";", "\[IndentingNewLine]", 
      RowBox[{"newRNorm", "=", "rEnd"}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"theZ", "[", "r_", "]"}], ":=", 
       RowBox[{"r", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"I", " ", "$thetaV"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"theRoots", "=", 
       RowBox[{"w", "/.", 
        RowBox[{"NSolve", "[", 
         RowBox[{
          RowBox[{"$theFunction", "\[Equal]", "0"}], "/.", 
          RowBox[{"z", "\[Rule]", 
           RowBox[{"theZ", "[", "rStart", "]"}]}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"wStart", "=", 
       RowBox[{"theRoots", "[", 
        RowBox[{"[", "theRootIndex", "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"wDeriv", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"w", "'"}], "[", "r", "]"}], "\[Equal]", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", 
             FractionBox[
              RowBox[{"D", "[", 
               RowBox[{"$theFunction", ",", "z"}], "]"}], 
              RowBox[{"D", "[", 
               RowBox[{"$theFunction", ",", "w"}], "]"}]]}], 
            RowBox[{"D", "[", 
             RowBox[{
              RowBox[{"theZ", "[", "r", "]"}], ",", "r"}], "]"}]}], ")"}], "/.", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"w", "\[Rule]", 
             RowBox[{"w", "[", "r", "]"}]}], ",", 
            RowBox[{"z", "\[Rule]", 
             RowBox[{"theZ", "[", "r", "]"}]}]}], "}"}]}], ")"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"radialTrace", "=", 
       RowBox[{"NDSolveValue", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"wDeriv", ",", 
           RowBox[{
            RowBox[{"w", "[", "rStart", "]"}], "\[Equal]", "wStart"}]}], 
          "}"}], ",", "w", ",", 
         RowBox[{"{", 
          RowBox[{"r", ",", "rStart", ",", "rEnd"}], "}"}]}], "]"}]}], ";", 
      " ", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", "\"\<aax\>\"", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"newWStart", "=", 
       RowBox[{"radialTrace", "[", "rEnd", "]"}]}], ";", 
