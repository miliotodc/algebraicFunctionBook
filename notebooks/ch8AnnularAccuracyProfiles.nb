                    RowBox[{"1", ";;", "index"}]}], "]"}], "]"}], "/.", 
                 RowBox[{"z", "->", "t"}]}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"theTestValue", "=", 
                RowBox[{"baseF2", "[", "newZ", "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"ePos", "[", 
                  RowBox[{"[", "index", "]"}], "]"}], ",", 
                 RowBox[{"SetPrecision", "[", 
                  RowBox[{
                   RowBox[{"type", "@", "theTestValue"}], ",", "wp"}], "]"}], 
                 ",", 
                 RowBox[{"Abs", "[", 
                  RowBox[{"actW", "-", "theTestValue"}], "]"}]}], "}"}]}], 
              ",", "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{"index", ",", "expInc", ",", 
                RowBox[{"Length", "@", "ePos"}], ",", "expInc"}], "}"}]}], 
             "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"correctNumber", "=", 
            RowBox[{"type", "@", 
             RowBox[{"SetPrecision", "[", " ", 
              RowBox[{"actW", ",", "wp"}], "]"}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"correctChar", "=", 
            RowBox[{"convertToChar", "[", "correctNumber", "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"cTable2", "=", 
            RowBox[{"Table", "[", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"maxCharIndex", "=", "0"}], ";", "\[IndentingNewLine]", 
               RowBox[{"testNumber", "=", 
                RowBox[{"errTable", "[", 
                 RowBox[{"[", 
                  RowBox[{"sIndex", ",", "2"}], "]"}], "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"testChar", "=", 
                RowBox[{"convertToChar", "[", "testNumber", "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"i", "=", "1"}], ";", "\[IndentingNewLine]", 
               RowBox[{"While", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"correctChar", "[", 
