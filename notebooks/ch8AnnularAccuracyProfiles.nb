           "\[IndentingNewLine]", 
           RowBox[{"i", "=", "1"}], ";", "\[IndentingNewLine]", 
           RowBox[{"While", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"actWChar", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "==", 
               RowBox[{"seriesWChar", "[", 
                RowBox[{"[", "i", "]"}], "]"}]}], " ", "&&", " ", 
              RowBox[{"i", "<", "maxCharLen"}]}], ",", "\[IndentingNewLine]", 
