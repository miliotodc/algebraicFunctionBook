Cell[CellGroupData[{

Cell["\<\
Section 4:  Import precise analytic and singular expansions for inner annular \
domains, a_2 through a_{n-1}.  \
\>", "Section",
 CellChangeTimes->{{3.944295375647391*^9, 3.9442953892018485`*^9}, {
  3.9591540590100484`*^9, 3.9591540655216403`*^9}, {3.9737767259588284`*^9, 
  3.9737767262475505`*^9}, {3.9811799121860137`*^9, 3.981179912315158*^9}, {
  3.9825950554679303`*^9, 3.982595058928299*^9}, {3.986994976678142*^9, 
  3.9869949824494104`*^9}, {3.994761673207382*^9, 
  3.994761691785445*^9}},ExpressionUUID->"05f93a92-c532-46ca-8222-\
70d527bccd52"],

Cell["\<\
This section is used to generate accuracy profiles for inner annular domains \
(not a_1 or a_{n}) as these can be generated by the Chatper 5 notebook (the \
a_n domain profiles are determined by the a_1 expansion at infinity).\
\>", "Text",
 CellChangeTimes->{{3.9947617001825128`*^9, 3.9947617445570326`*^9}, {
  3.994761800549223*^9, 
  3.994761841097246*^9}},ExpressionUUID->"f9d707cf-dea0-4977-88e4-\
487af28adfc9"],

Cell[CellGroupData[{

Cell["\<\
Section 4.1:  Import combinedExpansion terms previously generated by the \
chapter 6 notebook\
\>", "Subsection",
 CellChangeTimes->{{3.959593997296858*^9, 3.9595940048043604`*^9}, {
  3.9597617200440397`*^9, 3.9597617236234016`*^9}, {3.982504076548872*^9, 
  3.9825040861271996`*^9}, {3.9947617530750685`*^9, 
  3.994761765994272*^9}},ExpressionUUID->"f39ddc89-daa5-45d9-9e9d-\
067b0b056b11"],

Cell["\<\
Note:  The annular power expansions for the base annular branch must be \
available for import.  For example if the {1,2} branch in a_ 4 extends into \
a_ 25, then the power expansions for the a_ 4 (1,2) branch must be available \
for import to generate the extended branch with domain a_4 through a_25  with \
its power expansions.\
\>", "Text",
 CellChangeTimes->{{3.9924356667028627`*^9, 
  3.9924357116494303`*^9}},ExpressionUUID->"c8f3845c-d1e0-4100-8c55-\
fb977ae5d8d2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"$selectedAnnulus", "==", 
        RowBox[{"Length", "@", "theAnnuli"}]}], "||", " ", 
       RowBox[{"$selectedAnnulus", "==", "1"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"Style", "[", 
         RowBox[{
         "\"\<This section is for inner annular domains 2 through n-1 with n \
the total annuli\>\"", ",", "Red"}], "]"}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"Style", "[", 
         RowBox[{
         "\"\<Accuracy studies of a_1 are done with the chapter 5 \
notebook\>\"", ",", "Red"}], "]"}], "]"}], ";"}], "\[IndentingNewLine]", ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"FileExistsQ", "[", 
          RowBox[{"combinedExpansionTermsFileName", "[", 
           RowBox[{
           "$theTestCase", ",", "$selectedAnnulus", ",", 
            "theBranchMonodromy"}], "]"}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"\"\<Importing \>\"", ",", 
            RowBox[{"combinedExpansionTermsFileName", "[", 
             RowBox[{
             "$theTestCase", ",", "$selectedAnnulus", ",", 
              "theBranchMonodromy"}], "]"}]}], "]"}], ";", 
          "\[IndentingNewLine]", " ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
            "analyticTerms", ",", "analyticOrderList", ",", "singularTerms", 
             ",", "singularOrderList"}], "}"}], " ", "=", 
           RowBox[{"Import", "[", 
            RowBox[{"combinedExpansionTermsFileName", "[", 
             RowBox[{
             "$theTestCase", ",", "$selectedAnnulus", ",", 
              "theBranchMonodromy"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"maxAnalyticOrder", "=", 
           RowBox[{"analyticOrderList", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"-", "1"}], ",", "1"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"maxSingularOrder", "=", 
           RowBox[{"singularOrderList", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"-", "1"}], ",", "1"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"maxSeriesOrder", "=", 
           RowBox[{"Min", "[", 
            RowBox[{"maxAnalyticOrder", ",", "maxSingularOrder"}], "]"}]}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<maxSeriesOrder: \>\"", ",", "maxSeriesOrder"}], "]"}],
           ";", "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<Size of analytic Terms: \>\"", ",", 
            RowBox[{"Length", "@", "analyticTerms"}], ",", "\"\< prec: \>\"", 
            ",", 
            RowBox[{"Precision", "@", "analyticTerms"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<Size of singular terms: \>\"", ",", 
            RowBox[{"Length", "@", "singularTerms"}], ",", "\"\< prec: \>\"", 
            ",", 
            RowBox[{"Precision", "@", "singularTerms"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<The extendedDomain: \>\"", ",", 
            RowBox[{"extendedDomain", "//", "N"}]}], "]"}], ";"}], 
         "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{"\"\<Combined annular expansion file \>\"", "<>", 
              RowBox[{"combinedExpansionTermsFileName", "[", 
               RowBox[{
               "$theTestCase", ",", "$selectedAnnulus", ",", 
                "theBranchMonodromy"}], "]"}], "<>", 
              "\"\< not found.  Create this file with the chapter 6 \
notebook\>\""}], ",", "Red"}], "]"}], "]"}], ";"}]}], "\[IndentingNewLine]", 
        "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], 
   "\[IndentingNewLine]"}]}]], "Input",
