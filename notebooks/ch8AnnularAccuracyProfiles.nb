      RowBox[{
       RowBox[{"(", 
        RowBox[{"7", "-", 
         RowBox[{"2", " ", "z"}], "-", 
         RowBox[{"4", " ", 
          RowBox[{"z", "^", "2"}]}], "-", 
         RowBox[{"z", "^", "3"}]}], ")"}], 
       RowBox[{"w", "^", "2"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"7", " ", "z"}], "-", 
         RowBox[{"2", " ", 
          RowBox[{"z", "^", "3"}]}]}], ")"}], 
