              RowBox[{"{", 
               RowBox[{"wDeriv", ",", 
                RowBox[{
                 RowBox[{"w", "[", "rStart", "]"}], "\[Equal]", "wStart"}]}], 
               "}"}], ",", "w", ",", 
              RowBox[{"{", 
               RowBox[{"r", ",", "rStart", ",", "rEnd"}], "}"}], ",", 
              RowBox[{"MaxSteps", "\[Rule]", "totalIntegrationSteps"}], ",", 
              RowBox[{"MaxStepSize", "\[Rule]", "maxStepSize"}]}], "]"}]}], 
           ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{
            "generate", " ", "points", " ", "along", " ", "blue", " ", 
             "radial", " ", "contour", " ", "total", " ", "of", " ", 
             RowBox[{"1", "/", "2"}], " ", "of", " ", "annularSegments"}], 
            " ", "*)"}], "\[IndentingNewLine]", 
           RowBox[{"innerRValues", "=", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Re", "[", "z", "]"}], ",", 
                 RowBox[{"Im", "[", "z", "]"}], ",", 
                 RowBox[{"thePlotType", "[", 
                  RowBox[{"innerRadialTrace", "[", "r", "]"}], "]"}]}], "}"}],
                "/.", 
               RowBox[{"z", "\[Rule]", 
                RowBox[{"r", " ", 
                 RowBox[{"Exp", "[", 
                  RowBox[{"\[ImaginaryI]", " ", "tStart"}], "]"}]}]}]}], ",", 
              RowBox[{"{", 
               RowBox[{"r", ",", 
                RowBox[{"newRadiiTable", "[", 
                 RowBox[{"[", 
                  RowBox[{"1", ";;", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"radialSegments", "-", "1"}], ")"}], "/", "2"}], 
                    "+", "1"}]}], "]"}], "]"}]}], "}"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"rStart", "=", "rNorm"}], ";", "\[IndentingNewLine]", 
           RowBox[{"rEnd", "=", "rMax"}], ";", "\[IndentingNewLine]", 
           RowBox[{"(*", " ", "*)"}], "\[IndentingNewLine]", 
           RowBox[{"wStart", "=", 
