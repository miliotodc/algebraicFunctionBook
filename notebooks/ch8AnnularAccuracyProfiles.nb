Cell[CellGroupData[{

Cell["Generate interpolation function of v-plot", "Subsubsection",
 CellChangeTimes->{{3.9208104980200305`*^9, 
  3.9208105049559526`*^9}},ExpressionUUID->"83423974-33ae-47ca-aa41-\
4fb6e84251c3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{
   RowBox[{
    RowBox[{"intFPointTableB", "=", 
     RowBox[{"Interpolation", "[", 
      RowBox[{"pointTable", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "2", ",", "4"}], "}"}]}], "]"}], "]"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"intFPlotPointTableB", "=", 
     RowBox[{"Plot3D", "[", 
      RowBox[{
       RowBox[{"intFPointTableB", "[", 
        RowBox[{"r", ",", "\[Theta]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", 
         RowBox[{"radiusRatios", "[", 
          RowBox[{"[", "5", "]"}], "]"}], ",", 
         RowBox[{"radiusRatios", "[", 
          RowBox[{"[", "95", "]"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Theta]", ",", 
         RowBox[{"thetaRange", "[", 
          RowBox[{"[", "2", "]"}], "]"}], ",", 
         RowBox[{
          RowBox[{"thetaRange", "[", 
           RowBox[{"[", 
            RowBox[{"-", "1"}], "]"}], "]"}], "+", 
          RowBox[{"4", " ", "Pi"}]}]}], "}"}], ",", 
       RowBox[{"BoxRatios", "->", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "1", ",", " ", "1"}], "}"}]}], ",", 
       RowBox[{"PlotStyle", "->", "LightBlue"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"radiusThetaPlot3D", "=", 
    RowBox[{"Show", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"pointTablePlot", ",", "intFPlotPointTableB"}], "}"}], ",", 
      RowBox[{"Framed", "->", "True"}], ",", 
      RowBox[{"AxesLabel", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{
          "\"\<\!\(\*SubscriptBox[\(r\), \(s\)]\)\>\"", ",", "14", ",", 
           "Bold", ",", "Black"}], "]"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{"\"\<\[Theta]\>\"", ",", "14", ",", "Bold", ",", "Black"}], 
          "]"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{"\"\<A\>\"", ",", "14", ",", "Bold", ",", "Black"}], 
          "]"}]}], "}"}]}], ",", 
      RowBox[{"AxesEdge", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", 
           RowBox[{"-", "1"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", 
           RowBox[{"-", "1"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", 
           RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], ",", 
      RowBox[{"FaceGrids", "->", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", 
          RowBox[{"-", "1"}]}], "}"}], "}"}]}], ",", 
      RowBox[{"FaceGridsStyle", "\[Rule]", 
       RowBox[{"Directive", "[", 
        RowBox[{"Black", ",", "Bold"}], "]"}]}]}], "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]"}]}]], "Input",
