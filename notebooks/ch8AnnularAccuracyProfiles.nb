                    RowBox[{"Print", "[", 
                    RowBox[{"\"\<Total annuli: \>\"", ",", 
                    RowBox[{"Length", "@", "theAnnuli"}]}], "]"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"minRingSize", "=", 
                    RowBox[{"Min", "[", 
                    RowBox[{"Differences", "[", "theAnnuli", "]"}], "]"}]}], 
                    ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
                    RowBox[{"AppendTo", "[", 
                    RowBox[{"theAnnuli", ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"ringSizes", "[", 
                    RowBox[{"[", 
                    RowBox[{"-", "1"}], "]"}], "]"}], ",", 
                    RowBox[{
                    RowBox[{"ringSizes", "[", 
                    RowBox[{"[", 
                    RowBox[{"-", "1"}], "]"}], "]"}], "+", "4"}]}], "}"}]}], 
                    "]"}], ";", "\[IndentingNewLine]", 
                    RowBox[{"Print", "[", 
                    RowBox[{"\"\<theAnnuli: \>\"", ",", 
                    RowBox[{"theAnnuli", "//", "N"}]}], "]"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"(*", "\[IndentingNewLine]", " ", 
                    RowBox[{"compute", " ", "radiiTable"}], 
                    "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
                    RowBox[{"radiiTable", "=", 
                    RowBox[{"Table", "[", 
                    RowBox[{
                    RowBox[{"Array", "[", 
                    RowBox[{
                    RowBox[{"#", "&"}], ",", "radialSegments", ",", 
                    RowBox[{"theAnnuli", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"i", ",", "1", ",", 
                    RowBox[{"Length", "[", "theAnnuli", "]"}]}], "}"}]}], 
                    "]"}]}], ";", "\[IndentingNewLine]", 
                    RowBox[{"(*", 
                    RowBox[{
                    RowBox[{"singularListR", "=", "theSingularList"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"singularListR", "[", 
                    RowBox[{"[", "#", "]"}], "]"}], "=", 
                    RowBox[{"Style", "[", 
                    RowBox[{
                    RowBox[{"N", "[", 
                    RowBox[{
                    RowBox[{"singularListR", "[", 
                    RowBox[{"[", "#", "]"}], "]"}], ",", "6"}], "]"}], ",", 
                    "Red"}], "]"}]}], ")"}], "&"}], "/@", "poleIndexes"}], 
                    ";"}], "\[IndentingNewLine]", "*)"}], 
                    "\[IndentingNewLine]", 
                    RowBox[{"(*", "\[IndentingNewLine]", " ", 
                    RowBox[{"compute", " ", "annular", " ", "sizes"}], 
                    "\[IndentingNewLine]", "*)"}], " ", "\[IndentingNewLine]", 
                    RowBox[{"annularSizes", "=", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "[", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "-", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "&"}], "/@", " ",
                     "theAnnuli"}], "//", "N"}]}], ";", "\[IndentingNewLine]", 
                    RowBox[{"Print", "[", 
                    RowBox[{"\"\<annularSizes: \>\"", ",", 
                    RowBox[{"annularSizes", "//", "N"}]}], "]"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"(*", "\[IndentingNewLine]", "  ", 
                    RowBox[{
                    "determine", " ", "which", " ", "singular", " ", "points",
                     " ", "are", " ", "on", " ", "each", " ", "ring"}], 
                    "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
                    RowBox[{"ringMembers", "=", 
                    RowBox[{"Table", "[", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"Select", "[", 
                    RowBox[{
                    RowBox[{"theSingularList", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ";;"}], "]"}], "]"}], ",", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "[", 
                    RowBox[{
                    RowBox[{"Abs", "[", "#", "]"}], "-", 
                    RowBox[{"theAnnuli", "[", 
                    RowBox[{"[", 
                    RowBox[{"rIndex", ",", "1"}], "]"}], "]"}]}], "]"}], "<", 
                    RowBox[{"10", "^", 
                    RowBox[{"-", "10"}]}]}], "&"}]}], "]"}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{"{", 
                    RowBox[{"rIndex", ",", "1", ",", 
                    RowBox[{"Length", "@", "theAnnuli"}]}], "}"}]}], 
                    "\[IndentingNewLine]", "]"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"(*", "\[IndentingNewLine]", " ", 
                    RowBox[{
                    "determine", " ", "position", " ", "in", " ", 
                    "theSingularList", " ", "for", " ", "each", " ", "ring", 
                    " ", "member"}], "\[IndentingNewLine]", "*)"}], " ", 
                    "\[IndentingNewLine]", 
                    RowBox[{"singularRingIndexes", "=", 
                    RowBox[{"Table", "[", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"Flatten", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Position", "[", 
                    RowBox[{
                    RowBox[{"theSingularList", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ";;"}], "]"}], "]"}], ",", 
                    RowBox[{"x_", "/;", " ", 
                    RowBox[{
                    RowBox[{"Abs", "[", 
                    RowBox[{"x", "-", "#"}], "]"}], "<", 
                    RowBox[{"10", "^", 
                    RowBox[{"-", "10"}]}]}]}]}], "]"}], "&"}], " ", "/@", " ", 
                    RowBox[{"ringMembers", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}], "]"}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{"{", 
                    RowBox[{"j", ",", "1", ",", 
                    RowBox[{"Length", "@", "ringMembers"}]}], "}"}]}], 
                    "\[IndentingNewLine]", "]"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"polePos", "=", 
                    RowBox[{"Flatten", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"Position", "[", 
                    RowBox[{"ringMembers", ",", 
                    RowBox[{"x_", "/;", 
                    RowBox[{
                    RowBox[{"Abs", "[", 
                    RowBox[{"x", "-", "#"}], "]"}], "<", 
                    RowBox[{"10", "^", 
                    RowBox[{"-", "10"}]}]}]}]}], "]"}], "&"}], "/@", " ", 
                    RowBox[{"theSingularList", "[", 
                    RowBox[{"[", "poleIndexes", "]"}], "]"}]}], ",", "1"}], 
                    "]"}]}], ";", "\[IndentingNewLine]", 
                    RowBox[{"(*", "\[IndentingNewLine]", " ", 
                    RowBox[{
                    "use", " ", "ringMembersR", " ", "for", " ", "list", " ", 
                    "of", " ", "singular", " ", "points", " ", "with", " ", 
                    "poles", " ", "in", " ", "red"}], "\[IndentingNewLine]", 
                    "*)"}], "\[IndentingNewLine]", 
                    RowBox[{"ringMembersR", "=", 
                    RowBox[{"N", "[", 
                    RowBox[{"ringMembers", ",", "6"}], "]"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"For", "[", 
                    RowBox[{
                    RowBox[{"i", "=", "1"}], ",", 
                    RowBox[{"i", "<=", 
                    RowBox[{"Length", "@", "polePos"}]}], ",", 
                    RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"ringMembersR", "[", 
                    RowBox[{"[", 
                    RowBox[{"Sequence", "@@", 
                    RowBox[{"polePos", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], "]"}], "]"}], "=", 
                    RowBox[{"Style", "[", 
                    RowBox[{
                    RowBox[{"ringMembersR", "[", 
                    RowBox[{"[", 
                    RowBox[{"Sequence", "@@", 
                    RowBox[{"polePos", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], "]"}], "]"}], ",", 
                    "Red"}], "]"}]}]}], "\[IndentingNewLine]", "]"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"Print", "[", 
                    RowBox[{"\"\<ringMemvbersR: \>\"", ",", 
                    RowBox[{"ringMembersR", "//", "N"}]}], "]"}], ";", 
                    "\[IndentingNewLine]", "\[IndentingNewLine]", 
                    RowBox[{"theReturn", "=", 
                    RowBox[{"{", 
                    RowBox[{
                    "theSingularList", ",", "argList", ",", "zeroIndexes", 
                    ",", "poleIndexes", ",", "minRadiusArray", ",", 
                    "ringSizes", ",", "theAnnuli", ",", "singularListR", ",", 
                    "annularSizes", ",", "ringMembers", ",", "radiiTable", 
                    ",", "ringMembersR", ",", "singularRingIndexes"}], 
                    "}"}]}], ";", "\[IndentingNewLine]", 
                    RowBox[{"(*", 
                    RowBox[{
                    RowBox[{"theReturn", "=", 
                    RowBox[{"{", 
                    RowBox[{
                    "theSingularList", ",", "poleIndexes", ",", 
                    "minRadiusArray", ",", "res", ",", "zeroIndexes", ",", 
                    "ringTableR", ",", "theAnnuli", ",", "radiiTable"}], 
                    "}"}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
                    RowBox[{"If", "[", 
                    RowBox[{"diagFlag", ",", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"Print", "[", 
                    RowBox[{"\"\<Total singular points: \>\"", ",", 
                    RowBox[{"Length", "@", "theSingularList"}]}], "]"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"Print", "[", 
                    RowBox[{"\"\<Precision of singular points: \>\"", ",", 
                    RowBox[{"Precision", "@", "theSingularList"}]}], "]"}], 
                    ";", "\[IndentingNewLine]", 
                    RowBox[{"Print", "[", 
                    RowBox[{"\"\<Total poles: \>\"", ",", 
                    RowBox[{"Length", "@", "poleIndexes"}]}], "]"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"Print", "[", 
                    RowBox[{
                    RowBox[{"Style", "[", 
                    RowBox[{"\"\<Pole indexes: \>\"", ",", "Red"}], "]"}], 
                    ",", 
                    RowBox[{"Style", "[", 
                    RowBox[{"poleIndexes", ",", "Red"}], "]"}]}], "]"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"Print", "[", 
                    RowBox[{"\"\<Total zero points: \>\"", ",", 
                    RowBox[{"Length", "@", "zeroIndexes"}]}], "]"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"Print", "[", 
                    RowBox[{
                    RowBox[{"Style", "[", 
                    RowBox[{"\"\<Zero indexes: \>\"", ",", "Blue"}], "]"}], 
                    ",", 
                    RowBox[{"Style", "[", 
                    RowBox[{"zeroIndexes", ",", "Blue"}], "]"}]}], "]"}], ";",
                     "\[IndentingNewLine]", 
                    RowBox[{"Print", "[", 
