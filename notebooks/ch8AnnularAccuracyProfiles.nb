                    RowBox[{"w", "[", "tStart", "]"}], "\[Equal]", 
                    "wstart"}]}], "}"}], ",", "w", ",", 
                    RowBox[{"{", 
                    RowBox[{"t", ",", "tStart", ",", "tEnd"}], "}"}], ",", 
                    RowBox[{"MaxSteps", "\[Rule]", "2000000"}], ",", 
                    RowBox[{"MaxStepSize", "\[Rule]", 
                    RowBox[{"precisionArray", "[", 
                    RowBox[{"[", 
                    RowBox[{"numTries", ",", "1"}], "]"}], "]"}]}], ",", 
                    RowBox[{"WorkingPrecision", "\[Rule]", 
                    RowBox[{"precisionArray", "[", 
                    RowBox[{"[", 
                    RowBox[{"numTries", ",", "2"}], "]"}], "]"}]}]}], "]"}], 
                   "]"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"theCentralTrace", "[", "t_", "]"}], "=", 
               RowBox[{"Evaluate", "[", 
                RowBox[{"Flatten", "[", 
                 RowBox[{
                  RowBox[{"w", "[", "t", "]"}], "/.", "myazsol"}], "]"}], 
                "]"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"theCentralTraceValueDigits", "=", 
               RowBox[{
                RowBox[{"getDigits", "[", 
                 RowBox[{
                  RowBox[{"theCentralTrace", "[", "tEnd", "]"}], ",", 
                  "baseComparisonAccuracy"}], "]"}], "//", "First"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"loopPos", "=", 
               RowBox[{"Position", "[", 
                RowBox[{
                "theBaseValueDigits", ",", "theCentralTraceValueDigits"}], 
                "]"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Length", "[", "loopPos", "]"}], "\[NotEqual]", 
                 "1"}], ",", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"Print", "[", 
                  RowBox[{"\"\<Error with loopPos: \>\"", ",", "loopPos"}], 
                  "]"}], ";", "\[IndentingNewLine]", " ", 
                 RowBox[{"Print", "[", 
                  RowBox[{
                  "\"\<Base Value digits: \>\"", ",", "theBaseValueDigits"}], 
                  "]"}], ";", "\[IndentingNewLine]", 
                 RowBox[{"Print", "[", 
                  RowBox[{"\"\<base values: \>\"", ",", 
                   RowBox[{"theBaseValues", "//", "N"}]}], "]"}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"Print", "[", 
                  RowBox[{
                  "\"\<the Central trace Digits: \>\"", ",", 
                   "theCentralTraceValueDigits"}], "]"}], ";", " ", 
                 "\[IndentingNewLine]", 
                 RowBox[{"Print", "[", 
                  RowBox[{"\"\<central trace: \>\"", ",", 
                   RowBox[{"theCentralTrace", "[", "tEnd", "]"}]}], "]"}], 
                 ";"}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"branchValues", "=", 
                  RowBox[{"Append", "[", 
                   RowBox[{"branchValues", ",", 
                    RowBox[{"{", 
                    RowBox[{"wstartDigits", ",", 
                    RowBox[{"theBaseValueDigits", "[", 
                    RowBox[{"[", 
                    RowBox[{"loopPos", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "1"}], "]"}], "]"}], "]"}], "]"}]}], 
                    "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
                 RowBox[{"posFoundFlag", "=", "True"}], ";"}]}], 
               "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"posFoundFlag", "\[Equal]", "False"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
              "Print", "[", 
               "\"\<Position not found at end of 10 attempts at increasing \
precision.\>\"", "]"}], ";", "\[IndentingNewLine]", 
              RowBox[{"Abort", "[", "]"}], ";"}]}], "\[IndentingNewLine]", 
            "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
         "branchValues", ",", "saveBaseDigits", ",", "savePoleValues"}], 
         "}"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
