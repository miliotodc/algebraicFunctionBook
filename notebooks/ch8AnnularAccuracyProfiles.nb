Cell[CellGroupData[{

Cell["Some additional plots", "Section",
 CellChangeTimes->{{3.9738486150986094`*^9, 
  3.97384861863231*^9}},ExpressionUUID->"b31d1123-7321-4853-8c76-\
99f18715a682"],

Cell[CellGroupData[{

Cell["\<\
Generate full v-shaped accuracy plot using full branchSheetF series\
\>", "Subsubsection",
 CellChangeTimes->{{3.9208104539358816`*^9, 3.9208104612468376`*^9}, {
  3.9208132599758267`*^9, 
  3.9208132746288333`*^9}},ExpressionUUID->"3994df4f-0dc0-46b6-b9ef-\
23a0052dce69"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{
    "plot", " ", "accuracy", " ", "verses", " ", "argument", " ", "from"}], 
    " ", "-", 
    RowBox[{
    "Pi", " ", "to", " ", "Pi", " ", "for", " ", "a", " ", "selected", " ", 
     "radius"}]}], "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"theAngularErrorTable3D", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"theRadius", "=", 
         RowBox[{"SetPrecision", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"radiusRange", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "+", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"radiusRatios", "[", 
               RowBox[{"[", "rIndex", "]"}], "]"}], " ", "radiusDif"}], 
             ")"}]}], ",", "1000"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"theRadius", "=", 
           RowBox[{"Rationalize", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"radiusRange", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "+", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"radiusRatios", "[", 
                 RowBox[{"[", "rIndex", "]"}], "]"}], " ", "radiusDif"}], 
               ")"}]}], ",", "0"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{"theTheta", "=", 
         RowBox[{"SetPrecision", "[", 
          RowBox[{
           RowBox[{"thetaRange", "[", 
            RowBox[{"[", "thetaIndex", "]"}], "]"}], ",", "1000"}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"zVal", "=", 
         RowBox[{"SetPrecision", "[", 
          RowBox[{
           RowBox[{"theRadius", " ", 
            RowBox[{"Exp", "[", 
             RowBox[{"I", " ", "theTheta"}], "]"}]}], ",", "1000"}], "]"}]}], 
        ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"pVal", "=", 
         RowBox[{"branchSheetF", "[", 
          RowBox[{"zVal", ",", "n"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"wVals", "=", 
         RowBox[{"w", "/.", 
          RowBox[{"NSolve", "[", 
           RowBox[{
            RowBox[{"$theFunction", "==", "0"}], "/.", 
            RowBox[{"z", "->", "zVal"}]}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"errTable", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"#", "-", "pVal"}], "]"}], "&"}], "/@", " ", "wVals"}]}], 
        ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"pos", "=", 
         RowBox[{
          RowBox[{"Position", "[", 
           RowBox[{"errTable", ",", 
            RowBox[{"Min", "[", "errTable", "]"}]}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"radiusRatios", "[", 
           RowBox[{"[", "rIndex", "]"}], "]"}], ",", 
          RowBox[{"theTheta", "+", 
           RowBox[{"2", " ", "n", " ", "Pi"}]}], ",", 
          RowBox[{
           RowBox[{"errTable", "[", 
            RowBox[{"[", "pos", "]"}], "]"}], "//", "N"}], ",", 
          RowBox[{"Log", "[", 
           RowBox[{"10", ",", 
            RowBox[{"errTable", "[", 
             RowBox[{"[", "pos", "]"}], "]"}]}], "]"}]}], "}"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"rIndex", ",", "5", ",", "95"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"n", ",", "0", ",", 
         RowBox[{"$selectedMonodromyIndexCycleSize", "-", "1"}]}], "}"}], ",",
        "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"thetaIndex", ",", "2", ",", 
         RowBox[{"Length", "@", "thetaRange"}]}], "}"}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{"pointTable", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{"theAngularErrorTable3D", ",", "2"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"pointTablePlot", "=", 
    RowBox[{"ListPointPlot3D", "[", 
     RowBox[{
      RowBox[{"pointTable", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "2", ",", "4"}], "}"}]}], "]"}], "]"}], ",", 
      RowBox[{"BoxRatios", "->", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "1", ",", " ", "1"}], "}"}]}], ",", 
      RowBox[{"AxesLabel", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{"\"\<r\>\"", ",", "14", ",", "Bold", ",", "Black"}], "]"}], 
         ",", 
         RowBox[{"Style", "[", 
          RowBox[{"\"\<\[Theta]\>\"", ",", "14", ",", "Bold", ",", "Black"}], 
          "]"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{
          "\"\<\!\(\*SubscriptBox[\(Log\), \
\(10\)]\)[\!\(\*SubscriptBox[\(s\), \(a\)]\)]\>\"", ",", "14", ",", "Bold", 
           ",", "Black"}], "]"}]}], "}"}]}], ",", 
      RowBox[{"(*", 
       RowBox[{"FaceGrids", "->", 
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", 
           RowBox[{"-", "1"}]}], "}"}], "}"}]}], "*)"}], 
      RowBox[{"FaceGrids", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "0", ",", 
            RowBox[{"-", "1"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", "0", "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "Pi"}], ",", "0", ",", "Pi", ",", 
              RowBox[{"2", " ", "Pi"}], ",", 
              RowBox[{"3", " ", "Pi"}]}], "}"}]}], "}"}]}], "}"}], "}"}]}], 
      ",", 
      RowBox[{"FaceGridsStyle", "\[Rule]", 
       RowBox[{"Directive", "[", 
        RowBox[{"Black", ",", "Bold"}], "]"}]}], ",", 
      RowBox[{"Ticks", "->", 
       RowBox[{"{", 
        RowBox[{"Automatic", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "Pi"}], ",", 
             RowBox[{"-", "\[Pi]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"Pi", ",", "\[Pi]"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"2", " ", "Pi"}], ",", 
             RowBox[{"2", "\[Pi]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"3", " ", "Pi"}], ",", 
             RowBox[{"3", " ", "\[Pi]"}]}], "}"}]}], "}"}], ",", 
         "Automatic"}], "}"}]}], ",", 
      RowBox[{"AxesEdge", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", 
           RowBox[{"-", "1"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", 
           RowBox[{"-", "1"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", 
           RowBox[{"-", "1"}]}], "}"}]}], "}"}]}]}], "  ", "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.9208104170382633`*^9, 3.920810445375493*^9}, {
   3.920810600542852*^9, 3.920810601902042*^9}, {3.9208207959980383`*^9, 
   3.920820806636179*^9}, {3.920908856190514*^9, 3.920908856565416*^9}, {
   3.940342835956693*^9, 3.9403428367065067`*^9}, {3.9404145943902903`*^9, 
   3.9404145994981966`*^9}, 3.940926050065946*^9, 
   3.959149086982091*^9},ExpressionUUID->"61454f43-4c50-4544-9074-\
95a6538e637f"],

