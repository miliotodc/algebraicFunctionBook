   RowBox[{
    RowBox[{"plotDomain", "=", 
     RowBox[{"plottingRadiiTable", "[", 
      RowBox[{"[", "$selectedAnnulus", "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rMin", "=", 
     RowBox[{"plotDomain", "[", 
      RowBox[{"[", "plotDomainDif", "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rMax", "=", 
     RowBox[{"plotDomain", "[", 
      RowBox[{"[", 
       RowBox[{"-", "plotDomainDif"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"orderIndex", "=", "24"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"truncatedSeries", "[", "z_", "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"Plus", "@@", 
        RowBox[{"analyticTerms", "[", 
         RowBox[{"[", 
          RowBox[{"1", ";;", 
           RowBox[{"analyticOrderList", "[", 
            RowBox[{"[", 
             RowBox[{"orderIndex", ",", "2"}], "]"}], "]"}]}], "]"}], "]"}]}],
        ")"}], "+", 
      RowBox[{"(", 
       RowBox[{"Plus", "@@", 
        RowBox[{"singularTerms", "[", 
         RowBox[{"[", 
          RowBox[{"1", ";;", 
           RowBox[{"singularOrderList", "[", 
            RowBox[{"[", 
             RowBox[{"orderIndex", ",", "2"}], "]"}], "]"}]}], "]"}], "]"}]}],
        ")"}]}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{"theexp", "=", 
     RowBox[{"Exponent", "[", 
      RowBox[{
       RowBox[{"truncatedSeries", "[", "z", "]"}], ",", "z", ",", "List"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"theNum", "=", 
     RowBox[{"Numerator", "@", "theexp"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"clist", "=", 
     RowBox[{"Coefficient", "[", 
      RowBox[{
       RowBox[{"truncatedSeries", "[", "z", "]"}], ",", "z", ",", "theexp"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
