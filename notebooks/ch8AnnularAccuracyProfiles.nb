Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", "\[IndentingNewLine]", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"polishMedial", "[", 
     RowBox[{
      RowBox[{"t_", "?", "NumericQ"}], ",", 
      RowBox[{"r_", "?", "NumericQ"}], ",", "implicitF_", ",", 
      RowBox[{"medialVal_", "?", "NumericQ"}], ",", 
      RowBox[{"wPrec_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
