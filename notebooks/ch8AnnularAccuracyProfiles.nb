Cell[CellGroupData[{

Cell["getClosestIntegerOrder", "Subsection",
 CellChangeTimes->{{3.9169948520796213`*^9, 
  3.9169948560477*^9}},ExpressionUUID->"37f3ae97-7a0b-4a32-a7b1-662010c20460"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"getClosestIntegerOrder", "[", 
     RowBox[{"orderVal_", ",", "series_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "seriesSize", ",", "cycleExpList", ",", "nearestExpList", ",", 
        "theVals", ",", "nearestExp", ",", "posArray", ",", "pos", ",", 
        "seriesIndex"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"seriesSize", "=", 
        RowBox[{"Length", "@", 
         RowBox[{"series", "[", "z", "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"cycleExpList", "=", 
        RowBox[{"Exponent", "[", 
         RowBox[{
          RowBox[{"series", "[", "z", "]"}], ",", "z", ",", "List"}], "]"}]}],
        ";", "\[IndentingNewLine]", 
       RowBox[{"nearestExpList", "=", 
        RowBox[{"Nearest", "[", 
         RowBox[{"cycleExpList", ",", "orderVal"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "@", "nearestExpList"}], "==", "0"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"Style", "[", 
            RowBox[{"\"\<exponent not found\>\"", ",", "Red"}], "]"}], "]"}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"theVals", "=", 
           RowBox[{"{", 
            RowBox[{"\"\<ea\>\"", ",", "\"\<ea\>\""}], "}"}]}], ";"}], 
         "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"nearestExp", "=", 
           RowBox[{"nearestExpList", "[", 
            RowBox[{"[", 
             RowBox[{"-", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"posArray", "=", 
           RowBox[{"Position", "[", 
            RowBox[{"cycleExpList", ",", 
             RowBox[{"x_", "/;", 
              RowBox[{"x", "==", "nearestExp"}]}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "@", "posArray"}], "==", "0"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{
               RowBox[{"Style", "[", 
                RowBox[{"\"\<Error with posArray: \>\"", ",", "Red"}], "]"}], 
               ",", "posArray"}], "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"theVals", "=", 
              RowBox[{"{", 
               RowBox[{"\"\<eb\>\"", ",", "\"\<eb\>\""}], "}"}]}], ";"}], 
            "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"pos", "=", 
              RowBox[{"posArray", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"pos", "==", "seriesSize"}], " ", "&&", " ", 
                RowBox[{"orderVal", ">", 
                 RowBox[{"Round", "@", "nearestExp"}]}]}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"Print", "[", 
                 RowBox[{
                  RowBox[{"Style", "[", 
                   RowBox[{
                   "\"\<Requested order of series is greater than max series \
order \>\"", ",", "Red"}], "]"}], ",", 
                  RowBox[{"Style", "[", 
                   RowBox[{
                    RowBox[{"Round", "@", "nearestExp"}], ",", "Red"}], 
                   "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
                RowBox[{"theVals", "=", 
                 RowBox[{"{", 
                  RowBox[{"\"\<e\>\"", ",", "\"\<e\>\""}], "}"}]}], ";"}], 
               "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
               RowBox[{"theVals", "=", 
                RowBox[{"{", 
                 RowBox[{"orderVal", ",", "pos", ",", 
                  RowBox[{"cycleExpList", "[", 
                   RowBox[{"[", "pos", "]"}], "]"}]}], "}"}]}]}], 
              "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", 
           "]"}], ";"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
        "]"}], ";", "\[IndentingNewLine]", "theVals"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.9169264677086935`*^9, 3.9169264961709576`*^9}, {
  3.9169265733869925`*^9, 3.9169265752146606`*^9}, {3.916931338937172*^9, 
  3.916931339780907*^9}, {3.9169369371283903`*^9, 3.916937034386766*^9}},
 CellLabel->
  "In[106]:=",ExpressionUUID->"e73a0365-e015-4143-8091-2c94fa568a98"]
}, Closed]],

Cell[CellGroupData[{

Cell["getSingleConvergenceTrend", "Subsection",
 CellChangeTimes->{{3.8777648128828354`*^9, 
  3.8777648206467752`*^9}},ExpressionUUID->"42d7c41f-bcf7-4fd1-a654-\
bd698e819c35"],

Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"getSingleConvergenceTrend", "[", 
      RowBox[{
      "seriesIndex_", ",", "centerIndex_", ",", "clsp_", ",", "wp_", ",", 
       "zValue_", ",", "expInc_", ",", "type_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "cTable", ",", "cTable2", ",", "zVal", ",", "wTest", ",", "theWList", 
         ",", "theDif", ",", "pos", ",", "theIndex", ",", "s5", ",", "actW", 
         ",", "singularPoint", ",", "convData", ",", "branchStats", ",", 
         "typeIndex", ",", "limitPoint", ",", "maxRadius", ",", "errTable", 
         ",", "correctNumber", ",", "correctChar", ",", "testChar", ",", "i", 
         ",", "k", ",", "testNumber", ",", "expList", ",", "theExpNum", ",", 
         "ePos", ",", "theExpList", ",", "rationalR", ",", "dataPoints", ",", 
         "news5", ",", "baseF", ",", "tempB", ",", "tempZ", ",", "rTest", ",",
          "baseF2", ",", "theTestValue", ",", "pVal", ",", "newZ", ",", 
         "powerList", ",", "seriesW", ",", "actWChar", ",", "seriesWChar", 
         ",", "maxCharLen", ",", "maxCharFlag", ",", "charMin", ",", 
         "errorFlag", ",", "basePrec", ",", "zPrec", ",", "maxCharIndex", ",",
          "maxCharLen2", ",", "aDigits", ",", "decimalPosList", ",", 
         "correctCharLen"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"charMin", "=", "500"}], ";", "\[IndentingNewLine]", 
        RowBox[{"maxCharFlag", "=", "False"}], ";", "\[IndentingNewLine]", 
        RowBox[{"errorFlag", "=", "False"}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"singularPoint", "=", 
         RowBox[{"$theSingularList", "[", 
          RowBox[{"[", "centerIndex", "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"limitPoint", "=", 
         RowBox[{"$theSingularList", "[", 
          RowBox[{"[", "clsp", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"baseF", "[", "t_", "]"}], "=", 
         RowBox[{
          RowBox[{"baseSeries", "[", 
           RowBox[{"[", "seriesIndex", "]"}], "]"}], "/.", 
          RowBox[{"z", "->", "t"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"pVal", "=", 
         RowBox[{"Precision", "@", 
          RowBox[{"baseF", "[", "t", "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"newZ", "=", 
         RowBox[{"SetPrecision", "[", 
          RowBox[{"zValue", ",", "pVal"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"maxRadius", "=", 
         RowBox[{"Abs", "[", 
          RowBox[{"singularPoint", "-", "limitPoint"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"ePos", "=", 
         RowBox[{"Exponent", "[", 
          RowBox[{
           RowBox[{"baseSeries", "[", 
            RowBox[{"[", "seriesIndex", "]"}], "]"}], ",", "z", ",", "List"}],
           "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"wTest", "=", 
         RowBox[{"baseF", "[", "newZ", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"theWList", "=", 
         RowBox[{"w", "/.", 
          RowBox[{"NSolve", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"$theFunction", "==", "0"}], "/.", 
             RowBox[{"z", "->", 
              RowBox[{"(", 
               RowBox[{"singularPoint", "+", "newZ"}], ")"}]}]}], ",", "w", 
            ",", 
            RowBox[{"WorkingPrecision", "->", "wp"}]}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"theDif", "=", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{"wTest", "-", "#"}], "]"}], "&"}], "/@", " ", 
           "theWList"}], ")"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"pos", "=", 
         RowBox[{"Position", "[", 
          RowBox[{"theDif", ",", 
           RowBox[{"Min", "[", "theDif", "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"actW", "=", 
         RowBox[{"theWList", "[", 
          RowBox[{"[", 
           RowBox[{"pos", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "1"}], "]"}], "]"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"seriesW", "=", "wTest"}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"actWChar", "=", 
         RowBox[{"convertToChar", "[", 
          RowBox[{"SetPrecision", "[", 
           RowBox[{
            RowBox[{"type", "@", "actW"}], ",", "wp"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"seriesWChar", "=", 
         RowBox[{"convertToChar", "[", 
          RowBox[{"SetPrecision", "[", 
           RowBox[{
            RowBox[{"type", "@", "seriesW"}], ",", "wp"}], "]"}], "]"}]}], 
        ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Length", "@", "actWChar"}], "<", "charMin"}], "||", " ", 
           RowBox[{
            RowBox[{"Length", "@", "seriesWChar"}], "<", "charMin"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
           "Print", "[", 
            "\"\<actWChar or seriesWChar lenght less than char min: \>\"", 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<actW: \>\"", ",", 
             RowBox[{"N", "[", 
              RowBox[{"actW", ",", "20"}], "]"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<seriesW: \>\"", ",", 
             RowBox[{"N", "[", 
              RowBox[{"seriesW", ",", "20"}], "]"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<actWChar length: \>\"", ",", 
             RowBox[{"Length", "@", "actWChar"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<seriesWChar length: \>\"", ",", 
             RowBox[{"Length", "@", "seriesWChar"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"errorFlag", "=", "True"}], ";"}], "\[IndentingNewLine]", 
          ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"maxCharLen", "=", 
            RowBox[{"Min", "@", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Length", "@", "actWChar"}], ",", 
               RowBox[{"Length", "@", "seriesWChar"}]}], "}"}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"i", "=", "1"}], ";", "\[IndentingNewLine]", 
           RowBox[{"While", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"actWChar", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "==", 
               RowBox[{"seriesWChar", "[", 
                RowBox[{"[", "i", "]"}], "]"}]}], " ", "&&", " ", 
              RowBox[{"i", "<", "maxCharLen"}]}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"i", "++"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";",
            "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"i", "==", "maxCharLen"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Print", "[", 
               RowBox[{
                RowBox[{"Style", "[", 
                 RowBox[{"\"\<maxCharLen reached: \>\"", ",", "Red"}], "]"}], 
                ",", 
                RowBox[{"Style", "[", 
                 RowBox[{"maxCharLen", ",", "Red"}], "]"}]}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"Print", "[", 
               RowBox[{"\"\<       Length actWChar: \>\"", ",", 
                RowBox[{"Length", "@", "actWChar"}]}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"Print", "[", 
               RowBox[{"\"\<       Length seriesWChar: \>\"", ",", 
                RowBox[{"Length", "@", "seriesWChar"}]}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"maxCharFlag", "=", "True"}], ";"}]}], 
            "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{"For", "[", 
              RowBox[{
               RowBox[{"k", "=", "1"}], ",", 
               RowBox[{"k", "<=", 
                RowBox[{"i", "-", "1"}]}], ",", 
               RowBox[{"k", "++"}], ",", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{
                 RowBox[{"seriesWChar", "[", 
                  RowBox[{"[", "k", "]"}], "]"}], "=", 
                 RowBox[{"Style", "[", 
                  RowBox[{
                   RowBox[{"seriesWChar", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], ",", "Black", ",", 
                   "Bold"}], "]"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], 
             ";"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"For", "[", 
            RowBox[{
             RowBox[{"k", "=", "i"}], ",", 
             RowBox[{"k", "<=", "maxCharLen"}], ",", 
             RowBox[{"k", "++"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"seriesWChar", "[", 
                RowBox[{"[", "k", "]"}], "]"}], "=", 
               RowBox[{"Style", "[", 
                RowBox[{
                 RowBox[{"seriesWChar", "[", 
                  RowBox[{"[", "k", "]"}], "]"}], ",", "Red"}], "]"}]}], 
              ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"errTable", "=", 
            RowBox[{"Table", "[", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"baseF2", "[", "t_", "]"}], "=", 
                RowBox[{
                 RowBox[{"baseSeries", "[", 
                  RowBox[{"[", 
                   RowBox[{"seriesIndex", ",", 
                    RowBox[{"1", ";;", "index"}]}], "]"}], "]"}], "/.", 
                 RowBox[{"z", "->", "t"}]}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"theTestValue", "=", 
                RowBox[{"baseF2", "[", "newZ", "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"ePos", "[", 
                  RowBox[{"[", "index", "]"}], "]"}], ",", 
                 RowBox[{"SetPrecision", "[", 
                  RowBox[{
                   RowBox[{"type", "@", "theTestValue"}], ",", "wp"}], "]"}], 
                 ",", 
                 RowBox[{"Abs", "[", 
                  RowBox[{"actW", "-", "theTestValue"}], "]"}]}], "}"}]}], 
              ",", "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{"index", ",", "expInc", ",", 
                RowBox[{"Length", "@", "ePos"}], ",", "expInc"}], "}"}]}], 
             "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"correctNumber", "=", 
            RowBox[{"type", "@", 
             RowBox[{"SetPrecision", "[", " ", 
              RowBox[{"actW", ",", "wp"}], "]"}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"correctChar", "=", 
            RowBox[{"convertToChar", "[", "correctNumber", "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"correctCharLen", "=", 
            RowBox[{"Length", "@", "correctChar"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"cTable2", "=", 
            RowBox[{"Table", "[", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"maxCharIndex", "=", "0"}], ";", "\[IndentingNewLine]", 
               RowBox[{"testNumber", "=", 
                RowBox[{"errTable", "[", 
                 RowBox[{"[", 
                  RowBox[{"sIndex", ",", "2"}], "]"}], "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"testChar", "=", 
                RowBox[{"convertToChar", "[", "testNumber", "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"maxCharLen2", "=", 
                RowBox[{"Min", "@", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"Length", "@", "testChar"}], ",", "maxCharLen", 
                   ",", "correctCharLen"}], "}"}]}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"i", "=", "1"}], ";", "\[IndentingNewLine]", 
               RowBox[{"While", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"correctChar", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "==", 
                   RowBox[{"testChar", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], " ", "&&", " ", 
                  RowBox[{"i", "<", "maxCharLen2"}]}], ",", 
                 "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"i", "++"}], ";"}]}], "\[IndentingNewLine]", "]"}], 
               ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"i", "==", "maxCharLen"}], ",", 
                 "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"Print", "[", 
                   RowBox[{
                    RowBox[{"Style", "[", 
                    RowBox[{"\"\<maxCharLen reached: \>\"", ",", "Red"}], 
                    "]"}], ",", 
                    RowBox[{"Style", "[", 
                    RowBox[{"maxCharLen", ",", "Red"}], "]"}]}], "]"}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"maxCharFlag", "=", "True"}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"maxCharIndex", "=", "sIndex"}], ";"}]}], 
                "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
               RowBox[{"(*", "\[IndentingNewLine]", " ", 
                RowBox[{"now", " ", "find", " ", "decimal", " ", "point"}], 
                "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
               RowBox[{"decimalPosList", "=", 
                RowBox[{"Position", "[", 
                 RowBox[{"testChar", ",", 
                  RowBox[{"x_", "/;", 
                   RowBox[{"x", "==", "\"\<.\>\""}]}]}], "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Length", "@", "decimalPosList"}], "==", "0"}], ",",
                  "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"Print", "[", 
                   RowBox[{"Style", "[", 
                    RowBox[{
                    "\"\<error with decimal location\>\"", ",", "Red"}], 
                    "]"}], "]"}], ";", "\[IndentingNewLine]", 
                  RowBox[{"aDigits", "=", "0"}], ";", "\[IndentingNewLine]", 
                  RowBox[{"Abort", "[", "]"}], ";"}], "\[IndentingNewLine]", 
                 ",", "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"aDigits", "=", 
                   RowBox[{"i", "-", 
                    RowBox[{"decimalPosList", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "1"}], "]"}], "]"}], "-", "1"}]}], 
                  ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
               "\[IndentingNewLine]", "\[IndentingNewLine]", 
               RowBox[{"For", "[", 
                RowBox[{
                 RowBox[{"k", "=", "i"}], ",", 
                 RowBox[{"k", "<=", "maxCharLen2"}], ",", 
                 RowBox[{"k", "++"}], ",", "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"testChar", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], "=", 
                   RowBox[{"Style", "[", 
                    RowBox[{
                    RowBox[{"testChar", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], ",", "Red"}], "]"}]}], 
                  ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"sIndex", " ", "expInc"}], ",", 
                 RowBox[{"errTable", "[", 
                  RowBox[{"[", 
                   RowBox[{"sIndex", ",", "1"}], "]"}], "]"}], ",", "aDigits",
                  ",", 
                 RowBox[{"testChar", "[", 
                  RowBox[{"[", 
                   RowBox[{"1", ";;", "100"}], "]"}], "]"}], ",", 
                 "maxCharIndex", ",", "i"}], "}"}]}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{"sIndex", ",", "1", ",", 
                RowBox[{"Length", "@", "errTable"}]}], "}"}]}], 
             "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"PrependTo", "[", 
            RowBox[{"cTable2", ",", 
             RowBox[{"{", 
              RowBox[{
              "\"\<Series\>\"", ",", "0", ",", "0", ",", "seriesWChar"}], 
              "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"PrependTo", "[", 
            RowBox[{"cTable2", ",", 
             RowBox[{"{", 
              RowBox[{"\"\<Act\>\"", ",", "0", ",", "0", ",", "actWChar"}], 
