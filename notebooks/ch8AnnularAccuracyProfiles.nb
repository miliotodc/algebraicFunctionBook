       RowBox[{"theBranchSet", "=", 
        RowBox[{"Table", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"rStart", "=", "rNorm"}], ";", "\[IndentingNewLine]", 
