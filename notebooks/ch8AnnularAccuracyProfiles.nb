      RowBox[{
       RowBox[{
        RowBox[{"clist", "[", 
         RowBox[{"[", "n", "]"}], "]"}], " ", 
        RowBox[{"(", 
         RowBox[{"Exp", "[", 
          RowBox[{"2", " ", "k", " ", "\[Pi]", " ", "\[ImaginaryI]", " ", 
           RowBox[{"theexp", "[", 
            RowBox[{"[", "n", "]"}], "]"}]}], "]"}], ")"}], " ", 
        RowBox[{"z", "^", 
