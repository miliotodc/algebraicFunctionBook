          RowBox[{"theSeries", ",", "z", ",", "List"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"wTest", "=", 
         RowBox[{"baseF", "[", "newZ", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"theWList", "=", 
         RowBox[{"w", "/.", 
          RowBox[{"NSolve", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"$theFunction", "==", "0"}], "/.", 
             RowBox[{"z", "->", 
              RowBox[{"(", 
               RowBox[{"singularPoint", "+", "newZ"}], ")"}]}]}], ",", "w", 
            ",", 
            RowBox[{"WorkingPrecision", "->", "wp"}]}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"theDif", "=", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{"wTest", "-", "#"}], "]"}], "&"}], "/@", " ", 
           "theWList"}], ")"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"pos", "=", 
         RowBox[{"Position", "[", 
          RowBox[{"theDif", ",", 
           RowBox[{"Min", "[", "theDif", "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
