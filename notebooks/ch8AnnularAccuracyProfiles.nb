Cell[CellGroupData[{

Cell["getBranchPlot", "Subsection",
 CellChangeTimes->{{3.915875744431652*^9, 
  3.915875747602986*^9}},ExpressionUUID->"00c33549-2c2f-4e4c-b9e0-\
8a3ea792a396"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"getBranchPlot", "[", 
     RowBox[{
     "annulusTable_", ",", "thePlotType_", ",", "annularIndex_", ",", 
      "branchNum_", ",", "thetaV_", ",", 
      RowBox[{"radialSegments_", ":", "15"}], ",", 
      RowBox[{"arcSegments_", ":", "24"}], ",", 
      RowBox[{"totalIntegrationSteps_", ":", "2500000"}], ",", 
      RowBox[{"maxStepSize_", ":", 
       RowBox[{"1", "/", "1000"}]}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "newRadiiTable", ",", "rNorm", ",", "rMin", ",", "rMax", ",", "aIndex",
         ",", "sIndex", ",", "currentAnnuli", ",", "currentMonodromyList", 
        ",", "branchSize", ",", "rootIndex", ",", "tStart", ",", "tEnd", ",", 
        "zStart", ",", "zThetaF", ",", "theRoots", ",", "wStart", ",", 
        "wDeriv", ",", "mdeialTrace", ",", "arcSegmentList", ",", 
        "theBranchSet", ",", "rStart", ",", "rEnd", ",", "zRadiusF", ",", 
        "innerRadialTrace", ",", "innerRValues", ",", "outerRadialTrace", ",",
         "outerRValues", ",", "medialTrace"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "get", " ", "annulus", " ", "index", " ", "into", " ", 
        "annulusTable"}], " ", "*)"}], "\[IndentingNewLine]", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"aIndex", ",", "sIndex"}], "}"}], "=", 
        RowBox[{"getSingTableIndexes", "[", 
         RowBox[{"annulusTable", ",", "annularIndex"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"currentAnnuli", "=", 
        RowBox[{"annulusTable", "[", 
         RowBox[{"[", 
          RowBox[{"aIndex", ",", "3"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "adjust", " ", "annulus", " ", "bounds", " ", "for", " ", "plotting", 
         " ", "to", " ", "avoid", " ", "getting", " ", "too", " ", "close", 
         " ", "to", " ", "singular", " ", "points"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"newRadiiTable", "=", 
        RowBox[{"Array", "[", 
         RowBox[{
          RowBox[{"#", "&"}], ",", 
          RowBox[{"{", "radialSegments", "}"}], ",", "currentAnnuli"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"newRadiiTable", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "=", 
        RowBox[{
         RowBox[{"newRadiiTable", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"newRadiiTable", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "-", 
            RowBox[{"newRadiiTable", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "/", "10"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"newRadiiTable", "[", 
         RowBox[{"[", 
          RowBox[{"-", "1"}], "]"}], "]"}], "=", 
        RowBox[{
         RowBox[{"newRadiiTable", "[", 
          RowBox[{"[", 
           RowBox[{"-", "1"}], "]"}], "]"}], "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"newRadiiTable", "[", 
             RowBox[{"[", 
              RowBox[{"-", "2"}], "]"}], "]"}], "-", 
            RowBox[{"newRadiiTable", "[", 
             RowBox[{"[", 
              RowBox[{"-", "1"}], "]"}], "]"}]}], ")"}], "/", "10"}]}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"rNorm", "=", 
        RowBox[{"SetPrecision", "[", 
         RowBox[{
          RowBox[{"annulusTable", "[", 
           RowBox[{"[", 
            RowBox[{"aIndex", ",", "4"}], "]"}], "]"}], ",", 
          "workingPrecision"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"rNorm", "=", 
          RowBox[{"newRadiiTable", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"radialSegments", "-", "1"}], ")"}], "/", "2"}], "+", 
             "1"}], "]"}], "]"}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"rMin", ",", "rMax"}], "}"}], "=", 
        RowBox[{"newRadiiTable", "[", 
         RowBox[{"[", 
          RowBox[{"{", 
           RowBox[{"1", ",", 
            RowBox[{"-", "1"}]}], "}"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"currentMonodromyList", "=", 
        RowBox[{"annulusTable", "[", 
         RowBox[{"[", 
          RowBox[{"aIndex", ",", "6"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"branchSize", "=", 
        RowBox[{"Length", "@", 
         RowBox[{"currentMonodromyList", "[", 
          RowBox[{"[", "branchNum", "]"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "get", " ", "root", " ", "index", " ", "for", " ", "first", " ", 
         "sheet", " ", "in", " ", "monodromy", " ", "list"}], " ", "*)"}], 
       " ", "\[IndentingNewLine]", 
       RowBox[{"rootIndex", "=", 
        RowBox[{"currentMonodromyList", "[", 
         RowBox[{"[", 
          RowBox[{"branchNum", ",", "1"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "set", " ", "up", " ", "monodromy", " ", "DE", " ", "for", " ", 
         "medial", " ", "contour", " ", "integration"}], " ", "*)"}], " ", 
       "\[IndentingNewLine]", 
       RowBox[{"tStart", "=", "thetaV"}], ";", " ", 
       RowBox[{"(*", " ", 
        RowBox[{
        "begin", " ", "integration", " ", "at", " ", "branch", " ", 
         "reference", " ", "angle"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"tEnd", "=", 
        RowBox[{"thetaV", "+", 
         RowBox[{"2", "\[Pi]", " ", "branchSize"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"zStart", "=", 
        RowBox[{"rNorm", " ", 
         RowBox[{"Exp", "[", 
          RowBox[{"\[ImaginaryI]", " ", "tStart"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"zThetaF", "[", "t_", "]"}], ":=", 
        RowBox[{"rNorm", " ", 
         RowBox[{"Exp", "[", 
          RowBox[{"I", " ", "t"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"theRoots", "=", 
        RowBox[{"w", "/.", 
         RowBox[{"NSolve", "[", 
          RowBox[{
           RowBox[{"$theFunction", "\[Equal]", "0"}], "/.", 
           RowBox[{"z", "\[Rule]", "zStart"}]}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"wStart", "=", 
        RowBox[{"theRoots", "[", 
         RowBox[{"[", "rootIndex", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"wDeriv", ":=", 
        RowBox[{
         RowBox[{
          RowBox[{"w", "'"}], "[", "t", "]"}], "\[Equal]", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", 
              FractionBox[
               RowBox[{"D", "[", 
                RowBox[{"$theFunction", ",", "z"}], "]"}], 
               RowBox[{"D", "[", 
                RowBox[{"$theFunction", ",", "w"}], "]"}]]}], " ", 
             RowBox[{"D", "[", 
              RowBox[{
               RowBox[{"zThetaF", "[", "t", "]"}], ",", "t"}], "]"}]}], ")"}],
            "/.", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"w", "\[Rule]", 
              RowBox[{"w", "[", "t", "]"}]}], ",", 
             RowBox[{"z", "\[Rule]", 
              RowBox[{"zThetaF", "[", "t", "]"}]}]}], "}"}]}], ")"}]}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"medialTrace", "=", 
        RowBox[{"NDSolveValue", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"wDeriv", ",", 
            RowBox[{
             RowBox[{"w", "[", "tStart", "]"}], "\[Equal]", "wStart"}]}], 
           "}"}], ",", "w", ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "tStart", ",", "tEnd"}], "}"}], ",", 
          RowBox[{"MaxSteps", "\[Rule]", "totalIntegrationSteps"}], ",", 
          RowBox[{"MaxStepSize", "\[Rule]", "maxStepSize"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "construct", " ", "point", " ", "along", " ", "medial", " ", 
         "contour", " ", "for", " ", "radial", " ", "integrations"}], " ", 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"arcSegmentList", "=", 
        RowBox[{"Array", "[", 
         RowBox[{
          RowBox[{"#", "&"}], ",", 
          RowBox[{"(", 
           RowBox[{"arcSegments", " ", "branchSize"}], ")"}], ",", 
          RowBox[{"{", 
           RowBox[{"tStart", ",", "tEnd"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Clear", "[", "r", "]"}], ";"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"do", " ", "radial", " ", "integrations"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"theBranchSet", "=", 
        RowBox[{"Table", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"rStart", "=", "rNorm"}], ";", "\[IndentingNewLine]", 
           RowBox[{"rEnd", "=", "rMin"}], ";", "\[IndentingNewLine]", 
           RowBox[{"tStart", "=", "segmentNum"}], ";", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"zRadiusF", "[", "r_", "]"}], ":=", 
            RowBox[{"r", " ", 
             RowBox[{"Exp", "[", 
              RowBox[{"I", " ", "tStart"}], "]"}]}]}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"wStart", "=", 
            RowBox[{"medialTrace", "[", "tStart", "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"wDeriv", "=", 
            RowBox[{
             RowBox[{
              RowBox[{"w", "'"}], "[", "r", "]"}], "\[Equal]", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"-", 
                  FractionBox[
                   RowBox[{"D", "[", 
                    RowBox[{"$theFunction", ",", "z"}], "]"}], 
                   RowBox[{"D", "[", 
                    RowBox[{"$theFunction", ",", "w"}], "]"}]]}], 
                 RowBox[{"D", "[", 
                  RowBox[{
                   RowBox[{"zRadiusF", "[", "r", "]"}], ",", "r"}], "]"}]}], 
                ")"}], "/.", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"w", "\[Rule]", 
                  RowBox[{"w", "[", "r", "]"}]}], ",", 
                 RowBox[{"z", "\[Rule]", 
                  RowBox[{"zRadiusF", "[", "r", "]"}]}]}], "}"}]}], ")"}]}]}],
            ";", "\[IndentingNewLine]", 
           RowBox[{"innerRadialTrace", "=", 
            RowBox[{"NDSolveValue", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"wDeriv", ",", 
                RowBox[{
                 RowBox[{"w", "[", "rStart", "]"}], "\[Equal]", "wStart"}]}], 
               "}"}], ",", "w", ",", 
              RowBox[{"{", 
               RowBox[{"r", ",", "rStart", ",", "rEnd"}], "}"}], ",", 
              RowBox[{"MaxSteps", "\[Rule]", "totalIntegrationSteps"}], ",", 
              RowBox[{"MaxStepSize", "\[Rule]", "maxStepSize"}]}], "]"}]}], 
           ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{
            "generate", " ", "points", " ", "along", " ", "blue", " ", 
             "radial", " ", "contour", " ", "total", " ", "of", " ", 
             RowBox[{"1", "/", "2"}], " ", "of", " ", "annularSegments"}], 
            " ", "*)"}], "\[IndentingNewLine]", 
           RowBox[{"innerRValues", "=", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Re", "[", "z", "]"}], ",", 
                 RowBox[{"Im", "[", "z", "]"}], ",", 
                 RowBox[{"thePlotType", "[", 
                  RowBox[{"innerRadialTrace", "[", "r", "]"}], "]"}]}], "}"}],
                "/.", 
               RowBox[{"z", "\[Rule]", 
                RowBox[{"r", " ", 
                 RowBox[{"Exp", "[", 
                  RowBox[{"\[ImaginaryI]", " ", "tStart"}], "]"}]}]}]}], ",", 
              RowBox[{"{", 
               RowBox[{"r", ",", 
                RowBox[{"newRadiiTable", "[", 
                 RowBox[{"[", 
                  RowBox[{"1", ";;", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"radialSegments", "-", "1"}], ")"}], "/", "2"}], 
                    "+", "1"}]}], "]"}], "]"}]}], "}"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"rStart", "=", "rNorm"}], ";", "\[IndentingNewLine]", 
           RowBox[{"rEnd", "=", "rMax"}], ";", "\[IndentingNewLine]", 
           RowBox[{"(*", " ", "*)"}], "\[IndentingNewLine]", 
           RowBox[{"wStart", "=", 
            RowBox[{"medialTrace", "[", "tStart", "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"wDeriv", "=", 
            RowBox[{
             RowBox[{
              RowBox[{"w", "'"}], "[", "r", "]"}], "\[Equal]", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"-", 
                  FractionBox[
                   RowBox[{"D", "[", 
                    RowBox[{"$theFunction", ",", "z"}], "]"}], 
                   RowBox[{"D", "[", 
                    RowBox[{"$theFunction", ",", "w"}], "]"}]]}], 
                 RowBox[{"D", "[", 
                  RowBox[{
                   RowBox[{"zRadiusF", "[", "r", "]"}], ",", "r"}], "]"}]}], 
                ")"}], "/.", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"w", "\[Rule]", 
                  RowBox[{"w", "[", "r", "]"}]}], ",", 
                 RowBox[{"z", "\[Rule]", 
                  RowBox[{"zRadiusF", "[", "r", "]"}]}]}], "}"}]}], ")"}]}]}],
            ";", "\[IndentingNewLine]", " ", 
           RowBox[{"outerRadialTrace", "=", 
            RowBox[{"NDSolveValue", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"wDeriv", ",", 
                RowBox[{
                 RowBox[{"w", "[", "rStart", "]"}], "\[Equal]", "wStart"}]}], 
               "}"}], ",", "w", ",", 
              RowBox[{"{", 
               RowBox[{"r", ",", "rStart", ",", "rEnd"}], "}"}], ",", 
              RowBox[{"MaxSteps", "\[Rule]", "totalIntegrationSteps"}], ",", 
              RowBox[{"MaxStepSize", "\[Rule]", "maxStepSize"}]}], "]"}]}], 
           ";", " ", "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{
            "generate", " ", "point", " ", "along", " ", "green", " ", 
             "radial", " ", "contour", " ", "total", " ", "of", " ", 
             RowBox[{"1", "/", "2"}], " ", "of", " ", "annularSegments"}], 
            " ", "*)"}], "\[IndentingNewLine]", 
           RowBox[{"outerRValues", "=", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Re", "[", "z", "]"}], ",", 
                 RowBox[{"Im", "[", "z", "]"}], ",", 
                 RowBox[{"thePlotType", "[", 
                  RowBox[{"outerRadialTrace", "[", "r", "]"}], "]"}]}], "}"}],
                "/.", 
               RowBox[{"z", "\[Rule]", 
                RowBox[{"r", " ", 
                 RowBox[{"Exp", "[", 
                  RowBox[{"\[ImaginaryI]", " ", "tStart"}], "]"}]}]}]}], ",", 
              RowBox[{"{", 
               RowBox[{"r", ",", 
                RowBox[{"newRadiiTable", "[", 
                 RowBox[{"[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"radialSegments", "-", "1"}], ")"}], "/", "2"}], 
                    "+", "2"}], ";;", "radialSegments"}], "]"}], "]"}]}], 
               "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"Join", "[", 
            RowBox[{"innerRValues", ",", "outerRValues"}], "]"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"segmentNum", ",", "arcSegmentList"}], "}"}]}], 
         "]"}]}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.916141408131365*^9, 3.9161414506054335`*^9}, {
  3.9591490897954364`*^9, 3.959149089827007*^9}},
 CellLabel->"In[99]:=",ExpressionUUID->"38696945-7212-4617-85c2-fb86d89a0187"]
}, Closed]],

