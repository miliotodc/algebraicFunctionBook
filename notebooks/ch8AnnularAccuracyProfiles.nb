Cell[CellGroupData[{

Cell["getSingleConvergenceTrendTempSave", "Subsection",
 CellChangeTimes->{{3.920724892079209*^9, 
  3.9207248990934095`*^9}},ExpressionUUID->"5cebe637-34bb-48bb-9108-\
792f418eba03"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"getSingleConvergenceTrendTempSave", "[", 
      RowBox[{
      "seriesIndex_", ",", "centerIndex_", ",", "clsp_", ",", "wp_", ",", 
       "zValue_", ",", "expInc_", ",", "type_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "cTable", ",", "cTable2", ",", "zVal", ",", "wTest", ",", "theWList", 
         ",", "theDif", ",", "pos", ",", "theIndex", ",", "s5", ",", "actW", 
         ",", "singularPoint", ",", "convData", ",", "branchStats", ",", 
         "typeIndex", ",", "limitPoint", ",", "maxRadius", ",", "errTable", 
         ",", "correctNumber", ",", "correctChar", ",", "testChar", ",", "i", 
         ",", "k", ",", "testNumber", ",", "expList", ",", "theExpNum", ",", 
         "ePos", ",", "theExpList", ",", "rationalR", ",", "dataPoints", ",", 
         "news5", ",", "baseF", ",", "tempB", ",", "tempZ", ",", "rTest", ",",
          "baseF2", ",", "theTestValue", ",", "pVal", ",", "newZ", ",", 
         "powerList", ",", "seriesW", ",", "actWChar", ",", "seriesWChar", 
         ",", "maxCharLen", ",", "maxCharFlag", ",", "charMin", ",", 
         "errorFlag", ",", "basePrec", ",", "zPrec", ",", "maxCharIndex"}], 
        "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"charMin", "=", "500"}], ";", "\[IndentingNewLine]", 
        RowBox[{"maxCharFlag", "=", "False"}], ";", "\[IndentingNewLine]", 
        RowBox[{"errorFlag", "=", "False"}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"singularPoint", "=", 
         RowBox[{"$theSingularList", "[", 
          RowBox[{"[", "centerIndex", "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"limitPoint", "=", 
         RowBox[{"$theSingularList", "[", 
          RowBox[{"[", "clsp", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"baseF", "[", "t_", "]"}], "=", 
         RowBox[{
          RowBox[{"baseSeries", "[", 
           RowBox[{"[", "seriesIndex", "]"}], "]"}], "/.", 
          RowBox[{"z", "->", "t"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"pVal", "=", 
         RowBox[{"Precision", "@", 
          RowBox[{"baseF", "[", "t", "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"newZ", "=", 
         RowBox[{"SetPrecision", "[", 
          RowBox[{"zValue", ",", "pVal"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"maxRadius", "=", 
         RowBox[{"Abs", "[", 
          RowBox[{"singularPoint", "-", "limitPoint"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"ePos", "=", 
         RowBox[{"Exponent", "[", 
          RowBox[{
           RowBox[{"baseSeries", "[", 
            RowBox[{"[", "seriesIndex", "]"}], "]"}], ",", "z", ",", "List"}],
           "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"wTest", "=", 
         RowBox[{"baseF", "[", "newZ", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"theWList", "=", 
         RowBox[{"w", "/.", 
          RowBox[{"NSolve", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"$theFunction", "==", "0"}], "/.", 
             RowBox[{"z", "->", 
              RowBox[{"(", 
               RowBox[{"singularPoint", "+", "newZ"}], ")"}]}]}], ",", "w", 
            ",", 
            RowBox[{"WorkingPrecision", "->", "wp"}]}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"theDif", "=", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{"wTest", "-", "#"}], "]"}], "&"}], "/@", " ", 
           "theWList"}], ")"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"pos", "=", 
         RowBox[{"Position", "[", 
          RowBox[{"theDif", ",", 
           RowBox[{"Min", "[", "theDif", "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"actW", "=", 
         RowBox[{"theWList", "[", 
          RowBox[{"[", 
           RowBox[{"pos", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "1"}], "]"}], "]"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"seriesW", "=", "wTest"}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"actWChar", "=", 
         RowBox[{"convertToChar", "[", 
          RowBox[{"SetPrecision", "[", 
           RowBox[{
            RowBox[{"type", "@", "actW"}], ",", "wp"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"seriesWChar", "=", 
         RowBox[{"convertToChar", "[", 
          RowBox[{"SetPrecision", "[", 
           RowBox[{
            RowBox[{"type", "@", "seriesW"}], ",", "wp"}], "]"}], "]"}]}], 
        ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Length", "@", "actWChar"}], "<", "charMin"}], "||", " ", 
           RowBox[{
            RowBox[{"Length", "@", "seriesWChar"}], "<", "charMin"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
           "Print", "[", 
            "\"\<actWChar or seriesWChar lenght less than char min: \>\"", 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<actW: \>\"", ",", 
             RowBox[{"N", "[", 
              RowBox[{"actW", ",", "20"}], "]"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<seriesW: \>\"", ",", 
