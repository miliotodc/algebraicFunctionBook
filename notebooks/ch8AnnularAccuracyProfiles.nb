        "dataVals"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"quadraticResidue", "=", 
     RowBox[{"Plus", "@@", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "-", "quadraticLine"}], "/.", 
           RowBox[{"x", "->", 
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}]}], "]"}], "&"}], "/@", " ", 
        "dataVals"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
