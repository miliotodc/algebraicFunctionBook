Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{"Compile", " ", "data"}], "\[IndentingNewLine]", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"analyticSet", "=", "analyticTerms"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"singularSet", "=", "singularTerms"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"mTable3", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"theRadius", "=", 
         RowBox[{"Rationalize", "[", 
          RowBox[{
           RowBox[{"radiusStart", "+", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"radiusRatios", "[", 
               RowBox[{"[", "theN", "]"}], "]"}], "radiusDif"}], ")"}]}], ",",
            "0"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"theTheta", "=", 
         RowBox[{"SetPrecision", "[", 
          RowBox[{
           RowBox[{"Pi", "/", "2"}], ",", "1000"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"zVal", "=", 
         RowBox[{"theRadius", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"I", " ", "theTheta"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"analTerm", "=", 
         RowBox[{
          RowBox[{"analyticSet", "[", 
           RowBox[{"[", 
            RowBox[{"(", 
             RowBox[{"analyticOrderList", "[", 
              RowBox[{"[", 
               RowBox[{"orderIndex", ",", "2"}], "]"}], "]"}], ")"}], "]"}], 
           "]"}], "/.", 
          RowBox[{"z", "->", "zVal"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"singTerm", "=", 
         RowBox[{
          RowBox[{"singularSet", "[", 
           RowBox[{"[", 
            RowBox[{"(", 
