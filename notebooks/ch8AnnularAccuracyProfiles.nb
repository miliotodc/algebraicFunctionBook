        "\[IndentingNewLine]", 
        RowBox[{"seriesWChar", "=", 
         RowBox[{"convertToChar", "[", 
          RowBox[{"SetPrecision", "[", 
           RowBox[{
            RowBox[{"type", "@", "seriesW"}], ",", "wp"}], "]"}], "]"}]}], 
        ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Length", "@", "actWChar"}], "<", "charMin"}], "||", " ", 
           RowBox[{
            RowBox[{"Length", "@", "seriesWChar"}], "<", "charMin"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
           "Print", "[", 
            "\"\<actWChar or seriesWChar lenght less than char min: \>\"", 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<actW: \>\"", ",", 
             RowBox[{"N", "[", 
              RowBox[{"actW", ",", "20"}], "]"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<seriesW: \>\"", ",", 
             RowBox[{"N", "[", 
              RowBox[{"seriesW", ",", "20"}], "]"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<actWChar length: \>\"", ",", 
             RowBox[{"Length", "@", "actWChar"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
