        RowBox[{
         RowBox[{"baseF", "[", "t_", "]"}], "=", 
         RowBox[{"theSeries", "/.", 
          RowBox[{"z", "->", "t"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"pVal", "=", 
         RowBox[{"Precision", "@", 
          RowBox[{"baseF", "[", "t", "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"newZ", "=", 
         RowBox[{"SetPrecision", "[", 
          RowBox[{"zValue", ",", "pVal"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"maxRadius", "=", 
         RowBox[{"Abs", "[", 
          RowBox[{"singularPoint", "-", "limitPoint"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"ePos", "=", 
