Cell[CellGroupData[{

Cell["Fit order data to an upper minimize function", "Subsubsection",
 CellChangeTimes->{{3.9404150100038896`*^9, 
  3.9404150399652147`*^9}},ExpressionUUID->"fb589d79-3d08-4eea-a224-\
0c9c4bd9bafe"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"(*", " ", "\[IndentingNewLine]", "   ", 
   RowBox[{
   "Fit", " ", "data", " ", "to", " ", "upper", " ", "minimize", " ", 
    "function"}], "\[IndentingNewLine]", " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"cTable", "=", 
     RowBox[{
      RowBox[{"theOrderErrorTable", "[", 
       RowBox[{"[", 
        RowBox[{
         RowBox[{"5", ";;"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "3"}], "}"}]}], "]"}], "]"}], "//", "N"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"startTerms", "=", "10"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dataVals", "=", "cTable"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"plotXStart", "=", 
     RowBox[{"cTable", "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"plotXEnd", "=", 
     RowBox[{"cTable", "[", 
      RowBox[{"[", 
       RowBox[{
        RowBox[{"-", "1"}], ",", "1"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"endTerms", "=", 
     RowBox[{"Length", "@", "cTable"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"diagFlag", "=", "False"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"linearLine", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"c0", "+", 
        RowBox[{"c1", " ", "x"}]}], "/.", " ", 
       RowBox[{
        RowBox[{"Minimize", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Total", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"Abs", "[", 
                 RowBox[{
                  RowBox[{"#", "[", 
                   RowBox[{"[", "2", "]"}], "]"}], "-", 
                  RowBox[{"(", 
                   RowBox[{"c0", "+", 
                    RowBox[{"c1", " ", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}]}], ")"}]}], "]"}], ")"}],
                "&"}], "/@", "dataVals"}], "]"}], ",", 
            RowBox[{"And", "@@", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"c0", "+", 
                    RowBox[{"c1", " ", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}]}], ")"}], ">=", 
                  RowBox[{"#", "[", 
                   RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "&"}], "/@", " ", 
               "dataVals"}], ")"}]}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"c0", ",", "c1"}], "}"}]}], "]"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], "//", "N"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"quadraticLine", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"c0", "+", 
        RowBox[{"c1", " ", "x"}], "+", 
        RowBox[{"c2", " ", 
         RowBox[{"x", "^", "2"}]}]}], "/.", " ", 
       RowBox[{
        RowBox[{"Minimize", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Total", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"Abs", "[", 
                 RowBox[{
                  RowBox[{"#", "[", 
                   RowBox[{"[", "2", "]"}], "]"}], "-", 
                  RowBox[{"(", 
                   RowBox[{"c0", "+", 
                    RowBox[{"c1", " ", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "+", 
                    RowBox[{"c2", " ", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "^", "2"}]}]}], ")"}]}], 
                 "]"}], ")"}], "&"}], "/@", " ", "dataVals"}], "]"}], ",", 
            RowBox[{"And", "@@", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"c0", "+", 
                    RowBox[{"c1", " ", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "+", 
                    RowBox[{"c2", " ", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "^", "2"}]}]}], ")"}], ">=", 
                  RowBox[{"#", "[", 
                   RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "&"}], "/@", " ", 
               "dataVals"}], ")"}]}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"c0", ",", "c1", ",", "c2"}], "}"}]}], "]"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], "//", "N"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cubicLine", "=", 
     RowBox[{
      RowBox[{"c0", "+", 
       RowBox[{"c1", " ", "x"}], "+", 
       RowBox[{"c2", " ", 
        RowBox[{"x", "^", "2"}]}], "+", 
       RowBox[{"c3", " ", 
        RowBox[{"x", "^", "3"}]}]}], "/.", " ", 
      RowBox[{
       RowBox[{"NMinimize", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Total", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"Abs", "[", 
                RowBox[{
                 RowBox[{"#", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], "-", 
                 RowBox[{"(", 
                  RowBox[{"c0", "+", 
                   RowBox[{"c1", " ", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "+", 
                   RowBox[{"c2", " ", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "^", "2"}]}], "+", 
                   RowBox[{"c3", " ", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "^", "3"}]}]}], ")"}]}], 
                "]"}], ")"}], "&"}], "/@", " ", "dataVals"}], "]"}], ",", 
           RowBox[{"And", "@@", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"c0", "+", 
                   RowBox[{"c1", " ", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "+", 
                   RowBox[{"c2", " ", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "^", "2"}]}], "+", 
                   RowBox[{"c3", " ", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "^", "3"}]}]}], ")"}], ">=", 
                 RowBox[{"#", "[", 
                  RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "&"}], "/@", " ", 
              "dataVals"}], ")"}]}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"c0", ",", "c1", ",", "c2", ",", "c3"}], "}"}]}], "]"}], 
       "[", 
       RowBox[{"[", "2", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"linearResidue", "=", 
    RowBox[{"Plus", "@@", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "-", "linearLine"}], "/.", 
          RowBox[{"x", "->", 
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}]}], "]"}], "&"}], "/@", " ", 
       "dataVals"}], ")"}]}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cubicResidue", "=", 
     RowBox[{"Plus", "@@", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "-", "cubicLine"}], "/.", 
           RowBox[{"x", "->", 
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}]}], "]"}], "&"}], "/@", " ", 
        "dataVals"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"quadraticResidue", "=", 
     RowBox[{"Plus", "@@", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "-", "quadraticLine"}], "/.", 
           RowBox[{"x", "->", 
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}]}], "]"}], "&"}], "/@", " ", 
        "dataVals"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"residueSet", "=", 
     RowBox[{"{", 
      RowBox[{"linearResidue", ",", "quadraticResidue", ",", "cubicResidue"}],
       "}"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"functionList", "=", 
     RowBox[{"{", 
      RowBox[{"linearLine", ",", "quadraticLine", ",", "cubicLine"}], "}"}]}],
     ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"bestFitPos", "=", 
     RowBox[{
      RowBox[{"Position", "[", 
       RowBox[{"residueSet", ",", 
        RowBox[{"Min", "[", "residueSet", "]"}]}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{"diagFlag", ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"\"\<residueSet: \>\"", ",", 
         RowBox[{"residueSet", "//", "N"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Best fit function: \>\"", ",", 
         RowBox[{
          RowBox[{"functionList", "[", 
           RowBox[{"[", "bestFitPos", "]"}], "]"}], "//", "N"}]}], "]"}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Minimum Residue: \>\"", ",", 
         RowBox[{
          RowBox[{"residueSet", "[", 
           RowBox[{"[", "bestFitPos", "]"}], "]"}], "//", "N"}]}], "]"}], 
       ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"bestUpperFitPlot", "=", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"functionList", "[", 
        RowBox[{"[", "bestFitPos", "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "20", ",", "theMaxOrder"}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Thickness", "[", "0.0025", "]"}], ",", "Red"}], "}"}]}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Show", "[", 
    RowBox[{"{", 
     RowBox[{"orderPointsPlot", ",", "bestUpperFitPlot"}], "}"}], 
    "]"}]}]}]], "Input",
