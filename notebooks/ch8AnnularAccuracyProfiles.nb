Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"ratioIndex", "=", "50"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"selectedOrder", "=", "60"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"theRadius", "=", 
     RowBox[{"radiusStart", "+", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"radiusRatios", "[", 
         RowBox[{"[", "ratioIndex", "]"}], "]"}], " ", "radiusDif"}], 
       ")"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"theTheta", "=", 
     RowBox[{"SetPrecision", "[", 
      RowBox[{
       RowBox[{"1", "/", "100"}], ",", "1000"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"zVal", "=", 
     RowBox[{"theRadius", " ", 
      RowBox[{"Exp", "[", 
       RowBox[{"I", " ", "theTheta"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<zVal: \>\"", ",", 
      RowBox[{"zVal", "//", "N"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<theRadius: \>\"", ",", 
      RowBox[{"theRadius", "//", "N"}]}], "]"}], ";"}], "\[IndentingNewLine]",
    "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"pVal", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"Plus", "@@", 
          RowBox[{"reducedAnalyticTerms", "[", 
           RowBox[{"[", 
            RowBox[{"1", ";;", 
             RowBox[{"analyticOrderIndexList", "[", 
              RowBox[{"[", 
               RowBox[{"selectedOrder", ",", "2"}], "]"}], "]"}]}], "]"}], 
           "]"}]}], ")"}], "+", 
        RowBox[{"(", 
         RowBox[{"Plus", "@@", 
          RowBox[{"theReformedSingularTerms", "[", 
           RowBox[{"[", 
            RowBox[{"1", ";;", 
             RowBox[{"singularOrderIndexList", "[", 
              RowBox[{"[", 
               RowBox[{"selectedOrder", ",", "2"}], "]"}], "]"}]}], "]"}], 
           "]"}]}], ")"}]}], "/.", 
       RowBox[{"z", "->", "zVal"}]}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pVal1", "=", 
     RowBox[{
      RowBox[{"seriesTable", "[", 
       RowBox[{"[", "selectedOrder", "]"}], "]"}], "/.", 
      RowBox[{"z", "->", "zVal"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"pVal2", "=", 
      RowBox[{"seriesTable2", "/.", 
       RowBox[{"z", "->", "zVal"}]}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"pVal", "=", 
      RowBox[{
       RowBox[{"pureAnalyticSeries", "[", "zVal", "]"}], "+", 
       RowBox[{"pureSingularSeries", "[", "zVal", "]"}]}]}], ";"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wVals", "=", 
     RowBox[{"w", "/.", 
      RowBox[{"NSolve", "[", 
       RowBox[{
        RowBox[{"$theFunction", "==", "0"}], "/.", 
        RowBox[{"z", "->", "zVal"}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"errTable", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"#", "-", "pVal1"}], "]"}], "&"}], "/@", " ", "wVals"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<errTable: \>\"", ",", 
      RowBox[{"errTable", "//", "N"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pos", "=", 
     RowBox[{
      RowBox[{"Position", "[", 
       RowBox[{"errTable", ",", 
        RowBox[{"Min", "[", "errTable", "]"}]}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"actualError", "=", 
     RowBox[{"errTable", "[", 
      RowBox[{"[", "pos", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{
      RowBox[{"Style", "[", 
       RowBox[{"\"\<Actual accuracy: \>\"", ",", "Blue"}], "]"}], ",", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"Log", "[", 
         RowBox[{"10", ",", "actualError"}], "]"}]}], "//", "N"}]}], "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"estError", "=", 
     RowBox[{"intFA", "[", 
      RowBox[{"theRadius", ",", "selectedOrder"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{
      RowBox[{"Style", "[", 
       RowBox[{"\"\<Estimated error: \>\"", ",", "Red"}], "]"}], ",", 
      RowBox[{"estError", "//", "N"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"actErrorG", "=", 
     RowBox[{"Graphics3D", "@", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"PointSize", "[", "0.025", "]"}], ",", "Blue", ",", 
        RowBox[{"Point", "@", 
         RowBox[{"{", 
          RowBox[{"theRadius", ",", "selectedOrder", ",", 
           RowBox[{"-", 
            RowBox[{"Log", "[", 
             RowBox[{"10", ",", "actualError"}], "]"}]}]}], "}"}]}]}], 
       "}"}]}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"digitsOfAccuracy", "=", 
     RowBox[{
      RowBox[{"MantissaExponent", "[", "actualError", "]"}], "[", 
      RowBox[{"[", "2", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"estErrorG", "=", 
     RowBox[{"Graphics3D", "@", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"PointSize", "[", "0.025", "]"}], ",", "Red", ",", 
        RowBox[{"Point", "@", 
         RowBox[{"{", 
          RowBox[{"theRadius", ",", "selectedOrder", ",", "estError"}], 
          "}"}]}]}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Results: \>\"", "]"}], ";"}], 
   "\[IndentingNewLine]", 
