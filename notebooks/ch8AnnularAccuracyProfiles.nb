Cell[CellGroupData[{

Cell["strictPolynomialQ", "Subsection",
 CellChangeTimes->{{3.8893602934364414`*^9, 
  3.8893602965138407`*^9}},ExpressionUUID->"08ea1230-b8a1-477b-8f25-\
2b5c1f560fa6"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"strictPolynomialQ", "[", 
     RowBox[{"myPoly_", ",", 
      RowBox[{"{", 
       RowBox[{"x_", ",", "y_"}], "}"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"levels", ",", "cList", ",", "finalList", ",", "return"}], 
       "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"PolynomialQ", "[", 
          RowBox[{"myPoly", ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", "y"}], "}"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"levels", "=", 
           RowBox[{"Level", "[", 
            RowBox[{"myPoly", ",", 
             RowBox[{"{", 
              RowBox[{"-", "1"}], "}"}], ",", 
             RowBox[{"Heads", "->", "True"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Length", "@", 
               RowBox[{"Position", "[", 
                RowBox[{"levels", ",", "x"}], "]"}]}], ">", "0"}], " ", "&&", 
             " ", 
             RowBox[{
              RowBox[{"Length", "@", 
               RowBox[{"Position", "[", 
                RowBox[{"levels", ",", "y"}], "]"}]}], ">", "0"}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"cList", "=", 
              RowBox[{"Complement", "[", 
               RowBox[{"levels", ",", 
                RowBox[{"{", 
                 RowBox[{
                 "Plus", ",", "Power", ",", "Times", ",", "x", ",", "y"}], 
                 "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"finalList", "=", 
              RowBox[{"Complement", "[", 
               RowBox[{"cList", ",", 
                RowBox[{"Select", "[", 
                 RowBox[{"cList", ",", "NumberQ"}], "]"}]}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Length", "@", "finalList"}], ">", "0"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"Print", "[", 
                 RowBox[{
                  RowBox[{"Style", "[", 
                   RowBox[{
                   "\"\<expression is not strict polynomial in \>\"", ",", 
                    "Red"}], "]"}], ",", 
                  RowBox[{"Style", "[", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"x", ",", "y"}], "}"}], ",", "Red"}], "]"}]}], 
                 "]"}], ";", "\[IndentingNewLine]", 
                RowBox[{"return", "=", "False"}], ";"}], 
               "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"return", "=", "True"}], ";"}]}], 
              "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", ",",
             "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{
               RowBox[{"Style", "[", 
                RowBox[{
                "\"\<expression is not strict polynomial in \>\"", ",", 
                 "Red"}], "]"}], ",", 
               RowBox[{"Style", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"x", ",", "y"}], "}"}], ",", "Red"}], "]"}]}], 
              "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"return", "=", "False"}], ";"}]}], "\[IndentingNewLine]",
            "]"}], ";"}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"return", "=", "False"}], ";"}]}], "\[IndentingNewLine]", 
        "]"}], ";", "\[IndentingNewLine]", "return"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.8893602992317033`*^9, 3.8893603006690025`*^9}, {
  3.8893630345963316`*^9, 3.8893630418912425`*^9}, {3.894371500481982*^9, 
  3.8943715009192405`*^9}, {3.8970419131913157`*^9, 3.897041953096331*^9}},
 CellLabel->"In[95]:=",ExpressionUUID->"ff3893f6-51ff-4fb2-8f46-ea56193e6722"]
}, Closed]],

Cell[CellGroupData[{

Cell["getSingTableIndexes", "Subsection",
 CellChangeTimes->{{3.9147456537242537`*^9, 
  3.914745664221779*^9}},ExpressionUUID->"4c0552a1-cca9-4fdd-ab55-\
00c0a1d7aeed"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"getSingTableIndexes", "[", 
    RowBox[{"singTable_", ",", "annulus_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "singMembers", ",", "singIndexes", ",", "annulusIndex", ",", "return"}],
       "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"annulus", ">", 
          RowBox[{"Length", "@", "theAnnuli"}]}], " ", "||", " ", 
         RowBox[{"annulus", "<", "0"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"Style", "[", 
           RowBox[{"\"\<Annulus number out of range!\>\"", ",", "Red"}], 
           "]"}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"return", "=", 
          RowBox[{"-", "1"}]}], ";"}], "\[IndentingNewLine]", ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"annulusIndex", "=", 
          RowBox[{"singTableAnnulusIndexes", "[", 
           RowBox[{"[", "annulus", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"annulus", "==", 
            RowBox[{"Length", "@", "theAnnuli"}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"singIndexes", "=", 
             RowBox[{"{", 
              RowBox[{"-", "1"}], "}"}]}], ";"}], "\[IndentingNewLine]", ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"singMembers", "=", 
             RowBox[{"ringMemberSingularIndexes", "[", 
              RowBox[{"[", "annulus", "]"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"singIndexes", "=", 
             RowBox[{"singTableSingIndexes", "[", 
              RowBox[{"[", "singMembers", "]"}], "]"}]}], ";"}]}], 
          "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"return", "=", 
          RowBox[{"{", 
           RowBox[{"annulusIndex", ",", "singIndexes"}], "}"}]}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", "return"}]}],
     "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]"}]], "Input",
 CellLabel->"In[96]:=",ExpressionUUID->"475d319c-3c8b-4599-b2ab-cd6b416212c8"]
}, Closed]],

Cell[CellGroupData[{

Cell["getPartialBranchPlot", "Subsection",
 CellChangeTimes->{{3.918043518812316*^9, 
  3.918043522170928*^9}},ExpressionUUID->"fed11a78-50da-4923-945a-\
c1e4fafb0809"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"getPartialBranchPlot", "[", 
      RowBox[{
      "annulusTable_", ",", "thePlotType_", ",", "annularIndex_", ",", 
       "branchNum_", ",", "thetaV_", ",", 
       RowBox[{"radialSegments_", ":", "15"}], ",", 
       RowBox[{"arcSegments_", ":", "24"}], ",", 
       RowBox[{"totalIntegrationSteps_", ":", "2500000"}], ",", 
       RowBox[{"maxStepSize_", ":", 
        RowBox[{"1", "/", "1000"}]}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "newRadiiTable", ",", "rNorm", ",", "rMin", ",", "rMax", ",", 
         "aIndex", ",", "sIndex", ",", "currentAnnuli", ",", 
         "currentMonodromyList", ",", "branchSize", ",", "rootIndex", ",", 
         "tStart", ",", "tEnd", ",", "zStart", ",", "zThetaF", ",", 
         "theRoots", ",", "wStart", ",", "wDeriv", ",", "mdeialTrace", ",", 
         "arcSegmentList", ",", "theBranchSet", ",", "rStart", ",", "rEnd", 
         ",", "zRadiusF", ",", "innerRadialTrace", ",", "innerRValues", ",", 
         "outerRadialTrace", ",", "outerRValues", ",", "medialTrace"}], "}"}],
        ",", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "get", " ", "annulus", " ", "index", " ", "into", " ", 
         "annulusTable"}], " ", "*)"}], "\[IndentingNewLine]", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"aIndex", ",", "sIndex"}], "}"}], "=", 
         RowBox[{"getSingTableIndexes", "[", 
          RowBox[{"annulusTable", ",", "annularIndex"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"currentAnnuli", "=", 
         RowBox[{"annulusTable", "[", 
          RowBox[{"[", 
           RowBox[{"aIndex", ",", "3"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "adjust", " ", "annulus", " ", "bounds", " ", "for", " ", "plotting",
           " ", "to", " ", "avoid", " ", "getting", " ", "too", " ", "close", 
          " ", "to", " ", "singular", " ", "points"}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"newRadiiTable", "=", 
         RowBox[{"Array", "[", 
          RowBox[{
           RowBox[{"#", "&"}], ",", 
           RowBox[{"{", "radialSegments", "}"}], ",", "currentAnnuli"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"newRadiiTable", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "=", 
         RowBox[{
          RowBox[{"newRadiiTable", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"newRadiiTable", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "-", 
             RowBox[{"newRadiiTable", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "/", "10"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"newRadiiTable", "[", 
          RowBox[{"[", 
           RowBox[{"-", "1"}], "]"}], "]"}], "=", 
         RowBox[{
          RowBox[{"newRadiiTable", "[", 
           RowBox[{"[", 
            RowBox[{"-", "1"}], "]"}], "]"}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"newRadiiTable", "[", 
              RowBox[{"[", 
               RowBox[{"-", "2"}], "]"}], "]"}], "-", 
             RowBox[{"newRadiiTable", "[", 
              RowBox[{"[", 
               RowBox[{"-", "1"}], "]"}], "]"}]}], ")"}], "/", "10"}]}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"rNorm", "=", 
         RowBox[{"SetPrecision", "[", 
          RowBox[{
           RowBox[{"annulusTable", "[", 
            RowBox[{"[", 
             RowBox[{"aIndex", ",", "4"}], "]"}], "]"}], ",", 
           "workingPrecision"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"rNorm", "=", 
           RowBox[{"newRadiiTable", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"radialSegments", "-", "1"}], ")"}], "/", "2"}], "+", 
              "1"}], "]"}], "]"}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"rMin", ",", "rMax"}], "}"}], "=", 
         RowBox[{"newRadiiTable", "[", 
          RowBox[{"[", 
           RowBox[{"{", 
            RowBox[{"1", ",", 
             RowBox[{"-", "1"}]}], "}"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"currentMonodromyList", "=", 
         RowBox[{"annulusTable", "[", 
          RowBox[{"[", 
           RowBox[{"aIndex", ",", "6"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"branchSize", "=", 
         RowBox[{"Length", "@", 
          RowBox[{"currentMonodromyList", "[", 
           RowBox[{"[", "branchNum", "]"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "get", " ", "root", " ", "index", " ", "for", " ", "first", " ", 
          "sheet", " ", "in", " ", "monodromy", " ", "list"}], " ", "*)"}], 
        " ", "\[IndentingNewLine]", 
        RowBox[{"rootIndex", "=", 
         RowBox[{"currentMonodromyList", "[", 
          RowBox[{"[", 
           RowBox[{"branchNum", ",", "1"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "set", " ", "up", " ", "monodromy", " ", "DE", " ", "for", " ", 
          "medial", " ", "contour", " ", "integration"}], " ", "*)"}], " ", 
        "\[IndentingNewLine]", 
        RowBox[{"tStart", "=", "thetaV"}], ";", " ", 
        RowBox[{"(*", " ", 
         RowBox[{
         "begin", " ", "integration", " ", "at", " ", "branch", " ", 
          "reference", " ", "angle"}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"tEnd", "=", 
         RowBox[{"thetaV", "+", 
          RowBox[{"2", "\[Pi]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"zStart", "=", 
         RowBox[{"rNorm", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"\[ImaginaryI]", " ", "tStart"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"zThetaF", "[", "t_", "]"}], ":=", 
         RowBox[{"rNorm", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"I", " ", "t"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"theRoots", "=", 
         RowBox[{"w", "/.", 
          RowBox[{"NSolve", "[", 
           RowBox[{
            RowBox[{"$theFunction", "\[Equal]", "0"}], "/.", 
            RowBox[{"z", "\[Rule]", "zStart"}]}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"wStart", "=", 
         RowBox[{"theRoots", "[", 
          RowBox[{"[", "rootIndex", "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"wDeriv", ":=", 
         RowBox[{
          RowBox[{
           RowBox[{"w", "'"}], "[", "t", "]"}], "\[Equal]", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", 
               FractionBox[
                RowBox[{"D", "[", 
                 RowBox[{"$theFunction", ",", "z"}], "]"}], 
                RowBox[{"D", "[", 
                 RowBox[{"$theFunction", ",", "w"}], "]"}]]}], " ", 
              RowBox[{"D", "[", 
               RowBox[{
                RowBox[{"zThetaF", "[", "t", "]"}], ",", "t"}], "]"}]}], 
             ")"}], "/.", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"w", "\[Rule]", 
               RowBox[{"w", "[", "t", "]"}]}], ",", 
              RowBox[{"z", "\[Rule]", 
               RowBox[{"zThetaF", "[", "t", "]"}]}]}], "}"}]}], ")"}]}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"medialTrace", "=", 
         RowBox[{"NDSolveValue", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"wDeriv", ",", 
             RowBox[{
              RowBox[{"w", "[", "tStart", "]"}], "\[Equal]", "wStart"}]}], 
            "}"}], ",", "w", ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", "tStart", ",", "tEnd"}], "}"}], ",", 
           RowBox[{"MaxSteps", "\[Rule]", "totalIntegrationSteps"}], ",", 
           RowBox[{"MaxStepSize", "\[Rule]", "maxStepSize"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "construct", " ", "point", " ", "along", " ", "medial", " ", 
          "contour", " ", "for", " ", "radial", " ", "integrations"}], " ", 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{"arcSegmentList", "=", 
         RowBox[{"Array", "[", 
          RowBox[{
           RowBox[{"#", "&"}], ",", 
           RowBox[{"(", 
            RowBox[{"arcSegments", " ", "branchSize"}], ")"}], ",", 
           RowBox[{"{", 
            RowBox[{"tStart", ",", "tEnd"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Clear", "[", "r", "]"}], ";"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{"do", " ", "radial", " ", "integrations"}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"theBranchSet", "=", 
         RowBox[{"Table", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"rStart", "=", "rNorm"}], ";", "\[IndentingNewLine]", 
            RowBox[{"rEnd", "=", "rMin"}], ";", "\[IndentingNewLine]", 
            RowBox[{"tStart", "=", "segmentNum"}], ";", "\[IndentingNewLine]",
             "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"zRadiusF", "[", "r_", "]"}], ":=", 
             RowBox[{"r", " ", 
              RowBox[{"Exp", "[", 
               RowBox[{"I", " ", "tStart"}], "]"}]}]}], ";", 
            "\[IndentingNewLine]", "\[IndentingNewLine]", 
            "\[IndentingNewLine]", 
            RowBox[{"wStart", "=", 
             RowBox[{"medialTrace", "[", "tStart", "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"wDeriv", "=", 
             RowBox[{
              RowBox[{
               RowBox[{"w", "'"}], "[", "r", "]"}], "\[Equal]", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"-", 
