               "]"}], ",", 
             RowBox[{"Style", "[", 
              RowBox[{"\"\<Im(z)\>\"", ",", "14", ",", "Bold", ",", "Black"}],
               "]"}], ",", 
             RowBox[{"Style", "[", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"ToString", "[", "$plotType", "]"}], "<>", 
