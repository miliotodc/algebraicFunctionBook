                RowBox[{"Style", "[", 
                 RowBox[{"maxCharLen", ",", "Red"}], "]"}]}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"Print", "[", 
               RowBox[{"\"\<       Length actWChar: \>\"", ",", 
                RowBox[{"Length", "@", "actWChar"}]}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"Print", "[", 
               RowBox[{"\"\<       Length seriesWChar: \>\"", ",", 
                RowBox[{"Length", "@", "seriesWChar"}]}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"maxCharFlag", "=", "True"}], ";"}]}], 
            "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{"For", "[", 
