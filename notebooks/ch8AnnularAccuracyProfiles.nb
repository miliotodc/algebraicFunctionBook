  "\[IndentingNewLine]", " ", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"getRingMonodromy", "[", 
      RowBox[{"ringNum_", ",", "baseComparisonAccuracy_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "precisionArray", ",", "rnorm", ",", "zstart", ",", "theBaseValues", 
         ",", "theBaseValueDigits", ",", "tStart", ",", "tEnd", ",", 
