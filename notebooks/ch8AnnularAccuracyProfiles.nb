          RowBox[{"Im", "@", 
           RowBox[{"singularSet", "[", 
            RowBox[{"[", 
             RowBox[{"(", 
              RowBox[{"singularOrderList", "[", 
               RowBox[{"[", 
                RowBox[{"orderIndex", ",", "2"}], "]"}], "]"}], ")"}], "]"}], 
            "]"}]}], "/.", 
          RowBox[{"z", "->", "zVal"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"aValRe", "=", 
         RowBox[{
          RowBox[{"Re", "@", 
           RowBox[{"analyticSet", "[", 
            RowBox[{"[", 
             RowBox[{"(", 
              RowBox[{"analyticOrderList", "[", 
               RowBox[{"[", 
                RowBox[{"orderIndex", ",", "2"}], "]"}], "]"}], ")"}], "]"}], 
            "]"}]}], "/.", 
          RowBox[{"z", "->", "zVal"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"sValRe", "=", 
