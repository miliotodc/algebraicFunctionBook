          RowBox[{"z", "->", "zVal"}]}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"aValImME", "=", 
         RowBox[{
          RowBox[{"MantissaExponent", "[", "aValIm", "]"}], "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"sValImME", "=", 
         RowBox[{
