Cell[CellGroupData[{

Cell["getSingularMonodromy", "Subsection",
 CellChangeTimes->{{3.9292797409201126`*^9, 
  3.9292797439821234`*^9}},ExpressionUUID->"474e532a-5b12-48fa-8a00-\
16dacb33e427"],

Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
   "get", " ", "differential", " ", "monodromy", " ", "around", " ", "a", " ",
     "singular", " ", "point"}], "\[IndentingNewLine]", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"getSingularMonodromy", "[", 
     RowBox[{
     "theSingularPoint_", ",", "rNorm_", ",", "thetaQ_", ",", "diagFlag_"}], 
     "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "z0", ",", "singularRoots", ",", "wArray", ",", "branchVals", ",", 
        "polishedVals", ",", "pArray", ",", "theCycles", ",", "theLinks", ",",
         "oneCycles", ",", "finalCycles"}], "}"}], ",", "\[IndentingNewLine]",
       "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"z0", "=", 
        RowBox[{"theSingularPoint", "+", 
         RowBox[{"rNorm", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"I", " ", "thetaQ"}], "]"}]}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<z0: \>\"", ",", 
         RowBox[{"z0", "//", "N"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"singularRoots", "=", 
        RowBox[{"Sort", "[", 
         RowBox[{"w", "/.", 
          RowBox[{"NSolve", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"$theFunction", "==", "0"}], "/.", 
             RowBox[{"z", "->", "z0"}]}], ",", "w", ",", 
            RowBox[{"WorkingPrecision", "->", "50"}]}], "]"}]}], "]"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"wArray", "=", 
        RowBox[{"MapThread", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"#1", ",", "#2"}], "}"}], "&"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Range", "[", 
             RowBox[{"Length", "@", "singularRoots"}], "]"}], ",", 
            "singularRoots"}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", " ", 
       RowBox[{"branchVals", "=", 
        RowBox[{"integrateOverSheet", "[", 
         RowBox[{
         "z0", ",", "theSingularPoint", ",", "thetaQ", ",", "wArray", ",", 
          "rNorm", ",", "False", ",", "50"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"polishedVals", "=", 
        RowBox[{"polishBranchTerms", "[", 
         RowBox[{"z0", ",", "branchVals", ",", "20"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{"diagFlag", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"\"\<polishedVals: \>\"", ",", 
            RowBox[{
             RowBox[{"polishedVals", "//", "N"}], "//", "MatrixForm"}]}], 
           "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"pArray", "=", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Position", "[", 
            RowBox[{
             RowBox[{"polishedVals", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
             RowBox[{"x_", "/;", 
              RowBox[{
               RowBox[{"Abs", "[", 
                RowBox[{"x", "-", "#"}], "]"}], "<", 
               RowBox[{"10", "^", 
                RowBox[{"-", "20"}]}]}]}]}], "]"}], "&"}], "/@", " ", 
          RowBox[{"polishedVals", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "3"}], "]"}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"theCycles", "=", 
        RowBox[{"PermutationCycles", "[", "pArray", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"theLinks", "=", 
        RowBox[{"theCycles", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"oneCycles", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"{", "#", "}"}], "&"}], "/@", 
         RowBox[{"Complement", "[", 
          RowBox[{
           RowBox[{"Range", "[", "functionDegree", "]"}], ",", 
           RowBox[{"Flatten", "[", "theLinks", "]"}]}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"finalCycles", "=", 
        RowBox[{"Join", "[", 
         RowBox[{"theLinks", ",", "oneCycles"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Sort", "[", 
           RowBox[{"Flatten", "@", "finalCycles"}], "]"}], "!=", 
          RowBox[{"Range", "[", 
           RowBox[{"Length", "@", 
            RowBox[{"Flatten", "@", "finalCycles"}]}], "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"Style", "[", 
            RowBox[{"\"\<Monodromy is not consistent!\>\"", ",", "Red"}], 
            "]"}], "]"}], ";"}], "\[IndentingNewLine]", ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", "\"\<Monodromy is consistent\>\"", "]"}], 
          ";"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"finalCycles", ",", "polishedVals"}], "}"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.9292797337343035`*^9, 3.929279734077978*^9}, {
   3.929342083325768*^9, 3.9293420903241653`*^9}, {3.929343498732478*^9, 
   3.9293435064184375`*^9}, 3.9591490900017815`*^9},
 CellLabel->
  "In[120]:=",ExpressionUUID->"4222945c-e2cc-43dd-b52e-118ceb2e2643"]
}, Closed]],

Cell[CellGroupData[{

Cell["getAnnularTemplate", "Subsection",
 CellChangeTimes->{{3.940523544396841*^9, 
  3.940523547489897*^9}},ExpressionUUID->"aa9ce640-0a56-4a6e-947e-\
372cf4dbb666"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{"getAnnularTemplate", "[", "$theFunction", "]"}], ";"}]}]], "Input",
 CellChangeTimes->{{3.9869870088199625`*^9, 3.9869870170527024`*^9}},
 CellLabel->
  "In[121]:=",ExpressionUUID->"a76da9ca-17b0-469a-89b7-33412549e0a1"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"getAnnularTemplate", "[", "$theFunction_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "res", ",", "theSingularSet", ",", "singAccuracy", ",", 
         "theSingularList", ",", "argList", ",", "zeroIndexes", ",", 
         "poleIndexes", ",", "nearestSing", ",", "nearestDist", ",", 
         "minRadiusArray", ",", "singularPerimeters", ",", "absVals", ",", 
         "ringSize", ",", "tempRings", ",", "theAnnuli", ",", 
         "ringMemberSingularIndexes", ",", "radiiTable", ",", "annularSizes", 
         ",", "annularCenters", ",", "singTable", ",", "annulusTable", ",", 
         "annulusTableR", ",", "ringSizes", ",", "minRingSize", ",", 
         "tableIndex", ",", "j", ",", "annulusTableReport", ",", 
         "singTableAnnulusIndexes", ",", "plottingRadiiTable", ",", 
         "newTable", ",", "theReturn", ",", "singTableSingIndexes", ",", 
         "i"}], " ", "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]",
        "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"totalIntegrationSteps", "=", "1500000"}], ";"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"maxStepSize", "=", "0.0001"}], ";"}], "*)"}], 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"ringDelta", "=", 
          RowBox[{"1", "/", "20000"}]}], ";"}], "*)"}], " ", 
       RowBox[{"(*", " ", 
        RowBox[{"ring", " ", "separation", " ", "threshold"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"minRingSize", "=", 
         RowBox[{"1", "/", "2000"}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"res", "=", 
         RowBox[{"Resultant", "[", 
          RowBox[{"$theFunction", ",", 
           RowBox[{"D", "[", 
            RowBox[{"$theFunction", ",", "w"}], "]"}], ",", "w"}], "]"}]}], 
        ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"theSingularSet", "=", 
         RowBox[{"Sort", "[", 
          RowBox[{
           RowBox[{"z", "/.", 
            RowBox[{"NSolve", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Simplify", "@", "res"}], "\[Equal]", "0"}], ",", "z", 
              ",", 
              RowBox[{"WorkingPrecision", "\[Rule]", "$workingPrecision"}]}], 
             "]"}]}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "@", "#1"}], "<=", " ", 
             RowBox[{"Abs", "@", "#2"}]}], "&"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"singAccuracy", "=", 
         RowBox[{"Floor", "@", 
          RowBox[{"Accuracy", "@", "theSingularSet"}]}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", "\[IndentingNewLine]", " ", 
         RowBox[{
         "final", " ", "form", " ", "of", " ", "the", " ", "singular", " ", 
          "list"}], "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"theSingularList", "=", 
         RowBox[{"DeleteDuplicates", "[", 
          RowBox[{"theSingularSet", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"#1", "-", "#2"}], "]"}], "<", 
             RowBox[{"10", "^", 
              RowBox[{"-", 
               RowBox[{"(", 
                RowBox[{"singAccuracy", "-", "$accuracyComparisonFactor"}], 
                ")"}]}]}]}], "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", "\[IndentingNewLine]", " ", 
         RowBox[{
          RowBox[{
          "get", " ", "arguments", " ", "of", " ", "singular", " ", "points", 
           " ", "argList"}], ",", "zeroIndexes", ",", "poleIndexes", ",", 
          "nearestSing", ",", "nearestDist"}], "\[IndentingNewLine]", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"argList", "=", 
         RowBox[{"Arg", "@", "theSingularList"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", "\[IndentingNewLine]", " ", 
         RowBox[{
          RowBox[{
          "now", " ", "get", " ", "zero", " ", "points", " ", "a_", "0", 
           RowBox[{"(", "z", ")"}]}], "=", 
          RowBox[{
           RowBox[{"0", " ", "when", " ", "either", " ", "$a_", "1", 
            RowBox[{"(", "z", ")"}]}], "=", 
           RowBox[{
            RowBox[{"0", " ", "or", " ", "$a_", "0"}], "=", 
            RowBox[{"a_", "1"}]}]}]}], "\[IndentingNewLine]", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"zeroIndexes", "=", 
         RowBox[{"getZeroIndexes", "[", 
          RowBox[{"$theFunction", ",", "theSingularList", ",", "False"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", "\[IndentingNewLine]", 
         RowBox[{"get", " ", "poles"}], " ", "\[IndentingNewLine]", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"poleIndexes", "=", 
         RowBox[{"getPoles", "[", 
          RowBox[{"$theFunction", ",", "theSingularList", ",", "False"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<poleIndexes: \>\"", ",", "poleIndexes"}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", "\[IndentingNewLine]", " ", 
         RowBox[{
          RowBox[{
          "compute", " ", "minArray", " ", "of", " ", "integration", " ", 
           "region", " ", "around", " ", "each", " ", "singular", " ", 
           "point", " ", "if", " ", "total"}], " ", ">", " ", "1"}], " ", 
         "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "@", "theSingularList"}], ">", "1"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"nearestSing", "=", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"NearestTo", "[", 
                  RowBox[{"#1", ",", "2"}], "]"}], "[", "theSingularList", 
                 "]"}], "&"}], "/@", " ", "theSingularList"}], ")"}], "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"nearestDist", "=", 
            RowBox[{"MapThread", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"1", "/", "3"}], 
                RowBox[{"Abs", "[", 
                 RowBox[{"#1", "-", "#2"}], "]"}]}], "&"}], ",", 
              RowBox[{"{", 
               RowBox[{"theSingularList", ",", "nearestSing"}], "}"}]}], 
             "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{"nearestSingDist", "=", 
              RowBox[{"MapThread", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Abs", "[", 
                  RowBox[{"#1", "-", "#2"}], "]"}], "&"}], ",", 
                RowBox[{"{", 
                 RowBox[{"theSingularList", ",", "nearestSing"}], "}"}]}], 
               "]"}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
           RowBox[{"For", "[", 
            RowBox[{
             RowBox[{"i", "=", "1"}], ",", 
             RowBox[{"i", "<=", 
              RowBox[{"Length", "@", "nearestDist"}]}], ",", 
             RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"nearestDist", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], ">", "10"}], ",", 
                "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{
                  RowBox[{"nearestDist", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], "=", "10"}], ";"}]}], 
               "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", 
            "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"minRadiusArray", "=", "nearestDist"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"singularPerimeters", "=", "minRadiusArray"}], ";"}], 
          "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"Style", "[", 
             RowBox[{
             "\"\<Found only one singular point!\>\"", ",", "Red", ",", 
              "Bold"}], "]"}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"minRadiusArray", "=", "\[Infinity]"}], ";"}]}], 
         "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", "\[IndentingNewLine]", 
         RowBox[{"compute", " ", "rings"}], "\[IndentingNewLine]", "*)"}], 
        "\[IndentingNewLine]", " ", 
        RowBox[{"absVals", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "@", "#"}], "&"}], "/@", " ", "theSingularList"}]}],
         ";", "\[IndentingNewLine]", 
        RowBox[{"ringSizes", "=", 
         RowBox[{"DeleteDuplicates", "[", 
          RowBox[{"absVals", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"#1", "-", "#2"}], "]"}], "<", 
             RowBox[{"10", "^", 
              RowBox[{"-", "$accuracyComparisonFactor"}]}]}], "&"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", "\[IndentingNewLine]", "  ", 
         RowBox[{"compute", " ", "annular", " ", "regions"}], " ", 
         "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"tempRings", "=", 
         RowBox[{"Union", "[", 
          RowBox[{
           RowBox[{"{", "0", "}"}], ",", "ringSizes", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"ringSizes", "[", 
              RowBox[{"[", 
               RowBox[{"-", "1"}], "]"}], "]"}], "+", "4"}], "}"}]}], "]"}]}],
         ";", "\[IndentingNewLine]", 
        RowBox[{"theAnnuli", "=", 
         RowBox[{"Partition", "[", 
          RowBox[{"tempRings", ",", "2", ",", "1"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"ringMemberSingularIndexes", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"Flatten", "[", 
            RowBox[{"Position", "[", 
             RowBox[{"theSingularList", ",", 
              RowBox[{"x_", "/;", 
               RowBox[{
                RowBox[{"Abs", "[", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"Abs", "[", "x", "]"}], "-", "#"}], ")"}], "]"}], 
                "<", 
                RowBox[{"10", "^", 
                 RowBox[{"-", "20"}]}]}]}]}], "]"}], "]"}], "&"}], " ", "/@", 
          RowBox[{"theAnnuli", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{";;", 
              RowBox[{"-", "2"}]}], ",", "2"}], "]"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"minRingSize", "=", 
         RowBox[{"Min", "[", 
          RowBox[{"Differences", "[", "theAnnuli", "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"radiiTable", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Array", "[", 
            RowBox[{
             RowBox[{"#", "&"}], ",", "radialSegments", ",", 
             RowBox[{"theAnnuli", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", 
             RowBox[{"Length", "[", "theAnnuli", "]"}]}], "}"}]}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"(*", "\[IndentingNewLine]", " ", 
         RowBox[{"compute", " ", "annular", " ", "sizes"}], 
         "\[IndentingNewLine]", "*)"}], " ", "\[IndentingNewLine]", 
        RowBox[{"annularSizes", "=", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "-", 
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "&"}], "/@", " ", 
           "theAnnuli"}], "//", "N"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"annularCenters", "=", 
