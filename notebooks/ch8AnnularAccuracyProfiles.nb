Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"plotDomainDif", "=", "2"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"branchColors", "=", 
     RowBox[{"{", 
      RowBox[{"Red", ",", "Blue", ",", "Green", ",", "Yellow"}], "}"}]}], 
