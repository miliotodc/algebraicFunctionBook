        "\[IndentingNewLine]", 
        RowBox[{"linearResidue", "=", 
         RowBox[{"Plus", "@@", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], "-", "linearLine"}], "/.", 
               RowBox[{"x", "->", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "1", "]"}], "]"}]}]}], "]"}], "&"}], "/@", " ", 
            "dataVals"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"cubicResidue", "=", 
         RowBox[{"Plus", "@@", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], "-", "cubicLine"}], "/.", 
               RowBox[{"x", "->", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "1", "]"}], "]"}]}]}], "]"}], "&"}], "/@", " ", 
            "dataVals"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"quadraticResidue", "=", 
         RowBox[{"Plus", "@@", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], "-", "quadraticLine"}], "/.", 
               RowBox[{"x", "->", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "1", "]"}], "]"}]}]}], "]"}], "&"}], "/@", " ", 
            "dataVals"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"residueSet", "=", 
         RowBox[{"{", 
          RowBox[{
          "linearResidue", ",", "quadraticResidue", ",", "cubicResidue"}], 
          "}"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"functionList", "=", 
         RowBox[{"{", 
          RowBox[{"linearLine", ",", "quadraticLine", ",", "cubicLine"}], 
          "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"bestFitPos", "=", 
         RowBox[{
          RowBox[{"Position", "[", 
           RowBox[{"residueSet", ",", 
            RowBox[{"Min", "[", "residueSet", "]"}]}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{"diagFlag", ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{"\"\<residueSet: \>\"", ",", 
               RowBox[{"residueSet", "//", "N"}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"Print", "[", 
              RowBox[{"\"\<Best fit function: \>\"", ",", 
               RowBox[{
                RowBox[{"functionList", "[", 
                 RowBox[{"[", "bestFitPos", "]"}], "]"}], "//", "N"}]}], 
              "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"Print", "[", 
              RowBox[{"\"\<Minimum Residue: \>\"", ",", 
               RowBox[{
                RowBox[{"residueSet", "[", 
                 RowBox[{"[", "bestFitPos", "]"}], "]"}], "//", "N"}]}], 
              "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], "*)"}], 
        "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"bestLowerFitPlot", "=", 
         RowBox[{"Plot", "[", 
          RowBox[{
           RowBox[{"functionList", "[", 
            RowBox[{"[", "bestFitPos", "]"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", "orderStart", ",", "orderEnd"}], "}"}], ",", 
           RowBox[{"PlotStyle", "->", 
            RowBox[{"{", 
             RowBox[{"Dashed", ",", 
              RowBox[{"Thickness", "[", "0.0025", "]"}], ",", "Black"}], 
             "}"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"bestLowerFitFunction", "=", 
         RowBox[{"functionList", "[", 
          RowBox[{"[", "bestFitPos", "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"theRadius", ",", 
          RowBox[{"{", 
           RowBox[{"bestLowerFitFunction", ",", "bestUpperFitPlot"}], "}"}], 
          ",", 
          RowBox[{"{", 
           RowBox[{"bestUpperFitFunction", ",", "bestLowerFitPlot"}], "}"}], 
          ",", "theOrderErrorTable"}], "}"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"radiusIndex", ",", "1", ",", 
         RowBox[{"Length", "@", "radiusRatios"}]}], "}"}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
