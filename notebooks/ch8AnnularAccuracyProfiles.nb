           RowBox[{"singularSet", "[", 
            RowBox[{"[", 
             RowBox[{"(", 
              RowBox[{"singularOrderList", "[", 
               RowBox[{"[", 
                RowBox[{"orderIndex", ",", "2"}], "]"}], "]"}], ")"}], "]"}], 
