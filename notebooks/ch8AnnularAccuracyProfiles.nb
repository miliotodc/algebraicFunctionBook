}, Closed]],

Cell[CellGroupData[{

Cell["getAnnularMonodromy", "Subsection",
 CellChangeTimes->{{3.9292776480259233`*^9, 
  3.9292776510097303`*^9}},ExpressionUUID->"10c7baa1-6234-4abd-8f37-\
6bac3cffc8fd"],

Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
   "get", " ", "differential", " ", "monodromy", " ", "around", " ", "a", " ",
     "selected", " ", "annulus"}], "\[IndentingNewLine]", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"getAnnularMonodromy", "[", 
      RowBox[{
      "annulusIndex_", ",", "annularNorms_", ",", "thetaQ_", ",", 
       "diagFlag_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "rNorm", ",", "z0", ",", "annularMedialVals", ",", "wArray", ",", 
         "branchVals", ",", "polishedVals", ",", "pArray", ",", "theCycles", 
         ",", "theLinks", ",", "oneCycles", ",", "finalCycles", ",", 
         "monodromyTable"}], "}"}], ",", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"rNorm", "=", 
         RowBox[{"annularNorms", "[", 
          RowBox[{"[", "annulusIndex", "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"z0", "=", 
         RowBox[{"rNorm", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"I", " ", "thetaQ"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{"diagFlag", ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"\"\<z0: \>\"", ",", 
             RowBox[{"z0", "//", "N"}]}], "]"}], ";"}]}], 
         "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"annularMedialVals", "=", 
         RowBox[{"Sort", "[", 
          RowBox[{"w", "/.", 
           RowBox[{"NSolve", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"$theFunction", "==", "0"}], "/.", 
              RowBox[{"z", "->", "z0"}]}], ",", "w", ",", 
             RowBox[{"WorkingPrecision", "->", "50"}]}], "]"}]}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"\"\<annularMedialVals: \>\"", ",", 
            RowBox[{"annularMedialVals", "//", "N"}]}], "]"}], ";"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"wArray", "=", 
         RowBox[{"MapThread", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"#1", ",", "#2"}], "}"}], "&"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Range", "[", 
              RowBox[{"Length", "@", "annularMedialVals"}], "]"}], ",", 
             "annularMedialVals"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{"diagFlag", ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"Grid", "[", 
             RowBox[{"SetPrecision", "[", 
              RowBox[{"wArray", ",", "4"}], "]"}], "]"}], "]"}], ";"}]}], 
         "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", " ", 
        RowBox[{"branchVals", "=", 
         RowBox[{"integrateOverAnnulus", "[", 
          RowBox[{
          "thetaQ", ",", "wArray", ",", "rNorm", ",", "False", ",", "50"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"polishedVals", "=", 
         RowBox[{"polishBranchTerms", "[", 
          RowBox[{"z0", ",", "branchVals", ",", "20"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{"diagFlag", ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{
             RowBox[{"polishedVals", "//", "N"}], "//", "MatrixForm"}], "]"}],
            ";"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"pArray", "=", 
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Position", "[", 
             RowBox[{
              RowBox[{"polishedVals", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
              RowBox[{"x_", "/;", 
               RowBox[{
                RowBox[{"Abs", "[", 
                 RowBox[{"x", "-", "#"}], "]"}], "<", 
                RowBox[{"10", "^", 
                 RowBox[{"-", "20"}]}]}]}]}], "]"}], "&"}], "/@", " ", 
           RowBox[{"polishedVals", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "3"}], "]"}], "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{"diagFlag", ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"monodromyTable", "=", 
            RowBox[{"MapThread", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"#1", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], ",", 
                 RowBox[{"N", "[", 
                  RowBox[{
                   RowBox[{"#1", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], ",", "5"}], "]"}], ",", 
                 RowBox[{"N", "[", 
                  RowBox[{
                   RowBox[{"#1", "[", 
                    RowBox[{"[", "3", "]"}], "]"}], ",", "5"}], "]"}], ",", 
                 "#2"}], "}"}], "&"}], ",", 
              RowBox[{"{", 
               RowBox[{"polishedVals", ",", "pArray"}], "}"}]}], "]"}]}], ";",
            "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"Grid", "[", "monodromyTable", "]"}], "]"}], ";"}]}], 
         "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"theCycles", "=", 
         RowBox[{"PermutationCycles", "[", "pArray", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"theLinks", "=", 
         RowBox[{"theCycles", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"oneCycles", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"{", "#", "}"}], "&"}], "/@", 
          RowBox[{"Complement", "[", 
           RowBox[{
            RowBox[{"Range", "[", "functionDegree", "]"}], ",", 
            RowBox[{"Flatten", "[", "theLinks", "]"}]}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"finalCycles", "=", 
         RowBox[{"Join", "[", 
          RowBox[{"theLinks", ",", "oneCycles"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<finalCycles: \>\"", ",", "finalCycles"}], "]"}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Sort", "[", 
            RowBox[{"Flatten", "@", "finalCycles"}], "]"}], "!=", 
           RowBox[{"Range", "[", 
            RowBox[{"Length", "@", 
             RowBox[{"Flatten", "@", "finalCycles"}]}], "]"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"Style", "[", 
             RowBox[{"\"\<monodromy is inconsistent!\>\"", ",", "Red"}], 
             "]"}], "]"}], ";"}], "\[IndentingNewLine]", ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Print", "[", "\"\<monodromy is consistent\>\"", "]"}], 
           ";"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
         "z0", ",", "rNorm", ",", "finalCycles", ",", "polishedVals"}], 
         "}"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]"}]}]], "Input",
