          RowBox[{"int32", "[", 
           RowBox[{"[", 
            RowBox[{"1", ";;", "8"}], "]"}], "]"}], ",", "2"}], "]"}]}], 
       "}"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
