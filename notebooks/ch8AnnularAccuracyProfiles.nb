Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{"(*", " ", "\[IndentingNewLine]", "   ", 
   RowBox[{
   "Fit", " ", "data", " ", "to", " ", "lower", " ", "minimize", " ", 
    "function"}], "\[IndentingNewLine]", " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"cTable", "=", 
     RowBox[{
      RowBox[{"theOrderErrorTable", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "3"}], "}"}]}], "]"}], "]"}], "//", "N"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dataVals", "=", "cTable"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"plotXStart", "=", 
     RowBox[{"cTable", "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"plotXEnd", "=", 
     RowBox[{"cTable", "[", 
      RowBox[{"[", 
       RowBox[{
        RowBox[{"-", "1"}], ",", "1"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"linearLine", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"c0", "+", 
        RowBox[{"c1", " ", "x"}]}], "/.", " ", 
       RowBox[{
        RowBox[{"Minimize", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Total", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"Abs", "[", 
                 RowBox[{
                  RowBox[{"#", "[", 
                   RowBox[{"[", "2", "]"}], "]"}], "-", 
                  RowBox[{"(", 
                   RowBox[{"c0", "+", 
                    RowBox[{"c1", " ", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}]}], ")"}]}], "]"}], ")"}],
                "&"}], "/@", "dataVals"}], "]"}], ",", 
            RowBox[{"And", "@@", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"c0", "+", 
                    RowBox[{"c1", " ", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}]}], ")"}], "<=", 
                  RowBox[{"#", "[", 
                   RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "&"}], "/@", " ", 
               "dataVals"}], ")"}]}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"c0", ",", "c1"}], "}"}]}], "]"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], "//", "N"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"quadraticLine", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"c0", "+", 
        RowBox[{"c1", " ", "x"}], "+", 
        RowBox[{"c2", " ", 
         RowBox[{"x", "^", "2"}]}]}], "/.", " ", 
       RowBox[{
        RowBox[{"Minimize", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Total", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"Abs", "[", 
                 RowBox[{
                  RowBox[{"#", "[", 
                   RowBox[{"[", "2", "]"}], "]"}], "-", 
                  RowBox[{"(", 
                   RowBox[{"c0", "+", 
                    RowBox[{"c1", " ", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "+", 
                    RowBox[{"c2", " ", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "^", "2"}]}]}], ")"}]}], 
                 "]"}], ")"}], "&"}], "/@", " ", "dataVals"}], "]"}], ",", 
            RowBox[{"And", "@@", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"c0", "+", 
                    RowBox[{"c1", " ", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "+", 
                    RowBox[{"c2", " ", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "^", "2"}]}]}], ")"}], "<=", 
                  RowBox[{"#", "[", 
                   RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "&"}], "/@", " ", 
               "dataVals"}], ")"}]}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"c0", ",", "c1", ",", "c2"}], "}"}]}], "]"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], "//", "N"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cubicLine", "=", 
     RowBox[{
      RowBox[{"c0", "+", 
       RowBox[{"c1", " ", "x"}], "+", 
       RowBox[{"c2", " ", 
        RowBox[{"x", "^", "2"}]}], "+", 
       RowBox[{"c3", " ", 
        RowBox[{"x", "^", "3"}]}]}], "/.", " ", 
      RowBox[{
       RowBox[{"NMinimize", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Total", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"Abs", "[", 
                RowBox[{
                 RowBox[{"#", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], "-", 
                 RowBox[{"(", 
                  RowBox[{"c0", "+", 
                   RowBox[{"c1", " ", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "+", 
                   RowBox[{"c2", " ", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "^", "2"}]}], "+", 
                   RowBox[{"c3", " ", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "^", "3"}]}]}], ")"}]}], 
                "]"}], ")"}], "&"}], "/@", " ", "dataVals"}], "]"}], ",", 
           RowBox[{"And", "@@", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"c0", "+", 
                   RowBox[{"c1", " ", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "+", 
                   RowBox[{"c2", " ", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "^", "2"}]}], "+", 
                   RowBox[{"c3", " ", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "^", "3"}]}]}], ")"}], "<=", 
                 RowBox[{"#", "[", 
                  RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "&"}], "/@", " ", 
              "dataVals"}], ")"}]}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"c0", ",", "c1", ",", "c2", ",", "c3"}], "}"}]}], "]"}], 
       "[", 
       RowBox[{"[", "2", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"logLine", "=", 
     RowBox[{
      RowBox[{"c0", "+", 
       RowBox[{"c1", " ", 
        RowBox[{"Log", "[", "x", "]"}]}]}], "/.", " ", 
      RowBox[{
       RowBox[{"NMinimize", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Total", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], "-", 
                RowBox[{"(", 
                 RowBox[{"c0", "+", 
                  RowBox[{"c1", " ", 
                   RowBox[{"Log", "[", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "]"}]}]}], ")"}]}], ")"}],
               "&"}], "/@", " ", "dataVals"}], "]"}], ",", 
           RowBox[{"And", "@@", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"c0", "+", 
                   RowBox[{"c1", " ", 
                    RowBox[{"Log", "[", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "]"}]}]}], ")"}], "<=", 
                 RowBox[{"#", "[", 
                  RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "&"}], "/@", " ", 
              "dataVals"}], ")"}]}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"c0", ",", "c1"}], "}"}]}], "]"}], "[", 
       RowBox[{"[", "2", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"linearResidue", "=", 
     RowBox[{"Plus", "@@", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "-", "linearLine"}], "/.", 
           RowBox[{"x", "->", 
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}]}], "]"}], "&"}], "/@", " ", 
        "dataVals"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cubicResidue", "=", 
     RowBox[{"Plus", "@@", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "-", "cubicLine"}], "/.", 
