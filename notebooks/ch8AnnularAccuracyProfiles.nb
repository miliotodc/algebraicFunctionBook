             RowBox[{"Exp", "[", 
              RowBox[{"I", " ", "tStart"}], "]"}]}]}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"wStart", "=", 
            RowBox[{"medialTrace", "[", "tStart", "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"wDeriv", "=", 
            RowBox[{
             RowBox[{
              RowBox[{"w", "'"}], "[", "r", "]"}], "\[Equal]", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"-", 
                  FractionBox[
                   RowBox[{"D", "[", 
                    RowBox[{"$theFunction", ",", "z"}], "]"}], 
                   RowBox[{"D", "[", 
                    RowBox[{"$theFunction", ",", "w"}], "]"}]]}], 
                 RowBox[{"D", "[", 
                  RowBox[{
                   RowBox[{"zRadiusF", "[", "r", "]"}], ",", "r"}], "]"}]}], 
                ")"}], "/.", 
               RowBox[{"{", 
