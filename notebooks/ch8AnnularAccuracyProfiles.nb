                 RowBox[{"z", "\[Rule]", 
                  RowBox[{"zRadiusF", "[", "r", "]"}]}]}], "}"}]}], ")"}]}]}],
            ";", "\[IndentingNewLine]", 
           RowBox[{"innerRadialTrace", "=", 
            RowBox[{"NDSolveValue", "[", 
