Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"f1", "[", "z_", "]"}], ":=", 
   FractionBox[
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", "\[ImaginaryI]"}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["z", "3"], "+", 
       RowBox[{
        SqrtBox[
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox["z", "2"], "+", 
            RowBox[{"(", 
             RowBox[{"1", "+", "\[ImaginaryI]"}], ")"}]}], ")"}], "2"]], " ", 
        SqrtBox[
         RowBox[{
          SuperscriptBox["z", "2"], "+", 
          RowBox[{"(", 
           RowBox[{"4", "+", 
            RowBox[{"4", " ", "\[ImaginaryI]"}]}], ")"}]}]]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"3", "+", 
          RowBox[{"3", " ", "\[ImaginaryI]"}]}], ")"}], " ", "z"}]}], ")"}]}], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["z", "2"], "+", 
       RowBox[{"(", 
        RowBox[{"4", "+", 
         RowBox[{"4", " ", "\[ImaginaryI]"}]}], ")"}]}], ")"}], 
     RowBox[{"3", "/", "2"}]]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gb", "=", 
    RowBox[{"GroebnerBasis", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", "\[ImaginaryI]"}], ")"}], " ", 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["z", "3"], "+", 
           RowBox[{
            SqrtBox[
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{
                SuperscriptBox["z", "2"], "+", 
                RowBox[{"(", 
                 RowBox[{"1", "+", "\[ImaginaryI]"}], ")"}]}], ")"}], "2"]], 
            " ", 
            SqrtBox[
             RowBox[{
              SuperscriptBox["z", "2"], "+", 
              RowBox[{"(", 
               RowBox[{"4", "+", 
                RowBox[{"4", " ", "\[ImaginaryI]"}]}], ")"}]}]]}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"3", "+", 
              RowBox[{"3", " ", "\[ImaginaryI]"}]}], ")"}], " ", "z"}]}], 
          ")"}]}], "-", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox["z", "2"], "+", 
            RowBox[{"(", 
             RowBox[{"4", "+", 
              RowBox[{"4", " ", "\[ImaginaryI]"}]}], ")"}]}], ")"}], 
          RowBox[{"3", "/", "2"}]], "w"}]}], "==", "0"}], ",", 
      RowBox[{"{", 
       RowBox[{"z", ",", "w"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"factorGB", "=", " ", 
