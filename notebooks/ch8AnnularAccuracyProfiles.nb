       RowBox[{"FindRoot", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"implicitF", "[", 
           RowBox[{
            RowBox[{"r", " ", 
             RowBox[{"Exp", "[", 
              RowBox[{"I", " ", "t"}], "]"}]}], ",", "w"}], "]"}], "==", 
          "0"}], ",", 
         RowBox[{"{", 
          RowBox[{"w", ",", "medialVal"}], "}"}], ",", 
         RowBox[{"WorkingPrecision", "->", "wPrec"}], ",", 
         RowBox[{"AccuracyGoal", "->", "wPrec"}], ",", 
         RowBox[{"PrecisionGoal", "->", "wPrec"}]}], "]"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}]}]], "Input",
