              RowBox[{"[", 
               RowBox[{"orderIndex", ",", "2"}], "]"}], "]"}], ")"}], "]"}], 
           "]"}], "/.", 
          RowBox[{"z", "->", "zVal"}]}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"aValIm", "=", 
         RowBox[{
          RowBox[{"Im", "@", 
           RowBox[{"analyticSet", "[", 
            RowBox[{"[", 
             RowBox[{"(", 
              RowBox[{"analyticOrderList", "[", 
               RowBox[{"[", 
                RowBox[{"orderIndex", ",", "2"}], "]"}], "]"}], ")"}], "]"}], 
            "]"}]}], "/.", 
