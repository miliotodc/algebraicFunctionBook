                  ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
               "\[IndentingNewLine]", "\[IndentingNewLine]", 
               RowBox[{"For", "[", 
                RowBox[{
                 RowBox[{"k", "=", "i"}], ",", 
                 RowBox[{"k", "<=", "maxCharLen2"}], ",", 
                 RowBox[{"k", "++"}], ",", "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"testChar", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], "=", 
                   RowBox[{"Style", "[", 
                    RowBox[{
                    RowBox[{"testChar", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], ",", "Red"}], "]"}]}], 
                  ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"sIndex", " ", "expInc"}], ",", 
                 RowBox[{"errTable", "[", 
