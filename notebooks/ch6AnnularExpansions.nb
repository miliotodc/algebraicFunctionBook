Cell[CellGroupData[{

Cell["Section 12.1:  Retrieve precise terms and compute max order", \
"Subsection",
 CellChangeTimes->{{3.9424030652013564`*^9, 3.942403086337016*^9}, {
  3.9821394294893036`*^9, 
  3.9821394320738707`*^9}},ExpressionUUID->"85e41726-e80a-4eb2-8389-\
f41bedd2e64e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{"retrieve", " ", "combinedTermsFileName"}], "\[IndentingNewLine]", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"FileExistsQ", "[", 
       RowBox[{"combinedExpansionTermsFileName", "[", 
        RowBox[{
        "$theTestCase", ",", "$selectedAnnulus", ",", "$selectedBranch"}], 
        "]"}], "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Importing combined high precision terms to \>\"", ",", 
         RowBox[{"combinedExpansionTermsFileName", "[", 
          RowBox[{
          "$theTestCase", ",", "$selectedAnnulus", ",", "$selectedBranch"}], 
          "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "reducedPreciseAnalyticTerms", ",", 
          "reducedPreciseAnalyticOrderList", ",", 
          "reducedPreciseSingularTerms", ",", 
          "reducedPreciseSingularOrderList"}], "}"}], "=", 
        RowBox[{"Import", "[", 
         RowBox[{"combinedExpansionTermsFileName", "[", 
          RowBox[{
          "$theTestCase", ",", "$selectedAnnulus", ",", "$selectedBranch"}], 
          "]"}], "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"singularMaxOrder", "=", 
        RowBox[{"reducedPreciseSingularOrderList", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"analyticMaxOrder", "=", 
        RowBox[{"reducedPreciseAnalyticOrderList", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"theMaxOrder", "=", 
        RowBox[{"Min", "[", 
         RowBox[{"{", 
          RowBox[{"analyticMaxOrder", ",", "singularMaxOrder"}], "}"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<theMaxOrder: \>\"", ",", "theMaxOrder"}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Precision of analytic terms: \>\"", ",", 
         RowBox[{"Precision", "@", "reducedPreciseAnalyticTerms"}]}], "]"}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Precision of singular terms: \>\"", ",", 
         RowBox[{"Precision", "@", "reducedPreciseSingularTerms"}]}], "]"}], 
       ";"}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"combinedExpansionTermsFileName", "[", 
            RowBox[{
            "$theTestCase", ",", "$selectedAnnulus", ",", "$selectedBranch"}],
             "]"}], "<>", "\"\< not found during import.\>\""}], ",", "Red"}],
          "]"}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.9410332868789873`*^9, 3.9410332872538977`*^9}, {
