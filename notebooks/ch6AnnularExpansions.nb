Cell[CellGroupData[{

Cell["\<\
Section 12.5:  Check accuracy as a function of order and radius ratio\
\>", "Subsection",
 CellChangeTimes->{{3.9811239717342224`*^9, 3.981123981097606*^9}, {
  3.982141230949798*^9, 3.982141238593778*^9}, {3.9864784834059896`*^9, 
  3.986478486324582*^9}},ExpressionUUID->"76984d58-3f3b-403f-9955-\
56ac699ec53f"],

Cell["\<\
Generate a list plot of accuracy vs. radius ratio using the maximum order of \
both singular and analytic terms computed above.  This plot should be \
V-shaped with accuracy increasing as the ratio is increased to a point about \
midway in the domain, then dropping as the ratio approaches the outer domain \
boundary\
\>", "Text",
 CellChangeTimes->{
  3.986478376781995*^9},ExpressionUUID->"6aac27ef-824d-4b12-ac95-\
deb53b56db46"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"   ", 
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{"check", " ", "accuracy", " ", "across", " ", "domain"}], " ", 
   "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"theAnnulus", "//", "N"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"thetaRange", "=", 
     RowBox[{"Array", "[", 
      RowBox[{
       RowBox[{"#", "&"}], ",", "100", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "Pi"}], ",", "Pi"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"if", " ", "outer", " ", "annulus"}], ",", " ", 
     RowBox[{"can", " ", "try", " ", "larger", " ", "domains"}]}], " ", 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"radiusRange", "=", 
     RowBox[{"Array", "[", 
      RowBox[{
       RowBox[{"#", "&"}], ",", "80", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"theAnnulus", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{"theAnnulus", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"radiusRatios", "=", 
     RowBox[{"Array", "[", 
      RowBox[{
       RowBox[{"#", "&"}], ",", "100", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "/", "100"}], ",", 
         RowBox[{"99", "/", "100"}]}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"radiusStart", "=", 
     RowBox[{"theAnnulus", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"radiusDif", "=", 
     RowBox[{
      RowBox[{"radiusRange", "[", 
       RowBox[{"[", 
        RowBox[{"-", "1"}], "]"}], "]"}], "-", 
      RowBox[{"radiusRange", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"diagFlag", "=", "False"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"seriesType", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"theTheta", "=", 
     RowBox[{"SetPrecision", "[", 
      RowBox[{
       RowBox[{"thetaRange", "[", 
        RowBox[{"[", "20", "]"}], "]"}], ",", "1000"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"theTheta", "=", 
     RowBox[{"Arg", "[", 
      RowBox[{"$theSingularList", "[", 
       RowBox[{"[", "2", "]"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"theTheta", "=", 
     RowBox[{"SetPrecision", "[", 
      RowBox[{
       RowBox[{"Pi", "/", "6"}], ",", "1000"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"orderStart", "=", "20"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"orderEnd", "=", "theMaxOrder"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"plotTable", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Mod", "[", 
            RowBox[{"radiusIndex", ",", "10"}], "]"}], "==", "0"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"\"\<rIndex: \>\"", ",", "radiusIndex"}], "]"}], ";"}]}], 
         "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", " ", 
        RowBox[{"theOrderErrorTable", "=", 
         RowBox[{"Table", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"theRadius", "=", 
             RowBox[{"radiusStart", "+", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"radiusRatios", "[", 
                 RowBox[{"[", "radiusIndex", "]"}], "]"}], " ", "radiusDif"}],
                ")"}]}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"zVal", "=", 
             RowBox[{"SetPrecision", "[", 
              RowBox[{
               RowBox[{"theRadius", " ", 
                RowBox[{"Exp", "[", 
                 RowBox[{"I", " ", 
                  RowBox[{"(", "theTheta", ")"}]}], "]"}]}], ",", "1000"}], 
              "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{"pVal", "=", 
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"Plus", "@@", 
                   RowBox[{"reducedAnalyticTerms", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ";;", 
                    RowBox[{"analyticOrderIndexList", "[", 
                    RowBox[{"[", 
                    RowBox[{"orderIndex", ",", "2"}], "]"}], "]"}]}], "]"}], 
                    "]"}]}], ")"}], "+", 
                 RowBox[{"(", 
                  RowBox[{"Plus", "@@", 
                   RowBox[{"theReformedSingularTerms", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ";;", 
                    RowBox[{"singularOrderIndexList", "[", 
                    RowBox[{"[", 
                    RowBox[{"orderIndex", ",", "2"}], "]"}], "]"}]}], "]"}], 
                    "]"}]}], ")"}]}], "/.", 
                RowBox[{"z", "->", "zVal"}]}]}], ";"}], "*)"}], 
            "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"pVal", "=", 
             RowBox[{
              RowBox[{"seriesTable", "[", 
               RowBox[{"[", "orderIndex", "]"}], "]"}], "/.", 
              RowBox[{"z", "->", "zVal"}]}]}], ";", "\[IndentingNewLine]", 
            "\[IndentingNewLine]", 
            RowBox[{"wVals", "=", 
             RowBox[{"w", "/.", 
              RowBox[{"NSolve", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"$theFunction", "==", "0"}], "/.", 
                 RowBox[{"z", "->", "zVal"}]}], ",", 
                RowBox[{"WorkingPrecision", "->", "200"}]}], "]"}]}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"errTable", "=", 
             RowBox[{
              RowBox[{
               RowBox[{"Abs", "[", 
                RowBox[{"#", "-", "pVal"}], "]"}], "&"}], "/@", " ", 
              "wVals"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"minError", "=", 
             RowBox[{"Min", "@", "errTable"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"minError", "<", 
               RowBox[{"10", "^", 
                RowBox[{"-", "200"}]}]}], ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"Print", "[", 
                RowBox[{"Style", "[", 
                 RowBox[{
                 "\"\<Error approaching working precision\>\"", ",", "Red"}], 
                 "]"}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
            "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"pos", "=", 
             RowBox[{
              RowBox[{"Position", "[", 
               RowBox[{"errTable", ",", 
                RowBox[{"Min", "[", "errTable", "]"}]}], "]"}], "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"radiusRatios", "[", 
                 RowBox[{"[", "n", "]"}], "]"}], ",", 
                RowBox[{
                 RowBox[{"errTable", "[", 
                  RowBox[{"[", "pos", "]"}], "]"}], "//", "N"}], ",", 
                RowBox[{"-", 
                 RowBox[{
                  RowBox[{"MantissaExponent", "[", 
                   RowBox[{"errTable", "[", 
                    RowBox[{"[", "pos", "]"}], "]"}], "]"}], "[", 
                  RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], ","}], "*)"}], 
            "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{"theRadius", ",", "orderIndex", ",", 
              RowBox[{"-", 
               RowBox[{"Log", "[", 
                RowBox[{"10", ",", 
                 RowBox[{"errTable", "[", 
                  RowBox[{"[", "pos", "]"}], "]"}]}], "]"}]}]}], "}"}]}], ",",
            "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"orderIndex", ",", "20", ",", "theMaxOrder", ",", "5"}], 
            "}"}]}], "\[IndentingNewLine]", "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"cTable", "=", 
         RowBox[{
          RowBox[{"theOrderErrorTable", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", 
             RowBox[{"{", 
              RowBox[{"2", ",", "3"}], "}"}]}], "]"}], "]"}], "//", "N"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"dataVals", "=", "cTable"}], ";", "\[IndentingNewLine]", 
        RowBox[{"plotXStart", "=", 
         RowBox[{"cTable", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"plotXEnd", "=", 
         RowBox[{"cTable", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"-", "1"}], ",", "1"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", " ", 
        RowBox[{"(*", " ", "\[IndentingNewLine]", "   ", 
         RowBox[{
         "Fit", " ", "data", " ", "to", " ", "upper", " ", "minimize", " ", 
