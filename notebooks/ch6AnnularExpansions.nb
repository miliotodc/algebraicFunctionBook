Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{"second", " ", "version"}], "\[IndentingNewLine]", "*)"}], 
  "\[IndentingNewLine]", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"pureData", "=", 
     RowBox[{"MapThread", "[", 
      RowBox[{"List", ",", 
       RowBox[{"ReIm", "@", 
        RowBox[{"residualSingularTerms", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "4", ",", "All", ",", "2"}], "]"}], "]"}]}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Precision of highest precision pureData: \>\"", ",", 
      RowBox[{"Precision", "@", 
       RowBox[{"pureData", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", 
          RowBox[{"-", "1"}]}], "]"}], "]"}]}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pureExp", "=", 
     RowBox[{"residualSingularTerms", "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "4", ",", "All", ",", "1"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"reducedFlag1", "=", "False"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"imagZeroIndexes", "=", "0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"realZeroIndexes", "=", "0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"singularCodeArray", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"reducedSingCoefList", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"newDataList", "=", 
         RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"coeffCode", "=", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0"}], "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"testRun", "=", 
         RowBox[{"pureData", "[", 
          RowBox[{"[", "iVal", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"realTrend", "=", 
         RowBox[{"-", 
          RowBox[{
           RowBox[{"MantissaExponent", "[", 
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{"testRun", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", "1"}], "]"}], "]"}], "//", "N"}], "]"}], 
            "]"}], "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "2"}], ";;"}], ",", "2"}], "]"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"imagTrend", "=", 
         RowBox[{"-", 
          RowBox[{
           RowBox[{"MantissaExponent", "[", 
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{"testRun", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", "2"}], "]"}], "]"}], "//", "N"}], "]"}], 
            "]"}], "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "2"}], ";;"}], ",", "2"}], "]"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Differences", "@", "realTrend"}], "==", 
           RowBox[{"{", "0", "}"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"AppendTo", "[", 
            RowBox[{"newDataList", ",", 
             RowBox[{"testRun", "[", 
