Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{"generate", " ", "high"}], "-", 
    RowBox[{"precision", " ", "analytic", " ", "terms"}]}], 
   "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"analyticIndexes", "=", 
     RowBox[{"analyticResidueArray", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<analyticIndexes: \>\"", ",", "analyticIndexes"}], "]"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"DistributeDefinitions", "[", 
     RowBox[{
     "$integrationPartition", ",", "$useAnalyticCodeArray", ",", 
      "$preciseAnalyticPolishPrecision"}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"SetSharedVariable", "[", "parallelIndex", "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"t0", "=", "$thetaV"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"t1", "=", 
     RowBox[{"t0", "+", 
      RowBox[{"2", " ", "Pi", " ", "$selectedBranchSize"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"intervalArray", "=", 
     RowBox[{"Array", "[", 
      RowBox[{
       RowBox[{"#", "&"}], ",", 
       RowBox[{"$preciseAnalyticIntegrationPartition", "+", "1"}], ",", 
       RowBox[{"{", 
        RowBox[{"t0", ",", "t1"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"thePartitions", "=", 
     RowBox[{"Partition", "[", 
      RowBox[{"intervalArray", ",", "2", ",", "1"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Partitioning integration as: \>\"", ",", "thePartitions"}], 
     "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sequenceTestPass", "=", "True"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"$preciseAnalyticPolishSequenceStart", "<", "0"}], "||", " ", 
       RowBox[{"$preciseAnalyticPolishSequenceStart", ">=", "1000"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"Style", "[", 
         RowBox[{
         "\"\<Sequence function range is 1 to 1000.  Edit max size if larger \
size is needed.\>\"", ",", "Red"}], "]"}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Abort", "[", "]"}], ";"}], "\[IndentingNewLine]", ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"parallelIndex", "=", "0"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{
        "\"\<Computing analytic terms using polishMedial at \>\"", ",", 
         "$preciseAnalyticPolishPrecision", ",", 
         "\"\< digits of working precision\>\""}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"analStartTime", "=", 
        RowBox[{"DateObject", "[", "Now", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"precisionAnalyticArray", "=", 
        RowBox[{"ParallelTable", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"parallelIndex", "++"}], ";", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Mod", "[", 
               RowBox[{"parallelIndex", ",", "25"}], "]"}], "==", "0"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Print", "[", 
               RowBox[{"\"\<Current index \>\"", ",", "parallelIndex"}], 
               "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"k", "==", "0"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"finalIntVal", "=", 
               RowBox[{"Plus", "@@", 
                RowBox[{"Table", "[", "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"NIntegrate", "[", " ", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"polishMedial", "[", 
                    RowBox[{"t", ",", "rationalRNorm", ",", "implicitF", ",", 
                    RowBox[{"lowPrecMedialSol", "[", "t", "]"}], ",", 
                    "$preciseAnalyticPolishPrecision"}], "]"}], 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Cos", "[", 
                    RowBox[{"t", " ", 
                    RowBox[{"k", "/", "$selectedBranchSize"}]}], "]"}], "-", 
                    RowBox[{"I", " ", 
                    RowBox[{"Sin", "[", 
                    RowBox[{"t", " ", 
                    RowBox[{"k", "/", "$selectedBranchSize"}]}], "]"}]}]}], 
                    ")"}]}], ",", 
                    RowBox[{"{", 
                    RowBox[{"t", ",", 
                    RowBox[{"thePartitions", "[", 
                    RowBox[{"[", 
                    RowBox[{"index", ",", "1"}], "]"}], "]"}], ",", 
                    RowBox[{"thePartitions", "[", 
                    RowBox[{"[", 
                    RowBox[{"index", ",", "2"}], "]"}], "]"}]}], "}"}], ",", 
                    RowBox[{"Method", "->", 
                    RowBox[{"{", 
                    RowBox[{"\"\<GlobalAdaptive\>\"", ",", 
                    RowBox[{"\"\<MaxErrorIncreases\>\"", "->", "600"}], ",", 
                    RowBox[{"Method", "->", "\"\<GaussKronrodRule\>\""}]}], 
                    "}"}]}], ",", 
                    RowBox[{
                    "WorkingPrecision", "->", 
                    "$preciseAnalyticPolishPrecision"}], ",", 
                    RowBox[{"AccuracyGoal", "->", 
                    RowBox[{"$preciseAnalyticPolishPrecision", "/", "2"}]}], 
                    ",", 
                    RowBox[{"MaxRecursion", "->", "Infinity"}]}], "]"}], ",", 
                  "\[IndentingNewLine]", 
                  RowBox[{"{", 
                   RowBox[{"index", ",", "1", ",", 
                    RowBox[{"Length", "@", "thePartitions"}]}], "}"}]}], 
                 "\[IndentingNewLine]", "]"}]}]}], ";"}], 
             "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"finalIntVal", "=", 
               RowBox[{"Plus", "@@", 
                RowBox[{"Table", "[", "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"NIntegrate", "[", " ", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"polishMedial", "[", 
                    RowBox[{"t", ",", "rationalRNorm", ",", "implicitF", ",", 
                    RowBox[{"lowPrecMedialSol", "[", "t", "]"}], ",", 
                    "$preciseAnalyticPolishPrecision"}], "]"}], 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Cos", "[", 
                    RowBox[{"t", " ", 
                    RowBox[{"k", "/", "$selectedBranchSize"}]}], "]"}], "-", 
                    RowBox[{"I", " ", 
                    RowBox[{"Sin", "[", 
                    RowBox[{"t", " ", 
                    RowBox[{"k", "/", "$selectedBranchSize"}]}], "]"}]}]}], 
                    ")"}]}], ",", 
                    RowBox[{"{", 
                    RowBox[{"t", ",", 
                    RowBox[{"thePartitions", "[", 
                    RowBox[{"[", 
                    RowBox[{"index", ",", "1"}], "]"}], "]"}], ",", 
                    RowBox[{"thePartitions", "[", 
                    RowBox[{"[", 
                    RowBox[{"index", ",", "2"}], "]"}], "]"}]}], "}"}], ",", 
                    RowBox[{"Method", "->", 
                    RowBox[{"{", 
                    RowBox[{"\"\<GlobalAdaptive\>\"", ",", 
                    RowBox[{"\"\<MaxErrorIncreases\>\"", "->", "600"}], ",", 
                    RowBox[{"Method", "->", "\"\<LevinRule\>\""}]}], "}"}]}], 
                    ",", 
                    RowBox[{
                    "WorkingPrecision", "->", 
                    "$preciseAnalyticPolishPrecision"}], ",", 
                    RowBox[{"AccuracyGoal", "->", 
                    RowBox[{"$preciseAnalyticPolishPrecision", "/", "2"}]}], 
                    ",", 
                    RowBox[{"MaxRecursion", "->", "Infinity"}]}], "]"}], ",", 
                  "\[IndentingNewLine]", 
                  RowBox[{"{", 
                   RowBox[{"index", ",", "1", ",", 
                    RowBox[{"Length", "@", "thePartitions"}]}], "}"}]}], 
                 "\[IndentingNewLine]", "]"}]}]}], ";"}]}], 
            "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"coef", "=", 
            RowBox[{
             FractionBox["1", 
              RowBox[{"2", " ", "Pi", " ", "$selectedBranchSize", " ", 
               RowBox[{"rNorm", "^", 
                RowBox[{"(", 
                 RowBox[{"k", "/", "$selectedBranchSize"}], ")"}]}]}]], 
             "finalIntVal"}]}], ";", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"k", "/", "$selectedBranchSize"}], ",", "coef", ",", 
             RowBox[{"N", "[", 
              RowBox[{"coef", ",", "10"}], "]"}], ",", 
             RowBox[{"coef", " ", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"z", "^", 
                 RowBox[{"(", 
                  RowBox[{"1", "/", "$selectedBranchSize"}], ")"}]}], ")"}], 
               "^", "k"}]}]}], "}"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"k", ",", "analyticIndexes"}], "}"}]}], 
         "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"analEndTime", "=", 
        RowBox[{"DateObject", "[", "Now", "]"}]}], ";", "\[IndentingNewLine]",
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Time to compute analytic terms: \>\"", ",", 
         RowBox[{"analEndTime", "-", "analStartTime"}]}], "]"}], ";"}]}], 
     "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.940420590921779*^9, 3.9404205929995975`*^9}, {
