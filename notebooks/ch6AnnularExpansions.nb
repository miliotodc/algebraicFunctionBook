Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", "\[IndentingNewLine]", " ", 
   RowBox[{"Root", " ", "Test"}], "\[IndentingNewLine]", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"plotLabel", "=", 
     RowBox[{"Column", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", "$theTestCase", "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Style", "[", 
             SubscriptBox["a", "$selectedAnnulus"], "]"}], ",", "\"\< \>\"", 
            ",", 
            RowBox[{"Style", "[", 
             RowBox[{"$selectedMonodromyList", "[", 
              RowBox[{"[", "$selectedMonodromyIndex", "]"}], "]"}], "]"}]}], 
           "}"}], "]"}]}], "}"}], ",", 
       RowBox[{"Alignment", "->", "Center"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"baseSeries", "=", 
     RowBox[{"Plus", "@@", "reducedAnalyticTerms"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Cycle size: \>\"", ",", "$selectedBranchSize"}], "]"}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"seriesLength", "=", 
     RowBox[{"Length", "@", "baseSeries"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"theexp", "=", 
     RowBox[{"Exponent", "[", 
      RowBox[{"baseSeries", ",", "z", ",", "List"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lcm", "=", 
     RowBox[{"LCM", "@@", 
      RowBox[{"(", 
       RowBox[{"Denominator", "@", "theexp"}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"numVals", "=", 
     RowBox[{"lcm", " ", "theexp"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"clist", "=", 
     RowBox[{"Coefficient", "[", 
      RowBox[{"baseSeries", ",", "z", ",", "theexp"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"$analyticRootTestStartTerm", "<", "1"}], ",", 
