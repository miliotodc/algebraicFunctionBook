Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"generateMedialContour", "[", 
    RowBox[{
    "annulusTable_", ",", "annulus_", ",", "branchNum_", ",", "wpVal_", ",", 
     RowBox[{"altNorm_", ":", 
      RowBox[{"1", "/", "2"}]}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "cycleSize", ",", "zFun", ",", "tEnd", ",", "wDeriv", ",", "selected", 
       ",", "aIndex", ",", "sIndex", ",", "zStart", ",", 
       "$selectedMonodromyList", ",", "theRoots", ",", "tStart", ",", 
       "wStart", ",", "medialSol", ",", "rNorm", ",", "newRNorm", ",", 
       "theAnnulus"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"aIndex", ",", "sIndex"}], "}"}], "=", 
       RowBox[{"getSingTableIndexes", "[", 
        RowBox[{"annulusTable", ",", "annulus"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"$selectedMonodromyList", "=", 
       RowBox[{"annulusTable", "[", 
        RowBox[{"[", 
         RowBox[{"aIndex", ",", "6", ",", "branchNum"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"cycleSize", "=", 
       RowBox[{"Length", "@", "$selectedMonodromyList"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"theAnnulus", "=", 
       RowBox[{"annulusTable", "[", 
        RowBox[{"[", 
         RowBox[{"aIndex", ",", "3"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"rNorm", "=", 
       RowBox[{"annulusTable", "[", 
        RowBox[{"[", 
         RowBox[{"aIndex", ",", "4"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"altNorm", "!=", 
         RowBox[{"1", "/", "2"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"rNorm", "=", "altNorm"}], ";"}]}], "\[IndentingNewLine]", 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Setting rNorm: \>\"", ",", 
        RowBox[{"rNorm", "//", "N"}]}], "]"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"zFun", "[", "t_", "]"}], ":=", 
       RowBox[{"rNorm", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"I", " ", "t"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"zStart", "=", 
       RowBox[{"zFun", "[", " ", "$thetaV", "]"}]}], " ", ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"theRoots", "=", 
       RowBox[{"w", "/.", 
        RowBox[{"NSolve", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"implicitF", "[", 
            RowBox[{"zStart", ",", "w"}], "]"}], "\[Equal]", "0"}], ",", "w", 
          ",", 
          RowBox[{"WorkingPrecision", "->", "700"}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"wStart", "=", 
       RowBox[{"theRoots", "[", 
        RowBox[{"[", 
         RowBox[{"$selectedMonodromyList", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"tStart", "=", "$thetaV"}], ";", "\[IndentingNewLine]", 
      RowBox[{"tEnd", "=", " ", 
       RowBox[{"tStart", "+", 
        RowBox[{"2", " ", "Pi", " ", "cycleSize"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<tStart: \>\"", ",", 
        RowBox[{"tStart", "//", "N"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<tEnd: \>\"", ",", 
        RowBox[{"tEnd", "//", "N"}]}], "]"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"wDeriv", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"w", "'"}], "[", "t", "]"}], "\[Equal]", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"(", 
              FractionBox[
               RowBox[{"D", "[", 
                RowBox[{
                 RowBox[{"implicitF", "[", 
                  RowBox[{"z", ",", "w"}], "]"}], ",", "z"}], "]"}], 
               RowBox[{"D", "[", 
                RowBox[{
                 RowBox[{"implicitF", "[", 
                  RowBox[{"z", ",", "w"}], "]"}], ",", "w"}], "]"}]], ")"}]}],
             " ", 
            RowBox[{"(", 
             RowBox[{"D", "[", 
              RowBox[{
               RowBox[{"zFun", "[", "t", "]"}], ",", "t"}], "]"}], ")"}]}], 
           ")"}], "/.", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"w", "\[Rule]", 
             RowBox[{"w", "[", "t", "]"}]}], ",", 
            RowBox[{"z", "\[Rule]", 
             RowBox[{"zFun", "[", "t", "]"}]}]}], "}"}]}], ")"}]}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"medialSol", "=", 
       RowBox[{"NDSolveValue", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"wDeriv", ",", 
           RowBox[{
            RowBox[{"w", "[", "tStart", "]"}], "\[Equal]", "wStart"}]}], 
          "}"}], ",", "w", ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "tStart", ",", "tEnd"}], "}"}], ",", 
         RowBox[{"MaxSteps", "->", "20000000"}], ",", 
         RowBox[{"InterpolationOrder", "->", "All"}], ",", 
         RowBox[{"WorkingPrecision", "->", "wpVal"}], ",", 
         RowBox[{"MaxStepSize", "->", 
          RowBox[{"1", "/", "1000"}]}], ",", 
         RowBox[{"Method", "->", "\"\<StiffnessSwitching\>\""}]}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<medialSol: \>\"", ",", 
        RowBox[{
         RowBox[{"medialSol", "[", 
          RowBox[{"Pi", "/", "2"}], "]"}], "//", "N"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
       "tStart", ",", "tEnd", ",", "rNorm", ",", "medialSol", ",", 
        "cycleSize"}], "}"}]}]}], "\[IndentingNewLine]", 
    "\[IndentingNewLine]", "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
