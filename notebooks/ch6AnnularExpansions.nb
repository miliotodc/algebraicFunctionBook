    "contour"}], "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"rationalRNorm", "=", 
     RowBox[{"Rationalize", "[", 
      RowBox[{"rNorm", ",", 
       RowBox[{"10", "^", 
        RowBox[{"-", "25"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
