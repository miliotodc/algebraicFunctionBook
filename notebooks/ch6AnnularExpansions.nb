Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", "\[IndentingNewLine]", " ", 
   RowBox[{
   "generate", " ", "series", " ", "plot", " ", "with", " ", "orderIndex", 
    " ", "terms"}], "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"orderIndex", "=", "25"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"branchColors", "=", 
     RowBox[{"{", 
      RowBox[{
      "Red", ",", "Blue", ",", "Green", ",", "Yellow", ",", "Orange", ",", 
       "Purple", ",", "Brown", ",", "Magenta", ",", "Pink"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{
    "use", " ", "plotting", " ", "dimension", " ", "from", " ", 
     "differential", " ", "plot"}], "\[IndentingNewLine]", "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"plotDomain", "=", 
     RowBox[{"plottingRadiiTable", "[", 
      RowBox[{"[", "$selectedAnnulus", "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"rMin", "=", 
    RowBox[{
     RowBox[{"plotDomain", "[", 
      RowBox[{"[", "1", "]"}], "]"}], "//", "N"}]}], "\[IndentingNewLine]", 
   RowBox[{"rMax", "=", 
    RowBox[{
     RowBox[{"plotDomain", "[", 
      RowBox[{"[", 
       RowBox[{"-", "1"}], "]"}], "]"}], "//", "N"}]}], "\[IndentingNewLine]",
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"truncatedSeries", "[", "z_", "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"Plus", "@@", 
        RowBox[{"reducedPreciseAnalyticTerms", "[", 
         RowBox[{"[", 
          RowBox[{"1", ";;", 
           RowBox[{"reducedPreciseAnalyticOrderList", "[", 
            RowBox[{"[", 
             RowBox[{"orderIndex", ",", "2"}], "]"}], "]"}]}], "]"}], "]"}]}],
        ")"}], "+", 
      RowBox[{"(", 
       RowBox[{"Plus", "@@", 
        RowBox[{"reducedPreciseSingularTerms", "[", 
         RowBox[{"[", 
          RowBox[{"1", ";;", 
           RowBox[{"reducedPreciseSingularOrderList", "[", 
            RowBox[{"[", 
             RowBox[{"orderIndex", ",", "2"}], "]"}], "]"}]}], "]"}], "]"}]}],
        ")"}]}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{"theexp", "=", 
     RowBox[{"Exponent", "[", 
      RowBox[{
       RowBox[{"truncatedSeries", "[", "z", "]"}], ",", "z", ",", "List"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"theNum", "=", 
     RowBox[{"Numerator", "@", "theexp"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"clist", "=", 
     RowBox[{"Coefficient", "[", 
      RowBox[{
       RowBox[{"truncatedSeries", "[", "z", "]"}], ",", "z", ",", "theexp"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"branchSheetF", "[", 
      RowBox[{"z_", ",", "k_"}], "]"}], ":=", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"clist", "[", 
         RowBox[{"[", "n", "]"}], "]"}], " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"Exp", "[", 
           RowBox[{"2", " ", "k", " ", "\[Pi]", " ", 
            RowBox[{"\[ImaginaryI]", "/", "$selectedBranchSize"}]}], "]"}], 
          ")"}], "^", 
         RowBox[{"(", 
          RowBox[{"$selectedBranchSize", " ", 
           RowBox[{"theexp", "[", 
            RowBox[{"[", "n", "]"}], "]"}]}], ")"}]}], " ", 
        RowBox[{"z", "^", 
         RowBox[{"theexp", "[", 
          RowBox[{"[", "n", "]"}], "]"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "1", ",", 
         RowBox[{"Length", "[", "clist", "]"}]}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", " ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"imagSeriesPlots", "=", 
      RowBox[{"Table", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"ParametricPlot3D", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Re", "@", "z"}], ",", 
             RowBox[{"Im", "@", "z"}], ",", 
             RowBox[{"Im", "@", 
              RowBox[{"branchSheetF", "[", 
               RowBox[{"z", ",", "sheetIndex"}], "]"}]}]}], "}"}], "/.", 
           RowBox[{"z", "->", 
            RowBox[{"r", " ", 
             RowBox[{"Exp", "[", 
              RowBox[{"I", " ", "t"}], "]"}]}]}]}], ",", 
          RowBox[{"{", 
           RowBox[{"r", ",", "rMin", ",", "rMax"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", 
            RowBox[{"-", "Pi"}], ",", "Pi"}], "}"}], ",", 
          RowBox[{"PlotStyle", "->", 
           RowBox[{"branchColors", "[", 
            RowBox[{"[", 
             RowBox[{"sheetIndex", "+", "1"}], "]"}], "]"}]}], ",", 
          RowBox[{"BoxRatios", "->", 
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "1", ",", " ", "2"}], "}"}]}], ",", 
          RowBox[{"PlotRange", "->", 
           RowBox[{"PlotRange", "[", "theDifferentialBranchPlot", "]"}]}]}], 
         "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"sheetIndex", ",", "0", ",", 
          RowBox[{"$selectedBranchSize", "-", "1"}]}], "}"}]}], 
       "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
    "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{"realSeriesPlots", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"ParametricPlot3D", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Re", "@", "z"}], ",", 
            RowBox[{"Im", "@", "z"}], ",", 
            RowBox[{"Re", "@", 
             RowBox[{"branchSheetF", "[", 
              RowBox[{"z", ",", "sheetIndex"}], "]"}]}]}], "}"}], "/.", 
          RowBox[{"z", "->", 
           RowBox[{"r", " ", 
            RowBox[{"Exp", "[", 
             RowBox[{"I", " ", "t"}], "]"}]}]}]}], ",", 
         RowBox[{"{", 
          RowBox[{"r", ",", "rMin", ",", "rMax"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", 
           RowBox[{"-", "Pi"}], ",", "Pi"}], "}"}], ",", 
         RowBox[{"PlotStyle", "->", 
          RowBox[{"branchColors", "[", 
           RowBox[{"[", 
            RowBox[{"sheetIndex", "+", "1"}], "]"}], "]"}]}], ",", 
         RowBox[{"BoxRatios", "->", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "1", ",", " ", "1"}], "}"}]}], ",", 
         RowBox[{"PlotRange", "->", 
          RowBox[{"PlotRange", "[", "realDifferentialBranchPlot", "]"}]}]}], 
        "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"sheetIndex", ",", "0", ",", 
         RowBox[{"$selectedBranchSize", "-", "1"}]}], "}"}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.982136861274151*^9, 3.982136862398742*^9}, {
