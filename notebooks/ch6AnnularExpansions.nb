Cell["Section 14.1:  Create low-precision medial contour", "Subsection",
 CellChangeTimes->{{3.9422257955026445`*^9, 3.942225812108554*^9}, {
  3.942229002659419*^9, 3.942229010548378*^9}, {3.9422296995652037`*^9, 
  3.9422297014399757`*^9}, {3.9550227028019*^9, 3.9550227100149755`*^9}, {
  3.982078887039127*^9, 3.9820788897701197`*^9}, {3.9889839698120623`*^9, 
  3.9889839966082478`*^9}, {3.98904651925528*^9, 
  3.9890465220660276`*^9}},ExpressionUUID->"e0528883-0bbd-44bd-82cd-\
2225a22eb5f4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
   "set", " ", "up", " ", "low", " ", "precision", " ", "medial", " ", 
    "contour"}], "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"rationalRNorm", "=", 
     RowBox[{"Rationalize", "[", 
      RowBox[{"rNorm", ",", 
       RowBox[{"10", "^", 
        RowBox[{"-", "25"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"at", "=", 
     RowBox[{"AbsoluteTiming", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "tStart", ",", "tEnd", ",", "rNorm", ",", "lowPrecMedialSol", ",", 
          "$selectedBranchSize"}], "}"}], "=", 
        RowBox[{"generateMedialContour", "[", 
         RowBox[{
         "annulusTable", ",", "$selectedAnnulus", ",", 
          "$selectedMonodromyIndex", ",", "25", ",", 
          RowBox[{"1", "/", "2"}]}], "]"}]}], ";"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<total time: \>\"", ",", 
      RowBox[{"at", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.942224136188385*^9, 3.942224136641393*^9}, {
