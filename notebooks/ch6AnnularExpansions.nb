Cell[CellGroupData[{

Cell["\<\
Section 10.5:  Generate reducedPreciseSingularTerms and order list\
\>", "Subsection",
 CellChangeTimes->{{3.9404288039573975`*^9, 3.9404288134551525`*^9}, {
  3.942241633817031*^9, 3.942241650297538*^9}, {3.94224172426434*^9, 
  3.9422417277635107`*^9}, {3.942400531631428*^9, 3.9424005319909105`*^9}, {
  3.9424007798361173`*^9, 3.9424007804453335`*^9}, {3.9443796774200506`*^9, 
  3.944379698270784*^9}, {3.955114621984562*^9, 3.9551146235107193`*^9}, {
  3.981122298998704*^9, 
  3.9811222992720313`*^9}},ExpressionUUID->"1c6c4883-af01-4b3e-9cf3-\
adbb038f57dd"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"arrayTerms", "=", " ", 
  RowBox[{
   RowBox[{"precisionSingularArray", "[", 
    RowBox[{"[", 
     RowBox[{
      RowBox[{"1", ";;", "10"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "2"}], "}"}]}], "]"}], "]"}], "//", 
   "N"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"reducedPreciseSingularTerms", "=", 
   RowBox[{"Table", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"sum", "=", "0"}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"singularResidueArray", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "3", ",", "1"}], "]"}], "]"}], "==", "1"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"sum", "+=", 
          RowBox[{"Re", "@", 
           RowBox[{"precisionSingularArray", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "2"}], "]"}], "]"}]}]}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"singularResidueArray", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "3", ",", "2"}], "]"}], "]"}], "==", "1"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"sum", "+=", 
          RowBox[{
           RowBox[{"Im", "@", 
            RowBox[{"precisionSingularArray", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "2"}], "]"}], "]"}]}], " ", "I"}]}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"sum", " ", 
       RowBox[{"z", "^", 
        RowBox[{"precisionSingularArray", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "1"}], "]"}], "]"}]}]}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{"Length", "@", "precisionSingularArray"}]}], "}"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"\"\<reducedPreciseSingularTerms[[1;;10]]: \>\"", ",", 
     RowBox[{
      RowBox[{"reducedPreciseSingularTerms", "[", 
       RowBox[{"[", 
        RowBox[{"1", ";;", "22"}], "]"}], "]"}], "//", "N"}]}], "]"}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", "\[IndentingNewLine]", " ", 
   RowBox[{"create", " ", "reducedPreciseSingularOrderList"}], 
   "\[IndentingNewLine]", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"deleteLen", "=", 
  RowBox[{
  "Length", "@", "reducedPreciseSingularTerms"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"deleteLen", ">", "0"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"theExps", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         RowBox[{"Exponent", "[", 
          RowBox[{"#", ",", "z"}], "]"}]}], "&"}], "/@", " ", 
       "reducedPreciseSingularTerms"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"maxExp", "=", 
      RowBox[{"Floor", "@", 
       RowBox[{"Max", "@", "theExps"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<maxExp: \>\"", ",", "maxExp"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"nearElements", "=", 
      RowBox[{"Nearest", "[", 
       RowBox[{"theExps", ",", 
        RowBox[{"Range", "[", "maxExp", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"uniqueVals", "=", 
      RowBox[{"nearElements", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", "\"\<test\>\"", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"newOrderList", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"Position", "[", 
           RowBox[{"theExps", ",", 
            RowBox[{"x_", "/;", 
             RowBox[{"x", "==", "#"}]}]}], "]"}], "&"}], "/@", "uniqueVals"}],
         ")"}], "//", "Flatten"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"reducedPreciseSingularOrderList", "=", 
      RowBox[{"MapThread", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"#1", ",", "#2"}], "}"}], "&"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Range", "[", "maxExp", "]"}], ",", "newOrderList"}], 
         "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{
      "\"\<preciseSingularOrderIndexList: \>\"", ",", 
       "reducedPreciseSingularOrderList"}], "]"}], ";"}], 
    "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"reducedPreciseSingularOrderList", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"Style", "[", 
       RowBox[{"\"\<All analytic terms are zero!\>\"", ",", "Red"}], "]"}], 
      "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Highest order singular term: \>\"", ",", 
     RowBox[{"reducedPreciseSingularOrderList", "[", 
      RowBox[{"[", 
       RowBox[{"-", "1"}], "]"}], "]"}]}], "]"}], ";"}], 
  "\[IndentingNewLine]", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.944146684492487*^9, 3.9441467144229293`*^9}, {
   3.9441467607086887`*^9, 3.944146761333688*^9}, {3.944382612498913*^9, 
   3.9443826241474485`*^9}, 3.944388815235041*^9, {3.9550970463902545`*^9, 
   3.955097051391423*^9}, {3.9550975137913313`*^9, 3.9550976090884056`*^9}, {
   3.955100403555751*^9, 3.955100426812235*^9}, {3.955449316662554*^9, 
