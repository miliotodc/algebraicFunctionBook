Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"convertToChar", "[", "num_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"sTest", ",", "s1", ",", "newS", ",", "newS2"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"sTest", "=", 
       RowBox[{"ToString", "@", 
        RowBox[{"AccountingForm", "@", "num"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"s1", "=", 
       RowBox[{"StringTake", "[", 
        RowBox[{"sTest", ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"s1", "==", "\"\<(\>\""}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"newS", "=", 
          RowBox[{"StringReplacePart", "[", 
           RowBox[{"sTest", ",", "\"\<-\>\"", ",", 
            RowBox[{"{", 
             RowBox[{"1", ",", "1"}], "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"newS2", "=", 
          RowBox[{"StringDrop", "[", 
