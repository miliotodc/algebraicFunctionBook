Cell["\<\
Section 12.3:  Check final series at a point about midway in annular domain\
\>", "Subsection",
 CellChangeTimes->{{3.9864766884391036`*^9, 
  3.986476715299911*^9}},ExpressionUUID->"615bc9ff-67c4-4450-b5c3-\
0d17a89f1a70"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{
    "test", " ", "series", " ", "with", " ", "a", " ", "random", " ", "point",
      " ", "in", " ", "the", " ", "annular", " ", "domain", " ", "and", " ", 
     "compare", " ", "to", " ", "NSolve", " ", 
     RowBox[{"values", ".", "  ", "One"}], " ", "of", " ", "the", " ", 
     "NSolve", " ", "values", " ", "should", " ", "be", " ", "close", " ", 
     "to", " ", "the", " ", "series", " ", "value", " ", "with", " ", "the", 
     " ", "actual", " ", "difference", " ", "dependent", " ", "on", " ", 
     "the", " ", "number", " ", "of", " ", "terms", " ", "used"}], ",", " ", 
    RowBox[{"the", " ", "precision", " ", "of", " ", "the", " ", "series"}], 
    ",", " ", 
    RowBox[{
    "and", " ", "how", " ", "close", " ", "the", " ", "selected", " ", 
     "value", " ", "of", " ", "z", " ", "is", " ", "to", " ", "the", " ", 
     "annular", " ", 
     RowBox[{"boundaries", ".", "  ", "An"}], " ", "acceptable", " ", "value",
      " ", "is", " ", "at", " ", "least", " ", 
     RowBox[{"10", "^", 
      RowBox[{"-", "8"}]}], " ", "error", " ", "between", " ", "the", " ", 
     "NSolve", " ", "value", " ", "and", " ", "the", " ", "series", " ", 
     RowBox[{"value", "."}]}]}], "\[IndentingNewLine]", "*)"}], 
  "\[IndentingNewLine]", " ", 
  RowBox[{
   RowBox[{"theAnnulus", "//", "N"}], " ", "\[IndentingNewLine]", 
   RowBox[{"theZ", "=", 
    RowBox[{"Rationalize", "[", 
     RowBox[{
      RowBox[{"Mean", "[", "theAnnulus", "]"}], ",", 
      RowBox[{"10", "^", 
       RowBox[{"-", "25"}]}]}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{"sVal", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"seriesTable", "[", 
       RowBox[{"[", 
        RowBox[{"-", "1"}], "]"}], "]"}], "/.", 
      RowBox[{"z", "->", "theZ"}]}], "//", "N"}]}], "\[IndentingNewLine]", 
   RowBox[{"wVals", "=", 
    RowBox[{"NSolveValues", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"$theFunction", "==", "0"}], "/.", 
       RowBox[{"z", "->", "theZ"}]}], ",", "w", ",", 
      RowBox[{"WorkingPrecision", "->", "25"}]}], "]"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{"difTable", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"sVal", "-", "#"}], "]"}], "&"}], "/@", " ", "wVals"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{"pos", "=", 
    RowBox[{
     RowBox[{"Position", "[", 
      RowBox[{"difTable", ",", 
       RowBox[{"Min", "@", "difTable"}]}], "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"1", ",", "1"}], "]"}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Error: \>\"", ",", 
     RowBox[{"difTable", "[", 
      RowBox[{"[", "pos", "]"}], "]"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9863883368921137`*^9, 3.9863883612089524`*^9}, {
  3.986476399794856*^9, 3.986476434495488*^9}, {3.986476561437908*^9, 
