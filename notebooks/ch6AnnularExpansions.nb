                 ";"}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"branchValues", "=", 
                  RowBox[{"Append", "[", 
                   RowBox[{"branchValues", ",", 
                    RowBox[{"{", 
                    RowBox[{"wstartDigits", ",", 
                    RowBox[{"theBaseValueDigits", "[", 
                    RowBox[{"[", 
                    RowBox[{"loopPos", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "1"}], "]"}], "]"}], "]"}], "]"}]}], 
                    "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
                 RowBox[{"posFoundFlag", "=", "True"}], ";"}]}], 
               "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"posFoundFlag", "\[Equal]", "False"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
              "Print", "[", 
               "\"\<Position not found at end of 10 attempts at increasing \
precision.\>\"", "]"}], ";", "\[IndentingNewLine]", 
              RowBox[{"Abort", "[", "]"}], ";"}]}], "\[IndentingNewLine]", 
            "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
         "branchValues", ",", "saveBaseDigits", ",", "savePoleValues"}], 
