Cell[CellGroupData[{

Cell["Root Test of singular terms for lower limit of convergence", \
"Subsection",
 CellChangeTimes->{{3.963141921659663*^9, 
  3.9631419354545145`*^9}},ExpressionUUID->"49ae5b9a-7d79-4f70-8b34-\
a9b40521ba8d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"zeroPos", "=", " ", 
   RowBox[{
    RowBox[{"Position", "[", 
     RowBox[{
      RowBox[{"alphaSeriesSet", "[", 
       RowBox[{"[", 
        RowBox[{"branchIndex", ",", "2", ",", "All", ",", "1"}], "]"}], "]"}],
       ",", "0"}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"1", ",", "1"}], "]"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9865552822047715`*^9, 3.986555283246541*^9}},
 CellLabel->
  "In[649]:=",ExpressionUUID->"5b4ab201-cf78-42da-8181-4a5ba3b9e315"],

Cell[BoxData["101"], "Output",
 CellChangeTimes->{3.986555285684162*^9},
 CellLabel->
  "Out[649]=",ExpressionUUID->"b901bc2a-0dbd-4b62-8c89-e5a5f1431afb"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"singularSeries", "=", " ", 
   RowBox[{"Plus", "@@", 
    RowBox[{"alphaSeriesSet", "[", 
     RowBox[{"[", 
      RowBox[{"branchIndex", ",", "2", ",", 
       RowBox[{"1", ";;", 
        RowBox[{"(", 
         RowBox[{"zeroPos", "-", "5"}], ")"}]}], ",", "4"}], "]"}], "]"}]}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"singularTerms", "=", 
   RowBox[{"alphaSeriesSet", "[", 
    RowBox[{"[", 
     RowBox[{"branchIndex", ",", "2", ",", 
      RowBox[{"1", ";;", "100"}], ",", "4"}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"singularSeries", "[", 
   RowBox[{"[", 
    RowBox[{"1", ";;", "5"}], "]"}], "]"}], "//", 
  "N"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"cycleSize", "=", 
    RowBox[{"Length", "@", 
     RowBox[{"alphaMonodromyList", "[", 
      RowBox[{"[", "branchIndex", "]"}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"\"\<branch: \>\"", ",", 
     RowBox[{"alphaMonodromyList", "[", 
      RowBox[{"[", "branchIndex", "]"}], "]"}]}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"seriesLength", "=", 
   RowBox[{"Length", "@", "singularSeries"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"theexp", "=", 
   RowBox[{"Exponent", "[", 
    RowBox[{"singularSeries", ",", "z", ",", "List"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"theexp", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Exponent", "[", 
      RowBox[{"#", ",", "z"}], "]"}], "&"}], "/@", " ", "singularTerms"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lcm", "=", 
   RowBox[{"LCM", "@@", 
    RowBox[{"(", 
     RowBox[{"Denominator", "@", "theexp"}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"numVals", "=", 
   RowBox[{"lcm", " ", "theexp"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"clist", "=", 
    RowBox[{"MapThread", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Coefficient", "[", 
        RowBox[{"#1", ",", "z", ",", "#2"}], "]"}], "&"}], ",", 
      RowBox[{"{", 
       RowBox[{"singularTerms", ",", "theexp"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"cTable", "=", 
    RowBox[{"Reverse", "@", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "/", 
          RowBox[{"numVals", "[", 
           RowBox[{"[", "k", "]"}], "]"}]}], ",", 
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{"1", "/", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{"clist", "[", 
                RowBox[{"[", "k", "]"}], "]"}], "]"}], "^", 
              RowBox[{"(", 
               RowBox[{"cycleSize", "/", 
                RowBox[{"numVals", "[", 
                 RowBox[{"[", "k", "]"}], "]"}]}], ")"}]}], ")"}]}], ",", 
           "25"}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"k", ",", "5", ",", 
         RowBox[{"Length", "@", "clist"}]}], "}"}]}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<cTable Len: \>\"", ",", 
      RowBox[{"Length", "@", "cTable"}]}], "]"}], ";"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"singularLp1", "=", 
    RowBox[{"ListPlot", "[", 
     RowBox[{"cTable", ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"{", 
        RowBox[{"PointSize", "[", "0.01", "]"}], "}"}]}], ",", 
      RowBox[{"AxesOrigin", "->", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}]}], ",", 
      RowBox[{"Frame", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
