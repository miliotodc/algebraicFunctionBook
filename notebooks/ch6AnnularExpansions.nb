Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"FileExistsQ", "[", 
      RowBox[{"medialTableFileName", "[", 
       RowBox[{
       "$theTestCase", ",", "$selectedAnnulus", ",", "$selectedBranch"}], 
       "]"}], "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Importing multimedial file \>\"", ",", 
        RowBox[{"medialTableFileName", "[", 
         RowBox[{
         "$theTestCase", ",", "$selectedAnnulus", ",", "$selectedBranch"}], 
         "]"}]}], "]"}], ";", "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{"AbsoluteTiming", "[", 
        RowBox[{
