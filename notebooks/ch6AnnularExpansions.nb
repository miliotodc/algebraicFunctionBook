            SqrtBox[
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{
                SuperscriptBox["z", "2"], "+", 
                RowBox[{"(", 
                 RowBox[{"1", "+", "\[ImaginaryI]"}], ")"}]}], ")"}], "2"]], 
            " ", 
