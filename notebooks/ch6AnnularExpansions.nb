Cell[CellGroupData[{

Cell["getSingularMonodromy", "Subsection",
 CellChangeTimes->{{3.9292797409201126`*^9, 
  3.9292797439821234`*^9}},ExpressionUUID->"474e532a-5b12-48fa-8a00-\
16dacb33e427"],

Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
   "get", " ", "differential", " ", "monodromy", " ", "around", " ", "a", " ",
     "singular", " ", "point"}], "\[IndentingNewLine]", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Options", "[", "getSingularMonodromy", "]"}], "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<nSolveWP\>\"", "->", "50"}], ",", 
       RowBox[{"\"\<integrateWP\>\"", "->", "50"}], ",", 
       RowBox[{"\"\<polishWP\>\"", "->", "20"}], ",", 
       RowBox[{"\"\<diagFlag\>\"", "->", "False"}], ",", 
       RowBox[{"\"\<stiffFlag\>\"", "->", "False"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"getSingularMonodromy", "[", 
     RowBox[{"theSingularIndex_", ",", "rNorm_", ",", 
      RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "z0", ",", "singularRoots", ",", "wArray", ",", "branchVals", ",", 
        "polishedVals", ",", "pArray", ",", "theCycles", ",", "theLinks", ",",
         "oneCycles", ",", "finalCycles", ",", "flag", ",", 
        "theSingularPoint"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{"\"\<nSolveWP: \>\"", ",", 
          RowBox[{"OptionValue", "[", "\"\<nSolveWP\>\"", "]"}]}], "]"}], 
        ";"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"theSingularPoint", "=", 
        RowBox[{"$theSingularList", "[", 
         RowBox[{"[", "theSingularIndex", "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"z0", "=", 
        RowBox[{"theSingularPoint", "+", 
         RowBox[{"rNorm", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"I", " ", "$thetaV"}], "]"}]}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"\"\<z0: \>\"", ",", 
           RowBox[{"z0", "//", "N"}]}], "]"}], ";"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"singularRoots", "=", 
        RowBox[{"Sort", "[", 
         RowBox[{"w", "/.", 
          RowBox[{"NSolve", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"$theFunction", "==", "0"}], "/.", 
             RowBox[{"z", "->", "z0"}]}], ",", "w", ",", 
            RowBox[{"WorkingPrecision", "->", 
             RowBox[{"OptionValue", "[", "\"\<nSolveWP\>\"", "]"}]}]}], 
           "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"wArray", "=", 
        RowBox[{"MapThread", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"#1", ",", "#2"}], "}"}], "&"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Range", "[", 
             RowBox[{"Length", "@", "singularRoots"}], "]"}], ",", 
            "singularRoots"}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", " ", 
       RowBox[{"branchVals", "=", 
        RowBox[{"integrateOverSheet", "[", 
         RowBox[{
         "z0", ",", "theSingularPoint", ",", "$thetaV", ",", "wArray", ",", 
          "rNorm", ",", 
          RowBox[{"OptionValue", "[", "\"\<stiffFlag\>\"", "]"}], ",", 
          RowBox[{"OptionValue", "[", "\"\<integrateWP\>\"", "]"}]}], "]"}]}],
        ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"polishedVals", "=", 
        RowBox[{"polishBranchTerms", "[", 
         RowBox[{"z0", ",", "branchVals", ",", 
          RowBox[{"OptionValue", "[", "\"\<polishWP\>\"", "]"}]}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"OptionValue", "[", "\"\<diagFlag\>\"", "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"\"\<     polishedVals: \>\"", ",", 
            RowBox[{
             RowBox[{"polishedVals", "//", "N"}], "//", "MatrixForm"}]}], 
           "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"pArray", "=", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Position", "[", 
            RowBox[{
             RowBox[{"polishedVals", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
             RowBox[{"x_", "/;", 
              RowBox[{
               RowBox[{"Abs", "[", 
                RowBox[{"x", "-", "#"}], "]"}], "<", 
               RowBox[{"10", "^", 
                RowBox[{"-", "20"}]}]}]}]}], "]"}], "&"}], "/@", " ", 
          RowBox[{"polishedVals", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "3"}], "]"}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"theCycles", "=", 
        RowBox[{"PermutationCycles", "[", "pArray", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"theLinks", "=", 
        RowBox[{"theCycles", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"oneCycles", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"{", "#", "}"}], "&"}], "/@", 
         RowBox[{"Complement", "[", 
          RowBox[{
           RowBox[{"Range", "[", "functionDegree", "]"}], ",", 
           RowBox[{"Flatten", "[", "theLinks", "]"}]}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"finalCycles", "=", 
        RowBox[{"Join", "[", 
         RowBox[{"theLinks", ",", "oneCycles"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<     finalCycles: \>\"", ",", "finalCycles"}], "]"}], 
       ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Sort", "[", 
           RowBox[{"Flatten", "@", "finalCycles"}], "]"}], "!=", 
          RowBox[{"Range", "[", 
           RowBox[{"Length", "@", 
            RowBox[{"Flatten", "@", "finalCycles"}]}], "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"Style", "[", 
             RowBox[{"\"\<Monodromy is not consistent!\>\"", ",", "Red"}], 
             "]"}], "]"}], ";"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"flag", "=", "False"}], ";"}], "\[IndentingNewLine]", ",", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"Style", "[", "\"\<Monodromy is consistent\>\"", "]"}], 
            "]"}], ";"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"flag", "=", "True"}], ";"}]}], "\[IndentingNewLine]", 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"finalCycles", ",", "polishedVals", ",", 
         RowBox[{"{", 
          RowBox[{"theSingularIndex", ",", "flag"}], "}"}]}], "}"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.9937359901686115`*^9, 3.993736111291679*^9}, {
   3.9937385206995554`*^9, 3.99373852198433*^9}, {3.9938025163354254`*^9, 
   3.9938025323808675`*^9}, 3.9938144891474895`*^9, {3.9938146711096883`*^9, 
   3.993814676608876*^9}, {3.993817067081568*^9, 3.9938170698266463`*^9}},
 CellLabel->
  "In[149]:=",ExpressionUUID->"fcb02295-ff7e-4445-b6b6-0abfd3e4298a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["getAnnularTemplate", "Subsection",
 CellChangeTimes->{{3.941905389118188*^9, 
  3.941905392195545*^9}},ExpressionUUID->"59890562-a0eb-44bb-99fc-\
8e51fedffed8"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"getAnnularTemplate", "[", "theFunction_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "res", ",", "theSingularSet", ",", "singAccuracy", ",", 
         "theSingularList", ",", "argList", ",", "zeroIndexes", ",", 
         "poleIndexes", ",", "nearestSing", ",", "nearestDist", ",", 
         "minRadiusArray", ",", "singularPerimeters", ",", "absVals", ",", 
         "ringSize", ",", "tempRings", ",", "theAnnuli", ",", 
         "ringMemberSingularIndexes", ",", "radiiTable", ",", "annularSizes", 
         ",", "annularCenters", ",", "singTable", ",", "annulusTable", ",", 
         "annulusTableR", ",", "ringSizes", ",", "minRingSize", ",", 
         "tableIndex", ",", "j", ",", "annulusTableReport", ",", 
         "singTableAnnulusIndexes", ",", "plottingRadiiTable", ",", 
         "newTable", ",", "theReturn", ",", "singTableSingIndexes", ",", 
         "i"}], " ", "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]",
        "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"totalIntegrationSteps", "=", "1500000"}], ";"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"maxStepSize", "=", "0.0001"}], ";"}], "*)"}], 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"ringDelta", "=", 
          RowBox[{"1", "/", "20000"}]}], ";"}], "*)"}], " ", 
       RowBox[{"(*", " ", 
        RowBox[{"ring", " ", "separation", " ", "threshold"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"minRingSize", "=", 
         RowBox[{"1", "/", "2000"}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"res", "=", 
         RowBox[{"Resultant", "[", 
          RowBox[{"theFunction", ",", 
           RowBox[{"D", "[", 
            RowBox[{"theFunction", ",", "w"}], "]"}], ",", "w"}], "]"}]}], 
        ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"theSingularSet", "=", 
         RowBox[{"Sort", "[", 
          RowBox[{
           RowBox[{"z", "/.", 
            RowBox[{"NSolve", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Simplify", "@", "res"}], "\[Equal]", "0"}], ",", "z", 
              ",", 
              RowBox[{"WorkingPrecision", "\[Rule]", "$workingPrecision"}]}], 
             "]"}]}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "@", "#1"}], "<=", " ", 
             RowBox[{"Abs", "@", "#2"}]}], "&"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"singAccuracy", "=", 
         RowBox[{"Floor", "@", 
          RowBox[{"Accuracy", "@", "theSingularSet"}]}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", "\[IndentingNewLine]", " ", 
         RowBox[{
         "final", " ", "form", " ", "of", " ", "the", " ", "singular", " ", 
          "list"}], "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"theSingularList", "=", 
         RowBox[{"DeleteDuplicates", "[", 
          RowBox[{"theSingularSet", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"#1", "-", "#2"}], "]"}], "<", 
             RowBox[{"10", "^", 
              RowBox[{"-", 
               RowBox[{"(", 
                RowBox[{"singAccuracy", "-", "$accuracyComparisonFactor"}], 
                ")"}]}]}]}], "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", "\[IndentingNewLine]", " ", 
         RowBox[{
          RowBox[{
          "get", " ", "arguments", " ", "of", " ", "singular", " ", "points", 
           " ", "argList"}], ",", "zeroIndexes", ",", "poleIndexes", ",", 
          "nearestSing", ",", "nearestDist"}], "\[IndentingNewLine]", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"argList", "=", 
         RowBox[{"Arg", "@", "theSingularList"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", "\[IndentingNewLine]", " ", 
         RowBox[{
          RowBox[{
          "now", " ", "get", " ", "zero", " ", "points", " ", "a_", "0", 
           RowBox[{"(", "z", ")"}]}], "=", 
          RowBox[{
           RowBox[{"0", " ", "when", " ", "either", " ", "$a_", "1", 
            RowBox[{"(", "z", ")"}]}], "=", 
           RowBox[{
            RowBox[{"0", " ", "or", " ", "$a_", "0"}], "=", 
            RowBox[{"a_", "1"}]}]}]}], "\[IndentingNewLine]", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"zeroIndexes", "=", 
         RowBox[{"getZeroIndexes", "[", 
          RowBox[{"theFunction", ",", "theSingularList", ",", "False"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", "\[IndentingNewLine]", 
         RowBox[{"get", " ", "poles"}], " ", "\[IndentingNewLine]", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"poleIndexes", "=", 
         RowBox[{"getPoles", "[", 
          RowBox[{"theFunction", ",", "theSingularList", ",", "False"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<poleIndexes: \>\"", ",", "poleIndexes"}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", "\[IndentingNewLine]", " ", 
         RowBox[{
          RowBox[{
