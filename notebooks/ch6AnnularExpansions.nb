e63f6173d9fa"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{"import", " ", "precise", " ", "analytic", " ", "data"}], 
   "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"FileExistsQ", "[", 
       RowBox[{"reducedPreciseAnalyticTermsFileName", "[", 
        RowBox[{
        "$theTestCase", ",", "$selectedAnnulus", ",", "$selectedBranch"}], 
        "]"}], "]"}], ",", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Import reduced precise analytic terms to \>\"", ",", 
         RowBox[{"reducedPreciseAnalyticTermsFileName", "[", 
          RowBox[{
          "$theTestCase", ",", "$selectedAnnulus", ",", "$selectedBranch"}], 
          "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "reducedPreciseAnalyticTerms", ",", 
          "reducedPreciseAnalyticOrderList"}], "}"}], "=", 
        RowBox[{"Import", "[", 
         RowBox[{"reducedPreciseAnalyticTermsFileName", "[", 
          RowBox[{
          "$theTestCase", ",", "$selectedAnnulus", ",", "$selectedBranch"}], 
          "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Size: \>\"", ",", 
         RowBox[{"Length", "@", "reducedPreciseAnalyticTerms"}]}], "]"}], 
       ";"}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"reducedPreciseAnalyticTermsFileName", "[", 
            RowBox[{
            "$theTestCase", ",", "$selectedAnnulus", ",", "$selectedBranch"}],
             "]"}], "<>", "\"\< not found during import.\>\""}], ",", "Red"}],
          "]"}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{"import", " ", "precise", " ", "singular", " ", "data"}], 
    "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"FileExistsQ", "[", 
       RowBox[{"reducedPreciseSingularTermsFileName", "[", 
        RowBox[{
        "$theTestCase", ",", "$selectedAnnulus", ",", "$selectedBranch"}], 
        "]"}], "]"}], ",", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Import reduced precise analytic terms to \>\"", ",", 
         RowBox[{"reducedPreciseSingularTermsFileName", "[", 
          RowBox[{
          "$theTestCase", ",", "$selectedAnnulus", ",", "$selectedBranch"}], 
          "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "reducedPreciseSingularTerms", ",", 
          "reducedPreciseSingularOrderList"}], "}"}], "=", 
        RowBox[{"Import", "[", 
         RowBox[{"reducedPreciseSingularTermsFileName", "[", 
          RowBox[{
          "$theTestCase", ",", "$selectedAnnulus", ",", "$selectedBranch"}], 
          "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Size: \>\"", ",", 
         RowBox[{"Length", "@", "reducedPreciseSingularTerms"}]}], "]"}], 
       ";"}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"reducedPreciseSingularTermsFileName", "[", 
            RowBox[{
            "$theTestCase", ",", "$selectedAnnulus", ",", "$selectedBranch"}],
             "]"}], "<>", "\"\< not found during import.\>\""}], ",", "Red"}],
          "]"}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], 
