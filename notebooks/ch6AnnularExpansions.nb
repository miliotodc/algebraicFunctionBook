Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"reducedSingularTerms", "=", 
     RowBox[{"DeleteCases", "[", 
      RowBox[{
       RowBox[{"updatedSingularData", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", 
          RowBox[{"-", "1"}]}], "]"}], "]"}], ",", "0"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"singularResidueArray", "=", " ", 
     RowBox[{"Cases", "[", 
      RowBox[{"singularCodeArray", ",", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x_", ",", "y_", ",", "z_"}], "}"}], "/;", 
        RowBox[{"z", "!=", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0"}], "}"}]}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<singularResidueArray: \>\"", ",", "singularResidueArray"}], 
     "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{
     RowBox[{
     "singularSequenceFunction", " ", "not", " ", "currently", " ", "used"}], 
     ",", " ", 
     RowBox[{"set", " ", "to", " ", "zero"}]}], " ", "\[IndentingNewLine]", 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"singularSequenceFunction", "=", 
     RowBox[{"FindSequenceFunction", "[", 
      RowBox[{
       RowBox[{"singularResidueArray", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "2"}], "]"}], "]"}], " ", 
       "$selectedBranchSize"}], "]"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"singularSequenceFunction", "=", "0"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{
    "use", " ", "raw", " ", "analytic", " ", "terms", " ", "of", " ", 
     "highest", " ", "precision"}], "\[IndentingNewLine]", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Precision", "@", "reducedSingularTerms"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"deleteLen", "=", 
    RowBox[{"Length", "@", "reducedSingularTerms"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"deleteLen", ">", "0"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"theExps", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           RowBox[{"Exponent", "[", 
            RowBox[{"#", ",", "z"}], "]"}]}], "&"}], "/@", " ", 
         "reducedSingularTerms"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"maxExp", "=", 
        RowBox[{"Floor", "@", 
         RowBox[{"Max", "@", "theExps"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"nearElements", "=", 
        RowBox[{"Nearest", "[", 
         RowBox[{"theExps", ",", 
          RowBox[{"Range", "[", "maxExp", "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"uniqueVals", "=", 
        RowBox[{"nearElements", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"newOrderList", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Position", "[", 
             RowBox[{"theExps", ",", 
              RowBox[{"x_", "/;", 
               RowBox[{"x", "==", "#"}]}]}], "]"}], "&"}], "/@", 
           "uniqueVals"}], ")"}], "//", "Flatten"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"singularOrderIndexList", "=", 
        RowBox[{"MapThread", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"#1", ",", "#2"}], "}"}], "&"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Range", "[", "maxExp", "]"}], ",", "newOrderList"}], 
           "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{
        "\"\<singularOrderIndexList: \>\"", ",", "singularOrderIndexList"}], 
        "]"}], ";"}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"singularOrderIndexList", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"Style", "[", 
         RowBox[{"\"\<All analytic terms are zero!\>\"", ",", "Red"}], "]"}], 
        "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Highest order analytic term: \>\"", ",", 
      RowBox[{"singularOrderIndexList", "[", 
       RowBox[{"[", 
        RowBox[{"-", "1"}], "]"}], "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Precision of deleted analytic terms: \>\"", ",", 
      RowBox[{"Precision", "@", "reducedSingularTerms"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Length", "@", "singularResidueArray"}]}]}]], "Input",
