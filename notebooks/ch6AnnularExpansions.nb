Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"(*", "\[IndentingNewLine]", "  ", 
   RowBox[{
   "now", " ", "update", " ", "grid", " ", "with", " ", "reduced", " ", 
    "terms"}], "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"analData", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"iVal", "==", "1"}], ",", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"residualAnalyticTerms", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "2", ",", "All", ",", "1"}], "]"}], "]"}], ",", 
           RowBox[{
            RowBox[{"residualAnalyticTerms", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "2", ",", "All", ",", "2"}], "]"}], "]"}], "//",
             "N"}]}], "}"}], "\[IndentingNewLine]", ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"residualAnalyticTerms", "[", 
           RowBox[{"[", 
            RowBox[{"iVal", ",", "2", ",", "All", ",", "2"}], "]"}], "]"}], "//",
           "N"}]}], "]"}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"iVal", ",", "1", ",", "totalMedialRuns"}], "}"}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{
    "now", " ", "append", " ", "reduced", " ", "terms", " ", "to", " ", 
     "data"}], "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<test\>\"", "]"}], ";"}], "\[IndentingNewLine]",
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"analErrorReport", "=", 
     RowBox[{"MapThread", "[", 
      RowBox[{"List", ",", 
       RowBox[{"FlattenAt", "[", 
        RowBox[{"analData", ",", "1"}], "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"updatedAnalyticData", "=", 
     RowBox[{"MapThread", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Append", "[", 
         RowBox[{"#1", ",", "#2"}], "]"}], "&"}], ",", 
       RowBox[{"{", 
        RowBox[{"analErrorReport", ",", 
         RowBox[{"reducedAnalCoefList", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2"}], "]"}], "]"}]}], "}"}]}], "]"}]}], ";"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"updatedAnalyticDataR", "=", 
     RowBox[{"MapThread", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Append", "[", 
         RowBox[{"#1", ",", "#2"}], "]"}], "&"}], ",", 
       RowBox[{"{", 
        RowBox[{"analErrorReport", ",", 
         RowBox[{
          RowBox[{"reducedAnalCoefList", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "2"}], "]"}], "]"}], "//", "N"}]}], "}"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"theHeading", "=", 
    RowBox[{"Flatten", "@", 
     RowBox[{"{", 
      RowBox[{"\"\<exp\>\"", ",", 
       RowBox[{
        RowBox[{"#1", "&"}], "/@", " ", 
        RowBox[{"precisionArray", "[", 
         RowBox[{"[", 
          RowBox[{"Range", "[", "totalMedialRuns", "]"}], "]"}], "]"}]}]}], 
      "}"}]}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"AppendTo", "[", 
     RowBox[{"theHeading", ",", "\"\<reformed Vals\>\""}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"theDisplay", "=", 
     RowBox[{"Style", "[", 
      RowBox[{
       RowBox[{"Grid", "[", 
        RowBox[{
         RowBox[{"Prepend", "[", 
          RowBox[{
           RowBox[{"updatedAnalyticDataR", "//", "N"}], ",", "theHeading"}], 
          "]"}], ",", 
         RowBox[{"Dividers", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"{", "True", "}"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"True", ",", "True", ",", 
              RowBox[{"{", "False", "}"}], ",", "True"}], "}"}]}], "}"}]}]}], 
        "]"}], ",", "8"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
