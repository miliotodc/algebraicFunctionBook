Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"(*", "\[IndentingNewLine]", "  ", 
   RowBox[{
   "now", " ", "update", " ", "grid", " ", "with", " ", "reduced", " ", 
    "terms"}], "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"reportFlag", "=", "False"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"singData", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"iVal", "==", "1"}], ",", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"residualSingularTerms", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "2", ",", "All", ",", "1"}], "]"}], "]"}], ",", 
           RowBox[{
            RowBox[{"residualSingularTerms", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "2", ",", "All", ",", "2"}], "]"}], "]"}], "//",
             "N"}]}], "}"}], "\[IndentingNewLine]", ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"residualSingularTerms", "[", 
           RowBox[{"[", 
            RowBox[{"iVal", ",", "2", ",", "All", ",", "2"}], "]"}], "]"}], "//",
           "N"}]}], "]"}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"iVal", ",", "1", ",", "totalMedialRuns"}], "}"}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{
    "now", " ", "append", " ", "reduced", " ", "terms", " ", "to", " ", 
     "data"}], "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<test\>\"", "]"}], ";"}], "\[IndentingNewLine]",
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"singErrorReport", "=", 
     RowBox[{"MapThread", "[", 
      RowBox[{"List", ",", 
       RowBox[{"FlattenAt", "[", 
        RowBox[{"singData", ",", "1"}], "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"updatedSingularData", "=", 
     RowBox[{"MapThread", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Append", "[", 
         RowBox[{"#1", ",", "#2"}], "]"}], "&"}], ",", 
       RowBox[{"{", 
        RowBox[{"singErrorReport", ",", 
         RowBox[{"reducedSingCoefList", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2"}], "]"}], "]"}]}], "}"}]}], "]"}]}], ";"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"updatedSingularDataR", "=", 
     RowBox[{"MapThread", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Append", "[", 
