Cell["Create reducedAnalCoefList", "Subsubsection",
 CellChangeTimes->{{3.955282890387867*^9, 
  3.9552828977334566`*^9}},ExpressionUUID->"74a6438a-9f3a-4898-abc7-\
864df816d1e0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{"second", " ", "version"}], "\[IndentingNewLine]", "*)"}], 
  "\[IndentingNewLine]", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"pureData", "=", 
     RowBox[{"MapThread", "[", 
      RowBox[{"List", ",", 
       RowBox[{"ReIm", "@", 
        RowBox[{"residualAnalyticTerms", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "4", ",", "All", ",", "2"}], "]"}], "]"}]}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Precision of highest precision pureData: \>\"", ",", 
      RowBox[{"Precision", "@", 
       RowBox[{"pureData", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", 
          RowBox[{"-", "1"}]}], "]"}], "]"}]}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pureExp", "=", 
     RowBox[{"residualAnalyticTerms", "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "4", ",", "All", ",", "1"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"reducedFlag1", "=", "False"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"imagZeroIndexes", "=", "0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"realZeroIndexes", "=", "0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"analyticCodeArray", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"reducedAnalCoefList", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"newDataList", "=", 
         RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"coeffCode", "=", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0"}], "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"testRun", "=", 
         RowBox[{"pureData", "[", 
          RowBox[{"[", "iVal", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"realTrend", "=", 
         RowBox[{"-", 
          RowBox[{
           RowBox[{"MantissaExponent", "[", 
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{"testRun", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", "1"}], "]"}], "]"}], "//", "N"}], "]"}], 
            "]"}], "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "2"}], ";;"}], ",", "2"}], "]"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"imagTrend", "=", 
         RowBox[{"-", 
          RowBox[{
           RowBox[{"MantissaExponent", "[", 
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{"testRun", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", "2"}], "]"}], "]"}], "//", "N"}], "]"}], 
            "]"}], "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "2"}], ";;"}], ",", "2"}], "]"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Differences", "@", "realTrend"}], "==", 
           RowBox[{"{", "0", "}"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"AppendTo", "[", 
            RowBox[{"newDataList", ",", 
             RowBox[{"testRun", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{"-", "1"}], ",", "1"}], "]"}], "]"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"coeffCode", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "=", "1"}], ";"}], 
          "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"realZeroIndexes", "++"}], ";", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{"reducedFlag1", ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Print", "[", 
               RowBox[{"Style", "[", 
                RowBox[{"\"\<real has differences\>\"", ",", "Red"}], "]"}], 
               "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]}], 
         "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Differences", "@", "imagTrend"}], "==", 
           RowBox[{"{", "0", "}"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"AppendTo", "[", 
            RowBox[{"newDataList", ",", 
             RowBox[{"I", " ", 
              RowBox[{"testRun", "[", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{"-", "1"}], ",", "2"}], "]"}], "]"}]}]}], "]"}], ";",
            "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"coeffCode", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "=", "1"}], ";"}], 
          "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"imagZeroIndexes", "++"}], ";", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{"reducedFlag1", ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Print", "[", 
               RowBox[{"Style", "[", 
                RowBox[{"\"\<imag has differences\>\"", ",", "Red"}], "]"}], 
               "]"}], ";"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
            "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", "\[IndentingNewLine]", " ", 
         RowBox[{"now", " ", "update", " ", "value", " ", "of", " ", "coef"}],
          "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "@", "newDataList"}], "==", "1"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"newValue", "=", 
            RowBox[{"newDataList", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
          ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Length", "@", "newDataList"}], "==", "2"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"newValue", "=", 
               RowBox[{"Plus", "@@", "newDataList"}]}], ";"}], 
             "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"newValue", "=", "0"}], ";"}]}], "\[IndentingNewLine]", 
            "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"analyticCodeArray", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"pureExp", "[", 
              RowBox[{"[", "iVal", "]"}], "]"}], " ", "$selectedBranchSize"}],
             ",", 
            RowBox[{"pureExp", "[", 
             RowBox[{"[", "iVal", "]"}], "]"}], ",", "coeffCode"}], "}"}]}], 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"pureExp", "[", 
           RowBox[{"[", "iVal", "]"}], "]"}], ",", 
          RowBox[{"newValue", " ", 
           RowBox[{"z", "^", 
            RowBox[{"pureExp", "[", 
             RowBox[{"[", "iVal", "]"}], "]"}]}]}]}], "}"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"iVal", ",", "1", ",", 
         RowBox[{"Length", "@", "pureData"}]}], "}"}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Print", "[", 
      RowBox[{"\"\<reducedAnalCoefList: \>\"", ",", 
       RowBox[{"reducedAnalCoefList", "//", "N"}]}], "]"}], ";"}], 
    "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"imagZeroIndexes", "==", 
       RowBox[{"Length", "@", "pureData"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
       "Print", "[", "\"\<Imag parts of all terms are zero!\>\"", "]"}], 
       ";"}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"imagZeroIndexes", "!=", "0"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{
           "Style", "[", "\"\<Some real parts are zero but not all !,Red\>\"",
             "]"}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]}], 
     "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"realZeroIndexes", "==", 
       RowBox[{"Length", "@", "pureData"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
       "Print", "[", "\"\<Real parts of all terms are zero!\>\"", "]"}], 
       ";"}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"realZeroIndexes", "!=", "0"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{
           "Style", "[", "\"\<Some real parts are zero but not all\>\"", 
            "]"}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]}], 
     "\[IndentingNewLine]", "]"}], ";"}], " ", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<imagZeroIndexes: \>\"", ",", "imagZeroIndexes"}], "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<realZeroIndexes: \>\"", ",", "realZeroIndexes"}], "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"reducedList", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{"N", "[", 
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "}"}], "&"}], "/@", 
      "reducedAnalCoefList"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"Prepend", "[", 
      RowBox[{"reducedList", ",", 
       RowBox[{"{", 
        RowBox[{"\"\<exp\>\"", ",", "\"\<Term\>\""}], "}"}]}], "]"}], ",", 
     RowBox[{"Dividers", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"{", "True", "}"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"True", ",", "True", ",", 
          RowBox[{"{", "False", "}"}], ",", "True"}], "}"}]}], "}"}]}]}], 
    "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Precision of reducedAnalCoefList: \>\"", ",", 
      RowBox[{"Precision", "@", 
       RowBox[{"reducedAnalCoefList", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}]}], "]"}], ";"}]}]}]], "Input",
