Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"getZeroIndexes", "[", 
     RowBox[{"theFunction_", ",", "theSingularList_", ",", 
      RowBox[{"diag_", ":", "False"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "wKeys", ",", "a0Rule", ",", "a1Rule", ",", "theZeroPoints", ",", 
        "zeroPrecision", ",", "duplicateError", ",", "zeroIndexes", ",", 
        "theZeroList", ",", "singPrecision", ",", "difTable", ",", "maxDif", 
        ",", "rootPrecisionTable", ",", "dif"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"wKeys", "=", 
        RowBox[{"CoefficientRules", "[", 
         RowBox[{
         "theFunction", ",", "w", ",", "\"\<NegativeLexicographic\>\""}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"a0Rule", "=", 
        RowBox[{"Normal", "@", 
         RowBox[{"KeyTake", "[", 
          RowBox[{"wKeys", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", "0", "}"}], ",", "z"}], "}"}]}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"singPrecision", "=", 
        RowBox[{"Floor", "@", 
         RowBox[{"Precision", "@", "theSingularList"}]}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "@", "a0Rule"}], ">", "0"}], " ", ",", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{"found", " ", "a_", "0"}], " ", "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Exponent", "[", 
              RowBox[{
               RowBox[{"a0Rule", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "2"}], "]"}], "]"}], ",", "z"}], "]"}], 
             ">", "0"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"a1Rule", "=", 
              RowBox[{"Normal", "@", 
               RowBox[{"KeyTake", "[", 
                RowBox[{"wKeys", ",", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"{", "1", "}"}], ",", "z"}], "}"}]}], "]"}]}]}], 
             ";", "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Length", "@", "a1Rule"}], ">", "0"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"(*", " ", 
                RowBox[{
                "now", " ", "have", " ", "a0", " ", "and", " ", "a1", " ", 
                 "in", " ", "function"}], " ", "*)"}], "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Exponent", "[", 
                    RowBox[{
                    RowBox[{"a1Rule", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}], ",", "z"}], "]"}], 
                   ">", "0"}], ",", "\[IndentingNewLine]", 
                  RowBox[{"(*", " ", 
                   RowBox[{
                    RowBox[{
                    "a1", " ", "is", " ", "a", " ", "poly", " ", "degree"}], 
                    ">", "0"}], " ", "*)"}], "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"a0Rule", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}], "===", 
                    RowBox[{"a1Rule", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{"(*", " ", 
                    RowBox[{
                    RowBox[{"at", " ", "this", " ", "point", " ", "a0"}], "===", 
                    RowBox[{
                    RowBox[{"a1", " ", "poly", " ", "degree"}], ">", 
                    RowBox[{
                    "0", " ", "so", " ", "zero", " ", "terms", " ", "are", 
                    " ", "zeros", " ", "to", " ", "a0"}]}]}], " ", "*)"}], 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"theZeroPoints", "=", 
                    RowBox[{"Sort", "[", 
                    RowBox[{
                    RowBox[{"z", "/.", 
                    RowBox[{"NSolve", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Factor", "@", 
                    RowBox[{"a0Rule", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}]}], "\[Equal]", 
                    "0"}], ",", "z", ",", 
                    RowBox[{
                    "WorkingPrecision", "\[Rule]", "singPrecision"}]}], 
                    "]"}]}], ",", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "@", "#1"}], "<=", 
                    RowBox[{"Abs", "@", "#2"}]}], "&"}]}], "]"}]}], ";"}], 
                    "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
                    RowBox[{"(*", 
                    RowBox[{
                    RowBox[{"Print", "[", 
                    RowBox[{"Style", "[", 
                    RowBox[{
                    "\"\<No zero key singular points\>\"", ",", "Red"}], 
                    "]"}], "]"}], ";"}], "*)"}], "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"theZeroPoints", "=", 
                    RowBox[{"{", "}"}]}], ";"}]}], "\[IndentingNewLine]", 
                    "]"}], ";"}], "\[IndentingNewLine]", ",", 
                  "\[IndentingNewLine]", 
                  RowBox[{"(*", " ", 
                   RowBox[{
                   "if", " ", "a1", " ", "is", " ", "a", " ", "constant", " ",
                     "zero", " ", "set", " ", "is", " ", "null"}], " ", 
                   "*)"}], "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"theZeroPoints", "=", 
                    RowBox[{"{", "}"}]}], ";"}]}], "\[IndentingNewLine]", 
                 "]"}], ";"}], "\[IndentingNewLine]", ",", 
               "\[IndentingNewLine]", 
               RowBox[{"(*", " ", 
                RowBox[{
                "have", " ", "no", " ", "a1", " ", "at", " ", "this", " ", 
                 "point"}], " ", "*)"}], "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"theZeroPoints", "=", 
                 RowBox[{"Sort", "[", 
                  RowBox[{
                   RowBox[{"z", "/.", 
                    RowBox[{"NSolve", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Factor", "@", 
                    RowBox[{"a0Rule", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}]}], "\[Equal]", 
                    "0"}], ",", "z", ",", 
                    RowBox[{
                    "WorkingPrecision", "\[Rule]", "singPrecision"}]}], 
                    "]"}]}], ",", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "@", "#1"}], "<=", 
                    RowBox[{"Abs", "@", "#2"}]}], "&"}]}], "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"(*", "\[IndentingNewLine]", " ", 
                 RowBox[{"now", " ", "confirm", " ", "solutions"}], 
                 "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
                RowBox[{"difTable", "=", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{"a0Rule", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}], "/.", 
                    RowBox[{"z", "->", "#"}]}], "&"}], "/@", " ", 
                  "theZeroPoints"}]}], ";", "\[IndentingNewLine]", 
                RowBox[{"rootPrecisionTable", "=", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Precision", "@", "#"}], "&"}], "/@", " ", 
                  "difTable"}]}], ";", "\[IndentingNewLine]", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Min", "@", "rootPrecisionTable"}], ">", "10"}], 
                  ",", "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"maxDif", "=", 
                    RowBox[{"Max", "@", "difTable"}]}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"maxDif", ">", "$maxRootVerifyDifference"}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"Print", "[", 
                    RowBox[{"Style", "[", 
                    RowBox[{
                    "\"\<Verification of theZeroPoints roots exceeded the \
$maxRootVerifyDifference\>\"", ",", "Red", ",", "Bold"}], "]"}], "]"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"Print", "[", 
                    RowBox[{"\"\<   maxDif: \>\"", ",", 
                    RowBox[{"N", "[", 
                    RowBox[{"maxDif", ",", "20"}], "]"}]}], "]"}], ";"}]}], 
                    "\[IndentingNewLine]", "]"}], ";"}]}], 
                 "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
                RowBox[{"zeroPrecision", "=", 
                 RowBox[{"Floor", "@", 
                  RowBox[{"Precision", "@", "theZeroPoints"}]}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"duplicateError", "=", 
                 RowBox[{
                  RowBox[{"Min", "[", 
                   RowBox[{"zeroPrecision", ",", "singPrecision"}], "]"}], 
                  "-", "$accuracyComparisonFactor"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"theZeroList", "=", 
                 RowBox[{"DeleteDuplicates", "[", 
                  RowBox[{"theZeroPoints", ",", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "[", 
                    RowBox[{"#1", "-", "#2"}], "]"}], "<", 
                    RowBox[{"10", "^", 
                    RowBox[{"-", 
                    RowBox[{"(", "duplicateError", ")"}]}]}]}], "&"}]}], 
                  "]"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], 
            "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"theZeroPoints", "=", 
              RowBox[{"{", "}"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], 
          ";"}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"theZeroPoints", "=", 
           RowBox[{"{", "}"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{"diag", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"\"\<theZeroPoints: \>\"", ",", 
            RowBox[{"theZeroPoints", "//", "N"}]}], "]"}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "@", "theZeroPoints"}], ">", "0"}], ",", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"zeroPrecision", "=", 
           RowBox[{"Floor", "@", 
            RowBox[{"Precision", "@", "theZeroPoints"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"duplicateError", "=", 
           RowBox[{
            RowBox[{"Min", "[", 
             RowBox[{"zeroPrecision", ",", "singPrecision"}], "]"}], "-", 
            "$accuracyComparisonFactor"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"theZeroList", "=", 
           RowBox[{"DeleteDuplicates", "[", 
            RowBox[{"theZeroPoints", ",", 
             RowBox[{
              RowBox[{
               RowBox[{"Abs", "[", 
                RowBox[{"#1", "-", "#2"}], "]"}], "<", 
               RowBox[{"10", "^", 
                RowBox[{"-", 
                 RowBox[{"(", "duplicateError", ")"}]}]}]}], "&"}]}], "]"}]}],
           ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"zeroIndexes", "=", 
           RowBox[{"Flatten", "[", "\[IndentingNewLine]", 
            RowBox[{"Table", "[", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"dif", "=", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Abs", "[", 
                   RowBox[{
                    RowBox[{"theZeroList", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "-", "#"}], "]"}], "&"}], 
                 "/@", " ", "theSingularList"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"Position", "[", 
                 RowBox[{"dif", ",", 
                  RowBox[{"x_", "/;", 
                   RowBox[{"x", "==", 
                    RowBox[{"Min", "[", "dif", "]"}]}]}]}], "]"}], "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{"i", ",", "1", ",", 
                RowBox[{"Length", "@", "theZeroList"}]}], "}"}]}], 
             "\[IndentingNewLine]", "]"}], "]"}]}], ";"}], 
         "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"zeroIndexes", "=", 
           RowBox[{"{", "}"}]}], ";"}]}], "\[IndentingNewLine]", 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       "zeroIndexes"}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.894362756298192*^9, 3.894362760003891*^9}, {
   3.894364812693549*^9, 3.8943648146460304`*^9}, {3.894364851591223*^9, 
   3.89436489302394*^9}, {3.894365384522834*^9, 3.894365425958099*^9}, {
   3.8943657185630875`*^9, 3.8943657231016607`*^9}, {3.8943687672778807`*^9, 
   3.8943687802880025`*^9}, {3.894368875359459*^9, 3.894368883593053*^9}, {
   3.8943689804297943`*^9, 3.8943690336829424`*^9}, {3.8943690734193044`*^9, 
   3.8943691765924177`*^9}, {3.894369207230199*^9, 3.894369258702525*^9}, {
   3.8943693359499216`*^9, 3.8943693369965396`*^9}, {3.8943693964921455`*^9, 
   3.894369408270458*^9}, {3.894370467676176*^9, 3.894370471269084*^9}, {
