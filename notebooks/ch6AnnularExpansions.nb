Cell[CellGroupData[{

Cell["generateCustomMedialContour", "Subsection",
 CellChangeTimes->{{3.9628028750923605`*^9, 3.962802878882354*^9}, {
  3.9630683322536945`*^9, 
  3.9630683339090157`*^9}},ExpressionUUID->"9d8dc5ab-17e9-4819-864c-\
c00a468d7942"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"generateCustomMedialContour", "[", 
     RowBox[{
     "contour_", ",", "theFunction_", ",", "monodromyList_", ",", 
      "branchNum_", ",", "wpVal_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "cycleSize", ",", "zFun", ",", "tEnd", ",", "wDeriv", ",", "selected", 
        ",", "aIndex", ",", "sIndex", ",", "zStart", ",", 
        "$selectedMonodromyList", ",", "theRoots", ",", "tStart", ",", 
        "wStart", ",", "medialSol", ",", "newRNorm", ",", "theAnnulus"}], 
       "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{"\"\<contour: \>\"", ",", 
          RowBox[{
           RowBox[{"contour", "[", "t", "]"}], "//", "N"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<deriv: \>\"", ",", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"contour", "[", "t", "]"}], ",", "t"}], "]"}]}], "]"}], 
        ";"}], "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"$selectedMonodromyList", "=", 
        RowBox[{"monodromyList", "[", 
         RowBox[{"[", "branchNum", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"cycleSize", "=", 
        RowBox[{"Length", "@", "$selectedMonodromyList"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"zStart", "=", 
        RowBox[{"contour", "[", "$thetaV", "]"}]}], " ", ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"theRoots", "=", 
        RowBox[{"w", "/.", 
         RowBox[{"NSolve", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"theFunction", "\[Equal]", "0"}], "/.", 
            RowBox[{"z", "->", "zStart"}]}], ",", "w", ",", 
           RowBox[{"WorkingPrecision", "->", "700"}]}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"wStart", "=", 
        RowBox[{"theRoots", "[", 
         RowBox[{"[", 
          RowBox[{"$selectedMonodromyList", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"tStart", "=", "$thetaV"}], ";", "\[IndentingNewLine]", 
       RowBox[{"tEnd", "=", " ", 
        RowBox[{"tStart", "+", 
         RowBox[{"2", " ", "Pi", " ", "cycleSize"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<tStart: \>\"", ",", 
         RowBox[{"tStart", "//", "N"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<tEnd: \>\"", ",", 
         RowBox[{"tEnd", "//", "N"}]}], "]"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"wDeriv", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"w", "'"}], "[", "t", "]"}], "\[Equal]", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", 
              RowBox[{"(", 
               FractionBox[
                RowBox[{"D", "[", 
                 RowBox[{"theFunction", ",", "z"}], "]"}], 
                RowBox[{"D", "[", 
                 RowBox[{"theFunction", ",", "w"}], "]"}]], ")"}]}], " ", 
             RowBox[{"D", "[", 
              RowBox[{
               RowBox[{"contour", "[", "t", "]"}], ",", "t"}], "]"}]}], ")"}],
            "/.", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"w", "\[Rule]", 
              RowBox[{"w", "[", "t", "]"}]}], ",", 
             RowBox[{"z", "\[Rule]", 
              RowBox[{"contour", "[", "t", "]"}]}]}], "}"}]}], ")"}]}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"Print", "[", "\"\<test\>\"", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"medialSol", "=", 
        RowBox[{"NDSolveValue", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"wDeriv", ",", 
            RowBox[{
             RowBox[{"w", "[", "tStart", "]"}], "\[Equal]", "wStart"}]}], 
           "}"}], ",", "w", ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "tStart", ",", "tEnd"}], "}"}], ",", 
          RowBox[{"MaxSteps", "->", "20000000"}], ",", 
          RowBox[{"InterpolationOrder", "->", "All"}], ",", 
          RowBox[{"WorkingPrecision", "->", "wpVal"}], ",", 
          RowBox[{"MaxStepSize", "->", 
           RowBox[{"1", "/", "1000"}]}], ",", 
          RowBox[{"Method", "->", "\"\<StiffnessSwitching\>\""}]}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"tStart", ",", "tEnd", ",", "medialSol", ",", "cycleSize"}], 
        "}"}]}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.9628018504265556`*^9, 3.9628019494969263`*^9}, {
   3.9628019843472013`*^9, 3.9628020563571987`*^9}, {3.962802102347151*^9, 
