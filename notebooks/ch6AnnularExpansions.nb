           "\"\<\!\(\*SubscriptBox[\(s\), \(a\)]\)\>\"", ",", "12", ",", 
            "Bold", ",", "Black"}], "]"}], ",", 
          RowBox[{
           RowBox[{"-", "Pi"}], "/", "2"}]}], "]"}]}], "}"}]}], ",", 
     RowBox[{"FrameTicksStyle", "->", 
      RowBox[{"Directive", "[", 
       RowBox[{"Black", ",", "12", ",", "Black", ",", "Bold"}], "]"}]}]}], 
    "]"}], "\[IndentingNewLine]", "\[IndentingNewLine]"}]}]], "Input",
