Cell["\<\
Generate 3D plot of accuracy as function of order and radius ratio\
\>", "Subsubsection",
 CellChangeTimes->{{3.942404115512347*^9, 
  3.9424041292122655`*^9}},ExpressionUUID->"23cad691-0a4e-4bc2-9a23-\
6927d1494e8b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"extRadiusTicks", "[", "n_", "]"}], ":=", 
     RowBox[{
      RowBox[{"radiusRange", "[", 
       RowBox[{"[", "1", "]"}], "]"}], "+", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"radiusRatios", "[", 
         RowBox[{"[", "n", "]"}], "]"}], "radiusDif"}], ")"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{"orderGrids", "=", 
     RowBox[{"Array", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Floor", "@", "#"}], "&"}], ",", 
       RowBox[{"{", "5", "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"orderStart", ",", 
         RowBox[{"orderEnd", "-", "2"}]}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pointPlot3D", "=", 
     RowBox[{"ListPointPlot3D", "[", 
      RowBox[{
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"plotTable", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "4"}], "]"}], "]"}], ",", "1"}], "]"}], ",", 
       RowBox[{"BoxRatios", "->", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "1", ",", " ", "1"}], "}"}]}], ",", 
       RowBox[{"AxesLabel", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{
           "\"\<\!\(\*SubscriptBox[\(r\), \(s\)]\)\>\"", ",", "14", ",", 
            "Bold", ",", "Black"}], "]"}], ",", 
          RowBox[{"Style", "[", 
           RowBox[{"\"\<O\>\"", ",", "14", ",", "Bold", ",", "Black"}], "]"}],
           ",", 
          RowBox[{"Style", "[", 
           RowBox[{
           "\"\<\!\(\*SubscriptBox[\(s\), \(a\)]\)\>\"", ",", "14", ",", 
            "Bold", ",", "Black"}], "]"}]}], "}"}]}], ",", 
       RowBox[{"AxesEdge", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}]}], ",", 
       RowBox[{"FaceGrids", "->", 
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "0", ",", "1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"extRadiusTicks", "[", "20", "]"}], ",", 
               RowBox[{"extRadiusTicks", "[", "40", "]"}], ",", 
               RowBox[{"extRadiusTicks", "[", "60", "]"}], ",", 
               RowBox[{"extRadiusTicks", "[", "80", "]"}]}], "}"}], ",", 
             "orderGrids"}], "}"}]}], "}"}], "}"}]}], ",", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"Ticks", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"extRadiusTicks", "[", "1", "]"}], ",", 
              RowBox[{"N", "[", 
               RowBox[{
                RowBox[{"extRadiusTicks", "[", "1", "]"}], ",", "2"}], 
               "]"}]}], "}"}], ",", 
            RowBox[{"{", 
