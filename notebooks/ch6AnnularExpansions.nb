Cell["\<\
Before running this section, choose testCase0001 and compute the annular \
table with monodromies.  Then return to this section.\
\>", "Text",
 CellChangeTimes->{{3.986553457622983*^9, 
  3.98655348027956*^9}},ExpressionUUID->"e4115b74-efcd-4ab6-8063-\
c209b7444887"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{"generate", " ", "polar", " ", "perimters"}], " ", 
   "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Pole indexes: \>\"", ",", "$poleIndexes"}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "@", "$poleIndexes"}], ">", "1"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"nearestPole", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"NearestTo", "[", 
              RowBox[{"#1", ",", "2"}], "]"}], "[", 
             RowBox[{"$theSingularList", "[", 
              RowBox[{"[", "$poleIndexes", "]"}], "]"}], "]"}], "&"}], "/@", 
           " ", 
           RowBox[{"$theSingularList", "[", 
            RowBox[{"[", "$poleIndexes", "]"}], "]"}]}], ")"}], "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"nearestDistArray", "=", 
        RowBox[{"MapThread", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"#1", "-", "#2"}], "]"}], "&"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"$theSingularList", "[", 
             RowBox[{"[", "$poleIndexes", "]"}], "]"}], ",", "nearestPole"}], 
           "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"poleRadiusArray", "=", 
        RowBox[{"MapThread", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"3", "/", "4"}], 
            RowBox[{"Abs", "[", 
             RowBox[{"#1", "-", "#2"}], "]"}]}], "&"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"$theSingularList", "[", 
             RowBox[{"[", "$poleIndexes", "]"}], "]"}], ",", "nearestPole"}], 
           "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", " ", 
       RowBox[{"theSings", "=", "$theSingularList"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"thePoles", "=", 
        RowBox[{"$theSingularList", "[", 
         RowBox[{"[", "$poleIndexes", "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"theRingList", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"Abs", "[", "#", "]"}], "&"}], "/@", " ", "theSings"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"maxX", "=", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"$theSingularList", "[", 
           RowBox[{"[", 
            RowBox[{"-", "1"}], "]"}], "]"}], "]"}], "+", "2"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"maxX", "=", 
        RowBox[{"theAnnuli", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "2"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"nonPoleIndexes", "=", 
        RowBox[{"Complement", "[", 
         RowBox[{
          RowBox[{"Range", "[", 
           RowBox[{"1", ",", 
