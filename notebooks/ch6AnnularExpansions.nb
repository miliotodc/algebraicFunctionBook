Cell["Section 9.3:  Computing multi-medial singular terms", "Subsection",
 CellChangeTimes->{{3.9820809125382214`*^9, 3.9820809245584717`*^9}, {
  3.9820809668462667`*^9, 
  3.9820809764557533`*^9}},ExpressionUUID->"0423b054-eb90-4a52-b4dc-\
940e4d1edab3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"DistributeDefinitions", "[", 
   RowBox[{
   "$integrationPartition", ",", "$singTermMin", ",", "$singTermMax"}], "]"}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"totalMedialRuns", "=", 
    RowBox[{"Length", "@", "medialTable"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"t0", "=", "$thetaV"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"t1", "=", 
   RowBox[{"t0", "+", 
    RowBox[{"2", " ", "Pi", " ", "$selectedBranchSize"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"intervalArray", "=", 
   RowBox[{"Array", "[", 
    RowBox[{
     RowBox[{"#", "&"}], ",", 
     RowBox[{"$integrationPartition", "+", "1"}], ",", 
     RowBox[{"{", 
      RowBox[{"t0", ",", "t1"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"thePartitions", "=", 
   RowBox[{"Partition", "[", 
    RowBox[{"intervalArray", ",", "2", ",", "1"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Partitioning integration as: \>\"", ",", "thePartitions"}], 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"totalMedialRuns", "=", 
   RowBox[{"Length", "@", "medialTable"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"startTime", "=", 
   RowBox[{"TimeObject", "[", "Now", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"at2", "=", 
   RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"residualSingularTerms", "=", 
      RowBox[{"ParallelTable", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"medialSol", "=", 
          RowBox[{"medialTable", "[", 
           RowBox[{"[", 
            RowBox[{"medialIndex", ",", "1"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", " ", 
         RowBox[{"medialPrec", "=", 
          RowBox[{"medialTable", "[", 
           RowBox[{"[", 
            RowBox[{"medialIndex", ",", "2"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"medialAcc", "=", 
          RowBox[{"medialTable", "[", 
           RowBox[{"[", 
            RowBox[{"medialIndex", ",", "3"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"theCycleSize", "=", 
          RowBox[{"medialTable", "[", 
           RowBox[{"[", 
            RowBox[{"medialIndex", ",", "4"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{
          "\"\<Analyzing medial index \>\"", ",", "medialIndex", ",", 
           "\"\< with precision \>\"", ",", "medialPrec"}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"medialPrec", "=", 
          RowBox[{"(", 
           RowBox[{"Precision", "@", "medialSol"}], ")"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"at", "=", 
          RowBox[{"AbsoluteTiming", "[", 
           RowBox[{
            RowBox[{"singTable", "=", 
             RowBox[{"Table", "[", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Mod", "[", 
                    RowBox[{"k", ",", "25"}], "]"}], "==", "0"}], ",", 
                  "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"Print", "[", 
                    RowBox[{"\"\<Current index \>\"", ",", "k"}], "]"}], 
                   ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"finalIntVal", "=", 
                 RowBox[{"Plus", "@@", 
                  RowBox[{"Table", "[", "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"NIntegrate", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"medialSol", "[", "t", "]"}], 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Cos", "[", 
                    RowBox[{"t", " ", 
                    RowBox[{"k", "/", "$selectedBranchSize"}]}], "]"}], "-", 
                    RowBox[{"I", " ", 
                    RowBox[{"Sin", "[", 
                    RowBox[{"t", " ", 
                    RowBox[{"k", "/", "$selectedBranchSize"}]}], "]"}]}]}], 
                    ")"}]}], ",", 
                    RowBox[{"{", 
                    RowBox[{"t", ",", 
                    RowBox[{"thePartitions", "[", 
                    RowBox[{"[", 
                    RowBox[{"index", ",", "1"}], "]"}], "]"}], ",", 
                    RowBox[{"thePartitions", "[", 
                    RowBox[{"[", 
                    RowBox[{"index", ",", "2"}], "]"}], "]"}]}], "}"}], ",", 
                    RowBox[{"Method", "->", 
                    RowBox[{"{", 
                    RowBox[{"\"\<GlobalAdaptive\>\"", ",", 
                    RowBox[{"\"\<MaxErrorIncreases\>\"", "->", "600"}], ",", 
                    RowBox[{"Method", "->", "\"\<LevinRule\>\""}]}], "}"}]}], 
                    ",", 
                    RowBox[{"WorkingPrecision", "->", "medialPrec"}], ",", 
                    RowBox[{"AccuracyGoal", "->", 
                    RowBox[{"medialPrec", "/", "2"}]}], ",", 
                    RowBox[{"MaxRecursion", "->", "Infinity"}]}], "]"}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{"{", 
                    RowBox[{"index", ",", "1", ",", 
                    RowBox[{"Length", "@", "thePartitions"}]}], "}"}]}], 
                   "\[IndentingNewLine]", "]"}]}]}], ";", 
                "\[IndentingNewLine]", "\[IndentingNewLine]", 
                RowBox[{"coef", "=", 
                 RowBox[{
                  FractionBox["1", 
                   RowBox[{"2", " ", "Pi", " ", "$selectedBranchSize", " ", 
                    RowBox[{"rNorm", "^", 
                    RowBox[{"(", 
                    RowBox[{"k", "/", "$selectedBranchSize"}], ")"}]}]}]], 
                  "finalIntVal"}]}], ";", "\[IndentingNewLine]", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"k", "/", "$selectedBranchSize"}], ",", "coef", ",", 
                  RowBox[{"N", "[", 
                   RowBox[{"coef", ",", "10"}], "]"}], ",", 
                  RowBox[{"coef", " ", 
                   RowBox[{
                    RowBox[{"(", 
