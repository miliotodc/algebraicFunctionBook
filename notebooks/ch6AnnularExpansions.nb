Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{"save", " ", "to", " ", "combinedTermsFileName"}], 
   "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Exporting combined high precision terms to \>\"", ",", 
      RowBox[{"combinedExpansionTermsFileName", "[", 
       RowBox[{
       "$theTestCase", ",", "$selectedAnnulus", ",", "$selectedBranch"}], 
       "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Export", "[", 
     RowBox[{
      RowBox[{"combinedExpansionTermsFileName", "[", 
       RowBox[{
       "$theTestCase", ",", "$selectedAnnulus", ",", "$selectedBranch"}], 
       "]"}], ",", 
      RowBox[{"{", 
       RowBox[{
       "reducedPreciseAnalyticTerms", ",", "reducedPreciseAnalyticOrderList", 
        ",", "reducedPreciseSingularTerms", ",", 
        "reducedPreciseSingularOrderList"}], "}"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"singularMaxOrder", "=", 
    RowBox[{"reducedPreciseSingularOrderList", "[", 
     RowBox[{"[", 
      RowBox[{
       RowBox[{"-", "1"}], ",", "1"}], "]"}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{"analyticMaxOrder", "=", 
    RowBox[{"reducedPreciseAnalyticOrderList", "[", 
     RowBox[{"[", 
      RowBox[{
       RowBox[{"-", "1"}], ",", "1"}], "]"}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{"theMaxOrder", "=", 
    RowBox[{"Min", "[", 
     RowBox[{"{", 
      RowBox[{"analyticMaxOrder", ",", "singularMaxOrder"}], "}"}], "]"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<theMaxOrder: \>\"", ",", "theMaxOrder"}], "]"}], ";"}], 
