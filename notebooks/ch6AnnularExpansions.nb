       RowBox[{"maxExp", "=", 
        RowBox[{"Floor", "@", 
         RowBox[{"Max", "@", "theExps"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"nearElements", "=", 
        RowBox[{"Nearest", "[", 
         RowBox[{"theExps", ",", 
          RowBox[{"Range", "[", "maxExp", "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"uniqueVals", "=", 
        RowBox[{"nearElements", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
