Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"totalBranches", "=", 
     RowBox[{"Length", "@", "alphaMonodromyList"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"termRange", "=", 
      RowBox[{"Range", "[", 
       RowBox[{"Sequence", "@@", "$range9111"}], "]"}]}], ";"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"termRange", "=", 
     RowBox[{"Range", "[", 
      RowBox[{"Sequence", "@@", "$range933d"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{"$doPolishFlag933d", ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"integrationPrecision", "=", "$polishPrecision933d"}], ";"}], 
      "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"integrationPrecision", "=", "medialPrecision"}], ";"}]}], 
     "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"alphaSeriesSet", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"selectedBranch", "=", 
         RowBox[{"alphaMonodromyList", "[", 
          RowBox[{"[", "branchIndex", "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{"\"\<Analyzing branch \>\"", ",", "Red", ",", "14"}], 
           "]"}], ",", "selectedBranch"}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"selectedBranchSize", "=", 
         RowBox[{"Length", "@", 
          RowBox[{"alphaMonodromyList", "[", 
           RowBox[{"[", "branchIndex", "]"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"rNorm", "=", "medialR"}], ";", "\[IndentingNewLine]", 
        RowBox[{"tStart", "=", "$thetaV"}], ";", "\[IndentingNewLine]", 
        RowBox[{"tEnd", "=", " ", 
         RowBox[{"tStart", "+", 
          RowBox[{"2", " ", "Pi", " ", "selectedBranchSize"}]}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        " ", 
        RowBox[{"rationalRNorm", "=", 
         RowBox[{"Rationalize", "[", 
          RowBox[{"rNorm", ",", 
           RowBox[{"10", "^", 
            RowBox[{"-", "25"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", "\"\<Generating medial contour\>\"", "]"}], ";",
         "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "tStart", ",", "tEnd", ",", "lowPrecMedialSol", ",", 
           "selectedBranchSize"}], "}"}], "=", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"generateMedialContour", "[", 
            RowBox[{
            "annulusTable", ",", "$selectedAnnulus933b", ",", "branchIndex", 
             ",", "integrationPrecision", ",", 
             RowBox[{"1", "/", "2"}]}], "]"}], ";"}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"generateCustomMedialContour", "[", 
          RowBox[{
          "alphaContourF", ",", "$theFunction", ",", "alphaMonodromyList", 
           ",", "branchIndex", ",", "medialPrecision"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<prec: \>\"", ",", 
          RowBox[{"Precision", "@", "lowPrecMedialSol"}]}], "]"}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", " ", 
        RowBox[{"numPart", "=", "$partitionSize933d"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"t0", "=", "$thetaV"}], ";", "\[IndentingNewLine]", 
        RowBox[{"t1", "=", 
         RowBox[{"t0", "+", 
          RowBox[{"2", " ", "Pi", " ", "selectedBranchSize"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"intervalArray", "=", 
         RowBox[{"Array", "[", 
          RowBox[{
           RowBox[{"#", "&"}], ",", 
           RowBox[{"numPart", "+", "1"}], ",", 
           RowBox[{"{", 
            RowBox[{"t0", ",", "t1"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"thePartitions", "=", 
         RowBox[{"Partition", "[", 
          RowBox[{"intervalArray", ",", "2", ",", "1"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"theBranchTerms", "=", 
         RowBox[{"Table", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Mod", "[", 
                RowBox[{"k", ",", "10"}], "]"}], "==", "0"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"Print", "[", "k", "]"}], ";"}]}], 
             "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"k", "==", "0"}], ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"finalIntVal", "=", 
                RowBox[{"Plus", "@@", 
                 RowBox[{"Table", "[", "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"NIntegrate", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"lowPrecMedialSol", "[", "t", "]"}], 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Cos", "[", 
                    RowBox[{"t", " ", 
                    RowBox[{"k", "/", "selectedBranchSize"}]}], "]"}], "-", 
                    RowBox[{"I", " ", 
                    RowBox[{"Sin", "[", 
                    RowBox[{"t", " ", 
                    RowBox[{"k", "/", "selectedBranchSize"}]}], "]"}]}]}], 
                    ")"}]}], ",", 
                    RowBox[{"{", 
                    RowBox[{"t", ",", 
                    RowBox[{"thePartitions", "[", 
                    RowBox[{"[", 
                    RowBox[{"index", ",", "1"}], "]"}], "]"}], ",", 
                    RowBox[{"thePartitions", "[", 
                    RowBox[{"[", 
                    RowBox[{"index", ",", "2"}], "]"}], "]"}]}], "}"}], ",", 
                    RowBox[{"Method", "->", 
                    RowBox[{"{", 
                    RowBox[{"\"\<GlobalAdaptive\>\"", ",", 
                    RowBox[{"\"\<MaxErrorIncreases\>\"", "->", "600"}], ",", 
                    RowBox[{"Method", "->", "\"\<GaussKronrodRule\>\""}]}], 
                    "}"}]}], ",", 
                    RowBox[{
                    "WorkingPrecision", "->", "integrationPrecision"}], ",", 
                    RowBox[{"AccuracyGoal", "->", 
                    RowBox[{"integrationPrecision", "/", "2"}]}], ",", 
                    RowBox[{"MaxRecursion", "->", "Infinity"}]}], "]"}], ",", 
                   "\[IndentingNewLine]", 
                   RowBox[{"{", 
                    RowBox[{"index", ",", "1", ",", 
                    RowBox[{"Length", "@", "thePartitions"}]}], "}"}]}], 
                  "\[IndentingNewLine]", "]"}]}]}], ";"}], 
              "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"finalIntVal", "=", 
                RowBox[{"Plus", "@@", 
                 RowBox[{"Table", "[", "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"NIntegrate", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"lowPrecMedialSol", "[", "t", "]"}], 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Cos", "[", 
                    RowBox[{"t", " ", 
                    RowBox[{"k", "/", "selectedBranchSize"}]}], "]"}], "-", 
                    RowBox[{"I", " ", 
                    RowBox[{"Sin", "[", 
                    RowBox[{"t", " ", 
                    RowBox[{"k", "/", "selectedBranchSize"}]}], "]"}]}]}], 
                    ")"}]}], ",", 
                    RowBox[{"{", 
                    RowBox[{"t", ",", 
                    RowBox[{"thePartitions", "[", 
                    RowBox[{"[", 
                    RowBox[{"index", ",", "1"}], "]"}], "]"}], ",", 
                    RowBox[{"thePartitions", "[", 
                    RowBox[{"[", 
                    RowBox[{"index", ",", "2"}], "]"}], "]"}]}], "}"}], ",", 
                    RowBox[{"Method", "->", 
                    RowBox[{"{", 
                    RowBox[{"\"\<GlobalAdaptive\>\"", ",", 
                    RowBox[{"\"\<MaxErrorIncreases\>\"", "->", "600"}], ",", 
                    RowBox[{"Method", "->", "\"\<LevinRule\>\""}]}], "}"}]}], 
                    ",", 
                    RowBox[{
                    "WorkingPrecision", "->", "integrationPrecision"}], ",", 
                    RowBox[{"AccuracyGoal", "->", 
                    RowBox[{"integrationPrecision", "/", "2"}]}], ",", 
                    RowBox[{"MaxRecursion", "->", "Infinity"}]}], "]"}], ",", 
                   "\[IndentingNewLine]", 
                   RowBox[{"{", 
                    RowBox[{"index", ",", "1", ",", 
                    RowBox[{"Length", "@", "thePartitions"}]}], "}"}]}], 
                  "\[IndentingNewLine]", "]"}]}]}], ";"}]}], 
             "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
            RowBox[{"coef", "=", 
             RowBox[{
              FractionBox["1", 
               RowBox[{"2", " ", "Pi", " ", "selectedBranchSize", " ", 
                RowBox[{"rNorm", "^", 
                 RowBox[{"(", 
                  RowBox[{"k", "/", "selectedBranchSize"}], ")"}]}]}]], 
              "finalIntVal"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"k", "/", "selectedBranchSize"}], ",", "coef", ",", 
              RowBox[{"N", "[", 
               RowBox[{"coef", ",", "10"}], "]"}], ",", 
              RowBox[{"coef", " ", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"z", "^", 
                  RowBox[{"(", 
                   RowBox[{"1", "/", "selectedBranchSize"}], ")"}]}], ")"}], 
                "^", "k"}]}]}], "}"}]}], ",", "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"k", ",", "termRange"}], "}"}]}], "\[IndentingNewLine]", 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"selectedBranch", ",", "theBranchTerms"}], "}"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"branchIndex", ",", "1", ",", "totalBranches"}], "}"}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\n"}]}]], "Input",
