Cell[CellGroupData[{

Cell["Choose a branch index into alphaSeriesSet to check", "Subsection",
 CellChangeTimes->{{3.986553686225351*^9, 
  3.9865537136894073`*^9}},ExpressionUUID->"5f9ab8cd-baf3-490a-8927-\
e5d2e9b3ba4e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{
    "the", " ", "branches", " ", "are", " ", "organized", " ", "in", " ", 
     "alphaSeriesSet", " ", "as", " ", 
     RowBox[{"1", "--"}], 
     RowBox[{"{", 
      RowBox[{"4", ",", "5"}], "}"}]}], ",", " ", 
    RowBox[{
     RowBox[{"2", "--"}], ">", 
     RowBox[{"{", "3", "}"}]}], ",", 
    RowBox[{
     RowBox[{"3", "--"}], ">", 
     RowBox[{"{", "4", "}"}]}], ",", 
    RowBox[{
     RowBox[{"4", "--"}], ">", 
     RowBox[{"{", "5", "}"}]}]}], " ", "\[IndentingNewLine]", "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"branchIndex", "=", "1"}], ";"}], "  ", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"alpha1", "[", "z_", "]"}], "=", 
     RowBox[{"Plus", "@@", 
      RowBox[{"alphaSeriesSet", "[", 
       RowBox[{"[", 
        RowBox[{"branchIndex", ",", "2", ",", "All", ",", "4"}], "]"}], 
       "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"zTest", "=", 
     RowBox[{"alphaContourF", "[", 
      RowBox[{"2", " ", 
       RowBox[{"Pi", "/", "14"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"alpha1", "[", 
     RowBox[{"zTest", "-", "translateFactor"}], "]"}], "//", "N"}], 
   "\[IndentingNewLine]", 
   RowBox[{"wVals", "=", 
    RowBox[{
     RowBox[{"w", "/.", 
      RowBox[{"NSolve", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"$theFunction", "==", "0"}], "/.", 
         RowBox[{"z", "->", "zTest"}]}], ",", "w", ",", 
        RowBox[{"WorkingPrecision", "->", "25"}]}], "]"}]}], "//", "N"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"expList", "=", 
     RowBox[{"Exponent", "[", 
      RowBox[{
       RowBox[{"alpha1", "[", "z", "]"}], ",", "z", ",", "List"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"coefList", "=", 
     RowBox[{"Coefficient", "[", 
      RowBox[{
       RowBox[{"alpha1", "[", "z", "]"}], ",", "z", ",", "expList"}], "]"}]}],
     ";"}], "\[IndentingNewLine]", 
   RowBox[{"Length", "@", "coefList"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"alpha2F", "[", 
      RowBox[{"z_", ",", "k_"}], "]"}], ":=", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"coefList", "[", 
         RowBox[{"[", "n", "]"}], "]"}], " ", 
        RowBox[{"(", 
         RowBox[{"Exp", "[", 
          RowBox[{"2", " ", "k", " ", "\[Pi]", " ", "\[ImaginaryI]", " ", 
           RowBox[{"expList", "[", 
            RowBox[{"[", "n", "]"}], "]"}]}], "]"}], ")"}], " ", 
        RowBox[{"z", "^", 
         RowBox[{"expList", "[", 
          RowBox[{"[", "n", "]"}], "]"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "1", ",", 
         RowBox[{"Length", "[", "coefList", "]"}]}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"aVal", "=", 
    RowBox[{"alpha2F", "[", 
     RowBox[{
      RowBox[{"zTest", "-", "translateFactor"}], ",", "1"}], "]"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"difVals", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"aVal", "-", "#"}], "]"}], "&"}], "/@", " ", "wVals"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pos", "=", 
     RowBox[{
      RowBox[{"Position", "[", 
       RowBox[{"difVals", ",", 
        RowBox[{"Min", "@", "difVals"}]}], "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Accuracy: \>\"", ",", 
     RowBox[{"difVals", "[", 
      RowBox[{"[", "pos", "]"}], "]"}]}], "]"}]}]}]], "Input",
