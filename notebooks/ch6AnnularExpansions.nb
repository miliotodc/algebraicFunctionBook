  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{"expansion", " ", "at", " ", "infinity"}], "\[IndentingNewLine]", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"$theFunction", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"z", "^", 
         RowBox[{"(", "30", ")"}]}], "+", 
        RowBox[{"z", "^", 
         RowBox[{"(", "32", ")"}]}]}], ")"}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
