        "\[IndentingNewLine]", 
        RowBox[{"seriesWChar", "=", 
         RowBox[{"convertToChar", "[", 
          RowBox[{"SetPrecision", "[", 
           RowBox[{
            RowBox[{"type", "@", "seriesW"}], ",", "wp"}], "]"}], "]"}]}], 
        ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Length", "@", "actWChar"}], "<", "charMin"}], "||", " ", 
           RowBox[{
            RowBox[{"Length", "@", "seriesWChar"}], "<", "charMin"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
           "Print", "[", 
            "\"\<actWChar or seriesWChar lenght less than char min: \>\"", 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<actW: \>\"", ",", 
             RowBox[{"N", "[", 
              RowBox[{"actW", ",", "20"}], "]"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<seriesW: \>\"", ",", 
             RowBox[{"N", "[", 
              RowBox[{"seriesW", ",", "20"}], "]"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<actWChar length: \>\"", ",", 
             RowBox[{"Length", "@", "actWChar"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<seriesWChar length: \>\"", ",", 
             RowBox[{"Length", "@", "seriesWChar"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"errorFlag", "=", "True"}], ";"}], "\[IndentingNewLine]", 
          ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"maxCharLen", "=", 
            RowBox[{"Min", "@", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Length", "@", "actWChar"}], ",", 
               RowBox[{"Length", "@", "seriesWChar"}]}], "}"}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"i", "=", "1"}], ";", "\[IndentingNewLine]", 
           RowBox[{"While", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"actWChar", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "==", 
               RowBox[{"seriesWChar", "[", 
                RowBox[{"[", "i", "]"}], "]"}]}], " ", "&&", " ", 
              RowBox[{"i", "<", "maxCharLen"}]}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"i", "++"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";",
            "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
