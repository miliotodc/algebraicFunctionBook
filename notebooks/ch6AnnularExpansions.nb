Cell[CellGroupData[{

Cell["formatNumber", "Subsection",
 CellChangeTimes->{{3.923813943945816*^9, 
  3.9238139464294405`*^9}},ExpressionUUID->"2b820da0-fa61-4406-9d8e-\
552168ff896b"],

Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{
   RowBox[{"formatNumber", "[", "num_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "real", ",", "imag", ",", "realPart", ",", "imagPart", ",", "me", ",", 
       "return"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Precision", "@", 
           RowBox[{"Im", "@", "num"}]}], "<", "10"}], " ", "||", " ", 
         RowBox[{
          RowBox[{"Precision", "@", 
           RowBox[{"Re", "@", "num"}]}], "<", "10"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"return", "=", "\"\<E\>\""}], ";"}]}], "\[IndentingNewLine]",
        "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"real", "=", 
       RowBox[{"Re", "@", "num"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"imag", "=", 
       RowBox[{"Im", "@", "num"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Precision", "@", "real"}], ">", "10"}], " ", "&&", " ", 
         RowBox[{
          RowBox[{"Precision", "@", "imag"}], ">", "10"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"me", "=", 
          RowBox[{"MantissaExponent", "[", "real", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"realPart", "=", 
          RowBox[{
           RowBox[{"N", "[", 
            RowBox[{
             RowBox[{"10", " ", 
              RowBox[{"me", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], ",", "5"}], "]"}], " ", 
           RowBox[{"10", "^", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"me", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "-", "1"}], ")"}]}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"me", "=", 
          RowBox[{"MantissaExponent", "[", "imag", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"imagPart", "=", 
          RowBox[{
           RowBox[{"N", "[", 
            RowBox[{
             RowBox[{"10", " ", 
              RowBox[{"me", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], ",", "5"}], "]"}], " ", 
           RowBox[{"10", "^", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"me", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "-", "1"}], ")"}]}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"return", "=", 
          RowBox[{"realPart", "+", 
           RowBox[{"I", " ", "imagPart"}]}]}], ";"}], "\[IndentingNewLine]", 
        ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Precision", "@", "imag"}], "<", "10"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"me", "=", 
             RowBox[{"MantissaExponent", "[", "real", "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"realPart", "=", 
             RowBox[{
              RowBox[{"N", "[", 
               RowBox[{
                RowBox[{"10", " ", 
                 RowBox[{"me", "[", 
                  RowBox[{"[", "1", "]"}], "]"}]}], ",", "5"}], "]"}], " ", 
              RowBox[{"10", "^", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"me", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], "-", "1"}], ")"}]}]}]}], 
            ";", "\[IndentingNewLine]", 
            RowBox[{"return", "=", "realPart"}], ";"}], "\[IndentingNewLine]",
            ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Precision", "@", "real"}], "<", "10"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"me", "=", 
                RowBox[{"MantissaExponent", "[", "imag", "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"imagPart", "=", 
                RowBox[{
                 RowBox[{"N", "[", 
                  RowBox[{
                   RowBox[{"10", " ", 
                    RowBox[{"me", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], ",", "5"}], "]"}], " ", 
                 RowBox[{"10", "^", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"me", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "-", "1"}], ")"}]}]}]}], 
               ";", "\[IndentingNewLine]", 
               RowBox[{"return", "=", 
                RowBox[{"I", " ", "imagPart"}]}], ";"}], 
              "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
              RowBox[{"return", "=", "\"\<E\>\""}]}], "\[IndentingNewLine]", 
             "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", "return"}]}],
     "\[IndentingNewLine]", "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9238139351041665`*^9, 3.923813954990339*^9}},
 CellLabel->
  "In[142]:=",ExpressionUUID->"510ba2fc-903f-470b-a316-fdf1a59c62b2"]
}, Closed]],

Cell[CellGroupData[{

Cell["polishBranchTerms", "Subsection",
 CellChangeTimes->{{3.9291148919187965`*^9, 
  3.9291148946995955`*^9}},ExpressionUUID->"5b11820f-f20d-4a54-8e57-\
380f8e16d257"],

Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{
   RowBox[{
    RowBox[{"polishBranchTerms", "[", 
     RowBox[{"zVal_", ",", "terms_", ",", "maxErrorTolerance_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "wVals", ",", "polishedValues", ",", "difTable", ",", "pos", ",", 
        "wValsPrec", ",", "termsPrec"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"seriesValues", " ", 
        RowBox[{"format", ":", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"baseSeriesIndexK", ",", " ", "seriesValK"}], "}"}], 
            "..."}], 
           RowBox[{"{", 
            RowBox[{"baseSeriesIndexM", ",", "seriesValM"}], "}"}]}], 
          "}"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"termsPrec", "=", 
        RowBox[{"Floor", "@", 
         RowBox[{"Precision", "@", 
          RowBox[{"terms", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "2"}], "]"}], "]"}]}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"wVals", "=", 
        RowBox[{"w", "/.", 
         RowBox[{"NSolve", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"$theFunction", "==", "0"}], "/.", 
            RowBox[{"z", "->", "zVal"}]}], ",", "w", ",", 
           RowBox[{"WorkingPrecision", "->", "termsPrec"}]}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"polishedValues", "=", 
        RowBox[{"Table", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"difTable", "=", 
            RowBox[{
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{
                RowBox[{"terms", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", "3"}], "]"}], "]"}], "-", "#"}], "]"}], 
              "&"}], "/@", " ", "wVals"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"pos", "=", 
            RowBox[{
             RowBox[{"Position", "[", 
              RowBox[{"difTable", ",", 
               RowBox[{"Min", "@", "difTable"}]}], "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{"difTable", "[", 
                RowBox[{"[", "pos", "]"}], "]"}], "]"}], ">", 
              RowBox[{"10", "^", 
               RowBox[{"(", 
                RowBox[{"-", "maxErrorTolerance"}], ")"}]}]}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Print", "[", 
               RowBox[{"Style", "[", 
                RowBox[{
                 RowBox[{"\"\<     polishTerms accuracy below: \>\"", "<>", 
                  RowBox[{"ToString", "[", "maxErrorTolerance", "]"}]}], ",", 
                 "Black"}], "]"}], "]"}], ";", "\[IndentingNewLine]", 
              RowBox[{"Print", "[", 
               RowBox[{"\"\<     difTable: \>\"", ",", 
                RowBox[{"difTable", "//", "N"}]}], "]"}], ";"}]}], 
            "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"terms", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", 
             RowBox[{"terms", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "2"}], "]"}], "]"}], ",", 
             RowBox[{"wVals", "[", 
              RowBox[{"[", "pos", "]"}], "]"}]}], "}"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{"Length", "@", "terms"}]}], "}"}]}], 
         "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"return", ":", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"seriesIndexK", ",", "polishedValK"}], "}"}], "..."}], 
           RowBox[{"{", 
            RowBox[{"seriesIndexM", ",", "polishedValM"}], "}"}]}], "}"}]}], 
        " ", "*)"}], "\[IndentingNewLine]", "polishedValues"}]}], 
     "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.929114884030032*^9, 3.929114884436383*^9}, {
   3.929115110430355*^9, 3.929115110821054*^9}, 3.954487504086605*^9, {
   3.986134256807198*^9, 3.986134259708357*^9}, {3.986134316840456*^9, 
   3.9861343183957233`*^9}, {3.992149867000701*^9, 3.9921498895631514`*^9}, {
   3.992150761154468*^9, 3.9921507636423645`*^9}, {3.9938027519493756`*^9, 
   3.9938027596199236`*^9}},
 CellLabel->
  "In[143]:=",ExpressionUUID->"05331ed0-3f26-446f-a91e-127fe4e39964"]
