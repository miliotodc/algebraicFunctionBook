Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "attempt", " ", "to", " ", "make", " ", "sub", " ", "for", " ", "init", 
    " ", "data"}], " ", "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "In", " ", "order", " ", "to", " ", "have", " ", "unique", " ", 
     "barycentric", " ", "ids", " ", "for", " ", "each", " ", "vertex"}], ",",
     " ", 
    RowBox[{
     RowBox[{"must", " ", "use", " ", "radialSegments"}], "=", 
     RowBox[{
      RowBox[{"3", "n"}], "+", 
      RowBox[{
      "1", " ", "and", " ", "odd", " ", "for", " ", "vertex", " ", 
       "calculations", " ", "to", " ", "find", " ", "a", " ", "mid", " ", 
       "point"}]}]}]}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"radialSegments", "=", "13"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"arcSegments", " ", "is", " ", "2", "n"}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"arcSegments", "=", "48"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"totalIntegrationSteps", "=", "1500000"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"maxStepSize", "=", "0.0001"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"workingPrecision", "=", "75"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ringDelta", "=", 
     RowBox[{"1", "/", "20000"}]}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{"ring", " ", "separation", " ", "threshold"}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"minRingSize", "=", 
     RowBox[{"1", "/", "2000"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"initializationFunction", "[", "theFunction_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "singlist", ",", "singularPrecision", ",", "theValues", ",", 
         "polePrecision", ",", "newPrecision", ",", "sing2", ",", "rings", 
         ",", "pre", ",", "ring2", ",", "theRingSet", ",", "ringDifferences", 
         ",", "i", ",", "j", ",", "min", ",", "distance", ",", "preRingSize", 
         ",", "postRingSize", ",", "newRing", ",", "theRingDigits", ",", 
         "theSingList", ",", "singStyle", ",", "index", ",", "currentSing", 
         ",", "pos"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"functionOrder", "=", 
         RowBox[{"Exponent", "[", 
          RowBox[{"theFunction", ",", "w"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"singlist", "=", 
         RowBox[{"(", 
          RowBox[{"z", "/.", 
           RowBox[{"NSolve", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Resultant", "[", 
               RowBox[{"theFunction", ",", 
                RowBox[{"D", "[", 
                 RowBox[{"theFunction", ",", "w"}], "]"}], ",", "w"}], "]"}], 
              "\[Equal]", "0"}], ",", "z", ",", 
             RowBox[{"WorkingPrecision", "\[Rule]", "workingPrecision"}]}], 
            "]"}]}], ")"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"singularPrecision", "=", 
         RowBox[{"Precision", "[", "singlist", "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"theValues", "=", 
         RowBox[{"NSolve", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Coefficient", "[", 
             RowBox[{"theFunction", ",", 
              RowBox[{"w", "^", "functionOrder"}]}], "]"}], "\[Equal]", "0"}],
            ",", "z", ",", 
           RowBox[{"WorkingPrecision", "\[Rule]", "workingPrecision"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "theValues", "]"}], ">", "0"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"thePoles", "=", 
            RowBox[{"z", "/.", "theValues"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"polePrecision", "=", 
            RowBox[{"Precision", "[", "thePoles", "]"}]}], ";"}], 
          "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"thePoles", "=", 
            RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"polePrecision", "=", "singularPrecision"}], ";"}]}], 
         "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "take", " ", "min", " ", "of", " ", "these", " ", "precison"}], " ", 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{"newPrecision", "=", 
         RowBox[{"Min", "[", 
          RowBox[{"singularPrecision", ",", "polePrecision"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", " ", "[", 
         RowBox[{
         "\"\<Working precision of computations: \>\"", ",", "newPrecision"}],
          "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"sing2", "=", 
         RowBox[{"SetPrecision", "[", 
          RowBox[{"singlist", ",", 
           RowBox[{"newPrecision", "-", "2"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"pole2", "=", 
         RowBox[{"SetPrecision", "[", 
          RowBox[{"thePoles", ",", 
           RowBox[{"newPrecision", "-", "2"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"pole2", "=", 
         RowBox[{"Sort", "[", 
          RowBox[{
           RowBox[{"DeleteDuplicates", "[", "pole2", "]"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", "#1", "]"}], "\[LessEqual]", 
             RowBox[{"Abs", "[", "#2", "]"}]}], "&"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"sing3", "=", 
         RowBox[{"Sort", "[", 
          RowBox[{
           RowBox[{"DeleteDuplicates", "[", "sing2", "]"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", "#1", "]"}], "\[LessEqual]", 
             RowBox[{"Abs", "[", "#2", "]"}]}], "&"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"$theSingularList", "=", "sing3"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"rings", "=", 
         RowBox[{"Sort", "[", 
          RowBox[{"Abs", "[", "singlist", "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"pre", "=", 
         RowBox[{"Precision", "[", "rings", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"ring2", "=", 
         RowBox[{"SetPrecision", "[", 
          RowBox[{"rings", ",", 
           RowBox[{"pre", "-", "2"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"ring3", "=", 
         RowBox[{"Sort", "[", 
          RowBox[{"DeleteDuplicates", "[", "ring2", "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"theRingSet", "=", 
         RowBox[{"Union", "[", 
          RowBox[{
           RowBox[{"{", "0", "}"}], ",", "ring3", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Last", "[", "ring3", "]"}], "+", "4"}], "}"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"ringRegions", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Length", "[", "theRingSet", "]"}], "-", "1"}], "}"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"i", "=", "1"}], ",", 
          RowBox[{"i", "\[LessEqual]", 
           RowBox[{
            RowBox[{"Length", "[", "theRingSet", "]"}], "-", "1"}]}], ",", 
          RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"ringRegions", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "1"}], "]"}], "]"}], "=", 
            RowBox[{
             RowBox[{"theRingSet", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "+", "ringDelta"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"ringRegions", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "2"}], "]"}], "]"}], "=", 
            RowBox[{
             RowBox[{"theRingSet", "[", 
              RowBox[{"[", 
               RowBox[{"i", "+", "1"}], "]"}], "]"}], "-", "ringDelta"}]}], 
           ";"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"ringDifferences", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "-", 
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], "}"}], "&"}], " ", "/@", " ", 
          "ringRegions"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", 
            RowBox[{"Select", "[", 
             RowBox[{
              RowBox[{"Flatten", "[", "ringDifferences", "]"}], ",", 
              RowBox[{
               RowBox[{"#", "<", 
                RowBox[{"1", "/", "5000"}]}], "&"}]}], "]"}], "]"}], ">", 
           "1"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"Style", "[", 
             RowBox[{"\"\<Ring size too small\>\"", ",", "Red"}], "]"}], 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"Select", "[", 
             RowBox[{
              RowBox[{"Flatten", "[", "ringDifferences", "]"}], ",", 
              RowBox[{
               RowBox[{"#", "<", 
                RowBox[{"1", "/", "5000"}]}], "&"}]}], "]"}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Abort", "[", "]"}], ";"}]}], "\[IndentingNewLine]", "]"}],
         ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"radiiTable", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Array", "[", 
            RowBox[{
             RowBox[{"#", "&"}], ",", "radialSegments", ",", 
             RowBox[{"ringRegions", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", 
             RowBox[{"Length", "[", "ringRegions", "]"}]}], "}"}]}], "]"}]}], 
        ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "need", " ", "to", " ", "flag", " ", "this", " ", "as", " ", "an", 
          " ", "expansion", " ", "around", " ", "the", " ", "origin"}], " ", 
         "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"singularPointExpansion", "=", "False"}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"minArray", "=", 
         RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"i", "=", "1"}], ",", 
          RowBox[{"i", "\[LessEqual]", 
           RowBox[{"Length", "[", "sing3", "]"}]}], ",", 
          RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"currentSing", "=", 
            RowBox[{"sing3", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"min", "=", 
            RowBox[{"10", "^", "6"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"For", "[", 
            RowBox[{
             RowBox[{"j", "=", "1"}], ",", 
             RowBox[{"j", "\[LessEqual]", 
              RowBox[{"Length", "[", "sing3", "]"}]}], ",", 
             RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"j", "\[NotEqual]", "i"}], ",", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"distance", "=", 
                  RowBox[{"Sqrt", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Re", "[", "currentSing", "]"}], "-", 
                    RowBox[{"Re", "[", 
                    RowBox[{"sing3", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "]"}]}], ")"}], "^", 
                    "2"}], "+", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Im", "[", "currentSing", "]"}], "-", 
                    RowBox[{"Im", "[", 
                    RowBox[{"sing3", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "]"}]}], ")"}], "^", 
                    "2"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{"distance", "<", "min"}], ",", 
                   "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"min", "=", "distance"}], ";"}]}], 
                  "\[IndentingNewLine]", "]"}], ";"}]}], 
               "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"minArray", "=", 
            RowBox[{"Append", "[", 
             RowBox[{"minArray", ",", 
              RowBox[{"min", "/", "2"}]}], "]"}]}], ";"}]}], 
         "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"sing3", "=", 
         RowBox[{"Append", "[", 
          RowBox[{"sing3", ",", "0"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "now", " ", "add", " ", "a", " ", "circle", " ", "around", " ", 
          "all", " ", "singular", " ", "points", " ", "for", " ", "the", " ", 
          "point", " ", "at", " ", "infinity"}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"minArray", "=", 
         RowBox[{"Append", "[", 
          RowBox[{"minArray", ",", 
           RowBox[{
            RowBox[{"Max", "[", "ring3", "]"}], "+", "2"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "and", " ", "add", " ", "zero", " ", "as", " ", "the", " ", "center",
           " ", "of", " ", "this", " ", 
          RowBox[{"ring", ".", "  ", "The"}], " ", "added", " ", "zero", " ", 
          "at", " ", "the", " ", "end", " ", "allows", " ", "a", " ", 
          "spacer", " ", "so", " ", "when", " ", "it", " ", "gets", " ", "to",
           " ", "this", " ", "point"}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "the", " ", "ring", " ", "monodromy", " ", "will", " ", "be", " ", 
          "around", " ", "all", " ", "finite", " ", "singular", " ", "points",
           " ", "so", " ", "is", " ", "the", " ", "mondromy", " ", "around", 
          " ", "infinity"}], "  ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "now", " ", "add", " ", "zero", " ", "at", " ", "end", " ", "of", 
          " ", "singular", " ", "list", " ", "for", " ", "point", " ", "at", 
          " ", "infinity"}], " ", "*)"}], "\[IndentingNewLine]", 
