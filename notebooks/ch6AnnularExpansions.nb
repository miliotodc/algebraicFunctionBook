                RowBox[{
                 RowBox[{"Re", "[", "z", "]"}], ",", 
                 RowBox[{"Im", "[", "z", "]"}], ",", 
                 RowBox[{"thePlotType", "[", 
                  RowBox[{"outerRadialTrace", "[", "r", "]"}], "]"}]}], "}"}],
                "/.", 
               RowBox[{"z", "\[Rule]", 
                RowBox[{"r", " ", 
                 RowBox[{"Exp", "[", 
                  RowBox[{"\[ImaginaryI]", " ", "tStart"}], "]"}]}]}]}], ",", 
              RowBox[{"{", 
               RowBox[{"r", ",", 
                RowBox[{"newRadiiTable", "[", 
                 RowBox[{"[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"radialSegments", "-", "1"}], ")"}], "/", "2"}], 
                    "+", "2"}], ";;", "radialSegments"}], "]"}], "]"}]}], 
               "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"Join", "[", 
            RowBox[{"innerRValues", ",", "outerRValues"}], "]"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"segmentNum", ",", "arcSegmentList"}], "}"}]}], 
         "]"}]}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}]], "Input",
