Cell["Section 12.2  Create series table", "Subsection",
 CellChangeTimes->{{3.9821401953449316`*^9, 3.982140202715954*^9}, {
  3.9821403930380144`*^9, 
  3.982140393406808*^9}},ExpressionUUID->"2528e4c6-dd47-46c1-bf23-\
e64fb4f544a3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{"Create", " ", 
    RowBox[{"seriesTable", "[", 
     RowBox[{"[", "n", "]"}], "]"}], " ", "with", " ", "n", " ", "the", " ", 
    "order"}], "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", "  ", 
  RowBox[{
   RowBox[{"theAnnulus", "//", "N"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"thetaRange", "=", 
     RowBox[{"Array", "[", 
      RowBox[{
       RowBox[{"#", "&"}], ",", "100", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "Pi"}], ",", "Pi"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"if", " ", "outer", " ", "annulus"}], ",", " ", 
     RowBox[{"can", " ", "try", " ", "larger", " ", "domains"}]}], " ", 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"radiusRange", "=", 
     RowBox[{"Array", "[", 
      RowBox[{
       RowBox[{"#", "&"}], ",", "80", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"theAnnulus", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{"theAnnulus", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"radiusRatios", "=", 
     RowBox[{"Array", "[", 
      RowBox[{
       RowBox[{"#", "&"}], ",", "100", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "/", "100"}], ",", 
         RowBox[{"99", "/", "100"}]}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"radiusStart", "=", 
     RowBox[{"theAnnulus", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"radiusDif", "=", 
     RowBox[{
      RowBox[{"radiusRange", "[", 
       RowBox[{"[", 
        RowBox[{"-", "1"}], "]"}], "]"}], "-", 
      RowBox[{"radiusRange", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"finalReducedSeries", "[", "z_", "]"}], "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"Plus", "@@", "reducedPreciseAnalyticTerms"}], ")"}], "+", 
      RowBox[{"(", 
       RowBox[{"Plus", "@@", "reducedPreciseSingularTerms"}], ")"}]}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"seriesTable", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"Plus", "@@", 
          RowBox[{"reducedPreciseAnalyticTerms", "[", 
           RowBox[{"[", 
            RowBox[{"1", ";;", 
             RowBox[{"reducedPreciseAnalyticOrderList", "[", 
              RowBox[{"[", 
               RowBox[{"orderIndex", ",", "2"}], "]"}], "]"}]}], "]"}], 
           "]"}]}], ")"}], "+", 
        RowBox[{"(", 
         RowBox[{"Plus", "@@", 
          RowBox[{"reducedPreciseSingularTerms", "[", 
           RowBox[{"[", 
            RowBox[{"1", ";;", 
             RowBox[{"reducedPreciseSingularOrderList", "[", 
              RowBox[{"[", 
               RowBox[{"orderIndex", ",", "2"}], "]"}], "]"}]}], "]"}], 
           "]"}]}], ")"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"orderIndex", ",", "1", ",", "theMaxOrder"}], "}"}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{
  3.9424986621218653`*^9, 3.9552049307084446`*^9, {3.955204970017412*^9, 
   3.955205016224491*^9}, {3.9573559698027077`*^9, 3.9573559735106015`*^9}, {
