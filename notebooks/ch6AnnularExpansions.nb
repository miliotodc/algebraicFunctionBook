Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"computeAnnularTerm", "[", 
    RowBox[{
    "medialSol_", ",", "$selectedBranchSize_", ",", "tStart_", ",", "tEnd_", 
     ",", "rNorm_", ",", "k_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"intVal", ",", "ratioData", ",", "medialPrec"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"medialPrec", "=", 
       RowBox[{"(", 
        RowBox[{"Precision", "@", "medialSol"}], ")"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"intVal", "=", 
       RowBox[{"Check", "[", 
        RowBox[{
         RowBox[{"NIntegrate", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"medialSol", "[", "t", "]"}], 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Cos", "[", 
               RowBox[{"t", " ", 
                RowBox[{"k", "/", "$selectedBranchSize"}]}], "]"}], "-", 
              RowBox[{"I", " ", 
               RowBox[{"Sin", "[", 
                RowBox[{"t", " ", 
                 RowBox[{"k", "/", "$selectedBranchSize"}]}], "]"}]}]}], 
             ")"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", "tStart", ",", "tEnd"}], "}"}], ",", 
           RowBox[{"Method", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<GlobalAdaptive\>\"", ",", 
              RowBox[{"\"\<MaxErrorIncreases\>\"", "->", "600"}], ",", 
              RowBox[{"Method", "->", "\"\<LevinRule\>\""}]}], "}"}]}], ",", 
           RowBox[{"WorkingPrecision", "->", "medialPrec"}], ",", 
           RowBox[{"AccuracyGoal", "->", 
            RowBox[{"medialPrec", "/", "2"}]}], ",", 
           RowBox[{"MaxRecursion", "->", "Infinity"}]}], "]"}], ",", 
         RowBox[{"-", "1"}], ",", 
         RowBox[{"NIntegrate", "::", "slwcon"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"intVal", "==", 
         RowBox[{"-", "1"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
         "Print", "[", "\"\<Encountered NIntegrate::slwcon error\>\"", "]"}], 
         ";", "\[IndentingNewLine]", 
         RowBox[{"ratioData", "=", 
          RowBox[{"{", 
           RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], ";"}], 
        "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"ratioData", "=", 
          RowBox[{"rNorm", 
           RowBox[{
            RowBox[{"(", 
             FractionBox[
              RowBox[{"2", " ", "$selectedBranchSize", " ", "Pi"}], 
              RowBox[{"Abs", "[", "intVal", "]"}]], ")"}], "^", 
            RowBox[{"(", 
             RowBox[{"$selectedBranchSize", "/", "k"}], ")"}]}]}]}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "/", "k"}], ",", "ratioData", ",", 
        RowBox[{"Abs", "@", "intVal"}]}], "}"}]}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.940926116080285*^9, 3.9409261160959063`*^9}},
 CellLabel->
  "In[132]:=",ExpressionUUID->"cc7c2b99-8549-4699-a684-48ee56d031c7"]
}, Closed]],

