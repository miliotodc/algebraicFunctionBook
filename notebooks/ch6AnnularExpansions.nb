              RowBox[{"Print", "[", 
               RowBox[{
                RowBox[{"Style", "[", 
                 RowBox[{"\"\<maxCharLen reached: \>\"", ",", "Red"}], "]"}], 
                ",", 
                RowBox[{"Style", "[", 
                 RowBox[{"maxCharLen", ",", "Red"}], "]"}]}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"Print", "[", 
               RowBox[{"\"\<       Length actWChar: \>\"", ",", 
                RowBox[{"Length", "@", "actWChar"}]}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"Print", "[", 
               RowBox[{"\"\<       Length seriesWChar: \>\"", ",", 
                RowBox[{"Length", "@", "seriesWChar"}]}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"maxCharFlag", "=", "True"}], ";"}]}], 
            "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{"For", "[", 
              RowBox[{
               RowBox[{"k", "=", "1"}], ",", 
               RowBox[{"k", "<=", 
                RowBox[{"i", "-", "1"}]}], ",", 
               RowBox[{"k", "++"}], ",", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{
                 RowBox[{"seriesWChar", "[", 
                  RowBox[{"[", "k", "]"}], "]"}], "=", 
                 RowBox[{"Style", "[", 
                  RowBox[{
                   RowBox[{"seriesWChar", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], ",", "Black", ",", 
                   "Bold"}], "]"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], 
             ";"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"For", "[", 
            RowBox[{
             RowBox[{"k", "=", "i"}], ",", 
             RowBox[{"k", "<=", "maxCharLen"}], ",", 
             RowBox[{"k", "++"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"seriesWChar", "[", 
                RowBox[{"[", "k", "]"}], "]"}], "=", 
               RowBox[{"Style", "[", 
                RowBox[{
                 RowBox[{"seriesWChar", "[", 
                  RowBox[{"[", "k", "]"}], "]"}], ",", "Red"}], "]"}]}], 
              ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"errTable", "=", 
            RowBox[{"Table", "[", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"baseF2", "[", "t_", "]"}], "=", 
                RowBox[{
                 RowBox[{"theSeries", "[", 
                  RowBox[{"[", 
                   RowBox[{"1", ";;", "index"}], "]"}], "]"}], "/.", 
                 RowBox[{"z", "->", "t"}]}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"theTestValue", "=", 
                RowBox[{"baseF2", "[", "newZ", "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"ePos", "[", 
                  RowBox[{"[", "index", "]"}], "]"}], ",", 
                 RowBox[{"SetPrecision", "[", 
                  RowBox[{
                   RowBox[{"type", "@", "theTestValue"}], ",", "wp"}], "]"}], 
                 ",", 
                 RowBox[{"Abs", "[", 
                  RowBox[{"actW", "-", "theTestValue"}], "]"}]}], "}"}]}], 
              ",", "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{"index", ",", "expInc", ",", 
                RowBox[{"Length", "@", "ePos"}], ",", "expInc"}], "}"}]}], 
             "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"correctNumber", "=", 
            RowBox[{"type", "@", 
             RowBox[{"SetPrecision", "[", " ", 
              RowBox[{"actW", ",", "wp"}], "]"}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"correctChar", "=", 
            RowBox[{"convertToChar", "[", "correctNumber", "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"cTable2", "=", 
            RowBox[{"Table", "[", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"maxCharIndex", "=", "0"}], ";", "\[IndentingNewLine]", 
               RowBox[{"testNumber", "=", 
                RowBox[{"errTable", "[", 
                 RowBox[{"[", 
                  RowBox[{"sIndex", ",", "2"}], "]"}], "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"testChar", "=", 
                RowBox[{"convertToChar", "[", "testNumber", "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"maxCharLen2", "=", 
                RowBox[{"Min", "@", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"Length", "@", "testChar"}], ",", "maxCharLen"}], 
                  "}"}]}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"i", "=", "1"}], ";", "\[IndentingNewLine]", 
               RowBox[{"While", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"correctChar", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "==", 
                   RowBox[{"testChar", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], " ", "&&", " ", 
                  RowBox[{"i", "<", "maxCharLen2"}]}], ",", 
                 "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"i", "++"}], ";"}]}], "\[IndentingNewLine]", "]"}], 
               ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"i", "==", "maxCharLen"}], ",", 
                 "\[IndentingNewLine]", 
