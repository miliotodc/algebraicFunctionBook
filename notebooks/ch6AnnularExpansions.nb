Cell[CellGroupData[{

Cell["\<\
Section 13.3:  Compute high-precision terms with polishMedial\
\>", "Subsection",
 CellChangeTimes->{{3.9890463955640235`*^9, 
  3.9890464237177706`*^9}},ExpressionUUID->"3f341f86-a2d0-48c6-99a2-\
180e7f6957d2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{"define", " ", "high", " ", "precision", " ", "arrays"}], 
   "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"precisionArray", "=", "$analyticPrecisionArray"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"totalMedialRuns", "=", 
     RowBox[{"Length", "@", "precisionArray"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{"startTime", "=", 
     RowBox[{"TimeObject", "[", "Now", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"DistributeDefinitions", "[", 
     RowBox[{
     "$integrationPartition", ",", "$analTermMin", ",", "$analTermMax", ",", 
      "$selectedBranchSize"}], "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"Style", "[", 
      RowBox[{
       RowBox[{"\"\<Analyzing annulus \>\"", "<>", 
        RowBox[{"ToString", "@", "$selectedAnnulus"}], "<>", 
        "\"\< branch \>\"", "<>", 
        RowBox[{"ToString", "@", "$selectedBranch"}]}], ",", "12"}], "]"}], 
     "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"t0", "=", "$thetaV"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"t1", "=", 
     RowBox[{"t0", "+", 
      RowBox[{"2", " ", "Pi", " ", "$selectedBranchSize"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"intervalArray", "=", 
     RowBox[{"Array", "[", 
      RowBox[{
       RowBox[{"#", "&"}], ",", 
       RowBox[{"$integrationPartition", "+", "1"}], ",", 
       RowBox[{"{", 
        RowBox[{"t0", ",", "t1"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"thePartitions", "=", 
     RowBox[{"Partition", "[", 
      RowBox[{"intervalArray", ",", "2", ",", "1"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Partitioning integration as: \>\"", ",", "thePartitions"}], 
     "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
