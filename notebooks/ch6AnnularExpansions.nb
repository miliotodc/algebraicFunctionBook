                    RowBox[{"Style", "[", 
                    RowBox[{"maxCharLen", ",", "Red"}], "]"}]}], "]"}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"maxCharFlag", "=", "True"}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"maxCharIndex", "=", "sIndex"}], ";"}]}], 
                "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
               RowBox[{"(*", "\[IndentingNewLine]", " ", 
                RowBox[{"now", " ", "find", " ", "decimal", " ", "point"}], 
                "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
               RowBox[{"decimalPosList", "=", 
                RowBox[{"Position", "[", 
                 RowBox[{"testChar", ",", 
                  RowBox[{"x_", "/;", 
                   RowBox[{"x", "==", "\"\<.\>\""}]}]}], "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Length", "@", "decimalPosList"}], "==", "0"}], ",",
                  "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"Print", "[", 
                   RowBox[{"Style", "[", 
                    RowBox[{
                    "\"\<error with decimal location\>\"", ",", "Red"}], 
                    "]"}], "]"}], ";", "\[IndentingNewLine]", 
                  RowBox[{"aDigits", "=", "0"}], ";", "\[IndentingNewLine]", 
                  RowBox[{"Abort", "[", "]"}], ";"}], "\[IndentingNewLine]", 
                 ",", "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"aDigits", "=", 
                   RowBox[{"i", "-", 
                    RowBox[{"decimalPosList", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "1"}], "]"}], "]"}], "-", "1"}]}], 
                  ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
               "\[IndentingNewLine]", "\[IndentingNewLine]", 
               RowBox[{"For", "[", 
                RowBox[{
                 RowBox[{"k", "=", "i"}], ",", 
                 RowBox[{"k", "<=", "maxCharLen2"}], ",", 
                 RowBox[{"k", "++"}], ",", "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"testChar", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], "=", 
                   RowBox[{"Style", "[", 
                    RowBox[{
                    RowBox[{"testChar", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], ",", "Red"}], "]"}]}], 
                  ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"sIndex", " ", "expInc"}], ",", 
                 RowBox[{"errTable", "[", 
                  RowBox[{"[", 
                   RowBox[{"sIndex", ",", "1"}], "]"}], "]"}], ",", "aDigits",
                  ",", 
                 RowBox[{"testChar", "[", 
                  RowBox[{"[", 
                   RowBox[{"1", ";;", "100"}], "]"}], "]"}], ",", 
                 "maxCharIndex", ",", "i"}], "}"}]}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{"sIndex", ",", "1", ",", 
                RowBox[{"Length", "@", "errTable"}]}], "}"}]}], 
             "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"PrependTo", "[", 
            RowBox[{"cTable2", ",", 
             RowBox[{"{", 
              RowBox[{
              "\"\<Series\>\"", ",", "0", ",", "0", ",", "seriesWChar"}], 
