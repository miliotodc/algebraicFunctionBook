bba506206318"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"TrueQ", "@", 
      RowBox[{"FileExistsQ", "@", 
       RowBox[{"medialTableFileName", "[", 
        RowBox[{
        "$theTestCase", ",", "$selectedAnnulus", ",", "$selectedBranch"}], 
        "]"}]}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Print", "[", "\"\<Multi-medial contours on disc\>\"", "]"}], 
      ";"}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Print", "[", "\"\<Multi-medial files not found\>\"", "]"}], 
      ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]}]], "Input",
