Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
   "set", " ", "up", " ", "low", " ", "precision", " ", "medial", " ", 
    "contour"}], "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"rationalRNorm", "=", 
     RowBox[{"Rationalize", "[", 
      RowBox[{"rNorm", ",", 
       RowBox[{"10", "^", 
        RowBox[{"-", "25"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"at", "=", 
     RowBox[{"AbsoluteTiming", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "tStart", ",", "tEnd", ",", "rNorm", ",", "lowPrecMedialSol", ",", 
          "$selectedBranchSize"}], "}"}], "=", 
        RowBox[{"generateMedialContour", "[", 
         RowBox[{
         "annulusTable", ",", "$selectedAnnulus", ",", 
          "$selectedMonodromyIndex", ",", "25", ",", 
          RowBox[{"1", "/", "2"}]}], "]"}]}], ";"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
