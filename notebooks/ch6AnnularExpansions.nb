Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
   "draw", " ", "medial", " ", "contour", " ", "interactively", " ", "via", 
    " ", "Manipulate"}], "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]",
   " ", 
  RowBox[{
   RowBox[{
    RowBox[{"medialSol", "=", 
     RowBox[{"medialTable", "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ParametricPlot3D", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Re", "@", "z"}], ",", 
          RowBox[{"Im", "@", "z"}], ",", 
          RowBox[{"Re", "@", 
           RowBox[{"medialSol", "[", "t", "]"}]}]}], "}"}], "/.", 
        RowBox[{"z", "->", 
         RowBox[{"rNorm", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"I", " ", "t"}], "]"}]}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "tStart", ",", "tStop"}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", "Black"}], ",", 
       RowBox[{"PlotRange", "->", "pRange"}], ",", 
       RowBox[{"BoxRatios", "->", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "1", ",", " ", "1"}], "}"}]}]}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"tStop", ",", 
         RowBox[{"tStart", "+", "0.1"}]}], "}"}], ",", 
       RowBox[{"tStart", "+", "0.01"}], ",", "tEnd"}], "}"}]}], 
    "\[IndentingNewLine]", "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9235834593792315`*^9, 
  3.9235834825929365`*^9}},ExpressionUUID->"36badc52-35f5-42ac-8e2c-\
84726e766c9f"],

