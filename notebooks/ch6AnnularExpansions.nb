Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"analyticSequenceFunction", "=", 
     RowBox[{"#", "&"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", " ", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{
    "use", " ", "raw", " ", "analytic", " ", "terms", " ", "of", " ", 
     "highest", " ", "precision"}], "\[IndentingNewLine]", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
