Cell[CellGroupData[{

Cell["Section 7.2:  Compute unreformed multi-medial analytic terms", \
"Subsection",
 CellChangeTimes->{{3.95492605713839*^9, 3.9549260743569374`*^9}, {
  3.955279197341007*^9, 3.9552792018661747`*^9}, {3.9552792319884014`*^9, 
  3.9552792329235315`*^9}, {3.9552793057346*^9, 3.9552793065360966`*^9}, {
  3.9820506509927053`*^9, 
  3.982050651238886*^9}},ExpressionUUID->"7018aaca-b61b-4699-b9a7-\
5d6b305ce6e5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"startTime", "=", 
   RowBox[{"TimeObject", "[", "Now", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DistributeDefinitions", "[", 
   RowBox[{
   "$integrationPartition", ",", "$analTermMin", ",", "$analTermMax", ",", 
    "$selectedBranchSize"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"totalMedialRuns", "=", 
   RowBox[{"Length", "@", "medialTable"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"Style", "[", 
    RowBox[{
     RowBox[{"\"\<Analyzing annulus \>\"", "<>", 
      RowBox[{"ToString", "@", "$selectedAnnulus"}], "<>", "\"\< branch \>\"",
       "<>", 
      RowBox[{"ToString", "@", "$selectedBranch"}]}], ",", "12"}], "]"}], 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"t0", "=", "$thetaV"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"t1", "=", 
   RowBox[{"t0", "+", 
    RowBox[{"2", " ", "Pi", " ", "$selectedBranchSize"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"intervalArray", "=", 
   RowBox[{"Array", "[", 
    RowBox[{
     RowBox[{"#", "&"}], ",", 
     RowBox[{"$integrationPartition", "+", "1"}], ",", 
     RowBox[{"{", 
      RowBox[{"t0", ",", "t1"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"thePartitions", "=", 
   RowBox[{"Partition", "[", 
    RowBox[{"intervalArray", ",", "2", ",", "1"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Partitioning integration as: \>\"", ",", "thePartitions"}], 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"totalMedialRuns", "=", 
    RowBox[{"Length", "@", "medialTable"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"at2", "=", 
   RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"residualAnalyticTerms", "=", 
      RowBox[{"ParallelTable", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"medialSol", "=", 
          RowBox[{"medialTable", "[", 
           RowBox[{"[", 
            RowBox[{"medialIndex", ",", "1"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", " ", 
         RowBox[{"medialPrec", "=", 
          RowBox[{"medialTable", "[", 
           RowBox[{"[", 
            RowBox[{"medialIndex", ",", "2"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"medialAcc", "=", 
          RowBox[{"medialTable", "[", 
           RowBox[{"[", 
            RowBox[{"medialIndex", ",", "3"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"theCycleSize", "=", 
          RowBox[{"medialTable", "[", 
           RowBox[{"[", 
            RowBox[{"medialIndex", ",", "4"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{
          "\"\<Analyzing medial index \>\"", ",", "medialIndex", ",", 
           "\"\< with precision \>\"", ",", "medialPrec"}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"medialPrec", "=", 
          RowBox[{"(", 
           RowBox[{"Precision", "@", "medialSol"}], ")"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"analTable", "=", 
          RowBox[{"Table", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Mod", "[", 
                 RowBox[{"k", ",", "25"}], "]"}], "==", "0"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"Print", "[", 
                 RowBox[{"\"\<Current index \>\"", ",", "k"}], "]"}], ";"}]}],
               "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
             "\[IndentingNewLine]", "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"k", "==", "0"}], ",", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"finalIntVal", "=", 
                 RowBox[{"Plus", "@@", 
                  RowBox[{"Table", "[", "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"NIntegrate", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"medialSol", "[", "t", "]"}], 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Cos", "[", 
                    RowBox[{"t", " ", 
                    RowBox[{"k", "/", "$selectedBranchSize"}]}], "]"}], "-", 
                    RowBox[{"I", " ", 
                    RowBox[{"Sin", "[", 
                    RowBox[{"t", " ", 
                    RowBox[{"k", "/", "$selectedBranchSize"}]}], "]"}]}]}], 
                    ")"}]}], ",", 
                    RowBox[{"{", 
                    RowBox[{"t", ",", 
                    RowBox[{"thePartitions", "[", 
                    RowBox[{"[", 
                    RowBox[{"index", ",", "1"}], "]"}], "]"}], ",", 
                    RowBox[{"thePartitions", "[", 
                    RowBox[{"[", 
                    RowBox[{"index", ",", "2"}], "]"}], "]"}]}], "}"}], ",", 
                    RowBox[{"Method", "->", 
                    RowBox[{"{", 
                    RowBox[{"\"\<GlobalAdaptive\>\"", ",", 
                    RowBox[{"\"\<MaxErrorIncreases\>\"", "->", "600"}], ",", 
                    RowBox[{"Method", "->", "\"\<GaussKronrodRule\>\""}]}], 
                    "}"}]}], ",", 
                    RowBox[{"WorkingPrecision", "->", "medialPrec"}], ",", 
                    RowBox[{"AccuracyGoal", "->", 
                    RowBox[{"medialPrec", "/", "2"}]}], ",", 
                    RowBox[{"MaxRecursion", "->", "Infinity"}]}], "]"}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{"{", 
                    RowBox[{"index", ",", "1", ",", 
                    RowBox[{"Length", "@", "thePartitions"}]}], "}"}]}], 
                   "\[IndentingNewLine]", "]"}]}]}], ";"}], 
               "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"finalIntVal", "=", 
                 RowBox[{"Plus", "@@", 
                  RowBox[{"Table", "[", "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"NIntegrate", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"medialSol", "[", "t", "]"}], 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Cos", "[", 
                    RowBox[{"t", " ", 
                    RowBox[{"k", "/", "$selectedBranchSize"}]}], "]"}], "-", 
                    RowBox[{"I", " ", 
                    RowBox[{"Sin", "[", 
                    RowBox[{"t", " ", 
                    RowBox[{"k", "/", "$selectedBranchSize"}]}], "]"}]}]}], 
                    ")"}]}], ",", 
                    RowBox[{"{", 
                    RowBox[{"t", ",", 
                    RowBox[{"thePartitions", "[", 
                    RowBox[{"[", 
                    RowBox[{"index", ",", "1"}], "]"}], "]"}], ",", 
                    RowBox[{"thePartitions", "[", 
                    RowBox[{"[", 
                    RowBox[{"index", ",", "2"}], "]"}], "]"}]}], "}"}], ",", 
                    RowBox[{"Method", "->", 
                    RowBox[{"{", 
                    RowBox[{"\"\<GlobalAdaptive\>\"", ",", 
                    RowBox[{"\"\<MaxErrorIncreases\>\"", "->", "600"}], ",", 
                    RowBox[{"Method", "->", "\"\<LevinRule\>\""}]}], "}"}]}], 
                    ",", 
                    RowBox[{"WorkingPrecision", "->", "medialPrec"}], ",", 
                    RowBox[{"AccuracyGoal", "->", 
                    RowBox[{"medialPrec", "/", "2"}]}], ",", 
                    RowBox[{"MaxRecursion", "->", "Infinity"}]}], "]"}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{"{", 
                    RowBox[{"index", ",", "1", ",", 
                    RowBox[{"Length", "@", "thePartitions"}]}], "}"}]}], 
                   "\[IndentingNewLine]", "]"}]}]}], ";"}]}], 
              "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"coef", "=", 
              RowBox[{
               FractionBox["1", 
                RowBox[{"2", " ", "Pi", " ", "$selectedBranchSize", " ", 
                 RowBox[{"rNorm", "^", 
                  RowBox[{"(", 
                   RowBox[{"k", "/", "$selectedBranchSize"}], ")"}]}]}]], 
               "finalIntVal"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"k", "/", "$selectedBranchSize"}], ",", "coef", ",", 
               RowBox[{"N", "[", 
                RowBox[{"coef", ",", "10"}], "]"}], ",", 
               RowBox[{"coef", " ", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"z", "^", 
                   RowBox[{"(", 
                    RowBox[{"1", "/", "$selectedBranchSize"}], ")"}]}], ")"}],
                  "^", "k"}]}]}], "}"}]}], ",", "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{"k", ",", "$analTermMin", ",", "$analTermMax"}], "}"}]}],
            "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
          "medialIndex", ",", "medialPrec", ",", "medialAcc", ",", 
           "analTable"}], "}"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"medialIndex", ",", "1", ",", 
          RowBox[{"Length", "@", "medialTable"}]}], "}"}]}], 
       "\[IndentingNewLine]", "]"}]}], ";"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"endTime", "=", 
  RowBox[{"TimeObject", "[", "Now", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Time to compute multi-medial analytic contours: \>\"", ",", 
   RowBox[{"endTime", "-", "startTime"}]}], 
  "]"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.940152403849583*^9, 3.940152405068261*^9}, {
   3.940152489783598*^9, 3.9401525595327377`*^9}, {3.9401526008823705`*^9, 
