Cell[CellGroupData[{

Cell["\<\
Section 12.6:  Generate series plots and compare to differential plots\
\>", "Subsection",
 CellChangeTimes->{{3.9188050987707186`*^9, 3.91880511043864*^9}, {
  3.9556362673732996`*^9, 3.9556362821865673`*^9}, {3.9864785025599675`*^9, 
  3.9864785062291203`*^9}},ExpressionUUID->"70293b48-3d89-4074-aa5f-\
7e069246a341"],

Cell["\<\
The series plot, with a reasonable number of terms, 25-50 or more if needed, \
should look identical to the differential plot and should overlay neatly over \
the differential plot when plotted together.\
\>", "Text",
 CellChangeTimes->{{3.9864785533729706`*^9, 
  3.9864786146166506`*^9}},ExpressionUUID->"55f43d44-d910-40f9-bdc0-\
6fce34772bc2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
   "retrieve", " ", "reduced", " ", "precise", " ", "series", " ", "from", 
    " ", "file"}], "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"FileExistsQ", "[", 
       RowBox[{"combinedExpansionTermsFileName", "[", 
        RowBox[{
        "$theTestCase", ",", "$selectedAnnulus", ",", "$selectedBranch"}], 
        "]"}], "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Importing combined high precision terms to \>\"", ",", 
         RowBox[{"combinedExpansionTermsFileName", "[", 
          RowBox[{
          "$theTestCase", ",", "$selectedAnnulus", ",", "$selectedBranch"}], 
          "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "reducedPreciseAnalyticTerms", ",", 
          "reducedPreciseAnalyticOrderList", ",", 
          "reducedPreciseSingularTerms", ",", 
          "reducedPreciseSingularOrderList"}], "}"}], "=", 
        RowBox[{"Import", "[", 
         RowBox[{"combinedExpansionTermsFileName", "[", 
          RowBox[{
          "$theTestCase", ",", "$selectedAnnulus", ",", "$selectedBranch"}], 
          "]"}], "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"singularMaxOrder", "=", 
        RowBox[{"reducedPreciseSingularOrderList", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"analyticMaxOrder", "=", 
        RowBox[{"reducedPreciseAnalyticOrderList", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"theMaxOrder", "=", 
        RowBox[{"Min", "[", 
         RowBox[{"{", 
          RowBox[{"analyticMaxOrder", ",", "singularMaxOrder"}], "}"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<theMaxOrder: \>\"", ",", "theMaxOrder"}], "]"}], ";"}], 
      "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"combinedExpansionTermsFileName", "[", 
            RowBox[{
            "$theTestCase", ",", "$selectedAnnulus", ",", "$selectedBranch"}],
             "]"}], "<>", "\"\< not found during import.\>\""}], ",", "Red"}],
          "]"}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.982136661723961*^9, 3.982136662817292*^9}, {
