Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"singularIndexes", "=", 
    RowBox[{"singularResidueArray", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<singularIndexes: \>\"", ",", "singularIndexes"}], "]"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetSharedVariable", "[", "parallelIndex", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DistributeDefinitions", "[", 
   RowBox[{
   "$integrationPartition", ",", "$preciseSingularPolishPrecision", ",", 
    "parallelIndex"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"t0", "=", "$thetaV"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"t1", "=", 
   RowBox[{"t0", "+", 
    RowBox[{"2", " ", "Pi", " ", "$selectedBranchSize"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"intervalArray", "=", 
   RowBox[{"Array", "[", 
    RowBox[{
     RowBox[{"#", "&"}], ",", 
     RowBox[{"$preciseSingularIntegrationPartition", "+", "1"}], ",", 
     RowBox[{"{", 
      RowBox[{"t0", ",", "t1"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"thePartitions", "=", 
   RowBox[{"Partition", "[", 
    RowBox[{"intervalArray", ",", "2", ",", "1"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Partitioning integration as: \>\"", ",", "thePartitions"}], 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sequenceTestPass", "=", "True"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"parallelIndex", "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{
   "\"\<Computing singular terms using polishMedial at \>\"", ",", 
    "$preciseSingularPolishPrecision", ",", 
    "\"\< digits of working precision\>\""}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"at2", "=", 
   RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"precisionSingularArray", "=", 
      RowBox[{"ParallelTable", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"parallelIndex", "--"}], ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Mod", "[", 
             RowBox[{"parallelIndex", ",", "10"}], "]"}], "==", "0"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Print", "[", 
             RowBox[{"\"\<Current index \>\"", ",", "parallelIndex"}], "]"}], 
            ";"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"k", "==", "0"}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"finalIntVal", "=", 
             RowBox[{"Plus", "@@", 
              RowBox[{"Table", "[", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"NIntegrate", "[", " ", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"polishMedial", "[", 
                    RowBox[{"t", ",", "rationalRNorm", ",", "implicitF", ",", 
                    RowBox[{"lowPrecMedialSol", "[", "t", "]"}], ",", 
                    "$preciseSingularPolishPrecision"}], "]"}], 
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Cos", "[", 
                    RowBox[{"t", " ", 
                    RowBox[{"k", "/", "$selectedBranchSize"}]}], "]"}], "-", 
                    RowBox[{"I", " ", 
                    RowBox[{"Sin", "[", 
                    RowBox[{"t", " ", 
                    RowBox[{"k", "/", "$selectedBranchSize"}]}], "]"}]}]}], 
                    ")"}]}], ",", 
                  RowBox[{"{", 
                   RowBox[{"t", ",", 
                    RowBox[{"thePartitions", "[", 
                    RowBox[{"[", 
                    RowBox[{"index", ",", "1"}], "]"}], "]"}], ",", 
                    RowBox[{"thePartitions", "[", 
                    RowBox[{"[", 
                    RowBox[{"index", ",", "2"}], "]"}], "]"}]}], "}"}], ",", 
                  RowBox[{"Method", "->", 
                   RowBox[{"{", 
                    RowBox[{"\"\<GlobalAdaptive\>\"", ",", 
                    RowBox[{"\"\<MaxErrorIncreases\>\"", "->", "600"}], ",", 
                    RowBox[{"Method", "->", "\"\<GaussKronrodRule\>\""}]}], 
                    "}"}]}], ",", 
                  RowBox[{
                  "WorkingPrecision", "->", 
                   "$preciseSingularPolishPrecision"}], ",", 
                  RowBox[{"AccuracyGoal", "->", 
                   RowBox[{"$preciseSingularPolishPrecision", "/", "2"}]}], 
                  ",", 
                  RowBox[{"MaxRecursion", "->", "Infinity"}]}], "]"}], ",", 
                "\[IndentingNewLine]", 
                RowBox[{"{", 
                 RowBox[{"index", ",", "1", ",", 
                  RowBox[{"Length", "@", "thePartitions"}]}], "}"}]}], 
               "\[IndentingNewLine]", "]"}]}]}], ";"}], "\[IndentingNewLine]",
            ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"finalIntVal", "=", 
             RowBox[{"Plus", "@@", 
              RowBox[{"Table", "[", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"NIntegrate", "[", " ", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"polishMedial", "[", 
                    RowBox[{"t", ",", "rationalRNorm", ",", "implicitF", ",", 
                    RowBox[{"lowPrecMedialSol", "[", "t", "]"}], ",", 
                    "$preciseSingularPolishPrecision"}], "]"}], 
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Cos", "[", 
                    RowBox[{"t", " ", 
                    RowBox[{"k", "/", "$selectedBranchSize"}]}], "]"}], "-", 
                    RowBox[{"I", " ", 
                    RowBox[{"Sin", "[", 
                    RowBox[{"t", " ", 
                    RowBox[{"k", "/", "$selectedBranchSize"}]}], "]"}]}]}], 
                    ")"}]}], ",", 
                  RowBox[{"{", 
                   RowBox[{"t", ",", 
                    RowBox[{"thePartitions", "[", 
                    RowBox[{"[", 
                    RowBox[{"index", ",", "1"}], "]"}], "]"}], ",", 
                    RowBox[{"thePartitions", "[", 
                    RowBox[{"[", 
                    RowBox[{"index", ",", "2"}], "]"}], "]"}]}], "}"}], ",", 
                  RowBox[{"Method", "->", 
                   RowBox[{"{", 
                    RowBox[{"\"\<GlobalAdaptive\>\"", ",", 
                    RowBox[{"\"\<MaxErrorIncreases\>\"", "->", "600"}], ",", 
                    RowBox[{"Method", "->", "\"\<LevinRule\>\""}]}], "}"}]}], 
                  ",", 
                  RowBox[{
                  "WorkingPrecision", "->", 
                   "$preciseSingularPolishPrecision"}], ",", 
                  RowBox[{"AccuracyGoal", "->", 
                   RowBox[{"$preciseSingularPolishPrecision", "/", "2"}]}], 
                  ",", 
                  RowBox[{"MaxRecursion", "->", "Infinity"}]}], "]"}], ",", 
                "\[IndentingNewLine]", 
                RowBox[{"{", 
                 RowBox[{"index", ",", "1", ",", 
                  RowBox[{"Length", "@", "thePartitions"}]}], "}"}]}], 
               "\[IndentingNewLine]", "]"}]}]}], ";"}]}], 
          "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{"coef", "=", 
          RowBox[{
           FractionBox["1", 
            RowBox[{"2", " ", "Pi", " ", "$selectedBranchSize", " ", 
             RowBox[{"rNorm", "^", 
              RowBox[{"(", 
               RowBox[{"k", "/", "$selectedBranchSize"}], ")"}]}]}]], 
           "finalIntVal"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"k", "/", "$selectedBranchSize"}], ",", "coef", ",", 
           RowBox[{"N", "[", 
            RowBox[{"coef", ",", "10"}], "]"}], ",", 
           RowBox[{"coef", " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"z", "^", 
               RowBox[{"(", 
                RowBox[{"1", "/", "$selectedBranchSize"}], ")"}]}], ")"}], 
             "^", "k"}]}]}], "}"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"k", ",", "singularIndexes"}], "}"}]}], 
       "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", "]"}]}], 
  ";"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.957115907525248*^9, 3.957115928101372*^9}, {
