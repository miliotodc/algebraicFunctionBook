Cell[CellGroupData[{

Cell["Section 6.2:  Generate multi-medial contours", "Subsection",
 CellChangeTimes->{{3.9422297982151856`*^9, 3.9422298065102825`*^9}, {
  3.986717253204366*^9, 
  3.9867172562880135`*^9}},ExpressionUUID->"2f63ef37-5127-4094-881c-\
a5daabb44c7e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
     "edit", " ", "the", " ", "$multiMedialAnalyticPrecisionArray", " ", "as",
       " ", "needed", " ", "to", " ", "identify", " ", 
      RowBox[{"residuals", ".", "  ", "For"}], " ", "low"}], "-", 
     RowBox[{"degree", " ", "function"}]}], ",", " ", 
    RowBox[{
    "25", " ", "and", " ", "50", " ", "digit", " ", "precisions", " ", "are", 
     " ", 
     RowBox[{"adequate", ".", "  ", "Higher"}], " ", "precision", " ", "such",
      " ", "as", " ", "25"}], ",", "50", ",", " ", 
    RowBox[{
    "and", " ", "75", " ", "or", " ", "even", " ", "higher", " ", "may", " ", 
     "be", " ", "needed", " ", "for", " ", "problem", " ", "functions"}]}], 
   "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"startTime", "=", 
     RowBox[{"TimeObject", "[", "Now", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"$multiMedialAnalyticPrecisionArray", "=", 
     RowBox[{"{", 
      RowBox[{"25", ",", "50"}], "}"}]}], ";"}], "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{"totalMedialRuns", "=", 
     RowBox[{"Length", "@", "$multiMedialAnalyticPrecisionArray"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"DistributeDefinitions", "[", 
     RowBox[{"$selectedAnnulus", ",", "$selectedMonodromyIndex"}], "]"}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"medialTable", "=", 
     RowBox[{"ParallelTable", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{"\"\<contourPrecision: \>\"", ",", "contourPrecision"}], 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "tStart", ",", "tEnd", ",", "rNorm", ",", "medialSol", ",", 
           "$selectedBranchSize"}], "}"}], "=", 
         RowBox[{"generateMedialContour", "[", 
          RowBox[{
          "annulusTable", ",", "$selectedAnnulus", ",", 
           "$selectedMonodromyIndex", ",", "contourPrecision", ",", 
           RowBox[{"1", "/", "2"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", "\[IndentingNewLine]", " ", 
         RowBox[{
         "check", " ", "the", " ", "accuracy", " ", "of", " ", "the", " ", 
          "integration", " ", "with", " ", "respect", " ", "to", " ", 
          "actual", " ", "funtion", " ", "values"}], "\[IndentingNewLine]", 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{
         "\"\<$selectedBranchSize: \>\"", ",", "$selectedBranchSize"}], "]"}],
         ";", "\[IndentingNewLine]", " ", 
        RowBox[{"testW", "=", 
         RowBox[{"medialSol", "[", "tEnd", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"wVals", "=", 
         RowBox[{"w", "/.", 
          RowBox[{"NSolve", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"$theFunction", "==", "0"}], "/.", 
             RowBox[{"z", "->", 
              RowBox[{"rNorm", " ", 
               RowBox[{"Exp", "[", 
                RowBox[{"I", " ", "tEnd"}], "]"}]}]}]}], ",", "w", ",", 
            RowBox[{"WorkingPrecision", "->", "250"}]}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"actualAccuracy", "=", 
         RowBox[{"Min", "@", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"#", "-", "testW"}], "]"}], "&"}], "/@", " ", "wVals"}],
            ")"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<actual accuracy of integration: \>\"", ",", 
          RowBox[{"actualAccuracy", "//", "N"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"accuracyExponent", "=", 
         RowBox[{
          RowBox[{"MantissaExponent", "[", "actualAccuracy", "]"}], "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
         "medialSol", ",", "contourPrecision", ",", "accuracyExponent", ",", 
          "$selectedBranchSize"}], "}"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
        "contourPrecision", ",", "$multiMedialAnalyticPrecisionArray"}], 
        "}"}]}], "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"endTime", "=", 
     RowBox[{"TimeObject", "[", "Now", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Time to compute medial contours: \>\"", ",", 
      RowBox[{"endTime", "-", "startTime"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]"}]}]], "Input",
