Cell["Section 12.4:  Create ListPlot of radius ratio and accuracy", \
"Subsection",
 CellChangeTimes->{{3.982140337581326*^9, 3.982140357272047*^9}, {
  3.982140399637018*^9, 3.9821403999038315`*^9}, {3.9864769679956274`*^9, 
  3.9864769682533846`*^9}},ExpressionUUID->"e7013b63-ecc2-419b-80ea-\
812892b18757"],

Cell["\<\
Generate a list plot of accuracy vs. radius ratio using the maximum order of \
both singular and analytic terms computed above.  This plot should be  \
shark-fin shaped in most cases but may not appear if domain is small or an \
insufficient number of terms is used.\
\>", "Text",
 CellChangeTimes->{{3.9864783409614687`*^9, 
  3.986478449739111*^9}},ExpressionUUID->"879d6104-d3d5-45a6-b834-\
c509f0e50777"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"accPoints", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"theRatio", "=", 
         RowBox[{"radiusRatios", "[", 
          RowBox[{"[", "rIndex", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"testZ", "=", 
         RowBox[{
          RowBox[{"theRatio", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"theAnnulus", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "-", 
             RowBox[{"theAnnulus", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], ")"}]}], "+", 
          RowBox[{"theAnnulus", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}]}], ";", " ", 
        "\[IndentingNewLine]", 
        RowBox[{"seriesVal", "=", 
         RowBox[{
          RowBox[{"seriesTable", "[", 
           RowBox[{"[", 
            RowBox[{"-", "1"}], "]"}], "]"}], "/.", 
          RowBox[{"z", "->", "testZ"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"wVals", "=", 
         RowBox[{"NSolveValues", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"$theFunction", "==", "0"}], "/.", 
            RowBox[{"z", "->", "testZ"}]}], ",", "w"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"difTable", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"seriesVal", "-", "#"}], "]"}], "&"}], "/@", " ", 
          "wVals"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"accVal", "=", 
         RowBox[{"-", 
          RowBox[{
           RowBox[{"MantissaExponent", "[", 
            RowBox[{"Min", "@", "difTable"}], "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"theRatio", ",", "accVal"}], "}"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"rIndex", ",", "1", ",", 
         RowBox[{"Length", "@", "radiusRatios"}]}], "}"}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"ListPlot", "[", 
    RowBox[{"accPoints", ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{
         "\"\<\!\(\*SubscriptBox[\(r\), \(f\)]\)\>\"", ",", "12", ",", "Bold",
           ",", "Black"}], "]"}], ",", 
        RowBox[{"Style", "[", 
         RowBox[{
         "\"\<\!\(\*SubscriptBox[\(s\), \(a\)]\)\>\"", ",", "12", ",", "Bold",
           ",", "Black"}], "]"}]}], "}"}]}], ",", 
     RowBox[{"Frame", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"True", ",", "False"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"True", ",", "False"}], "}"}]}], "}"}]}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{
         "\"\<\!\(\*SubscriptBox[\(r\), \(a\)]\)\>\"", ",", "12", ",", "Bold",
           ",", "Black"}], "]"}], ",", 
        RowBox[{"Rotate", "[", 
