 RowBox[{
  RowBox[{"medialSol", "=", 
   RowBox[{"medialTable", "[", 
    RowBox[{"[", 
     RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"tStart", "//", "N"}], "\[IndentingNewLine]", 
 RowBox[{"tEnd", "//", "N"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"medialPlot", "=", 
   RowBox[{"ParametricPlot3D", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Re", "@", "z"}], ",", 
        RowBox[{"Im", "@", "z"}], ",", 
        RowBox[{"Re", "@", 
         RowBox[{"medialSol", "[", "t", "]"}]}]}], "}"}], "/.", 
      RowBox[{"z", "->", 
       RowBox[{"rNorm", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"I", " ", "t"}], "]"}]}]}]}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "tStart", ",", "tEnd"}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", "Yellow"}], ",", 
     RowBox[{"PlotLabel", "->", 
      RowBox[{"If", "[", 
       RowBox[{"$showPlotLabel", ",", "plotLabel", ",", "None"}], "]"}]}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
