Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"plotLabel", "=", 
    RowBox[{"Column", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Style", "[", "$theTestCase", "]"}], ",", 
