Cell["Section 14.3:  Computing multi-medial singular terms", "Subsection",
 CellChangeTimes->{{3.9820809125382214`*^9, 3.9820809245584717`*^9}, {
  3.9820809668462667`*^9, 3.9820809764557533`*^9}, {3.9890465354982777`*^9, 
  3.989046536383054*^9}},ExpressionUUID->"5f70cfb1-164f-4213-b16e-\
84dc6fb45e62"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"DistributeDefinitions", "[", 
    RowBox[{
    "$integrationPartition", ",", "$singTermMin", ",", "$singTermMax"}], 
    "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"precisionArray", "=", "$singularPrecisionArray"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"totalMedialRuns", "=", 
    RowBox[{"Length", "@", "precisionArray"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"t0", "=", "$thetaV"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"t1", "=", 
   RowBox[{"t0", "+", 
    RowBox[{"2", " ", "Pi", " ", "$selectedBranchSize"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"intervalArray", "=", 
   RowBox[{"Array", "[", 
    RowBox[{
     RowBox[{"#", "&"}], ",", 
     RowBox[{"$integrationPartition", "+", "1"}], ",", 
     RowBox[{"{", 
      RowBox[{"t0", ",", "t1"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"thePartitions", "=", 
   RowBox[{"Partition", "[", 
    RowBox[{"intervalArray", ",", "2", ",", "1"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Partitioning integration as: \>\"", ",", "thePartitions"}], 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"totalMedialRuns", "=", 
   RowBox[{"Length", "@", "precisionArray"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"startTime", "=", 
   RowBox[{"TimeObject", "[", "Now", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"at2", "=", 
   RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"residualSingularTerms", "=", 
      RowBox[{"ParallelTable", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"theCycleSize", "=", "$selectedBranchSize"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{
          "\"\<Computing terms at medial precision \>\"", ",", 
           "medialPrecision"}], "]"}], ";", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"singTable", "=", 
          RowBox[{"Table", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Mod", "[", 
                 RowBox[{"k", ",", "25"}], "]"}], "==", "0"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"Print", "[", 
                 RowBox[{"\"\<Current index \>\"", ",", "k"}], "]"}], ";"}]}],
               "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"finalIntVal", "=", 
              RowBox[{"Plus", "@@", 
               RowBox[{"Table", "[", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"NIntegrate", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"polishMedial", "[", 
                    RowBox[{"t", ",", "rationalRNorm", ",", "implicitF", ",", 
                    RowBox[{"lowPrecMedialSol", "[", "t", "]"}], ",", 
                    "medialPrecision"}], "]"}], 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Cos", "[", 
                    RowBox[{"t", " ", 
                    RowBox[{"k", "/", "$selectedBranchSize"}]}], "]"}], "-", 
                    RowBox[{"I", " ", 
                    RowBox[{"Sin", "[", 
                    RowBox[{"t", " ", 
                    RowBox[{"k", "/", "$selectedBranchSize"}]}], "]"}]}]}], 
                    ")"}]}], ",", 
                   RowBox[{"{", 
                    RowBox[{"t", ",", 
                    RowBox[{"thePartitions", "[", 
                    RowBox[{"[", 
                    RowBox[{"index", ",", "1"}], "]"}], "]"}], ",", 
                    RowBox[{"thePartitions", "[", 
                    RowBox[{"[", 
                    RowBox[{"index", ",", "2"}], "]"}], "]"}]}], "}"}], ",", 
                   RowBox[{"Method", "->", 
                    RowBox[{"{", 
                    RowBox[{"\"\<GlobalAdaptive\>\"", ",", 
                    RowBox[{"\"\<MaxErrorIncreases\>\"", "->", "600"}], ",", 
                    RowBox[{"Method", "->", "\"\<LevinRule\>\""}]}], "}"}]}], 
                   ",", 
                   RowBox[{"WorkingPrecision", "->", "medialPrecision"}], ",", 
                   RowBox[{"AccuracyGoal", "->", 
                    RowBox[{"medialPrecision", "/", "2"}]}], ",", 
                   RowBox[{"MaxRecursion", "->", "Infinity"}]}], "]"}], ",", 
                 "\[IndentingNewLine]", 
                 RowBox[{"{", 
                  RowBox[{"index", ",", "1", ",", 
                   RowBox[{"Length", "@", "thePartitions"}]}], "}"}]}], 
                "\[IndentingNewLine]", "]"}]}]}], ";", "\[IndentingNewLine]", 
             "\[IndentingNewLine]", 
             RowBox[{"coef", "=", 
              RowBox[{
               FractionBox["1", 
                RowBox[{"2", " ", "Pi", " ", "$selectedBranchSize", " ", 
                 RowBox[{"rNorm", "^", 
                  RowBox[{"(", 
                   RowBox[{"k", "/", "$selectedBranchSize"}], ")"}]}]}]], 
               "finalIntVal"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"k", "/", "$selectedBranchSize"}], ",", "coef", ",", 
               RowBox[{"N", "[", 
                RowBox[{"coef", ",", "10"}], "]"}], ",", 
               RowBox[{"coef", " ", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"z", "^", 
                   RowBox[{"(", 
                    RowBox[{"1", "/", "$selectedBranchSize"}], ")"}]}], ")"}],
                  "^", "k"}]}]}], "}"}]}], ",", "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{"k", ",", "$singTermMax", ",", "$singTermMin", ",", 
              RowBox[{"-", "1"}]}], "}"}]}], "\[IndentingNewLine]", "]"}]}], 
         ";", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"medialPrecision", ",", "singTable"}], "}"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"medialPrecision", ",", "precisionArray"}], "}"}]}], 
       "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<total time: \>\"", ",", 
    RowBox[{"at2", "[", 
     RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"endTime", "=", 
  RowBox[{"TimeObject", "[", "Now", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Total time: \>\"", ",", 
   RowBox[{"endTime", "-", "startTime"}]}], 
  "]"}], "\[IndentingNewLine]"}], "Input",
