     RowBox[{"reducedAnalyticTerms", "=", 
      RowBox[{"residualAnalyticTerms", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "3"}], "]"}], "]"}]}], ";"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Precision", "@", "reducedAnalyticTerms"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"deleteLen", "=", 
    RowBox[{"Length", "@", "reducedAnalyticTerms"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"deleteLen", ">", "0"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"theExps", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"Exponent", "[", 
           RowBox[{"#", ",", "z"}], "]"}], "&"}], "/@", " ", 
