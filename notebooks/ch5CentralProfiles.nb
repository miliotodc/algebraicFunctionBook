  RowBox[{"polyForm", "[", 
   RowBox[{"poly_", ",", "var_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"coeffs", "=", 
      RowBox[{
       RowBox[{"CoefficientRules", "[", 
        RowBox[{"poly", ",", "var"}], "]"}], "//", "Sort"}]}], "}"}], ",", 
    RowBox[{"Interpretation", "[", 
