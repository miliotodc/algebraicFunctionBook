           "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"wTest", "=", 
         RowBox[{"baseF", "[", "newZ", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"theWList", "=", 
         RowBox[{"w", "/.", 
          RowBox[{"NSolve", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"$theFunction", "==", "0"}], "/.", 
             RowBox[{"z", "->", 
              RowBox[{"(", 
               RowBox[{"singularPoint", "+", "newZ"}], ")"}]}]}], ",", "w", 
            ",", 
            RowBox[{"WorkingPrecision", "->", "wp"}]}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"theDif", "=", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{"wTest", "-", "#"}], "]"}], "&"}], "/@", " ", 
           "theWList"}], ")"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"pos", "=", 
         RowBox[{"Position", "[", 
          RowBox[{"theDif", ",", 
           RowBox[{"Min", "[", "theDif", "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"actW", "=", 
         RowBox[{"theWList", "[", 
          RowBox[{"[", 
           RowBox[{"pos", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "1"}], "]"}], "]"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"seriesW", "=", "wTest"}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"actWChar", "=", 
         RowBox[{"convertToChar", "[", 
          RowBox[{"SetPrecision", "[", 
           RowBox[{
            RowBox[{"type", "@", "actW"}], ",", "wp"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"seriesWChar", "=", 
         RowBox[{"convertToChar", "[", 
          RowBox[{"SetPrecision", "[", 
           RowBox[{
            RowBox[{"type", "@", "seriesW"}], ",", "wp"}], "]"}], "]"}]}], 
        ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Length", "@", "actWChar"}], "<", "charMin"}], "||", " ", 
           RowBox[{
            RowBox[{"Length", "@", "seriesWChar"}], "<", "charMin"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
           "Print", "[", 
            "\"\<actWChar or seriesWChar lenght less than char min: \>\"", 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<actW: \>\"", ",", 
             RowBox[{"N", "[", 
              RowBox[{"actW", ",", "20"}], "]"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<seriesW: \>\"", ",", 
             RowBox[{"N", "[", 
              RowBox[{"seriesW", ",", "20"}], "]"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<actWChar length: \>\"", ",", 
