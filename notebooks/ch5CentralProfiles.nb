              RowBox[{"(", 
               RowBox[{
                SuperscriptBox["z", "2"], "+", 
                RowBox[{"(", 
                 RowBox[{"1", "+", "\[ImaginaryI]"}], ")"}]}], ")"}], "2"]], 
            " ", 
            SqrtBox[
             RowBox[{
              SuperscriptBox["z", "2"], "+", 
              RowBox[{"(", 
               RowBox[{"4", "+", 
                RowBox[{"4", " ", "\[ImaginaryI]"}]}], ")"}]}]]}], "+", 
           RowBox[{
            RowBox[{"(", 
