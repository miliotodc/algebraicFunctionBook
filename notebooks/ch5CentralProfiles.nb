Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"getRationalOrderIndexes", "[", "finalSummaryIndex_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "seriesSize", ",", "cycleExpList", ",", "nearestExpList", ",", 
        "theVals", ",", "nearestExp", ",", "posArray", ",", "pos", ",", 
        "seriesIndex", ",", "maxExp", ",", "nearestIntegerMax", ",", 
        "rationalIndexes"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"seriesIndex", "=", 
        RowBox[{"baseSheetLinks", "[", 
         RowBox[{"[", 
          RowBox[{"finalSummaryIndex", ",", "2", ",", "1"}], "]"}], "]"}]}], 
       ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"seriesSize", "=", 
        RowBox[{"Length", "@", 
         RowBox[{"baseSeries", "[", 
          RowBox[{"[", "seriesIndex", "]"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"cycleExpList", "=", 
        RowBox[{"Exponent", "[", 
         RowBox[{
          RowBox[{"baseSeries", "[", 
           RowBox[{"[", "seriesIndex", "]"}], "]"}], ",", "z", ",", "List"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"maxExp", "=", 
        RowBox[{"cycleExpList", "[", 
         RowBox[{"[", 
          RowBox[{"-", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"nearestIntegerMax", "=", 
        RowBox[{
         RowBox[{"Nearest", "[", 
          RowBox[{"cycleExpList", ",", 
           RowBox[{"Floor", "@", "maxExp"}]}], "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"rationalIndexes", "=", 
        RowBox[{"Table", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"nearestExp", "=", 
            RowBox[{
             RowBox[{"Nearest", "[", 
              RowBox[{"cycleExpList", ",", "orderVal"}], "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"posArray", "=", 
            RowBox[{"Position", "[", 
             RowBox[{"cycleExpList", ",", 
              RowBox[{"x_", "/;", 
               RowBox[{"x", "==", "nearestExp"}]}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Length", "@", "posArray"}], "==", "0"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Print", "[", 
               RowBox[{
                RowBox[{"Style", "[", 
                 RowBox[{"\"\<Error with posArray: \>\"", ",", "Red"}], "]"}],
