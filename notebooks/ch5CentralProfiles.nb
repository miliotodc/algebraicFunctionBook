Cell[TextData[{
 "testCase0019: ",
 Cell[BoxData[
  StyleBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "-", 
      RowBox[{"3", " ", "z"}], "+", 
      RowBox[{"3", " ", 
       SuperscriptBox["z", "2"]}], "-", 
      RowBox[{"1", " ", 
       SuperscriptBox["z", "3"]}]}], ")"}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "4"}], "+", 
       RowBox[{"8", " ", "z"}], "-", 
       RowBox[{"4", " ", 
        SuperscriptBox["z", "2"]}]}], ")"}], " ", "w"}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"6", "-", 
       RowBox[{"6", " ", "z"}]}], ")"}], " ", 
     SuperscriptBox["w", "2"]}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"-", "4"}], ")"}], " ", 
     SuperscriptBox["w", "3"]}], "+", 
    RowBox[{
     RowBox[{"(", "1", ")"}], " ", 
     SuperscriptBox["w", "4"]}]}],
   StripOnInput->False,
   FontSize->10]], "Print",
  CellChangeTimes->{{3.952246878024342*^9, 3.952246909255206*^9}},
  ExpressionUUID->"049857a6-17ff-440f-88b6-01e12741906c"],
 " (polynomial solution at origin)"
}], "Subsection",
