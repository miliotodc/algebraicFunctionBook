               RowBox[{"10", "^", 
                RowBox[{"-", 
                 RowBox[{"(", "duplicateError", ")"}]}]}]}], "&"}]}], "]"}]}],
           ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"zeroIndexes", "=", 
           RowBox[{"Flatten", "[", "\[IndentingNewLine]", 
            RowBox[{"Table", "[", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"dif", "=", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Abs", "[", 
                   RowBox[{
                    RowBox[{"theZeroList", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "-", "#"}], "]"}], "&"}], 
                 "/@", " ", "theSingularList"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"Position", "[", 
                 RowBox[{"dif", ",", 
                  RowBox[{"x_", "/;", 
                   RowBox[{"x", "==", 
                    RowBox[{"Min", "[", "dif", "]"}]}]}]}], "]"}], "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{"i", ",", "1", ",", 
                RowBox[{"Length", "@", "theZeroList"}]}], "}"}]}], 
             "\[IndentingNewLine]", "]"}], "]"}]}], ";"}], 
         "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"zeroIndexes", "=", 
           RowBox[{"{", "}"}]}], ";"}]}], "\[IndentingNewLine]", 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       "zeroIndexes"}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}]], "Input",
