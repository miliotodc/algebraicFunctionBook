Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{
   RowBox[{
    RowBox[{"$theFunction", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"3", " ", "z"}], "+", 
        RowBox[{"3", " ", 
         RowBox[{"z", "^", "2"}]}], "-", 
        RowBox[{"z", "^", "3"}]}], ")"}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "4"}], "+", 
         RowBox[{"8", " ", "z"}], "-", 
         RowBox[{"4", " ", 
          RowBox[{"z", "^", "2"}]}]}], ")"}], "w"}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"6", "-", 
         RowBox[{"6", "z"}]}], ")"}], 
       RowBox[{"w", "^", "2"}]}], "-", 
      RowBox[{"4", " ", 
       RowBox[{"w", "^", "3"}]}], "+", 
      RowBox[{"w", "^", "4"}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"$theTestCase", "=", "\"\<testCase0019\>\""}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"subDirectory", "=", "$theTestCase"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"!", 
       RowBox[{"TrueQ", "@", 
        RowBox[{"FileExistsQ", "@", 
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{"dataDir", ",", "subDirectory"}], "}"}], "]"}]}]}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"CreateDirectory", "[", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{"dataDir", ",", "subDirectory"}], "}"}], "]"}], "]"}], 
       ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Print", "@", 
    RowBox[{"Style", "[", 
     RowBox[{
      RowBox[{"aForm", "[", "$theFunction", "]"}], ",", "10"}], "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wExp", "=", 
     RowBox[{"Exponent", "[", 
      RowBox[{"$theFunction", ",", "w", ",", "List"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"functionDegree", "=", 
    RowBox[{"Last", "@", "wExp"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{"$theFunction", ",", "z"}], "]"}], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"z", "->", "0"}], ",", 
      RowBox[{"w", "->", "0"}]}], "}"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{"$theFunction", ",", "w"}], "]"}], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"z", "->", "0"}], ",", 
      RowBox[{"w", "->", "0"}]}], "}"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fVals", "=", 
     RowBox[{"Sort", "[", 
      RowBox[{"w", "/.", 
       RowBox[{"NSolve", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"$theFunction", "==", "0"}], "/.", 
          RowBox[{"z", "->", "0"}]}], ",", "w"}], "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dVals", "=", 
     RowBox[{"Sort", "[", 
      RowBox[{"w", "/.", 
       RowBox[{"NSolve", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{"$theFunction", ",", "w"}], "]"}], "==", "0"}], "/.", 
          RowBox[{"z", "->", "0"}]}], ",", "w"}], "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "@", 
        RowBox[{"Intersection", "[", 
         RowBox[{"fVals", ",", "dVals"}], "]"}]}], "!=", "0"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"Style", "[", 
         RowBox[{"\"\<Origin is a singular point!\>\"", ",", "Red"}], "]"}], 
        "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]"}]}]], "Input",
