               RowBox[{"k", "++"}], ",", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{
                 RowBox[{"seriesWChar", "[", 
                  RowBox[{"[", "k", "]"}], "]"}], "=", 
                 RowBox[{"Style", "[", 
                  RowBox[{
                   RowBox[{"seriesWChar", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], ",", "Black", ",", 
