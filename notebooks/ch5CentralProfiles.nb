Cell[CellGroupData[{

Cell["getPoles", "Subsection",
 CellChangeTimes->{{3.8943662356980977`*^9, 
  3.8943662371510544`*^9}},ExpressionUUID->"8cc28318-9506-4a7b-9451-\
aaab2e988959"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"getPoles", "[", 
    RowBox[{"theFunction_", ",", "theSingularList_", ",", 
     RowBox[{"diag_", ":", "False"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "wExpList", ",", "poleFunction", ",", "pExp", ",", "singPrecision", ",",
        "thePoles", ",", "polePrecision", ",", "thePoleList", ",", "poleF", 
       ",", "poleIndexes", ",", "difTable", ",", "maxDif", ",", 
       "duplicateError", ",", "pTable", ",", "rootPrecisionTable"}], "}"}], 
     ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"wExpList", "=", 
       RowBox[{"Exponent", "[", 
        RowBox[{"theFunction", ",", "w", ",", "List"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"poleFunction", "=", 
       RowBox[{"Coefficient", "[", 
        RowBox[{"theFunction", ",", "w", ",", 
         RowBox[{"Max", "@", "wExpList"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"pExp", "=", 
       RowBox[{"Exponent", "[", 
        RowBox[{"poleFunction", ",", "z", ",", "List"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"check", " ", "if", " ", "a_n", 
         RowBox[{"(", "z", ")"}], " ", "is", " ", "a", " ", "polynomial", " ",
          "of", " ", "degree"}], ">", "0"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"singPrecision", "=", 
       RowBox[{"Floor", "@", 
        RowBox[{"Precision", "@", "theSingularList"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Last", "@", "pExp"}], ">", "0"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"thePoles", "=", 
          RowBox[{"Sort", "[", 
           RowBox[{
            RowBox[{"z", "/.", 
             RowBox[{"NSolve", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Factor", "@", "poleFunction"}], "\[Equal]", "0"}], 
               ",", "z", ",", 
               RowBox[{"WorkingPrecision", "\[Rule]", "singPrecision"}]}], 
              "]"}]}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"Abs", "@", "#1"}], "<=", 
              RowBox[{"Abs", "@", "#2"}]}], "&"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", "\[IndentingNewLine]", " ", 
          RowBox[{"now", " ", "confirm", " ", "solutions"}], 
          "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"difTable", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"poleFunction", "/.", 
             RowBox[{"z", "->", "#"}]}], "&"}], "/@", " ", "thePoles"}]}], 
         ";", "\[IndentingNewLine]", 
         RowBox[{"rootPrecisionTable", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"Precision", "@", "#"}], "&"}], "/@", " ", "difTable"}]}],
          ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Min", "@", "rootPrecisionTable"}], ">", "10"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"maxDif", "=", 
             RowBox[{"Max", "@", "difTable"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"maxDif", ">", "$maxRootVerifyDifference"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"Print", "[", 
                RowBox[{"Style", "[", 
                 RowBox[{
                 "\"\<Verification of theZeroPoints roots exceeded the \
$maxRootVerifyDifference\>\"", ",", "Red", ",", "Bold"}], "]"}], "]"}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"Print", "[", 
                RowBox[{"\"\<   maxDif: \>\"", ",", 
                 RowBox[{"N", "[", 
                  RowBox[{"maxDif", ",", "20"}], "]"}]}], "]"}], ";"}]}], 
             "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", 
          "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"polePrecision", "=", 
          RowBox[{"Floor", "@", 
           RowBox[{"Precision", "@", "thePoles"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"duplicateError", "=", 
          RowBox[{
           RowBox[{"Min", "[", 
            RowBox[{"polePrecision", ",", "singPrecision"}], "]"}], "-", 
           "$acf"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"thePoleList", "=", 
          RowBox[{"DeleteDuplicates", "[", 
           RowBox[{"thePoles", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{"#1", "-", "#2"}], "]"}], "<", 
              RowBox[{"10", "^", 
               RowBox[{"-", 
                RowBox[{"(", "duplicateError", ")"}]}]}]}], "&"}]}], "]"}]}], 
         ";"}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"thePoleList", "=", 
          RowBox[{"{", "}"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"poleF", "[", "a_", "]"}], ":=", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"#", "-", "a"}], "]"}], "&"}], "/@", " ", 
         "theSingularList"}], ")"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"poleIndexes", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Position", "[", 
           RowBox[{
            RowBox[{"poleF", "[", "#", "]"}], ",", 
            RowBox[{"Min", "[", 
             RowBox[{"poleF", "[", "#", "]"}], "]"}]}], "]"}], "&"}], "/@", 
         " ", "thePoleList"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "poleIndexes"}]}], "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.894365959024037*^9, 3.894366220801469*^9}, {
   3.8943901200342073`*^9, 3.8943901283291583`*^9}, {3.896423333964148*^9, 
   3.896423341837122*^9}, {3.896423409665063*^9, 3.896423441407426*^9}, {
   3.902928831468609*^9, 3.902928832093462*^9}, 3.936947623939025*^9, {
   3.9520925439458313`*^9, 3.952092570537503*^9}, {3.952165381475609*^9, 
   3.9521653814859056`*^9}, {3.9810132764695244`*^9, 3.9810133111241913`*^9}},
 CellLabel->"In[83]:=",ExpressionUUID->"35af7f84-0947-4050-8d28-0a264fa38801"]
}, Closed]],

Cell[CellGroupData[{

Cell["strictPolynomialQ", "Subsection",
 CellChangeTimes->{{3.8893602934364414`*^9, 
  3.8893602965138407`*^9}},ExpressionUUID->"918cfb4b-ac04-48bc-bc50-\
7403a859482f"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"strictPolynomialQ", "[", 
     RowBox[{"myPoly_", ",", 
      RowBox[{"{", 
       RowBox[{"x_", ",", "y_"}], "}"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"levels", ",", "cList", ",", "finalList", ",", "return"}], 
       "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"PolynomialQ", "[", 
          RowBox[{"myPoly", ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", "y"}], "}"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"levels", "=", 
           RowBox[{"Level", "[", 
            RowBox[{"myPoly", ",", 
             RowBox[{"{", 
              RowBox[{"-", "1"}], "}"}], ",", 
             RowBox[{"Heads", "->", "True"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Length", "@", 
               RowBox[{"Position", "[", 
                RowBox[{"levels", ",", "x"}], "]"}]}], ">", "0"}], " ", "&&", 
             " ", 
             RowBox[{
              RowBox[{"Length", "@", 
               RowBox[{"Position", "[", 
                RowBox[{"levels", ",", "y"}], "]"}]}], ">", "0"}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"cList", "=", 
              RowBox[{"Complement", "[", 
               RowBox[{"levels", ",", 
                RowBox[{"{", 
                 RowBox[{
                 "Plus", ",", "Power", ",", "Times", ",", "x", ",", "y"}], 
                 "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"finalList", "=", 
              RowBox[{"Complement", "[", 
               RowBox[{"cList", ",", 
                RowBox[{"Select", "[", 
                 RowBox[{"cList", ",", "NumberQ"}], "]"}]}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Length", "@", "finalList"}], ">", "0"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"Print", "[", 
                 RowBox[{
                  RowBox[{"Style", "[", 
                   RowBox[{
                   "\"\<expression is not strict polynomial in \>\"", ",", 
                    "Red"}], "]"}], ",", 
                  RowBox[{"Style", "[", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"x", ",", "y"}], "}"}], ",", "Red"}], "]"}]}], 
                 "]"}], ";", "\[IndentingNewLine]", 
                RowBox[{"return", "=", "False"}], ";"}], 
               "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"return", "=", "True"}], ";"}]}], 
              "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", ",",
             "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{
               RowBox[{"Style", "[", 
                RowBox[{
                "\"\<expression is not strict polynomial in \>\"", ",", 
                 "Red"}], "]"}], ",", 
               RowBox[{"Style", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"x", ",", "y"}], "}"}], ",", "Red"}], "]"}]}], 
              "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"return", "=", "False"}], ";"}]}], "\[IndentingNewLine]",
            "]"}], ";"}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"return", "=", "False"}], ";"}]}], "\[IndentingNewLine]", 
        "]"}], ";", "\[IndentingNewLine]", "return"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.8893602992317033`*^9, 3.8893603006690025`*^9}, {
  3.8893630345963316`*^9, 3.8893630418912425`*^9}, {3.894371500481982*^9, 
  3.8943715009192405`*^9}, {3.8970419131913157`*^9, 3.897041953096331*^9}},
 CellLabel->"In[84]:=",ExpressionUUID->"e0a064d8-105b-4602-afda-1be88a417aef"]
}, Closed]],

