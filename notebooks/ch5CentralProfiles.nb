            "$acf"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"theZeroList", "=", 
           RowBox[{"DeleteDuplicates", "[", 
            RowBox[{"theZeroPoints", ",", 
             RowBox[{
              RowBox[{
               RowBox[{"Abs", "[", 
