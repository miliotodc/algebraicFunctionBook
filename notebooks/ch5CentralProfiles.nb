Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"getInvalidRecs", "[", 
     RowBox[{"sheetIndex_", ",", "radiusIndex_", ",", "arcIndex_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "sheetData", ",", "radiusData", ",", "circleData", ",", "arcData", ",",
         "invalidTerms", ",", "seriesData", ",", "validRecs", ",", 
        "invalidRecs", ",", "radiusRatio"}], "}"}], ",", 
      "\[IndentingNewLine]", " ", 
      RowBox[{
       RowBox[{"sheetData", "=", 
        RowBox[{"sheetAccuracyTable", "[", 
         RowBox[{"[", "sheetIndex", "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "radiusData", " ", "holds", " ", "all", " ", "data", " ", "for", " ", 
         "this", " ", "current", " ", "radius", " ", "index"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"radiusData", "=", 
        RowBox[{"sheetData", "[", 
         RowBox[{"[", "radiusIndex", "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
