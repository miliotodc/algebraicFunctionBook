Cell[CellGroupData[{

Cell["Section 8:  Check fit models", "Section",
 CellChangeTimes->{{3.9344474499867935`*^9, 3.9344474572507567`*^9}, 
   3.9391357643342233`*^9, {3.9538133450035644`*^9, 3.953813351464604*^9}, {
   3.981110694433279*^9, 3.9811106947890453`*^9}, {3.981964341336895*^9, 
   3.9819643465558243`*^9}},ExpressionUUID->"e7a962a8-2969-448f-ba4d-\
d0305fb092b2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
   "routine", " ", "to", " ", "check", " ", "accuracy", " ", "functions"}], 
   "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", " ", 
  RowBox[{
   RowBox[{"sumIndex", "=", "summaryReportIndex"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"theRatio", "=", 
     RowBox[{"1", "/", "3"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"desiredAccuracy", "=", "100"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"genIndex", "=", 
     RowBox[{"baseSheetLinks", "[", 
      RowBox[{"[", 
       RowBox[{"sumIndex", ",", "2", ",", "1"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<baseSheetLinks: \>\"", ",", 
      RowBox[{"baseSheetLinks", "[", 
       RowBox[{"[", 
        RowBox[{"sumIndex", ",", "2"}], "]"}], "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"clsp", "=", 
     RowBox[{"seriesSummaryReport", "[", 
      RowBox[{"[", 
       RowBox[{"sumIndex", ",", "5"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"bigR", "=", 
     RowBox[{"Abs", "[", 
      RowBox[{"baseSingularPoint", "-", 
       RowBox[{"$theSingularList", "[", 
        RowBox[{"[", "clsp", "]"}], "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<bigR: \>\"", ",", 
      RowBox[{"bigR", "//", "N"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"zVal", "=", 
     RowBox[{"theRatio", " ", "bigR", " ", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"RandomChoice", "[", "argList", "]"}], " ", "I"}], "]"}]}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<zVal: \>\"", ",", 
      RowBox[{"N", "[", 
       RowBox[{"zVal", ",", "10"}], "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wVals", "=", 
     RowBox[{"w", "/.", 
      RowBox[{"NSolve", "[", 
       RowBox[{
        RowBox[{"$theFunction", "/.", 
         RowBox[{"z", "->", 
          RowBox[{"(", 
           RowBox[{"baseSingularPoint", "+", "zVal"}], ")"}]}]}], ",", "w", 
        ",", 
        RowBox[{"WorkingPrecision", "->", "500"}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"accuracyF", "[", 
      RowBox[{"r_", ",", "ord_"}], "]"}], "=", 
     RowBox[{"accuracyModels", "[", 
      RowBox[{"[", 
       RowBox[{"sumIndex", ",", "9"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Accuracy function: \>\"", ",", 
      RowBox[{
       RowBox[{"accuracyF", "[", 
        RowBox[{"r", ",", "ord"}], "]"}], "//", "N"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"orderF", "[", 
     RowBox[{"r_", ",", "a_"}], "]"}], "=", 
    RowBox[{"accuracyModels", "[", 
     RowBox[{"[", 
      RowBox[{"sumIndex", ",", "10"}], "]"}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<orderF[r,a]: \>\"", ",", 
      RowBox[{"orderF", "[", 
       RowBox[{"r", ",", "a"}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"requiredOrder", "=", 
     RowBox[{"orderF", "[", 
      RowBox[{"theRatio", ",", "desiredAccuracy"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fitAccG", "=", 
     RowBox[{"Graphics3D", "@", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"PointSize", "[", "0.025", "]"}], ",", "Green", ",", 
