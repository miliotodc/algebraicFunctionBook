              RowBox[{"theVals", "=", 
               RowBox[{"{", 
                RowBox[{"\"\<eb\>\"", ",", "\"\<eb\>\"", ",", "\"\<eb\>\""}], 
                "}"}]}], ";"}], "\[IndentingNewLine]", ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"pos", "=", 
               RowBox[{"posArray", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"theVals", "=", 
               RowBox[{"{", 
                RowBox[{"orderVal", ",", "pos", ",", 
                 RowBox[{"cycleExpList", "[", 
                  RowBox[{"[", "pos", "]"}], "]"}]}], "}"}]}], ";"}]}], 
            "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
           "theVals"}], ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"orderVal", ",", "1", ",", "nearestIntegerMax"}], "}"}]}], 
         "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
       "rationalIndexes"}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
