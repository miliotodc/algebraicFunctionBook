Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"$workingPrecision", "=", "1000"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"at", "=", 
     RowBox[{"AbsoluteTiming", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "$theSingularList", ",", "$poleIndexes", ",", "$minRadiusArray", ",",
           "res", ",", "$zeroIndexes", ",", "$nearestDistanceArray", ",", 
          "$rNormArray"}], "}"}], "=", 
        RowBox[{"getSingularPoints", "[", 
         RowBox[{"$theFunction", ",", "$workingPrecision", ",", "True"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"$theSingularList", "==", "\"\<-1\>\""}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"Style", "[", 
            RowBox[{
            "\"\<Encountered error with getSingular Points!\>\"", ",", 
             "Red"}], "]"}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"Abort", "[", "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], 
       ";"}], "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"$singularPerimeters", "=", "$minRadiusArray"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"$singularNorms", "=", "$rNormArray"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"$singularDistances", "=", "$nearestDistanceArray"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{
    "add", " ", "0", " ", "for", " ", "TestCase0006", " ", "for", " ", 
     "book"}], "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"subDirectory", "==", "\"\<testCase0006\>\""}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"PrependTo", "[", 
         RowBox[{"$theSingularList", ",", "0"}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"$minRadiusArray", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"1", "/", "3"}], ",", 
           RowBox[{"1", "/", "3"}], ",", 
           RowBox[{"1", "/", "3"}]}], "}"}]}], ";"}]}], "\[IndentingNewLine]",
       "]"}], ";"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{"add", " ", "0", " ", "for", " ", "testCaseFInif"}], 
    "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"subDirectory", "==", "\"\<testCaseFInif\>\""}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"PrependTo", "[", 
         RowBox[{"$theSingularList", ",", "0"}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"$minRadiusArray", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"1", "/", "3"}], ",", 
           RowBox[{"1", "/", "3"}], ",", 
           RowBox[{"1", "/", "3"}]}], "}"}]}], ";"}]}], "\[IndentingNewLine]",
       "]"}], ";"}], "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"subDirectory", "==", "\"\<testCase0001Inf0\>\""}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"singPerim", "=", 
        RowBox[{
         RowBox[{"1", "/", "3"}], " ", 
         RowBox[{"Abs", "[", 
          RowBox[{"$theSingularList", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"PrependTo", "[", 
        RowBox[{"$theSingularList", ",", "0"}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"$minRadiusArray", "=", 
        RowBox[{"{", 
         RowBox[{"singPerim", ",", "singPerim", ",", "singPerim"}], "}"}]}], 
       ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"subDirectory", "==", "\"\<testCase0400\>\""}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"$theSingularList", "=", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"$minRadiusArray", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"1", "/", "3"}], ",", 
          RowBox[{"1", "/", "3"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"$poleIndexes", "=", 
        RowBox[{"{", "}"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Total singular points: \>\"", ",", 
      RowBox[{"Length", "@", "$theSingularList"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{
      RowBox[{"Style", "[", 
       RowBox[{
       "\"\<Time to compute singular points: \>\"", ",", "Red", ",", "Bold"}],
        "]"}], ",", 
      RowBox[{"at", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"singPrec", "=", 
     RowBox[{"Floor", "@", 
      RowBox[{"Precision", "@", "$theSingularList"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"$theSingularList", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "]"}], "<", 
       RowBox[{"10", "^", 
        RowBox[{"(", 
         RowBox[{"-", 
          RowBox[{"(", 
           RowBox[{"singPrec", "-", "$acf"}], ")"}]}], ")"}]}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"Style", "[", 
         RowBox[{
         "\"\<Zero is a singular point\>\"", ",", "Bold", ",", "Red"}], "]"}],
         "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "@", "$theSingularList"}], ">", "1"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"minSingSeparation", "=", 
        RowBox[{
         RowBox[{"3", 
          RowBox[{"Min", "@", "$minRadiusArray"}]}], "//", "N"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"minSingAccFactor", "=", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{
           RowBox[{"MantissaExponent", "[", "minSingSeparation", "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], "+", "5"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<minSingAccFactor: \>\"", ",", "minSingAccFactor"}], 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{"$theSingularList", "[", 
          RowBox[{"[", 
           RowBox[{"1", ";;", "2"}], "]"}], "]"}], ",", "20"}], "]"}], 
       ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{"Export", "[", 
     RowBox[{
      RowBox[{"singularDataFileName", "[", "$theTestCase", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{
       "$theSingularList", ",", "$poleIndexes", ",", "$minRadiusArray", ",", 
        "res", ",", "$zeroIndexes", ",", "$nearestDistanceArray", ",", 
        "$rNormArray"}], "}"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Export", "[", 
     RowBox[{
      RowBox[{"resultantFileName", "[", "$theTestCase", "]"}], ",", "res"}], 
     "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"aForm", "[", "$theFunction", "]"}], "\[IndentingNewLine]", 
   RowBox[{"Grid", "[", "g2", "]"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]"}]}]], "Input",
