Cell["Section 9.3:  Check accuracy interpolation I_z(r_f,0)", "Subsection",
 CellChangeTimes->{{3.9395547791427116`*^9, 3.9395547879218903`*^9}, {
  3.9819657177718225`*^9, 3.981965722353961*^9}, {3.9819657821215525`*^9, 
  3.981965803679701*^9}},ExpressionUUID->"b9f005ab-dd8b-47b9-b9c8-\
06079ae9071c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
   "routine", " ", "to", " ", "check", " ", "accuracy", " ", "functions"}], 
   "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"sumIndex", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"theRatio", "=", 
     RowBox[{"3", "/", "10"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"theOrder", "=", "75"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
      "routine", " ", "to", " ", "estimate", " ", "accuracy", " ", "of", " ", 
       "selected", " ", "series", " ", "at", " ", "r_f"}], "=", "theRatio"}], 
     ",", " ", 
     RowBox[{
      RowBox[{"and", " ", "order"}], "=", 
      RowBox[{
      "theOrder", " ", "and", " ", "check", " ", "against", " ", "actual", 
       " ", "accuracy", " ", "of", " ", "series"}]}]}], "\[IndentingNewLine]",
     "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"genIndex", "=", 
    RowBox[{"baseSheetLinks", "[", 
     RowBox[{"[", 
      RowBox[{"sumIndex", ",", "2", ",", "1"}], "]"}], "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"clsp", "=", 
     RowBox[{"seriesSummaryReport", "[", 
      RowBox[{"[", 
       RowBox[{"sumIndex", ",", "5"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"bigR", "=", 
     RowBox[{"Abs", "[", 
      RowBox[{"baseSingularPoint", "-", 
       RowBox[{"$theSingularList", "[", 
        RowBox[{"[", "clsp", "]"}], "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"zVal", "=", 
     RowBox[{"theRatio", " ", "bigR", " ", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"RandomChoice", "[", "argList", "]"}], " ", "I"}], "]"}]}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<zVal: \>\"", ",", 
      RowBox[{"N", "[", 
       RowBox[{"zVal", ",", "10"}], "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wVals", "=", 
     RowBox[{"w", "/.", 
      RowBox[{"NSolve", "[", 
       RowBox[{
        RowBox[{"$theFunction", "/.", 
         RowBox[{"z", "->", 
          RowBox[{"(", 
           RowBox[{"baseSingularPoint", "+", "zVal"}], ")"}]}]}], ",", "w", 
        ",", 
        RowBox[{"WorkingPrecision", "->", "500"}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"estAcc", "=", 
     RowBox[{"intFA", "[", 
      RowBox[{"theRatio", ",", "theOrder"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<estAcc: \>\"", ",", 
      RowBox[{"estAcc", "//", "N"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"estAccPoint", "=", 
     RowBox[{"{", 
      RowBox[{"theRatio", ",", "theOrder", ",", "estAcc"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"estAccPoint3D", "=", 
     RowBox[{"Graphics3D", "@", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"PointSize", "[", "0.025", "]"}], ",", "Red", ",", 
        RowBox[{"Point", "@", "estAccPoint"}]}], "}"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"accData", "=", 
    RowBox[{"getOrderIndex3", "[", 
     RowBox[{"theOrder", ",", "seriesSummaryReport", ",", "sumIndex"}], 
     "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pVal", "=", 
     RowBox[{
      RowBox[{"baseSeries", "[", 
       RowBox[{"[", 
        RowBox[{"sumIndex", ",", 
         RowBox[{"1", ";;", 
          RowBox[{"accData", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}]}], "]"}], "]"}], "/.", 
      RowBox[{"z", "->", "zVal"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<wVals: \>\"", ",", 
      RowBox[{"wVals", "//", "N"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<pVal: \>\"", ",", 
      RowBox[{"pVal", "//", "N"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"difTable", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"#", "-", "pVal"}], "]"}], "&"}], "/@", " ", "wVals"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"difTable", "//", "N"}], "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"posArray", "=", 
     RowBox[{"Position", "[", 
      RowBox[{"wVals", ",", 
       RowBox[{"x_", "/;", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"x", "-", "pVal"}], "]"}], "<", 
         RowBox[{"10", "^", 
          RowBox[{"-", "10"}]}]}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"actualAccuracy", "=", 
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{"wVals", "[", 
        RowBox[{"[", 
         RowBox[{"posArray", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "1"}], "]"}], "]"}], "]"}], "]"}], "-", "pVal"}],
       "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Actual accuracy: \>\"", ",", 
      RowBox[{"-", 
       RowBox[{
        RowBox[{"MantissaExponent", "[", "actualAccuracy", "]"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}]}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"actAccuracy", "=", 
     RowBox[{"-", 
      RowBox[{
       RowBox[{"MantissaExponent", "[", "actualAccuracy", "]"}], "[", 
       RowBox[{"[", "2", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"actAccPoint", "=", 
     RowBox[{"{", 
      RowBox[{"theRatio", ",", "requiredOrder", ",", "actAccuracy"}], "}"}]}],
     ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"actAccPoint3D", "=", 
     RowBox[{"Graphics3D", "@", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"PointSize", "[", "0.025", "]"}], ",", "Blue", ",", 
        RowBox[{"Point", "@", "actAccPoint"}]}], "}"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Show", "[", 
    RowBox[{"{", 
     RowBox[{
     "accuracyPoints3DPlot", ",", "interpolationPlot", ",", "estAccPoint3D"}],
      "}"}], "]"}], "\[IndentingNewLine]", "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.9395547693793864`*^9, 3.939554769769773*^9}, {
   3.93955482052355*^9, 3.939554932076064*^9}, {3.9395549711135654`*^9, 
   3.9395549740348897`*^9}, {3.939555012666435*^9, 3.939555056031149*^9}, {
   3.939555102801179*^9, 3.939555150805581*^9}, 3.939555255922183*^9, {
