Cell[CellGroupData[{

Cell["accuracyInterpolation", "Subsection",
 CellChangeTimes->{{3.9395513702322226`*^9, 
  3.9395513734501514`*^9}},ExpressionUUID->"c225e59f-cdb2-4fd0-b8d4-\
30fcb62c7384"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"accuracyInterpolation", "[", 
     RowBox[{
     "finalSummary_", ",", "baseSeries_", ",", "baseSingularPoint_", ",", 
      "theSingularList_", ",", "summaryReportIndex_", ",", 
      "radiusRatioArraySize_", ",", "orderArraySize_", ",", "theta_"}], "]"}],
     ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "theOrders", ",", "orderStart", ",", "orderEnd", ",", "theR", ",", 
        "theRadiusArray", ",", "theOrderArray", ",", "generatorIndex", ",", 
        "theTheta", ",", "radiusIndex", ",", "plotTable", ",", 
        "theOrderErrorTable", ",", "theRadius", ",", "zVal", ",", "pVal", ",",
         "wVals", ",", "wValsPrec", ",", "errTable", ",", "minError", ",", 
        "pos", ",", "cTable", ",", "dataVals", ",", "plotXStart", ",", 
        "plotXEnd", ",", "linearLine", ",", "quadraticLine", ",", "cubicLine",
         ",", "linearResidue", ",", "cubicResidue", ",", "quadraticResidue", 
        ",", "residueSet", ",", "functionList", ",", "bestPos", ",", 
        "bestUpperFitPlot", ",", "bestUpperFitFunction", ",", 
        "bestLowerFitPlot", ",", "bestLowFitFunction", ",", "bestFitPos", ",",
         "bestLowerFitFunction", ",", "lowerFitData", ",", "c0", ",", "c1", 
        ",", "c2", ",", "c3"}], "}"}], ",", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"theOrders", "=", 
        RowBox[{"getOrderIndexes", "[", 
         RowBox[{"baseSeries", "[", 
          RowBox[{"[", 
           RowBox[{"finalSummary", "[", 
            RowBox[{"[", 
             RowBox[{"summaryReportIndex", ",", "4"}], "]"}], "]"}], "]"}], 
          "]"}], "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"orderStart", "=", 
        RowBox[{"theOrders", "[", 
         RowBox[{"[", 
          RowBox[{"25", ",", "1"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"orderEnd", "=", 
        RowBox[{"theOrders", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"theR", "=", 
        RowBox[{"Abs", "[", 
         RowBox[{"baseSingularPoint", "-", 
          RowBox[{"theSingularList", "[", 
           RowBox[{"[", 
            RowBox[{"finalSummary", "[", 
             RowBox[{"[", 
              RowBox[{"summaryReportIndex", ",", "5"}], "]"}], "]"}], "]"}], 
           "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"theRadiusArray", "=", 
        RowBox[{"Array", "[", 
         RowBox[{
          RowBox[{"#", "&"}], ",", "radiusRatioArraySize", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"1", "/", "10"}], ",", 
            RowBox[{"9", "/", "10"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<theRadiusArray: \>\"", ",", "theRadiusArray"}], "]"}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"theOrderArray", "=", 
        RowBox[{"DeleteDuplicates", "@", 
         RowBox[{"Array", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Floor", "@", "#"}], "&"}], ",", "orderArraySize", ",", 
           RowBox[{"{", 
            RowBox[{"orderStart", ",", "orderEnd"}], "}"}]}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<theOrderArray: \>\"", ",", "theOrderArray"}], "]"}], ";",
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"generatorIndex", "=", 
        RowBox[{"finalSummary", "[", 
         RowBox[{"[", 
          RowBox[{"summaryReportIndex", ",", "4"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"theTheta", "=", 
        RowBox[{"SetPrecision", "[", 
         RowBox[{
          RowBox[{"Rationalize", "[", 
           RowBox[{"theta", ",", "0"}], "]"}], ",", "1000"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"branchName", "=", 
        RowBox[{"finalSummary", "[", 
         RowBox[{"[", 
          RowBox[{"summaryReportIndex", ",", "2"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Analyzing branch \>\"", ",", "branchName"}], "]"}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"radiusIndex", "=", "0"}], ";", "\[IndentingNewLine]", 
       RowBox[{"plotTable", "=", 
        RowBox[{"Table", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"radiusIndex", "++"}], ";", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Mod", "[", 
               RowBox[{"radiusIndex", ",", "1"}], "]"}], "==", "0"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Print", "[", 
               RowBox[{"\"\<rIndex: \>\"", ",", "radiusIndex"}], "]"}], 
              ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
           "\[IndentingNewLine]", " ", 
           RowBox[{"theOrderErrorTable", "=", 
            RowBox[{"Table", "[", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"theRadius", "=", 
                RowBox[{"radiusRatio", " ", "theR"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"zVal", "=", 
                RowBox[{"SetPrecision", "[", 
                 RowBox[{
                  RowBox[{"theRadius", " ", 
                   RowBox[{"Exp", "[", 
                    RowBox[{"I", " ", 
                    RowBox[{"(", "theTheta", ")"}]}], "]"}]}], ",", "1000"}], 
                 "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
               RowBox[{"pVal", "=", 
                RowBox[{
                 RowBox[{"baseSeries", "[", 
                  RowBox[{"[", 
                   RowBox[{"generatorIndex", ",", 
                    RowBox[{"1", ";;", 
                    RowBox[{"theOrders", "[", 
                    RowBox[{"[", 
                    RowBox[{"orderIndex", ",", "2"}], "]"}], "]"}]}]}], "]"}],
                   "]"}], "/.", 
                 RowBox[{"z", "->", "zVal"}]}]}], ";", "\[IndentingNewLine]", 
               "\[IndentingNewLine]", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"orderIndex", "==", 
                  RowBox[{"theOrderArray", "[", 
                   RowBox[{"[", "1", "]"}], "]"}]}], ",", 
                 "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"wVals", "=", 
                   RowBox[{"w", "/.", 
                    RowBox[{"NSolve", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"$theFunction", "==", "0"}], "/.", 
                    RowBox[{"z", "->", 
                    RowBox[{"(", 
                    RowBox[{"baseSingularPoint", "+", "zVal"}], ")"}]}]}], 
                    ",", 
                    RowBox[{"WorkingPrecision", "->", 
                    RowBox[{"Floor", "@", 
                    RowBox[{"Precision", "@", "baseSeries"}]}]}]}], "]"}]}]}],
                   ";", "\[IndentingNewLine]", 
                  RowBox[{"wValsPrec", "=", 
                   RowBox[{"Floor", "@", 
                    RowBox[{"Precision", "@", "wVals"}]}]}], ";"}]}], 
                "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
               RowBox[{"errTable", "=", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Abs", "[", 
                   RowBox[{"#", "-", "pVal"}], "]"}], "&"}], "/@", " ", 
                 "wVals"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"minError", "=", 
                RowBox[{"Min", "@", "errTable"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"minError", "<", 
                  RowBox[{"10", "^", 
                   RowBox[{"-", 
                    RowBox[{"(", 
                    RowBox[{"wValsPrec", "-", "50"}], ")"}]}]}]}], ",", 
                 "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"Print", "[", 
                   RowBox[{"Style", "[", 
                    RowBox[{
                    "\"\<Minimum difference approaching working \
precision\>\"", ",", "Red"}], "]"}], "]"}], ";", "\[IndentingNewLine]", 
                  RowBox[{"Print", "[", 
                   RowBox[{"\"\<minError: \>\"", ",", 
                    RowBox[{"N", "[", 
                    RowBox[{"minError", ",", "10"}], "]"}]}], "]"}], ";"}]}], 
                "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
               RowBox[{"pos", "=", 
                RowBox[{
                 RowBox[{"Position", "[", 
                  RowBox[{"errTable", ",", 
                   RowBox[{"Min", "[", "errTable", "]"}]}], "]"}], "[", 
                 RowBox[{"[", 
                  RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"(*", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"radiusRatios", "[", 
                    RowBox[{"[", "n", "]"}], "]"}], ",", 
                   RowBox[{
                    RowBox[{"errTable", "[", 
                    RowBox[{"[", "pos", "]"}], "]"}], "//", "N"}], ",", 
                   RowBox[{"-", 
                    RowBox[{
                    RowBox[{"MantissaExponent", "[", 
                    RowBox[{"errTable", "[", 
                    RowBox[{"[", "pos", "]"}], "]"}], "]"}], "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], ","}], "*)"}], 
               "\[IndentingNewLine]", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Precision", "@", 
                   RowBox[{"errTable", "[", 
                    RowBox[{"[", "pos", "]"}], "]"}]}], "<", "10"}], ",", 
                 "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"Print", "[", 
                   RowBox[{"Style", "[", 
                    RowBox[{
                    "\"\<Minimum difference precision approaching zero\>\"", 
                    ",", "Red"}], "]"}], "]"}], ";", "\[IndentingNewLine]", 
                  RowBox[{"Print", "[", 
                   RowBox[{"Style", "[", 
                    RowBox[{
                    "\"\<Flagging maximum accuracy point NULL\>\"", ",", 
                    "Red"}], "]"}], "]"}], ";", "\[IndentingNewLine]", 
                  RowBox[{"{", 
                   RowBox[{
                   "radiusRatio", ",", "orderIndex", ",", "\"\<np\>\""}], 
                   "}"}]}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
                 RowBox[{"{", 
                  RowBox[{"radiusRatio", ",", "orderIndex", ",", 
                   RowBox[{"-", 
                    RowBox[{"Log", "[", 
                    RowBox[{"10", ",", 
                    RowBox[{"errTable", "[", 
                    RowBox[{"[", "pos", "]"}], "]"}]}], "]"}]}]}], "}"}]}], 
                "\[IndentingNewLine]", "]"}]}], ",", "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{"orderIndex", ",", "theOrderArray"}], "}"}]}], 
             "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"cTable", "=", 
            RowBox[{
             RowBox[{"theOrderErrorTable", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", 
                RowBox[{"{", 
                 RowBox[{"2", ",", "3"}], "}"}]}], "]"}], "]"}], "//", 
             "N"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"dataVals", "=", "cTable"}], ";", "\[IndentingNewLine]", 
           RowBox[{"plotXStart", "=", 
            RowBox[{"cTable", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"plotXEnd", "=", 
            RowBox[{"cTable", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"-", "1"}], ",", "1"}], "]"}], "]"}]}], ";", 
           "\[IndentingNewLine]", " ", 
           RowBox[{"(*", " ", "\[IndentingNewLine]", "   ", 
            RowBox[{
            "Fit", " ", "data", " ", "to", " ", "upper", " ", "minimize", " ",
              "function"}], "\[IndentingNewLine]", " ", "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{"linearLine", "=", 
            RowBox[{
             RowBox[{
              RowBox[{"c0", "+", 
               RowBox[{"c1", " ", "x"}]}], "/.", " ", 
              RowBox[{
               RowBox[{"NMinimize", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"Total", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"Abs", "[", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "-", 
                    RowBox[{"(", 
                    RowBox[{"c0", "+", 
                    RowBox[{"c1", " ", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}]}], ")"}]}], "]"}], ")"}],
                     "&"}], "/@", "dataVals"}], "]"}], ",", 
                   RowBox[{"And", "@@", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"c0", "+", 
                    RowBox[{"c1", " ", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}]}], ")"}], ">=", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "&"}], "/@", " ",
                     "dataVals"}], ")"}]}]}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"c0", ",", "c1"}], "}"}]}], "]"}], "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], "//", "N"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"quadraticLine", "=", 
            RowBox[{
             RowBox[{
              RowBox[{"c0", "+", 
               RowBox[{"c1", " ", "x"}], "+", 
               RowBox[{"c2", " ", 
                RowBox[{"x", "^", "2"}]}]}], "/.", " ", 
              RowBox[{
               RowBox[{"NMinimize", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"Total", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"Abs", "[", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "-", 
                    RowBox[{"(", 
                    RowBox[{"c0", "+", 
                    RowBox[{"c1", " ", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "+", 
                    RowBox[{"c2", " ", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "^", "2"}]}]}], ")"}]}], 
                    "]"}], ")"}], "&"}], "/@", " ", "dataVals"}], "]"}], ",", 
                   RowBox[{"And", "@@", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"c0", "+", 
                    RowBox[{"c1", " ", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "+", 
                    RowBox[{"c2", " ", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "^", "2"}]}]}], ")"}], ">=", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "&"}], "/@", " ",
                     "dataVals"}], ")"}]}]}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"c0", ",", "c1", ",", "c2"}], "}"}]}], "]"}], "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], "//", "N"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"cubicLine", "=", 
            RowBox[{
             RowBox[{"c0", "+", 
              RowBox[{"c1", " ", "x"}], "+", 
              RowBox[{"c2", " ", 
               RowBox[{"x", "^", "2"}]}], "+", 
              RowBox[{"c3", " ", 
               RowBox[{"x", "^", "3"}]}]}], "/.", " ", 
             RowBox[{
              RowBox[{"NMinimize", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"Total", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"Abs", "[", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "-", 
                    RowBox[{"(", 
                    RowBox[{"c0", "+", 
                    RowBox[{"c1", " ", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "+", 
                    RowBox[{"c2", " ", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "^", "2"}]}], "+", 
                    RowBox[{"c3", " ", 
                    RowBox[{
