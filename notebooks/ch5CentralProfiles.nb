      RowBox[{
       RowBox[{"(", 
        RowBox[{"7", "-", 
         RowBox[{"2", " ", "z"}], "-", 
         RowBox[{"4", " ", 
          RowBox[{"z", "^", "2"}]}], "-", 
         RowBox[{"z", "^", "3"}]}], ")"}], 
       RowBox[{"w", "^", "2"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"7", " ", "z"}], "-", 
         RowBox[{"2", " ", 
          RowBox[{"z", "^", "3"}]}]}], ")"}], 
       RowBox[{"w", "^", "3"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cList", "=", 
     RowBox[{"CoefficientList", "[", 
      RowBox[{"$theFunction", ",", "w"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"maxZ", "=", 
     RowBox[{"Max", "@", 
      RowBox[{"Flatten", "@", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"Exponent", "[", 
           RowBox[{"#", ",", "z", ",", "List"}], "]"}], "&"}], "/@", " ", 
         "cList"}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"newFunction", "=", 
     RowBox[{"Expand", "[", 
      RowBox[{
       RowBox[{"z", "^", "maxZ"}], 
       RowBox[{"(", 
        RowBox[{"$theFunction", "/.", 
         RowBox[{"z", "->", 
          RowBox[{"1", "/", "z"}]}]}], ")"}]}], "]"}]}], ";"}], 
