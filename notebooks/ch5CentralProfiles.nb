              RowBox[{"{", 
               RowBox[{"index", ",", "expInc", ",", 
                RowBox[{"Length", "@", "ePos"}], ",", "expInc"}], "}"}]}], 
             "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"correctNumber", "=", 
            RowBox[{"type", "@", 
             RowBox[{"SetPrecision", "[", " ", 
              RowBox[{"actW", ",", "wp"}], "]"}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"correctChar", "=", 
            RowBox[{"convertToChar", "[", "correctNumber", "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"cTable2", "=", 
            RowBox[{"Table", "[", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"maxCharIndex", "=", "0"}], ";", "\[IndentingNewLine]", 
               RowBox[{"testNumber", "=", 
                RowBox[{"errTable", "[", 
                 RowBox[{"[", 
                  RowBox[{"sIndex", ",", "2"}], "]"}], "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"testChar", "=", 
                RowBox[{"convertToChar", "[", "testNumber", "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"maxCharLen2", "=", 
                RowBox[{"Min", "@", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"Length", "@", "testChar"}], ",", "maxCharLen"}], 
                  "}"}]}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"i", "=", "1"}], ";", "\[IndentingNewLine]", 
               RowBox[{"While", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"correctChar", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "==", 
                   RowBox[{"testChar", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], " ", "&&", " ", 
                  RowBox[{"i", "<", "maxCharLen2"}]}], ",", 
                 "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"i", "++"}], ";"}]}], "\[IndentingNewLine]", "]"}], 
               ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"i", "==", "maxCharLen"}], ",", 
                 "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"Print", "[", 
                   RowBox[{
                    RowBox[{"Style", "[", 
                    RowBox[{"\"\<maxCharLen reached: \>\"", ",", "Red"}], 
                    "]"}], ",", 
                    RowBox[{"Style", "[", 
                    RowBox[{"maxCharLen", ",", "Red"}], "]"}]}], "]"}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"maxCharFlag", "=", "True"}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"maxCharIndex", "=", "sIndex"}], ";"}]}], 
                "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
               RowBox[{"(*", "\[IndentingNewLine]", " ", 
                RowBox[{"now", " ", "find", " ", "decimal", " ", "point"}], 
                "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
               RowBox[{"decimalPosList", "=", 
                RowBox[{"Position", "[", 
                 RowBox[{"testChar", ",", 
                  RowBox[{"x_", "/;", 
                   RowBox[{"x", "==", "\"\<.\>\""}]}]}], "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Length", "@", "decimalPosList"}], "==", "0"}], ",",
                  "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"Print", "[", 
                   RowBox[{"Style", "[", 
                    RowBox[{
                    "\"\<error with decimal location\>\"", ",", "Red"}], 
                    "]"}], "]"}], ";", "\[IndentingNewLine]", 
                  RowBox[{"aDigits", "=", "0"}], ";", "\[IndentingNewLine]", 
                  RowBox[{"Abort", "[", "]"}], ";"}], "\[IndentingNewLine]", 
                 ",", "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"aDigits", "=", 
                   RowBox[{"i", "-", 
                    RowBox[{"decimalPosList", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "1"}], "]"}], "]"}], "-", "1"}]}], 
                  ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
               "\[IndentingNewLine]", "\[IndentingNewLine]", 
               RowBox[{"For", "[", 
                RowBox[{
                 RowBox[{"k", "=", "i"}], ",", 
                 RowBox[{"k", "<=", "maxCharLen2"}], ",", 
