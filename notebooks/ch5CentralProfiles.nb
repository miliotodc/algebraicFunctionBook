                    RowBox[{"Style", "[", 
                    RowBox[{"\"\<maxCharLen reached: \>\"", ",", "Red"}], 
                    "]"}], ",", 
                    RowBox[{"Style", "[", 
                    RowBox[{"maxCharLen", ",", "Red"}], "]"}]}], "]"}], ";"}],
                   "*)"}], "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"maxCharFlag", "=", "True"}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"maxCharIndex", "=", "sIndex"}], ";"}]}], 
                "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
               RowBox[{"For", "[", 
                RowBox[{
                 RowBox[{"k", "=", "i"}], ",", 
                 RowBox[{"k", "<=", "maxCharLen2"}], ",", 
                 RowBox[{"k", "++"}], ",", "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"testChar", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], "=", 
                   RowBox[{"Style", "[", 
                    RowBox[{
                    RowBox[{"testChar", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], ",", "Red"}], "]"}]}], 
                  ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"sIndex", " ", "expInc"}], ",", 
                 RowBox[{"errTable", "[", 
                  RowBox[{"[", 
                   RowBox[{"sIndex", ",", "1"}], "]"}], "]"}], ",", 
                 RowBox[{"i", "-", "4"}], ",", 
                 RowBox[{"testChar", "[", 
                  RowBox[{"[", 
                   RowBox[{"1", ";;", "100"}], "]"}], "]"}], ",", 
                 "maxCharIndex", ",", "i"}], "}"}]}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{"sIndex", ",", "1", ",", 
                RowBox[{"Length", "@", "errTable"}]}], "}"}]}], 
             "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"PrependTo", "[", 
            RowBox[{"cTable2", ",", 
