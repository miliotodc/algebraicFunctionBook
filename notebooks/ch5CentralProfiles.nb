Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"getIntegerOrderIndexes", "[", "finalSummaryIndex_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "seriesIndex", ",", "cycleExpList", ",", "integerOrders", ",", 
         "orderIndexes", ",", "nearestExpList", ",", "integerCycleExpList", 
         ",", "theOrderTable", ",", "theMaxOrder", ",", "theMaxExp"}], "}"}], 
       ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"seriesIndex", "=", 
         RowBox[{"baseSheetLinks", "[", 
          RowBox[{"[", 
           RowBox[{"finalSummaryIndex", ",", "2", ",", "1"}], "]"}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"cycleExpList", "=", 
         RowBox[{"Exponent", "[", 
          RowBox[{
           RowBox[{"baseSeries", "[", 
            RowBox[{"[", "seriesIndex", "]"}], "]"}], ",", "z", ",", "List"}],
           "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"integerCycleExpList", "=", 
         RowBox[{"Select", "[", 
          RowBox[{"cycleExpList", ",", "IntegerQ"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", "\[IndentingNewLine]", " ", 
         RowBox[{
         "check", " ", "if", " ", "less", " ", "than", " ", "10", " ", 
          "integer", " ", "orders"}], "\[IndentingNewLine]", "*)"}], 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "@", "integerCycleExpList"}], "<", "10"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{
             RowBox[{"Style", "[", 
              RowBox[{"\"\<Too few integer orders\>\"", ",", "Red"}], "]"}], 
             ",", 
             RowBox[{"Style", "[", 
              RowBox[{
              "\"\< Reverting to closest fractional power\>\"", ",", "Red"}], 
              "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"theMaxOrder", "=", 
            RowBox[{
             RowBox[{"getMaxOrder", "[", "finalSummaryIndex", "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<max order: \>\"", ",", "theMaxOrder"}], "]"}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"theOrderTable", "=", 
            RowBox[{
             RowBox[{
              RowBox[{"getOrderIndex3", "[", 
               RowBox[{"#", ",", "finalSummaryIndex"}], "]"}], "&"}], "/@", 
             " ", 
             RowBox[{"Range", "[", "theMaxOrder", "]"}]}]}], ";"}], 
          "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"theMaxOrder", "=", 
            RowBox[{
             RowBox[{"getMaxOrder", "[", "finalSummaryIndex", "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"orderIndexes", "=", 
            RowBox[{"Flatten", "@", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"Position", "[", 
                 RowBox[{"cycleExpList", ",", 
                  RowBox[{"x_", "/;", 
                   RowBox[{"x", "==", "#"}]}]}], "]"}], "&"}], "/@", " ", 
               "integerCycleExpList"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"theOrderTable", "=", 
            RowBox[{"MapThread", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"{", 
                RowBox[{"#1", ",", "#2", ",", "#3"}], "}"}], "&"}], ",", 
              RowBox[{"{", 
               RowBox[{
               "integerCycleExpList", ",", "orderIndexes", ",", 
                "integerCycleExpList"}], "}"}]}], "]"}]}]}]}], 
         "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
        "theOrderTable"}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"SetAttributes", "[", 
    RowBox[{"getIntegerOrderIndexes", ",", "Listable"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.8855612713184376`*^9, 3.8855612966987596`*^9}, {
