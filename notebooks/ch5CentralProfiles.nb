Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"tStart", "=", 
     RowBox[{"-", "Pi"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tEnd", "=", "Pi"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rVal", "=", 
     RowBox[{"9", "/", "10"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"thetaTable", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"zVal", "=", 
         RowBox[{"rVal", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"I", " ", "theta"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"wVals", "=", 
         RowBox[{"Sort", "[", 
          RowBox[{"w", "/.", 
           RowBox[{"NSolve", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"theFunction", "==", "0"}], "/.", 
              RowBox[{"z", "->", 
               RowBox[{"(", 
                RowBox[{"baseSingularPoint", "+", "zVal"}], ")"}]}]}], ",", 
             "w", ",", 
             RowBox[{"WorkingPrecision", "->", "1500"}]}], "]"}]}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"bVal", "=", 
         RowBox[{
          RowBox[{"baseSeries", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "/.", 
          RowBox[{"z", "->", "zVal"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"difArray", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"bVal", "-", "#"}], "]"}], "&"}], "/@", " ", "wVals"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"pos", "=", 
         RowBox[{
          RowBox[{"Position", "[", 
           RowBox[{"difArray", ",", 
            RowBox[{"Min", "@", "difArray"}]}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"pc", "=", 
         RowBox[{"Floor", "@", 
          RowBox[{"Precision", "@", "difArray"}]}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"theta", ",", 
          RowBox[{"-", 
           RowBox[{"Log", "[", 
            RowBox[{"difArray", "[", 
             RowBox[{"[", "pos", "]"}], "]"}], "]"}]}], ",", "pc"}], "}"}]}], 
       ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"theta", ",", "tStart", ",", "tEnd", ",", 
         RowBox[{"Pi", "/", "125"}]}], "}"}]}], "\[IndentingNewLine]", 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"lpTheta", "=", 
    RowBox[{"ListLogPlot", "[", 
     RowBox[{
      RowBox[{"thetaTable", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "2"}], "}"}]}], "]"}], "]"}], ",", 
      RowBox[{"PlotStyle", "->", "Black"}], ",", 
      RowBox[{"Frame", "->", "True"}], ",", 
      RowBox[{"FrameLabel", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{"\"\<\[Theta]\>\"", ",", "14", ",", "Bold", ",", "Black"}], 
          "]"}], ",", 
         RowBox[{"Rotate", "[", 
          RowBox[{
           RowBox[{"Style", "[", 
            RowBox[{
            "\"\<\!\(\*SubscriptBox[\(s\), \(a\)]\)\>\"", ",", "16", ",", 
             "Black", ",", "Bold"}], "]"}], ",", 
           RowBox[{
            RowBox[{"-", "90"}], " ", "Degree"}]}], "]"}]}], "}"}]}], ",", 
      RowBox[{"FrameTicks", "->", 
       RowBox[{"{", 
        RowBox[{
