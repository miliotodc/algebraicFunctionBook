Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"accuracyPlotOfT", "[", 
     RowBox[{
     "finalSummary_", ",", "summaryIndex_", ",", "rRatio_", ",", 
      "baseSingularIndex_", ",", "theSingularList_", ",", "baseSeries_"}], 
     "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "bPoint", ",", "thetaTable", ",", "zVal", ",", "wVals", ",", "bVal", 
        ",", "difArray", ",", "pos", ",", "generatorIndex", ",", "theR"}], 
       "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"generatorIndex", "=", 
        RowBox[{"finalSummary", "[", 
         RowBox[{"[", 
          RowBox[{"summaryIndex", ",", "4"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"bPoint", "=", 
        RowBox[{"theSingularList", "[", 
         RowBox[{"[", "baseSingularIndex", "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"theR", "=", 
        RowBox[{"Abs", "[", 
         RowBox[{"bPoint", "-", 
          RowBox[{"theSingularList", "[", 
           RowBox[{"[", 
            RowBox[{"finalSummary", "[", 
             RowBox[{"[", 
              RowBox[{"summaryIndex", ",", "5"}], "]"}], "]"}], "]"}], 
           "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"thetaTable", "=", 
        RowBox[{"Table", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"zVal", "=", 
            RowBox[{"rRatio", " ", "theR", " ", 
             RowBox[{"Exp", "[", 
              RowBox[{"I", " ", "theta"}], "]"}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"wVals", "=", 
            RowBox[{"Sort", "[", 
             RowBox[{"w", "/.", 
              RowBox[{"NSolve", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"$theFunction", "==", "0"}], "/.", 
                 RowBox[{"z", "->", 
