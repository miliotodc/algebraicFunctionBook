Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"getSingularPoints2", "[", 
      RowBox[{"theFunction_", ",", "workingPrecision_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "i", ",", "theSingularSet", ",", "theSingularList", ",", "wExpList", 
         ",", "poleFuntion", ",", "pExp", ",", "poleIndexes", ",", 
         "poleFunction", ",", "polePositions", ",", "singularReport", ",", 
         "theArgList", ",", "nearestSing", ",", "nearestDist", ",", 
         "minRadiusArray", ",", "thePoleList", ",", "theReturn"}], "}"}], ",",
        "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"workingPrecision", "<", "1000"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"Style", "[", 
             RowBox[{
             "\"\<WorkingPrecision must be greater than or equal to 1000\>\"",
               ",", "Red"}], "]"}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"theReturn", "=", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", 
              RowBox[{"-", "1"}], ",", 
              RowBox[{"-", "1"}], ",", 
              RowBox[{"-", "1"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
          ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"!", 
              RowBox[{"IrreduciblePolynomialQ", "[", "theFunction", "]"}]}], 
             ",", "\[IndentingNewLine]", 
             RowBox[{"{", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"Print", "[", 
                RowBox[{
                 RowBox[{"Style", "[", 
                  RowBox[{"\"\<Function is reducible:  \>\"", ",", "Red"}], 
                  "]"}], ",", 
                 RowBox[{"Style", "[", 
                  RowBox[{
                   RowBox[{"Factor", "[", "theFunction", "]"}], ",", "Red"}], 
                  "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
               RowBox[{"theReturn", "=", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"-", "1"}], ",", 
                  RowBox[{"-", "1"}], ",", 
                  RowBox[{"-", "1"}], ",", 
                  RowBox[{"-", "1"}]}], "}"}]}], ";"}], "\[IndentingNewLine]",
               "}"}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"theSingularSet", "=", 
               RowBox[{"Sort", "[", 
                RowBox[{
                 RowBox[{"z", "/.", 
                  RowBox[{"NSolve", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"Simplify", "@", 
                    RowBox[{"Resultant", "[", 
                    RowBox[{"theFunction", ",", 
                    RowBox[{"D", "[", 
                    RowBox[{"theFunction", ",", "w"}], "]"}], ",", "w"}], 
                    "]"}]}], "\[Equal]", "0"}], ",", "z", ",", 
                    RowBox[{
                    "WorkingPrecision", "\[Rule]", "workingPrecision"}]}], 
                   "]"}]}], ",", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Abs", "@", "#1"}], "<=", " ", 
                   RowBox[{"Abs", "@", "#2"}]}], "&"}]}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Length", "@", "theSingularSet"}], "==", "0"}], ",", 
                "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"Print", "[", 
                  RowBox[{"Style", "[", 
                   RowBox[{"\"\<No singular points found\>\"", ",", "Red"}], 
                   "]"}], "]"}], ";", "\[IndentingNewLine]", 
                 RowBox[{"theReturn", "=", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"-", "1"}], ",", 
                    RowBox[{"-", "1"}], ",", 
                    RowBox[{"-", "1"}], ",", 
                    RowBox[{"-", "1"}]}], "}"}]}], ";"}], 
                "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"theSingularList", "=", 
                  RowBox[{"DeleteDuplicates", "[", 
                   RowBox[{"theSingularSet", ",", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "[", 
                    RowBox[{"#1", "-", "#2"}], "]"}], "<", 
                    RowBox[{"10", "^", 
                    RowBox[{"-", "50"}]}]}], "&"}]}], "]"}]}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"wExpList", "=", 
                  RowBox[{"Exponent", "[", 
                   RowBox[{"theFunction", ",", "w", ",", "List"}], "]"}]}], 
                 ";", "\[IndentingNewLine]", 
                 RowBox[{"poleFunction", "=", 
                  RowBox[{"Coefficient", "[", 
                   RowBox[{"theFunction", ",", "w", ",", 
                    RowBox[{"Max", "@", "wExpList"}]}], "]"}]}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"pExp", "=", 
                  RowBox[{"Exponent", "[", 
                   RowBox[{"poleFunction", ",", "z", ",", "List"}], "]"}]}], 
                 ";", "\[IndentingNewLine]", 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"Last", "@", "pExp"}], ">", "0"}], ",", 
                   "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"thePoleList", "=", 
                    RowBox[{"DeleteDuplicates", "[", 
                    RowBox[{"z", "/.", 
                    RowBox[{"NSolve", "[", 
                    RowBox[{
                    RowBox[{"poleFunction", "\[Equal]", "0"}], ",", "z", ",", 
                    RowBox[{
                    "WorkingPrecision", "\[Rule]", "workingPrecision"}]}], 
                    "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", ",", 
                   "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"thePoleList", "=", 
                    RowBox[{"{", "}"}]}], ";"}]}], "\[IndentingNewLine]", 
                  "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
                 RowBox[{"polePositions", "=", 
                  RowBox[{"Flatten", "[", 
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Position", "[", 
                    RowBox[{"theSingularList", ",", 
                    RowBox[{"x_", "/;", 
                    RowBox[{
                    RowBox[{"Abs", "[", 
                    RowBox[{"x", "-", "#"}], "]"}], "<", 
                    RowBox[{"10", "^", 
                    RowBox[{"-", "50"}]}]}]}]}], "]"}], "&"}], "/@", " ", 
                    "thePoleList"}], ")"}], "]"}]}], ";", 
                 "\[IndentingNewLine]", "\[IndentingNewLine]", 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"Length", "@", "polePositions"}], ">", "0"}], ",",
                    "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"poleIndexes", "=", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"{", "#", "}"}], "&"}], "/@", " ", 
                    "polePositions"}]}], ";"}], "\[IndentingNewLine]", ",", 
                   "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"poleIndexes", "=", 
                    RowBox[{"{", "}"}]}], ";"}]}], "\[IndentingNewLine]", 
                  "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
                 RowBox[{"(*", "\[IndentingNewLine]", " ", 
                  RowBox[{
                  "compute", " ", "minArray", " ", "of", " ", "integration", 
                   " ", "region", " ", "around", " ", "each", " ", "singular",
                    " ", "point"}], " ", "\[IndentingNewLine]", "*)"}], 
                 "\[IndentingNewLine]", 
                 RowBox[{"nearestSing", "=", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"NearestTo", "[", 
                    RowBox[{"#1", ",", "2"}], "]"}], "[", "theSingularList", 
                    "]"}], "&"}], "/@", " ", "theSingularList"}], ")"}], "[", 
                   RowBox[{"[", 
                    RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"nearestDist", "=", 
                  RowBox[{"MapThread", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"1", "/", "3"}], 
                    RowBox[{"Abs", "[", 
                    RowBox[{"#1", "-", "#2"}], "]"}]}], "&"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"theSingularList", ",", "nearestSing"}], "}"}]}], 
                   "]"}]}], ";", "\[IndentingNewLine]", 
                 RowBox[{"(*", 
                  RowBox[{
                   RowBox[{"nearestSingDist", "=", 
                    RowBox[{"MapThread", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "[", 
                    RowBox[{"#1", "-", "#2"}], "]"}], "&"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"theSingularList", ",", "nearestSing"}], "}"}]}], 
                    "]"}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
                 RowBox[{"For", "[", 
                  RowBox[{
                   RowBox[{"i", "=", "1"}], ",", 
                   RowBox[{"i", "<=", 
                    RowBox[{"Length", "@", "nearestDist"}]}], ",", 
                   RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"nearestDist", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], ">", "10"}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"nearestDist", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "=", "10"}], ";"}]}], 
                    "\[IndentingNewLine]", "]"}], ";"}]}], 
                  "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
                 RowBox[{"minRadiusArray", "=", "nearestDist"}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"theReturn", "=", 
                  RowBox[{"{", 
                   RowBox[{
                   "theSingularList", ",", "thePoleList", ",", "poleIndexes", 
                    ",", "minRadiusArray"}], "}"}]}], ";"}]}], 
               "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", 
            "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
        "\[IndentingNewLine]", "theReturn"}]}], "\[IndentingNewLine]", 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.8814159819741616`*^9, 3.8814159824584384`*^9}},
