Cell[CellGroupData[{

Cell["accuracyPlotOfR", "Subsection",
 CellChangeTimes->{{3.939217192185684*^9, 
  3.939217195559886*^9}},ExpressionUUID->"78031b57-40f6-4e2a-80f0-\
ba85f60bc66f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"accuracyPlotOfR", "[", 
     RowBox[{
     "finalSummary_", ",", "summaryIndex_", ",", "ratioStart_", ",", 
      "ratioEnd_", ",", "baseSingularIndex_", ",", "theSingularList_", ",", 
      "baseSeries_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "ratioTable", ",", "theRList", ",", "generatorIndex", ",", "singPrec", 
        ",", "zTable", ",", "zVal", ",", "wp", ",", "wVals", ",", "bVal", ",",
         "difArray", ",", "pos", ",", "posArray", ",", "genIndex", ",", 
        "return", ",", "reportHeader", ",", "basePoint", ",", "nflLog", ",", 
        "nflPlot", ",", "a1", ",", "a2", ",", "a3"}], "}"}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"basePoint", "=", 
        RowBox[{"theSingularList", "[", 
         RowBox[{"[", "baseSingularIndex", "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"ratioTable", "=", 
        RowBox[{"Array", "[", 
         RowBox[{
          RowBox[{"#", "&"}], ",", 
          RowBox[{"{", "25", "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"ratioStart", ",", "ratioEnd"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"theRList", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"basePoint", "-", 
            RowBox[{"theSingularList", "[", 
             RowBox[{"[", 
              RowBox[{"#", "[", 
               RowBox[{"[", "5", "]"}], "]"}], "]"}], "]"}]}], "]"}], "&"}], "/@",
          " ", "finalSummary"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"posArray", "=", 
        RowBox[{"Position", "[", 
         RowBox[{
          RowBox[{"finalSummary", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", 
          RowBox[{"x_", "/;", 
           RowBox[{"x", "==", "summaryIndex"}]}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "@", "posArray"}], "==", "0"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", "\"\<Summary index out of range\>\"", "]"}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"return", "=", 
