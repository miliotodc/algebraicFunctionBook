$maxRootVerifyDifference\>\"", ",", "Red", ",", "Bold"}], "]"}], "]"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"Print", "[", 
                    RowBox[{"\"\<   maxDif: \>\"", ",", 
