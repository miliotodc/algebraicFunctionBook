Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"getOrderIndex3", "[", 
     RowBox[{"orderVal_", ",", "summaryTable_", ",", "finalSummaryIndex_"}], 
     "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "seriesSize", ",", "cycleExpList", ",", "nearestExpList", ",", 
        "theVals", ",", "nearestExp", ",", "posArray", ",", "pos", ",", 
        "seriesIndex"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"seriesIndex", "=", 
        RowBox[{"summaryTable", "[", 
         RowBox[{"[", 
          RowBox[{"finalSummaryIndex", ",", "4"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"seriesSize", "=", 
        RowBox[{"Length", "@", 
         RowBox[{"baseSeries", "[", 
          RowBox[{"[", "seriesIndex", "]"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"cycleExpList", "=", 
        RowBox[{"Exponent", "[", 
         RowBox[{
          RowBox[{"baseSeries", "[", 
           RowBox[{"[", "seriesIndex", "]"}], "]"}], ",", "z", ",", "List"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"nearestExpList", "=", 
        RowBox[{"Nearest", "[", 
         RowBox[{"cycleExpList", ",", "orderVal"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "@", "nearestExpList"}], "==", "0"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"Style", "[", 
            RowBox[{"\"\<exponent not found\>\"", ",", "Red"}], "]"}], "]"}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"theVals", "=", 
           RowBox[{"{", 
            RowBox[{"\"\<ea\>\"", ",", "\"\<ea\>\""}], "}"}]}], ";"}], 
         "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"nearestExp", "=", 
           RowBox[{"nearestExpList", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"posArray", "=", 
           RowBox[{"Position", "[", 
            RowBox[{"cycleExpList", ",", 
             RowBox[{"x_", "/;", 
              RowBox[{"x", "==", "nearestExp"}]}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "@", "posArray"}], "==", "0"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{
               RowBox[{"Style", "[", 
                RowBox[{"\"\<Error with posArray: \>\"", ",", "Red"}], "]"}], 
               ",", "posArray"}], "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"theVals", "=", 
              RowBox[{"{", 
               RowBox[{"\"\<eb\>\"", ",", "\"\<eb\>\""}], "}"}]}], ";"}], 
            "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"pos", "=", 
              RowBox[{"posArray", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"pos", "==", "seriesSize"}], " ", "&&", " ", 
                RowBox[{"orderVal", ">", 
                 RowBox[{"Round", "@", "nearestExp"}]}]}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"Print", "[", 
                 RowBox[{
                  RowBox[{"Style", "[", 
                   RowBox[{"\"\<Requested order of branch \>\"", ",", "Red"}],
                    "]"}], ",", 
                  RowBox[{"Style", "[", 
                   RowBox[{
                    RowBox[{"seriesSummaryReport", "[", 
                    RowBox[{"[", 
                    RowBox[{"finalSummaryIndex", ",", "2"}], "]"}], "]"}], 
                    ",", "Red"}], "]"}], ",", 
                  RowBox[{"Style", "[", 
                   RowBox[{
                   "\"\< is greater than max series order \>\"", ",", "Red"}],
                    "]"}], ",", 
                  RowBox[{"Style", "[", 
                   RowBox[{
                    RowBox[{"Round", "@", "nearestExp"}], ",", "Red"}], 
                   "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
                RowBox[{"theVals", "=", 
                 RowBox[{"{", 
                  RowBox[{"\"\<e\>\"", ",", "\"\<e\>\""}], "}"}]}], ";"}], 
               "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
               RowBox[{"theVals", "=", 
                RowBox[{"{", 
                 RowBox[{"orderVal", ",", "pos", ",", 
                  RowBox[{"cycleExpList", "[", 
                   RowBox[{"[", "pos", "]"}], "]"}]}], "}"}]}]}], 
              "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", 
           "]"}], ";"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
        "]"}], ";", "\[IndentingNewLine]", "theVals"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]"}]], "Input",
 CellLabel->"In[86]:=",ExpressionUUID->"e9b227c8-83d2-4aff-982b-79c3d17d6b4a"]
}, Closed]]
