Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"getRadialRange", "[", 
     RowBox[{"actR_", ",", "totalPoints_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "rData", ",", "rExp", ",", "fData", ",", "uLimit", ",", "lLimit", ",", 
        "theRange"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"rData", "=", 
        RowBox[{"RealDigits", "[", 
         RowBox[{"actR", "//", "N"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"rExp", "=", 
        RowBox[{"rData", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"rExp", "==", "0"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"fData", "=", 
           RowBox[{"FromDigits", "[", 
            RowBox[{"rData", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", 
               RowBox[{"1", ";;", "3"}]}], "]"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"uLimit", "=", 
           RowBox[{"fData", "/", "1000"}]}], ";"}], "\[IndentingNewLine]", 
         ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"fData", "=", 
           RowBox[{"FromDigits", "[", 
            RowBox[{"rData", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", 
               RowBox[{"1", ";;", "3"}]}], "]"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"uLimit", "=", 
           RowBox[{"fData", "/", "100"}]}], ";"}]}], "\[IndentingNewLine]", 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"lLimit", "=", 
        RowBox[{
         RowBox[{"1", "/", "10"}], " ", "uLimit"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"theRange", "=", 
        RowBox[{"Array", "[", 
         RowBox[{
          RowBox[{"#", "&"}], ",", "totalPoints", ",", 
          RowBox[{"{", 
           RowBox[{"lLimit", ",", "uLimit"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"lLimit", ",", "uLimit", ",", "theRange"}], "}"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}]}]], "Input",
 CellLabel->"In[24]:=",ExpressionUUID->"812af011-98b1-4b56-8b74-4b6c80d0aaf1"]
