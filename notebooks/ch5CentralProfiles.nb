Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{"get", " ", "orderList"}], ",", " ", "ratioTable", ",", 
    "theRList", ",", "argList"}], "\[IndentingNewLine]", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"orderList", "=", 
     RowBox[{"getOrderIndexes", "[", 
      RowBox[{"baseSeries", "[", 
       RowBox[{"[", 
        RowBox[{"finalSummary", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2", ",", "1"}], "]"}], "]"}], "]"}], "]"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"ratioTable", "=", 
    RowBox[{"Array", "[", 
     RowBox[{
      RowBox[{"#", "&"}], ",", "25", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "/", "10"}], ",", 
        RowBox[{"9", "/", "10"}]}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"theRList", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"baseSingularPoint", "-", 
         RowBox[{"$theSingularList", "[", 
          RowBox[{"[", 
           RowBox[{"#", "[", 
            RowBox[{"[", "6", "]"}], "]"}], "]"}], "]"}]}], "]"}], "&"}], "/@",
       " ", "finalSummary"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<theRList: \>\"", ",", 
      RowBox[{"theRList", "//", "N"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"argList", "=", 
     RowBox[{"Array", "[", 
      RowBox[{
       RowBox[{"#", "&"}], ",", "25", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "Pi"}], ",", "Pi"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{"order", " ", "list", " ", "is", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"integer", " ", "order"}], ",", " ", 
       RowBox[{"series", " ", "term"}], ",", " ", 
       RowBox[{"actual", " ", "order"}]}], "}"}], " ", "elements"}], 
    "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"finalOrderTable", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"orderList", "[", 
        RowBox[{"[", 
         RowBox[{"j", ",", "k"}], "]"}], "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", 
         RowBox[{"Length", "@", "orderList"}]}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"k", ",", "10", ",", 
         RowBox[{"Length", "@", 
          RowBox[{"orderList", "[", 
           RowBox[{"[", "j", "]"}], "]"}]}], ",", 
         RowBox[{"Floor", "[", 
          RowBox[{
           RowBox[{"Length", "@", 
            RowBox[{"orderList", "[", 
             RowBox[{"[", "j", "]"}], "]"}]}], "/", "25"}], "]"}]}], "}"}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"finalOrderTable", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Reverse", "[", "#", "]"}], "&"}], "/@", " ", 
      "finalOrderTable"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"finalOrderTable", "[", 
    RowBox[{"[", "1", "]"}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"finalOrderTable", "[", 
    RowBox[{"[", 
     RowBox[{"1", ",", "All", ",", "2"}], "]"}], "]"}], "\[IndentingNewLine]",
    "\[IndentingNewLine]", 
   RowBox[{"bt", "=", "$showBottomOutPoints"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"at10", "=", 
     RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"accuracyData3D", "=", 
        RowBox[{"ParallelTable", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"theRatioIndex", "==", "1"}], " ", "&&", " ", 
              RowBox[{"theOrderIndex", "==", "1"}]}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Print", "[", 
               RowBox[{
               "\"\<Analyzing summaryIndex \>\"", ",", "summaryIndex"}], 
               "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"currentOrderArray", "=", 
            RowBox[{"finalOrderTable", "[", 
             RowBox[{"[", 
              RowBox[{"summaryIndex", ",", "theOrderIndex"}], "]"}], "]"}]}], 
           ";", "\[IndentingNewLine]", 
           RowBox[{"currentIntegerOrder", "=", 
            RowBox[{"currentOrderArray", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"seriesEndTerm", "=", 
            RowBox[{"currentOrderArray", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"actualOrder", "=", 
            RowBox[{"currentOrderArray", "[", 
             RowBox[{"[", "3", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"branchSeriesIndex", "=", 
            RowBox[{"baseSheetLinks", "[", 
             RowBox[{"[", 
              RowBox[{"summaryIndex", ",", "2", ",", "1"}], "]"}], "]"}]}], 
           ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"theOrderIndex", "==", "1"}], ",", "\[IndentingNewLine]", 
             RowBox[{"(*", 
              RowBox[{
               RowBox[{"zVal", "=", 
                RowBox[{
                 RowBox[{"ratioTable", "[", 
                  RowBox[{"[", "theRatioIndex", "]"}], "]"}], " ", 
                 RowBox[{"theRList", "[", 
                  RowBox[{"[", "summaryIndex", "]"}], "]"}], " ", 
                 RowBox[{"Exp", "[", 
                  RowBox[{
                   RowBox[{"RandomChoice", "[", "argList", "]"}], "I"}], 
                  "]"}]}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"zVal", "=", 
               RowBox[{
                RowBox[{"ratioTable", "[", 
                 RowBox[{"[", "theRatioIndex", "]"}], "]"}], " ", 
                RowBox[{"theRList", "[", 
                 RowBox[{"[", "summaryIndex", "]"}], "]"}], " ", 
                RowBox[{"Exp", "[", 
                 RowBox[{"Pi", " ", 
                  RowBox[{"I", "/", "4"}]}], "]"}]}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"(*", " ", 
               RowBox[{
                RowBox[{"zVal", "=", 
                 RowBox[{
                  RowBox[{"ratioTable", "[", 
                   RowBox[{"[", "theRatioIndex", "]"}], "]"}], " ", 
                  RowBox[{"theRList", "[", 
                   RowBox[{"[", "summaryIndex", "]"}], "]"}], 
                  RowBox[{"Exp", "[", 
                   RowBox[{
                    RowBox[{"RandomChoice", "[", "argList", "]"}], " ", "I"}],
                    "]"}]}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
              RowBox[{"bVal", "=", 
               RowBox[{
                RowBox[{"baseSeries", "[", 
                 RowBox[{"[", 
                  RowBox[{"branchSeriesIndex", ",", 
                   RowBox[{"1", ";;", "seriesEndTerm"}]}], "]"}], "]"}], "/.", 
                RowBox[{"z", "->", "zVal"}]}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"rootFunction", "=", 
               RowBox[{
                RowBox[{"theFunction", "==", "0"}], "/.", 
                RowBox[{"z", "->", 
                 RowBox[{"(", 
                  RowBox[{"baseSingularPoint", "+", "zVal"}], ")"}]}]}]}], 
              ";", "\[IndentingNewLine]", 
              RowBox[{"rootFunctionPrecision", "=", 
               RowBox[{"Floor", "@", 
                RowBox[{"Precision", "@", "rootFunction"}]}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"Quiet", "[", 
               RowBox[{"wVals", "=", 
                RowBox[{"w", "/.", 
                 RowBox[{"NSolve", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"$theFunction", "==", "0"}], "/.", 
                    RowBox[{"z", "->", 
                    RowBox[{"(", 
                    RowBox[{"baseSingularPoint", "+", "zVal"}], ")"}]}]}], 
                   ",", "w", ",", 
                   RowBox[{
                   "WorkingPrecision", "->", "rootFunctionPrecision"}]}], 
                  "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
              RowBox[{"difTable", "=", 
               RowBox[{
                RowBox[{
                 RowBox[{"Abs", "[", 
                  RowBox[{"#", "-", "bVal"}], "]"}], "&"}], "/@", " ", 
                "wVals"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"wPosArray", "=", 
               RowBox[{"Flatten", "[", 
                RowBox[{"Position", "[", 
                 RowBox[{"difTable", ",", 
                  RowBox[{"x_", "/;", 
                   RowBox[{"x", "==", 
                    RowBox[{"Min", "[", "difTable", "]"}]}]}]}], "]"}], 
                "]"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Length", "@", "wPosArray"}], "==", "0"}], ",", 
                "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"Print", "[", 
                  RowBox[{
                   RowBox[{"Style", "[", 
                    RowBox[{"\"\<Error with wPosArray: \>\"", ",", "Red"}], 
                    "]"}], ",", "wPosArray", ",", "\"\< at order \>\"", " ", 
                   ",", "currentIntegerOrder", ",", "\"\< for cycle \>\"", 
                   ",", 
                   RowBox[{"finalSummary", "[", 
                    RowBox[{"[", 
                    RowBox[{"summaryIndex", ",", "3"}], "]"}], "]"}]}], "]"}],
                  ";", "\[IndentingNewLine]", 
                 RowBox[{"difTable", "=", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"Abs", "[", 
                    RowBox[{"#", "-", "bVal"}], "]"}], "&"}], "/@", " ", 
                   "wVals"}]}], ";", "\[IndentingNewLine]", 
                 RowBox[{"minDif", "=", 
                  RowBox[{"Min", "[", "difTable", "]"}]}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"loc2", "=", 
                  RowBox[{
                   RowBox[{"Flatten", "[", 
                    RowBox[{"Position", "[", 
                    RowBox[{"difTable", ",", 
                    RowBox[{"x_", "/;", 
                    RowBox[{"x", "==", "minDif"}]}]}], "]"}], "]"}], "[", 
                   RowBox[{"[", "1", "]"}], "]"}]}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"theVal", "=", 
                  RowBox[{"{", 
                   RowBox[{
                   "\"\<pa\>\"", ",", "\"\<pa\>\"", ",", "\"\<pa\>\"", ",", 
                    "\"\<pa\>\"", ",", "\"\<pa\>\""}], "}"}]}], ";"}], 
                "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"wPos", "=", 
                  RowBox[{"wPosArray", "[", 
                   RowBox[{"[", "1", "]"}], "]"}]}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"wMatch", "=", 
                  RowBox[{"wVals", "[", 
                   RowBox[{"[", "wPos", "]"}], "]"}]}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"dif", "=", 
                  RowBox[{"Abs", "[", 
                   RowBox[{"bVal", "-", "wMatch"}], "]"}]}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"Precision", "@", "dif"}], "<", "25"}], ",", 
                   "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"Print", "[", 
                    RowBox[{"Style", "[", 
                    RowBox[{"\"\<low precision\>\"", ",", "Red"}], "]"}], 
                    "]"}], ";", "\[IndentingNewLine]", 
                    RowBox[{"Print", "[", 
                    RowBox[{"\"\<dif: \>\"", ",", 
                    RowBox[{"N", "[", 
                    RowBox[{"dif", ",", "10"}], "]"}]}], "]"}], ";", 
                    "\[IndentingNewLine]", "\[IndentingNewLine]", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    "$showBottomOutPoints", ",", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"theVal", "=", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"ratioTable", "[", 
                    RowBox[{"[", "theRatioIndex", "]"}], "]"}], ",", 
                    "actualOrder", ",", 
                    RowBox[{"Floor", "@", 
                    RowBox[{"Precision", "@", 
                    RowBox[{"baseSeries", "[", 
                    RowBox[{"[", "branchSeriesIndex", "]"}], "]"}]}]}], ",", 
                    RowBox[{"Floor", "@", 
                    RowBox[{"Precision", "@", 
                    RowBox[{"baseSeries", "[", 
                    RowBox[{"[", "branchSeriesIndex", "]"}], "]"}]}]}], ",", 
                    RowBox[{"Abs", "[", "zVal", "]"}]}], "}"}]}], ";"}], 
                    "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"theVal", "=", 
                    RowBox[{"{", 
                    RowBox[{
                    "\"\<dp\>\"", ",", "\"\<dp\>\"", ",", "\"\<dp\>\"", ",", 
                    "\"\<dp\>\"", ",", "\"\<dp\>\""}], "}"}]}], ";"}]}], 
                    "\[IndentingNewLine]", "]"}], ";"}], 
                   "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"me", "=", 
                    RowBox[{"-", 
                    RowBox[{
                    RowBox[{"MantissaExponent", "[", "dif", "]"}], "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"me", "<", "10"}], ",", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"Print", "[", "\"\<low accuracy\>\"", "]"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"theVal", "=", 
                    RowBox[{"{", 
                    RowBox[{
