                    RowBox[{"theSingularList", "[", 
                    RowBox[{"[", "poleIndexes", "]"}], "]"}]}], ",", "1"}], 
                    "]"}]}], ";", "\[IndentingNewLine]", 
                    RowBox[{"(*", "\[IndentingNewLine]", " ", 
                    RowBox[{
                    "use", " ", "ringMembersR", " ", "for", " ", "list", " ", 
