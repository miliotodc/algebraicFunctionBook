Cell[CellGroupData[{

Cell["Section 8.3.9:  Set up arrows", "Subsubsection",
 CellChangeTimes->{{3.987076043652611*^9, 
  3.9870760489352813`*^9}},ExpressionUUID->"5738f86a-7579-42bf-b6f1-\
b73f79cf186c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{"do", " ", "arrows"}], "\[IndentingNewLine]", "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", "  ", 
  RowBox[{
   RowBox[{
    RowBox[{"contLinks", "=", 
     RowBox[{"continuationRecords", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "8"}], "}"}]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dy", "=", "0.1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"arrowTranslationFactor", "=", "3.5"}], " ", 
   RowBox[{"(*", " ", "default", " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"arrowTranslationFactor", "=", "2"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"arrowTable", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"currentContLink", "=", 
         RowBox[{"contLinks", "[", 
          RowBox[{"[", "currentContAIndex", "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<currentAnnulus: \>\"", ",", 
          RowBox[{"currentContLink", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"theCurrentAnnulus", "=", 
         RowBox[{"currentContLink", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<currentContLink: \>\"", ",", 
          RowBox[{"currentContLink", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"preAIndex", ",", "preSIndex"}], "}"}], "=", 
         RowBox[{"getSingTableIndexes", "[", 
          RowBox[{"annulusTable", ",", 
           RowBox[{"currentContLink", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"preMonodromy", "=", 
         RowBox[{"annulusTable", "[", 
          RowBox[{"[", 
           RowBox[{"preAIndex", ",", "6"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<preMonodromy: \>\"", ",", "preMonodromy"}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"postAIndex", ",", "postSIndex"}], "}"}], "=", 
         RowBox[{"getSingTableIndexes", "[", 
          RowBox[{"annulusTable", ",", 
           RowBox[{
            RowBox[{"currentContLink", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "+", "1"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"postMonodromy", "=", 
         RowBox[{"annulusTable", "[", 
          RowBox[{"[", 
           RowBox[{"postAIndex", ",", "6"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<postMonodromy: \>\"", ",", "postMonodromy"}], "]"}], 
        ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<postMonodromy: \>\"", ",", 
          RowBox[{"annulusTable", "[", 
           RowBox[{"[", 
            RowBox[{"postAIndex", ",", "6"}], "]"}], "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"currentPreBranch", "=", 
         RowBox[{"currentContLink", "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", "currentBranchLink", ",", "1"}], "]"}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<currentPreBranch: \>\"", ",", "currentPreBranch"}], 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"theCurrentPreBranch", "=", "currentPreBranch"}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"currentPreBranchLoc", "=", 
         RowBox[{
          RowBox[{"Position", "[", 
           RowBox[{"preMonodromy", ",", 
            RowBox[{"x_", "/;", 
             RowBox[{"x", "==", "currentPreBranch"}]}]}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"currentPostBranch", "=", 
         RowBox[{"currentContLink", "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", "currentBranchLink", ",", "2"}], "]"}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"currentPostBranchLoc", "=", 
         RowBox[{
