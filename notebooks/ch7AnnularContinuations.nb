Cell[CellGroupData[{

Cell["Section 8.2.6:  Set up annular monodromes ", "Subsubsection",
 CellChangeTimes->{{3.982224998965021*^9, 3.9822250583704357`*^9}, 
   3.9822251811576366`*^9},ExpressionUUID->"ac459c35-1d49-4f22-9489-\
85f73530ce04"],

Cell["\<\
Adjust full size of the monodromy to fit all cycles without overlapping.  \
This is controlled by variable maxWidth.  Increase for larger-length \
monodromies.\
\>", "Text",
 CellChangeTimes->{{3.982225203583501*^9, 
  3.9822252517891245`*^9}},ExpressionUUID->"3bcdf3b3-c7f1-4017-898d-\
23cad092cbc7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{"do", " ", "annular", " ", "monodromies"}], "\[IndentingNewLine]", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"xLocationSave", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"annuliMonodromyGraphics", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"yOffSet", "=", "20"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"maxWidth", "=", "10"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"netMax", "=", "0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"k", "=", "1"}], ",", 
      RowBox[{"k", "<=", 
       RowBox[{"(", 
        RowBox[{"Length", "@", "theAnnuli"}], ")"}]}], ",", 
      RowBox[{"k", "++"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"aIndex", ",", "sIndex"}], "}"}], "=", 
        RowBox[{"getSingTableIndexes", "[", 
         RowBox[{"annulusTable", ",", "k"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Monodromy: \>\"", ",", 
         RowBox[{"annulusTable", "[", 
          RowBox[{"[", 
           RowBox[{"aIndex", ",", "6"}], "]"}], "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"numBranches", "=", 
        RowBox[{"Length", "@", 
         RowBox[{"annulusTable", "[", 
          RowBox[{"[", 
           RowBox[{"aIndex", ",", "6"}], "]"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"locations", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"Array", "[", 
           RowBox[{
            RowBox[{"#", "&"}], ",", 
            RowBox[{"numBranches", "+", "2"}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "maxWidth"}], "}"}]}], "]"}], ")"}], "[", 
         RowBox[{"[", 
          RowBox[{"2", ";;", 
           RowBox[{"-", "2"}]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"xLocationSave", ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "yOffSet", ",", "locations"}], "}"}]}], "]"}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<x-locations: \>\"", ",", "locations"}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"maxX", "=", 
        RowBox[{"locations", "[", 
         RowBox[{"[", 
          RowBox[{"-", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"maxX", ">", "netMax"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"netMax", "=", "maxX"}], ";"}]}], "\[IndentingNewLine]", 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"j", "=", "1"}], ",", 
         RowBox[{"j", "<=", "numBranches"}], ",", 
         RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"AppendTo", "[", 
           RowBox[{"annuliMonodromyGraphics", ",", 
            RowBox[{"Inset", "[", 
             RowBox[{
              RowBox[{"Style", "[", 
               RowBox[{
                RowBox[{"ToString", "[", 
                 RowBox[{"annulusTable", "[", 
                  RowBox[{"[", 
