                    RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"ringMembersR", "[", 
                    RowBox[{"[", 
                    RowBox[{"Sequence", "@@", 
                    RowBox[{"polePos", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], "]"}], "]"}], "=", 
                    RowBox[{"Style", "[", 
                    RowBox[{
                    RowBox[{"ringMembersR", "[", 
                    RowBox[{"[", 
                    RowBox[{"Sequence", "@@", 
                    RowBox[{"polePos", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], "]"}], "]"}], ",", 
                    "Red"}], "]"}]}]}], "\[IndentingNewLine]", "]"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"Print", "[", 
                    RowBox[{"\"\<ringMemvbersR: \>\"", ",", 
                    RowBox[{"ringMembersR", "//", "N"}]}], "]"}], ";", 
                    "\[IndentingNewLine]", "\[IndentingNewLine]", 
                    RowBox[{"theReturn", "=", 
                    RowBox[{"{", 
                    RowBox[{
                    "theSingularList", ",", "argList", ",", "zeroIndexes", 
                    ",", "poleIndexes", ",", "minRadiusArray", ",", 
                    "ringSizes", ",", "theAnnuli", ",", "singularListR", ",", 
                    "annularSizes", ",", "ringMembers", ",", "radiiTable", 
                    ",", "ringMembersR", ",", "singularRingIndexes"}], 
                    "}"}]}], ";", "\[IndentingNewLine]", 
                    RowBox[{"(*", 
                    RowBox[{
                    RowBox[{"theReturn", "=", 
                    RowBox[{"{", 
                    RowBox[{
                    "theSingularList", ",", "poleIndexes", ",", 
                    "minRadiusArray", ",", "res", ",", "zeroIndexes", ",", 
                    "ringTableR", ",", "theAnnuli", ",", "radiiTable"}], 
                    "}"}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
                    RowBox[{"If", "[", 
                    RowBox[{"diagFlag", ",", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"Print", "[", 
                    RowBox[{"\"\<Total singular points: \>\"", ",", 
                    RowBox[{"Length", "@", "theSingularList"}]}], "]"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"Print", "[", 
                    RowBox[{"\"\<Precision of singular points: \>\"", ",", 
                    RowBox[{"Precision", "@", "theSingularList"}]}], "]"}], 
                    ";", "\[IndentingNewLine]", 
                    RowBox[{"Print", "[", 
                    RowBox[{"\"\<Total poles: \>\"", ",", 
                    RowBox[{"Length", "@", "poleIndexes"}]}], "]"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"Print", "[", 
                    RowBox[{
                    RowBox[{"Style", "[", 
                    RowBox[{"\"\<Pole indexes: \>\"", ",", "Red"}], "]"}], 
                    ",", 
                    RowBox[{"Style", "[", 
                    RowBox[{"poleIndexes", ",", "Red"}], "]"}]}], "]"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"Print", "[", 
                    RowBox[{"\"\<Total zero points: \>\"", ",", 
                    RowBox[{"Length", "@", "zeroIndexes"}]}], "]"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"Print", "[", 
                    RowBox[{
                    RowBox[{"Style", "[", 
                    RowBox[{"\"\<Zero indexes: \>\"", ",", "Blue"}], "]"}], 
                    ",", 
                    RowBox[{"Style", "[", 
                    RowBox[{"zeroIndexes", ",", "Blue"}], "]"}]}], "]"}], ";",
                     "\[IndentingNewLine]", 
                    RowBox[{"Print", "[", 
                    RowBox[{"\"\<Min singular perimeter: \>\"", ",", 
                    RowBox[{
                    RowBox[{"Min", "@", "minRadiusArray"}], "//", "N"}]}], 
                    "]"}], ";", "\[IndentingNewLine]", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Length", "@", "theSingularList"}], ">", "1"}], 
                    ",", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"Print", "[", 
                    RowBox[{"\"\<Smallest singular points: \>\"", ",", 
                    RowBox[{
                    RowBox[{"theSingularList", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ";;", "2"}], "]"}], "]"}], "//", "N"}]}], 
                    "]"}], ";"}], "\[IndentingNewLine]", ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"Print", "[", 
                    RowBox[{"\"\<Singular point: \>\"", ",", 
                    RowBox[{
                    RowBox[{"theSingularList", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "//", "N"}]}], "]"}], 
                    ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]}], 
                    "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}], 
                    ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]}], 
               "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", 
            "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
