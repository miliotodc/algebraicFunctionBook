        "\[IndentingNewLine]", 
        RowBox[{"(*", "  ", "*)"}], "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"thePostRingSheet", "=", "endingLeg5Position"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "now", " ", "find", " ", "which", " ", "branch", " ", "cycle", " ", 
          "in", " ", "the", " ", "next", " ", "ring", " ", "this", " ", 
          "continuation", " ", "is", " ", "part", " ", "of"}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"nextRingCyclePosition", "=", 
