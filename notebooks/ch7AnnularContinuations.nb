                    "]"}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"branchRegions", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"theCurrentRing", "-", "1"}], ",", "preBranchpos",
                     ",", "2", ",", "2"}], "]"}], "]"}], "=", 
                   RowBox[{"annulusTable", "[", 
                    RowBox[{"[", 
                    RowBox[{"currentRingIndex", ",", "3", ",", "2"}], "]"}], 
                    "]"}]}], ";", "\[IndentingNewLine]", 
                  RowBox[{"(*", " ", 
                   RowBox[{
                   "now", " ", "set", " ", "the", " ", "update", " ", "flag", 
