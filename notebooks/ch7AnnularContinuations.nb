           RowBox[{"annulusTable", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"nextAnnulusIndexSet", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", "6"}], "]"}], "]"}]}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"Print", "[", 
             RowBox[{"\"\<next annulus radius: \>\"", ",", 
              RowBox[{"nextAnnulusRadius", "//", "N"}]}], "]"}], ";"}], 
           "*)"}], "\[IndentingNewLine]", 
          RowBox[{"currentArgument", "=", 
           RowBox[{"supportedSingularArgs", "[", 
            RowBox[{"[", 
             RowBox[{"annularIndex", ",", "singularIndex"}], "]"}], "]"}]}], 
          ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"branchStats", ",", " ", 
            RowBox[{"{", 
             RowBox[{
             "currentAnnuli", ",", "currentBranch", ",", 
              "currentBranchSheet"}], "}"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{
             "\"\<Current annulus: \>\"", ",", "Black", ",", "Bold", ",", 
