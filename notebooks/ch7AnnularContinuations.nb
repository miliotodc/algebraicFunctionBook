Cell[CellGroupData[{

Cell["getClosestIntegerOrder", "Subsection",
 CellChangeTimes->{{3.9169948520796213`*^9, 
  3.9169948560477*^9}},ExpressionUUID->"08fa18dd-e088-4699-aa04-6d616aa0b915"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"getClosestIntegerOrder", "[", 
     RowBox[{"orderVal_", ",", "series_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "seriesSize", ",", "cycleExpList", ",", "nearestExpList", ",", 
        "theVals", ",", "nearestExp", ",", "posArray", ",", "pos", ",", 
        "seriesIndex"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"seriesSize", "=", 
        RowBox[{"Length", "@", 
         RowBox[{"series", "[", "z", "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"cycleExpList", "=", 
        RowBox[{"Exponent", "[", 
         RowBox[{
          RowBox[{"series", "[", "z", "]"}], ",", "z", ",", "List"}], "]"}]}],
        ";", "\[IndentingNewLine]", 
       RowBox[{"nearestExpList", "=", 
        RowBox[{"Nearest", "[", 
         RowBox[{"cycleExpList", ",", "orderVal"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "@", "nearestExpList"}], "==", "0"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"Style", "[", 
            RowBox[{"\"\<exponent not found\>\"", ",", "Red"}], "]"}], "]"}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"theVals", "=", 
           RowBox[{"{", 
            RowBox[{"\"\<ea\>\"", ",", "\"\<ea\>\""}], "}"}]}], ";"}], 
         "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"nearestExp", "=", 
           RowBox[{"nearestExpList", "[", 
            RowBox[{"[", 
             RowBox[{"-", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"posArray", "=", 
           RowBox[{"Position", "[", 
            RowBox[{"cycleExpList", ",", 
             RowBox[{"x_", "/;", 
              RowBox[{"x", "==", "nearestExp"}]}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "@", "posArray"}], "==", "0"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{
               RowBox[{"Style", "[", 
                RowBox[{"\"\<Error with posArray: \>\"", ",", "Red"}], "]"}], 
               ",", "posArray"}], "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"theVals", "=", 
              RowBox[{"{", 
               RowBox[{"\"\<eb\>\"", ",", "\"\<eb\>\""}], "}"}]}], ";"}], 
            "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"pos", "=", 
              RowBox[{"posArray", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"pos", "==", "seriesSize"}], " ", "&&", " ", 
                RowBox[{"orderVal", ">", 
                 RowBox[{"Round", "@", "nearestExp"}]}]}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"Print", "[", 
                 RowBox[{
                  RowBox[{"Style", "[", 
                   RowBox[{
                   "\"\<Requested order of series is greater than max series \
order \>\"", ",", "Red"}], "]"}], ",", 
                  RowBox[{"Style", "[", 
                   RowBox[{
                    RowBox[{"Round", "@", "nearestExp"}], ",", "Red"}], 
                   "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
                RowBox[{"theVals", "=", 
                 RowBox[{"{", 
                  RowBox[{"\"\<e\>\"", ",", "\"\<e\>\""}], "}"}]}], ";"}], 
               "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
               RowBox[{"theVals", "=", 
                RowBox[{"{", 
                 RowBox[{"orderVal", ",", "pos", ",", 
                  RowBox[{"cycleExpList", "[", 
                   RowBox[{"[", "pos", "]"}], "]"}]}], "}"}]}]}], 
              "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", 
           "]"}], ";"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
        "]"}], ";", "\[IndentingNewLine]", "theVals"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.9169264677086935`*^9, 3.9169264961709576`*^9}, {
  3.9169265733869925`*^9, 3.9169265752146606`*^9}, {3.916931338937172*^9, 
  3.916931339780907*^9}, {3.9169369371283903`*^9, 3.916937034386766*^9}},
 CellLabel->"In[49]:=",ExpressionUUID->"a6ffc32f-74c4-481e-8624-a9a743893154"]
}, Closed]],

Cell[CellGroupData[{

Cell["minSheetSeparation using NearestTo", "Subsection",
 CellChangeTimes->{{3.930736286931653*^9, 
  3.9307362939611783`*^9}},ExpressionUUID->"1cdad62f-83d8-4e68-a4de-\
9a0bf78e1f34"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"minSheetSeparation", "[", "wVals_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"nearestList", ",", "nearestDist", ",", "minVal"}], "}"}], ",",
       "\[IndentingNewLine]", " ", 
      RowBox[{
       RowBox[{"nearestList", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"NearestTo", "[", 
              RowBox[{"#1", ",", "2"}], "]"}], "[", "wVals", "]"}], "&"}], "/@",
            " ", "wVals"}], ")"}], "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"nearestDist", "=", 
        RowBox[{"MapThread", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"#1", "-", "#2"}], "]"}], "&"}], ",", 
          RowBox[{"{", 
           RowBox[{"wVals", ",", "nearestList"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Min", "@", "nearestDist"}]}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}]], "Input",
 CellLabel->"In[50]:=",ExpressionUUID->"0102702e-657b-4ac3-a8a8-d72b837df379"]
}, Closed]],

