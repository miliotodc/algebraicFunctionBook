Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{
   RowBox[{
    RowBox[{"continuedAnnuli", "=", 
     RowBox[{
      RowBox[{"continuedAnnuliRecords", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "1"}], "]"}], "]"}], "//", "DeleteDuplicates"}]}],
     ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"continuationList", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"branchPoleLinks", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"continuationBranchTable", "=", 
    RowBox[{"Table", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"currentAnnuli", "=", 
        RowBox[{"continuedAnnuli", "[", 
         RowBox[{"[", "currentAnnuliIndex", "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", " ", 
       RowBox[{"continuedAnnuliBranches", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"Select", "[", 
            RowBox[{"continuedAnnuliRecords", ",", 
             RowBox[{
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "==", "currentAnnuli"}], 
              "&"}]}], "]"}], ")"}], "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2"}], "]"}], "]"}], "//", 
         "DeleteDuplicates"}]}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"currentAnnuliIndex", ",", "1", ",", 
        RowBox[{"Length", "@", "continuedAnnuli"}]}], "}"}]}], 
     "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<continuedAnnuli: \>\"", ",", "continuedAnnuli"}], "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Do", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"\"\<currentAnnuliIndex: \>\"", ",", "currentAnnuliIndex"}], 
        "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"currentAnnuli", "=", 
        RowBox[{"continuedAnnuli", "[", 
         RowBox[{"[", "currentAnnuliIndex", "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<current annuli: \>\"", ",", "currentAnnuli"}], "]"}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"aPos", "=", 
          RowBox[{
           RowBox[{"Position", "[", 
            RowBox[{"continuedAnnuli", ",", 
             RowBox[{"x_", "/;", 
              RowBox[{"x", "==", "currentAnnuli"}]}]}], "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"aPos", "=", 
        RowBox[{
         RowBox[{"Position", "[", 
          RowBox[{"supportedAnnuli", ",", 
           RowBox[{"x_", "/;", 
            RowBox[{"x", "==", "currentAnnuli"}]}]}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"currentAnnularSingularIndexes", "=", 
        RowBox[{"supportedSingularIndexes", "[", 
         RowBox[{"[", "aPos", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"currentAnnularSingularIndexes", "=", 
          RowBox[{"supportedSingularIndexes", "[", 
           RowBox[{"[", "currentAnnuli", "]"}], "]"}]}], ";"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{
        "\"\<  currentAnnularSingularIndexes: \>\"", ",", 
         "currentAnnularSingularIndexes"}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"continuedAnnuliBranches", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"Select", "[", 
            RowBox[{"continuedAnnuliRecords", ",", 
             RowBox[{
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "==", "currentAnnuli"}], 
              "&"}]}], "]"}], ")"}], "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2"}], "]"}], "]"}], "//", 
         "DeleteDuplicates"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{
        "\"\<continuedAnnuliBranches: \>\"", ",", "continuedAnnuliBranches"}],
         "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{"\"\<    current branch: \>\"", ",", "Blue"}], "]"}], ",", 
         "currentContinuedBranch"}], "]"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", "\[IndentingNewLine]", " ", 
        RowBox[{"new", " ", "version"}], "\[IndentingNewLine]", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"currentBranchIndex", "=", "1"}], ";"}], "*)"}], 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"currentContinuedBranchRecords", "=", 
        RowBox[{"Select", "[", 
         RowBox[{"continuedAnnuliRecords", ",", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "==", "currentAnnuli"}], " ", "&&",
              " ", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "==", 
              "currentContinuedBranch"}]}], ")"}], "&"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<          current continued branch records: \>\"", ",", 
         RowBox[{"currentContinuedBranchRecords", "//", "MatrixForm"}]}], 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", "\[IndentingNewLine]", " ", 
        RowBox[{
        "first", " ", "check", " ", "if", " ", "the", " ", "branch", " ", 
         "continued", " ", "onto", " ", "is", " ", "the", " ", "same", " ", 
         "for", " ", "all", " ", "continued", " ", "branch", " ", "records"}],
         " ", "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"continuedOntoBranches", "=", 
        RowBox[{"currentContinuedBranchRecords", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "9"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"Apply", "[", 
          RowBox[{"SameQ", ",", "continuedOntoBranches"}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
          "Print", "[", 
           "\"\<All branch sheets impinging onto same branch\>\"", "]"}], 
          ";"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"theContinuedOntoBranch", "=", 
        RowBox[{"continuedOntoBranches", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"postSheets", "=", 
        RowBox[{"Partition", "[", 
         RowBox[{
          RowBox[{"currentContinuedBranchRecords", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "10"}], "]"}], "]"}], ",", 
          RowBox[{"Length", "@", "currentContinuedBranch"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"\"\<postSheets: \>\"", ",", "postSheets"}], "]"}], ";"}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Count", "[", 
          RowBox[{
           RowBox[{"currentContinuedBranchRecords", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "11"}], "]"}], "]"}], ",", "True"}], "]"}], 
         "\[IndentingNewLine]", 
         RowBox[{"Length", "@", "currentContinuedBranch"}], 
         "\[IndentingNewLine]", " ", 
         RowBox[{"Length", "@", "currentAnnularSingularIndexes"}]}], "*)"}], 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<True count: \>\"", ",", 
         RowBox[{"Count", "[", 
          RowBox[{
           RowBox[{"currentContinuedBranchRecords", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "11"}], "]"}], "]"}], ",", "True"}], "]"}]}],
         "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<continued True branches: \>\"", ",", 
         RowBox[{
          RowBox[{"Length", "@", "currentContinuedBranch"}], " ", 
          RowBox[{"Length", "@", "currentAnnularSingularIndexes"}]}]}], "]"}],
        ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Length of currentAnnularSingularIndexes: \>\"", ",", 
         RowBox[{"Length", "@", "currentAnnularSingularIndexes"}]}], "]"}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"(*", "\[IndentingNewLine]", "  ", 
        RowBox[{
        "Now", " ", "check", " ", "that", " ", "the", " ", "length", " ", 
         "of", " ", "the", " ", "currentContinuedBranchRecords", " ", "is", 
         " ", "equal", " ", "to", " ", "the", " ", "branch", " ", "size", " ",
          "times", " ", "the", " ", "number", " ", "of", " ", "intervening", 
         " ", "singular", " ", "points"}], "\[IndentingNewLine]", " ", "*)"}],
        "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Count", "[", 
           RowBox[{
            RowBox[{"currentContinuedBranchRecords", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "11"}], "]"}], "]"}], ",", "True"}], "]"}], 
          "!=", 
          RowBox[{
           RowBox[{"Length", "@", "currentContinuedBranch"}], " ", 
           RowBox[{"Length", "@", "currentAnnularSingularIndexes"}]}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{"\"\<Annulus \>\"", "<>", 
              RowBox[{"ToString", "@", "currentAnnuli"}], "<>", 
              "\"\< branch \>\"", "<>", 
              RowBox[{"ToString", "@", "currentContinuedBranch"}], "<>", 
              "\"\< not continuing into next annulus\>\""}], ",", "Red"}], 
            "]"}], "]"}], ";"}], "\[IndentingNewLine]", ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{"\"\<Annulus \>\"", "<>", 
              RowBox[{"ToString", "@", "currentAnnuli"}], "<>", 
              "\"\< branch \>\"", "<>", 
              RowBox[{"ToString", "@", "currentContinuedBranch"}], "<>", 
              "\"\< continuing into next annulus \>\"", "<>", 
              RowBox[{"ToString", "@", 
               RowBox[{"(", 
                RowBox[{"currentAnnuli", "+", "1"}], ")"}]}], "<>", 
              "\"\< branch \>\"", "<>", 
              RowBox[{"ToString", "@", "theContinuedOntoBranch"}]}], ",", 
             "Blue"}], "]"}], "]"}], ";", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"continuationList", ",", 
            RowBox[{"{", 
             RowBox[{
             "currentAnnuli", ",", "currentContinuedBranch", ",", 
              "theContinuedOntoBranch"}], "}"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"MemberQ", "[", 
             RowBox[{
              RowBox[{"currentContinuedBranchRecords", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", "8"}], "]"}], "]"}], ",", "True"}], "]"}],
             ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{"Style", "[", 
               RowBox[{"\"\<     Branch meromorphic\>\"", ",", "Red"}], "]"}],
               "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"(*", "\[IndentingNewLine]", " ", 
              RowBox[{"now", " ", "get", " ", "pole", " ", "links"}], 
              "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
             RowBox[{"tempPoleLinks", "=", 
              RowBox[{"Select", "[", 
               RowBox[{"currentContinuedBranchRecords", ",", 
                RowBox[{
                 RowBox[{
                  RowBox[{"#", "[", 
                   RowBox[{"[", "8", "]"}], "]"}], "==", "True"}], "&"}]}], 
               "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"Print", "[", 
              RowBox[{"\"\<tempPoleLinks: \>\"", ",", 
               RowBox[{"tempPoleLinks", "//", "MatrixForm"}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Length", "@", "tempPoleLinks"}], ">", "0"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"thePoleLinks", "=", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "4", "]"}], "]"}], ",", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "3", "]"}], "]"}], ",", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "8", "]"}], "]"}], "==", "True"}], ",", 
                    RowBox[{"Style", "[", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "7", "]"}], "]"}], ",", "Red"}], "]"}], ",", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "7", "]"}], "]"}]}], "]"}], ",", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "10", "]"}], "]"}]}], "}"}], "&"}], "/@", 
                  " ", "tempPoleLinks"}]}], ";", "\[IndentingNewLine]", 
                RowBox[{"AppendTo", "[", 
                 RowBox[{"branchPoleLinks", ",", 
                  RowBox[{"{", 
                   RowBox[{"currentAnnuli", ",", "thePoleLinks"}], "}"}]}], 
                 "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
             "\[IndentingNewLine]", "\[IndentingNewLine]", 
             RowBox[{"Print", "[", 
              RowBox[{"\"\<thePoleLinks: \>\"", ",", 
               RowBox[{"thePoleLinks", "//", "MatrixForm"}]}], "]"}], ";"}]}],
            "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"!", 
             RowBox[{"Apply", "[", 
              RowBox[{"SameQ", ",", "postSheets"}], "]"}]}], ",", " ", 
            RowBox[{"(*", " ", 
             RowBox[{
             "Check", " ", "if", " ", "branch", " ", "sheets", " ", "at", " ",
               "post", " ", "annulus", " ", "impinge", " ", "onto", " ", 
              "the", " ", "post", " ", "annulus", " ", "branch", " ", "in", 
              " ", "the", " ", "same", " ", "order", " ", "over", " ", "all", 
              " ", "singular", " ", "points"}], " ", "*)"}], 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{"Style", "[", 
               RowBox[{
               "\"\<          Branch sheets not impinging onto post-annulus \
branch in the sam order over all singular points\>\"", ",", "Purple"}], "]"}],
               "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"Print", "[", 
              RowBox[{"\"\<postSheets sequence: \>\"", ",", "postSheets"}], 
              "]"}], ";"}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{"Style", "[", 
               RowBox[{
               "\"\<          Branch sheets impinging onto post-annulus \
branch in the same order over all singular points\>\"", ",", "Blue"}], "]"}], 
              "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
