Cell[CellGroupData[{

Cell["getMedialStartVals", "Subsection",
 CellChangeTimes->{{3.916247729484652*^9, 
  3.9162477335773087`*^9}},ExpressionUUID->"b99b803c-1d74-4486-9a16-\
fcdd33669634"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"getMedialStartVals", "[", 
    RowBox[{
    "annulusTable_", ",", "selectedAnnulus_", ",", "selectedBranch_", ",", 
     "annularThetaV_", ",", "implicitF_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "aIndex", ",", "sIndex", ",", "selectedMonodromy", ",", 
       "branchCycleSize", ",", "rNorm", ",", "zStart", ",", "theRoots", ",", 
       "wStart"}], "}"}], ",", "\[IndentingNewLine]", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"aIndex", ",", "sIndex"}], "}"}], "=", 
       RowBox[{"getSingTableIndexes", "[", 
        RowBox[{"annulusTable", ",", "selectedAnnulus"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"selectedMonodromy", "=", 
       RowBox[{"annulusTable", "[", 
        RowBox[{"[", 
         RowBox[{"aIndex", ",", "6"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"branchCycleSize", "=", 
       RowBox[{"Length", "@", 
        RowBox[{"selectedMonodromy", "[", 
         RowBox[{"[", "selectedBranch", "]"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"rNorm", "=", 
       RowBox[{"annulusTable", "[", 
        RowBox[{"[", 
         RowBox[{"aIndex", ",", "4"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"rNorm", "=", 
        RowBox[{"Rationalize", "[", 
         RowBox[{
          RowBox[{"radiiTable", "[", 
           RowBox[{"[", 
            RowBox[{"selectedAnnulus", ",", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"$radialSegments", "-", "1"}], ")"}], "/", "2"}], "+",
               "1"}]}], "]"}], "]"}], ",", 
          RowBox[{"10", "^", 
           RowBox[{"-", "6"}]}]}], "]"}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"zStart", "=", 
       RowBox[{"rNorm", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"I", " ", "annularThetaV"}], "]"}]}]}], " ", ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"theRoots", "=", 
       RowBox[{"w", "/.", 
        RowBox[{"NSolve", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"implicitF", "[", 
            RowBox[{"zStart", ",", "w"}], "]"}], "\[Equal]", "0"}], ",", "w", 
          ",", 
          RowBox[{"WorkingPrecision", "->", "700"}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"wStart", "=", 
       RowBox[{"theRoots", "[", 
        RowBox[{"[", 
         RowBox[{"selectedMonodromy", "[", 
          RowBox[{"[", 
           RowBox[{"selectedBranch", ",", "1"}], "]"}], "]"}], "]"}], "]"}]}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"rNorm", ",", "zStart", ",", "wStart"}], "}"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.935066941233655*^9, 3.935066941233655*^9}, 
   3.942669162213133*^9},
 CellLabel->"In[46]:=",ExpressionUUID->"b5709bca-f848-4b7a-b2c6-0d86540ca018"]
}, Closed]],

Cell[CellGroupData[{

Cell["computeAnnularTerm", "Subsection",
 CellChangeTimes->{{3.916297158278287*^9, 
  3.916297161042883*^9}},ExpressionUUID->"7692ba48-4b31-4bb6-9c86-\
7162a905126f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"computeAnnularTerm", "[", 
    RowBox[{
    "medialSol_", ",", "branchCycleSize_", ",", "tStart_", ",", "tEnd_", ",", 
     "rNorm_", ",", "k_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"intVal", ",", "ratioData", ",", "medialPrec"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"medialPrec", "=", 
       RowBox[{"(", 
        RowBox[{"Precision", "@", "medialSol"}], ")"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"intVal", "=", 
       RowBox[{"Check", "[", 
        RowBox[{
         RowBox[{"NIntegrate", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"medialSol", "[", "t", "]"}], 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Cos", "[", 
               RowBox[{"t", " ", 
                RowBox[{"k", "/", "branchCycleSize"}]}], "]"}], "-", 
              RowBox[{"I", " ", 
               RowBox[{"Sin", "[", 
                RowBox[{"t", " ", 
                 RowBox[{"k", "/", "branchCycleSize"}]}], "]"}]}]}], ")"}]}], 
           ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", "tStart", ",", "tEnd"}], "}"}], ",", 
           RowBox[{"Method", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<GlobalAdaptive\>\"", ",", 
              RowBox[{"\"\<MaxErrorIncreases\>\"", "->", "600"}], ",", 
              RowBox[{"Method", "->", "\"\<LevinRule\>\""}]}], "}"}]}], ",", 
           RowBox[{"WorkingPrecision", "->", "medialPrec"}], ",", 
           RowBox[{"AccuracyGoal", "->", 
            RowBox[{"medialPrec", "/", "2"}]}], ",", 
           RowBox[{"MaxRecursion", "->", "Infinity"}]}], "]"}], ",", 
         RowBox[{"-", "1"}], ",", 
         RowBox[{"NIntegrate", "::", "slwcon"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"intVal", "==", 
         RowBox[{"-", "1"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
         "Print", "[", "\"\<Encountered NIntegrate::slwcon error\>\"", "]"}], 
         ";", "\[IndentingNewLine]", 
         RowBox[{"ratioData", "=", 
          RowBox[{"{", 
           RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], ";"}], 
        "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"ratioData", "=", 
          RowBox[{"rNorm", 
           RowBox[{
            RowBox[{"(", 
             FractionBox[
              RowBox[{"2", " ", "branchCycleSize", " ", "Pi"}], 
              RowBox[{"Abs", "[", "intVal", "]"}]], ")"}], "^", 
            RowBox[{"(", 
             RowBox[{"branchCycleSize", "/", "k"}], ")"}]}]}]}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "/", "k"}], ",", "ratioData", ",", 
        RowBox[{"Abs", "@", "intVal"}]}], "}"}]}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]], "Input",
 CellLabel->"In[47]:=",ExpressionUUID->"b04e8c0e-f05f-4457-98a5-2fec1e29ddee"]
}, Closed]],

