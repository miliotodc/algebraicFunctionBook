Cell[CellGroupData[{

Cell["getPoles", "Subsection",
 CellChangeTimes->{{3.8943662356980977`*^9, 
  3.8943662371510544`*^9}},ExpressionUUID->"b9e27d48-3967-4f17-947f-\
d6bd43ae5955"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"getPoles", "[", 
    RowBox[{"$theFunction_", ",", "theSingularList_", ",", 
     RowBox[{"diag_", ":", "False"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "wExpList", ",", "poleFunction", ",", "pExp", ",", "singPrecision", ",",
        "thePoles", ",", "polePrecision", ",", "thePoleList", ",", "poleF", 
       ",", "poleIndexes", ",", "difTable", ",", "maxDif", ",", 
       "duplicateError", ",", "pTable", ",", "rootPrecisionTable"}], "}"}], 
     ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"wExpList", "=", 
       RowBox[{"Exponent", "[", 
        RowBox[{"$theFunction", ",", "w", ",", "List"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"poleFunction", "=", 
       RowBox[{"Coefficient", "[", 
        RowBox[{"$theFunction", ",", "w", ",", 
         RowBox[{"Max", "@", "wExpList"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"pExp", "=", 
       RowBox[{"Exponent", "[", 
        RowBox[{"poleFunction", ",", "z", ",", "List"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"check", " ", "if", " ", "a_n", 
         RowBox[{"(", "z", ")"}], " ", "is", " ", "a", " ", "polynomial", " ",
          "of", " ", "degree"}], ">", "0"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"singPrecision", "=", 
       RowBox[{"Floor", "@", 
        RowBox[{"Precision", "@", "theSingularList"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Last", "@", "pExp"}], ">", "0"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"thePoles", "=", 
          RowBox[{"Sort", "[", 
           RowBox[{
            RowBox[{"z", "/.", 
             RowBox[{"NSolve", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Factor", "@", "poleFunction"}], "\[Equal]", "0"}], 
               ",", "z", ",", 
               RowBox[{"WorkingPrecision", "\[Rule]", "singPrecision"}]}], 
              "]"}]}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"Abs", "@", "#1"}], "<=", 
              RowBox[{"Abs", "@", "#2"}]}], "&"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", "\[IndentingNewLine]", " ", 
          RowBox[{"now", " ", "confirm", " ", "solutions"}], 
          "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"difTable", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"poleFunction", "/.", 
             RowBox[{"z", "->", "#"}]}], "&"}], "/@", " ", "thePoles"}]}], 
         ";", "\[IndentingNewLine]", 
         RowBox[{"rootPrecisionTable", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"Precision", "@", "#"}], "&"}], "/@", " ", "difTable"}]}],
          ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Min", "@", "rootPrecisionTable"}], ">", "10"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"maxDif", "=", 
             RowBox[{"Max", "@", "difTable"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"maxDif", ">", "$maxRootVerifyDifference"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"Print", "[", 
                RowBox[{"Style", "[", 
                 RowBox[{
                 "\"\<Verification of theZeroPoints roots exceeded the \
$maxRootVerifyDifference\>\"", ",", "Red", ",", "Bold"}], "]"}], "]"}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"Print", "[", 
                RowBox[{"\"\<   maxDif: \>\"", ",", 
                 RowBox[{"N", "[", 
                  RowBox[{"maxDif", ",", "20"}], "]"}]}], "]"}], ";"}]}], 
             "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", 
          "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"polePrecision", "=", 
          RowBox[{"Floor", "@", 
           RowBox[{"Precision", "@", "thePoles"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"duplicateError", "=", 
          RowBox[{
           RowBox[{"Min", "[", 
            RowBox[{"polePrecision", ",", "singPrecision"}], "]"}], "-", 
           "$accuracyComparisonFactor"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"thePoleList", "=", 
          RowBox[{"DeleteDuplicates", "[", 
           RowBox[{"thePoles", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{"#1", "-", "#2"}], "]"}], "<", 
              RowBox[{"10", "^", 
               RowBox[{"-", 
                RowBox[{"(", "duplicateError", ")"}]}]}]}], "&"}]}], "]"}]}], 
         ";"}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"thePoleList", "=", 
          RowBox[{"{", "}"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"poleF", "[", "a_", "]"}], ":=", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"#", "-", "a"}], "]"}], "&"}], "/@", " ", 
         "theSingularList"}], ")"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"poleIndexes", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Position", "[", 
           RowBox[{
            RowBox[{"poleF", "[", "#", "]"}], ",", 
            RowBox[{"Min", "[", 
             RowBox[{"poleF", "[", "#", "]"}], "]"}]}], "]"}], "&"}], "/@", 
         " ", "thePoleList"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "poleIndexes"}]}], "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.894365959024037*^9, 3.894366220801469*^9}, {
  3.8943901200342073`*^9, 3.8943901283291583`*^9}, {3.896423333964148*^9, 
  3.896423341837122*^9}, {3.896423409665063*^9, 3.896423441407426*^9}, {
  3.902928831468609*^9, 3.902928832093462*^9}, {3.9580483242689905`*^9, 
  3.958048324284749*^9}},
 CellLabel->"In[40]:=",ExpressionUUID->"1fc4f011-2b96-4b25-975f-c6a396d8a1e2"]
}, Open  ]],

Cell[CellGroupData[{

Cell["getNewSingularData", "Subsection",
 CellChangeTimes->{{3.9137172931612663`*^9, 3.9137172960667486`*^9}, {
  3.9171066561357794`*^9, 
  3.917106659306924*^9}},ExpressionUUID->"c9adf534-b2d6-4900-8a15-\
629afa918711"],

Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"getNewSingularData", "[", 
      RowBox[{"$theFunction_", ",", 
       RowBox[{"workingPrecision_", ":", "1000"}], ",", 
       RowBox[{"diagFlag_", ":", "False"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "i", ",", "theSingularSet", ",", "theSingularList", ",", "wExpList", 
         ",", "poleFuntion", ",", "pExp", ",", "poleIndexes", ",", 
         "poleFunction", ",", "polePositions", ",", "singularReport", ",", 
         "theArgList", ",", "nearestSing", ",", "nearestDist", ",", 
         "minRadiusArray", ",", "thePoleList", ",", "theReturn", ",", 
         "singAccuracy", ",", "poleAccuracy", ",", "thePoleSet", ",", "poleF",
          ",", "res", ",", "at1", ",", "at2", ",", "zeroIndexes", ",", 
         "originCheck", ",", "argList", ",", "absVals", ",", "ringSizes", ",",
          "minRingSize", ",", "singularListR", ",", "annularSizes", ",", 
         "ringMembers", ",", "polePos", ",", "ringMembersR", ",", "ringTable",
          ",", "snIndex", ",", "ringTableR", ",", "theAnnuli", ",", 
         "radiiTable", ",", "singularRingIndexes"}], "\[IndentingNewLine]", 
        "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"workingPrecision", "<", "1000"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"Style", "[", 
             RowBox[{
             "\"\<WorkingPrecision must be greater than or equal to 1000\>\"",
               ",", "Red"}], "]"}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"theReturn", "=", 
            RowBox[{"ConstantArray", "[", 
             RowBox[{
              RowBox[{"-", "1"}], ",", "12"}], "]"}]}], ";"}], 
          "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"!", 
              RowBox[{"strictPolynomialQ", "[", 
               RowBox[{"$theFunction", ",", 
                RowBox[{"{", 
                 RowBox[{"z", ",", "w"}], "}"}]}], "]"}]}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Print", "[", 
               RowBox[{"Style", "[", 
                RowBox[{
                "\"\<Function not a strict polynomial with rational \
coefficients in z and w\>\"", ",", "Red"}], "]"}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"theReturn", "=", 
               RowBox[{"ConstantArray", "[", 
                RowBox[{
                 RowBox[{"-", "1"}], ",", "12"}], "]"}]}], ";"}], 
             "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"!", 
                 RowBox[{
                 "IrreduciblePolynomialQ", "[", "$theFunction", "]"}]}], ",", 
                "\[IndentingNewLine]", 
                RowBox[{"{", "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"Print", "[", 
                   RowBox[{
                    RowBox[{"Style", "[", 
                    RowBox[{"\"\<Function is reducible:  \>\"", ",", "Red"}], 
                    "]"}], ",", 
                    RowBox[{"Style", "[", 
                    RowBox[{
                    RowBox[{"Factor", "[", "$theFunction", "]"}], ",", 
                    "Red"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
                  RowBox[{"theReturn", "=", 
                   RowBox[{"ConstantArray", "[", 
                    RowBox[{
                    RowBox[{"-", "1"}], ",", "12"}], "]"}]}], ";"}], 
                 "\[IndentingNewLine]", "}"}], "\[IndentingNewLine]", ",", 
                "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"at1", "=", 
                  RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"res", "=", 
                    RowBox[{"Resultant", "[", 
                    RowBox[{"$theFunction", ",", 
                    RowBox[{"D", "[", 
                    RowBox[{"$theFunction", ",", "w"}], "]"}], ",", "w"}], 
                    "]"}]}], ";"}], "\[IndentingNewLine]", "]"}]}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"If", "[", 
                  RowBox[{"diagFlag", ",", "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"Print", "[", 
                    RowBox[{"\"\<Time to compute resultant: \>\"", ",", 
                    RowBox[{"at1", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ";"}]}], 
                  "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
                 RowBox[{"at2", "=", 
                  RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"theSingularSet", "=", 
                    RowBox[{"Sort", "[", 
                    RowBox[{
                    RowBox[{"z", "/.", 
                    RowBox[{"NSolve", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Simplify", "@", "res"}], "\[Equal]", "0"}], ",", 
                    "z", ",", 
                    RowBox[{
                    "WorkingPrecision", "\[Rule]", "workingPrecision"}]}], 
                    "]"}]}], ",", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "@", "#1"}], "<=", " ", 
                    RowBox[{"Abs", "@", "#2"}]}], "&"}]}], "]"}]}], ";"}], 
                   "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
                 RowBox[{"If", "[", 
                  RowBox[{"diagFlag", ",", "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"Print", "[", 
                    RowBox[{"\"\<Time to compute singular points: \>\"", ",", 
                    RowBox[{"at2", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ";"}]}], 
                  "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
                 RowBox[{"singAccuracy", "=", 
                  RowBox[{"Floor", "@", 
                   RowBox[{"Accuracy", "@", "theSingularSet"}]}]}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    RowBox[{"Length", "@", "theSingularSet"}], "==", "0"}], 
                    " ", "||", " ", 
                    RowBox[{"singAccuracy", "<", "900"}]}], ",", 
                   "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"Print", "[", 
                    RowBox[{"Style", "[", 
                    RowBox[{
                    "\"\<No singular points found or sing accuracy<900\>\"", 
                    ",", "Red"}], "]"}], "]"}], ";", "\[IndentingNewLine]", 
                    RowBox[{"theReturn", "=", 
                    RowBox[{"ConstantArray", "[", 
                    RowBox[{
                    RowBox[{"-", "1"}], ",", "12"}], "]"}]}], ";"}], 
                   "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
                   RowBox[{"(*", "\[IndentingNewLine]", " ", 
                    RowBox[{
                    "final", " ", "form", " ", "of", " ", "the", " ", 
                    "singular", " ", "list"}], "\[IndentingNewLine]", "*)"}], 
                   "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"theSingularList", "=", 
                    RowBox[{"DeleteDuplicates", "[", 
                    RowBox[{"theSingularSet", ",", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "[", 
                    RowBox[{"#1", "-", "#2"}], "]"}], "<", 
                    RowBox[{"10", "^", 
                    RowBox[{"-", 
                    RowBox[{"(", 
                    RowBox[{
                    "singAccuracy", "-", "$accuracyComparisonFactor"}], 
                    ")"}]}]}]}], "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
                    RowBox[{"(*", "\[IndentingNewLine]", " ", 
                    RowBox[{
                    "get", " ", "arguments", " ", "of", " ", "singular", " ", 
                    "points"}], "\[IndentingNewLine]", "*)"}], 
                    "\[IndentingNewLine]", 
                    RowBox[{"argList", "=", 
                    RowBox[{"Arg", "@", "theSingularList"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"(*", "\[IndentingNewLine]", " ", 
                    RowBox[{
                    RowBox[{
                    "now", " ", "get", " ", "zero", " ", "points", " ", "a_", 
                    "0", 
                    RowBox[{"(", "z", ")"}]}], "=", 
                    RowBox[{
                    RowBox[{"0", " ", "when", " ", "either", " ", "$a_", "1", 
                    RowBox[{"(", "z", ")"}]}], "=", 
                    RowBox[{
                    RowBox[{"0", " ", "or", " ", "$a_", "0"}], "=", 
                    RowBox[{"a_", "1"}]}]}]}], "\[IndentingNewLine]", "*)"}], 
                    "\[IndentingNewLine]", 
                    RowBox[{"zeroIndexes", "=", 
                    RowBox[{"getZeroIndexes", "[", 
                    RowBox[{
                    "$theFunction", ",", "theSingularList", ",", "False"}], 
                    "]"}]}], ";", "\[IndentingNewLine]", 
                    RowBox[{"(*", "\[IndentingNewLine]", 
                    RowBox[{"get", " ", "poles"}], "\[IndentingNewLine]", 
                    "*)"}], "\[IndentingNewLine]", 
                    RowBox[{"poleIndexes", "=", 
                    RowBox[{"getPoles", "[", 
                    RowBox[{
                    "$theFunction", ",", "theSingularList", ",", "False"}], 
                    "]"}]}], ";", "\[IndentingNewLine]", 
                    RowBox[{"(*", "\[IndentingNewLine]", " ", 
                    RowBox[{
                    RowBox[{
                    "compute", " ", "minArray", " ", "of", " ", "integration",
                     " ", "region", " ", "around", " ", "each", " ", 
                    "singular", " ", "point", " ", "if", " ", "total"}], " ", 
                    ">", " ", "1"}], " ", "\[IndentingNewLine]", "*)"}], 
                    "\[IndentingNewLine]", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Length", "@", "theSingularList"}], ">", "1"}], 
                    ",", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"nearestSing", "=", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"NearestTo", "[", 
                    RowBox[{"#1", ",", "2"}], "]"}], "[", "theSingularList", 
                    "]"}], "&"}], "/@", " ", "theSingularList"}], ")"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"nearestDist", "=", 
                    RowBox[{"MapThread", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"1", "/", "3"}], 
                    RowBox[{"Abs", "[", 
                    RowBox[{"#1", "-", "#2"}], "]"}]}], "&"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"theSingularList", ",", "nearestSing"}], "}"}]}], 
                    "]"}]}], ";", "\[IndentingNewLine]", 
                    RowBox[{"(*", 
                    RowBox[{
                    RowBox[{"nearestSingDist", "=", 
                    RowBox[{"MapThread", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "[", 
                    RowBox[{"#1", "-", "#2"}], "]"}], "&"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"theSingularList", ",", "nearestSing"}], "}"}]}], 
                    "]"}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
                    RowBox[{"For", "[", 
                    RowBox[{
                    RowBox[{"i", "=", "1"}], ",", 
                    RowBox[{"i", "<=", 
                    RowBox[{"Length", "@", "nearestDist"}]}], ",", 
                    RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"nearestDist", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], ">", "10"}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"nearestDist", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "=", "10"}], ";"}]}], 
                    "\[IndentingNewLine]", "]"}], ";"}]}], 
                    "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
                    RowBox[{"minRadiusArray", "=", "nearestDist"}], ";"}], 
                    "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"Print", "[", 
                    RowBox[{"Style", "[", 
                    RowBox[{
                    "\"\<Found only one singular point!\>\"", ",", "Red", ",",
                     "Bold"}], "]"}], "]"}], ";", "\[IndentingNewLine]", 
                    RowBox[{"minRadiusArray", "=", "\[Infinity]"}], ";"}]}], 
                    "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
                    RowBox[{"(*", " ", "\[IndentingNewLine]", 
                    RowBox[{"compute", " ", "rings"}], "\[IndentingNewLine]", 
                    "*)"}], "\[IndentingNewLine]", " ", 
                    RowBox[{"absVals", "=", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "@", "#"}], "&"}], "/@", " ", 
                    "theSingularList"}]}], ";", "\[IndentingNewLine]", 
                    RowBox[{"ringSizes", "=", 
                    RowBox[{"DeleteDuplicates", "[", 
                    RowBox[{"absVals", ",", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "[", 
                    RowBox[{"#1", "-", "#2"}], "]"}], "<", 
                    RowBox[{"10", "^", 
                    RowBox[{"-", "$accuracyComparisonFactor"}]}]}], "&"}]}], 
                    "]"}]}], ";", "\[IndentingNewLine]", 
                    RowBox[{"(*", "\[IndentingNewLine]", "  ", 
                    RowBox[{"compute", " ", "annular", " ", "regions", " ", 
                    RowBox[{"(", 
                    RowBox[{
                    "need", " ", "to", " ", "adjust", " ", "them", " ", "by", 
                    " ", "deltaRing", " ", "for", " ", "numerical", " ", 
                    "work"}], " ", ")"}]}], "\[IndentingNewLine]", "*)"}], 
                    "\[IndentingNewLine]", 
                    RowBox[{"theAnnuli", "=", 
                    RowBox[{"Table", "[", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"ringSizes", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], ",", 
                    RowBox[{"ringSizes", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", "+", "1"}], "]"}], "]"}]}], "}"}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{"{", 
                    RowBox[{"i", ",", "1", ",", 
                    RowBox[{
                    RowBox[{"Length", "@", "ringSizes"}], "-", "1"}]}], 
                    "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
                    RowBox[{"Print", "[", 
                    RowBox[{"\"\<Total annuli: \>\"", ",", 
                    RowBox[{"Length", "@", "theAnnuli"}]}], "]"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"minRingSize", "=", 
                    RowBox[{"Min", "[", 
                    RowBox[{"Differences", "[", "theAnnuli", "]"}], "]"}]}], 
                    ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
                    RowBox[{"AppendTo", "[", 
                    RowBox[{"theAnnuli", ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"ringSizes", "[", 
                    RowBox[{"[", 
                    RowBox[{"-", "1"}], "]"}], "]"}], ",", 
                    RowBox[{
                    RowBox[{"ringSizes", "[", 
                    RowBox[{"[", 
                    RowBox[{"-", "1"}], "]"}], "]"}], "+", "4"}]}], "}"}]}], 
                    "]"}], ";", "\[IndentingNewLine]", 
                    RowBox[{"Print", "[", 
                    RowBox[{"\"\<theAnnuli: \>\"", ",", 
                    RowBox[{"theAnnuli", "//", "N"}]}], "]"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"(*", "\[IndentingNewLine]", " ", 
                    RowBox[{"compute", " ", "radiiTable"}], 
                    "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
                    RowBox[{"radiiTable", "=", 
                    RowBox[{"Table", "[", 
                    RowBox[{
                    RowBox[{"Array", "[", 
                    RowBox[{
                    RowBox[{"#", "&"}], ",", "$radialSegments", ",", 
                    RowBox[{"theAnnuli", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"i", ",", "1", ",", 
                    RowBox[{"Length", "[", "theAnnuli", "]"}]}], "}"}]}], 
                    "]"}]}], ";", "\[IndentingNewLine]", 
                    RowBox[{"(*", 
                    RowBox[{
                    RowBox[{"singularListR", "=", "theSingularList"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"singularListR", "[", 
                    RowBox[{"[", "#", "]"}], "]"}], "=", 
                    RowBox[{"Style", "[", 
                    RowBox[{
                    RowBox[{"N", "[", 
                    RowBox[{
                    RowBox[{"singularListR", "[", 
                    RowBox[{"[", "#", "]"}], "]"}], ",", "6"}], "]"}], ",", 
                    "Red"}], "]"}]}], ")"}], "&"}], "/@", "poleIndexes"}], 
                    ";"}], "\[IndentingNewLine]", "*)"}], 
                    "\[IndentingNewLine]", 
                    RowBox[{"(*", "\[IndentingNewLine]", " ", 
                    RowBox[{"compute", " ", "annular", " ", "sizes"}], 
                    "\[IndentingNewLine]", "*)"}], " ", "\[IndentingNewLine]", 
                    RowBox[{"annularSizes", "=", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "[", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "-", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "&"}], "/@", " ",
                     "theAnnuli"}], "//", "N"}]}], ";", "\[IndentingNewLine]", 
                    RowBox[{"Print", "[", 
                    RowBox[{"\"\<annularSizes: \>\"", ",", 
                    RowBox[{"annularSizes", "//", "N"}]}], "]"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"(*", "\[IndentingNewLine]", "  ", 
                    RowBox[{
                    "determine", " ", "which", " ", "singular", " ", "points",
                     " ", "are", " ", "on", " ", "each", " ", "ring"}], 
                    "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
                    RowBox[{"ringMembers", "=", 
                    RowBox[{"Table", "[", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"Select", "[", 
                    RowBox[{
                    RowBox[{"theSingularList", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ";;"}], "]"}], "]"}], ",", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "[", 
                    RowBox[{
                    RowBox[{"Abs", "[", "#", "]"}], "-", 
                    RowBox[{"theAnnuli", "[", 
                    RowBox[{"[", 
                    RowBox[{"rIndex", ",", "1"}], "]"}], "]"}]}], "]"}], "<", 
                    RowBox[{"10", "^", 
                    RowBox[{"-", "10"}]}]}], "&"}]}], "]"}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{"{", 
                    RowBox[{"rIndex", ",", "1", ",", 
                    RowBox[{"Length", "@", "theAnnuli"}]}], "}"}]}], 
                    "\[IndentingNewLine]", "]"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"(*", "\[IndentingNewLine]", " ", 
                    RowBox[{
                    "determine", " ", "position", " ", "in", " ", 
                    "theSingularList", " ", "for", " ", "each", " ", "ring", 
                    " ", "member"}], "\[IndentingNewLine]", "*)"}], " ", 
                    "\[IndentingNewLine]", 
                    RowBox[{"singularRingIndexes", "=", 
                    RowBox[{"Table", "[", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"Flatten", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Position", "[", 
                    RowBox[{
                    RowBox[{"theSingularList", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ";;"}], "]"}], "]"}], ",", 
                    RowBox[{"x_", "/;", " ", 
                    RowBox[{
                    RowBox[{"Abs", "[", 
                    RowBox[{"x", "-", "#"}], "]"}], "<", 
                    RowBox[{"10", "^", 
                    RowBox[{"-", "10"}]}]}]}]}], "]"}], "&"}], " ", "/@", " ", 
                    RowBox[{"ringMembers", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}], "]"}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{"{", 
                    RowBox[{"j", ",", "1", ",", 
                    RowBox[{"Length", "@", "ringMembers"}]}], "}"}]}], 
                    "\[IndentingNewLine]", "]"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"polePos", "=", 
                    RowBox[{"Flatten", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"Position", "[", 
