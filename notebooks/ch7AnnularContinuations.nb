            RowBox[{"Style", "[", 
             RowBox[{
             "currentBranchSheet", ",", "Black", ",", "Bold", ",", "13"}], 
             "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"zStart", "=", 
           RowBox[{"currentRadius", " ", 
            RowBox[{"Exp", "[", 
             RowBox[{"I", " ", "$thetaV"}], "]"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"theRoots", "=", 
           RowBox[{"Sort", "[", 
            RowBox[{"w", "/.", 
             RowBox[{"NSolve", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"$theFunction", "\[Equal]", "0"}], "/.", 
                RowBox[{"z", "\[Rule]", "zStart"}]}], ",", 
               RowBox[{"WorkingPrecision", "->", "$workingPrecision"}]}], 
              "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"wStartAtLeg1", "=", 
           RowBox[{"theRoots", "[", 
            RowBox[{"[", "currentBranchSheet", "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{"$continuationLegDiagFlag", ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{
               RowBox[{"Style", "[", 
                RowBox[{
