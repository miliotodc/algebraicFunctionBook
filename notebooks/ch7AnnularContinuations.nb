          RowBox[{"\"\<Impinging\>\"", ",", "\"\<sheet\>\""}], "}"}], "]"}], 
        ",", 
        RowBox[{"Column", "[", 
         RowBox[{"{", 
          RowBox[{
          "\"\<Impinging\>\"", ",", "\"\<pole\>\"", ",", "\"\<status\>\""}], 
          "}"}], "]"}], ",", 
        RowBox[{"Column", "[", 
