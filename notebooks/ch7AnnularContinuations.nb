      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<tStart: \>\"", ",", 
        RowBox[{"tStart", "//", "N"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<tEnd: \>\"", ",", 
        RowBox[{"tEnd", "//", "N"}]}], "]"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"wDeriv", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"w", "'"}], "[", "t", "]"}], "\[Equal]", 
