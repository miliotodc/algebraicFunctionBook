          RowBox[{"\"\<Post\>\"", ",", "\"\<branch\>\""}], "}"}], "]"}], ",", 
        RowBox[{"Column", "[", 
         RowBox[{"{", 
          RowBox[{"\"\<Post\>\"", ",", "\"\<sheet\>\""}], "}"}], "]"}], ",", 
        RowBox[{"Column", "[", 
         RowBox[{"{", 
          RowBox[{"\"\<Same\>\"", ",", "\"\<Cycle\>\"", ",", "\"\<flag\>\""}],
           "}"}], "]"}]}], "}"}]}], "]"}], ",", 
    RowBox[{"Dividers", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
