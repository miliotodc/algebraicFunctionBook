  3.9822263007757287`*^9}},ExpressionUUID->"52a82b0b-78ad-403d-84b9-\
b0bbf46a587b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{"do", " ", "arrows"}], "\[IndentingNewLine]", "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", "  ", 
  RowBox[{
   RowBox[{
    RowBox[{"contLinks", "=", 
     RowBox[{"continuationRecords", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "8"}], "}"}]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dy", "=", "0.1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"arrowTranslationFactor", "=", "3.5"}], " ", 
   RowBox[{"(*", " ", "default", " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"arrowTranslationFactor", "=", "2"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"arrowTable", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"currentContLink", "=", 
         RowBox[{"contLinks", "[", 
          RowBox[{"[", "currentContAIndex", "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<currentAnnulus: \>\"", ",", 
          RowBox[{"currentContLink", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"theCurrentAnnulus", "=", 
         RowBox[{"currentContLink", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<currentContLink: \>\"", ",", 
          RowBox[{"currentContLink", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"preAIndex", ",", "preSIndex"}], "}"}], "=", 
         RowBox[{"getSingTableIndexes", "[", 
          RowBox[{"annulusTable", ",", 
           RowBox[{"currentContLink", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"preMonodromy", "=", 
         RowBox[{"annulusTable", "[", 
