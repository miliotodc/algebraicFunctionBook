Cell[CellGroupData[{

Cell["strictPolynomialQ", "Subsection",
 CellChangeTimes->{{3.8893602934364414`*^9, 
  3.8893602965138407`*^9}},ExpressionUUID->"dd440852-6736-4543-a2af-\
b04655402ffc"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"strictPolynomialQ", "[", 
     RowBox[{"myPoly_", ",", 
      RowBox[{"{", 
       RowBox[{"x_", ",", "y_"}], "}"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"levels", ",", "cList", ",", "finalList", ",", "return"}], 
       "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"PolynomialQ", "[", 
          RowBox[{"myPoly", ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", "y"}], "}"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"levels", "=", 
           RowBox[{"Level", "[", 
            RowBox[{"myPoly", ",", 
             RowBox[{"{", 
              RowBox[{"-", "1"}], "}"}], ",", 
             RowBox[{"Heads", "->", "True"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Length", "@", 
               RowBox[{"Position", "[", 
                RowBox[{"levels", ",", "x"}], "]"}]}], ">", "0"}], " ", "&&", 
             " ", 
             RowBox[{
              RowBox[{"Length", "@", 
               RowBox[{"Position", "[", 
                RowBox[{"levels", ",", "y"}], "]"}]}], ">", "0"}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"cList", "=", 
              RowBox[{"Complement", "[", 
               RowBox[{"levels", ",", 
                RowBox[{"{", 
                 RowBox[{
                 "Plus", ",", "Power", ",", "Times", ",", "x", ",", "y"}], 
                 "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"finalList", "=", 
              RowBox[{"Complement", "[", 
               RowBox[{"cList", ",", 
                RowBox[{"Select", "[", 
                 RowBox[{"cList", ",", "NumberQ"}], "]"}]}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Length", "@", "finalList"}], ">", "0"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"Print", "[", 
                 RowBox[{
                  RowBox[{"Style", "[", 
                   RowBox[{
                   "\"\<expression is not strict polynomial in \>\"", ",", 
                    "Red"}], "]"}], ",", 
                  RowBox[{"Style", "[", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"x", ",", "y"}], "}"}], ",", "Red"}], "]"}]}], 
                 "]"}], ";", "\[IndentingNewLine]", 
                RowBox[{"return", "=", "False"}], ";"}], 
               "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"return", "=", "True"}], ";"}]}], 
              "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", ",",
             "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{
               RowBox[{"Style", "[", 
                RowBox[{
                "\"\<expression is not strict polynomial in \>\"", ",", 
                 "Red"}], "]"}], ",", 
               RowBox[{"Style", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"x", ",", "y"}], "}"}], ",", "Red"}], "]"}]}], 
              "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"return", "=", "False"}], ";"}]}], "\[IndentingNewLine]",
            "]"}], ";"}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"return", "=", "False"}], ";"}]}], "\[IndentingNewLine]", 
        "]"}], ";", "\[IndentingNewLine]", "return"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.8893602992317033`*^9, 3.8893603006690025`*^9}, {
  3.8893630345963316`*^9, 3.8893630418912425`*^9}, {3.894371500481982*^9, 
  3.8943715009192405`*^9}, {3.8970419131913157`*^9, 3.897041953096331*^9}},
 CellLabel->"In[42]:=",ExpressionUUID->"6aa5125b-85ad-40cf-b9be-f68953171913"]
}, Closed]],

