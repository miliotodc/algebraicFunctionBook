Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", "\[IndentingNewLine]", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"fileNames", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"seriesFileName", "[", 
        RowBox[{"$theTestCase", ",", "#"}], "]"}], "&"}], "/@", " ", 
      RowBox[{"Range", "[", 
