Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{"do", " ", "annular", " ", "monodromies"}], "\[IndentingNewLine]", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"xLocationSave", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"annuliMonodromyGraphics", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"yOffSet", "=", "20"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"maxWidth", "=", "10"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"netMax", "=", "0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"k", "=", "annuliStart"}], ",", 
      RowBox[{"k", "<=", "annuliEnd"}], ",", 
      RowBox[{"k", "++"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"aIndex", ",", "sIndex"}], "}"}], "=", 
        RowBox[{"getSingTableIndexes", "[", 
         RowBox[{"annulusTable", ",", "k"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Monodromy: \>\"", ",", 
         RowBox[{"annulusTable", "[", 
          RowBox[{"[", 
           RowBox[{"aIndex", ",", "6"}], "]"}], "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"numBranches", "=", 
        RowBox[{"Length", "@", 
         RowBox[{"annulusTable", "[", 
          RowBox[{"[", 
           RowBox[{"aIndex", ",", "6"}], "]"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"locations", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"Array", "[", 
           RowBox[{
            RowBox[{"#", "&"}], ",", 
            RowBox[{"numBranches", "+", "2"}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "maxWidth"}], "}"}]}], "]"}], ")"}], "[", 
         RowBox[{"[", 
          RowBox[{"2", ";;", 
           RowBox[{"-", "2"}]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"xLocationSave", ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "yOffSet", ",", "locations"}], "}"}]}], "]"}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<x-locations: \>\"", ",", "locations"}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"maxX", "=", 
        RowBox[{"locations", "[", 
         RowBox[{"[", 
          RowBox[{"-", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"maxX", ">", "netMax"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"netMax", "=", "maxX"}], ";"}]}], "\[IndentingNewLine]", 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"j", "=", "1"}], ",", 
         RowBox[{"j", "<=", "numBranches"}], ",", 
         RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"AppendTo", "[", 
           RowBox[{"annuliMonodromyGraphics", ",", 
            RowBox[{"Inset", "[", 
             RowBox[{
              RowBox[{"Style", "[", 
               RowBox[{
                RowBox[{"ToString", "[", 
                 RowBox[{"annulusTable", "[", 
                  RowBox[{"[", 
                   RowBox[{"aIndex", ",", "6", ",", "j"}], "]"}], "]"}], 
                 "]"}], ",", "12", ",", "Black", ",", "Bold"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"locations", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], ",", "yOffSet"}], "}"}], ",",
               "Center"}], "]"}]}], "]"}], ";"}]}], "\[IndentingNewLine]", 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"i", "=", "1"}], ",", 
         RowBox[{"i", "<=", 
          RowBox[{"Length", "@", "sIndex"}]}], ",", 
         RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"yOffSet", "-=", "sgIndex"}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"yOffSet", "-=", "agIndex"}], ";"}]}], "\[IndentingNewLine]", 
     "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{"now", " ", "do", " ", "last", " ", "annulus"}], " ", 
    "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"aIndex", ",", "sIndex"}], "}"}], "=", 
      RowBox[{"getSingTableIndexes", "[", 
       RowBox[{"annulusTable", ",", 
        RowBox[{"Length", "@", "theAnnuli"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"numBranches", "=", 
      RowBox[{"Length", "@", 
       RowBox[{"annulusTable", "[", 
        RowBox[{"[", 
         RowBox[{"aIndex", ",", "6"}], "]"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"locations", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"Array", "[", 
         RowBox[{
          RowBox[{"#", "&"}], ",", 
          RowBox[{"numBranches", "+", "2"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "maxWidth"}], "}"}]}], "]"}], ")"}], "[", 
       RowBox[{"[", 
        RowBox[{"2", ";;", 
         RowBox[{"-", "2"}]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"j", "=", "1"}], ",", 
       RowBox[{"j", "<=", "numBranches"}], ",", 
       RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"AppendTo", "[", 
         RowBox[{"annuliMonodromyGraphics", ",", 
          RowBox[{"Inset", "[", 
