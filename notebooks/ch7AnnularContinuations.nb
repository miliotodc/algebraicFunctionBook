Cell[BoxData[{
 RowBox[{
  RowBox[{"branchRegions", "=", " ", 
   RowBox[{"Table", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"aIndex", ",", "sIndex"}], "}"}], "=", 
       RowBox[{"getSingTableIndexes", "[", 
        RowBox[{"annulusTable", ",", "i"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"theMonodromy", "=", 
       RowBox[{"annulusTable", "[", 
        RowBox[{"[", 
         RowBox[{"aIndex", ",", "6"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Table", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"theMonodromy", "[", 
           RowBox[{"[", "j", "]"}], "]"}], ",", 
          RowBox[{"theAnnuli", "[", 
           RowBox[{"[", "i", "]"}], "]"}], ",", "0", ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"i", "+", "1"}]}], "}"}]}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"j", ",", "1", ",", 
          RowBox[{"Length", "@", "theMonodromy"}]}], "}"}]}], 
       "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{"Length", "@", "theAnnuli"}]}], "}"}]}], "\[IndentingNewLine]",
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"branchRegions", "//", "N"}], "//", "MatrixForm"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"  ", 
  RowBox[{
   RowBox[{"For", "[", 
    RowBox[{
     RowBox[{"theCurrentRing", "=", 
      RowBox[{"Length", "@", "theAnnuli"}]}], ",", 
     RowBox[{"theCurrentRing", "\[GreaterEqual]", "2"}], ",", 
     RowBox[{"theCurrentRing", "--"}], ",", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"theCurrentRing", "=", 
         RowBox[{"Length", "[", "branchRegions", "]"}]}], ",", 
        RowBox[{"theCurrentRing", "\[GreaterEqual]", "2"}], ",", 
        RowBox[{"theCurrentRing", "--"}], ","}], "  "}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Print", "[", 
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{"\"\<processing ring: \>\"", ",", "Red"}], "]"}], ",", 
        "theCurrentRing"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"currentRingIndex", ",", "currentSingularIndex"}], "}"}], "=", 
       RowBox[{"getSingTableIndexes", "[", 
        RowBox[{"annulusTable", ",", "theCurrentRing"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"previousRingIndex", ",", "previousSingularIndex"}], "}"}], 
       "=", 
       RowBox[{"getSingTableIndexes", "[", 
        RowBox[{"annulusTable", ",", 
         RowBox[{"theCurrentRing", "-", "1"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "first", " ", "get", " ", "list", " ", "of", " ", "branch", " ", 
        "cycles", " ", "on", " ", "thie", " ", "ring"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"currentBranchCycles", "=", 
       RowBox[{"annulusTable", "[", 
        RowBox[{"[", 
         RowBox[{"currentRingIndex", ",", "6"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"previousBranchCycles", "=", 
       RowBox[{"annulusTable", "[", 
        RowBox[{"[", 
         RowBox[{"previousRingIndex", ",", "6"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "check", " ", "if", " ", "any", " ", "cycles", " ", "are", " ", 
        "continued"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"branchContinuations", "=", 
       RowBox[{"annulusTable", "[", 
        RowBox[{"[", 
         RowBox[{"previousRingIndex", ",", "8"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", "\"\<test1\>\"", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"branchContinuations", "\[NotEqual]", 
         RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"For", "[", 
          RowBox[{
           RowBox[{"j", "=", "1"}], ",", 
           RowBox[{"j", "\[LessEqual]", 
            RowBox[{"Length", "[", "branchContinuations", "]"}]}], ",", 
           RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"currentContinuation", "=", 
             RowBox[{"branchContinuations", "[", 
              RowBox[{"[", "j", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"preBranch", "=", 
             RowBox[{"currentContinuation", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"postBranch", "=", 
             RowBox[{"currentContinuation", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"preBranchpos", "=", 
