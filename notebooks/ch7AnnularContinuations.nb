              RowBox[{"x_", "/;", 
               RowBox[{"x", "==", "k"}]}]}], "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"thePoleLinks", "=", 
