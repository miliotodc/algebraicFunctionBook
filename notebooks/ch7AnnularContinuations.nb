      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"MakeBoxes", "[", "#", "]"}], "&"}], "[", 
         RowBox[{"t", "^", "#"}], "]"}], "&"}], "@*", "First"}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"parenthesizeRow", "[", 
      RowBox[{"boxes", ":", 
       RowBox[{"{", 
        RowBox[{"b", ":", 
         RowBox[{"Except", "[", "_List", "]"}]}], "}"}]}], "]"}], ":=", 
     RowBox[{"RowBox", "[", 
      RowBox[{"{", 
