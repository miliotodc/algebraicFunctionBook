       RowBox[{"[", 
        RowBox[{"2", ";;", 
         RowBox[{"-", "2"}]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"j", "=", "1"}], ",", 
       RowBox[{"j", "<=", "numBranches"}], ",", 
       RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"AppendTo", "[", 
         RowBox[{"annuliMonodromyGraphics", ",", 
          RowBox[{"Inset", "[", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"ToString", "[", 
               RowBox[{"annulusTable", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"-", "1"}], ",", "6", ",", "j"}], "]"}], "]"}], 
               "]"}], ",", "12", ",", "Black", ",", "Bold"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"locations", "[", 
               RowBox[{"[", "j", "]"}], "]"}], ",", "yOffSet"}], "}"}], ",", 
            "Center"}], "]"}]}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}],
      ";", "\[IndentingNewLine]", 
