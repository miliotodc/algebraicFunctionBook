Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"monodromyTable", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"annularSupport", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"annuliMax", "=", 
   RowBox[{"Length", "@", "theAnnuli"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"For", "[", 
    RowBox[{
     RowBox[{"aIndex", "=", "1"}], ",", 
     RowBox[{"aIndex", "<=", 
      RowBox[{"annuliMax", "-", "1"}]}], ",", 
     RowBox[{"aIndex", "++"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"preIndex", "=", 
       RowBox[{"annulusTableAnnIndexes", "[", 
        RowBox[{"[", "aIndex", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{"\"\<current annulus: \>\"", ",", 
          RowBox[{"annulusTable", "[", 
           RowBox[{"[", 
            RowBox[{"preIndex", ",", "1"}], "]"}], "]"}]}], "]"}], ";"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"postIndex", "=", 
       RowBox[{"annulusTableAnnIndexes", "[", 
        RowBox[{"[", 
         RowBox[{"aIndex", "+", "1"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"preMonodromy", "=", 
       RowBox[{"annulusTable", "[", 
        RowBox[{"[", 
         RowBox[{"preIndex", ",", "6"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{"\"\<preMonodromy: \>\"", ",", "preMonodromy"}], "]"}], 
        ";"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"postMonodromy", "=", 
       RowBox[{"annulusTable", "[", 
        RowBox[{"[", 
         RowBox[{"postIndex", ",", "6"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{"\"\<postMonodromy: \>\"", ",", "postMonodromy"}], "]"}], 
        ";"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"postMonodromySizes", "=", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "@", "#"}], "&"}], "/@", " ", "postMonodromy"}], 
        ")"}]}], ";", "\[IndentingNewLine]", " ", 
      RowBox[{"preMonodromySizes", "=", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "@", "#"}], "&"}], "/@", " ", "preMonodromy"}], 
        ")"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"totalSingleCycles", "=", 
       RowBox[{"Count", "[", 
        RowBox[{"postMonodromySizes", ",", "1"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "check", " ", "branch", " ", "support", " ", "between", " ", "pre", 
        " ", "and", " ", "post", " ", "annuli"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"branchSupportArray", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"MemberQ", "[", 
          RowBox[{"postMonodromySizes", ",", "#"}], "]"}], "&"}], "/@", " ", 
        "preMonodromySizes"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"annularSupportIndexes", "=", 
       RowBox[{
        RowBox[{"Position", "[", 
         RowBox[{"branchSupportArray", ",", "True"}], "]"}], "//", 
        "Flatten"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"branchesSupported", "=", 
       RowBox[{"preMonodromy", "[", 
        RowBox[{"[", "annularSupportIndexes", "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
        "for", " ", "each", " ", "branch", " ", "supported", " ", "by", " ", 
         "postMonodromy"}], ",", " ", 
        RowBox[{
         RowBox[{
         "check", " ", "each", " ", "intervening", " ", "singular", " ", 
          "point", " ", "has", " ", "\[IndentingNewLine]", "the", " ", 
          "requisite", " ", "number", " ", "of", " ", "single"}], "-", 
         "cycles"}]}], "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", "\[IndentingNewLine]", " ", 
       RowBox[{
       "now", " ", "get", " ", "intervening", " ", "singular", " ", "point", 
        " ", "monodromies"}], "\[IndentingNewLine]", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"anIndex", ",", "sIndexes"}], "}"}], "=", 
       RowBox[{"getSingTableIndexes", "[", 
        RowBox[{"annulusTable", ",", "aIndex"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"singularIndexes", "=", 
         RowBox[{"singIndexes", "[", 
          RowBox[{"[", "aIndex", "]"}], "]"}]}], ";"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"singMonodromies", "=", 
       RowBox[{"annulusTable", "[", 
        RowBox[{"[", 
         RowBox[{"sIndexes", ",", "6"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"for", " ", "each", " ", "supported", " ", "branch"}], ",", 
        " ", 
        RowBox[{
         RowBox[{
         "check", " ", "all", " ", "intervening", " ", "singular", " ", 
          "point", " ", "have", " ", "requisite", " ", "number", 
          "\[IndentingNewLine]", "of", " ", "single"}], "-", "cycles"}]}], 
       "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"continuedBranches", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "1"}], ",", 
        RowBox[{"i", "<=", 
         RowBox[{"Length", "@", "branchesSupported"}]}], ",", 
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"currentBranchLen", "=", 
          RowBox[{"Length", "@", 
           RowBox[{"branchesSupported", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"totalTrue", "=", "0"}], ";", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{"For", "[", 
          RowBox[{
           RowBox[{"j", "=", "1"}], ",", 
           RowBox[{"j", "<=", 
