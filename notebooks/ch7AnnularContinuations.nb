  3.942567678710622*^9}},ExpressionUUID->"8f15798e-fa14-4d11-a54c-\
05f38423de22"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"getMatchingValue", "[", 
     RowBox[{"testVal_", ",", "comparisonList_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "minSeparation", ",", "minThresholdValue", ",", "difArray", ",", 
        "matchPos", ",", "return"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"minSeparation", "=", 
        RowBox[{"minSheetSeparation", "[", "comparisonList", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"minThresholdValue", "=", 
        RowBox[{"minSeparation", "/", "100"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"difArray", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"testVal", "-", "#"}], "]"}], "&"}], "/@", " ", 
         "comparisonList"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"\"\<difArray: \>\"", ",", 
           RowBox[{"difArray", "//", "N"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{"\"\<minThresholdValue: \>\"", ",", 
           RowBox[{"minThresholdValue", "//", "N"}]}], "]"}], ";"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"matchPos", "=", 
        RowBox[{
         RowBox[{"Position", "[", 
          RowBox[{"difArray", ",", 
           RowBox[{"Min", "[", "difArray", "]"}]}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", "\[IndentingNewLine]", 
        RowBox[{
        "now", " ", "check", " ", "if", " ", "the", " ", "match", " ", "is", 
         " ", "below", " ", "min", " ", "threshold", " ", "value"}], 
        "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"testVal", "-", 
            RowBox[{"comparisonList", "[", 
             RowBox[{"[", "matchPos", "]"}], "]"}]}], "]"}], ">", 
          "minThresholdValue"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"Style", "[", 
            RowBox[{
            "\"\<Leg 1:  match is greater than min threshold value!\>\"", ",",
              "Red", ",", "12", ",", "Bold"}], "]"}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<minThresholdValue: \>\"", ",", 
            RowBox[{"minThresholdValue", "//", "N"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<difArray: \>\"", ",", 
            RowBox[{"N", "[", 
             RowBox[{"difArray", ",", "10"}], "]"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"return", "=", "False"}], ";"}], "\[IndentingNewLine]", ",",
          "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"return", "=", "matchPos"}], ";"}]}], "\[IndentingNewLine]",
         "]"}], ";", "\[IndentingNewLine]", "return"}]}], 
     "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{"getMatchingValue", "[", 
     RowBox[{"testVal_", ",", "comparisonList_", ",", "diagFlag_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "minSeparation", ",", "minThresholdValue", ",", "difArray", ",", 
        "matchPos", ",", "return"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"minSeparation", "=", 
        RowBox[{"minSheetSeparation", "[", "comparisonList", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"minThresholdValue", "=", 
        RowBox[{"minSeparation", "/", "100"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"difArray", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"testVal", "-", "#"}], "]"}], "&"}], "/@", " ", 
         "comparisonList"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{"$getMatchValueDiagFlag", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"\"\<difArray: \>\"", ",", 
            RowBox[{"N", "[", 
             RowBox[{"difArray", ",", "10"}], "]"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<minThresholdValue: \>\"", ",", 
            RowBox[{"minThresholdValue", "//", "N"}]}], "]"}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"matchPos", "=", 
        RowBox[{
         RowBox[{"Position", "[", 
          RowBox[{"difArray", ",", 
           RowBox[{"Min", "[", "difArray", "]"}]}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", "\[IndentingNewLine]", 
        RowBox[{
        "now", " ", "check", " ", "if", " ", "the", " ", "match", " ", "is", 
         " ", "below", " ", "min", " ", "threshold", " ", "value"}], 
        "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"testVal", "-", 
            RowBox[{"comparisonList", "[", 
             RowBox[{"[", "matchPos", "]"}], "]"}]}], "]"}], ">", 
          "minThresholdValue"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"Style", "[", 
            RowBox[{
            "\"\<getMatchingValue:  match is greater than min threshold \
value!\>\"", ",", "Red", ",", "12", ",", "Bold"}], "]"}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<minThresholdValue: \>\"", ",", 
            RowBox[{"minThresholdValue", "//", "N"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<difArray: \>\"", ",", 
            RowBox[{"N", "[", 
             RowBox[{"difArray", ",", "10"}], "]"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"return", "=", "False"}], ";"}], "\[IndentingNewLine]", ",",
          "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"return", "=", "matchPos"}], ";"}]}], "\[IndentingNewLine]",
         "]"}], ";", "\[IndentingNewLine]", "return"}]}], 
     "\[IndentingNewLine]", "]"}]}]}]}]], "Input",
