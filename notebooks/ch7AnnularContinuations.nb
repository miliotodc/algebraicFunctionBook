Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"getMIVPImpingingData", "[", 
     RowBox[{
     "puiseuxSeriesIndex_", ",", "baseSeriesMIVPTable_", ",", 
      "baseBranchTypeArray_", ",", "basePoleList_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "mIVPTableIndex", ",", "mIVPBranchIndex", ",", 
        "branchMonodromyArrayIndex", ",", "theBranchName", ",", 
        "theBranchMIVPData", ",", "seriesMonodromyArray", ",", 
        "impingingSeriesIndex", ",", "impingingRootIndex", ",", 
        "matchingPoleData", ",", "poleStatus", ",", "impingingBranchSize"}], 
       "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"mIVPTableIndex", "=", 
        RowBox[{
         RowBox[{"Position", "[", 
          RowBox[{
           RowBox[{"baseSeriesMIVPTable", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "2", ",", "All", ",", "1"}], "]"}], "]"}], 
           ",", 
           RowBox[{"x_", "/;", 
            RowBox[{"x", "==", "puiseuxSeriesIndex"}]}]}], "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"mIVPBranchIndex", "=", 
        RowBox[{"mIVPTableIndex", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"branchMonodromyArrayIndex", "=", 
        RowBox[{"mIVPTableIndex", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", "\[IndentingNewLine]", " ", 
        RowBox[{
         RowBox[{"from", " ", "mIVPBranchIndex"}], ",", " ", 
         RowBox[{"can", " ", "get", " ", "branch", " ", "name"}]}], 
        "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"theBranchName", "=", 
        RowBox[{"baseBranchTypeArray", "[", 
         RowBox[{"[", 
          RowBox[{"mIVPBranchIndex", ",", "1"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"theBranchMIVPData", "=", 
        RowBox[{"baseSeriesMIVPTable", "[", 
         RowBox[{"[", 
          RowBox[{"mIVPBranchIndex", ",", "2"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"impingingBranchSize", "=", 
        RowBox[{"Length", "@", "theBranchMIVPData"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", "\[IndentingNewLine]", " ", 
        RowBox[{
         RowBox[{"now", " ", "get", " ", "monodromy"}], "-", 
         RowBox[{"series", " ", "cross", " ", "reference", " ", "array"}]}], 
        "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"seriesMonodromyArray", "=", 
        RowBox[{"baseSeriesMIVPTable", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"mIVPTableIndex", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", "2", ",", 
           RowBox[{"mIVPTableIndex", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"impingingSeriesIndex", "=", 
        RowBox[{"seriesMonodromyArray", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"impingingRootIndex", "=", 
        RowBox[{"seriesMonodromyArray", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{
          "\"\<Branch impinging on \>\"", ",", "theBranchName", ",", " ", 
           "\"\< with monodromy index \>\"", ",", "impingingRootIndex", ",", 
           "\"\< Puiseux index \>\"", ",", "impingingSeriesIndex"}], "]"}], 
         " ", ";"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", "\[IndentingNewLine]", " ", 
        RowBox[{"now", " ", "get", " ", "pole", " ", "data"}], 
        "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"matchingPoleData", "=", 
        RowBox[{"basePoleList", "[", 
         RowBox[{"[", 
          RowBox[{"mIVPTableIndex", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"matchingPoleData", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "!=", 
          RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"poleStatus", "=", "True"}], ";"}], "\[IndentingNewLine]", 
         ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"poleStatus", "=", "False"}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
        "theBranchName", ",", "impingingRootIndex", ",", 
         "impingingSeriesIndex", ",", "theBranchMIVPData", ",", 
         "impingingBranchSize", ",", "poleStatus"}], "}"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.9430208646732683`*^9, 3.9430208651573267`*^9}},
 CellLabel->"In[68]:=",ExpressionUUID->"06df6114-94ba-4a65-9a66-2c0dc9574e1a"]
}, Closed]],

Cell[CellGroupData[{

Cell["contourLeg routines", "Subsection",
 CellChangeTimes->{{3.943622118208562*^9, 
  3.943622120473653*^9}},ExpressionUUID->"9b0a24bd-8b67-4afc-8164-\
97a24f5403a5"],

Cell[CellGroupData[{

Cell["processRegLeg", "Subsubsection",
 CellChangeTimes->{{3.943622127581332*^9, 
  3.943622130549391*^9}},ExpressionUUID->"2db9d54b-e140-4666-a4a3-\
d43c1cc08caa"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"processRedLeg", "[", 
     RowBox[{
     "annulusRadius_", ",", "wStartAtLeg1_", ",", "theArg_", ",", 
      "precisionArray_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "tStart", ",", "tEnd", ",", "theZ", ",", "wDeriv", ",", ",", 
        "posFoundFlag", ",", "numTries", ",", "theBaseValues", ",", 
        "matchResult", ",", "wStartAtLeg2", ",", "leg1F", ",", "return"}], 
       "}"}], ",", " ", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"tStart", "=", "$thetaV"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"tEnd", "=", "theArg"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
          RowBox[{"theZ", "[", "t_", "]"}], ":=", 
          RowBox[{"SetPrecision", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"annulusTable", "[", 
              RowBox[{"[", 
               RowBox[{"annulusIndex", ",", "4"}], "]"}], "]"}], " ", 
             RowBox[{"Exp", "[", 
              RowBox[{"\[ImaginaryI]", " ", "t"}], "]"}]}], ",", 
            "$workingPrecision"}], "]"}]}], ";"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"theZ", "[", "t_", "]"}], ":=", 
        RowBox[{"SetPrecision", "[", 
         RowBox[{
          RowBox[{"annulusRadius", " ", 
           RowBox[{"Exp", "[", 
            RowBox[{"\[ImaginaryI]", " ", "t"}], "]"}]}], ",", 
          "$workingPrecision"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"wDeriv", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"w", "'"}], "[", "t", "]"}], "\[Equal]", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", 
              RowBox[{"(", 
               FractionBox[
                RowBox[{"D", "[", 
                 RowBox[{"$theFunction", ",", "z"}], "]"}], 
                RowBox[{"D", "[", 
                 RowBox[{"$theFunction", ",", "w"}], "]"}]], ")"}]}], " ", 
             RowBox[{"(", 
              RowBox[{"D", "[", 
               RowBox[{
                RowBox[{"theZ", "[", "t", "]"}], ",", "t"}], " ", "]"}], 
              ")"}]}], ")"}], "/.", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"w", "\[Rule]", 
              RowBox[{"w", "[", "t", "]"}]}], ",", 
             RowBox[{"z", "\[Rule]", 
              RowBox[{"theZ", "[", "t", "]"}]}]}], "}"}]}], ")"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"posFoundFlag", "=", "False"}], ";", "\[IndentingNewLine]", 
       RowBox[{"numTries", "=", "1"}], ";", "\[IndentingNewLine]", 
       RowBox[{"While", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"posFoundFlag", "\[Equal]", "False"}], " ", "&&", " ", 
          RowBox[{"numTries", "\[LessEqual]", 
           RowBox[{
            RowBox[{"Length", "@", "precisionArray"}], "-", "1"}]}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"numTries", "++"}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
           "$continuationStiffnessSwitching", ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"leg1F", "=", 
              RowBox[{"NDSolveValue", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"wDeriv", ",", 
                  RowBox[{
                   RowBox[{"w", "[", "tStart", "]"}], "\[Equal]", 
                   "wStartAtLeg1"}]}], "}"}], ",", "w", ",", 
                RowBox[{"{", 
                 RowBox[{"t", ",", "tStart", ",", "tEnd"}], "}"}], ",", 
                RowBox[{"MaxSteps", "\[Rule]", "250000"}], ",", 
                RowBox[{"MaxStepSize", "\[Rule]", 
                 RowBox[{"precisionArray", "[", 
                  RowBox[{"[", 
                   RowBox[{"numTries", ",", "1"}], "]"}], "]"}]}], ",", 
                RowBox[{"WorkingPrecision", "\[Rule]", 
                 RowBox[{"precisionArray", "[", 
                  RowBox[{"[", 
                   RowBox[{"numTries", ",", "2"}], "]"}], "]"}]}], ",", 
                RowBox[{"Method", "->", "\"\<StiffnessSwitching\>\""}]}], 
               "]"}]}], ";"}], "\[IndentingNewLine]", ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"leg1F", "=", 
              RowBox[{"NDSolveValue", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"wDeriv", ",", 
                  RowBox[{
                   RowBox[{"w", "[", "tStart", "]"}], "\[Equal]", 
                   "wStartAtLeg1"}]}], "}"}], ",", "w", ",", 
                RowBox[{"{", 
                 RowBox[{"t", ",", "tStart", ",", "tEnd"}], "}"}], ",", 
                RowBox[{"MaxSteps", "\[Rule]", "250000"}], ",", 
                RowBox[{"MaxStepSize", "\[Rule]", 
                 RowBox[{"precisionArray", "[", 
                  RowBox[{"[", 
                   RowBox[{"numTries", ",", "1"}], "]"}], "]"}]}], ",", 
                RowBox[{"WorkingPrecision", "\[Rule]", 
                 RowBox[{"precisionArray", "[", 
                  RowBox[{"[", 
                   RowBox[{"numTries", ",", "2"}], "]"}], "]"}]}]}], "]"}]}], 
             ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{"theVaseValues", ",", "matchResult", ",", "wStartAtLeg2"}],
            "*)"}], "\[IndentingNewLine]", 
          RowBox[{"theBaseValues", "=", 
           RowBox[{"Sort", "[", 
            RowBox[{
             RowBox[{"w", "/.", 
              RowBox[{"NSolve", "[", 
               RowBox[{
                RowBox[{"$theFunction", "\[Equal]", "0"}], "/.", 
                RowBox[{"z", "\[Rule]", 
                 RowBox[{"theZ", "[", "tEnd", "]"}]}]}], "]"}]}], ",", 
             RowBox[{"WorkingPrecision", "->", "40"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", " ", "\[IndentingNewLine]", "  ", 
           RowBox[{
           "Get", " ", "matching", " ", "value", " ", "and", " ", "check", 
            " ", "against", " ", "min", " ", "threshold", " ", "separation"}],
            "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
          RowBox[{"matchResult", "=", 
           RowBox[{"getMatchingValue", "[", 
            RowBox[{
             RowBox[{"leg1F", "[", "tEnd", "]"}], ",", "theBaseValues", ",", 
             "False"}], "]"}]}], ";", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"matchResult", "===", "False"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{"Style", "[", 
               RowBox[{
               "\"\<Leg 1:  match is greater than min threshold value!\>\"", 
                ",", "Red", ",", "12", ",", "Bold"}], "]"}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"Print", "[", 
              RowBox[{"Style", "[", 
               RowBox[{
               "\"\<     Increasing precision\>\"", ",", "12", ",", "Bold", 
                ",", "Red"}], "]"}], "]"}], ";"}], "\[IndentingNewLine]", ",",
             "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"wStartAtLeg2", "=", 
              RowBox[{"theBaseValues", "[", 
               RowBox[{"[", "matchResult", "]"}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"posFoundFlag", "=", "True"}], ";"}]}], 
           "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"posFoundFlag", "\[Equal]", "False"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"Style", "[", 
            RowBox[{
            "\"\<Position not found at end of 10 attempts at increasing \
precision.\>\"", ",", "14", ",", "Red"}], "]"}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"return", "=", "False"}], ";", "\[IndentingNewLine]", 
          RowBox[{"Abort", "[", "]"}]}], "\[IndentingNewLine]", ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"return", "=", "wStartAtLeg2"}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       "return"}]}], "\[IndentingNewLine]", "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.943607753865791*^9, 3.9436077793597145`*^9}, {
  3.958048324570588*^9, 3.958048324570588*^9}, {3.95831065868217*^9, 
  3.9583106634066043`*^9}, {3.958388147919325*^9, 3.9583881481762376`*^9}},
