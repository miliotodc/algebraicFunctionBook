           "First"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{"at", " ", "this", " ", "point"}], ",", " ", 
          RowBox[{
           RowBox[{
           "the", " ", "cycle", " ", "sheet", " ", "being", " ", "tested", 
            " ", "on", " ", "the", " ", "pre"}], "-", 
           RowBox[{
           "ring", " ", "is", " ", "continued", " ", "onto", " ", "this", " ",
             "post", " ", "ring", " ", 
            RowBox[{"cycle", ":"}]}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"postRingBranch", "=", 
         RowBox[{"nextAnnulusCycles", "[", 
          RowBox[{"[", 
           RowBox[{"nextRingCyclePosition", "//", "First"}], "]"}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
