Cell[CellGroupData[{

Cell["Section 8.4.5:  Set up singular monodromies", "Subsubsection",
 CellChangeTimes->{{3.9822249346587267`*^9, 3.9822249435260615`*^9}, {
  3.9869765860435038`*^9, 
  3.9869765861651397`*^9}},ExpressionUUID->"c8109180-2a72-42ee-aac4-\
f65a9b702d59"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{"do", " ", "singular", " ", "monodromies"}], "\[IndentingNewLine]",
    "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"sData", "=", 
     RowBox[{"Import", "[", 
      RowBox[{"singularMonodromyFileName", "[", "$theTestCase", "]"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"singularMonodromies", "=", 
     RowBox[{"sData", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"MapThread", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"#1", ",", "#2", ",", "#3"}], "}"}], "&"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"Length", "@", "$theSingularList"}], "]"}], ",", 
        "singularMonodromies", ",", 
        RowBox[{"$minRadiusArray", "//", "N"}]}], "}"}]}], "]"}], "//", 
    "MatrixForm"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"yOffSet", "=", "20"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{
    "first", " ", "do", " ", "singular", " ", "point", " ", "at", " ", 
     "origin", " ", "if", " ", "needed"}], "\[IndentingNewLine]", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"singularPointMonodromyGraphics", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"$theSingularList", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "==", "0"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"AppendTo", "[", 
        RowBox[{"singularPointMonodromyGraphics", ",", 
         RowBox[{"Inset", "[", 
          RowBox[{
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{"ToString", "@", 
              RowBox[{"singularMonodromies", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], ",", "12"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", 
             RowBox[{"yOffSet", "+", "sgIndex"}]}], "}"}], ",", "Left"}], 
          "]"}]}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"k", "=", "1"}], ",", 
      RowBox[{"k", "<=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"Length", "@", "theAnnuli"}], ")"}], "-", "1"}]}], ",", 
      RowBox[{"k", "++"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"aIndex", ",", "sIndex"}], "}"}], "=", 
        RowBox[{"getSingTableIndexes", "[", 
         RowBox[{"annulusTable", ",", "k"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"j", "=", "1"}], ",", 
         RowBox[{"j", "<=", 
          RowBox[{"Length", "@", "sIndex"}]}], ",", 
         RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"singIndexes", "=", 
           RowBox[{"ringMemberSingularIndexes", "[", 
            RowBox[{"[", "k", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"yOffSet", "-=", "sgIndex"}], ";", "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"singularLoc", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"singIndexes", "[", 
               RowBox[{"[", "j", "]"}], "]"}], ",", "yOffSet"}], "}"}]}], 
           "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<the sing monodromy: \>\"", ",", 
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"annulusTableR", "[", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{"sIndex", "[", 
                  RowBox[{"[", "j", "]"}], "]"}], ",", "6"}], "]"}], "]"}], 
              ",", "12"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
