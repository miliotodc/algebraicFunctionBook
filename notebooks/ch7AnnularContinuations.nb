                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"sIndex", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], ",", "2"}], "]"}], "]"}], 
                    "]"}], ",", "12"}], "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"0", ",", "yOffSet"}], "}"}], ",", "Left"}], 
