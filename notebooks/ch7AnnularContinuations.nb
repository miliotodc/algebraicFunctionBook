   RowBox[{
    RowBox[{
     RowBox[{"processPurpleLeg", "[", 
      RowBox[{
      "annulusRadius_", ",", "wStartAtLeg5_", ",", "currentArgument_", ",", 
       "precisionArray_", ",", "nextAnnulusRadius_", ",", 
