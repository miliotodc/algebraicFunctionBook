                  RowBox[{"precisionArray", "[", 
                   RowBox[{"[", 
                    RowBox[{"numTries", ",", "1"}], "]"}], "]"}]}], ",", 
                 RowBox[{"WorkingPrecision", "\[Rule]", 
                  RowBox[{"precisionArray", "[", 
                   RowBox[{"[", 
                    RowBox[{"numTries", ",", "2"}], "]"}], "]"}]}], ",", 
                 RowBox[{"Method", "->", "\"\<StiffnessSwitching\>\""}]}], 
                "]"}]}], ";"}], "\[IndentingNewLine]", ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"leg5F", "=", 
               RowBox[{"NDSolveValue", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"wDeriv", ",", 
                   RowBox[{
                    RowBox[{"w", "[", "tStart", "]"}], "\[Equal]", 
                    "wStartAtLeg5"}]}], "}"}], ",", "w", ",", 
                 RowBox[{"{", 
                  RowBox[{"t", ",", "tStart", ",", "tEnd"}], "}"}], ",", 
                 RowBox[{"MaxSteps", "\[Rule]", "10000000"}], ",", 
                 RowBox[{"MaxStepSize", "\[Rule]", 
                  RowBox[{"precisionArray", "[", 
                   RowBox[{"[", 
                    RowBox[{"numTries", ",", "1"}], "]"}], "]"}]}], ",", 
                 RowBox[{"WorkingPrecision", "\[Rule]", 
                  RowBox[{"precisionArray", "[", 
                   RowBox[{"[", 
                    RowBox[{"numTries", ",", "2"}], "]"}], "]"}]}]}], "]"}]}],
               ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{
            "theBaseValues", ",", "matchResult", ",", "endingLeg5Position"}], 
            " ", "*)"}], "\[IndentingNewLine]", 
           RowBox[{"theBaseValues", "=", 
            RowBox[{"w", "/.", 
             RowBox[{"NSolve", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"$theFunction", "\[Equal]", "0"}], "/.", 
                RowBox[{"z", "\[Rule]", 
                 RowBox[{"theZ", "[", "tEnd", "]"}]}]}], ",", 
               RowBox[{"WorkingPrecision", "->", "40"}]}], "]"}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"theBaseValues", "=", 
            RowBox[{"Sort", "[", "theBaseValues", "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"matchResult", "=", 
            RowBox[{"getMatchingValue", "[", 
             RowBox[{
              RowBox[{"leg5F", "[", "tEnd", "]"}], ",", "theBaseValues", ",", 
              "False"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{"$getMatchValueDiagFlag", ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Print", "[", 
               RowBox[{"\"\<getMatchResult value: \>\"", ",", 
                RowBox[{"matchResult", "//", "N"}]}], "]"}], ";"}]}], 
            "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"endingLeg5Position", "=", "matchResult"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"matchResult", "===", "False"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Print", "[", 
               RowBox[{"\"\<Leg 5 value at leg end: \>\"", ",", 
                RowBox[{"N", "[", 
                 RowBox[{
                  RowBox[{"leg5F", "[", "tEnd", "]"}], ",", "10"}], "]"}]}], 
               "]"}], ";", "\[IndentingNewLine]", 
              RowBox[{"Print", "[", 
               RowBox[{"\"\<Base values at leg end: \>\"", ",", 
                RowBox[{"N", "[", 
                 RowBox[{"theBaseValues", ",", "10"}], "]"}]}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"Print", "[", 
               RowBox[{"Style", "[", 
                RowBox[{
                "\"\<Leg 5:  match is greater than min threshold value!\>\"", 
                 ",", "Red", ",", "12", ",", "Bold"}], "]"}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"matchResult", "=", 
               RowBox[{"getMatchingValue", "[", 
                RowBox[{
                 RowBox[{"leg5F", "[", "tEnd", "]"}], ",", "theBaseValues", 
                 ",", "True"}], "]"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"Print", "[", 
               RowBox[{
                RowBox[{"Style", "[", 
                 RowBox[{
                 "\"\<     Increasing precision to \>\"", ",", "12", ",", 
                  "Bold", ",", "Red"}], "]"}], ",", 
                RowBox[{"precisionArray", "[", 
                 RowBox[{"[", "numTries", "]"}], "]"}]}], "]"}], ";"}], 
             "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"If", "[", 
