                RowBox[{
                 RowBox[{
                 "Print", "[", 
                  "\"\<  This annular index and branch is in pole \
records\>\"", "]"}], ";", "\[IndentingNewLine]", 
                 RowBox[{"poleFlag", "=", "True"}], ";"}]}], 
               "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
             "*)"}], "\[IndentingNewLine]", 
            RowBox[{"(*", " ", 
             RowBox[{
             "first", " ", "check", " ", "if", " ", "this", " ", "branch", 
