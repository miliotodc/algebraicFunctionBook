      "cycleSize", ",", "zFun", ",", "tEnd", ",", "wDeriv", ",", "selected", 
       ",", "aIndex", ",", "sIndex", ",", "zStart", ",", "selectedMonodromy", 
       ",", "theRoots", ",", "tStart", ",", "wStart", ",", "medialSol", ",", 
