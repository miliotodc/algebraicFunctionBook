d0bfc851f546"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{
    "theFinalContinuationList", " ", "is", " ", "the", " ", "array", " ", 
     "which", " ", "holds", " ", "the", " ", "analytically"}], "-", 
    RowBox[{
    "continued", " ", "domains", " ", "of", " ", "all", " ", "annular", " ", 
     "branches"}]}], "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"theFinalContinuationList", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"i", "=", "1"}], ",", 
      RowBox[{"i", "<=", 
       RowBox[{"Length", "@", "theAnnuli"}]}], ",", 
      RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{"\"\<branchRegion: \>\"", ",", 
          RowBox[{
           RowBox[{"branchRegions", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "//", "N"}]}], "]"}], ";"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"branchRegions", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "!=", 
          RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"AppendTo", "[", 
           RowBox[{"theFinalContinuationList", ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", 
              RowBox[{"branchRegions", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "All", ",", 
                 RowBox[{"{", 
                  RowBox[{"1", ",", "2", ",", "4"}], "}"}]}], "]"}], "]"}]}], 
             "}"}]}], "]"}], ";"}], "\[IndentingNewLine]", ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"AppendTo", "[", 
           RowBox[{"theFinalContinuationList", ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", 
              RowBox[{"{", "}"}]}], "}"}]}], "]"}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"theFinalContinuationList", "//", "N"}], ",", 
     RowBox[{"Alignment", "->", "Left"}]}], "]"}], 
   "\[IndentingNewLine]"}]}]], "Input",
