Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{"do", " ", "the", " ", "singular", " ", "points"}], 
   "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"starRecords", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"updatedPoleAnalysisReport", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "8", "]"}], "]"}], "==", "\"\<*\>\""}], "&"}]}], 
      "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"starRecords", "//", "N"}], "//", "MatrixForm"}]}], 
   "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"singularLoc", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"singularPointGraphics", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"yOffSet", "=", "20"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "do", " ", "singular", " ", "point", " ", "at", " ", "zero", " ", "if", 
     " ", "necessary"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"annulusTable", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "1"}], "]"}], "]"}], "==", "\"\< \>\""}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"do", " ", "singular", " ", "point", " ", "in", " ", "blue"}], 
       " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"AppendTo", "[", 
        RowBox[{"singularPointGraphics", ",", 
         RowBox[{"Inset", "[", 
          RowBox[{
           RowBox[{"Style", "[", 
            RowBox[{"annulusTable", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "3"}], "]"}], "]"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", 
             RowBox[{"yOffSet", "+", "sgIndex"}]}], "}"}], ",", "Left"}], 
          "]"}]}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"poleLinkGraphicData", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"k", "=", "1"}], ",", 
      RowBox[{"k", "<=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"Length", "@", "theAnnuli"}], ")"}], "-", "1"}]}], ",", 
      RowBox[{"k", "++"}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", "\[IndentingNewLine]", " ", 
       RowBox[{
       "check", " ", "if", " ", "this", " ", "annulus", " ", "has", " ", "a", 
        " ", "pole", " ", "link"}], "\[IndentingNewLine]", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"MemberQ", "[", 
          RowBox[{
           RowBox[{"newPoleLinkTable", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", "k"}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{
           "\"\<Annulus \>\"", ",", "k", ",", "\"\< has a pole link\>\""}], 
           "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"aIndex2", ",", "sIndex2"}], "}"}], "=", 
           RowBox[{"getSingTableIndexes", "[", 
            RowBox[{"annulusTable", ",", "k"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"theCurrentMonodromy", "=", 
           RowBox[{"annulusTable", "[", 
            RowBox[{"[", 
             RowBox[{"aIndex2", ",", "6"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{
           "\"\<  annulus monodromy: \>\"", ",", "theCurrentMonodromy"}], 
           "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"poleLinkPos", "=", 
           RowBox[{
            RowBox[{"Position", "[", 
             RowBox[{
              RowBox[{"newPoleLinkTable", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", 
              RowBox[{"x_", "/;", 
               RowBox[{"x", "==", "k"}]}]}], "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"thePoleLinks", "=", 
           RowBox[{"Sort", "[", 
            RowBox[{
             RowBox[{"newPoleLinkTable", "[", 
              RowBox[{"[", 
               RowBox[{"poleLinkPos", ",", "2"}], "]"}], "]"}], ",", 
