1240422f9ec6"],

Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
   "get", " ", "differential", " ", "monodromy", " ", "around", " ", "a", " ",
     "singular", " ", "point"}], "\[IndentingNewLine]", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Options", "[", "getSingularMonodromy", "]"}], "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<nSolveWP\>\"", "->", "50"}], ",", 
       RowBox[{"\"\<integrateWP\>\"", "->", "50"}], ",", 
       RowBox[{"\"\<polishWP\>\"", "->", "20"}], ",", 
       RowBox[{"\"\<diagFlag\>\"", "->", "False"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"getSingularMonodromy", "[", 
     RowBox[{"theSingularPoint_", ",", "rNorm_", ",", 
      RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "z0", ",", "singularRoots", ",", "wArray", ",", "branchVals", ",", 
        "polishedVals", ",", "pArray", ",", "theCycles", ",", "theLinks", ",",
         "oneCycles", ",", "finalCycles"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"\"\<nSolveWP: \>\"", ",", 
         RowBox[{"OptionValue", "[", "\"\<nSolveWP\>\"", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"z0", "=", 
        RowBox[{"theSingularPoint", "+", 
         RowBox[{"rNorm", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"I", " ", "$thetaV"}], "]"}]}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<z0: \>\"", ",", 
         RowBox[{"z0", "//", "N"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"singularRoots", "=", 
        RowBox[{"Sort", "[", 
         RowBox[{"w", "/.", 
          RowBox[{"NSolve", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"$theFunction", "==", "0"}], "/.", 
             RowBox[{"z", "->", "z0"}]}], ",", "w", ",", 
            RowBox[{"WorkingPrecision", "->", 
             RowBox[{"OptionValue", "[", "\"\<nSolveWP\>\"", "]"}]}]}], 
           "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"wArray", "=", 
        RowBox[{"MapThread", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"#1", ",", "#2"}], "}"}], "&"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Range", "[", 
             RowBox[{"Length", "@", "singularRoots"}], "]"}], ",", 
            "singularRoots"}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", "\"\<test2\>\"", "]"}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", " ", 
       RowBox[{"branchVals", "=", 
        RowBox[{"integrateOverSheet", "[", 
         RowBox[{
         "z0", ",", "theSingularPoint", ",", "$thetaV", ",", "wArray", ",", 
          "rNorm", ",", "False", ",", 
          RowBox[{"OptionValue", "[", "\"\<integrateWP\>\"", "]"}]}], "]"}]}],
        ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"polishedVals", "=", 
        RowBox[{"polishBranchTerms", "[", 
         RowBox[{"z0", ",", "branchVals", ",", 
          RowBox[{"OptionValue", "[", "\"\<polishWP\>\"", "]"}]}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"OptionValue", "[", "\"\<diagFlag\>\"", "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"\"\<polishedVals: \>\"", ",", 
            RowBox[{
             RowBox[{"polishedVals", "//", "N"}], "//", "MatrixForm"}]}], 
           "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"pArray", "=", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Position", "[", 
            RowBox[{
             RowBox[{"polishedVals", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
             RowBox[{"x_", "/;", 
              RowBox[{
               RowBox[{"Abs", "[", 
                RowBox[{"x", "-", "#"}], "]"}], "<", 
               RowBox[{"10", "^", 
                RowBox[{"-", "20"}]}]}]}]}], "]"}], "&"}], "/@", " ", 
          RowBox[{"polishedVals", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "3"}], "]"}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"theCycles", "=", 
        RowBox[{"PermutationCycles", "[", "pArray", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"theLinks", "=", 
        RowBox[{"theCycles", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"oneCycles", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"{", "#", "}"}], "&"}], "/@", 
         RowBox[{"Complement", "[", 
          RowBox[{
           RowBox[{"Range", "[", "functionDegree", "]"}], ",", 
           RowBox[{"Flatten", "[", "theLinks", "]"}]}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"finalCycles", "=", 
        RowBox[{"Join", "[", 
         RowBox[{"theLinks", ",", "oneCycles"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Sort", "[", 
           RowBox[{"Flatten", "@", "finalCycles"}], "]"}], "!=", 
          RowBox[{"Range", "[", 
           RowBox[{"Length", "@", 
            RowBox[{"Flatten", "@", "finalCycles"}]}], "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"Style", "[", 
            RowBox[{
            "\"\<Monodromy is not consistent!\>\"", ",", "Purple", ",", 
             "14"}], "]"}], "]"}], ";"}], "\[IndentingNewLine]", ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"Style", "[", 
            RowBox[{"\"\<Monodromy is consistent\>\"", ",", 
             RowBox[{"Darker", "@", "Green"}], ",", "12"}], "]"}], "]"}], 
          ";"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"finalCycles", ",", "polishedVals"}], "}"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.9292797337343035`*^9, 3.929279734077978*^9}, {
   3.929342083325768*^9, 3.9293420903241653`*^9}, {3.929343498732478*^9, 
   3.9293435064184375`*^9}, {3.9418018388072977`*^9, 3.941801846071035*^9}, {
