           RowBox[{
           "\"\<          Purple contour impinging upon post annulus branch \
\>\"", ",", "postRingBranch", ",", "\"\< sheet \>\"", ",", 
            "thePostRingSheet"}], "]"}], ";"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"{", 
