                    RowBox[{"annulusTable", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"sIndex", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], ",", "2"}], "]"}], "]"}], 
                    "]"}], ",", "12"}], "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"0", ",", "yOffSet"}], "}"}], ",", "Left"}], 
                "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"AppendTo", "[", 
              RowBox[{"singularPointIndexGraphics", ",", 
               RowBox[{"Inset", "[", 
                RowBox[{
                 RowBox[{"Style", "[", 
