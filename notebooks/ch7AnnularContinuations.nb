Cell[BoxData[{
 RowBox[{
  RowBox[{"poleRecords", "=", 
   RowBox[{"Select", "[", 
    RowBox[{"continuedAnnuliRecords", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"#", "[", 
        RowBox[{"[", "8", "]"}], "]"}], "==", "True"}], "&"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"poleRecordsGrid", "=", 
  RowBox[{"Grid", "[", 
   RowBox[{
    RowBox[{"Prepend", "[", 
     RowBox[{"poleRecords", ",", 
      RowBox[{"{", 
       RowBox[{
       "\"\<\!\(\*SubscriptBox[\(a\), \(n\)]\)\>\"", ",", "\"\<Branch\>\"", 
        ",", "\"\<Sheet\>\"", ",", 
        "\"\<\!\(\*SubscriptBox[\(s\), \(n\)]\)\>\"", ",", 
        RowBox[{"Column", "[", 
         RowBox[{"{", 
          RowBox[{
          "\"\<Impinging\>\"", ",", "\"\<Branch\>\"", ",", "\"\<name\>\""}], 
          "}"}], "]"}], ",", 
        RowBox[{"Column", "[", 
         RowBox[{"{", 
          RowBox[{"\"\<Impinging\>\"", ",", "\"\<Branch\>\""}], "}"}], "]"}], 
        ",", 
        RowBox[{"Column", "[", 
         RowBox[{"{", 
          RowBox[{"\"\<Impinging\>\"", ",", "\"\<sheet\>\""}], "}"}], "]"}], 
        ",", 
        RowBox[{"Column", "[", 
         RowBox[{"{", 
