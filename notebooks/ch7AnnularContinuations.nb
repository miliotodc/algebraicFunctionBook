Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"getSingularData", "[", 
     RowBox[{"testCase_", ",", "baseSingularIndex_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "baseSingularPoint", ",", "baseRadius", ",", "dataList", ",", 
        "baseBranchTypeArray", ",", "baseSeriesMIVPTable", ",", 
        "newSingularIndex", ",", "newSing", ",", "baseCycleMetric", ",", 
        "basePoleList", ",", "newConjList", ",", "baseRemovableList", ",", 
        "baseSeries", ",", "baseSheetLinks", ",", "baseSingSequence", ",", 
        "return"}], "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      " ", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"TrueQ", "@", 
          RowBox[{"FileExistsQ", "@", 
           RowBox[{"seriesFileName", "[", 
            RowBox[{"testCase", ",", "baseSingularIndex"}], "]"}]}]}], ",", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"baseSingularPoint", "=", 
           RowBox[{"$theSingularList", "[", 
            RowBox[{"[", "baseSingularIndex", "]"}], "]"}]}], ";", " ", 
          "\[IndentingNewLine]", 
          RowBox[{"baseRadius", "=", 
           RowBox[{"$minRadiusArray", "[", 
            RowBox[{"[", "baseSingularIndex", "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"Print", "[", 
             RowBox[{"\"\<baseSingularPoint: \>\"", ",", 
              RowBox[{
               RowBox[{"$theSingularList", "[", 
                RowBox[{"[", "baseSingularIndex", "]"}], "]"}], "//", "N"}]}],
              "]"}], ";", "\[IndentingNewLine]", 
            RowBox[{"Print", "[", 
             RowBox[{"\"\<Importing file: \>\"", ",", 
              RowBox[{"seriesFileName", "[", "baseSingularIndex", "]"}]}], 
             "]"}], ";"}], "*)"}], "\[IndentingNewLine]", 
          RowBox[{"dataList", "=", 
           RowBox[{"Import", "[", 
            RowBox[{"seriesFileName", "[", 
             RowBox[{"testCase", ",", "baseSingularIndex"}], "]"}], "]"}]}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"baseBranchTypeArray", "=", 
           RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"baseSeriesMIVPTable", "=", 
           RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "@", "dataList"}], "!=", "11"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{"Style", "[", 
               RowBox[{
               "\"\<This notebook requires Vers.3.0 Puiseux series data with \
baseSeriesMIVPTable\>\"", ",", "Red"}], "]"}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"Abort", "[", "]"}], ";"}], "\[IndentingNewLine]", ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{
               "newSingularIndex", ",", "newSing", ",", "baseCycleMetric", 
                ",", "basePoleList", ",", "newConjList", ",", 
                "baseRemovableList", ",", "baseSeries", ",", "baseSheetLinks",
                 ",", "baseSingSequence", ",", "baseBranchTypeArray", ",", 
                "baseSeriesMIVPTable"}], "}"}], "=", "dataList"}], ";"}]}], 
           "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"Print", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"baseSeries", "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", 
                  RowBox[{"1", ";;", "4"}]}], "]"}], "]"}], "//", "N"}], "//",
               "MatrixForm"}], "]"}], ";"}], "*)"}], "\[IndentingNewLine]", 
          RowBox[{"return", "=", 
           RowBox[{"{", 
            RowBox[{
            "newSingularIndex", ",", "newSing", ",", "baseCycleMetric", ",", 
             "basePoleList", ",", "newConjList", ",", "baseRemovableList", 
             ",", "baseSeries", ",", "baseSheetLinks", ",", 
             "baseSingSequence", ",", "baseBranchTypeArray", ",", 
             "baseSeriesMIVPTable"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
         ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{"\"\<Singular file \>\"", "<>", 
              RowBox[{"seriesFileName", "[", 
               RowBox[{"testCase", ",", "baseSingularIndex"}], "]"}], "<>", 
              "\"\< not found\>\""}], ",", "Red"}], "]"}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"return", "=", 
           RowBox[{"Table", "[", 
            RowBox[{"False", ",", 
             RowBox[{"{", "11", "}"}]}], "]"}]}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       "return"}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.942910420234145*^9, 3.9429107235851517`*^9}, {
   3.9429107766749396`*^9, 3.94291078289295*^9}, 3.9429108640580173`*^9, {
   3.9429109051799803`*^9, 3.94291098650089*^9}, 3.9429360478033996`*^9, {
   3.9429363255494375`*^9, 3.942936348231633*^9}, {3.9430239466088357`*^9, 
   3.9430240387744837`*^9}, {3.944594014190671*^9, 3.9445940345610485`*^9}, {
