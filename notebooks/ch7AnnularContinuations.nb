                  RowBox[{"-", "1"}], ",", "6", ",", "j"}], "]"}], "]"}], 
               "]"}], ",", "12", ",", "Black", ",", "Bold"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"locations", "[", 
               RowBox[{"[", "j", "]"}], "]"}], ",", "yOffSet"}], "}"}], ",", 
            "Center"}], "]"}]}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<netMax: \>\"", ",", "netMax"}], "]"}]}], 
    "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]"}]}]], "Input",
