          "included", " ", "in", " ", "the", " ", "branch", " ", "cycle", " ",
           "list", " ", "for", " ", "this", " ", "ring"}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
