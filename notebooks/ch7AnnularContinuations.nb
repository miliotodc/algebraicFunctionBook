            RowBox[{"k2", "=", "1"}], ",", 
            RowBox[{"k2", "<=", 
             RowBox[{"Length", "@", "thePoleLinks"}]}], ",", 
            RowBox[{"k2", "++"}], ",", "\[IndentingNewLine]", 
            "\[IndentingNewLine]", 
