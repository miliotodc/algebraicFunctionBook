   3.9420495942667103`*^9}, {3.9420496458635263`*^9, 3.942049652471054*^9}, {
   3.942049801154135*^9, 3.94204980580906*^9}, {3.942049909189849*^9, 
   3.9420499593032446`*^9}, 3.942050355737525*^9, {3.942050410146138*^9, 
   3.942050567247981*^9}, {3.9420506312169647`*^9, 3.942050668317066*^9}, {
   3.942050890873011*^9, 3.9420509651674705`*^9}, {3.942051078999349*^9, 
