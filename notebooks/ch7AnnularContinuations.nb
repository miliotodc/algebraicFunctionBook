Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
   "do", " ", "the", " ", "pole", " ", "link", " ", "graphics", " ", "here"}],
    "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"poleLinkGraphicData", "//", "MatrixForm"}], "\[IndentingNewLine]", 
   RowBox[{"xLocationSave", "//", "MatrixForm"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"poleLinkGraphics", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"For", "[", 
    RowBox[{
     RowBox[{"i", "=", "1"}], ",", 
     RowBox[{"i", "<=", 
      RowBox[{"Length", "@", "poleLinkGraphicData"}]}], ",", 
     RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"currentAnnulus", "=", 
       RowBox[{"poleLinkGraphicData", "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"singIndex", "=", 
       RowBox[{"poleLinkGraphicData", "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", "2"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"currentBranchIndex", "=", 
       RowBox[{"poleLinkGraphicData", "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", "4"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<  currentBranchIndex: \>\"", ",", "currentBranchIndex"}], 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<    currentAnnulus: \>\"", ",", "currentAnnulus"}], "]"}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<    current sing index: \>\"", ",", "singIndex"}], "]"}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"xLocationPos", "=", 
       RowBox[{
        RowBox[{"Position", "[", 
         RowBox[{
          RowBox[{"xLocationSave", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", 
          RowBox[{"x_", "/;", 
           RowBox[{"x", "==", "currentAnnulus"}]}]}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<  xLocationPos: \>\"", ",", "xLocationPos"}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<  xLocationData: \>\"", ",", 
        RowBox[{"xLocationSave", "[", 
         RowBox[{"[", "xLocationPos", "]"}], "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"xLoc", "=", 
       RowBox[{"xLocationSave", "[", 
        RowBox[{"[", 
         RowBox[{"xLocationPos", ",", "3", ",", "currentBranchIndex"}], "]"}],
         "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<  xLocation for this link: \>\"", ",", "xLoc"}], "]"}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"yLoc", "=", 
       RowBox[{"poleLinkGraphicData", "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", "3"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<  yLocation for this link: \>\"", ",", "yLoc"}], "]"}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<  pole link string: \>\"", ",", 
        RowBox[{"poleLinkGraphicData", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "5"}], "]"}], "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"poleLinkGraphics", ",", 
        RowBox[{"Inset", "[", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"poleLinkGraphicData", "[", 
