                    RowBox[{"k2", ",", "2"}], "]"}], "]"}]}]}]}], "]"}], "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"Print", "[", 
              RowBox[{
              "\"\<       annulusBranchIndex: \>\"", ",", 
               "annulusBranchIndex"}], "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"singPole", "=", 
