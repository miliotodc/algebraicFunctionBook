Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
   "update", " ", "annulus", " ", "table", " ", "with", " ", 
    "continuations"}], "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"theContinuedAnnuliList", "=", 
    RowBox[{
     RowBox[{"continuationList", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "1"}], "]"}], "]"}], "//", "DeleteDuplicates"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{"For", "[", 
    RowBox[{
     RowBox[{"i", "=", "1"}], ",", 
     RowBox[{"i", "<=", 
      RowBox[{"Length", "@", "theContinuedAnnuliList"}]}], ",", 
     RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"cRecords", "=", 
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{"continuationList", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "==", 
            RowBox[{"theContinuedAnnuliList", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], "&"}]}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", 
          RowBox[{"2", ";;", "3"}]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<cRecords: \>\"", ",", "cRecords"}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"aIndex", ",", "sIndex"}], "}"}], "=", 
       RowBox[{"getSingTableIndexes", "[", 
        RowBox[{"annulusTable", ",", 
         RowBox[{"theContinuedAnnuliList", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"annulusTable", "[", 
        RowBox[{"[", 
         RowBox[{"aIndex", ",", "8"}], "]"}], "]"}], "=", "cRecords"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"annulusTableR", "[", 
        RowBox[{"[", 
         RowBox[{"aIndex", ",", "8"}], "]"}], "]"}], "=", 
       RowBox[{"Style", "[", 
        RowBox[{"cRecords", ",", "Black", ",", "Bold"}], "]"}]}], ";"}]}], 
    "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"annulusTableReport", "=", 
     RowBox[{"Prepend", "[", 
      RowBox[{"annulusTableR", ",", 
       RowBox[{"{", 
        RowBox[{
        "\"\<\!\(\*SubscriptBox[\(a\), \(n\)]\)\>\"", ",", 
         "\"\<\!\(\*SubscriptBox[\(s\), \(n\)]\)\>\"", ",", "\"\<Annuli\>\"", 
         ",", "\"\<Perim\>\"", ",", "\"\<Arg\>\"", ",", "\"\<Monodromy\>\"", 
         ",", "\"\<support\>\"", ",", "\"\<Cont\>\"", ",", "\"\< \>\"", ",", 
         "\"\< \>\""}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"aTable", "=", 
    RowBox[{"Grid", "[", 
     RowBox[{"annulusTableReport", ",", 
      RowBox[{"Dividers", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"{", "True", "}"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"True", ",", "True", ",", 
           RowBox[{"{", "False", "}"}], ",", "True"}], "}"}]}], "}"}]}]}], 
     "]"}]}]}]}]], "Input",
