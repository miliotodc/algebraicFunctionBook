Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"(*", "\[IndentingNewLine]", 
   RowBox[{"Leg", " ", "4", " ", "calculation"}], "\[IndentingNewLine]", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"processYellowLeg", "[", 
     RowBox[{
     "annulusTable_", ",", "precisionArray_", ",", "theCurrentSingularPoint_",
       ",", "currentArgument_", ",", "wStartAtLeg3_", ",", 
      "currentSingularPerimeter_", ",", "nextAnnulusRadius_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "theZ", ",", "rStart", ",", "rEnd", ",", "wDeriv", ",", "numTries", 
        ",", "posFoundFlag", ",", "theBaseValues", ",", "matchResult", ",", 
        "wStartAtLeg5", ",", "leg4F"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"theZ", "[", "r_", "]"}], ":=", 
        RowBox[{"r", " ", 
         RowBox[{"Exp", "[", 
          RowBox[{"\[ImaginaryI]", " ", "currentArgument"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"rStart", "=", 
        RowBox[{
         RowBox[{"Abs", "[", "theCurrentSingularPoint", "]"}], "+", 
         "currentSingularPerimeter"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"rEnd", "=", 
        RowBox[{"SetPrecision", "[", 
         RowBox[{"nextAnnulusRadius", ",", "$workingPrecision"}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"rStart", ">", "rEnd"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"Style", "[", 
            RowBox[{
            "\"\<Found singular perimeter extending into medial contours for \
leg 4\>\"", ",", "12", ",", "Red"}], "]"}], "]"}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"wDeriv", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"w", "'"}], "[", "r", "]"}], "\[Equal]", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", 
              RowBox[{"(", 
               FractionBox[
                RowBox[{"D", "[", 
                 RowBox[{"$theFunction", ",", "z"}], "]"}], 
                RowBox[{"D", "[", 
                 RowBox[{"$theFunction", ",", "w"}], "]"}]], ")"}]}], " ", 
             RowBox[{"(", " ", 
              RowBox[{"D", "[", 
               RowBox[{
                RowBox[{"theZ", "[", "r", "]"}], ",", "r"}], "]"}], ")"}]}], 
            ")"}], "/.", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"w", "\[Rule]", 
              RowBox[{"w", "[", "r", "]"}]}], ",", 
             RowBox[{"z", "\[Rule]", 
              RowBox[{"theZ", "[", "r", "]"}]}]}], "}"}]}], ")"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"posFoundFlag", "=", "False"}], ";", "\[IndentingNewLine]", 
       RowBox[{"numTries", "=", "0"}], ";", "\[IndentingNewLine]", 
       RowBox[{"While", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"posFoundFlag", "\[Equal]", "False"}], " ", "&&", " ", 
          RowBox[{"numTries", "\[LessEqual]", "12"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"numTries", "++"}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
           "$continuationStiffnessSwitching", ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"leg4F", "=", 
              RowBox[{"NDSolveValue", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"wDeriv", ",", 
                  RowBox[{
                   RowBox[{"w", "[", "rStart", "]"}], "\[Equal]", 
                   "wStartAtLeg4"}]}], "}"}], ",", "w", ",", 
                RowBox[{"{", 
                 RowBox[{"r", ",", "rStart", ",", "rEnd"}], "}"}], ",", 
                RowBox[{"MaxSteps", "\[Rule]", "50000000"}], ",", 
                RowBox[{"MaxStepSize", "\[Rule]", 
                 RowBox[{"precisionArray", "[", 
                  RowBox[{"[", 
                   RowBox[{"numTries", ",", "1"}], "]"}], "]"}]}], ",", 
                RowBox[{"WorkingPrecision", "\[Rule]", 
                 RowBox[{"precisionArray", "[", 
                  RowBox[{"[", 
                   RowBox[{"numTries", ",", "2"}], "]"}], "]"}]}], ",", 
                RowBox[{"Method", "->", "\"\<StiffnessSwitching\>\""}]}], 
               "]"}]}], ";"}], "\[IndentingNewLine]", ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"leg4F", "=", 
              RowBox[{"NDSolveValue", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"wDeriv", ",", 
                  RowBox[{
                   RowBox[{"w", "[", "rStart", "]"}], "\[Equal]", 
                   "wStartAtLeg4"}]}], "}"}], ",", "w", ",", 
                RowBox[{"{", 
                 RowBox[{"r", ",", "rStart", ",", "rEnd"}], "}"}], ",", 
                RowBox[{"MaxSteps", "\[Rule]", "50000000"}], ",", 
                RowBox[{"MaxStepSize", "\[Rule]", 
                 RowBox[{"precisionArray", "[", 
                  RowBox[{"[", 
                   RowBox[{"numTries", ",", "1"}], "]"}], "]"}]}], ",", 
                RowBox[{"WorkingPrecision", "\[Rule]", 
                 RowBox[{"precisionArray", "[", 
                  RowBox[{"[", 
                   RowBox[{"numTries", ",", "2"}], "]"}], "]"}]}]}], "]"}]}], 
             ";"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
           "numTries", ",", "posFoundFlag", ",", "theBaseValues", ",", 
            "matchResult", ",", "wStartAtLeg5"}], " ", "*)"}], 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"theBaseValues", "=", 
           RowBox[{"w", "/.", 
            RowBox[{"NSolve", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"$theFunction", "\[Equal]", "0"}], "/.", 
               RowBox[{"z", "\[Rule]", 
                RowBox[{"theZ", "[", "rEnd", "]"}]}]}], ",", 
              RowBox[{"WorkingPrecision", "->", "40"}]}], "]"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"theBaseValues", "=", 
           RowBox[{"Sort", "[", "theBaseValues", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"matchResult", "=", 
           RowBox[{"getMatchingValue", "[", 
            RowBox[{
             RowBox[{"leg4F", "[", "rEnd", "]"}], ",", "theBaseValues", ",", 
             "False"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{"$getMatchValueDiagFlag", ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{"\"\<getMatchResult value: \>\"", ",", 
               RowBox[{"matchResult", "//", "N"}]}], "]"}], ";"}]}], 
           "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"matchResult", "===", "False"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{"Style", "[", 
               RowBox[{
               "\"\<Leg 4:  match is greater than min threshold value!\>\"", 
                ",", "Red", ",", "12", ",", "Bold"}], "]"}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"Print", "[", 
              RowBox[{"Style", "[", 
               RowBox[{
               "\"\<     Increasing precision\>\"", ",", "12", ",", "Bold", 
                ",", "Red"}], "]"}], "]"}], ";"}], "\[IndentingNewLine]", ",",
             "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"wStartAtLeg5", "=", 
              RowBox[{"theBaseValues", "[", 
               RowBox[{"[", "matchResult", "]"}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"posFoundFlag", "=", "True"}], ";"}]}], 
           "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"posFoundFlag", "\[Equal]", "False"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"Style", "[", 
            RowBox[{
            "\"\<Position not found at end of 10 attempts at increasing \
precision.\>\"", ",", "14", ",", "Red"}], "]"}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Abort", "[", "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], 
       ";", "\[IndentingNewLine]", "wStartAtLeg5"}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}]}]], "Input",
