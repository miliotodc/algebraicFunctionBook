Cell[CellGroupData[{

Cell["Section 8.1.6:  Set up annular monodromies", "Subsubsection",
 CellChangeTimes->{{3.9868897173072047`*^9, 3.986889735875163*^9}, {
  3.9869750890652213`*^9, 3.9869750893672347`*^9}, {3.9881992284397697`*^9, 
  3.9881992290596504`*^9}},ExpressionUUID->"6a0fd7c3-77e5-4283-8883-\
c92a81857722"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{"do", " ", "annular", " ", "monodromies"}], "\[IndentingNewLine]", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"xLocationSave", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"annuliMonodromyGraphics", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"yOffSet", "=", "20"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"maxWidth", "=", "10"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"netMax", "=", "0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"k", "=", "1"}], ",", 
      RowBox[{"k", "<=", 
       RowBox[{"(", 
        RowBox[{"Length", "@", "theAnnuli"}], ")"}]}], ",", 
      RowBox[{"k", "++"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"aIndex", ",", "sIndex"}], "}"}], "=", 
        RowBox[{"getSingTableIndexes", "[", 
         RowBox[{"annulusTable", ",", "k"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Monodromy: \>\"", ",", 
         RowBox[{"annulusTable", "[", 
          RowBox[{"[", 
           RowBox[{"aIndex", ",", "6"}], "]"}], "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"numBranches", "=", 
        RowBox[{"Length", "@", 
         RowBox[{"annulusTable", "[", 
          RowBox[{"[", 
           RowBox[{"aIndex", ",", "6"}], "]"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"locations", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"Array", "[", 
           RowBox[{
            RowBox[{"#", "&"}], ",", 
            RowBox[{"numBranches", "+", "2"}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "maxWidth"}], "}"}]}], "]"}], ")"}], "[", 
         RowBox[{"[", 
          RowBox[{"2", ";;", 
           RowBox[{"-", "2"}]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"xLocationSave", ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "yOffSet", ",", "locations"}], "}"}]}], "]"}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<x-locations: \>\"", ",", "locations"}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"maxX", "=", 
        RowBox[{"locations", "[", 
         RowBox[{"[", 
          RowBox[{"-", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"maxX", ">", "netMax"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"netMax", "=", "maxX"}], ";"}]}], "\[IndentingNewLine]", 
