                    RowBox[{
                    RowBox[{"leg5F", "[", "tEnd", "]"}], ",", "10"}], "]"}]}],
                   "]"}], ";", "\[IndentingNewLine]", 
                 RowBox[{"Print", "[", 
                  RowBox[{"\"\<Base values at leg end: \>\"", ",", 
                   RowBox[{"N", "[", 
                    RowBox[{"theBaseValues", ",", "10"}], "]"}]}], "]"}], 
                 ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"posFoundFlag", "=", "True"}], ";"}]}], 
            "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
