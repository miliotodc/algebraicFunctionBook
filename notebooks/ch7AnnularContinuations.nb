       RowBox[{"o___", "?", "OptionQ"}]}], "]"}], "/;", 
     RowBox[{"!", 
      RowBox[{"TrueQ", "@", "$TeX"}]}]}], ":=", 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"$TeX", "=", "True"}], "}"}], ",", 
      RowBox[{"Convert`TeX`ExpressionToTeX", "[", 
