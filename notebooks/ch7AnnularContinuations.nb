            "$continuationStiffnessSwitching", ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"leg5F", "=", 
               RowBox[{"NDSolveValue", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"wDeriv", ",", 
