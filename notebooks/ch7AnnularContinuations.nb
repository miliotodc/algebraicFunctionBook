Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"randomPolynomial", "[", 
     RowBox[{"z_", ",", "n_", ",", 
      RowBox[{"coeffRange_", ":", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "10"}], ",", "10"}], "}"}]}]}], "]"}], ":=", 
