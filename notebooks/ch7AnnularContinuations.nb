            RowBox[{"{", 
             RowBox[{
              RowBox[{"\"\<{\>\"", "->", "\"\<\\{\>\""}], ",", 
              RowBox[{"\"\<}\>\"", "->", "\"\<\\},\>\""}]}], "}"}]}], 
           "]"}]}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
     "\[IndentingNewLine]", "theString"}]}], "\[IndentingNewLine]", 
