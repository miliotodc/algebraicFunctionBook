              RowBox[{"i", ",", "5"}], "]"}], "]"}], ",", "10", ",", "Black", 
            ",", "Bold"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"xLoc", ",", "yLoc"}], "}"}]}], "]"}]}], "]"}], ";"}]}], 
