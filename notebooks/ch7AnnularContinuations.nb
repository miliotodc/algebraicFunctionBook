            RowBox[{
             RowBox[{
              RowBox[{"MakeBoxes", "[", "#", "]"}], "&"}], "@", 
             RowBox[{"Abs", "@", "#"}]}]}], "}"}], "&"}], ",", 
         RowBox[{"2", ";;"}]}], "]"}], "@", "assoc"}]}]}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"\[PlusMinus]", "1"}], " ", "are", " ", "specials", " ", 
