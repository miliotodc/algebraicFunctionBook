                 RowBox[{"D", "[", 
                  RowBox[{"$theFunction", ",", "z"}], "]"}], 
                 RowBox[{"D", "[", 
                  RowBox[{"$theFunction", ",", "w"}], "]"}]], ")"}]}], " ", 
              RowBox[{"(", 
               RowBox[{"D", "[", 
                RowBox[{
                 RowBox[{"theZ", "[", "t", "]"}], ",", "t"}], " ", "]"}], 
               ")"}]}], ")"}], "/.", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"w", "\[Rule]", 
               RowBox[{"w", "[", "t", "]"}]}], ",", 
              RowBox[{"z", "\[Rule]", 
               RowBox[{"theZ", "[", "t", "]"}]}]}], "}"}]}], ")"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"posFoundFlag", "=", "False"}], ";", "\[IndentingNewLine]", 
