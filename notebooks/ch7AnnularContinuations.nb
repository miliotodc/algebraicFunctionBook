   "\[IndentingNewLine]", " ", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"MemberQ", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"FileExistsQ", "@", "#"}], "&"}], "/@", " ", "fileNames"}], 
        ",", "False"}], "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"Style", "[", 
         RowBox[{
         "\"\<Singular point expansion files needed for this analysis.  Some \
or all are missing.  See Chapter 3 notebook.\>\"", ",", "Red"}], "]"}], "]"}],
        ";"}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Print", "[", "\"\<All singular files found.\>\"", "]"}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"index", "=", "0"}], ";", "\[IndentingNewLine]", 
       RowBox[{"branchStatsSummary", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"annularIndexStart", "=", "1"}], ";", "\[IndentingNewLine]", 
       RowBox[{"annularIndexEnd", "=", 
        RowBox[{"Length", "@", "supportedAnnuli"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"annularIndexEnd", "=", "10"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"index", "++"}], ";", "\[IndentingNewLine]", 
          RowBox[{"branchStats", "=", 
           RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"currentAnnuli", "=", 
           RowBox[{"supportedAnnuli", "[", 
            RowBox[{"[", "annularIndex", "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"currentBranch", "=", 
           RowBox[{"supportedMonodromies", "[", 
            RowBox[{"[", 
             RowBox[{"annularIndex", ",", "branchIndex"}], "]"}], "]"}]}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"currentSingularNum", "=", 
           RowBox[{"supportedSingularIndexes", "[", 
            RowBox[{"[", 
             RowBox[{"annularIndex", ",", "singularIndex"}], "]"}], "]"}]}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"currentBranchSheet", "=", 
           RowBox[{"supportedMonodromies", "[", 
            RowBox[{"[", 
             RowBox[{"annularIndex", ",", "branchIndex", ",", "sheetIndex"}], 
             "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"currentSingularPoint", "=", 
           RowBox[{"$theSingularList", "[", 
            RowBox[{"[", "currentSingularNum", "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"currentSingularPerimeter", "=", 
           RowBox[{"supportedSingularPerimeters", "[", 
            RowBox[{"[", 
             RowBox[{"annularIndex", ",", "singularIndex"}], "]"}], "]"}]}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"currentRadius", "=", 
           RowBox[{"supportedAnnularRadii", "[", 
            RowBox[{"[", "annularIndex", "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"Print", "[", 
             RowBox[{"\"\<current annulus radius: \>\"", ",", 
              RowBox[{"currentRadius", "//", "N"}]}], "]"}], ";"}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"nextAnnulusIndexSet", "=", 
           RowBox[{"getSingTableIndexes", "[", 
            RowBox[{"annulusTable", ",", 
             RowBox[{"currentAnnuli", "+", "1"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"nextAnnulusRadius", "=", 
           RowBox[{"annulusTable", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"nextAnnulusIndexSet", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", "4"}], "]"}], "]"}]}], 
          ";", "\[IndentingNewLine]", 
