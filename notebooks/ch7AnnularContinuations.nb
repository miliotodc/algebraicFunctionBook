   RowBox[{
    RowBox[{"Prepend", "[", 
     RowBox[{"poleRecords", ",", 
      RowBox[{"{", 
       RowBox[{
       "\"\<\!\(\*SubscriptBox[\(a\), \(n\)]\)\>\"", ",", "\"\<Branch\>\"", 
        ",", "\"\<Sheet\>\"", ",", 
