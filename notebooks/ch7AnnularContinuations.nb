Cell["Section 9.2.3:  Create final continuation list", "Subsubsection",
 CellChangeTimes->{{3.9582883089236655`*^9, 3.9582883148706985`*^9}, {
  3.982318607025091*^9, 3.9823186095981655`*^9}, {3.9869783630254965`*^9, 
