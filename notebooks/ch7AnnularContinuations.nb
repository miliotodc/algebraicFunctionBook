           RowBox[{"{", 
            RowBox[{"1", ",", "4", ",", "3"}], "}"}], " ", "then", " ", "we", 
           " ", "have", " ", "just", " ", "concluded", " ", "that", " ", 
           "the", " ", "cycle", " ", "sheet", "\[IndentingNewLine]", "      ", 
           RowBox[{"theContinuationList3", "[", 
            RowBox[{"[", 
             RowBox[{"theCurrentRingIndex", ",", "6", ",", "cycle"}], "]"}], 
            "]"}], " ", "is", " ", "continued", " ", "onto", " ", "the", " ", 
           "sheet", " ", 
           RowBox[{"\"\<thePositon\>\"", ".", " ", "Now"}], " ", "need", " ", 
           "to", " ", "confirm", " ", "that", " ", "this", " ", "postion", 
           " ", "is", " ", "part", " ", "of", " ", "a", " ", "cycle", " ", 
           "of", " ", "the", " ", "same", " ", "length", " ", "as", " ", 
           RowBox[{"theContinuationList3", "[", 
            RowBox[{"[", 
