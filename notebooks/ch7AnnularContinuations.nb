Cell["getSingTableIndexes", "Subsection",
 CellChangeTimes->{{3.9147456537242537`*^9, 
  3.914745664221779*^9}},ExpressionUUID->"93c8cc03-a9c3-4aeb-8cb9-\
52e3a6074eef"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"getSingTableIndexes", "[", 
    RowBox[{"singTable_", ",", "annulus_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "singMembers", ",", "singIndexes", ",", "annulusIndex", ",", "return"}],
       "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"annulus", ">", 
          RowBox[{"Length", "@", "theAnnuli"}]}], " ", "||", " ", 
         RowBox[{"annulus", "<", "0"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"Style", "[", 
           RowBox[{"\"\<Annulus number out of range!\>\"", ",", "Red"}], 
           "]"}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"return", "=", 
          RowBox[{"-", "1"}]}], ";"}], "\[IndentingNewLine]", ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"annulusIndex", "=", 
          RowBox[{"annulusTableAnnIndexes", "[", 
           RowBox[{"[", "annulus", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"annulus", "==", 
            RowBox[{"Length", "@", "theAnnuli"}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"singIndexes", "=", 
             RowBox[{"{", 
              RowBox[{"-", "1"}], "}"}]}], ";"}], "\[IndentingNewLine]", ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"singMembers", "=", 
             RowBox[{"ringMemberSingularIndexes", "[", 
              RowBox[{"[", "annulus", "]"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"singIndexes", "=", 
             RowBox[{"annulusTableSingIndexes", "[", 
              RowBox[{"[", "singMembers", "]"}], "]"}]}], ";"}]}], 
          "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"return", "=", 
          RowBox[{"{", 
           RowBox[{"annulusIndex", ",", "singIndexes"}], "}"}]}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", "return"}]}],
     "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.935482250518488*^9, 3.935482280449313*^9}, 
   3.9435374717901196`*^9},
