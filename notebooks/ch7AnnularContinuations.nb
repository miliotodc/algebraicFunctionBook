              RowBox[{"theCurrentRing", "-", "1"}]}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"Print", "[", 
             RowBox[{"\"\<postBranch: \>\"", ",", "postBranch"}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", "\[IndentingNewLine]", " ", 
             RowBox[{
             "need", " ", "to", " ", "process", " ", "meromorphic", " ", 
              "continuation", " ", "here"}], "\[IndentingNewLine]", "*)"}], 
            "\[IndentingNewLine]", 
            RowBox[{"Print", "[", 
