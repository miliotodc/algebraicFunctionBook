Cell[CellGroupData[{

Cell["polishBranchTerms", "Subsection",
 CellChangeTimes->{{3.9291148919187965`*^9, 
  3.9291148946995955`*^9}},ExpressionUUID->"33b7b3d7-5ac8-43db-abaa-\
b4328235f3d7"],

Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{
   RowBox[{
    RowBox[{"polishBranchTerms", "[", 
     RowBox[{"zVal_", ",", "terms_", ",", "maxErrorTolerance_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "wVals", ",", "polishedValues", ",", "difTable", ",", "pos", ",", 
        "wValsPrec", ",", "termsPrec"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"seriesValues", " ", 
        RowBox[{"format", ":", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"baseSeriesIndexK", ",", " ", "seriesValK"}], "}"}], 
            "..."}], 
           RowBox[{"{", 
            RowBox[{"baseSeriesIndexM", ",", "seriesValM"}], "}"}]}], 
          "}"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"termsPrec", "=", 
        RowBox[{"Floor", "@", 
         RowBox[{"Precision", "@", 
          RowBox[{"terms", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "2"}], "]"}], "]"}]}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"wVals", "=", 
        RowBox[{"w", "/.", 
         RowBox[{"NSolve", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"$theFunction", "==", "0"}], "/.", 
            RowBox[{"z", "->", "zVal"}]}], ",", "w", ",", 
           RowBox[{"WorkingPrecision", "->", "termsPrec"}]}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"polishedValues", "=", 
        RowBox[{"Table", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"difTable", "=", 
            RowBox[{
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{
                RowBox[{"terms", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", "3"}], "]"}], "]"}], "-", "#"}], "]"}], 
              "&"}], "/@", " ", "wVals"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"pos", "=", 
            RowBox[{
             RowBox[{"Position", "[", 
              RowBox[{"difTable", ",", 
               RowBox[{"Min", "@", "difTable"}]}], "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{"difTable", "[", 
                RowBox[{"[", "pos", "]"}], "]"}], "]"}], ">", 
              RowBox[{"10", "^", 
               RowBox[{"(", 
                RowBox[{"-", "maxErrorTolerance"}], ")"}]}]}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Print", "[", 
               RowBox[{"Style", "[", 
                RowBox[{
                "\"\<polishTerms error below $maxErrorTolerance: \>\"", ",", 
                 "Red", ",", "Bold", ",", "14"}], "]"}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"Print", "[", 
               RowBox[{"\"\<     difTable: \>\"", ",", 
                RowBox[{"difTable", "//", "N"}]}], "]"}], ";"}]}], 
            "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"terms", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", 
             RowBox[{"terms", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "2"}], "]"}], "]"}], ",", 
             RowBox[{"wVals", "[", 
              RowBox[{"[", "pos", "]"}], "]"}]}], "}"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{"Length", "@", "terms"}]}], "}"}]}], 
         "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"return", ":", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"seriesIndexK", ",", "polishedValK"}], "}"}], "..."}], 
           RowBox[{"{", 
            RowBox[{"seriesIndexM", ",", "polishedValM"}], "}"}]}], "}"}]}], 
        " ", "*)"}], "\[IndentingNewLine]", "polishedValues"}]}], 
     "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.929114884030032*^9, 3.929114884436383*^9}, {
   3.929115110430355*^9, 3.929115110821054*^9}, 3.958048324538966*^9},
 CellLabel->"In[62]:=",ExpressionUUID->"d3bc2dd5-da25-49ad-be81-fe014c45f535"]
}, Closed]],

Cell[CellGroupData[{

Cell["getAnnularMonodromy", "Subsection",
 CellChangeTimes->{{3.9292776480259233`*^9, 
  3.9292776510097303`*^9}},ExpressionUUID->"8aff0435-59af-498b-9915-\
aa8e78a5de0e"],

Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
   "get", " ", "differential", " ", "monodromy", " ", "around", " ", "a", " ",
     "selected", " ", "annulus"}], "\[IndentingNewLine]", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Options", "[", "getAnnularMonodromy", "]"}], "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<nSolveWP\>\"", "->", "50"}], ",", 
       RowBox[{"\"\<integrateWP\>\"", "->", "50"}], ",", 
       RowBox[{"\"\<polishWP\>\"", "->", "20"}], ",", 
       RowBox[{"\"\<stiffFlag\>\"", "->", "False"}], ",", 
       RowBox[{"\"\<diagFlag\>\"", "->", "False"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"getAnnularMonodromy", "[", 
      RowBox[{"annulusIndex_", ",", "annularNorms_", ",", 
       RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "rNorm", ",", "z0", ",", "annularMedialVals", ",", "wArray", ",", 
         "branchVals", ",", "polishedVals", ",", "pArray", ",", "theCycles", 
         ",", "theLinks", ",", "oneCycles", ",", "finalCycles", ",", 
         "monodromyTable"}], "}"}], ",", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"rNorm", "=", 
         RowBox[{"annularNorms", "[", 
          RowBox[{"[", "annulusIndex", "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"z0", "=", 
         RowBox[{"rNorm", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"I", " ", "$thetaV"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"OptionValue", "[", "\"\<diagFlag\>\"", "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"\"\<z0: \>\"", ",", 
             RowBox[{"z0", "//", "N"}]}], "]"}], ";"}]}], 
         "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"annularMedialVals", "=", 
         RowBox[{"Sort", "[", 
          RowBox[{"w", "/.", 
           RowBox[{"NSolve", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"$theFunction", "==", "0"}], "/.", 
              RowBox[{"z", "->", "z0"}]}], ",", "w", ",", 
             RowBox[{"WorkingPrecision", "->", 
              RowBox[{"OptionValue", "[", "\"\<nSolveWP\>\"", "]"}]}]}], 
            "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"\"\<annularMedialVals: \>\"", ",", 
            RowBox[{"annularMedialVals", "//", "N"}]}], "]"}], ";"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"wArray", "=", 
         RowBox[{"MapThread", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"#1", ",", "#2"}], "}"}], "&"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Range", "[", 
              RowBox[{"Length", "@", "annularMedialVals"}], "]"}], ",", 
             "annularMedialVals"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"OptionValue", "[", "\"\<diagFlag\>\"", "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"Grid", "[", 
             RowBox[{"SetPrecision", "[", 
              RowBox[{"wArray", ",", "4"}], "]"}], "]"}], "]"}], ";"}]}], 
         "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", " ", 
        RowBox[{"branchVals", "=", 
         RowBox[{"integrateOverAnnulus", "[", 
          RowBox[{"$thetaV", ",", "wArray", ",", "rNorm", ",", 
           RowBox[{"OptionValue", "[", "\"\<integrateWP\>\"", "]"}], ",", 
           RowBox[{"OptionValue", "[", "\"\<stiffFlag\>\"", "]"}]}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"polishedVals", "=", 
         RowBox[{"polishBranchTerms", "[", 
          RowBox[{"z0", ",", "branchVals", ",", "20"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"OptionValue", "[", "\"\<diagFlag\>\"", "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{
             RowBox[{"polishedVals", "//", "N"}], "//", "MatrixForm"}], "]"}],
            ";"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"pArray", "=", 
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Position", "[", 
             RowBox[{
              RowBox[{"polishedVals", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
              RowBox[{"x_", "/;", 
               RowBox[{
                RowBox[{"Abs", "[", 
                 RowBox[{"x", "-", "#"}], "]"}], "<", 
                RowBox[{"10", "^", 
                 RowBox[{"-", "20"}]}]}]}]}], "]"}], "&"}], "/@", " ", 
           RowBox[{"polishedVals", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "3"}], "]"}], "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"OptionValue", "[", "\"\<diagFlag\>\"", "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"\"\<pArray: \>\"", ",", 
             RowBox[{
              RowBox[{"pArray", "//", "N"}], "//", "MatrixForm"}]}], "]"}], 
           ";", "\[IndentingNewLine]", 
           RowBox[{"monodromyTable", "=", 
            RowBox[{"MapThread", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"#1", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], ",", 
                 RowBox[{"N", "[", 
                  RowBox[{
                   RowBox[{"#1", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], ",", "5"}], "]"}], ",", 
                 RowBox[{"N", "[", 
                  RowBox[{
                   RowBox[{"#1", "[", 
                    RowBox[{"[", "3", "]"}], "]"}], ",", "5"}], "]"}], ",", 
                 "#2"}], "}"}], "&"}], ",", 
              RowBox[{"{", 
               RowBox[{"polishedVals", ",", "pArray"}], "}"}]}], "]"}]}], ";",
            "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"Grid", "[", "monodromyTable", "]"}], "]"}], ";"}]}], 
         "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"theCycles", "=", 
         RowBox[{"PermutationCycles", "[", "pArray", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"OptionValue", "[", "\"\<diagFlag\>\"", "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"\"\<Permutation cycles: \>\"", ",", "theCycles"}], "]"}],
            ";"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"theLinks", "=", 
         RowBox[{"theCycles", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"oneCycles", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"{", "#", "}"}], "&"}], "/@", 
          RowBox[{"Complement", "[", 
           RowBox[{
            RowBox[{"Range", "[", "functionDegree", "]"}], ",", 
            RowBox[{"Flatten", "[", "theLinks", "]"}]}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"finalCycles", "=", 
         RowBox[{"Join", "[", 
          RowBox[{"theLinks", ",", "oneCycles"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<finalCycles: \>\"", ",", "finalCycles"}], "]"}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Sort", "[", 
            RowBox[{"Flatten", "@", "finalCycles"}], "]"}], "!=", 
           RowBox[{"Range", "[", 
            RowBox[{"Length", "@", 
             RowBox[{"Flatten", "@", "finalCycles"}]}], "]"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"Style", "[", 
             RowBox[{"\"\<monodromy is inconsistent!\>\"", ",", "Red"}], 
             "]"}], "]"}], ";"}], "\[IndentingNewLine]", ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Print", "[", "\"\<monodromy is consistent\>\"", "]"}], 
           ";"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
         "z0", ",", "rNorm", ",", "finalCycles", ",", "polishedVals"}], 
         "}"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.929277637981455*^9, 3.9292776384032297`*^9}, {
   3.9292814135495048`*^9, 3.929281416798893*^9}, {3.929281451071888*^9, 
   3.9292814553990407`*^9}, {3.929352102631076*^9, 3.929352105677422*^9}, {
   3.929352138638749*^9, 3.9293521658353024`*^9}, {3.9293632091245937`*^9, 
   3.9293632097338142`*^9}, {3.9293644180347548`*^9, 3.9293644680541134`*^9}, 
   3.929364522338019*^9, {3.9398255617155447`*^9, 3.9398255719623356`*^9}, {
   3.939825627054634*^9, 3.93982563422408*^9}, 3.9403189323716106`*^9, {
   3.941800025271597*^9, 3.9418000370499353`*^9}, {3.941800118668891*^9, 
   3.9418001562224846`*^9}, {3.941800277006811*^9, 3.941800307530935*^9}, {
   3.941800344897352*^9, 3.9418003505991955`*^9}, {3.9418212662020516`*^9, 
   3.941821268998273*^9}, {3.9418218045351753`*^9, 3.941821835090381*^9}, {
   3.9418223189014072`*^9, 3.9418223195107093`*^9}, 3.941822354538642*^9, {
   3.942051673610056*^9, 3.9420518407897635`*^9}, {3.942051920723549*^9, 
   3.94205192511312*^9}, {3.9420519928313675`*^9, 3.942051993487488*^9}, 
   3.9580483245547037`*^9, {3.958492348167465*^9, 3.958492357822774*^9}, {
   3.9584924078229785`*^9, 3.958492434593805*^9}},
