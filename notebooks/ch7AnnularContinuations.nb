Cell[CellGroupData[{

Cell["processBlueLeg", "Subsubsection",
 CellChangeTimes->{{3.943622143015085*^9, 
  3.9436221458270283`*^9}},ExpressionUUID->"3a2c3ce9-320d-4d02-adbd-\
227caf6e3b1c"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"(*", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Calculate", " ", "blue", " ", "Leg", " ", "2"}], ",", " ", 
    RowBox[{
     RowBox[{
     "will", " ", "need", " ", "to", " ", "check", " ", "if", " ", 
      "continuation", " ", "lands", " ", "on", " ", "a", " ", "$1$"}], "-", 
     RowBox[{
     "cycle", " ", "branch", " ", "at", " ", "singular", " ", "point"}]}]}], 
   "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"processBlueLeg", "[", 
     RowBox[{
     "annulusTable_", ",", "precisionArray_", ",", "currentSingularIndex_", 
      ",", "currentSingularPoint_", ",", "currentRadius_", ",", 
      "currentArgument_", ",", "wStartAtLeg2_", ",", 
      "currentSingularPerimeter_"}], "]"}], ":=", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"processBlueLeg2", "[", 
       RowBox[{
       "annulusTable_", ",", "precisionArray_", ",", 
        "annulusTableAnnulusIndex_", ",", "annulusTableSingularIndex_", ",", 
        "wStartAtLeg2_"}], "]"}], ":="}], "*)"}], 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "theZ", ",", "rStart", ",", "rEnd", ",", "wDeriv", ",", "posFoundFlag",
         ",", "numTries", ",", "leg2F", ",", "theSingularListIndex", ",", " ",
         "endingLeg2Value", ",", "theBaseValues", ",", "matchResult", ",", 
        "newSingularIndex", ",", "newSing", ",", "baseCycleMetric", ",", 
        "basePoleList", ",", "newConjList", ",", "baseRemovableList", ",", 
        "baseSeries", ",", "baseSheetLinks", ",", "baseSingSequence", ",", 
        "baseBranchTypeArray", ",", "baseSeriesMIVPTable", ",", "theArg", ",",
         "puiseuxBaseValues", ",", "puiseuxMatchIndex", ",", "puiseuxReport", 
        ",", "impingingBranchName", ",", "impingingRootIndex", ",", 
        "impingingSeriesIndex", ",", "impingingBranchMIVPData", ",", 
        "impingingBranchSize", ",", "impingingPoleStatus", ",", " ", 
        "thePoleSeriesList", ",", "sheetPoleFlag", ",", "pSeriesArray", ",", 
        "branchDataIndex", ",", "theBranchType", ",", "poleData", ",", 
        "wStartAtLeg3", ",", "return", ",", "seriesRootList", ",", 
        "seriesPos", ",", "poleRootNums", ",", "polePosition"}], "}"}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"theZ", "[", "r_", "]"}], ":=", 
        RowBox[{"r", " ", 
         RowBox[{"Exp", "[", 
          RowBox[{"\[ImaginaryI]", " ", "currentArgument"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"rStart", "=", "currentRadius"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"rEnd", "=", 
        RowBox[{
         RowBox[{"Abs", "[", "currentSingularPoint", "]"}], "-", 
         "currentSingularPerimeter"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"rStart", ">=", "rEnd"}], " ", "&&", " ", 
          "$continuationDiagFlagC"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"Style", "[", 
            RowBox[{
            "\"\<      Found singular perimeter extending into medial \
contours for leg 2\>\"", ",", "12", ",", "Red"}], "]"}], "]"}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"wDeriv", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"w", "'"}], "[", "r", "]"}], "\[Equal]", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", 
              RowBox[{"(", 
               FractionBox[
                RowBox[{"D", "[", 
                 RowBox[{"$theFunction", ",", "z"}], "]"}], 
                RowBox[{"D", "[", 
                 RowBox[{"$theFunction", ",", "w"}], "]"}]], ")"}]}], " ", 
             RowBox[{"(", " ", 
              RowBox[{"D", "[", 
               RowBox[{
                RowBox[{"theZ", "[", "r", "]"}], ",", "r"}], "]"}], ")"}]}], 
            ")"}], "/.", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"w", "\[Rule]", 
              RowBox[{"w", "[", "r", "]"}]}], ",", 
             RowBox[{"z", "\[Rule]", 
              RowBox[{"theZ", "[", "r", "]"}]}]}], "}"}]}], ")"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"posFoundFlag", "=", "False"}], ";", "\[IndentingNewLine]", 
       RowBox[{"numTries", "=", "0"}], ";", "\[IndentingNewLine]", 
       RowBox[{"While", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"posFoundFlag", "\[Equal]", "False"}], " ", "&&", " ", 
          RowBox[{"numTries", "\[LessEqual]", "12"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"numTries", "++"}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
           "$continuationStiffnessSwitching", ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"leg2F", "=", 
              RowBox[{"NDSolveValue", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"wDeriv", ",", 
                  RowBox[{
                   RowBox[{"w", "[", "rStart", "]"}], "\[Equal]", 
                   "wStartAtLeg2"}]}], "}"}], ",", "w", ",", 
                RowBox[{"{", 
                 RowBox[{"r", ",", "rStart", ",", "rEnd"}], "}"}], ",", 
                RowBox[{"MaxSteps", "\[Rule]", "50000000"}], ",", 
                RowBox[{"MaxStepSize", "\[Rule]", 
                 RowBox[{"precisionArray", "[", 
                  RowBox[{"[", 
                   RowBox[{"numTries", ",", "1"}], "]"}], "]"}]}], ",", 
                RowBox[{"WorkingPrecision", "\[Rule]", 
                 RowBox[{"precisionArray", "[", 
                  RowBox[{"[", 
                   RowBox[{"numTries", ",", "2"}], "]"}], "]"}]}], ",", 
                RowBox[{"Method", "->", "\"\<StiffnessSwitching\>\""}]}], 
               "]"}]}], ";"}], "\[IndentingNewLine]", ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"leg2F", "=", 
              RowBox[{"NDSolveValue", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"wDeriv", ",", 
                  RowBox[{
                   RowBox[{"w", "[", "rStart", "]"}], "\[Equal]", 
                   "wStartAtLeg2"}]}], "}"}], ",", "w", ",", 
                RowBox[{"{", 
                 RowBox[{"r", ",", "rStart", ",", "rEnd"}], "}"}], ",", 
                RowBox[{"MaxSteps", "\[Rule]", "50000000"}], ",", 
                RowBox[{"MaxStepSize", "\[Rule]", 
                 RowBox[{"precisionArray", "[", 
                  RowBox[{"[", 
                   RowBox[{"numTries", ",", "1"}], "]"}], "]"}]}], ",", 
                RowBox[{"WorkingPrecision", "\[Rule]", 
                 RowBox[{"precisionArray", "[", 
                  RowBox[{"[", 
                   RowBox[{"numTries", ",", "2"}], "]"}], "]"}]}]}], "]"}]}], 
             ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{
           "endingLeg2Value", ",", "theBaseValues", ",", "matchResult", ",", 
            "newSingularIndex", ",", "newSing", ",", "baseCycleMetric", ",", 
            "basePoleList", ",", "newConjList", ",", "baseRemovableList", ",",
             "baseSeries", ",", "baseSheetLinks", ",", "baseSingSequence", 
            ",", "baseBranchTypeArray", ",", "baseSeriesMIVPTable"}], " ", 
           "*)"}], "\[IndentingNewLine]", 
          RowBox[{"endingLeg2Value", "=", 
           RowBox[{"leg2F", "[", "rEnd", "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"theBaseValues", "=", 
           RowBox[{"Sort", "[", 
            RowBox[{
             RowBox[{"w", "/.", 
              RowBox[{"NSolve", "[", 
               RowBox[{
                RowBox[{"$theFunction", "\[Equal]", "0"}], "/.", 
                RowBox[{"z", "\[Rule]", 
                 RowBox[{"theZ", "[", "rEnd", "]"}]}]}], "]"}]}], ",", 
             RowBox[{"WorkingPrecision", "->", "40"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", "\[IndentingNewLine]", " ", 
           RowBox[{
            RowBox[{
            "Get", " ", "index", " ", "into", " ", "theBaseValues", " ", 
             "for", " ", "high"}], "-", 
            RowBox[{"precision", " ", "value", " ", "of", " ", 
             RowBox[{"leg2F", "[", "rEnd", "]"}]}]}], "\[IndentingNewLine]", 
           "*)"}], "\[IndentingNewLine]", 
          RowBox[{"matchResult", "=", 
           RowBox[{"getMatchingValue", "[", 
            RowBox[{"endingLeg2Value", ",", "theBaseValues", ",", "False"}], 
            "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{"$getMatchValueDiagFlag", ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{"\"\<getMatchResult value: \>\"", ",", 
               RowBox[{"matchResult", "//", "N"}]}], "]"}], ";"}]}], 
           "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"FileExistsQ", "[", 
             RowBox[{"seriesFileName", "[", 
              RowBox[{"$theTestCase", ",", "currentSingularIndex"}], "]"}], 
             "]"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{
               "newSingularIndex", ",", "newSing", ",", "baseCycleMetric", 
                ",", "basePoleList", ",", "newConjList", ",", 
                "baseRemovableList", ",", "baseSeries", ",", "baseSheetLinks",
                 ",", "baseSingSequence", ",", "baseBranchTypeArray", ",", 
                "baseSeriesMIVPTable"}], "}"}], "=", 
              RowBox[{"getSingularData", "[", 
               RowBox[{"$theTestCase", ",", "currentSingularIndex"}], "]"}]}],
              ";"}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{"Style", "[", 
               RowBox[{
                RowBox[{"\"\<Singular data file \>\"", "<>", 
                 RowBox[{"seriesFileName", "[", 
                  RowBox[{"$theTestCase", ",", "currentSingularIndex"}], 
                  "]"}], "<>", "\"\< not found\>\""}], ",", "Red"}], "]"}], 
              "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"Abort", "[", "]"}], ";"}]}], "\[IndentingNewLine]", 
           "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", "\[IndentingNewLine]", " ", 
           RowBox[{
            RowBox[{
            "now", " ", "check", " ", "Puiseux", " ", "series", " ", "at", 
             " ", 
             RowBox[{"blue", "[", "end", "]"}], " ", "puiseuxBaseValues"}], 
            ",", "puiseuxMatchIndex", ",", "puiseuxReport", ",", 
            "impingingBranchName", ",", "impingingRootIndex", ",", 
            "impingingSeriesIndex", ",", "impingingBranchMIVPData", ",", 
            "impingingBranchSize", ",", "impingingPoleStatus"}], 
           "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
          RowBox[{"puiseuxBaseValues", "=", 
           RowBox[{"baseSeries", "/.", 
            RowBox[{"z", "->", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"theZ", "[", "rEnd", "]"}], "-", 
               "currentSingularPoint"}], ")"}]}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"puiseuxMatchIndex", "=", 
           RowBox[{"getMatchingValue", "[", 
            RowBox[{
             RowBox[{"leg2F", "[", "rEnd", "]"}], ",", "puiseuxBaseValues", 
             ",", "False"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"puiseuxReport", "=", 
           RowBox[{"MapThread", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{"#1", ",", "#2"}], "}"}], "&"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Range", "[", 
                RowBox[{"Length", "@", "puiseuxBaseValues"}], "]"}], ",", 
               RowBox[{"puiseuxBaseValues", "//", "N"}]}], "}"}]}], "]"}]}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{"$puiseuxBaseValuesDiagFlag", ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{"\"\<                    end of blue leg: \>\"", ",", 
               RowBox[{
                RowBox[{"leg2F", "[", "rEnd", "]"}], "//", "N"}]}], "]"}], 
             ";", "\[IndentingNewLine]", 
             RowBox[{"Print", "[", 
              RowBox[{"\"\<                    puiseuxBaseValues: \>\"", ",", 
               RowBox[{"puiseuxReport", "//", "MatrixForm"}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"Print", "[", 
              RowBox[{
              "\"\<                    puiseuxMatchIndex: \>\"", ",", 
               "puiseuxMatchIndex"}], "]"}], ";"}]}], "\[IndentingNewLine]", 
           "]"}], ";", "\[IndentingNewLine]", " ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
            "impingingBranchName", ",", "impingingRootIndex", ",", 
             "impingingSeriesIndex", ",", "impingingBranchMIVPData", ",", 
             "impingingBranchSize", ",", "impingingPoleStatus"}], "}"}], "=", 
           " ", 
           RowBox[{"getMIVPImpingingData", "[", 
            RowBox[{
            "puiseuxMatchIndex", ",", "baseSeriesMIVPTable", ",", 
             "baseBranchTypeArray", ",", "basePoleList"}], "]"}]}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<               Branch impinging on \>\"", ",", 
            SubscriptBox["s", "currentSingularIndex"], ",", "\"\< \>\"", ",", 
            "impingingBranchName", ",", "\"\<: \>\"", ",", 
            "\"\<series index \>\"", ",", "impingingSeriesIndex", ",", 
            "\"\<,root index \>\"", ",", "impingingRootIndex"}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"thePoleSeriesList", "=", 
           RowBox[{
            RowBox[{"Position", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Exponent", "[", 
                   RowBox[{"#", ",", "z", ",", "List"}], "]"}], "&"}], "/@", 
                 " ", 
                 RowBox[{"baseSeries", "[", 
                  RowBox[{"[", 
                   RowBox[{"All", ",", 
                    RowBox[{"1", ";;", "5"}]}], "]"}], "]"}]}], ")"}], "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", 
              RowBox[{"x_", "/;", 
               RowBox[{"x", "<", "0"}]}]}], "]"}], "//", "Flatten"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"sheetPoleFlag", "=", "False"}], ";"}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"MemberQ", "[", 
             RowBox[{"thePoleSeriesList", ",", "impingingSeriesIndex"}], 
             "]"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{"Style", "[", 
               RowBox[{
               "\"\<               Impinging sheet is a pole!\>\"", ",", 
                "Red", ",", "14"}], "]"}], "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"sheetPoleFlag", "=", "True"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"seriesRootList", "=", 
              RowBox[{"Flatten", "[", 
               RowBox[{
                RowBox[{"baseSeriesMIVPTable", "[", 
                 RowBox[{"[", 
                  RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", "1"}], 
               "]"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"seriesRootList", "=", 
           RowBox[{"Flatten", "[", 
            RowBox[{
             RowBox[{"baseSeriesMIVPTable", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", "1"}], "]"}]}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"seriesPos", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"Position", "[", 
              RowBox[{"seriesRootList", ",", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"x_", ",", "y_"}], "}"}], "/;", 
                RowBox[{"x", "==", "#"}]}]}], "]"}], "&"}], "/@", " ", 
            "thePoleSeriesList"}]}], ";", 
          RowBox[{"poleRootNums", "=", 
           RowBox[{"seriesRootList", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"Flatten", "@", "seriesPos"}], ",", "2"}], "]"}], 
            "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{"$puiseuxBaseValuesDiagFlag", ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{
              "\"\<                    baseSeriesArray: \>\"", ",", 
               "baseBranchTypeArray"}], "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"Print", "[", 
              RowBox[{
              "\"\<                    baseSeriesMIVPTable: \>\"", ",", 
               "baseSeriesMIVPTable"}], "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"Print", "[", 
              RowBox[{
              "\"\<                    thePoleSeriesList: \>\"", ",", 
               "thePoleSeriesList"}], "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"Print", "[", 
              RowBox[{
              "\"\<                    thePoleRootNums:   \>\"", ",", 
               "poleRootNums"}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}],
           ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{"impingingPoleStatus", ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"Print", "[", 
                RowBox[{"Style", "[", 
                 RowBox[{
                 "\"\<              Contour impinging on a pole sheet\>\"", 
                  ",", "Red"}], "]"}], "]"}], ";"}]}], "\[IndentingNewLine]", 
             "]"}], ";"}], "*)"}], "\[IndentingNewLine]", 
          RowBox[{"(*", " ", "*)"}], "\[IndentingNewLine]", 
          RowBox[{"pSeriesArray", "=", 
           RowBox[{
            RowBox[{"Position", "[", 
             RowBox[{
              RowBox[{"baseBranchTypeArray", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
              RowBox[{"x_", "/;", 
               RowBox[{"x", "==", "puiseuxMatchIndex"}]}]}], "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"branchDataIndex", "=", 
           RowBox[{"pSeriesArray", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"theBranchType", "=", 
           RowBox[{"baseBranchTypeArray", "[", 
            RowBox[{"[", 
             RowBox[{"branchDataIndex", ",", "1"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{
           "basePoleList", " ", "is", " ", "list", " ", "of", " ", "all", " ",
             "series", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"series", "#"}], ",", 
              RowBox[{"{", 
               RowBox[{"denominator", ",", "numerator"}], "}"}]}], "}"}], " ",
             "for", " ", "each", " ", "sheet"}], " ", "*)"}], 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"Print", "[", 
             RowBox[{
             "\"\<          Blue contour impinging on branch \>\"", ",", 
              "theBranchType", ",", "\"\< sheet \>\"", ",", 
              "puiseuxMatchIndex"}], "]"}], ";"}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"poleData", "=", 
           RowBox[{"basePoleList", "[", 
            RowBox[{"[", "branchDataIndex", "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"matchResult", "===", "False"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{"Style", "[", 
               RowBox[{
               "\"\<Leg 2:  match is greater than min threshold value!\>\"", 
                ",", "Red", ",", "12", ",", "Bold"}], "]"}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"Print", "[", 
              RowBox[{"Style", "[", 
               RowBox[{
               "\"\<     Increasing precision\>\"", ",", "12", ",", "Bold", 
                ",", "Red"}], "]"}], "]"}], ";"}], "\[IndentingNewLine]", ",",
             "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"wStartAtLeg3", "=", 
              RowBox[{"theBaseValues", "[", 
               RowBox[{"[", "matchResult", "]"}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"posFoundFlag", "=", "True"}], ";"}]}], 
           "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"posFoundFlag", "\[Equal]", "False"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"Style", "[", 
            RowBox[{
            "\"\<Position not found at end of 10 attempts at increasing \
precision.\>\"", ",", "14", ",", "Red"}], "]"}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Abort", "[", "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"return", "=", "False"}], ";"}], "\[IndentingNewLine]", ",",
          "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"return", "=", 
           RowBox[{"{", 
            RowBox[{
            "wStartAtLeg3", ",", "impingingBranchName", ",", 
             "impingingRootIndex", ",", "impingingSeriesIndex", ",", 
             "impingingBranchMIVPData", ",", "impingingBranchSize", ",", 
             "impingingPoleStatus", ",", "baseSeriesMIVPTable"}], "}"}]}], 
          ";"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       "return"}]}], "\[IndentingNewLine]", "]"}]}], ";"}]}]], "Input",
