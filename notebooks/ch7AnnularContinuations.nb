            "\[IndentingNewLine]", 
            RowBox[{"Print", "[", 
             RowBox[{"\"\<postBranch: \>\"", ",", "postBranch"}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"MemberQ", "[", 
               RowBox[{
                RowBox[{"poleRecords", "[", 
                 RowBox[{"[", 
                  RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", 
                RowBox[{"theCurrentRing", "-", "1"}]}], "]"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"pos", "=", 
                RowBox[{"Position", "[", 
                 RowBox[{
                  RowBox[{"poleRecords", "[", 
                   RowBox[{"[", 
                    RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", 
                  RowBox[{"x_", "/;", 
                   RowBox[{"x", "==", 
                    RowBox[{"theCurrentRing", "-", "1"}]}]}]}], "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"Print", "[", 
                RowBox[{"\"\<pos: \>\"", ",", 
