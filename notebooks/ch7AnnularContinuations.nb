             "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{
             "\"\<     Current singular num: \>\"", ",", "Black", ",", "Bold",
               ",", "14"}], "]"}], ",", 
            RowBox[{"Style", "[", 
