Cell[CellGroupData[{

Cell["processGreenLeg", "Subsubsection",
 CellChangeTimes->{{3.9436221596675005`*^9, 
  3.94362216268228*^9}},ExpressionUUID->"2b3e5542-16a9-4a41-adae-\
66ae8e9824cf"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"processGreenLeg", "[", 
    RowBox[{
    "annulusTable_", ",", "precisionArray_", ",", "theCurrentSingularPoint_", 
     ",", "currentArgument_", ",", "wStartAtLeg3_", ",", 
     "currentSingularPerimeter_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "theZ", ",", "tStart", ",", "tEnd", ",", "wDeriv", ",", "posFoundFlag", 
       ",", "numTries", ",", "leg3F", ",", "theBaseValues", ",", 
       "matchResult", ",", "wStartAtLeg4"}], "}"}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"theZ", "[", "t_", "]"}], ":=", 
       RowBox[{"theCurrentSingularPoint", "+", 
        RowBox[{"currentSingularPerimeter", " ", 
         RowBox[{"Exp", "[", 
          RowBox[{"\[ImaginaryI]", " ", "t"}], "]"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"tStart", "=", 
       RowBox[{"currentArgument", "-", "\[Pi]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"tEnd", "=", "currentArgument"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"wDeriv", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"w", "'"}], "[", "t", "]"}], "\[Equal]", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"(", 
              FractionBox[
               RowBox[{"D", "[", 
                RowBox[{"$theFunction", ",", "z"}], "]"}], 
               RowBox[{"D", "[", 
                RowBox[{"$theFunction", ",", "w"}], "]"}]], ")"}]}], " ", 
            RowBox[{"(", 
             RowBox[{"D", "[", 
              RowBox[{
               RowBox[{"theZ", "[", "t", "]"}], ",", "t"}], " ", "]"}], 
             ")"}]}], ")"}], "/.", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"w", "\[Rule]", 
             RowBox[{"w", "[", "t", "]"}]}], ",", 
            RowBox[{"z", "\[Rule]", 
             RowBox[{"theZ", "[", "t", "]"}]}]}], "}"}]}], ")"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"posFoundFlag", "=", "False"}], ";", "\[IndentingNewLine]", 
      RowBox[{"numTries", "=", "0"}], ";", "\[IndentingNewLine]", 
      RowBox[{"While", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"posFoundFlag", "\[Equal]", "False"}], " ", "&&", " ", 
         RowBox[{"numTries", "\[LessEqual]", "12"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"numTries", "++"}], ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
          "$continuationStiffnessSwitching", ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"leg3F", "=", 
             RowBox[{"NDSolveValue", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"wDeriv", ",", 
                 RowBox[{
                  RowBox[{"w", "[", "tStart", "]"}], "\[Equal]", 
                  "wStartAtLeg3"}]}], "}"}], ",", "w", ",", 
               RowBox[{"{", 
                RowBox[{"t", ",", "tStart", ",", "tEnd"}], "}"}], ",", 
               RowBox[{"MaxSteps", "\[Rule]", "10000000"}], ",", 
               RowBox[{"MaxStepSize", "\[Rule]", 
                RowBox[{"precisionArray", "[", 
                 RowBox[{"[", 
                  RowBox[{"numTries", ",", "1"}], "]"}], "]"}]}], ",", 
               RowBox[{"WorkingPrecision", "\[Rule]", 
                RowBox[{"precisionArray", "[", 
                 RowBox[{"[", 
                  RowBox[{"numTries", ",", "2"}], "]"}], "]"}]}], ",", 
               RowBox[{"Method", "->", "\"\<StiffnessSwitching\>\""}]}], 
              "]"}]}], ";"}], "\[IndentingNewLine]", ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"leg3F", "=", 
             RowBox[{"NDSolveValue", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"wDeriv", ",", 
                 RowBox[{
                  RowBox[{"w", "[", "tStart", "]"}], "\[Equal]", 
                  "wStartAtLeg3"}]}], "}"}], ",", "w", ",", 
               RowBox[{"{", 
                RowBox[{"t", ",", "tStart", ",", "tEnd"}], "}"}], ",", 
               RowBox[{"MaxSteps", "\[Rule]", "10000000"}], ",", 
               RowBox[{"MaxStepSize", "\[Rule]", 
                RowBox[{"precisionArray", "[", 
                 RowBox[{"[", 
                  RowBox[{"numTries", ",", "1"}], "]"}], "]"}]}], ",", 
               RowBox[{"WorkingPrecision", "\[Rule]", 
                RowBox[{"precisionArray", "[", 
                 RowBox[{"[", 
                  RowBox[{"numTries", ",", "2"}], "]"}], "]"}]}]}], "]"}]}], 
            ";"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]",
          "\[IndentingNewLine]", 
         RowBox[{"theBaseValues", "=", 
          RowBox[{"w", "/.", 
           RowBox[{"NSolve", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"$theFunction", "\[Equal]", "0"}], "/.", 
              RowBox[{"z", "\[Rule]", 
               RowBox[{"theZ", "[", "tEnd", "]"}]}]}], ",", 
             RowBox[{"WorkingPrecision", "->", "40"}]}], "]"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"theBaseValues", "=", 
          RowBox[{"Sort", "[", "theBaseValues", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"\"\<End of green leg base values: \>\"", ",", 
             RowBox[{
              RowBox[{"theBaseValues", "//", "N"}], "//", "MatrixForm"}]}], 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<End of green leg value: \>\"", ",", 
             RowBox[{
              RowBox[{"leg3F", "[", "tEnd", "]"}], "//", "N"}]}], "]"}], 
           ";"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"(*", " ", "\[IndentingNewLine]", 
          RowBox[{"first", " ", "get", " ", "minimum", " ", "separation"}], 
          "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"(*", " ", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"matchResult", "=", 
          RowBox[{"getMatchingValue", "[", 
           RowBox[{
            RowBox[{"leg3F", "[", "tEnd", "]"}], ",", "theBaseValues", ",", 
            "False"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{"$getMatchValueDiagFlag", ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Print", "[", 
             RowBox[{"\"\<getMatchResult value: \>\"", ",", 
              RowBox[{"matchResult", "//", "N"}]}], "]"}], ";"}]}], 
          "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"matchResult", "===", "False"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Print", "[", 
             RowBox[{"Style", "[", 
              RowBox[{
              "\"\<Leg 3:  match is greater than min threshold value!\>\"", 
               ",", "Red", ",", "12", ",", "Bold"}], "]"}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"Print", "[", 
             RowBox[{"Style", "[", 
              RowBox[{
              "\"\<     Increasing precision\>\"", ",", "12", ",", "Bold", 
               ",", "Red"}], "]"}], "]"}], ";"}], "\[IndentingNewLine]", ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"wStartAtLeg4", "=", 
             RowBox[{"theBaseValues", "[", 
              RowBox[{"[", "matchResult", "]"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"posFoundFlag", "=", "True"}], ";"}]}], 
          "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", "]"}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"posFoundFlag", "\[Equal]", "False"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"Style", "[", 
           RowBox[{
           "\"\<Position not found at end of 10 attempts at increasing \
precision.\>\"", ",", "14", ",", "Red"}], "]"}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Abort", "[", "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], 
      ";", "\[IndentingNewLine]", "wStartAtLeg4"}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.943610694487387*^9, 3.943610805164321*^9}, {
   3.9436108482322874`*^9, 3.9436109887302527`*^9}, {3.9436110242532797`*^9, 
   3.9436110555269947`*^9}, {3.943611122089365*^9, 3.9436111720002794`*^9}, {
   3.943611260619963*^9, 3.943611371671971*^9}, 3.943720396750193*^9, {
   3.9580483246027155`*^9, 3.958048324618379*^9}, {3.9583106449498606`*^9, 
