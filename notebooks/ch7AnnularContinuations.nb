Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{"do", " ", "singular", " ", "monodromies"}], "\[IndentingNewLine]",
    "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"FileExistsQ", "[", 
       RowBox[{"singularMonodromyFileName", "[", "$theTestCase", "]"}], "]"}],
       ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"sData", "=", 
        RowBox[{"Import", "[", 
         RowBox[{"singularMonodromyFileName", "[", "$theTestCase", "]"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"singularMonodromies", "=", 
        RowBox[{"sData", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", " ", 
       RowBox[{"Print", "[", 
        RowBox[{
         RowBox[{"MapThread", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"#1", ",", "#2", ",", "#3"}], "}"}], "&"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Range", "[", 
              RowBox[{"Length", "@", "$theSingularList"}], "]"}], ",", 
             "singularMonodromies", ",", 
             RowBox[{"$minRadiusArray", "//", "N"}]}], "}"}]}], "]"}], "//", 
         "MatrixForm"}], "]"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", " ", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"yOffSet", "=", "20"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", "\[IndentingNewLine]", " ", 
        RowBox[{
        "first", " ", "do", " ", "singular", " ", "point", " ", "at", " ", 
         "origin", " ", "if", " ", "needed"}], "\[IndentingNewLine]", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"singularPointMonodromyGraphics", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"$theSingularList", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "==", "0"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"AppendTo", "[", 
           RowBox[{"singularPointMonodromyGraphics", ",", 
            RowBox[{"Inset", "[", 
             RowBox[{
              RowBox[{"Style", "[", 
               RowBox[{
                RowBox[{"ToString", "@", 
                 RowBox[{"singularMonodromies", "[", 
                  RowBox[{"[", "1", "]"}], "]"}]}], ",", "12"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"0", ",", 
                RowBox[{"yOffSet", "+", "sgIndex"}]}], "}"}], ",", "Left"}], 
             "]"}]}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"k", "=", "1"}], ",", 
         RowBox[{"k", "<=", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"Length", "@", "theAnnuli"}], ")"}], "-", "1"}]}], ",", 
         RowBox[{"k", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"aIndex", ",", "sIndex"}], "}"}], "=", 
           RowBox[{"getSingTableIndexes", "[", 
            RowBox[{"annulusTable", ",", "k"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"j", "=", "1"}], ",", 
            RowBox[{"j", "<=", 
             RowBox[{"Length", "@", "sIndex"}]}], ",", 
            RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"singIndexes", "=", 
              RowBox[{"ringMemberSingularIndexes", "[", 
               RowBox[{"[", "k", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"yOffSet", "-=", "sgIndex"}], ";", "\[IndentingNewLine]", 
             RowBox[{"AppendTo", "[", 
              RowBox[{"singularLoc", ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"singIndexes", "[", 
                  RowBox[{"[", "j", "]"}], "]"}], ",", "yOffSet"}], "}"}]}], 
              "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"Print", "[", 
              RowBox[{"\"\<the sing monodromy: \>\"", ",", 
               RowBox[{"Style", "[", 
                RowBox[{
                 RowBox[{"annulusTableR", "[", 
                  RowBox[{"[", 
                   RowBox[{
                    RowBox[{"sIndex", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], ",", "6"}], "]"}], "]"}], 
                 ",", "12"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"AppendTo", "[", 
              RowBox[{"singularPointMonodromyGraphics", ",", 
               RowBox[{"Inset", "[", 
                RowBox[{
                 RowBox[{"Style", "[", 
                  RowBox[{
                   RowBox[{"annulusTableR", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"sIndex", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], ",", "6"}], "]"}], "]"}], 
                   ",", "12"}], "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"0", ",", "yOffSet"}], "}"}], ",", "Left"}], 
                "]"}]}], "]"}], ";"}]}], "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{"AppendTo", "[", 
              RowBox[{"singularPointMonodromyGraphics", ",", 
               RowBox[{"Inset", "[", 
                RowBox[{
                 RowBox[{"Style", "[", 
                  RowBox[{
                   RowBox[{"ToString", "@", 
                    RowBox[{"annulusTableR", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"sIndex", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], ",", "6"}], "]"}], 
                    "]"}]}], ",", "12"}], "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"0", ",", "yOffSet"}], "}"}], ",", "Left"}], 
                "]"}]}], "]"}], ";"}], "*)"}], "\[IndentingNewLine]", 
           "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"yOffSet", "-=", "agIndex"}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"Show", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Graphics", "@", "annulusIndexGraphics"}], ",", 
            RowBox[{"Graphics", "@", 
             RowBox[{"Translate", "[", 
              RowBox[{"annuliGraphics", ",", 
               RowBox[{"{", 
                RowBox[{"1", ",", "0"}], "}"}]}], "]"}]}], ",", 
            RowBox[{"Graphics", "@", 
             RowBox[{"Translate", "[", 
              RowBox[{"singularPointGraphics", ",", 
               RowBox[{"{", 
                RowBox[{"1.2", ",", "0"}], "}"}]}], "]"}]}], ",", 
            RowBox[{"Graphics", "@", 
             RowBox[{"Translate", "[", 
              RowBox[{"singularPointIndexGraphics", ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"1", "/", "2"}], ",", "0"}], "}"}]}], "]"}]}], ",", 
            RowBox[{"Graphics", "@", 
             RowBox[{"Translate", "[", 
              RowBox[{"singularPointMonodromyGraphics", ",", 
               RowBox[{"{", 
                RowBox[{"4", ",", "0"}], "}"}]}], "]"}]}]}], "}"}], ",", 
          RowBox[{"PlotRange", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "1"}], ",", "12"}], "}"}], ",", "All"}], "}"}]}], 
          ",", 
          RowBox[{"Axes", "->", "True"}]}], "]"}], "]"}], ";"}], 
      "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"singularMonodromyFileName", "[", "$theTestCase", "]"}], 
           "<>", "\"\< not found during import.\>\""}], ",", "Red"}], "]"}], 
        "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], 
