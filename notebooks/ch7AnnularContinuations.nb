Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{
   RowBox[{
    RowBox[{"getRandomSingleCoeffPoly", "[", 
     RowBox[{
     "zExpMax_", ",", "zPolySize_", ",", "wExpMax_", ",", "sparseVal_"}], 
     "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "randomNum", ",", "getZPower", ",", "getWPower", ",", "getcoef", ",", 
        "foundFlag", ",", "index", ",", "functionDegree", ",", "$theFunction",
         ",", "wExp"}], "}"}], ",", "\[IndentingNewLine]", " ", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"randomNum", "[", "n_", "]"}], ":=", " ", 
        RowBox[{"RandomChoice", "[", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{"0", ",", 
             RowBox[{"{", "n", "}"}]}], "]"}], ",", 
           RowBox[{"{", "1", "}"}]}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", " ", 
       RowBox[{
        RowBox[{"getZPower", "[", "n_", "]"}], ":=", 
        RowBox[{
         RowBox[{"randomNum", "[", "sparseVal", "]"}], 
         RowBox[{"RandomInteger", "[", 
          RowBox[{"{", 
           RowBox[{"0", ",", "5"}], "}"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"getWPower", "[", "n_", "]"}], ":=", " ", 
        RowBox[{
         RowBox[{"randomNum", "[", "sparseVal", "]"}], 
         RowBox[{"RandomInteger", "[", 
          RowBox[{"{", 
           RowBox[{"0", ",", "n"}], "}"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"getcoef", "[", 
         RowBox[{"a_", ",", "b_"}], "]"}], ":=", 
        RowBox[{
         RowBox[{"RandomInteger", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "a"}], ",", "a"}], "}"}], "]"}], "/", 
         RowBox[{"RandomInteger", "[", 
          RowBox[{"{", 
           RowBox[{"1", ",", "b"}], "}"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"foundFlag", "=", "False"}], ";", "\[IndentingNewLine]", 
       RowBox[{"index", "=", "1"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"While", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"!", "foundFlag"}], " ", "&&", " ", 
          RowBox[{"index", "<", "25"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"$theFunction", "=", 
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"randomNum", "[", "sparseVal", "]"}], " ", 
              RowBox[{"getcoef", "[", 
               RowBox[{"8", ",", "5"}], "]"}], 
              RowBox[{"z", "^", 
               RowBox[{"getZPower", "[", "zExpMax", "]"}]}], " ", 
              RowBox[{"w", "^", 
               RowBox[{"getWPower", "[", "wExpMax", "]"}]}]}], ",", 
             RowBox[{"{", "wExpMax", "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"$theFunction", "=", 
             RowBox[{"Sum", "[", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"Sum", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"getcoef", "[", 
                    RowBox[{"8", ",", "5"}], "]"}], " ", 
                    RowBox[{"z", "^", 
                    RowBox[{"getZPower", "[", "zExpMax", "]"}]}]}], ",", 
                    RowBox[{"{", "zPolySize", "}"}]}], "]"}], ")"}], "  ", 
                 RowBox[{"w", "^", 
                  RowBox[{"getWPower", "[", "wExpMax", "]"}]}]}], ")"}], ",", 
               RowBox[{"{", "25", "}"}]}], "]"}]}], ";"}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"!", 
             RowBox[{"IrreduciblePolynomialQ", "[", "$theFunction", "]"}]}], 
            ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"index", "++"}], ";"}], "\[IndentingNewLine]", ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"foundFlag", "=", "True"}], ";"}]}], 
           "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", 
        "]"}], ";", "\[IndentingNewLine]", "$theFunction"}]}], 
     "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]"}]}]], "Input",
