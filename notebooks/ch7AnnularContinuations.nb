          RowBox[{"Print", "[", 
           RowBox[{"\"\<Impinging post-annulus branch: \>\"", ",", 
            RowBox[{"theNextRingCycles", "[", 
             RowBox[{"[", 
              RowBox[{"nextRingCyclePosition", "//", "First"}], "]"}], 
             "]"}]}], "]"}], ";"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"(*", 
