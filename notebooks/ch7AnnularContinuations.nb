      RowBox[{"(*", "\[IndentingNewLine]", " ", 
       RowBox[{
       "check", " ", "if", " ", "this", " ", "annulus", " ", "has", " ", "a", 
        " ", "pole", " ", "link"}], "\[IndentingNewLine]", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"MemberQ", "[", 
          RowBox[{
           RowBox[{"newPoleLinkTable", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", "k"}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{
           "\"\<Annulus \>\"", ",", "k", ",", "\"\< has a pole link\>\""}], 
           "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"aIndex2", ",", "sIndex2"}], "}"}], "=", 
           RowBox[{"getSingTableIndexes", "[", 
            RowBox[{"annulusTable", ",", "k"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"theCurrentMonodromy", "=", 
