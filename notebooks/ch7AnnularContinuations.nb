Cell["Section 7.5:  Update annulus table with pole links", "Subsection",
 CellChangeTimes->{{3.9868894931551266`*^9, 
  3.9868895011454115`*^9}},ExpressionUUID->"bb211fab-82a5-403e-b2e1-\
e17e27452ecb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"branchPoleLinks", "=", "newPoleLinkTable"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"branchPoleLinks", "//", "MatrixForm"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"i", "=", "1"}], ",", 
      RowBox[{"i", "<=", 
       RowBox[{"Length", "@", "newPoleLinkTable"}]}], ",", 
      RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"poleLinkRecord", "=", 
        RowBox[{"newPoleLinkTable", "[", 
         RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<poleLinkRecord: \>\"", ",", "poleLinkRecord"}], "]"}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"poleLinkData", "=", 
        RowBox[{"poleLinkRecord", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<poleLinkData: \>\"", ",", "poleLinkData"}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"singularIndexes", "=", 
        RowBox[{
         RowBox[{"poleLinkData", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "1"}], "]"}], "]"}], "//", 
         "DeleteDuplicates"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<singularIndexes: \>\"", ",", "singularIndexes"}], "]"}], 
       ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"singIndex", "=", "1"}], ",", 
         RowBox[{"singIndex", "<=", 
          RowBox[{"Length", "@", "singularIndexes"}]}], ",", 
         RowBox[{"singIndex", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"singPoleData", "=", 
           RowBox[{"Select", "[", 
            RowBox[{"poleLinkData", ",", 
             RowBox[{
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "==", 
               RowBox[{"singularIndexes", "[", 
                RowBox[{"[", "singIndex", "]"}], "]"}]}], "&"}]}], "]"}]}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<singular point: \>\"", ",", 
            RowBox[{"singularIndexes", "[", 
             RowBox[{"[", "singIndex", "]"}], "]"}], ",", 
            "\"\< singPoleData: \>\"", ",", "singPoleData"}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"annulusTableSingRecord", "=", 
           RowBox[{
            RowBox[{"Position", "[", 
             RowBox[{
              RowBox[{"annulusTable", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
              RowBox[{"x_", "/;", 
               RowBox[{"x", "==", 
                RowBox[{"singularIndexes", "[", 
                 RowBox[{"[", "singIndex", "]"}], "]"}]}]}]}], "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{
           "\"\<annulusTableSingRecord: \>\"", ",", 
            "annulusTableSingRecord"}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"annulusTable", "[", 
            RowBox[{"[", 
             RowBox[{"annulusTableSingRecord", ",", "8"}], "]"}], "]"}], "=", 
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{"singPoleData", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", 
                RowBox[{"2", ";;"}]}], "]"}], "]"}], ",", "8"}], "]"}]}], ";",
           "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"annulusTableR", "[", 
            RowBox[{"[", 
             RowBox[{"annulusTableSingRecord", ",", "8"}], "]"}], "]"}], "=", 
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{"singPoleData", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", 
                RowBox[{"2", ";;"}]}], "]"}], "]"}], ",", "8"}], "]"}]}], 
          ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]}], 
     "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"annulusTableReport", "=", 
     RowBox[{"Prepend", "[", 
