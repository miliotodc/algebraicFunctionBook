            " ", "testing", " ", "\[IndentingNewLine]", "    ", "so", " ", 
           "if", " ", 
           RowBox[{"theContiniuationList3", "[", 
            RowBox[{"[", 
             RowBox[{"theCurrentRingIndex", ",", "6"}], "]"}], "]"}]}], "=", 
