                 RowBox[{"\"\<GlobalAdaptive\>\"", ",", 
                  RowBox[{"\"\<MaxErrorIncreases\>\"", "->", "600"}], ",", 
                  RowBox[{"Method", "->", "\"\<GaussKronrodRule\>\""}]}], 
                 "}"}]}], ",", 
               RowBox[{"WorkingPrecision", "->", 
                RowBox[{"OptionValue", "[", "\"\<intWP\>\"", "]"}]}], ",", 
               RowBox[{"MaxRecursion", "->", "Infinity"}], ",", 
               RowBox[{"AccuracyGoal", "->", "6"}]}], "]"}], "*)"}], 
            "\[IndentingNewLine]", "]"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"monodromyIndex", ",", "1", ",", 
            RowBox[{"Length", "@", "selectedMonodromies"}]}], "}"}]}], 
