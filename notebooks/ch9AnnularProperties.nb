Cell[CellGroupData[{

Cell["getMonodromyOverContour", "Subsection",
 CellChangeTimes->{{3.9628008116449804`*^9, 
  3.962800815221407*^9}},ExpressionUUID->"1d6ad7b7-913f-4f9b-9571-\
ba78d88ba856"],

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"getMonodromyOverContour", "[", 
      RowBox[{
      "contour_", ",", "tStart_", ",", "tEnd_", ",", "theFunction_", ",", 
       "stiffnessFlag_", ",", "precision_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "z0", ",", "annularMedialVals", ",", "wArray", ",", "intTable", ",", 
         "w0", ",", "wDeriv", ",", "pArray", ",", "theCycles", ",", 
         "theLinks", ",", "oneCycles", ",", "finalCycles", ",", "theSol"}], 
        "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"z0", "=", 
         RowBox[{"contour", "[", "tStart", "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"annularMedialVals", "=", 
         RowBox[{"Sort", "[", 
          RowBox[{"w", "/.", 
           RowBox[{"NSolve", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"theFunction", "==", "0"}], "/.", 
              RowBox[{"z", "->", "z0"}]}], ",", "w", ",", 
             RowBox[{"WorkingPrecision", "->", "precision"}]}], "]"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"\"\<annularMedialVals: \>\"", ",", 
            RowBox[{"annularMedialVals", "//", "N"}]}], "]"}], ";"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"wArray", "=", 
         RowBox[{"MapThread", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"#1", ",", "#2"}], "}"}], "&"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Range", "[", 
              RowBox[{"Length", "@", "annularMedialVals"}], "]"}], ",", 
             "annularMedialVals"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", " ", 
        RowBox[{"intTable", "=", 
         RowBox[{"Table", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"w0", "=", 
             RowBox[{"wArray", "[", 
              RowBox[{"[", 
               RowBox[{"n", ",", "2"}], "]"}], "]"}]}], ";", 
            "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"wDeriv", "=", 
             RowBox[{
              RowBox[{
               RowBox[{"w", "'"}], "[", "t", "]"}], "\[Equal]", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"-", 
                   RowBox[{"(", 
                    FractionBox[
                    RowBox[{"D", "[", 
                    RowBox[{"theFunction", ",", "z"}], "]"}], 
                    RowBox[{"D", "[", 
                    RowBox[{"theFunction", ",", "w"}], "]"}]], ")"}]}], " ", 
                  RowBox[{"D", "[", 
                   RowBox[{
                    RowBox[{"contour", "[", "t", "]"}], ",", "t"}], "]"}]}], 
                 ")"}], "/.", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"w", "\[Rule]", 
                   RowBox[{"w", "[", "t", "]"}]}], ",", 
                  RowBox[{"z", "\[Rule]", 
                   RowBox[{"contour", "[", "t", "]"}]}]}], "}"}]}], ")"}]}]}],
             ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{"stiffnessFlag", ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"theSol", "=", 
                RowBox[{"NDSolveValue", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"wDeriv", ",", 
                    RowBox[{
                    RowBox[{"w", "[", "tStart", "]"}], "\[Equal]", "w0"}]}], 
                   "}"}], ",", "w", ",", 
                  RowBox[{"{", 
                   RowBox[{"t", ",", "tStart", ",", "tEnd"}], "}"}], ",", 
                  RowBox[{"MaxSteps", "\[Rule]", "2000000"}], ",", 
                  RowBox[{"MaxStepSize", "\[Rule]", 
                   RowBox[{"1", "/", "1000"}]}], ",", 
                  RowBox[{"WorkingPrecision", "\[Rule]", "precision"}], ",", 
                  RowBox[{"Method", " ", "\[Rule]", " ", 
                   RowBox[{"{", 
                    RowBox[{"\"\<StiffnessSwitching\>\"", ",", 
                    RowBox[{"\"\<NonstiffTest\>\"", "->", "False"}]}], 
                    "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", ",", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"theSol", "=", 
                RowBox[{"NDSolveValue", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"wDeriv", ",", 
                    RowBox[{
                    RowBox[{"w", "[", "tStart", "]"}], "\[Equal]", "w0"}]}], 
                   "}"}], ",", "w", ",", 
                  RowBox[{"{", 
                   RowBox[{"t", ",", "tStart", ",", "tEnd"}], "}"}], ",", 
                  RowBox[{"MaxSteps", "\[Rule]", "2000000"}], ",", 
                  RowBox[{"MaxStepSize", "\[Rule]", 
                   RowBox[{"1", "/", "1000"}]}], ",", 
                  RowBox[{"WorkingPrecision", "\[Rule]", "precision"}]}], 
                 "]"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", " ", 
             RowBox[{"save", " ", 
              RowBox[{"{", 
               RowBox[{"seriesIndex", ",", 
                RowBox[{"theSol", "[", "1", "]"}]}], "}"}]}], " ", "*)"}], 
            "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"wArray", "[", 
               RowBox[{"[", 
                RowBox[{"n", ",", "1"}], "]"}], "]"}], ",", 
              RowBox[{"wArray", "[", 
               RowBox[{"[", 
                RowBox[{"n", ",", "2"}], "]"}], "]"}], ",", 
              RowBox[{"theSol", "[", "tEnd", "]"}]}], "}"}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"n", ",", "1", ",", 
             RowBox[{"Length", "@", "wArray"}]}], "}"}]}], 
          "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", "\[IndentingNewLine]", " ", "*)"}], 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"pArray", "=", 
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Position", "[", 
             RowBox[{
              RowBox[{"intTable", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
              RowBox[{"x_", "/;", 
               RowBox[{
                RowBox[{"Abs", "[", 
                 RowBox[{"x", "-", "#"}], "]"}], "<", 
                RowBox[{"10", "^", 
                 RowBox[{"-", "4"}]}]}]}]}], "]"}], "&"}], "/@", " ", 
           RowBox[{"intTable", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "3"}], "]"}], "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"theCycles", "=", 
         RowBox[{"PermutationCycles", "[", "pArray", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"theLinks", "=", 
         RowBox[{"theCycles", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"oneCycles", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"{", "#", "}"}], "&"}], "/@", 
          RowBox[{"Complement", "[", 
           RowBox[{
            RowBox[{"Range", "[", "functionDegree", "]"}], ",", 
            RowBox[{"Flatten", "[", "theLinks", "]"}]}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"finalCycles", "=", 
         RowBox[{"Join", "[", 
          RowBox[{"theLinks", ",", "oneCycles"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "finalCycles"}]}], "\[IndentingNewLine]", 
      "]"}]}], ";"}], "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.9628008268443604`*^9, 3.9628010832547827`*^9}, {
