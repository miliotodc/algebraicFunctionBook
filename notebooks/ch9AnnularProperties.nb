Cell[CellGroupData[{

Cell["Section 7.4.3:  Create table of alpha-domain branch plots", \
"Subsubsection",
 CellChangeTimes->{{3.9830062622522783`*^9, 
  3.9830062795233564`*^9}},ExpressionUUID->"71232300-43a3-4037-9206-\
d3a36e794938"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
   "create", " ", "a", " ", "table", " ", "of", " ", "branch", " ", "plots"}],
    "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"cIndex", "=", "0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"branchTable", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", " ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"branchF", "[", "z_", "]"}], "=", 
         RowBox[{"Plus", "@@", 
          RowBox[{"alphaSeriesSet", "[", 
           RowBox[{"[", 
            RowBox[{"branchIndex", ",", "2", ",", "All", ",", "4"}], "]"}], 
           "]"}]}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"alpha1", "[", "z_", "]"}], "=", 
         RowBox[{"branchF", "[", "z", "]"}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", "  ", 
        RowBox[{"expList", "=", 
         RowBox[{"Exponent", "[", 
          RowBox[{
           RowBox[{"alpha1", "[", "z", "]"}], ",", "z", ",", "List"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"coefList", "=", 
         RowBox[{"Coefficient", "[", 
          RowBox[{
           RowBox[{"alpha1", "[", "z", "]"}], ",", "z", ",", "expList"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"conjBranchF", "[", 
          RowBox[{"z_", ",", "k_"}], "]"}], ":=", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"coefList", "[", 
             RowBox[{"[", "n", "]"}], "]"}], " ", 
            RowBox[{"(", 
             RowBox[{"Exp", "[", 
              RowBox[{"2", " ", "k", " ", "\[Pi]", " ", "\[ImaginaryI]", " ", 
               RowBox[{"expList", "[", 
                RowBox[{"[", "n", "]"}], "]"}]}], "]"}], ")"}], " ", 
            RowBox[{"z", "^", 
             RowBox[{"expList", "[", 
              RowBox[{"[", "n", "]"}], "]"}]}]}], ",", 
           RowBox[{"{", 
            RowBox[{"n", ",", "1", ",", 
             RowBox[{"Length", "[", "coefList", "]"}]}], "}"}]}], "]"}]}], 
        ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"selectedBranch", "=", 
         RowBox[{"alphaMonodromyList", "[", 
          RowBox[{"[", "branchIndex", "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Analyzing branch \>\"", ",", "selectedBranch"}], "]"}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"selectedBranchSize", "=", 
         RowBox[{"Length", "@", 
          RowBox[{"alphaMonodromyList", "[", 
           RowBox[{"[", "branchIndex", "]"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
        "Table", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", " ", 
         RowBox[{
          RowBox[{"ParametricPlot3D", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Re", "@", 
                RowBox[{"(", "z", ")"}]}], ",", 
               RowBox[{"Im", "@", 
                RowBox[{"(", "z", ")"}]}], ",", 
               RowBox[{"Re", "@", 
                RowBox[{"conjBranchF", "[", 
                 RowBox[{"z", ",", "j"}], "]"}]}]}], "}"}], "/.", 
             RowBox[{"z", "->", 
              RowBox[{"r", " ", 
               RowBox[{"Exp", "[", 
                RowBox[{"I", " ", "t"}], "]"}]}]}]}], ",", 
            RowBox[{"{", 
             RowBox[{"r", ",", "innerR", ",", "outerR"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"t", ",", 
              RowBox[{"-", "Pi"}], ",", "Pi"}], "}"}], ",", 
            RowBox[{"BoxRatios", "->", 
             RowBox[{"{", 
              RowBox[{"1", ",", " ", "1", ",", " ", "1"}], "}"}]}], ",", 
            RowBox[{"PlotStyle", "->", 
             RowBox[{"colorTable", "[", 
              RowBox[{"[", 
               RowBox[{"cIndex", "++"}], "]"}], "]"}]}]}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"j", ",", "1", ",", "selectedBranchSize"}], "}"}]}], 
         "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"branchIndex", ",", "1", ",", "totalBranches"}], "}"}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Show", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"p1", ",", "p2"}], "}"}], ",", 
      RowBox[{"PlotRange", "->", "All"}]}], "]"}], "*)"}], 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.977298830387365*^9, 3.9772988325145307`*^9}, 
   3.977299229008852*^9, {3.982929264578534*^9, 3.9829293167980127`*^9}, {
   3.9829293610811305`*^9, 3.9829294553212786`*^9}, {3.9829295304729357`*^9, 
   3.98292959286942*^9}, {3.9829940671836853`*^9, 3.98299407251031*^9}, {
   3.9829941513829737`*^9, 3.9829941627767096`*^9}},
 CellLabel->
