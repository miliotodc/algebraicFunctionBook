Cell["Section 7.4.7:  Create summatory series pSum[z] plot", "Subsubsection",
 CellChangeTimes->{{3.9830066344567404`*^9, 
  3.983006648822262*^9}},ExpressionUUID->"6a056739-ffaf-490b-87bd-\
80828c39da75"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"    ", 
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{"Generate", " ", "summatory", " ", "series", " ", 
    RowBox[{"pSumF", "[", "z", "]"}], " ", "plot"}], "\[IndentingNewLine]", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"pSumF", "[", "z_", "]"}], "=", 
     RowBox[{"Plus", "@@", 
      RowBox[{"alphaSummatoryTerms", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "3"}], "]"}], "]"}]}]}], ";", 
    RowBox[{"pSumFPlot", "=", 
     RowBox[{"ParametricPlot3D", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Re", "@", 
           RowBox[{"(", 
            RowBox[{"z", "+", "translateFactor"}], ")"}]}], ",", 
          RowBox[{"Im", "@", 
           RowBox[{"(", 
            RowBox[{"z", "+", "translateFactor"}], ")"}]}], ",", 
          RowBox[{"Re", "@", 
           RowBox[{"pSumF", "[", "z", "]"}]}]}], "}"}], "/.", 
        RowBox[{"z", "->", 
         RowBox[{"r", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"I", " ", "t"}], "]"}]}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", "innerR", ",", "outerR"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", 
         RowBox[{"-", "Pi"}], ",", "Pi"}], "}"}], ",", 
       RowBox[{"BoxRatios", "->", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "1", ",", " ", "1"}], "}"}]}], ",", 
       RowBox[{"AxesEdge", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", 
            RowBox[{"-", "1"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", 
            RowBox[{"-", "1"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", 
            RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], ",", 
       RowBox[{"AxesLabel", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{"\"\<Re[z]\>\"", ",", "12", ",", "Bold", ",", "Black"}], 
           "]"}], ",", 
          RowBox[{"Style", "[", 
           RowBox[{"\"\<Im[z]\>\"", ",", "12", ",", "Bold", ",", "Black"}], 
           "]"}], ",", 
          RowBox[{"Style", "[", 
           RowBox[{
           "\"\<Re(sF(z))\>\"", ",", "12", ",", "Bold", ",", "Black"}], 
           "]"}]}], "}"}]}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Opacity", "[", "0.5", "]"}], ",", "Red"}], "}"}]}]}], 
      RowBox[{"(*", 
       RowBox[{",", 
        RowBox[{"PlotPoints", "->", "100"}]}], "*)"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pSumFPlotRange", "=", 
     RowBox[{"PlotRange", "[", "pSumFPlot", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"plotP", "=", " ", 
    RowBox[{"Show", "[", 
     RowBox[{"pSumFPlot", ",", 
      RowBox[{"BoxRatios", "->", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "1", ",", " ", "1"}], "}"}]}], ",", 
      RowBox[{"PlotStyle", "->", "LightBlue"}], ",", 
      RowBox[{"AxesEdge", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
