          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"ppBlue", ",", "ppBlue2"}], "}"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"residueDataIndex", ",", "1", ",", 
         RowBox[{"Length", "@", "poleResidueTable"}]}], "}"}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{
    "generate", " ", "contour", " ", "around", " ", "all", " ", "poles"}], 
    " ", "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"envelopeF", "[", "z_", "]"}], ":=", 
