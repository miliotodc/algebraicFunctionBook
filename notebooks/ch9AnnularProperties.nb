Cell[CellGroupData[{

Cell[TextData[{
 "Section 6:  Annular relation 9.3.3:  A set of contiguous annuli free of \
poles is called an annular group ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["A", "n"], ".", " "}], TraditionalForm]],ExpressionUUID->
  "8c12f998-901a-4f27-a8ea-ebf1bb9563f6"],
 " The sum of the coefficients of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["z", "TI"], 
        StyleBox["k", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "$z^k$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e2f2c854-2705-4cca-bd90-1c9ebd1c7a9c"],
 " for integer k for all branches in each annular domain of an annular group \
counted with cyclic multiplicity is a constant given by ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Psi]", "(", 
         RowBox[{
           StyleBox["i", "TI"], ",", 
           StyleBox["n", "TI"]}], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "$\\psi(i,n)$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e33b229d-4e27-4a15-9053-e7502a5b6854"]
}], "Section",
