       RowBox[{"tEnd", "=", 
        RowBox[{"$thetaV", "+", 
         RowBox[{"2", "\[Pi]", " ", "branchSize"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"zStart", "=", 
        RowBox[{"rNorm", " ", 
         RowBox[{"Exp", "[", 
          RowBox[{"\[ImaginaryI]", " ", "tStart"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"zThetaF", "[", "t_", "]"}], ":=", 
        RowBox[{"rNorm", " ", 
         RowBox[{"Exp", "[", 
          RowBox[{"I", " ", "t"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"theRoots", "=", 
        RowBox[{"w", "/.", 
         RowBox[{"NSolve", "[", 
          RowBox[{
           RowBox[{"$theFunction", "\[Equal]", "0"}], "/.", 
           RowBox[{"z", "\[Rule]", "zStart"}]}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"wStart", "=", 
        RowBox[{"theRoots", "[", 
         RowBox[{"[", "rootIndex", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"wDeriv", ":=", 
        RowBox[{
         RowBox[{
          RowBox[{"w", "'"}], "[", "t", "]"}], "\[Equal]", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", 
              FractionBox[
               RowBox[{"D", "[", 
                RowBox[{"$theFunction", ",", "z"}], "]"}], 
               RowBox[{"D", "[", 
                RowBox[{"$theFunction", ",", "w"}], "]"}]]}], " ", 
             RowBox[{"D", "[", 
              RowBox[{
               RowBox[{"zThetaF", "[", "t", "]"}], ",", "t"}], "]"}]}], ")"}],
            "/.", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"w", "\[Rule]", 
              RowBox[{"w", "[", "t", "]"}]}], ",", 
             RowBox[{"z", "\[Rule]", 
              RowBox[{"zThetaF", "[", "t", "]"}]}]}], "}"}]}], ")"}]}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"medialTrace", "=", 
        RowBox[{"NDSolveValue", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"wDeriv", ",", 
            RowBox[{
             RowBox[{"w", "[", "tStart", "]"}], "\[Equal]", "wStart"}]}], 
           "}"}], ",", "w", ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "tStart", ",", "tEnd"}], "}"}], ",", 
          RowBox[{"MaxSteps", "\[Rule]", 
           RowBox[{
           "OptionValue", "[", "\"\<totalIntegrationSteps\>\"", "]"}]}], ",", 
          RowBox[{"MaxStepSize", "\[Rule]", 
           RowBox[{"OptionValue", "[", "\"\<maxStepSize\>\"", "]"}]}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "construct", " ", "point", " ", "along", " ", "medial", " ", 
         "contour", " ", "for", " ", "radial", " ", "integrations"}], " ", 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"arcSegmentList", "=", 
        RowBox[{"Array", "[", 
         RowBox[{
          RowBox[{"#", "&"}], ",", 
          RowBox[{"(", 
           RowBox[{
