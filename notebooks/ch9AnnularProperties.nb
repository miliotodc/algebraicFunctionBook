Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"getSeriesTypes", "[", 
     RowBox[{"baseSeries_", ",", "baseSheetLinks_", ",", "baseRemovalList_"}],
      "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "baseSheetNumbers", ",", "seriesLengths", ",", "theExpList", ",", 
        "minExpList", ",", "cycleTypes", ",", "multiType", ",", "newType", 
        ",", "multiBranchType", ",", "theLType", ",", "minE", ",", "type", 
        ",", "theD", ",", "theN", ",", " ", "theTally", ",", "mVals", ",", 
        "j", ",", "typeLoc", ",", "i", ",", "typeTable"}], " ", "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", "\[IndentingNewLine]", " ", 
       RowBox[{"uniquely", " ", "name", " ", "each", " ", "branch"}], 
       "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"baseSheetNumbers", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"Min", "@", "#"}], "&"}], " ", "/@", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "&"}], "/@", "baseSheetLinks"}], 
          ")"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"seriesLengths", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "#", "]"}], "&"}], "/@", " ", 
         RowBox[{"baseSeries", "[", 
          RowBox[{"[", "baseSheetNumbers", "]"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", " ", 
       RowBox[{"theExpList", "=", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"Exponent", "[", 
           RowBox[{"#", ",", "z", ",", "List"}], "]"}], "&"}], "/@", " ", 
         RowBox[{"baseSeries", "[", 
          RowBox[{"[", "baseSheetNumbers", "]"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"minExpList", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"Min", "[", "#", "]"}], "&"}], " ", "/@", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Select", "[", 
             RowBox[{"#", ",", 
              RowBox[{
               RowBox[{"#", "!=", "0"}], "&"}]}], "]"}], "&"}], "/@", " ", 
           "theExpList"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"cycleTypes", "=", 
        RowBox[{"baseSheetLinks", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"multiType", "[", 
         RowBox[{"a_Integer", ",", "b_String"}], "]"}], ":=", 
        RowBox[{
         RowBox[{
         "StringTemplate", "[", 
          "\"\<\!\(\*SubscriptBox[\(\[InvisiblePrefixScriptBase]\), \
\((`1`)\)]\)`2`\>\"", "]"}], "[", 
         RowBox[{
          RowBox[{"ToString", "@", "a"}], ",", "b"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"newType", "[", 
         RowBox[{
         "a_Integer", ",", "b_String", ",", "c_Integer", ",", "d_Integer"}], 
         "]"}], ":=", 
        RowBox[{
         RowBox[{
         "StringTemplate", "[", 
          "\"\<\!\(\*SubscriptBox[\(\[InvisiblePrefixScriptBase]\), \
\(`1`\)]\)\!\(\*SubsuperscriptBox[\(`2`\), \(`3`\), \(`4`\)]\)\>\"", "]"}], 
         "[", 
         RowBox[{
          RowBox[{"ToString", "@", "a"}], ",", "b", ",", 
          RowBox[{"ToString", "@", "c"}], ",", 
          RowBox[{"ToString", "@", "d"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"multiBranchType", "[", 
         RowBox[{"a_String", ",", "b_Integer", ",", "c_Integer"}], "]"}], ":=", 
        RowBox[{
         RowBox[{
         "StringTemplate", "[", 
          "\"\<\[InvisiblePrefixScriptBase]\!\(\*SubsuperscriptBox[\(`1`\), \
\(`2`\), \(`3`\)]\)\>\"", "]"}], "[", 
         RowBox[{
          RowBox[{"ToString", "@", "a"}], ",", 
          RowBox[{"ToString", "@", "b"}], ",", 
          RowBox[{"ToString", "@", "c"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"theLType", "[", 
         RowBox[{"a_String", ",", "b_Integer"}], "]"}], ":=", 
        RowBox[{
         RowBox[{
         "StringTemplate", "[", 
          "\"\<\!\(\*SubscriptBox[\(`1`\), \(`2`\)]\)\>\"", "]"}], "[", 
         RowBox[{"a", ",", 
          RowBox[{"ToString", "@", "b"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", " ", 
       RowBox[{"(*", " ", "\[IndentingNewLine]", 
        RowBox[{"pick", " ", "out", " ", "Taylor", " ", 
         RowBox[{"series", ":"}]}], " ", "\[IndentingNewLine]", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"typeTable", "=", 
        RowBox[{"Table", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"minE", "=", 
            RowBox[{"minExpList", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"cycleTypes", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "==", "1"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"baseRemovableList", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", ",", "2"}], "]"}], "]"}], "!=", 
                 RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", 
                RowBox[{"(*", 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{"MemberQ", "[", 
                    RowBox[{
                    RowBox[{"baseRemovableList", "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", 
                    RowBox[{"baseSheetNumbers", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ","}]}], "*)"}], 
                "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"type", "=", "\"\<E\>\""}], ";"}], 
                "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{"minE", "<", "0"}], ",", "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"theN", "=", 
                    RowBox[{"Numerator", "[", "minE", "]"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"(*", 
                    RowBox[{
                    RowBox[{"type", "=", 
                    SubscriptBox["\"\<L\>\"", 
                    RowBox[{"ToString", "[", "theN", "]"}]]}], ";"}], "*)"}], 
                    "\[IndentingNewLine]", 
                    RowBox[{"type", "=", 
                    RowBox[{"theLType", "[", 
                    RowBox[{"\"\<L\>\"", ",", "theN"}], "]"}]}], ";"}], 
                   "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"type", "=", "\"\<T\>\""}], ";"}]}], 
                  "\[IndentingNewLine]", "]"}], ";"}]}], 
               "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
             ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"theD", "=", 
               RowBox[{"Denominator", "[", "minE", "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"theN", "=", 
               RowBox[{"Numerator", "[", "minE", "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"minE", ">", "0"}], ",", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{"minE", ">", "1"}], ",", "\[IndentingNewLine]", 
                   RowBox[{"(*", 
                    RowBox[{
                    RowBox[{"type", "=", 
                    SubsuperscriptBox["F", 
                    RowBox[{"ToString", "[", "theD", "]"}], 
                    RowBox[{"ToString", "[", "theN", "]"}]]}], ";"}], "*)"}], 
                   "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"type", "=", 
                    RowBox[{"multiBranchType", "[", 
                    RowBox[{"\"\<F\>\"", ",", 
                    RowBox[{"cycleTypes", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], ",", "theN"}], "]"}]}], 
                    ";"}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
                   RowBox[{"(*", 
                    RowBox[{
                    RowBox[{"type", "=", 
                    SubsuperscriptBox["V", 
                    RowBox[{"ToString", "[", "theD", "]"}], 
                    RowBox[{"ToString", "[", "theN", "]"}]]}], ";"}], "*)"}], 
                   "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"type", "=", 
                    RowBox[{"multiBranchType", "[", 
                    RowBox[{"\"\<V\>\"", ",", 
                    RowBox[{"cycleTypes", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], ",", "theN"}], "]"}]}], 
                    ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], 
                "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
                RowBox[{"(*", 
                 RowBox[{
                  RowBox[{"type", "=", 
                   SubsuperscriptBox["P", 
                    RowBox[{"ToString", "[", "theD", "]"}], 
                    RowBox[{"ToString", "[", "theN", "]"}]]}], ";"}], "*)"}], 
                "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"type", "=", 
                  RowBox[{"multiBranchType", "[", 
                   RowBox[{"\"\<P\>\"", ",", 
                    RowBox[{"cycleTypes", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], ",", "theN"}], "]"}]}], 
                 ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]}], 
            "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
           "type"}], ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{"Length", "@", "baseSheetNumbers"}]}], "}"}]}], 
         "\[IndentingNewLine]", "]"}]}], ";", " ", 
       RowBox[{"(*", " ", 
        RowBox[{
        "theTally", ",", "mVals", ",", "j", ",", "typeLoc", ",", "i", ",", 
         "typeTable"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"theTally", "=", 
        RowBox[{"Tally", "[", "typeTable", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"mVals", "=", 
        RowBox[{"Select", "[", 
         RowBox[{"theTally", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ">", "1"}], "&"}]}], "]"}]}], 
       ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"j", "=", "1"}], ",", 
         RowBox[{"j", "<=", 
          RowBox[{"Length", "@", "mVals"}]}], ",", 
         RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"typeLoc", "=", 
           RowBox[{"Flatten", "@", 
            RowBox[{"Position", "[", 
             RowBox[{"typeTable", ",", 
              RowBox[{"x_", "/;", 
               RowBox[{"x", "==", 
                RowBox[{"mVals", "[", 
                 RowBox[{"[", 
                  RowBox[{"j", ",", "1"}], "]"}], "]"}]}]}]}], "]"}]}]}], ";",
           "\[IndentingNewLine]", 
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"i", "=", "1"}], ",", 
            RowBox[{"i", "<=", 
             RowBox[{"Length", "@", "typeLoc"}]}], ",", 
            RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"typeTable", "[", 
               RowBox[{"[", 
                RowBox[{"typeLoc", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], "=", 
              RowBox[{
               RowBox[{"ToString", "[", "i", "]"}], "<>", 
               RowBox[{"typeTable", "[", 
                RowBox[{"[", 
                 RowBox[{"typeLoc", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}]}]}], ";"}]}], 
           "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{
              RowBox[{"typeTable", "[", 
               RowBox[{"[", 
                RowBox[{"typeLoc", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], "=", 
              RowBox[{"multiType", "[", 
               RowBox[{"i", ",", 
                RowBox[{"typeTable", "[", 
                 RowBox[{"[", 
                  RowBox[{"typeLoc", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}]}], "]"}]}], 
             ";"}], "*)"}], "\[IndentingNewLine]", "]"}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"typeTable", ",", "baseSheetNumbers", ",", "seriesLengths"}], 
        "}"}]}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}], 
   ";"}]}]], "Input",
 CellChangeTimes->{{3.927105084486573*^9, 3.9271050849085197`*^9}, {
  3.927182293357755*^9, 3.927182299434436*^9}, {3.9271823549994187`*^9, 
  3.9271823568585415`*^9}, {3.928076355917574*^9, 3.92807638572591*^9}},
 CellLabel->
  "In[183]:=",ExpressionUUID->"f0ab8561-db6a-4f45-9bc7-26315e944973"]
}, Closed]],

Cell[CellGroupData[{

Cell["getSummatoryRootTest", "Subsection",
 CellChangeTimes->{{3.946910532435474*^9, 
  3.9469105359815474`*^9}},ExpressionUUID->"ff9f8b63-85c3-43ba-8ed8-\
e0be8496c642"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"getSummatoryRootTest", "[", 
      RowBox[{"summatorySeries_", ",", "poleIndex_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "seriesLength", ",", "cycleType", ",", "theexp", ",", "lcm", ",", 
         "numVals", ",", "cList", ",", "cTable", ",", "lp1", ",", 
         "startTerms", ",", "dataVals", ",", "plotXStart", ",", "plotXEnd", 
         ",", "endTerms", ",", "seriesType", ",", "graphicsData", ",", 
         "linearLine", ",", "quadraticLine", ",", "cubicLine", ",", 
         "linearResidue", ",", "cubicResidue", ",", "quadraticResidue", ",", 
         "residueSet", ",", "fitSet", ",", "bestFitPos", ",", "rTest", ",", 
         "fitResults", ",", "linearPlot", ",", "quadraticPlot", ",", 
         "cubicPlot", ",", "plotSet", ",", "plotFlag", ",", "fitValueG", ",", 
         "plotLabel", ",", "thePlotRange", ",", "xCoord", ",", "yCoord", ",", 
         "clist"}], "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"seriesLength", "=", 
         RowBox[{"Length", "@", "summatorySeries"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"cycleType", "=", "1"}], ";", "\[IndentingNewLine]", 
        RowBox[{"theexp", "=", 
         RowBox[{"Exponent", "[", 
          RowBox[{"summatorySeries", ",", "z", ",", "List"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"lcm", "=", 
         RowBox[{"LCM", "@@", 
          RowBox[{"(", 
           RowBox[{"Denominator", "@", "theexp"}], ")"}]}]}], ";", "\n", 
        "        ", 
        RowBox[{"numVals", "=", 
         RowBox[{"lcm", " ", "theexp"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"clist", "=", 
         RowBox[{"Coefficient", "[", 
          RowBox[{"summatorySeries", ",", "z", ",", "theexp"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"cTable", "=", 
         RowBox[{"Table", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"1", "/", 
              RowBox[{"numVals", "[", 
               RowBox[{"[", "k", "]"}], "]"}]}], ",", 
             RowBox[{"N", "[", 
              RowBox[{
               RowBox[{"1", "/", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"Abs", "[", 
                   RowBox[{"clist", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], "]"}], "^", 
                  RowBox[{"(", 
                   RowBox[{"cycleType", "/", 
                    RowBox[{"numVals", "[", 
                    RowBox[{"[", "k", "]"}], "]"}]}], ")"}]}], ")"}]}], ",", 
               "25"}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"k", ",", "15", ",", 
             RowBox[{"Length", "@", "clist"}]}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"lp1", "=", 
         RowBox[{"ListPlot", "[", 
          RowBox[{"cTable", ",", 
           RowBox[{"PlotStyle", "->", 
            RowBox[{"{", 
             RowBox[{"PointSize", "[", "0.0105", "]"}], "}"}]}], ",", 
           RowBox[{"AxesOrigin", "->", 
            RowBox[{"{", 
             RowBox[{"0", ",", "0"}], "}"}]}], ",", 
           RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"startTerms", "=", "10"}], ";", "\[IndentingNewLine]", 
        RowBox[{"dataVals", "=", 
         RowBox[{"cTable", "[", 
          RowBox[{"[", 
           RowBox[{"startTerms", ";;"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"plotXStart", "=", 
         RowBox[{"cTable", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"-", "1"}], ",", "1"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"plotXEnd", "=", 
         RowBox[{"cTable", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"endTerms", "=", 
         RowBox[{"Length", "@", "cTable"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
        "seriesType", "=", "\"\<\!\(\*SubscriptBox[\(L\), \(-1\)]\)\>\""}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"graphicsData", "=", 
         RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"linearLine", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"c0", "+", 
            RowBox[{"c1", " ", "x"}]}], "/.", " ", 
           RowBox[{
            RowBox[{"NMinimize", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Total", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"#", "[", 
