Cell["\<\
Section 2.2:  Import annular table with monodromies and continuation graphics \
if available (not needed for this notebook)\
\>", "Subsection",
 CellChangeTimes->{{3.9829252178238254`*^9, 3.9829252273456984`*^9}, {
  3.9882019431429787`*^9, 3.9882019584143*^9}, {3.989312554539935*^9, 
  3.9893125658968573`*^9}},ExpressionUUID->"a448700c-46f0-4bbf-a47f-\
be697b245c7d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
   "import", " ", "annular", " ", "table", " ", "for", " ", "calcuations"}], 
   "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"FileExistsQ", "[", 
       RowBox[{
       "annularTableWithMonodromiesFileName", "[", "$theTestCase", "]"}], 
       "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "annulusTable", ",", "annulusTableR", ",", "annulusTableReport"}], 
         "}"}], "=", 
        RowBox[{"Import", "[", 
         RowBox[{
         "annularTableWithMonodromiesFileName", "[", "$theTestCase", "]"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"annularResidueTable", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ",", 
            RowBox[{"#", "[", 
             RowBox[{"[", "3", "]"}], "]"}], ",", 
            RowBox[{"#", "[", 
             RowBox[{"[", "6", "]"}], "]"}]}], "}"}], "&"}], "/@", " ", 
         "annulusTableR"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"annularResidueReport", "=", 
        RowBox[{"Prepend", "[", 
         RowBox[{"annularResidueTable", ",", 
          RowBox[{"{", 
           RowBox[{
           "\"\<\!\(\*SubscriptBox[\(a\), \(n\)]\) Index\>\"", ",", 
            "\"\<\!\(\*SubscriptBox[\(s\), \(n\)]\) Index\>\"", ",", 
            "\"\<\!\(\*SubscriptBox[\(a\), \(n\)]\) or \!\(\*SubscriptBox[\(s\
\), \(n\)]\)\>\"", ",", "\"\<Monodromy\>\""}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"monodromyGridReport", "=", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"Labeled", "[", 
           RowBox[{
            RowBox[{"Grid", "[", 
             RowBox[{"annularResidueReport", ",", 
              RowBox[{"Dividers", "\[Rule]", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"{", "True", "}"}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"True", ",", "True", ",", 
                   RowBox[{"{", "False", "}"}], ",", "True"}], "}"}]}], 
                "}"}]}]}], "]"}], ",", 
            RowBox[{"Style", "[", 
             RowBox[{"$theTestCase", ",", "14", ",", "Bold", ",", "Black"}], 
             "]"}], ",", "Top"}], "]"}], ",", "10"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", "monodromyGridReport", "]"}], ";"}], 
      "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"Style", "[", 
         RowBox[{
         "\"\<annular table with monodromies not found\>\"", ",", "Red"}], 
         "]"}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{"import", " ", "figure", " ", "of", " ", "branch", " ", "links"}],
     "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"FileExistsQ", "[", 
       RowBox[{
       "annularTableWithBranchLinksFileName", "[", "$theTestCase", "]"}], 
       "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"annularLinkTable", "=", 
        RowBox[{"Import", "[", 
         RowBox[{
         "annularTableWithBranchLinksFileName", "[", "$theTestCase", "]"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"Show", "[", 
         RowBox[{"annularLinkTable", ",", 
          RowBox[{"ImageSize", "->", "800"}]}], "]"}], "]"}], ";"}], 
      "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"Style", "[", 
         RowBox[{
         "\"\<Annular table with branch links file not found\>\"", ",", 
          "Red"}], "]"}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}],
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "annulusTable", ",", "annulusTableR", ",", "annulusTableReport"}], 
       "}"}], "=", 
      RowBox[{"Import", "[", 
       RowBox[{
       "annularTableWithMonodromiesFileName", "[", "$theTestCase", "]"}], 
       "]"}]}], ";"}], "*)"}], "\[IndentingNewLine]", " ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "annulusTable", ",", "annulusTableR", ",", "annulusTableReport"}], 
       "}"}], "=", 
      RowBox[{"Import", "[", 
       RowBox[{"annularMonodromyTableFileName", "[", "$theTestCase", "]"}], 
       "]"}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"annulusTableReport", "//", "N"}], "//", "MatrixForm"}], " ", 
    "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"maxAnnulus", "=", 
     RowBox[{"annulusTable", "[", 
      RowBox[{"[", 
       RowBox[{
        RowBox[{"-", "1"}], ",", "1"}], "]"}], "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.94040855077966*^9, 3.940408589484033*^9}, {
