            "$acf"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"theZeroList", "=", 
           RowBox[{"DeleteDuplicates", "[", 
            RowBox[{"theZeroPoints", ",", 
             RowBox[{
              RowBox[{
               RowBox[{"Abs", "[", 
                RowBox[{"#1", "-", "#2"}], "]"}], "<", 
               RowBox[{"10", "^", 
                RowBox[{"-", 
                 RowBox[{"(", "duplicateError", ")"}]}]}]}], "&"}]}], "]"}]}],
           ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"zeroIndexes", "=", 
           RowBox[{"Flatten", "[", "\[IndentingNewLine]", 
            RowBox[{"Table", "[", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"dif", "=", 
