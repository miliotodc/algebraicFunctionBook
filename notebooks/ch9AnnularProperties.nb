Cell[CellGroupData[{

Cell["getSingTableIndexes", "Subsection",
 CellChangeTimes->{{3.9147456537242537`*^9, 
  3.914745664221779*^9}},ExpressionUUID->"dbbf54e2-0470-4cc4-841a-\
9de7eb2171c4"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"getSingTableIndexes", "[", 
    RowBox[{"singTable_", ",", "annulus_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "singMembers", ",", "singIndexes", ",", "annulusIndex", ",", "return"}],
       "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"annulus", ">", 
          RowBox[{"Length", "@", "theAnnuli"}]}], " ", "||", " ", 
         RowBox[{"annulus", "<", "0"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"Style", "[", 
           RowBox[{"\"\<Annulus number out of range!\>\"", ",", "Red"}], 
           "]"}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"return", "=", 
          RowBox[{"-", "1"}]}], ";"}], "\[IndentingNewLine]", ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"annulusIndex", "=", 
          RowBox[{"singTableAnnulusIndexes", "[", 
           RowBox[{"[", "annulus", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"annulus", "==", 
            RowBox[{"Length", "@", "theAnnuli"}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"singIndexes", "=", 
             RowBox[{"{", 
              RowBox[{"-", "1"}], "}"}]}], ";"}], "\[IndentingNewLine]", ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"singMembers", "=", 
             RowBox[{"ringMemberSingularIndexes", "[", 
              RowBox[{"[", "annulus", "]"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"singIndexes", "=", 
             RowBox[{"singTableSingIndexes", "[", 
              RowBox[{"[", "singMembers", "]"}], "]"}]}], ";"}]}], 
          "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"return", "=", 
          RowBox[{"{", 
           RowBox[{"annulusIndex", ",", "singIndexes"}], "}"}]}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", "return"}]}],
     "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]"}]], "Input",
