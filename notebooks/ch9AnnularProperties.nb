    " ", "Property", " ", "9.2", ".2"}], "\[IndentingNewLine]", "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Options", "[", "getAnnularIntegrations", "]"}], "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<ndSolveWP\>\"", "->", "MachinePrecision"}], ",", 
       RowBox[{"\"\<intWP\>\"", "->", "MachinePrecision"}], ",", 
       RowBox[{"\"\<polish\>\"", "->", "False"}], ",", 
       RowBox[{"\"\<polishPrec\>\"", "->", "50"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"integralData", "=", 
