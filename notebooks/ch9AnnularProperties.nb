Cell[CellGroupData[{

Cell["Section 7.4.4:  Check alpha-domain power expansions", "Subsubsection",
 CellChangeTimes->{{3.9830064695230775`*^9, 3.9830064787213144`*^9}, 
   3.9830076177795744`*^9},ExpressionUUID->"e38f6900-e12c-4b93-93a9-\
0ec4e21f64a4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{"check", " ", "alpha"}], "-", 
    RowBox[{
    "domain", " ", "power", " ", "expansions", " ", "at", " ", "test", " ", 
     "point"}]}], "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"zTest", "=", 
     RowBox[{"alphaContourF", "[", 
      RowBox[{"2", " ", 
       RowBox[{"Pi", "/", "14"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"zTest", "//", "N"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"expansionResults", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", " ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"branchF", "[", "z_", "]"}], "=", 
         RowBox[{"Plus", "@@", 
          RowBox[{"alphaSeriesSet", "[", 
           RowBox[{"[", 
            RowBox[{"branchIndex", ",", "2", ",", "All", ",", "4"}], "]"}], 
           "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Precision of \>\"", ",", 
          RowBox[{"alphaMonodromyList", "[", 
           RowBox[{"[", "branchIndex", "]"}], "]"}], ",", "\"\< series: \>\"",
           ",", 
          RowBox[{"Precision", "@", 
           RowBox[{"branchF", "[", "z", "]"}]}]}], "]"}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"branchVal", "=", 
         RowBox[{"branchF", "[", 
          RowBox[{"zTest", "-", "translateFactor"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"wVals", "=", 
         RowBox[{"w", "/.", 
          RowBox[{"NSolve", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"$theFunction", "==", "0"}], "/.", 
             RowBox[{"z", "->", "zTest"}]}], ",", "w", ",", 
            RowBox[{"WorkingPrecision", "->", "100"}]}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"difArray", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"#", "-", "branchVal"}], "]"}], "&"}], "/@", " ", 
          "wVals"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"dPos", "=", 
         RowBox[{
          RowBox[{"Position", "[", 
           RowBox[{"difArray", ",", 
            RowBox[{"Min", "@", "difArray"}]}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"\"\<Value of w(z): \>\"", ",", 
            RowBox[{
             RowBox[{"wVals", "[", 
              RowBox[{"[", "dPos", "]"}], "]"}], "//", "N"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<Series value:  \>\"", ",", 
            RowBox[{"branchVal", "//", "N"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<Error: \>\"", ",", 
            RowBox[{
             RowBox[{"difArray", "[", 
              RowBox[{"[", "dPos", "]"}], "]"}], "//", "N"}]}], "]"}], ";"}], 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"alphaMonodromyList", "[", 
           RowBox[{"[", "branchIndex", "]"}], "]"}], ",", 
          RowBox[{"branchVal", "//", "N"}], ",", 
          RowBox[{
           RowBox[{"wVals", "[", 
            RowBox[{"[", "dPos", "]"}], "]"}], "//", "N"}], ",", 
          RowBox[{"-", 
           RowBox[{
            RowBox[{"MantissaExponent", "[", 
             RowBox[{"difArray", "[", 
              RowBox[{"[", "dPos", "]"}], "]"}], "]"}], "[", 
            RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"branchIndex", ",", "1", ",", 
         RowBox[{"Length", "@", "alphaSeriesSet"}]}], "}"}]}], 
