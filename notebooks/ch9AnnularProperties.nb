                    "\"\<Verification of theZeroPoints roots exceeded the \
$maxRootVerifyDifference\>\"", ",", "Red", ",", "Bold"}], "]"}], "]"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"Print", "[", 
                    RowBox[{"\"\<   maxDif: \>\"", ",", 
                    RowBox[{"N", "[", 
                    RowBox[{"maxDif", ",", "20"}], "]"}]}], "]"}], ";"}]}], 
                    "\[IndentingNewLine]", "]"}], ";"}]}], 
                 "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
                RowBox[{"zeroPrecision", "=", 
                 RowBox[{"Floor", "@", 
                  RowBox[{"Precision", "@", "theZeroPoints"}]}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"duplicateError", "=", 
                 RowBox[{
                  RowBox[{"Min", "[", 
                   RowBox[{"zeroPrecision", ",", "singPrecision"}], "]"}], 
                  "-", "$acf"}]}], ";", "\[IndentingNewLine]", 
                RowBox[{"theZeroList", "=", 
                 RowBox[{"DeleteDuplicates", "[", 
                  RowBox[{"theZeroPoints", ",", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "[", 
                    RowBox[{"#1", "-", "#2"}], "]"}], "<", 
                    RowBox[{"10", "^", 
                    RowBox[{"-", 
                    RowBox[{"(", "duplicateError", ")"}]}]}]}], "&"}]}], 
                  "]"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], 
            "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
            RowBox[{
