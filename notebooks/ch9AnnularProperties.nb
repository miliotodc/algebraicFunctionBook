Cell[CellGroupData[{

Cell["\<\
Section 3.1: Compute poles, pole perimeters and illustrate poles\
\>", "Subsection",
 CellChangeTimes->{{3.982995014416424*^9, 
  3.982995047733093*^9}},ExpressionUUID->"68822211-8ac8-4d45-9b83-\
a7fc5ce36034"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{"generate", " ", "polar", " ", "perimters"}], " ", 
   "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Pole indexes: \>\"", ",", "$poleIndexes"}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "@", "$poleIndexes"}], ">", "1"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"nearestPole", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"NearestTo", "[", 
              RowBox[{"#1", ",", "2"}], "]"}], "[", 
             RowBox[{"$theSingularList", "[", 
              RowBox[{"[", "$poleIndexes", "]"}], "]"}], "]"}], "&"}], "/@", 
           " ", 
           RowBox[{"$theSingularList", "[", 
            RowBox[{"[", "$poleIndexes", "]"}], "]"}]}], ")"}], "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"nearestDistArray", "=", 
        RowBox[{"MapThread", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"#1", "-", "#2"}], "]"}], "&"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"$theSingularList", "[", 
             RowBox[{"[", "$poleIndexes", "]"}], "]"}], ",", "nearestPole"}], 
           "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"poleRadiusArray", "=", 
        RowBox[{"MapThread", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"3", "/", "4"}], 
            RowBox[{"Abs", "[", 
             RowBox[{"#1", "-", "#2"}], "]"}]}], "&"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"$theSingularList", "[", 
             RowBox[{"[", "$poleIndexes", "]"}], "]"}], ",", "nearestPole"}], 
           "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", " ", 
       RowBox[{"theSings", "=", "$theSingularList"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"thePoles", "=", 
        RowBox[{"$theSingularList", "[", 
         RowBox[{"[", "$poleIndexes", "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"theRingList", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"Abs", "[", "#", "]"}], "&"}], "/@", " ", "theSings"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"maxX", "=", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"$theSingularList", "[", 
           RowBox[{"[", 
