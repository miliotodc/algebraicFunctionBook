Cell[CellGroupData[{

Cell["getSingularMonodromy", "Subsection",
 CellChangeTimes->{{3.9292797409201126`*^9, 
  3.9292797439821234`*^9}},ExpressionUUID->"7a244c8c-30a6-4e7d-b721-\
70dba94de988"],

Cell[BoxData[""], "Input",
 CellChangeTimes->{{3.942052015107275*^9, 3.9420520192311363`*^9}},
 CellLabel->
  "In[198]:=",ExpressionUUID->"e176a9f8-a4ec-4e35-91be-a7dd265d9405"],

Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
   "get", " ", "differential", " ", "monodromy", " ", "around", " ", "a", " ",
     "singular", " ", "point"}], "\[IndentingNewLine]", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Options", "[", "getSingularMonodromy", "]"}], "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<nSolveWP\>\"", "->", "50"}], ",", 
       RowBox[{"\"\<integrateWP\>\"", "->", "50"}], ",", 
       RowBox[{"\"\<polishWP\>\"", "->", "20"}], ",", 
       RowBox[{"\"\<diagFlag\>\"", "->", "False"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"getSingularMonodromy", "[", 
     RowBox[{"theSingularPoint_", ",", "rNorm_", ",", 
      RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "z0", ",", "singularRoots", ",", "wArray", ",", "branchVals", ",", 
        "polishedVals", ",", "pArray", ",", "theCycles", ",", "theLinks", ",",
         "oneCycles", ",", "finalCycles"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"\"\<nSolveWP: \>\"", ",", 
         RowBox[{"OptionValue", "[", "\"\<nSolveWP\>\"", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"z0", "=", 
        RowBox[{"theSingularPoint", "+", 
         RowBox[{"rNorm", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"I", " ", "$thetaV"}], "]"}]}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<z0: \>\"", ",", 
         RowBox[{"z0", "//", "N"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"singularRoots", "=", 
        RowBox[{"Sort", "[", 
         RowBox[{"w", "/.", 
          RowBox[{"NSolve", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"$theFunction", "==", "0"}], "/.", 
             RowBox[{"z", "->", "z0"}]}], ",", "w", ",", 
            RowBox[{"WorkingPrecision", "->", 
             RowBox[{"OptionValue", "[", "\"\<nSolveWP\>\"", "]"}]}]}], 
           "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"wArray", "=", 
        RowBox[{"MapThread", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"#1", ",", "#2"}], "}"}], "&"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Range", "[", 
             RowBox[{"Length", "@", "singularRoots"}], "]"}], ",", 
            "singularRoots"}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", " ", 
       RowBox[{"branchVals", "=", 
        RowBox[{"integrateOverSheet", "[", 
         RowBox[{
         "z0", ",", "theSingularPoint", ",", "$thetaV", ",", "wArray", ",", 
          "rNorm", ",", "False", ",", 
          RowBox[{"OptionValue", "[", "\"\<integrateWP\>\"", "]"}]}], "]"}]}],
        ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"polishedVals", "=", 
        RowBox[{"polishBranchTerms", "[", 
         RowBox[{"z0", ",", "branchVals", ",", 
          RowBox[{"OptionValue", "[", "\"\<polishWP\>\"", "]"}]}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"OptionValue", "[", "\"\<diagFlag\>\"", "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"\"\<polishedVals: \>\"", ",", 
            RowBox[{
             RowBox[{"polishedVals", "//", "N"}], "//", "MatrixForm"}]}], 
           "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"pArray", "=", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Position", "[", 
            RowBox[{
             RowBox[{"polishedVals", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
             RowBox[{"x_", "/;", 
              RowBox[{
               RowBox[{"Abs", "[", 
                RowBox[{"x", "-", "#"}], "]"}], "<", 
               RowBox[{"10", "^", 
                RowBox[{"-", "20"}]}]}]}]}], "]"}], "&"}], "/@", " ", 
          RowBox[{"polishedVals", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "3"}], "]"}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"theCycles", "=", 
        RowBox[{"PermutationCycles", "[", "pArray", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"theLinks", "=", 
        RowBox[{"theCycles", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"oneCycles", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"{", "#", "}"}], "&"}], "/@", 
         RowBox[{"Complement", "[", 
          RowBox[{
           RowBox[{"Range", "[", "functionDegree", "]"}], ",", 
           RowBox[{"Flatten", "[", "theLinks", "]"}]}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"finalCycles", "=", 
        RowBox[{"Join", "[", 
         RowBox[{"theLinks", ",", "oneCycles"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Sort", "[", 
           RowBox[{"Flatten", "@", "finalCycles"}], "]"}], "!=", 
          RowBox[{"Range", "[", 
           RowBox[{"Length", "@", 
            RowBox[{"Flatten", "@", "finalCycles"}]}], "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"Style", "[", 
            RowBox[{
            "\"\<Monodromy is not consistent!\>\"", ",", "Purple", ",", 
             "14"}], "]"}], "]"}], ";"}], "\[IndentingNewLine]", ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"Style", "[", 
            RowBox[{"\"\<Monodromy is consistent\>\"", ",", 
             RowBox[{"Darker", "@", "Green"}], ",", "12"}], "]"}], "]"}], 
          ";"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"finalCycles", ",", "polishedVals"}], "}"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.9292797337343035`*^9, 3.929279734077978*^9}, {
   3.929342083325768*^9, 3.9293420903241653`*^9}, {3.929343498732478*^9, 
   3.9293435064184375`*^9}, {3.9418018388072977`*^9, 3.941801846071035*^9}, {
   3.9418242960168495`*^9, 3.9418243077962246`*^9}, {3.9420486651052327`*^9, 
   3.94204870195494*^9}, {3.942049346155344*^9, 3.942049386317704*^9}, {
   3.942049424495587*^9, 3.9420494477551637`*^9}, {3.9420495848315716`*^9, 
   3.9420495942667103`*^9}, {3.9420496458635263`*^9, 3.942049652471054*^9}, {
   3.942049801154135*^9, 3.94204980580906*^9}, {3.942049909189849*^9, 
   3.9420499593032446`*^9}, 3.942050355737525*^9, {3.942050410146138*^9, 
   3.942050567247981*^9}, {3.9420506312169647`*^9, 3.942050668317066*^9}, {
   3.942050890873011*^9, 3.9420509651674705`*^9}, {3.942051078999349*^9, 
   3.9420510793430147`*^9}, 3.982663907417045*^9},
 CellLabel->
  "In[199]:=",ExpressionUUID->"daadc0db-5a4a-4584-bf70-4aecd428e59a"]
}, Closed]],

Cell[CellGroupData[{

Cell["integrateOverSheet", "Subsection",
 CellChangeTimes->{{3.928684164266532*^9, 3.928684167187718*^9}, {
  3.9290869223801203`*^9, 
  3.92908692511351*^9}},ExpressionUUID->"169624ec-155e-4e5d-bb3b-\
f8da42ed24b4"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"integrateOverSheet", "[", 
      RowBox[{
      "startPoint_", ",", "singPoint_", ",", "startTheta_", ",", "w0Table_", 
       ",", "radius_", ",", "stiffnessFlag_", ",", "wp_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "intTable", ",", "integrationPath", ",", "wDeriv", ",", "theSol", ",",
          "w0"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"PrintTemporary", "[", 
         RowBox[{"\"\<Integrating index \>\"", ",", 
          RowBox[{"Dynamic", "@", "np"}]}], "]"}], ";", "\[IndentingNewLine]",
         " ", 
        RowBox[{"intTable", "=", 
         RowBox[{"Table", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"np", "=", "n"}], ";", "\[IndentingNewLine]", 
            RowBox[{"w0", "=", 
             RowBox[{"w0Table", "[", 
              RowBox[{"[", 
               RowBox[{"n", ",", "2"}], "]"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"integrationPath", "[", "t_", "]"}], ":=", 
             RowBox[{"singPoint", "+", 
              RowBox[{"radius", " ", 
               RowBox[{"Exp", "[", 
                RowBox[{"I", " ", "t"}], "]"}]}]}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"wDeriv", "=", 
             RowBox[{
              RowBox[{
               RowBox[{"w", "'"}], "[", "t", "]"}], "\[Equal]", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"-", 
                   RowBox[{"(", 
                    FractionBox[
                    RowBox[{"D", "[", 
                    RowBox[{"$theFunction", ",", "z"}], "]"}], 
                    RowBox[{"D", "[", 
                    RowBox[{"$theFunction", ",", "w"}], "]"}]], ")"}]}], " ", 
                  RowBox[{"D", "[", 
                   RowBox[{
                    RowBox[{"integrationPath", "[", "t", "]"}], ",", "t"}], 
                   "]"}]}], ")"}], "/.", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"w", "\[Rule]", 
                   RowBox[{"w", "[", "t", "]"}]}], ",", 
                  RowBox[{"z", "\[Rule]", 
                   RowBox[{"integrationPath", "[", "t", "]"}]}]}], "}"}]}], 
               ")"}]}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{"stiffnessFlag", ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"theSol", "=", 
                RowBox[{"NDSolveValue", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"wDeriv", ",", 
                    RowBox[{
                    RowBox[{"w", "[", "startTheta", "]"}], "\[Equal]", 
                    "w0"}]}], "}"}], ",", "w", ",", 
                  RowBox[{"{", 
                   RowBox[{"t", ",", "startTheta", ",", 
                    RowBox[{"startTheta", "+", 
                    RowBox[{"2", " ", "Pi"}]}]}], "}"}], ",", 
                  RowBox[{"MaxSteps", "\[Rule]", "2000000"}], ",", 
                  RowBox[{"MaxStepSize", "\[Rule]", 
                   RowBox[{"1", "/", "1000"}]}], ",", 
                  RowBox[{"WorkingPrecision", "\[Rule]", "wp"}], ",", 
                  RowBox[{"Method", " ", "\[Rule]", " ", 
                   RowBox[{"{", 
                    RowBox[{"\"\<StiffnessSwitching\>\"", ",", 
                    RowBox[{"\"\<NonstiffTest\>\"", "->", "False"}]}], 
                    "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", ",", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"theSol", "=", 
                RowBox[{"NDSolveValue", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"wDeriv", ",", 
                    RowBox[{
                    RowBox[{"w", "[", "startTheta", "]"}], "\[Equal]", 
                    "w0"}]}], "}"}], ",", "w", ",", 
                  RowBox[{"{", 
                   RowBox[{"t", ",", "startTheta", ",", 
                    RowBox[{"startTheta", "+", 
                    RowBox[{"2", " ", "Pi"}]}]}], "}"}], ",", 
                  RowBox[{"MaxSteps", "\[Rule]", "2000000"}], ",", 
                  RowBox[{"MaxStepSize", "\[Rule]", 
                   RowBox[{"1", "/", "1000"}]}], ",", 
                  RowBox[{"WorkingPrecision", "\[Rule]", "wp"}]}], "]"}]}], 
               ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", " ", 
             RowBox[{"save", " ", 
              RowBox[{"{", 
               RowBox[{"seriesIndex", ",", 
                RowBox[{"theSol", "[", "1", "]"}]}], "}"}]}], " ", "*)"}], 
            "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"w0Table", "[", 
               RowBox[{"[", 
                RowBox[{"n", ",", "1"}], "]"}], "]"}], ",", 
              RowBox[{"w0Table", "[", 
               RowBox[{"[", 
                RowBox[{"n", ",", "2"}], "]"}], "]"}], ",", 
              RowBox[{"theSol", "[", 
               RowBox[{"startTheta", "+", 
                RowBox[{"2", " ", "Pi"}]}], "]"}]}], "}"}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"n", ",", "1", ",", 
             RowBox[{"Length", "@", "w0Table"}]}], "}"}]}], 
          "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
        "intTable"}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.9286838213459244`*^9, 3.9286839392565193`*^9}, {
   3.9286841128720884`*^9, 3.9286841486608524`*^9}, {3.928684232611039*^9, 
   3.9286842335795593`*^9}, {3.929084593686824*^9, 3.9290848555961757`*^9}, {
   3.9290859738261375`*^9, 3.9290859819628334`*^9}, {3.9290862342670207`*^9, 
   3.929086245699602*^9}, {3.929086348124322*^9, 3.9290863808600035`*^9}, {
   3.9290870777677464`*^9, 3.9290870869044385`*^9}, 3.929087707984293*^9, 
   3.9291146791399455`*^9, {3.929114948749776*^9, 3.929114965683237*^9}, {
   3.9291150118745146`*^9, 3.9291150522709885`*^9}, {3.947345168343041*^9, 
   3.9473451938995028`*^9}, {3.9826606993028207`*^9, 3.9826607027749577`*^9}},
 CellLabel->
  "In[201]:=",ExpressionUUID->"1157e61d-3470-47da-9d46-8ac7efed8877"]
}, Closed]],

Cell[CellGroupData[{

Cell["singularBranchIntegrals", "Subsection",
 CellChangeTimes->{{3.9473462796251574`*^9, 
  3.9473462829372683`*^9}},ExpressionUUID->"3f3cf756-1ec7-4502-bf28-\
24210f07e119"],

Cell[BoxData[
 RowBox[{"   ", 
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
   "compute", " ", "integrals", " ", "over", " ", "all", " ", "branches", " ",
     "around", " ", "this", " ", "singular", " ", "point"}], 
   "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Options", "[", "singularBranchIntegrals", "]"}], "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<ndSolveWP\>\"", "->", "50"}], ",", 
       RowBox[{"\"\<integrateWP\>\"", "->", "50"}], ",", 
       RowBox[{"\"\<polishWP\>\"", "->", "20"}], ",", 
       RowBox[{"\"\<polish\>\"", "->", "False"}], ",", 
       RowBox[{"\"\<accGoal\>\"", "->", "20"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"singularBranchIntegrals", "[", 
      RowBox[{"theSingularIndex_", ",", "baseBranchTypeArray_", ",", 
       RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "tStart", ",", "theZ", ",", "wVals", ",", "intTable", ",", 
         "branchSize", ",", "tEnd", ",", "w0", ",", "wDeriv", ",", "theSol", 
         ",", "intVal"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"tStart", "=", "$thetaV"}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"theZ", "[", "t_", "]"}], ":=", 
         RowBox[{
          RowBox[{"$theSingularList", "[", 
           RowBox[{"[", "theSingularIndex", "]"}], "]"}], "+", 
          RowBox[{
           RowBox[{"$minRadiusArray", "[", 
            RowBox[{"[", "theSingularIndex", "]"}], "]"}], 
           RowBox[{"Exp", "[", 
            RowBox[{"I", " ", "t"}], "]"}]}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"wVals", "=", 
         RowBox[{"Sort", "[", 
          RowBox[{"w", "/.", 
           RowBox[{"NSolve", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"$theFunction", "==", "0"}], "/.", 
              RowBox[{"z", "->", 
               RowBox[{"theZ", "[", "tStart", "]"}]}]}], ",", "w"}], "]"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"intTable", "=", 
         RowBox[{"Table", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"branchSize", "=", 
             RowBox[{"Length", "@", 
              RowBox[{"baseBranchTypeArray", "[", 
               RowBox[{"[", 
                RowBox[{"n", ",", "2"}], "]"}], "]"}]}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"tEnd", "=", 
             RowBox[{"tStart", "+", 
              RowBox[{"2", " ", "Pi", " ", "branchSize"}]}]}], ";", 
            "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"w0", "=", 
             RowBox[{"wVals", "[", 
              RowBox[{"[", 
               RowBox[{"baseBranchTypeArray", "[", 
                RowBox[{"[", 
                 RowBox[{"n", ",", "2", ",", "1"}], "]"}], "]"}], "]"}], 
              "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"wDeriv", "=", 
             RowBox[{
              RowBox[{
               RowBox[{"w", "'"}], "[", "t", "]"}], "\[Equal]", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"-", 
                   RowBox[{"(", 
                    FractionBox[
                    RowBox[{"D", "[", 
                    RowBox[{"$theFunction", ",", "z"}], "]"}], 
                    RowBox[{"D", "[", 
                    RowBox[{"$theFunction", ",", "w"}], "]"}]], ")"}]}], " ", 
                  RowBox[{"D", "[", 
                   RowBox[{
                    RowBox[{"theZ", "[", "t", "]"}], ",", "t"}], "]"}]}], 
                 ")"}], "/.", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"w", "\[Rule]", 
                   RowBox[{"w", "[", "t", "]"}]}], ",", 
                  RowBox[{"z", "\[Rule]", 
                   RowBox[{"theZ", "[", "t", "]"}]}]}], "}"}]}], ")"}]}]}], 
            ";", "\[IndentingNewLine]", 
            RowBox[{"theSol", "=", 
             RowBox[{"NDSolveValue", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"wDeriv", ",", 
                 RowBox[{
                  RowBox[{"w", "[", "tStart", "]"}], "\[Equal]", "w0"}]}], 
                "}"}], ",", "w", ",", 
               RowBox[{"{", 
                RowBox[{"t", ",", "tStart", ",", "tEnd"}], "}"}], ",", 
               RowBox[{"MaxSteps", "\[Rule]", "2000000"}], ",", 
               RowBox[{"MaxStepSize", "\[Rule]", 
                RowBox[{"1", "/", "1000"}]}], ",", 
               RowBox[{"WorkingPrecision", "\[Rule]", 
                RowBox[{"OptionValue", "[", "\"\<ndSolveWP\>\"", "]"}]}]}], 
              "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"Print", "[", 
             RowBox[{"\"\<Precision of NDSolve solution: \>\"", ",", 
              RowBox[{"Precision", "@", "theSol"}]}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"OptionValue", "[", "\"\<polish\>\"", "]"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"intVal", "=", 
                RowBox[{"NIntegrate", "[", " ", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"polishContour", "[", 
                    RowBox[{"t", ",", "theZ", ",", "$implicitF", ",", 
                    RowBox[{"theSol", "[", "t", "]"}], ",", 
                    RowBox[{"OptionValue", "[", "\"\<polishWP\>\"", "]"}]}], 
                    "]"}], 
                   RowBox[{"D", "[", 
                    RowBox[{
                    RowBox[{"theZ", "[", "t", "]"}], ",", "t"}], "]"}]}], ",", 
                  RowBox[{"{", 
                   RowBox[{"t", ",", "tStart", ",", "tEnd"}], "}"}], ",", 
                  RowBox[{"WorkingPrecision", "->", 
                   RowBox[{"OptionValue", "[", "\"\<integrateWP\>\"", "]"}]}],
                   ",", 
                  RowBox[{"MaxRecursion", "->", "Infinity"}], ",", 
                  RowBox[{"AccuracyGoal", "->", 
                   RowBox[{"OptionValue", "[", "\"\<accGoal\>\"", "]"}]}]}], 
                 "]"}]}], ";"}], "\[IndentingNewLine]", ",", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"intVal", "=", 
