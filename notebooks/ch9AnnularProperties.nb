Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"    ", 
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
   "Generate", " ", "summatory", " ", "plot", " ", "using", " ", "sum", " ", 
    "of", " ", "branch", " ", "series"}], "\[IndentingNewLine]", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"sPSeriesPlot", "=", 
    RowBox[{"ParametricPlot3D", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Re", "@", "z"}], ",", 
         RowBox[{"Im", "@", "z"}], ",", 
         RowBox[{"Re", "@", 
          RowBox[{"summatorySeriesF", "[", "z", "]"}]}]}], "}"}], "/.", 
       RowBox[{"z", "->", 
        RowBox[{"r", " ", 
         RowBox[{"Exp", "[", 
          RowBox[{"I", " ", "t"}], "]"}]}]}]}], ",", 
      RowBox[{"{", 
       RowBox[{"r", ",", "innerR", ",", "outerR"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", 
        RowBox[{"-", "Pi"}], ",", "Pi"}], "}"}], ",", 
      RowBox[{"BoxRatios", "->", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "1", ",", " ", "1"}], "}"}]}], ",", 
      RowBox[{"AxesEdge", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", 
           RowBox[{"-", "1"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", 
           RowBox[{"-", "1"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", 
           RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], ",", 
      RowBox[{"AxesLabel", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{"\"\<Re[z]\>\"", ",", "12", ",", "Bold", ",", "Black"}], 
          "]"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{"\"\<Im[z]\>\"", ",", "12", ",", "Bold", ",", "Black"}], 
          "]"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{"\"\<Re(sF(z))\>\"", ",", "12", ",", "Bold", ",", "Black"}],
           "]"}]}], "}"}]}], ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"{", "Green", "}"}]}]}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"summatoryPlotRange", "=", 
     RowBox[{"PlotRange", "[", "summatoryPlot", "]"}]}], ";"}], 
   "\[IndentingNewLine]"}]}]], "Input",
