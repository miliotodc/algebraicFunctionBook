      RowBox[{"Accuracy", "@", "integralResult"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"maxAnnulus", "=", 
     RowBox[{"annulusTable", "[", 
      RowBox[{"[", 
