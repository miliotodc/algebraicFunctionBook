Cell[CellGroupData[{

Cell["Section 7.2.3:  Compute integral over summatory function", \
"Subsubsection",
 CellChangeTimes->{{3.962447315984684*^9, 3.9624473227308965`*^9}, {
  3.982924075794281*^9, 
  3.9829240786053367`*^9}},ExpressionUUID->"67ac7a8d-3266-4ead-a4b7-\
19b1fbf5d124"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"branchContourF", "[", "t_", "]"}], ":=", 
     RowBox[{
      RowBox[{"annularCenters", "[", 
       RowBox[{"[", "$property931Annulus", "]"}], "]"}], " ", 
      RowBox[{"Exp", "[", 
       RowBox[{"I", " ", "t"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"branchContourF", "[", "t", "]"}], "//", "N"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"summatoryIntegral", "=", " ", 
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"nSumF", "[", " ", 
         RowBox[{
          RowBox[{"branchContourF", "[", "t", "]"}], ",", 
          RowBox[{"\"\<sumWP\>\"", "->", "$polishPrecision931"}]}], "]"}], 
        " ", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"branchContourF", "[", "t", "]"}], ",", "t"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", 
         RowBox[{"-", "Pi"}], ",", "Pi"}], "}"}], ",", 
       RowBox[{"WorkingPrecision", "->", "$polishPrecision931"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<summatoryIntegral: \>\"", ",", 
      RowBox[{"summatoryIntegral", "//", "N"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<sum of the branch integrals: \>\"", ",", 
      RowBox[{"summatoryIntegral", "//", "N"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{"now", " ", "find", " ", "enclosed", " ", "poles"}], " ", 
    "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"$property931Annulus", "<", "maxAnnulus"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"aIndex", ",", "sIndexes"}], "}"}], "=", 
        RowBox[{"getSingTableIndexes", "[", 
         RowBox[{"annulusTable", ",", "$property931Annulus"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"upperBoundarySPs", "=", 
        RowBox[{"annulusTable", "[", 
         RowBox[{"[", 
          RowBox[{"sIndexes", ",", "2"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"enclosedPoleIndexes", "=", 
        RowBox[{"Select", "[", 
         RowBox[{"$poleIndexes", ",", 
          RowBox[{
           RowBox[{"#", "<", 
            RowBox[{"upperBoundarySPs", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], "&"}]}], "]"}]}], ";"}], 
      "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"enclosedPoleIndexes", "=", "$poleIndexes"}], ";"}]}], 
     "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{
     "\"\<Annulus \>\"", ",", "$property931Annulus", ",", 
      "\"\< is enclosing pole indexes \>\"", ",", "enclosedPoleIndexes"}], 
     "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"selectedElements", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"poleResidueTable", ",", 
       RowBox[{
        RowBox[{"MemberQ", "[", 
         RowBox[{"enclosedPoleIndexes", ",", 
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "&"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"residueResult", "=", 
     RowBox[{"2", " ", "Pi", " ", "I", " ", 
      RowBox[{"Plus", "@@", 
       RowBox[{"selectedElements", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "3"}], "]"}], "]"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "  ", 
   RowBox[{"latexErrorString", "=", 
    RowBox[{"colorAccuracyReport3", "[", 
     RowBox[{
     "residueResult", ",", "branchSum", ",", "summatoryIntegral", ",", "Im", 
      ",", "50", ",", "\"\<Exact val\>\"", ",", "\"\<Branch integrals\>\"", 
      ",", "\"\<Summatory integral:\>\""}], "]"}]}]}]}]], "Input",
 CellChangeTimes->CompressedData["
