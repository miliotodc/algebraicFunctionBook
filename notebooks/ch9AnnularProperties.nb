Cell[CellGroupData[{

Cell["Section 3:  Compute pole data", "Section",
 CellChangeTimes->{{3.9462060075635786`*^9, 3.9462060118750353`*^9}, {
  3.946540147980442*^9, 3.946540152369563*^9}, {3.946567700667042*^9, 
  3.946567719178482*^9}, {3.9466409393892536`*^9, 3.946640942169843*^9}, {
  3.946886524164296*^9, 3.9468865251173773`*^9}, {3.9469732352886753`*^9, 
  3.946973236304244*^9}, {3.946973390386864*^9, 3.946973390652252*^9}, {
  3.960281967928231*^9, 3.960281969566403*^9}, {3.960620371548587*^9, 
