        RowBox[{"getSingTableIndexes", "[", 
         RowBox[{"annulusTable", ",", "annularIndex"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"currentAnnuli", "=", 
        RowBox[{"annulusTable", "[", 
         RowBox[{"[", 
          RowBox[{"aIndex", ",", "3"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "adjust", " ", "annulus", " ", "bounds", " ", "for", " ", "plotting", 
         " ", "to", " ", "avoid", " ", "getting", " ", "too", " ", "close", 
         " ", "to", " ", "singular", " ", "points"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"newRadiiTable", "=", 
        RowBox[{"Array", "[", 
         RowBox[{
          RowBox[{"#", "&"}], ",", 
          RowBox[{"{", 
           RowBox[{"OptionValue", "[", "\"\<radialSegments\>\"", "]"}], "}"}],
           ",", "currentAnnuli"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"newRadiiTable", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "=", 
        RowBox[{
         RowBox[{"newRadiiTable", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"newRadiiTable", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "-", 
            RowBox[{"newRadiiTable", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "/", "10"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"newRadiiTable", "[", 
         RowBox[{"[", 
          RowBox[{"-", "1"}], "]"}], "]"}], "=", 
