      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"z", "^", "14"}], "+", 
         RowBox[{"z", "^", "20"}]}], ")"}], " ", 
       RowBox[{"w", "^", "5"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"z", "^", "5"}], "+", 
         RowBox[{"z", "^", "9"}]}], ")"}], " ", 
       RowBox[{"w", "^", "9"}]}], "+", 
      RowBox[{
