       " ", "\[IndentingNewLine]", 
       RowBox[{"rootIndex", "=", 
        RowBox[{"currentMonodromyList", "[", 
         RowBox[{"[", 
          RowBox[{"branchNum", ",", "1"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
