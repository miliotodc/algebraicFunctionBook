  3.9827464516143975`*^9}},ExpressionUUID->"226ddbda-0941-4946-b693-\
13f0bf2e98a9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"theAnnulusTable", "=", "annulusTable"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"precisionVal", "=", "$phiPrecision"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"1", "<=", "$firstAnnulus", "<=", 
      RowBox[{"Length", "@", "theAnnuli"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"aIndex", ",", "sIndex"}], "}"}], "=", 
       RowBox[{"getSingTableIndexes", "[", 
        RowBox[{"annulusTable", ",", "$firstAnnulus"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"$selectedMonodromyList", "=", 
       RowBox[{"annulusTable", "[", 
        RowBox[{"[", 
         RowBox[{"aIndex", ",", "6"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"Style", "[", 
        RowBox[{"\"\<Analyzing first annulus\>\"", ",", "Blue", ",", "14"}], 
        "]"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"branchData1", "=", 
       RowBox[{"Table", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"$selectedBranch", "=", 
           RowBox[{"$selectedMonodromyList", "[", 
            RowBox[{"[", "monodromyIndex", "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"$selectedBranchSize", "=", 
           RowBox[{"Length", "@", 
            RowBox[{"$selectedMonodromyList", "[", 
             RowBox[{"[", "monodromyIndex", "]"}], "]"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{"\"\<Analyzing annular index \>\"", ",", "Blue"}], "]"}],
             ",", "$firstAnnulus", ",", "\"\< branch \>\"", ",", 
            "$selectedBranch"}], "]"}], ";", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
          RowBox[{"annulusDomain", "=", 
           RowBox[{"Rationalize", "[", 
            RowBox[{
             RowBox[{"annulusTable", "[", 
              RowBox[{"[", 
               RowBox[{"aIndex", ",", "3"}], "]"}], "]"}], ",", "0"}], 
            "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<Annulus: \>\"", ",", 
            RowBox[{"annulusDomain", "//", "N"}]}], "]"}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"theAnnulus", "=", 
           RowBox[{"theAnnulusTable", "[", 
            RowBox[{"[", 
             RowBox[{"aIndex", ",", "3"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"rNorm", "=", 
           RowBox[{"annulusTable", "[", 
            RowBox[{"[", 
             RowBox[{"aIndex", ",", "4"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"tStart", "=", "$thetaV"}], ";", "\[IndentingNewLine]", 
          RowBox[{"tEnd", "=", " ", 
           RowBox[{"tStart", "+", 
            RowBox[{"2", " ", "Pi", " ", "$selectedBranchSize"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<tStart: \>\"", ",", 
            RowBox[{"tStart", "//", "N"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<tEnd: \>\"", ",", 
            RowBox[{"tEnd", "//", "N"}]}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", "\[IndentingNewLine]", " ", 
           RowBox[{"get", " ", "medial", " ", "contour"}], 
           "\[IndentingNewLine]", "*)"}], " ", "\[IndentingNewLine]", " ", 
          RowBox[{"rationalRNorm", "=", 
           RowBox[{"Rationalize", "[", 
            RowBox[{"rNorm", ",", 
             RowBox[{"10", "^", 
              RowBox[{"-", "25"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
            "tStart", ",", "tEnd", ",", "rNorm", ",", "lowPrecMedialSol", ",",
              "$selectedBranchSize"}], "}"}], "=", 
           RowBox[{"generateMedialContour", "[", 
            RowBox[{
            "annulusTable", ",", "$firstAnnulus", ",", "monodromyIndex", ",", 
             "precisionVal", ",", 
             RowBox[{"1", "/", "2"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<prec: \>\"", ",", 
            RowBox[{"Precision", "@", "lowPrecMedialSol"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", "\[IndentingNewLine]", " ", 
           RowBox[{"get", " ", "branch", " ", "expansions"}], 
           "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
          RowBox[{"t0", "=", "$thetaV"}], ";", "\[IndentingNewLine]", 
          RowBox[{"t1", "=", 
           RowBox[{"t0", "+", 
            RowBox[{"2", " ", "Pi", " ", "$selectedBranchSize"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"intervalArray", "=", 
           RowBox[{"Array", "[", 
            RowBox[{
             RowBox[{"#", "&"}], ",", 
             RowBox[{"$partitionSize", "+", "1"}], ",", 
             RowBox[{"{", 
              RowBox[{"t0", ",", "t1"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"thePartitions", "=", 
           RowBox[{"Partition", "[", 
            RowBox[{"intervalArray", ",", "2", ",", "1"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"termRange", "=", 
           RowBox[{"{", 
            RowBox[{"$coefficientPower", " ", "$selectedBranchSize"}], 
            "}"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"lowPrecAnalyticTerms", "=", 
           RowBox[{"Table", "[", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"Print", "[", "k", "]"}], ";", "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"k", "==", "0"}], ",", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"finalIntVal", "=", 
                  RowBox[{"Plus", "@@", 
                   RowBox[{"Table", "[", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"NIntegrate", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"lowPrecMedialSol", "[", "t", "]"}], 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Cos", "[", 
                    RowBox[{"t", " ", 
                    RowBox[{"k", "/", "$selectedBranchSize"}]}], "]"}], "-", 
                    RowBox[{"I", " ", 
                    RowBox[{"Sin", "[", 
                    RowBox[{"t", " ", 
                    RowBox[{"k", "/", "$selectedBranchSize"}]}], "]"}]}]}], 
                    ")"}]}], ",", 
                    RowBox[{"{", 
                    RowBox[{"t", ",", 
                    RowBox[{"thePartitions", "[", 
                    RowBox[{"[", 
                    RowBox[{"index", ",", "1"}], "]"}], "]"}], ",", 
                    RowBox[{"thePartitions", "[", 
                    RowBox[{"[", 
                    RowBox[{"index", ",", "2"}], "]"}], "]"}]}], "}"}], ",", 
                    RowBox[{"Method", "->", 
                    RowBox[{"{", 
                    RowBox[{"\"\<GlobalAdaptive\>\"", ",", 
                    RowBox[{"\"\<MaxErrorIncreases\>\"", "->", "600"}], ",", 
                    RowBox[{"Method", "->", "\"\<GaussKronrodRule\>\""}]}], 
                    "}"}]}], ",", 
                    RowBox[{"WorkingPrecision", "->", "precisionVal"}], ",", 
                    RowBox[{"AccuracyGoal", "->", 
                    RowBox[{"precisionVal", "/", "2"}]}], ",", 
                    RowBox[{"MaxRecursion", "->", "Infinity"}]}], "]"}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{"{", 
                    RowBox[{"index", ",", "1", ",", 
                    RowBox[{"Length", "@", "thePartitions"}]}], "}"}]}], 
                    "\[IndentingNewLine]", "]"}]}]}], ";"}], 
                "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"finalIntVal", "=", 
                  RowBox[{"Plus", "@@", 
                   RowBox[{"Table", "[", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"NIntegrate", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"lowPrecMedialSol", "[", "t", "]"}], 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Cos", "[", 
                    RowBox[{"t", " ", 
                    RowBox[{"k", "/", "$selectedBranchSize"}]}], "]"}], "-", 
                    RowBox[{"I", " ", 
                    RowBox[{"Sin", "[", 
                    RowBox[{"t", " ", 
                    RowBox[{"k", "/", "$selectedBranchSize"}]}], "]"}]}]}], 
                    ")"}]}], ",", 
                    RowBox[{"{", 
                    RowBox[{"t", ",", 
                    RowBox[{"thePartitions", "[", 
                    RowBox[{"[", 
                    RowBox[{"index", ",", "1"}], "]"}], "]"}], ",", 
                    RowBox[{"thePartitions", "[", 
                    RowBox[{"[", 
                    RowBox[{"index", ",", "2"}], "]"}], "]"}]}], "}"}], ",", 
                    RowBox[{"Method", "->", 
                    RowBox[{"{", 
                    RowBox[{"\"\<GlobalAdaptive\>\"", ",", 
                    RowBox[{"\"\<MaxErrorIncreases\>\"", "->", "600"}], ",", 
                    RowBox[{"Method", "->", "\"\<LevinRule\>\""}]}], "}"}]}], 
                    ",", 
                    RowBox[{"WorkingPrecision", "->", "precisionVal"}], ",", 
                    RowBox[{"AccuracyGoal", "->", 
                    RowBox[{"precisionVal", "/", "2"}]}], ",", 
                    RowBox[{"MaxRecursion", "->", "Infinity"}]}], "]"}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{"{", 
                    RowBox[{"index", ",", "1", ",", 
                    RowBox[{"Length", "@", "thePartitions"}]}], "}"}]}], 
                    "\[IndentingNewLine]", "]"}]}]}], ";"}]}], 
               "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
              RowBox[{"coef", "=", 
               RowBox[{
                FractionBox["1", 
                 RowBox[{"2", " ", "Pi", " ", "$selectedBranchSize", " ", 
                  RowBox[{"rNorm", "^", 
                   RowBox[{"(", 
                    RowBox[{"k", "/", "$selectedBranchSize"}], ")"}]}]}]], 
                "finalIntVal"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"k", "/", "$selectedBranchSize"}], ",", "coef", ",", 
                RowBox[{"N", "[", 
                 RowBox[{"coef", ",", "10"}], "]"}], ",", 
                RowBox[{"coef", " ", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"z", "^", 
                    RowBox[{"(", 
                    RowBox[{"1", "/", "$selectedBranchSize"}], ")"}]}], ")"}],
                   "^", "k"}]}]}], "}"}]}], ",", "\[IndentingNewLine]", 
             RowBox[{"{", 
              RowBox[{"k", ",", "termRange"}], "}"}]}], "\[IndentingNewLine]",
             "]"}]}], ";", "\n", " ", 
          RowBox[{"(*", "\[IndentingNewLine]", " ", 
           RowBox[{"extract", " ", "residue"}], "\[IndentingNewLine]", "*)"}],
           "\[IndentingNewLine]", 
          RowBox[{"powerSeries", "=", 
           RowBox[{"Plus", "@@", 
            RowBox[{"lowPrecAnalyticTerms", "[", 
