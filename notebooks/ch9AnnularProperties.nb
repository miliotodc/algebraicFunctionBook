 RowBox[{
  RowBox[{"theFileName", "=", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{"datadir", ",", "testCase", ",", "\"\<sumLSeries.m\>\""}], "}"}],
     "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"FileExistsQ", "[", "theFileName", "]"}], ",", " ", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"alphaSeriesSet", "=", 
      RowBox[{"Import", "[", "theFileName", "]"}]}], ";", " ", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"Precision", "@", 
       RowBox[{"alphaSeriesSet", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "2", ",", "All", ",", "4"}], "]"}], "]"}]}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{
       RowBox[{"alphaSeriesSet", "[", 
        RowBox[{"[", 
         RowBox[{"1", ";;", "5"}], "]"}], "]"}], "//", "N"}], "]"}], ";"}], 
    "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Print", "[", 
      RowBox[{"Style", "[", 
       RowBox[{
        RowBox[{"theFileName", "<>", "\"\< not found during import.\>\""}], 
        ",", "Red"}], "]"}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], 
