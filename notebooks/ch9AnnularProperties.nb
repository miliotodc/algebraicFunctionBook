Cell[CellGroupData[{

Cell["\<\
Section 7.6.3:  Re-create summatory function for testCase0001 and plot in \
alpha domain\
\>", "Subsection",
 CellChangeTimes->{{3.9830258958464093`*^9, 3.983025903104905*^9}, {
  3.983026864069888*^9, 3.983026866819508*^9}, {3.983028499222658*^9, 
  3.9830285398857327`*^9}},ExpressionUUID->"98e8aef5-9555-4ba5-bb9b-\
ef086f09e231"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{"create", " ", "summatory", " ", "function"}], 
   "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Options", "[", "nSumF", "]"}], "=", 
     RowBox[{"{", 
      RowBox[{"\"\<sumWP\>\"", "->", "MachinePrecision"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"nSumF", "[", 
      RowBox[{
       RowBox[{"z_", "?", "NumericQ"}], ",", 
       RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
     RowBox[{"Plus", "@@", 
      RowBox[{"(", 
       RowBox[{"w", "/.", 
        RowBox[{"NSolve", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"$implicitF", "[", 
            RowBox[{"z", ",", "w"}], "]"}], "==", "0"}], ",", "w", ",", 
          RowBox[{"WorkingPrecision", "->", 
           RowBox[{"OptionValue", "[", "\"\<sumWP\>\"", "]"}]}]}], "]"}]}], 
       ")"}]}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nSumFPlot", "=", " ", 
     RowBox[{"ParametricPlot3D", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Re", "@", "z"}], ",", 
          RowBox[{"Im", "@", "z"}], ",", 
          RowBox[{"Re", "@", 
           RowBox[{"nSumF", "[", "z", "]"}]}]}], "}"}], "/.", 
        RowBox[{"z", "->", 
         RowBox[{"translateFactor", "+", 
          RowBox[{"r", " ", 
           RowBox[{"Exp", "[", 
            RowBox[{"I", " ", "t"}], "]"}]}]}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", "innerR", ",", "outerR"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", 
         RowBox[{"2", " ", "Pi"}]}], "}"}], ",", 
       RowBox[{"BoxRatios", "->", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "1", ",", " ", "1"}], "}"}]}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nPlotRange", "=", 
     RowBox[{"PlotRange", "@", "nSumFPlot"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"plotN", "=", " ", 
    RowBox[{"Show", "[", 
     RowBox[{"nSumFPlot", ",", 
      RowBox[{"BoxRatios", "->", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "1", ",", " ", "1"}], "}"}]}], ",", 
      RowBox[{"PlotStyle", "->", "LightBlue"}], ",", 
      RowBox[{"AxesEdge", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", 
           RowBox[{"-", "1"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", 
           RowBox[{"-", "1"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", 
           RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], ",", 
      RowBox[{"AxesLabel", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{"\"\<Re[z]\>\"", ",", "12", ",", "Bold", ",", "Black"}], 
          "]"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{"\"\<Im[z]\>\"", ",", "12", ",", "Bold", ",", "Black"}], 
          "]"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{"\"\<N\>\"", ",", "12", ",", "Bold", ",", "Black"}], 
          "]"}]}], "}"}]}], ",", 
      RowBox[{"FaceGrids", "->", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "0", ",", 
            RowBox[{"-", "1"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Array", "[", 
             RowBox[{
              RowBox[{"#", "&"}], ",", 
              RowBox[{"{", "5", "}"}], ",", 
              RowBox[{"nPlotRange", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ",", 
            RowBox[{"Array", "[", 
             RowBox[{
              RowBox[{"#", "&"}], ",", 
              RowBox[{"{", "5", "}"}], ",", 
              RowBox[{"nPlotRange", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], "}"}]}], "}"}], 
        "}"}]}], ",", 
      RowBox[{"FaceGridsStyle", "\[Rule]", 
       RowBox[{"Directive", "[", 
        RowBox[{"Black", ",", "Dashed"}], "]"}]}], ",", 
      RowBox[{"ViewPoint", "->", 
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"-", "5"}], ",", "2"}], "}"}]}], ",", 
      RowBox[{"ImageSize", "->", "300"}]}], "]"}]}]}]}]], "Input",
