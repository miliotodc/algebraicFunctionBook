              RowBox[{"All", ",", 
               RowBox[{"-", "1"}]}], "]"}], "]"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<powerSeries: \>\"", ",", 
            RowBox[{"powerSeries", "//", "N"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"$selectedBranch", ",", 
            RowBox[{"Coefficient", "[", 
             RowBox[{"powerSeries", ",", "z", ",", "$coefficientPower"}], 
