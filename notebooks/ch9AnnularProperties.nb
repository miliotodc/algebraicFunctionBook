       RowBox[{
        RowBox[{"{", 
         RowBox[{"rMin", ",", "rMax"}], "}"}], "=", 
        RowBox[{"newRadiiTable", "[", 
         RowBox[{"[", 
          RowBox[{"{", 
           RowBox[{"1", ",", 
            RowBox[{"-", "1"}]}], "}"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"currentMonodromyList", "=", 
        RowBox[{"annulusTable", "[", 
