Cell[CellGroupData[{

Cell["Analyze a set of annuli in an annular group", "Subsubsection",
 CellChangeTimes->{{3.9623687236212916`*^9, 3.9623687316043687`*^9}, {
  3.974288295302742*^9, 
  3.974288300129154*^9}},ExpressionUUID->"42268c70-f2d8-4420-a2c3-\
f8b1d13867cf"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"annulusIndexStart", "=", "5"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"annulusIndexEnd", "=", "8"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"phiTable", "=", 
    RowBox[{"Table", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"aIndex", ",", "sIndex"}], "}"}], "=", 
        RowBox[{"getSingTableIndexes", "[", 
         RowBox[{"annulusTable", ",", "annulusIndex"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"$selectedMonodromyList", "=", 
        RowBox[{"annulusTable", "[", 
         RowBox[{"[", 
          RowBox[{"aIndex", ",", "6"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"branchData", "=", 
        RowBox[{"Table", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"$selectedBranch", "=", 
            RowBox[{"$selectedMonodromyList", "[", 
             RowBox[{"[", "monodromyIndex", "]"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"$selectedBranchSize", "=", 
            RowBox[{"Length", "@", 
             RowBox[{"$selectedMonodromyList", "[", 
              RowBox[{"[", "monodromyIndex", "]"}], "]"}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{
             RowBox[{"Style", "[", 
              RowBox[{"\"\<Analyzing annular index \>\"", ",", "Blue"}], 
              "]"}], ",", "annulusIndex", ",", "\"\< branch \>\"", ",", 
             "$selectedBranch"}], "]"}], ";", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"annulusDomain", "=", 
            RowBox[{"Rationalize", "[", 
             RowBox[{
              RowBox[{"annulusTable", "[", 
               RowBox[{"[", 
                RowBox[{"aIndex", ",", "3"}], "]"}], "]"}], ",", "0"}], 
             "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<Annulus: \>\"", ",", 
             RowBox[{"annulusDomain", "//", "N"}]}], "]"}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"theAnnulus", "=", 
            RowBox[{"theAnnulusTable", "[", 
             RowBox[{"[", 
              RowBox[{"aIndex", ",", "3"}], "]"}], "]"}]}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"rNorm", "=", 
            RowBox[{"annulusTable", "[", 
             RowBox[{"[", 
              RowBox[{"aIndex", ",", "4"}], "]"}], "]"}]}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"tStart", "=", "$thetaV"}], ";", "\[IndentingNewLine]", 
           RowBox[{"tEnd", "=", " ", 
            RowBox[{"tStart", "+", 
             RowBox[{"2", " ", "Pi", " ", "$selectedBranchSize"}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<tStart: \>\"", ",", 
             RowBox[{"tStart", "//", "N"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<tEnd: \>\"", ",", 
             RowBox[{"tEnd", "//", "N"}]}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"(*", "\[IndentingNewLine]", " ", 
            RowBox[{"get", " ", "medial", " ", "contour"}], 
            "\[IndentingNewLine]", "*)"}], " ", "\[IndentingNewLine]", " ", 
           RowBox[{"rationalRNorm", "=", 
            RowBox[{"Rationalize", "[", 
             RowBox[{"rNorm", ",", 
              RowBox[{"10", "^", 
               RowBox[{"-", "25"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"precisionVal", "=", "MachinePrecision"}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
             "tStart", ",", "tEnd", ",", "rNorm", ",", "lowPrecMedialSol", 
              ",", "$selectedBranchSize"}], "}"}], "=", 
            RowBox[{"generateMedialContour", "[", 
             RowBox[{
             "annulusTable", ",", "annulusIndex", ",", "monodromyIndex", ",", 
              "precisionVal", ",", 
              RowBox[{"1", "/", "2"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<prec: \>\"", ",", 
             RowBox[{"Precision", "@", "lowPrecMedialSol"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", "\[IndentingNewLine]", " ", 
            RowBox[{"get", " ", "branch", " ", "expansions"}], 
            "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", " ", 
           RowBox[{"numPart", "=", "1"}], ";", "\[IndentingNewLine]", 
           RowBox[{"t0", "=", "$thetaV"}], ";", "\[IndentingNewLine]", 
           RowBox[{"t1", "=", 
            RowBox[{"t0", "+", 
             RowBox[{"2", " ", "Pi", " ", "$selectedBranchSize"}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"intervalArray", "=", 
            RowBox[{"Array", "[", 
             RowBox[{
              RowBox[{"#", "&"}], ",", 
              RowBox[{"numPart", "+", "1"}], ",", 
              RowBox[{"{", 
               RowBox[{"t0", ",", "t1"}], "}"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"thePartitions", "=", 
            RowBox[{"Partition", "[", 
             RowBox[{"intervalArray", ",", "2", ",", "1"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"termRange", "=", 
            RowBox[{"{", 
             RowBox[{"$coefficientPower", " ", "$selectedBranchSize"}], 
             "}"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"lowPrecAnalyticTerms", "=", 
            RowBox[{"Table", "[", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"Print", "[", "k", "]"}], ";", "\[IndentingNewLine]", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"k", "==", "0"}], ",", "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"finalIntVal", "=", 
                   RowBox[{"Plus", "@@", 
                    RowBox[{"Table", "[", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"NIntegrate", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"lowPrecMedialSol", "[", "t", "]"}], 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Cos", "[", 
                    RowBox[{"t", " ", 
                    RowBox[{"k", "/", "$selectedBranchSize"}]}], "]"}], "-", 
                    RowBox[{"I", " ", 
                    RowBox[{"Sin", "[", 
                    RowBox[{"t", " ", 
                    RowBox[{"k", "/", "$selectedBranchSize"}]}], "]"}]}]}], 
                    ")"}]}], ",", 
                    RowBox[{"{", 
                    RowBox[{"t", ",", 
                    RowBox[{"thePartitions", "[", 
                    RowBox[{"[", 
                    RowBox[{"index", ",", "1"}], "]"}], "]"}], ",", 
                    RowBox[{"thePartitions", "[", 
                    RowBox[{"[", 
                    RowBox[{"index", ",", "2"}], "]"}], "]"}]}], "}"}], ",", 
                    RowBox[{"Method", "->", 
                    RowBox[{"{", 
                    RowBox[{"\"\<GlobalAdaptive\>\"", ",", 
                    RowBox[{"\"\<MaxErrorIncreases\>\"", "->", "600"}], ",", 
                    RowBox[{"Method", "->", "\"\<GaussKronrodRule\>\""}]}], 
                    "}"}]}], ",", 
                    RowBox[{"WorkingPrecision", "->", "precisionVal"}], ",", 
                    RowBox[{"AccuracyGoal", "->", 
                    RowBox[{"precisionVal", "/", "2"}]}], ",", 
                    RowBox[{"MaxRecursion", "->", "Infinity"}]}], "]"}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{"{", 
                    RowBox[{"index", ",", "1", ",", 
                    RowBox[{"Length", "@", "thePartitions"}]}], "}"}]}], 
                    "\[IndentingNewLine]", "]"}]}]}], ";"}], 
                 "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"finalIntVal", "=", 
                   RowBox[{"Plus", "@@", 
                    RowBox[{"Table", "[", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"NIntegrate", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"lowPrecMedialSol", "[", "t", "]"}], 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Cos", "[", 
                    RowBox[{"t", " ", 
                    RowBox[{"k", "/", "$selectedBranchSize"}]}], "]"}], "-", 
                    RowBox[{"I", " ", 
                    RowBox[{"Sin", "[", 
                    RowBox[{"t", " ", 
                    RowBox[{"k", "/", "$selectedBranchSize"}]}], "]"}]}]}], 
                    ")"}]}], ",", 
                    RowBox[{"{", 
                    RowBox[{"t", ",", 
                    RowBox[{"thePartitions", "[", 
                    RowBox[{"[", 
                    RowBox[{"index", ",", "1"}], "]"}], "]"}], ",", 
                    RowBox[{"thePartitions", "[", 
                    RowBox[{"[", 
                    RowBox[{"index", ",", "2"}], "]"}], "]"}]}], "}"}], ",", 
                    RowBox[{"Method", "->", 
                    RowBox[{"{", 
                    RowBox[{"\"\<GlobalAdaptive\>\"", ",", 
                    RowBox[{"\"\<MaxErrorIncreases\>\"", "->", "600"}], ",", 
                    RowBox[{"Method", "->", "\"\<LevinRule\>\""}]}], "}"}]}], 
                    ",", 
                    RowBox[{"WorkingPrecision", "->", "precisionVal"}], ",", 
                    RowBox[{"AccuracyGoal", "->", 
                    RowBox[{"precisionVal", "/", "2"}]}], ",", 
                    RowBox[{"MaxRecursion", "->", "Infinity"}]}], "]"}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{"{", 
                    RowBox[{"index", ",", "1", ",", 
                    RowBox[{"Length", "@", "thePartitions"}]}], "}"}]}], 
                    "\[IndentingNewLine]", "]"}]}]}], ";"}]}], 
                "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
               RowBox[{"coef", "=", 
                RowBox[{
                 FractionBox["1", 
                  RowBox[{"2", " ", "Pi", " ", "$selectedBranchSize", " ", 
                   RowBox[{"rNorm", "^", 
                    RowBox[{"(", 
                    RowBox[{"k", "/", "$selectedBranchSize"}], ")"}]}]}]], 
                 "finalIntVal"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"k", "/", "$selectedBranchSize"}], ",", "coef", ",", 
                 RowBox[{"N", "[", 
                  RowBox[{"coef", ",", "10"}], "]"}], ",", 
                 RowBox[{"coef", " ", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"z", "^", 
                    RowBox[{"(", 
                    RowBox[{"1", "/", "$selectedBranchSize"}], ")"}]}], ")"}],
                    "^", "k"}]}]}], "}"}]}], ",", "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{"k", ",", "termRange"}], "}"}]}], 
             "\[IndentingNewLine]", "]"}]}], ";", "\n", " ", 
           RowBox[{"(*", "\[IndentingNewLine]", " ", 
            RowBox[{"extract", " ", "residue"}], "\[IndentingNewLine]", 
            "*)"}], "\[IndentingNewLine]", 
           RowBox[{"powerSeries", "=", 
            RowBox[{"Plus", "@@", 
             RowBox[{"lowPrecAnalyticTerms", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", 
                RowBox[{"-", "1"}]}], "]"}], "]"}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<powerSeries: \>\"", ",", 
             RowBox[{"powerSeries", "//", "N"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"$selectedBranchSize", ",", 
             RowBox[{"Coefficient", "[", 
              RowBox[{"powerSeries", ",", "z", ",", "$coefficientPower"}], 
              "]"}], " ", ",", 
             RowBox[{
              RowBox[{"Coefficient", "[", 
               RowBox[{"powerSeries", ",", "z", ",", "$coefficientPower"}], 
               "]"}], " ", "$selectedBranchSize"}]}], "}"}]}], 
          "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"monodromyIndex", ",", "1", ",", 
            RowBox[{"Length", "@", "$selectedMonodromyList"}]}], "}"}]}], 
         "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"annularPhi", "=", 
        RowBox[{
         RowBox[{"Plus", "@@", 
          RowBox[{"branchData", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "3"}], "]"}], "]"}]}], "//", "N"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{"\"\<annularPhi for annulus \>\"", ",", "14", ",", "Red"}], 
          "]"}], ",", "annulusIndex", ",", "\"\<: \>\"", ",", "annularPhi"}], 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"annulusIndex", ",", "annularPhi"}], "}"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
       "annulusIndex", ",", "annulusIndexStart", ",", "annulusIndexEnd"}], 
       "}"}]}], "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]"}], "Input",
