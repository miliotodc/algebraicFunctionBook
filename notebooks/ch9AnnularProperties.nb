Section 9.10.5:  Other summatory funtion plot and summatorySeries plots\
\>", "Subsection",
 CellChangeTimes->{{3.9641584242342196`*^9, 3.9641584387108016`*^9}, {
  3.9641627118773737`*^9, 3.9641627322220173`*^9}, {3.964162797432654*^9, 
  3.9641628035999503`*^9}, {3.964162836502821*^9, 
  3.9641628405747414`*^9}},ExpressionUUID->"d7b3a4d0-4d37-4420-9cc5-\
1aa04422d05b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"     ", 
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
   "Generate", " ", "summatory", " ", "plot", " ", "from", " ", "sum", " ", 
    "of", " ", "the", " ", "integer", " ", "powers", " ", "of", " ", "branch",
     " ", "series"}], "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"summatoryBranchSumSeriesPlot", "=", 
    RowBox[{"ParametricPlot3D", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Re", "@", 
          RowBox[{"(", 
           RowBox[{"z", "+", "translateFactor"}], ")"}]}], ",", 
         RowBox[{"Im", "@", 
          RowBox[{"(", 
           RowBox[{"z", "+", "translateFactor"}], ")"}]}], ",", 
         RowBox[{"Re", "@", 
          RowBox[{"summatoryBranchSumSeriesF", "[", "z", "]"}]}]}], "}"}], "/.", 
       RowBox[{"z", "->", 
        RowBox[{"r", " ", 
         RowBox[{"Exp", "[", 
          RowBox[{"I", " ", "t"}], "]"}]}]}]}], ",", 
      RowBox[{"{", 
       RowBox[{"r", ",", "innerR", ",", "outerR"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", 
        RowBox[{"-", "Pi"}], ",", "Pi"}], "}"}], ",", 
      RowBox[{"BoxRatios", "->", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "1", ",", " ", "1"}], "}"}]}], ",", 
      RowBox[{"AxesEdge", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", 
           RowBox[{"-", "1"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", 
           RowBox[{"-", "1"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", 
           RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], ",", 
      RowBox[{"AxesLabel", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{"\"\<Re[z]\>\"", ",", "12", ",", "Bold", ",", "Black"}], 
          "]"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{"\"\<Im[z]\>\"", ",", "12", ",", "Bold", ",", "Black"}], 
          "]"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{"\"\<Re(sF(z))\>\"", ",", "12", ",", "Bold", ",", "Black"}],
           "]"}]}], "}"}]}], ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"{", 
        RowBox[{"Darker", "@", "Green"}], "}"}]}]}], "]"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"summatoryPlotRange", "=", 
     RowBox[{"PlotRange", "[", "summatorySeriesPlot", "]"}]}], ";"}], 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.9633999089619703`*^9, 3.963399939365309*^9}, {
