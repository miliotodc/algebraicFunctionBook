Cell[BoxData[
 RowBox[{
  RowBox[{"polyForm", "[", 
   RowBox[{"poly_", ",", "var_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"coeffs", "=", 
      RowBox[{
       RowBox[{"CoefficientRules", "[", 
        RowBox[{"poly", ",", "var"}], "]"}], "//", "Sort"}]}], "}"}], ",", 
    RowBox[{"Interpretation", "[", 
     RowBox[{
      RowBox[{"Row", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{"\"\<(\>\"", ",", 
             RowBox[{"coeff", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", "\"\<)\>\"", ",", 
             RowBox[{
              RowBox[{"var", "^", 
               RowBox[{"coeff", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "1"}], "]"}], "]"}]}], "/.", 
              RowBox[{"1", "\[Rule]", "\"\<\>\""}]}]}], "}"}], "]"}], ",", 
          RowBox[{"{", 
