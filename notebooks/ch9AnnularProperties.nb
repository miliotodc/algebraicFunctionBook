1c2a05352fc6"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Options", "[", "getAnnularIntegrations", "]"}], "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<ndSolveWP\>\"", "->", "MachinePrecision"}], ",", 
       RowBox[{"\"\<intWP\>\"", "->", "MachinePrecision"}], ",", 
       RowBox[{"\"\<polish\>\"", "->", "False"}], ",", 
       RowBox[{"\"\<polishPrec\>\"", "->", "50"}], ",", 
       RowBox[{"\"\<accGoal\>\"", "->", "6"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"getAnnularIntegrations", "[", 
      RowBox[{"annulusTable_", ",", "testAnnulus_", ",", 
       RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "aIndex", ",", "sIndexes", ",", "selectedMonodromies", ",", 
         "theMonodromy", ",", "theBranchSize", ",", "rNorm", ",", "zStart", 
         ",", "wStart", ",", "tStart", ",", "tEnd", ",", "integrationPath", 
         ",", "wDeriv", ",", "theSol"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"aIndex", ",", "sIndexes"}], "}"}], "=", 
         RowBox[{"getSingTableIndexes", "[", 
          RowBox[{"annulusTable", ",", "testAnnulus"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"selectedMonodromies", "=", 
         RowBox[{"annulusTable", "[", 
          RowBox[{"[", 
           RowBox[{"aIndex", ",", "6"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{
         "\"\<selectedMonodromies: \>\"", ",", "selectedMonodromies"}], "]"}],
         ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"Table", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"\"\<Analyzing branch: \>\"", ",", 
             RowBox[{"selectedMonodromies", "[", 
              RowBox[{"[", "monodromyIndex", "]"}], "]"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"theMonodromy", "=", 
            RowBox[{"selectedMonodromies", "[", 
             RowBox[{"[", "monodromyIndex", "]"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"theBranchSize", "=", 
            RowBox[{"Length", "@", "theMonodromy"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"rNorm", ",", "zStart", ",", "wStart"}], "}"}], "=", 
            RowBox[{"getMedialStartVals", "[", 
             RowBox[{
             "annulusTable", ",", "testAnnulus", ",", "monodromyIndex", ",", 
              "$thetaV", ",", "$implicitF"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"tStart", "=", "$thetaV"}], ";", "\[IndentingNewLine]", 
           RowBox[{"tEnd", "=", 
            RowBox[{"$thetaV", "+", 
             RowBox[{"2", " ", "Pi", " ", "theBranchSize"}]}]}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"integrationPath", "[", "t_", "]"}], ":=", 
            RowBox[{"rNorm", " ", 
             RowBox[{"Exp", "[", 
              RowBox[{"I", " ", "t"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"wDeriv", "=", 
            RowBox[{
             RowBox[{
              RowBox[{"w", "'"}], "[", "t", "]"}], "\[Equal]", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"-", 
                  RowBox[{"(", 
                   FractionBox[
                    RowBox[{"D", "[", 
                    RowBox[{"$theFunction", ",", "z"}], "]"}], 
                    RowBox[{"D", "[", 
                    RowBox[{"$theFunction", ",", "w"}], "]"}]], ")"}]}], " ", 
                 RowBox[{"D", "[", 
                  RowBox[{
                   RowBox[{"integrationPath", "[", "t", "]"}], ",", "t"}], 
                  "]"}]}], ")"}], "/.", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"w", "\[Rule]", 
                  RowBox[{"w", "[", "t", "]"}]}], ",", 
                 RowBox[{"z", "\[Rule]", 
                  RowBox[{"integrationPath", "[", "t", "]"}]}]}], "}"}]}], 
              ")"}]}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"theSol", "=", 
            RowBox[{"NDSolveValue", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"wDeriv", ",", 
                RowBox[{
                 RowBox[{"w", "[", "tStart", "]"}], "\[Equal]", "wStart"}]}], 
               "}"}], ",", "w", ",", 
              RowBox[{"{", 
               RowBox[{"t", ",", "tStart", ",", "tEnd"}], "}"}], ",", 
              RowBox[{"MaxSteps", "\[Rule]", "2000000"}], ",", 
              RowBox[{"MaxStepSize", "\[Rule]", 
               RowBox[{"1", "/", "1000"}]}], ",", 
              RowBox[{"WorkingPrecision", "\[Rule]", 
               RowBox[{"OptionValue", "[", "\"\<ndSolveWP\>\"", "]"}]}]}], 
             "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<Precision of NDSolve solution: \>\"", ",", 
             RowBox[{"Precision", "@", "theSol"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"OptionValue", "[", "\"\<polish\>\"", "]"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"NIntegrate", "[", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"polishMedial", "[", 
                 RowBox[{"t", ",", "rNorm", ",", "$implicitF", ",", 
                  RowBox[{"theSol", "[", "t", "]"}], ",", 
                  RowBox[{"OptionValue", "[", "\"\<polishPrec\>\"", "]"}]}], 
                 "]"}], 
                RowBox[{"D", "[", 
                 RowBox[{
                  RowBox[{"integrationPath", "[", "t", "]"}], ",", "t"}], 
                 "]"}]}], ",", 
               RowBox[{"{", 
                RowBox[{"t", ",", "tStart", ",", "tEnd"}], "}"}], ",", 
               RowBox[{"WorkingPrecision", "->", 
                RowBox[{"OptionValue", "[", "\"\<polishPrec\>\"", "]"}]}], 
               ",", 
               RowBox[{"MaxRecursion", "->", "Infinity"}], ",", 
               RowBox[{"AccuracyGoal", "->", 
                RowBox[{"OptionValue", "[", "\"\<accGoal\>\"", "]"}]}]}], 
              "]"}], "\[IndentingNewLine]", 
             RowBox[{"(*", 
              RowBox[{"NIntegrate", "[", " ", 
               RowBox[{
                RowBox[{
                 RowBox[{"polishMedial", "[", 
                  RowBox[{"t", ",", "rNorm", ",", "$implicitF", ",", 
                   RowBox[{"theSol", "[", "t", "]"}], ",", 
                   RowBox[{"OptionValue", "[", "\"\<polishPrec\>\"", "]"}]}], 
                  "]"}], 
                 RowBox[{"D", "[", 
                  RowBox[{
                   RowBox[{"integrationPath", "[", "t", "]"}], ",", "t"}], 
                  "]"}]}], ",", 
                RowBox[{"{", 
                 RowBox[{"t", ",", "tStart", ",", "tEnd"}], "}"}], ",", 
                RowBox[{"Method", "->", 
                 RowBox[{"{", 
                  RowBox[{"\"\<GlobalAdaptive\>\"", ",", 
                   RowBox[{"\"\<MaxErrorIncreases\>\"", "->", "600"}], ",", 
                   RowBox[{"Method", "->", "\"\<GaussKronrodRule\>\""}]}], 
                  "}"}]}], ",", 
                RowBox[{"WorkingPrecision", "->", 
                 RowBox[{"OptionValue", "[", "\"\<polishPrec\>\"", "]"}]}], 
                ",", 
                RowBox[{"MaxRecursion", "->", "Infinity"}], ",", 
                RowBox[{"AccuracyGoal", "->", "30"}]}], "]"}], "*)"}], 
             "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
             RowBox[{"NIntegrate", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"theSol", "[", "t", "]"}], " ", 
                RowBox[{"D", "[", 
                 RowBox[{
                  RowBox[{"integrationPath", "[", "t", "]"}], ",", "t"}], 
                 "]"}]}], ",", 
               RowBox[{"{", 
                RowBox[{"t", ",", "tStart", ",", "tEnd"}], "}"}], ",", 
               RowBox[{"WorkingPrecision", "->", 
                RowBox[{"OptionValue", "[", "\"\<intWP\>\"", "]"}]}], ",", 
               RowBox[{"MaxRecursion", "->", "Infinity"}], ",", 
               RowBox[{"AccuracyGoal", "->", 
                RowBox[{"OptionValue", "[", "\"\<accGoal\>\"", "]"}]}]}], 
              "]"}]}], "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{"NIntegrate", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"theSol", "[", "t", "]"}], " ", 
                RowBox[{"D", "[", 
                 RowBox[{
                  RowBox[{"integrationPath", "[", "t", "]"}], ",", "t"}], 
                 "]"}]}], ",", 
               RowBox[{"{", 
                RowBox[{"t", ",", "tStart", ",", "tEnd"}], "}"}], ",", 
