Cell[CellGroupData[{

Cell["\<\
Section 7.3.4:  Compute summatory function residue and compare to summatory \
integral\
\>", "Subsubsection",
 CellChangeTimes->{{3.9640911829272733`*^9, 3.964091241808175*^9}, 
   3.964091276645216*^9, {3.9829242898453293`*^9, 
   3.9829242917753067`*^9}},ExpressionUUID->"c7fd1eae-841b-4a08-8a51-\
1f580793f347"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
   "compute", " ", "summatory", " ", "function", "  ", "residue", " ", "and", 
    " ", "compare", " ", "to", " ", "summatory", " ", "integral"}], 
   "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"contourRadius", "=", 
     RowBox[{"annularCenters", "[", 
      RowBox[{"[", "$property932Annulus", "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"contourF", "[", "t_", "]"}], ":=", 
     RowBox[{"contourRadius", " ", 
      RowBox[{"Exp", "[", 
       RowBox[{"I", " ", "t"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"theK", "=", 
     RowBox[{"-", "1"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"intVal", "=", " ", 
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"nSumF", "[", 
         RowBox[{
          RowBox[{"contourF", "[", "t", "]"}], ",", 
          RowBox[{"\"\<sumWP\>\"", "->", "$property932Precision"}]}], "]"}], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Cos", "[", 
           RowBox[{"t", " ", "theK"}], "]"}], "-", 
          RowBox[{"I", " ", 
           RowBox[{"Sin", "[", 
            RowBox[{"t", " ", "theK"}], "]"}]}]}], ")"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", 
         RowBox[{"-", "Pi"}], ",", "Pi"}], "}"}], ",", 
       RowBox[{"WorkingPrecision", "->", "$property932Precision"}]}], "]"}]}],
     ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"summatoryResidueTerm", "=", 
     RowBox[{
      FractionBox["1", 
       RowBox[{"2", " ", "Pi", " ", 
        RowBox[{"contourRadius", "^", 
         RowBox[{"(", "theK", ")"}]}]}]], "intVal"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<summatoryResidueTerm: \>\"", ",", 
      RowBox[{"summatoryResidueTerm", "//", "N"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{
    "get", " ", "exact", " ", "value", " ", "from", " ", "pole", " ", 
     "table"}], "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"$property932Annulus", "<", "maxAnnulus"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"aIndex", ",", "sIndexes"}], "}"}], "=", 
        RowBox[{"getSingTableIndexes", "[", 
         RowBox[{"annulusTable", ",", "$property932Annulus"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"upperBoundarySPs", "=", 
        RowBox[{"annulusTable", "[", 
         RowBox[{"[", 
          RowBox[{"sIndexes", ",", "2"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"enclosedPoleIndexes", "=", 
        RowBox[{"Select", "[", 
         RowBox[{"$poleIndexes", ",", 
          RowBox[{
           RowBox[{"#", "<", 
            RowBox[{"upperBoundarySPs", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], "&"}]}], "]"}]}], ";"}], 
      "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"enclosedPoleIndexes", "=", "$poleIndexes"}], ";"}]}], 
     "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{
     "\"\<Annulus \>\"", ",", "$property932Annulus", ",", 
      "\"\< is enclosing pole indexes \>\"", ",", "enclosedPoleIndexes"}], 
     "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"selectedElements", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"poleResidueTable", ",", 
       RowBox[{
        RowBox[{"MemberQ", "[", 
         RowBox[{"enclosedPoleIndexes", ",", 
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "&"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"poleResidueResult", "=", 
     RowBox[{"2", " ", "Pi", " ", "I", " ", 
      RowBox[{"Plus", "@@", 
       RowBox[{"selectedElements", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "3"}], "]"}], "]"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<2PiI times residue: \>\"", ",", 
     RowBox[{"poleResidueResult", "//", "N"}]}], "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<summatoryIntegral: \>\"", ",", 
      RowBox[{"summatoryIntegral", "//", "N"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "  ", 
   RowBox[{"exactValue", "=", 
