Cell["getConjugateMembers", "Subsection",
 CellChangeTimes->{{3.9608894587827463`*^9, 
  3.9608894630549717`*^9}},ExpressionUUID->"e64ce265-b590-4ce6-92f2-\
8b3435d318d4"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"getConjugateMembers", "[", 
    RowBox[{"singularTerms_", ",", "analyticTerms_", ",", "memberIndex_"}], 
    "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "theExp", ",", "cList", ",", "conjSingularTerms", ",", 
       "conjAnalyticTerms"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"theExp", "=", 
       RowBox[{
        RowBox[{"Exponent", "[", 
         RowBox[{"singularTerms", ",", "z", ",", "List"}], "]"}], "//", 
        "Flatten"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"cList", "=", 
       RowBox[{
        RowBox[{"Coefficient", "[", 
         RowBox[{"singularTerms", ",", "z", ",", "theExp"}], "]"}], "//", 
        "Flatten"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"conjSingularTerms", "=", 
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"#1", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Exp", "[", 
              RowBox[{
              "2", " ", "memberIndex", " ", "Pi", " ", "I", " ", "#2"}], 
              "]"}], " ", 
             RowBox[{"z", "^", "#2"}]}], ")"}]}], "&"}], ",", 
         RowBox[{"{", 
          RowBox[{"cList", ",", "theExp"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", " ", 
      RowBox[{"theExp", "=", 
       RowBox[{
        RowBox[{"Exponent", "[", 
         RowBox[{"analyticTerms", ",", "z", ",", "List"}], "]"}], "//", 
        "Flatten"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"cList", "=", 
       RowBox[{
        RowBox[{"Coefficient", "[", 
         RowBox[{"analyticTerms", ",", "z", ",", "theExp"}], "]"}], "//", 
        "Flatten"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"conjAnalyticTerms", "=", 
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"#1", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Exp", "[", 
              RowBox[{
              "2", " ", "memberIndex", " ", "Pi", " ", "I", " ", "#2"}], 
              "]"}], " ", 
             RowBox[{"z", "^", "#2"}]}], ")"}]}], "&"}], ",", 
         RowBox[{"{", 
          RowBox[{"cList", ",", "theExp"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"conjAnalyticTerms", ",", "conjSingularTerms"}], "}"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
