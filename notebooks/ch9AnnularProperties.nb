  3.9829242842830243`*^9}},ExpressionUUID->"04f515ac-b86c-4465-9816-\
ee5c1a575cde"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
   "compute", " ", "summatory", " ", "integral", " ", "over", " ", "selected",
     " ", "annular", " ", "contour"}], "\[IndentingNewLine]", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"$property932Annulus", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"branchContourF", "[", "t_", "]"}], ":=", 
     RowBox[{
      RowBox[{"annularCenters", "[", 
       RowBox[{"[", "$property932Annulus", "]"}], "]"}], " ", 
      RowBox[{"Exp", "[", 
       RowBox[{"I", " ", "t"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"summatoryIntegral", "=", " ", 
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"nSumF", "[", " ", 
         RowBox[{
          RowBox[{"branchContourF", "[", "t", "]"}], ",", 
          RowBox[{"\"\<sumWP\>\"", "->", "$property932Precision"}]}], "]"}], 
        " ", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"branchContourF", "[", "t", "]"}], ",", "t"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", 
         RowBox[{"-", "Pi"}], ",", "Pi"}], "}"}], ",", 
       RowBox[{"WorkingPrecision", "->", "$property932Precision"}]}], "]"}]}],
     ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<summatoryIntegral: \>\"", ",", 
      RowBox[{"summatoryIntegral", "//", "N"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]"}]}]], "Input",
