Cell[CellGroupData[{

Cell["\<\
Section 7.4.8:  Create the additive summatory function and check with sample \
point\
\>", "Subsubsection",
 CellChangeTimes->{{3.982998048267412*^9, 3.9829980622624955`*^9}, {
  3.9829988405859566`*^9, 3.982998845044005*^9}, {3.9830066634575033`*^9, 
  3.983006664866673*^9}},ExpressionUUID->"f7e3dda3-7012-46b4-b327-\
bb0c67bcb0b5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{
    "find", " ", "lagest", " ", "negative", " ", "power", " ", "and", " ", 
     "smallest", " ", "positive", " ", "power", " ", "in", " ", "all", " ", 
     "branch", " ", "expansions", " ", "in", " ", "alpha"}], "-", "domain"}], 
   "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"expTable", "=", 
    RowBox[{"Table", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"series", "=", " ", 
        RowBox[{"Plus", "@@", 
         RowBox[{"alphaSeriesSet", "[", 
          RowBox[{"[", 
           RowBox[{"index", ",", "2", ",", "All", ",", "4"}], "]"}], 
          "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"expList", "=", 
        RowBox[{"Exponent", "[", 
         RowBox[{"series", ",", "z", ",", "List"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"integerPowerList", "=", 
        RowBox[{"Select", "[", 
         RowBox[{"expList", ",", "IntegerQ"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"theMin", "=", 
        RowBox[{"Min", "@", 
         RowBox[{"Select", "[", 
          RowBox[{"integerPowerList", ",", "Negative"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"theMax", "=", 
        RowBox[{"Max", "@", 
         RowBox[{"Select", "[", 
          RowBox[{"integerPowerList", ",", "Positive"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"theMin", ",", "theMax"}], "}"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"index", ",", "1", ",", 
        RowBox[{"Length", "@", "alphaSeriesSet"}]}], "}"}]}], 
     "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Min,max powers: \>\"", ",", "expTable"}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"summatoryExpRange", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Max", "@", 
        RowBox[{"expTable", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ",", 
       RowBox[{"Min", "@", 
        RowBox[{"expTable", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}]}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{
     "\"\<Additive summatory power expansion range: \>\"", ",", 
      "summatoryExpRange"}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{
    "now", " ", "create", " ", "the", " ", "additive", " ", "summatory", " ", 
     "power", " ", "expansion", " ", 
     RowBox[{"aSumF", "[", "z", "]"}]}], "\[IndentingNewLine]", "*)"}], 
   "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{"sPTable", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"pos", "=", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Position", "[", 
             RowBox[{
              RowBox[{"alphaSeriesSet", "[", 
               RowBox[{"[", 
                RowBox[{"index", ",", "2", ",", "All", ",", "1"}], "]"}], 
               "]"}], ",", 
              RowBox[{"z_", "/;", 
               RowBox[{"z", "==", "#"}]}]}], "]"}], "&"}], "/@", " ", 
           RowBox[{"Range", "[", 
            RowBox[{"Sequence", "@@", "summatoryExpRange"}], "]"}]}], "//", 
          "Flatten"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"Length", "@", 
           RowBox[{"alphaMonodromyList", "[", 
            RowBox[{"[", "index", "]"}], "]"}]}], ")"}], 
         RowBox[{"alphaSeriesSet", "[", 
          RowBox[{"[", 
           RowBox[{"index", ",", "2", ",", "pos", ",", "4"}], "]"}], 
          "]"}]}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"index", ",", "1", ",", 
         RowBox[{"Length", "@", "alphaSeriesSet"}]}], "}"}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"aSumF", "[", "z_", "]"}], "=", 
     RowBox[{"Plus", "@@", 
      RowBox[{"(", 
       RowBox[{"sPTable", "//", "Flatten"}], ")"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{
    "check", " ", "additive", " ", "summatory", " ", "power", " ", 
     "expansion", " ", "with", " ", "sum", " ", "of", " ", "wVals", " ", "at",
      " ", "test", " ", "point"}], "\[IndentingNewLine]", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"testP", "=", 
     RowBox[{"alphaContourF", "[", 
      RowBox[{"3", 
       RowBox[{"Pi", "/", "10"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<aSumF result: \>\"", ",", 
      RowBox[{
       RowBox[{"aSumF", "[", 
        RowBox[{"testP", "-", "translateFactor"}], "]"}], "//", "N"}]}], 
     "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wVals", "=", 
     RowBox[{
      RowBox[{"NSolveValues", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"$theFunction", "==", "0"}], "/.", 
         RowBox[{"z", "->", "testP"}]}], ",", "w"}], "]"}], "//", "N"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Sum of wVals at test point: \>\"", ",", 
     RowBox[{"Plus", "@@", "wVals"}]}], "]"}], 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.963388575376581*^9, 3.9633886682092075`*^9}, {
   3.963398754563597*^9, 3.9633987660948935`*^9}, {3.9633988671127048`*^9, 
   3.9633989058364477`*^9}, {3.9641920415998926`*^9, 3.964192065955906*^9}, {
