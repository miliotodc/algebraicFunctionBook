Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"polishMedial", "[", 
    RowBox[{"t", ",", "rNorm", ",", "$implicitF", ",", 
     RowBox[{"theSol", "[", "t", "]"}], ",", "50"}], "]"}], "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"polishMedial", "[", 
     RowBox[{
      RowBox[{"t_", "?", "NumericQ"}], ",", 
      RowBox[{"r_", "?", "NumericQ"}], ",", "implicitF_", ",", 
      RowBox[{"medialVal_", "?", "NumericQ"}], ",", 
      RowBox[{"wPrec_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"w", "/.", 
       RowBox[{"FindRoot", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"implicitF", "[", 
           RowBox[{
            RowBox[{"r", " ", 
             RowBox[{"Exp", "[", 
              RowBox[{"I", " ", "t"}], "]"}]}], ",", "w"}], "]"}], "==", 
          "0"}], ",", 
         RowBox[{"{", 
          RowBox[{"w", ",", "medialVal"}], "}"}], ",", 
         RowBox[{"WorkingPrecision", "->", "wPrec"}], ",", 
         RowBox[{"AccuracyGoal", "->", "wPrec"}], ",", 
         RowBox[{"PrecisionGoal", "->", "wPrec"}]}], "]"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}]}]], "Input",
