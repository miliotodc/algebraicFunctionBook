          RowBox[{"[", 
           RowBox[{"-", "1"}], "]"}], "]"}], "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"newRadiiTable", "[", 
             RowBox[{"[", 
              RowBox[{"-", "2"}], "]"}], "]"}], "-", 
            RowBox[{"newRadiiTable", "[", 
             RowBox[{"[", 
              RowBox[{"-", "1"}], "]"}], "]"}]}], ")"}], "/", "10"}]}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"rNorm", "=", 
        RowBox[{"SetPrecision", "[", 
         RowBox[{
          RowBox[{"annulusTable", "[", 
           RowBox[{"[", 
            RowBox[{"aIndex", ",", "4"}], "]"}], "]"}], ",", 
          RowBox[{"OptionValue", "[", "\"\<workingPrecision\>\"", "]"}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"rNorm", "=", 
          RowBox[{"newRadiiTable", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"radialSegments", "-", "1"}], ")"}], "/", "2"}], "+", 
