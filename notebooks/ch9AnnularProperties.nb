Cell[CellGroupData[{

Cell["strictPolynomialQ", "Subsection",
 CellChangeTimes->{{3.8893602934364414`*^9, 
  3.8893602965138407`*^9}},ExpressionUUID->"41dce0b9-bc6d-46aa-bd6c-\
773d6d28450d"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"strictPolynomialQ", "[", 
     RowBox[{"myPoly_", ",", 
      RowBox[{"{", 
       RowBox[{"x_", ",", "y_"}], "}"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"levels", ",", "cList", ",", "finalList", ",", "return"}], 
       "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"PolynomialQ", "[", 
          RowBox[{"myPoly", ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", "y"}], "}"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"levels", "=", 
           RowBox[{"Level", "[", 
            RowBox[{"myPoly", ",", 
             RowBox[{"{", 
              RowBox[{"-", "1"}], "}"}], ",", 
             RowBox[{"Heads", "->", "True"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Length", "@", 
               RowBox[{"Position", "[", 
                RowBox[{"levels", ",", "x"}], "]"}]}], ">", "0"}], " ", "&&", 
             " ", 
             RowBox[{
              RowBox[{"Length", "@", 
               RowBox[{"Position", "[", 
                RowBox[{"levels", ",", "y"}], "]"}]}], ">", "0"}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"cList", "=", 
              RowBox[{"Complement", "[", 
               RowBox[{"levels", ",", 
                RowBox[{"{", 
                 RowBox[{
                 "Plus", ",", "Power", ",", "Times", ",", "x", ",", "y"}], 
                 "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"finalList", "=", 
              RowBox[{"Complement", "[", 
               RowBox[{"cList", ",", 
                RowBox[{"Select", "[", 
                 RowBox[{"cList", ",", "NumberQ"}], "]"}]}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Length", "@", "finalList"}], ">", "0"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"Print", "[", 
                 RowBox[{
                  RowBox[{"Style", "[", 
                   RowBox[{
                   "\"\<expression is not strict polynomial in \>\"", ",", 
                    "Red"}], "]"}], ",", 
                  RowBox[{"Style", "[", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"x", ",", "y"}], "}"}], ",", "Red"}], "]"}]}], 
                 "]"}], ";", "\[IndentingNewLine]", 
                RowBox[{"return", "=", "False"}], ";"}], 
               "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"return", "=", "True"}], ";"}]}], 
              "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", ",",
             "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{
               RowBox[{"Style", "[", 
                RowBox[{
                "\"\<expression is not strict polynomial in \>\"", ",", 
                 "Red"}], "]"}], ",", 
               RowBox[{"Style", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"x", ",", "y"}], "}"}], ",", "Red"}], "]"}]}], 
              "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"return", "=", "False"}], ";"}]}], "\[IndentingNewLine]",
            "]"}], ";"}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"return", "=", "False"}], ";"}]}], "\[IndentingNewLine]", 
        "]"}], ";", "\[IndentingNewLine]", "return"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.8893602992317033`*^9, 3.8893603006690025`*^9}, {
  3.8893630345963316`*^9, 3.8893630418912425`*^9}, {3.894371500481982*^9, 
  3.8943715009192405`*^9}, {3.8970419131913157`*^9, 3.897041953096331*^9}},
 CellLabel->
  "In[179]:=",ExpressionUUID->"22d64371-9340-4f7b-a89d-8916e3442fef"]
}, Closed]],

Cell[CellGroupData[{

Cell["polishBranchTerms", "Subsection",
 CellChangeTimes->{{3.9291148919187965`*^9, 
  3.9291148946995955`*^9}},ExpressionUUID->"fed3c30e-3b4d-4adc-ba47-\
8f85f1931ab5"],

Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{
   RowBox[{
    RowBox[{"polishBranchTerms", "[", 
     RowBox[{"zVal_", ",", "terms_", ",", "maxErrorTolerance_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "wVals", ",", "polishedValues", ",", "difTable", ",", "pos", ",", 
        "wValsPrec", ",", "termsPrec"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"seriesValues", " ", 
        RowBox[{"format", ":", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"baseSeriesIndexK", ",", " ", "seriesValK"}], "}"}], 
            "..."}], 
           RowBox[{"{", 
            RowBox[{"baseSeriesIndexM", ",", "seriesValM"}], "}"}]}], 
          "}"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"termsPrec", "=", 
        RowBox[{"Floor", "@", 
         RowBox[{"Precision", "@", 
          RowBox[{"terms", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "2"}], "]"}], "]"}]}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"wVals", "=", 
        RowBox[{"w", "/.", 
         RowBox[{"NSolve", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"$theFunction", "==", "0"}], "/.", 
            RowBox[{"z", "->", "zVal"}]}], ",", "w", ",", 
           RowBox[{"WorkingPrecision", "->", "termsPrec"}]}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"polishedValues", "=", 
        RowBox[{"Table", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"difTable", "=", 
            RowBox[{
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{
                RowBox[{"terms", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", "3"}], "]"}], "]"}], "-", "#"}], "]"}], 
              "&"}], "/@", " ", "wVals"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"pos", "=", 
            RowBox[{
             RowBox[{"Position", "[", 
              RowBox[{"difTable", ",", 
               RowBox[{"Min", "@", "difTable"}]}], "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{"difTable", "[", 
                RowBox[{"[", "pos", "]"}], "]"}], "]"}], ">", 
              RowBox[{"10", "^", 
               RowBox[{"(", 
                RowBox[{"-", "maxErrorTolerance"}], ")"}]}]}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Print", "[", 
               RowBox[{"Style", "[", 
                RowBox[{
                "\"\<polishTerms error below $maxErrorTolerance: \>\"", ",", 
                 "Red", ",", "Bold", ",", "14"}], "]"}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"Print", "[", 
               RowBox[{"\"\<     difTable: \>\"", ",", 
                RowBox[{"difTable", "//", "N"}]}], "]"}], ";"}]}], 
            "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"terms", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", 
             RowBox[{"terms", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "2"}], "]"}], "]"}], ",", 
             RowBox[{"wVals", "[", 
              RowBox[{"[", "pos", "]"}], "]"}]}], "}"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{"Length", "@", "terms"}]}], "}"}]}], 
         "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"return", ":", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"seriesIndexK", ",", "polishedValK"}], "}"}], "..."}], 
           RowBox[{"{", 
            RowBox[{"seriesIndexM", ",", "polishedValM"}], "}"}]}], "}"}]}], 
        " ", "*)"}], "\[IndentingNewLine]", "polishedValues"}]}], 
     "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.929114884030032*^9, 3.929114884436383*^9}, {
   3.929115110430355*^9, 3.929115110821054*^9}, 3.9826606707910676`*^9},
 CellLabel->
  "In[180]:=",ExpressionUUID->"7b784f48-7cbf-4aca-adfb-8698377a079c"]
}, Closed]],

Cell[CellGroupData[{

Cell["integrateOverAnnulus", "Subsection",
 CellChangeTimes->{{3.9291224122893615`*^9, 
  3.9291224164758153`*^9}},ExpressionUUID->"363aa795-6f69-4bed-9d32-\
1820c50475e9"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"integrateOverAnnulus", "[", 
      RowBox[{
      "startTheta_", ",", "w0Table_", ",", "radius_", ",", "wp_", ",", 
       "stiffnessFlag_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "intTable", ",", "integrationPath", ",", "wDeriv", ",", "theSol", ",",
          "w0"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"PrintTemporary", "[", 
         RowBox[{"\"\<Integrating index \>\"", ",", 
          RowBox[{"Dynamic", "@", "np"}]}], "]"}], ";", "\[IndentingNewLine]",
         " ", 
        RowBox[{"intTable", "=", 
         RowBox[{"Table", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"np", "=", "n"}], ";", "\[IndentingNewLine]", 
            RowBox[{"w0", "=", 
             RowBox[{"w0Table", "[", 
              RowBox[{"[", 
               RowBox[{"n", ",", "2"}], "]"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"integrationPath", "[", "t_", "]"}], ":=", 
             RowBox[{"radius", " ", 
              RowBox[{"Exp", "[", 
               RowBox[{"I", " ", "t"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"wDeriv", "=", 
             RowBox[{
              RowBox[{
               RowBox[{"w", "'"}], "[", "t", "]"}], "\[Equal]", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"-", 
                   RowBox[{"(", 
                    FractionBox[
                    RowBox[{"D", "[", 
                    RowBox[{"$theFunction", ",", "z"}], "]"}], 
                    RowBox[{"D", "[", 
                    RowBox[{"$theFunction", ",", "w"}], "]"}]], ")"}]}], " ", 
                  RowBox[{"D", "[", 
                   RowBox[{
                    RowBox[{"integrationPath", "[", "t", "]"}], ",", "t"}], 
                   "]"}]}], ")"}], "/.", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"w", "\[Rule]", 
                   RowBox[{"w", "[", "t", "]"}]}], ",", 
                  RowBox[{"z", "\[Rule]", 
                   RowBox[{"integrationPath", "[", "t", "]"}]}]}], "}"}]}], 
               ")"}]}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{"stiffnessFlag", ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"theSol", "=", 
                RowBox[{"NDSolveValue", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"wDeriv", ",", 
                    RowBox[{
                    RowBox[{"w", "[", "startTheta", "]"}], "\[Equal]", 
                    "w0"}]}], "}"}], ",", "w", ",", 
                  RowBox[{"{", 
                   RowBox[{"t", ",", "startTheta", ",", 
                    RowBox[{"startTheta", "+", 
                    RowBox[{"2", " ", "Pi"}]}]}], "}"}], ",", 
                  RowBox[{"MaxSteps", "\[Rule]", "2000000"}], ",", 
                  RowBox[{"MaxStepSize", "\[Rule]", 
                   RowBox[{"1", "/", "1000"}]}], ",", 
                  RowBox[{"WorkingPrecision", "\[Rule]", "wp"}], ",", 
                  RowBox[{"Method", " ", "\[Rule]", " ", 
                   RowBox[{"{", 
                    RowBox[{"\"\<StiffnessSwitching\>\"", ",", 
                    RowBox[{"\"\<NonstiffTest\>\"", "->", "False"}]}], 
                    "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", ",", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"theSol", "=", 
                RowBox[{"NDSolveValue", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"wDeriv", ",", 
                    RowBox[{
                    RowBox[{"w", "[", "startTheta", "]"}], "\[Equal]", 
                    "w0"}]}], "}"}], ",", "w", ",", 
                  RowBox[{"{", 
                   RowBox[{"t", ",", "startTheta", ",", 
                    RowBox[{"startTheta", "+", 
                    RowBox[{"2", " ", "Pi"}]}]}], "}"}], ",", 
                  RowBox[{"MaxSteps", "\[Rule]", "2000000"}], ",", 
                  RowBox[{"MaxStepSize", "\[Rule]", 
                   RowBox[{"1", "/", "1000"}]}], ",", 
                  RowBox[{"WorkingPrecision", "\[Rule]", "wp"}]}], "]"}]}], 
               ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", " ", 
             RowBox[{"save", " ", 
              RowBox[{"{", 
               RowBox[{"seriesIndex", ",", 
                RowBox[{"theSol", "[", "1", "]"}]}], "}"}]}], " ", "*)"}], 
            "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"w0Table", "[", 
               RowBox[{"[", 
                RowBox[{"n", ",", "1"}], "]"}], "]"}], ",", 
              RowBox[{"w0Table", "[", 
               RowBox[{"[", 
                RowBox[{"n", ",", "2"}], "]"}], "]"}], ",", 
              RowBox[{"theSol", "[", 
               RowBox[{"startTheta", "+", 
                RowBox[{"2", " ", "Pi"}]}], "]"}]}], "}"}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"n", ",", "1", ",", 
             RowBox[{"Length", "@", "w0Table"}]}], "}"}]}], 
          "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"\"\<intTable: \>\"", ",", 
            RowBox[{"intTable", "//", "N"}]}], "]"}], ";"}], "*)"}], 
        "\[IndentingNewLine]", "intTable"}]}], "\[IndentingNewLine]", "]"}]}],
     ";"}], "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.929122364473211*^9, 3.929122380781461*^9}, 
   3.9293631706805296`*^9, {3.939825397641531*^9, 3.93982540479572*^9}, 
   3.940318977602786*^9, {3.9418216594127703`*^9, 3.941821725084796*^9}, {
   3.941822138156576*^9, 3.9418221428749576`*^9}, {3.941822185604186*^9, 
   3.9418222473158073`*^9}, {3.9418223638970985`*^9, 3.941822367849762*^9}, {
   3.982660682868001*^9, 3.9826606851788883`*^9}},
 CellLabel->
