Cell[CellGroupData[{

Cell["\<\
Section 7.4.5:  Create nSumF[f] function and its Laurent power expansions\
\>", "Subsubsection",
 CellChangeTimes->{{3.983006509182779*^9, 
  3.983006529361201*^9}},ExpressionUUID->"748f67a7-2518-4d57-ad14-\
b6825801f5dd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{"create", " ", "summatory", " ", "function"}], 
   "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Options", "[", "nSumF", "]"}], "=", 
     RowBox[{"{", 
      RowBox[{"\"\<sumWP\>\"", "->", "MachinePrecision"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"nSumF", "[", 
      RowBox[{
       RowBox[{"z_", "?", "NumericQ"}], ",", 
       RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
     RowBox[{"Plus", "@@", 
      RowBox[{"(", 
       RowBox[{"w", "/.", 
        RowBox[{"NSolve", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"$implicitF", "[", 
            RowBox[{"z", ",", "w"}], "]"}], "==", "0"}], ",", "w", ",", 
          RowBox[{"WorkingPrecision", "->", 
           RowBox[{"OptionValue", "[", "\"\<sumWP\>\"", "]"}]}]}], "]"}]}], 
       ")"}]}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nSumFPlot", "=", " ", 
     RowBox[{"ParametricPlot3D", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Re", "@", "z"}], ",", 
          RowBox[{"Im", "@", "z"}], ",", 
          RowBox[{"Re", "@", 
           RowBox[{"nSumF", "[", "z", "]"}]}]}], "}"}], "/.", 
        RowBox[{"z", "->", 
         RowBox[{"translateFactor", "+", 
          RowBox[{"r", " ", 
           RowBox[{"Exp", "[", 
            RowBox[{"I", " ", "t"}], "]"}]}]}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", "innerR", ",", "outerR"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", 
         RowBox[{"2", " ", "Pi"}]}], "}"}], ",", 
       RowBox[{"BoxRatios", "->", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "1", ",", " ", "1"}], "}"}]}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nPlotRange", "=", 
     RowBox[{"PlotRange", "@", "nSumFPlot"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"plotN", "=", " ", 
    RowBox[{"Show", "[", 
     RowBox[{"nSumFPlot", ",", 
      RowBox[{"BoxRatios", "->", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "1", ",", " ", "1"}], "}"}]}], ",", 
      RowBox[{"PlotStyle", "->", "LightBlue"}], ",", 
      RowBox[{"AxesEdge", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", 
           RowBox[{"-", "1"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", 
           RowBox[{"-", "1"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", 
           RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], ",", 
      RowBox[{"AxesLabel", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{"\"\<Re[z]\>\"", ",", "12", ",", "Bold", ",", "Black"}], 
          "]"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{"\"\<Im[z]\>\"", ",", "12", ",", "Bold", ",", "Black"}], 
          "]"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{"\"\<N\>\"", ",", "12", ",", "Bold", ",", "Black"}], 
          "]"}]}], "}"}]}], ",", 
      RowBox[{"FaceGrids", "->", 
       RowBox[{"{", 
