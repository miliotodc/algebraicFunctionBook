Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"theAnnulusTable", "=", "annulusTable"}], ";"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
   "the", " ", "medial", " ", "contour", " ", "and", " ", "integration", " ", 
    "precision", " ", "may", " ", "require", " ", "adjusting", " ", "to", " ",
     "avoid", " ", "errors"}], "\[IndentingNewLine]", "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"1", "<=", "$property921Annulus", "<=", 
      RowBox[{"Length", "@", "theAnnuli"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"aIndex", ",", "sIndex"}], "}"}], "=", 
       RowBox[{"getSingTableIndexes", "[", 
        RowBox[{"annulusTable", ",", "$property921Annulus"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"selectedMonodromyList", "=", 
       RowBox[{"annulusTable", "[", 
        RowBox[{"[", 
         RowBox[{"aIndex", ",", "6"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"branchData", "=", 
       RowBox[{"Table", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"selectedBranch", "=", 
           RowBox[{"selectedMonodromyList", "[", 
            RowBox[{"[", "monodromyIndex", "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"selectedBranchSize", "=", 
           RowBox[{"Length", "@", 
            RowBox[{"selectedMonodromyList", "[", 
             RowBox[{"[", "monodromyIndex", "]"}], "]"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{
           "\"\<Analyzing annular index \>\"", ",", "$property921Annulus", 
            ",", "\"\< branch \>\"", ",", "selectedBranch"}], "]"}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"annulusDomain", "=", 
           RowBox[{"Rationalize", "[", 
            RowBox[{
             RowBox[{"annulusTable", "[", 
              RowBox[{"[", 
               RowBox[{"aIndex", ",", "3"}], "]"}], "]"}], ",", "0"}], 
            "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<Annulus: \>\"", ",", 
            RowBox[{"annulusDomain", "//", "N"}]}], "]"}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"theAnnulus", "=", 
             RowBox[{"annulusTable", "[", 
              RowBox[{"[", 
               RowBox[{"aIndex", ",", "3"}], "]"}], "]"}]}], ";"}], "*)"}], 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"rNorm", "=", 
           RowBox[{"annulusTable", "[", 
            RowBox[{"[", 
             RowBox[{"aIndex", ",", "4"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"tStart", "=", "$thetaV"}], ";", "\[IndentingNewLine]", 
          RowBox[{"tEnd", "=", " ", 
           RowBox[{"tStart", "+", 
            RowBox[{"2", " ", "Pi", " ", "selectedBranchSize"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<tStart: \>\"", ",", 
            RowBox[{"tStart", "//", "N"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<tEnd: \>\"", ",", 
            RowBox[{"tEnd", "//", "N"}]}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", "\[IndentingNewLine]", " ", 
           RowBox[{"get", " ", "medial", " ", "contour"}], 
           "\[IndentingNewLine]", "*)"}], " ", "\[IndentingNewLine]", " ", 
          RowBox[{"rationalRNorm", "=", 
           RowBox[{"Rationalize", "[", 
            RowBox[{"rNorm", ",", 
             RowBox[{"10", "^", 
              RowBox[{"-", "$property921Precision"}]}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
            "tStart", ",", "tEnd", ",", "rNorm", ",", "lowPrecMedialSol", ",",
              "selectedBranchSize"}], "}"}], "=", 
           RowBox[{"generateMedialContour", "[", 
            RowBox[{
            "annulusTable", ",", "$property921Annulus", ",", "monodromyIndex",
              ",", "$property921Precision", ",", 
             RowBox[{"1", "/", "2"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<prec: \>\"", ",", 
            RowBox[{"Precision", "@", "lowPrecMedialSol"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", "\[IndentingNewLine]", " ", 
           RowBox[{"get", " ", "branch", " ", "expansions"}], 
           "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", " ", 
          RowBox[{"numPart", "=", "2"}], ";", "\[IndentingNewLine]", 
          RowBox[{"t0", "=", "$thetaV"}], ";", "\[IndentingNewLine]", 
          RowBox[{"t1", "=", 
           RowBox[{"t0", "+", 
            RowBox[{"2", " ", "Pi", " ", "selectedBranchSize"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"intervalArray", "=", 
           RowBox[{"Array", "[", 
            RowBox[{
             RowBox[{"#", "&"}], ",", 
             RowBox[{"numPart", "+", "1"}], ",", 
             RowBox[{"{", 
              RowBox[{"t0", ",", "t1"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"thePartitions", "=", 
           RowBox[{"Partition", "[", 
            RowBox[{"intervalArray", ",", "2", ",", "1"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"termRange", "=", 
           RowBox[{"{", 
            RowBox[{"-", "selectedBranchSize"}], "}"}]}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"finalIntVal", "=", 
           RowBox[{"Plus", "@@", 
            RowBox[{"Table", "[", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"NIntegrate", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"lowPrecMedialSol", "[", "t", "]"}], 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"Cos", "[", "t", "]"}], "+", 
                   RowBox[{"I", " ", 
                    RowBox[{"Sin", "[", "t", "]"}]}]}], ")"}]}], ",", 
                RowBox[{"{", 
                 RowBox[{"t", ",", 
                  RowBox[{"thePartitions", "[", 
                   RowBox[{"[", 
                    RowBox[{"index", ",", "1"}], "]"}], "]"}], ",", 
                  RowBox[{"thePartitions", "[", 
                   RowBox[{"[", 
                    RowBox[{"index", ",", "2"}], "]"}], "]"}]}], "}"}], ",", 
                RowBox[{"Method", "->", 
                 RowBox[{"{", 
                  RowBox[{"\"\<GlobalAdaptive\>\"", ",", 
                   RowBox[{"\"\<MaxErrorIncreases\>\"", "->", "600"}], ",", 
                   RowBox[{"Method", "->", "\"\<LevinRule\>\""}]}], "}"}]}], 
                ",", 
                RowBox[{"WorkingPrecision", "->", "$property921Precision"}], 
                ",", 
                RowBox[{"AccuracyGoal", "->", 
                 RowBox[{"$property921Precision", "/", "2"}]}], ",", 
                RowBox[{"MaxRecursion", "->", "Infinity"}]}], "]"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{"index", ",", "1", ",", 
                RowBox[{"Length", "@", "thePartitions"}]}], "}"}]}], 
             "\[IndentingNewLine]", "]"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"coef", "=", 
           RowBox[{
            FractionBox["rNorm", 
             RowBox[{"2", " ", "Pi", " ", "selectedBranchSize", " "}]], 
            "finalIntVal"}]}], ";", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"integralData", "[", 
             RowBox[{"[", "monodromyIndex", "]"}], "]"}], ",", "coef", ",", 
            RowBox[{
            "2", " ", "\[Pi]", " ", "\[ImaginaryI]", " ", 
             "selectedBranchSize", " ", "coef"}]}], "}"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"monodromyIndex", ",", "1", ",", 
           RowBox[{"Length", "@", "selectedMonodromyList"}]}], "}"}]}], 
        "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", "\"\<Annulus index out of range\>\"", "]"}]}], 
    "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<branchData: \>\"", ",", " ", 
      RowBox[{
       RowBox[{"branchData", "//", "N"}], "//", "MatrixForm"}]}], "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Sum of branch integrals: \>\"", ",", 
     RowBox[{"integralResult", "//", "N"}]}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<2PiI times sum of residues: \>\"", ",", " ", 
     RowBox[{"branchData", "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", 
        RowBox[{"-", "1"}]}], "]"}], "]"}]}], "]"}], 
   "\[IndentingNewLine]"}]}]], "Input",
