Cell[CellGroupData[{

Cell["\<\
Section 7.4.6:  Check summatory pSumF[z] function series at a test point and \
sum of w vals at test point\
\>", "Subsubsection",
 CellChangeTimes->{{3.9830065720822678`*^9, 
  3.9830066120829945`*^9}},ExpressionUUID->"c9baa30c-b479-4df4-a570-\
f2e1eada0e6a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
   "check", " ", "value", " ", "of", " ", "summatory", " ", "series", " ", 
    "to", " ", "sum", " ", "of", " ", "wVals"}], "\[IndentingNewLine]", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"pSumF", "[", "z_", "]"}], "=", 
     RowBox[{"Plus", "@@", 
      RowBox[{"alphaSummatoryTerms", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "3"}], "]"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", " ", 
   RowBox[{"Precision", "@", 
    RowBox[{"pSumF", "[", "z", "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"testP", "=", 
     RowBox[{"alphaContourF", "[", 
      RowBox[{"3", 
       RowBox[{"Pi", "/", "10"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<testP: \>\"", ",", 
     RowBox[{"testP", "//", "N"}]}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Summatory val: \>\"", ",", 
     RowBox[{
      RowBox[{"pSumF", "[", 
       RowBox[{"testP", "-", "translateFactor"}], "]"}], "//", "N"}]}], "]"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wVals", "=", 
     RowBox[{
      RowBox[{"w", "/.", 
       RowBox[{"NSolve", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"$theFunction", "==", "0"}], "/.", 
          RowBox[{"z", "->", 
           RowBox[{"(", "testP", ")"}]}]}], ",", "w"}], "]"}]}], "//", 
      "N"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<sum of wVals:  \>\"", ",", 
      RowBox[{"Plus", "@@", "wVals"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.96303578518025*^9, 3.963035814140827*^9}, {
