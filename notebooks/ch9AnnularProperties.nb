Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{"create", " ", 
    RowBox[{"nSumF", "[", "z", "]"}], " ", "power", " ", "expansions"}], 
   "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"summatoryRange", "=", 
     RowBox[{"Range", "[", 
      RowBox[{"Sequence", "@@", "$range933b"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"alphaSummatoryTerms", "=", 
     RowBox[{"ParallelTable", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Mod", "[", 
            RowBox[{"theK", ",", "25"}], "]"}], "==", "0"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"\"\<theK: \>\"", ",", "theK"}], "]"}], ";"}]}], 
         "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"theK", "==", "0"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"theInt", "=", " ", 
            RowBox[{"NIntegrate", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"nSumF", "[", 
                RowBox[{
                 RowBox[{"alphaContourF", "[", "t", "]"}], ",", 
                 RowBox[{"\"\<sumWP\>\"", "->", "$precision933b"}]}], "]"}], 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"Cos", "[", 
                  RowBox[{"t", " ", "theK"}], "]"}], "-", 
                 RowBox[{"I", " ", 
                  RowBox[{"Sin", "[", 
                   RowBox[{"t", " ", "theK"}], "]"}]}]}], ")"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"t", ",", 
                RowBox[{"-", "Pi"}], ",", "Pi"}], "}"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"WorkingPrecision", "->", "$precision933b"}], ",", 
              RowBox[{"AccuracyGoal", "->", 
               RowBox[{"$precision933b", "/", "2"}]}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"Method", "->", 
               RowBox[{"{", 
                RowBox[{"\"\<GlobalAdaptive\>\"", ",", 
                 RowBox[{"\"\<MaxErrorIncreases\>\"", "->", "600"}], ",", 
                 RowBox[{"Method", "->", "\"\<GaussKronrodRule\>\""}]}], 
                "}"}]}], ",", 
              RowBox[{"MaxRecursion", "->", "Infinity"}]}], "]"}]}], ";"}], 
          "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
          RowBox[{"theInt", "=", " ", 
           RowBox[{"NIntegrate", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"nSumF", "[", 
               RowBox[{
                RowBox[{"alphaContourF", "[", "t", "]"}], ",", 
                RowBox[{"\"\<sumWP\>\"", "->", "$precision933b"}]}], "]"}], 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"Cos", "[", 
                 RowBox[{"t", " ", "theK"}], "]"}], "-", 
                RowBox[{"I", " ", 
                 RowBox[{"Sin", "[", 
                  RowBox[{"t", " ", "theK"}], "]"}]}]}], ")"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"t", ",", 
               RowBox[{"-", "Pi"}], ",", "Pi"}], "}"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"WorkingPrecision", "->", "$precision933b"}], ",", 
             RowBox[{"AccuracyGoal", "->", 
              RowBox[{"$precision933b", "/", "2"}]}], ",", 
             RowBox[{"Method", "->", 
              RowBox[{"{", 
               RowBox[{"\"\<GlobalAdaptive\>\"", ",", 
                RowBox[{"\"\<MaxErrorIncreases\>\"", "->", "600"}], ",", 
                RowBox[{"Method", "->", "\"\<LevinRule\>\""}]}], "}"}]}], ",", 
             RowBox[{"MaxRecursion", "->", "Infinity"}]}], "]"}]}]}], 
         "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"coef", "=", 
         RowBox[{
          FractionBox["1", 
           RowBox[{"2", " ", "Pi", " ", 
            RowBox[{"medialR", "^", 
             RowBox[{"(", "theK", ")"}]}]}]], "theInt"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"theK", ",", "coef", ",", 
          RowBox[{"coef", " ", 
           RowBox[{"z", "^", "theK"}]}]}], "}"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"theK", ",", "summatoryRange"}], "}"}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{
    "extract", " ", "nSumf", " ", "power", " ", "expansion", " ", "residue"}],
     "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nSumResidue", "=", 
     RowBox[{"Coefficient", "[", 
      RowBox[{
       RowBox[{"Plus", "@@", 
        RowBox[{"alphaSummatoryTerms", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "3"}], "]"}], "]"}]}], ",", "z", ",", 
       RowBox[{"-", "1"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Residue of summatory function: \>\"", ",", "nSumResidue"}], 
     "]"}], ";"}]}]}]], "Input",
