Cell[CellGroupData[{

Cell["\<\
Section 6.2:  Compute value of Psi_n(i) for selected first and second annuli \
in the same annular group and use Psi_n(i) in the first annuli to compute the \
coefficient of a selected integer power of z in another annuli in the same \
annular group\
\>", "Subsection",
 CellChangeTimes->{{3.9741922049321237`*^9, 3.9741922122958493`*^9}, {
  3.974192256870164*^9, 3.974192257982401*^9}, {3.9742883969326534`*^9, 
  3.974288429198971*^9}, {3.97428880348847*^9, 3.9742888061520185`*^9}, {
  3.982670540692709*^9, 3.9826705571693897`*^9}, {3.982742801053994*^9, 
