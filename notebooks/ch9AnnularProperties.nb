                    RowBox[{"Factor", "@", 
                    RowBox[{"a0Rule", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}]}], "\[Equal]", 
                    "0"}], ",", "z", ",", 
                    RowBox[{
                    "WorkingPrecision", "\[Rule]", "singPrecision"}]}], 
                    "]"}]}], ",", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "@", "#1"}], "<=", 
                    RowBox[{"Abs", "@", "#2"}]}], "&"}]}], "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"(*", "\[IndentingNewLine]", " ", 
                 RowBox[{"now", " ", "confirm", " ", "solutions"}], 
                 "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
                RowBox[{"difTable", "=", 
