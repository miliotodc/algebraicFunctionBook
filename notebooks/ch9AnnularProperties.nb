                    RowBox[{"[", 
                    RowBox[{"index", ",", "2"}], "]"}], "]"}]}], "}"}], ",", 
                    RowBox[{"Method", "->", 
                    RowBox[{"{", 
                    RowBox[{"\"\<GlobalAdaptive\>\"", ",", 
                    RowBox[{"\"\<MaxErrorIncreases\>\"", "->", "600"}], ",", 
                    RowBox[{"Method", "->", "\"\<LevinRule\>\""}]}], "}"}]}], 
                    ",", 
                    RowBox[{"WorkingPrecision", "->", "$precision933a"}], ",", 
                    RowBox[{"AccuracyGoal", "->", 
                    RowBox[{"$precision933a", "/", "2"}]}], ",", 
                    RowBox[{"MaxRecursion", "->", "Infinity"}]}], "]"}], ",", 
                   "\[IndentingNewLine]", 
                   RowBox[{"{", 
                    RowBox[{"index", ",", "1", ",", 
                    RowBox[{"Length", "@", "thePartitions"}]}], "}"}]}], 
                  "\[IndentingNewLine]", "]"}]}]}], ";"}]}], 
             "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
            RowBox[{"coef", "=", 
             RowBox[{
              FractionBox["1", 
               RowBox[{"2", " ", "Pi", " ", "selectedBranchSize", " ", 
                RowBox[{"rNorm", "^", 
                 RowBox[{"(", 
                  RowBox[{"k", "/", "selectedBranchSize"}], ")"}]}]}]], 
              "finalIntVal"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"k", "/", "selectedBranchSize"}], ",", "coef", ",", 
              RowBox[{"N", "[", 
               RowBox[{"coef", ",", "10"}], "]"}], ",", 
              RowBox[{"coef", " ", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"z", "^", 
                  RowBox[{"(", 
                   RowBox[{"1", "/", "selectedBranchSize"}], ")"}]}], ")"}], 
                "^", "k"}]}]}], "}"}]}], ",", "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"k", ",", "termRange"}], "}"}]}], "\[IndentingNewLine]", 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"selectedBranch", ",", "theBranchTerms"}], "}"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"branchIndex", ",", "1", ",", "totalBranches"}], "}"}]}], 
