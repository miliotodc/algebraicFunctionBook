                    RowBox[{"a1", " ", "poly", " ", "degree"}], ">", 
                    RowBox[{
                    "0", " ", "so", " ", "zero", " ", "terms", " ", "are", 
                    " ", "zeros", " ", "to", " ", "a0"}]}]}], " ", "*)"}], 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"theZeroPoints", "=", 
                    RowBox[{"Sort", "[", 
                    RowBox[{
                    RowBox[{"z", "/.", 
                    RowBox[{"NSolve", "[", 
