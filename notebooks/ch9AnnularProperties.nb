Cell[CellGroupData[{

Cell["\<\
Section 7.4.10:  Create a plot of the error difference between the cyclic sum \
of integer branch coefficients to summatory power coefficients\
\>", "Subsubsection",
 CellChangeTimes->{{3.9829989700179214`*^9, 3.982999010591628*^9}, {
  3.983006704646269*^9, 
  3.9830067061017227`*^9}},ExpressionUUID->"f827f7da-fdfd-4a70-838d-\
224f86e7b834"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{"(*", "\[IndentingNewLine]", "  ", 
   RowBox[{
   "Create", " ", "a", " ", "plot", " ", "of", " ", "the", " ", "differnces", 
    " ", "between", " ", "the", " ", "sum", " ", "of", " ", "the", " ", 
    "integer", " ", "powers", " ", "of", " ", "the", " ", "branch", " ", 
    "expansions", " ", "to", " ", "that", " ", "of", " ", "the", " ", 
    "corresponding", " ", "summatory", " ", "power", " ", "coefficient"}], 
   "\[IndentingNewLine]", "  ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"summatoryDifTable", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"branchCoefficientSum", "=", 
         RowBox[{"Plus", "@@", 
          RowBox[{"(", " ", 
           RowBox[{"MapThread", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"Coefficient", "[", 
                RowBox[{
