Cell[CellGroupData[{

Cell["\<\
Section 7.4.9:  Compare selected summatory function coefficient to cyclic sum \
of branch coefficients\
\>", "Subsubsection",
 CellChangeTimes->{{3.982998920624928*^9, 3.9829989485110283`*^9}, {
  3.9830066912799673`*^9, 
  3.983006692677312*^9}},ExpressionUUID->"a3106d90-e7cf-43af-94b4-\
5c033ee2ab8b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
   "check", " ", "the", " ", "coefficient", " ", "of", " ", "a", " ", 
    "selected", " ", "power", " ", "of", " ", "z", " ", "in", " ", "the", " ",
     "summatory", " ", "funtion", " ", "to", " ", "the", " ", "sum", " ", 
    "of", " ", "the", " ", "coefficients", " ", "in", " ", "the", " ", 
    "branch", " ", "expansions"}], "\[IndentingNewLine]", "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"expVal", "=", "4"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"branchCoefficientSum", "=", 
     RowBox[{"Plus", "@@", 
      RowBox[{"(", " ", 
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Coefficient", "[", 
            RowBox[{
             RowBox[{"Plus", "@@", 
              RowBox[{"#1", "[", 
               RowBox[{"[", 
                RowBox[{"2", ",", "All", ",", "4"}], "]"}], "]"}]}], " ", ",",
              "z", ",", "expVal"}], "]"}], " ", "#2"}], "&"}], ",", 
         RowBox[{"{", 
          RowBox[{"alphaSeriesSet", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "@", "#"}], "&"}], "/@", 
            "alphaMonodromyList"}]}], "}"}]}], "]"}], ")"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"summatoryCoef", "=", " ", 
     RowBox[{"Coefficient", "[", 
      RowBox[{
       RowBox[{"pSumF", "[", "z", "]"}], ",", "z", ",", "expVal"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"coefDif", "=", 
    RowBox[{"-", 
     RowBox[{
      RowBox[{"MantissaExponent", "[", 
       RowBox[{"Abs", "[", 
        RowBox[{"branchCoefficientSum", "-", "summatoryCoef"}], "]"}], "]"}], 
      "[", 
      RowBox[{"[", "2", "]"}], "]"}]}]}], "\[IndentingNewLine]", 
   "branchCoefficientSum", "\[IndentingNewLine]", "summatoryCoef", 
   "\[IndentingNewLine]", "   ", 
   RowBox[{"latexErrorString", "=", 
    RowBox[{"colorAccuracyReport", "[", 
     RowBox[{
     "branchCoefficientSum", ",", "summatoryCoef", ",", "Im", ",", "50", ",", 
      "\"\<Branch coef sum:\>\"", ",", "\"\<aSum coef: \>\""}], 
     "]"}]}]}]}]], "Input",
