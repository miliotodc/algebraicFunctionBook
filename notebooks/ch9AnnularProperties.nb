Cell[CellGroupData[{

Cell["plotBranchSeries", "Subsection",
 CellChangeTimes->{{3.94715795063846*^9, 
  3.9471579537158756`*^9}},ExpressionUUID->"29e5b16e-70cf-45e0-92d8-\
7a5c150c593f"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"plotBranchSeries", "[", 
     RowBox[{
     "baseSingularPoint_", ",", "theBranchSeries_", ",", "sheetLinks_", ",", 
      "estR_", ",", "colors_", ",", "type_", ",", "startR_", ",", "endR_"}], 
     "]"}], ":=", "\[IndentingNewLine]", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "genF", ",", "theExp", ",", "theNum", ",", "cList", ",", "f", ",", 
        "thePlots", ",", "cycleSize", ",", "domain"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"cycleSize", "=", 
        RowBox[{"Length", "@", "sheetLinks"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"genF", "[", "u_", "]"}], "=", 
        RowBox[{"theBranchSeries", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"sheetLinks", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", 
           RowBox[{"1", ";;", "50"}]}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"theExp", "=", 
        RowBox[{"Exponent", "[", 
         RowBox[{
          RowBox[{"genF", "[", "z", "]"}], ",", "z", ",", "List"}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"theNum", "=", 
        RowBox[{"Numerator", "@", "theExp"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"cList", "=", 
        RowBox[{"Coefficient", "[", 
         RowBox[{
          RowBox[{"genF", "[", "z", "]"}], ",", "z", ",", "theExp"}], "]"}]}],
        ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"f", "[", 
         RowBox[{"z_", ",", "k_"}], "]"}], ":=", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"cList", "[", 
            RowBox[{"[", "n", "]"}], "]"}], " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"Exp", "[", 
              RowBox[{"2", " ", "k", " ", "\[Pi]", " ", 
               RowBox[{"\[ImaginaryI]", "/", "cycleSize"}]}], "]"}], ")"}], 
            "^", 
            RowBox[{"(", 
             RowBox[{"cycleSize", " ", 
              RowBox[{"theExp", "[", 
               RowBox[{"[", "n", "]"}], "]"}]}], ")"}]}], " ", 
           RowBox[{"z", "^", 
            RowBox[{"theExp", "[", 
             RowBox[{"[", "n", "]"}], "]"}]}]}], ",", 
          RowBox[{"{", 
           RowBox[{"n", ",", "1", ",", 
            RowBox[{"Length", "[", "cList", "]"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"domain", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"1", "/", "50"}], ",", "estR"}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Table", "[", "\[IndentingNewLine]", " ", 
        RowBox[{
         RowBox[{"ParametricPlot3D", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"Re", "[", "z", "]"}], "+", 
               RowBox[{"Re", "[", "baseSingularPoint", "]"}]}], ",", 
              RowBox[{
               RowBox[{"Im", "[", "z", "]"}], "+", 
               RowBox[{"Im", "[", "baseSingularPoint", "]"}]}], ",", 
              RowBox[{"type", "[", 
               RowBox[{"f", "[", 
                RowBox[{"z", ",", 
                 RowBox[{"i", "-", "1"}]}], "]"}], "]"}]}], "}"}], "/.", 
            RowBox[{"z", "\[Rule]", 
             RowBox[{"r", " ", 
              RowBox[{"Exp", "[", 
               RowBox[{"\[ImaginaryI]", " ", "t"}], "]"}]}]}]}], ",", 
           RowBox[{"{", 
            RowBox[{"r", ",", "startR", ",", "endR"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", 
             RowBox[{"-", "\[Pi]"}], ",", "\[Pi]"}], "}"}], ",", 
           RowBox[{"BoxRatios", "\[Rule]", 
            RowBox[{"{", 
             RowBox[{"1", ",", "1", ",", "1"}], "}"}]}], ",", 
           RowBox[{"PlotStyle", "->", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Opacity", "[", "0.55", "]"}], ",", 
              RowBox[{"colors", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], "}"}]}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "cycleSize"}], "}"}]}], "]"}]}]}], 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Show", "[", 
       RowBox[{"thePlots", ",", 
        RowBox[{"BoxRatios", "->", 
         RowBox[{"{", 
          RowBox[{"1", ",", "1", ",", "1"}], "}"}]}], ",", 
        RowBox[{"AxesEdge", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1"}], ",", 
             RowBox[{"-", "1"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", 
             RowBox[{"-", "1"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1"}], ",", 
             RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], ",", 
        RowBox[{"Axes", "->", "True"}], ",", 
        RowBox[{"FaceGridsStyle", "\[Rule]", 
         RowBox[{"Directive", "[", 
          RowBox[{"Black", ",", "Bold"}], "]"}]}], ",", 
        RowBox[{"AxesLabel", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Style", "[", 
            RowBox[{"\"\<Re[z]\>\"", ",", "12", ",", "Bold", ",", "Black"}], 
            "]"}], ",", 
           RowBox[{"Style", "[", 
            RowBox[{"\"\<Im[z]\>\"", ",", "12", ",", "Bold", ",", "Black"}], 
            "]"}], ",", 
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"ToString", "@", "type"}], "<>", "\"\<(w)\>\""}], ",", 
             "12", ",", "Bold", ",", "Black"}], "]"}]}], "}"}]}], ",", 
        RowBox[{"PlotRange", "->", "All"}], ",", 
        RowBox[{"ImageSize", "->", "300"}]}], "]"}], "*)"}], 
     "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{3.9471579571214457`*^9},
 CellLabel->
  "In[191]:=",ExpressionUUID->"d6c5b58e-85bb-4ddc-bf6d-9e8fcca2b0cc"]
}, Closed]],

Cell[CellGroupData[{

Cell["getCoefficientRulesB", "Subsection",
 CellChangeTimes->{{3.945963009660695*^9, 3.9459630138786383`*^9}, 
   3.9471682086878257`*^9},ExpressionUUID->"d583c4ad-2953-4cc2-bee9-\
4802be80fb52"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"getCoefficientRulesB", "[", "a_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"expList", ",", "coefList"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"expList", "=", 
      RowBox[{"Exponent", "[", 
       RowBox[{"a", ",", "z", ",", "List"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"coefList", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Coefficient", "[", 
         RowBox[{"a", ",", "z", ",", "#"}], "]"}], "&"}], "/@", " ", 
       "expList"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"expList", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "->", 
        RowBox[{"coefList", "[", 
         RowBox[{"[", "i", "]"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "@", "expList"}]}], "}"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SetAttributes", "[", 
    RowBox[{"getCoefficientRulesB", ",", "Listable"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{"getCoefficientRulesC", "[", 
    RowBox[{"a_", ",", "acc_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"expList", ",", "coefList"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"expList", "=", 
       RowBox[{"Exponent", "[", 
        RowBox[{"a", ",", "z", ",", "List"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"coefList", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Coefficient", "[", 
          RowBox[{"a", ",", "z", ",", "#"}], "]"}], "&"}], "/@", " ", 
        "expList"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"expList", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "->", 
         RowBox[{"SetAccuracy", "[", 
          RowBox[{
           RowBox[{"coefList", "[", 
            RowBox[{"[", "i", "]"}], "]"}], ",", "acc"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"Length", "@", "expList"}]}], "}"}]}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetAttributes", "[", 
   RowBox[{"getCoefficientRulesB", ",", "Listable"}], "]"}], 
  ";"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.9471681885673776`*^9, 3.9471682121087384`*^9}, {
  3.9474179486234446`*^9, 3.947417970899497*^9}},
 CellLabel->
  "In[192]:=",ExpressionUUID->"9b9513ec-5364-4984-92ee-5fb6724774a4"]
}, Closed]],

Cell[CellGroupData[{

Cell["summatoryFromPuiseux", "Subsection",
 CellChangeTimes->{{3.9472350729918346`*^9, 
  3.9472350800682597`*^9}},ExpressionUUID->"53cfbd68-a2d0-4ce5-a674-\
8e48df1e4495"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "summatoryFromPuiseux", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{"\"\<branches\>\"", "->", "\"\<All\>\""}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"  ", 
  RowBox[{
   RowBox[{
    RowBox[{"summatoryFromPuiseux", "[", 
     RowBox[{"testCase_", ",", "theSingularIndex_", ",", 
      RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "return", ",", "dataList", ",", "baseBranchTypeArray", ",", 
        "baseSeriesArray", ",", "newSingularIndex", ",", "newSing", ",", 
        "baseCycleMetric", ",", "basePoleList", ",", "newConjList", ",", 
        "baseRemovableList", ",", "baseSeries", ",", "baseSheetLinks", ",", 
        "baseSingSequence", ",", "baseSeriesMIVPTable", ",", "maxOrderList", 
        ",", "seriesIndexes", ",", "branchSize", ",", "listOfRules", ",", 
        "theKeys", ",", "integerKeys", ",", "maxSeriesOrder", ",", 
        "summatoryTable", ",", "powerList", ",", "maxPow", ",", 
        "branchList"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"\"\<opt: \>\"", ",", 
         RowBox[{"OptionValue", "[", "\"\<branches\>\"", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"FileExistsQ", "[", 
           RowBox[{"seriesFileName", "[", 
            RowBox[{"testCase", ",", "theSingularIndex"}], "]"}], "]"}]}], 
         ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"Style", "[", 
            RowBox[{"\"\<File not found\>\"", ",", "Red"}], "]"}], "]"}], ";",
           "\[IndentingNewLine]", 
          RowBox[{"return", "=", 
           RowBox[{"-", "1"}]}], ";"}], "\[IndentingNewLine]", ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"dataList", "=", 
           RowBox[{"Import", "[", 
            RowBox[{"seriesFileName", "[", 
             RowBox[{"testCase", ",", "theSingularIndex"}], "]"}], "]"}]}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"baseBranchTypeArray", "=", 
           RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"baseSeriesMIVPTable", "=", 
           RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "@", "dataList"}], "==", "9"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{
               "newSingularIndex", ",", "newSing", ",", "baseCycleMetric", 
                ",", "basePoleList", ",", "newConjList", ",", 
                "baseRemovableList", ",", "baseSeries", ",", "baseSheetLinks",
                 ",", "baseSingSequence"}], "}"}], "=", "dataList"}], ";"}], 
            "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Length", "@", "dataList"}], "==", "10"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                  "newSingularIndex", ",", "newSing", ",", "baseCycleMetric", 
                   ",", "basePoleList", ",", "newConjList", ",", 
                   "baseRemovableList", ",", "baseSeries", ",", 
                   "baseSheetLinks", ",", "baseSingSequence", ",", 
                   "baseBranchTypeArray"}], "}"}], "=", "dataList"}], ";"}], 
               "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                  "newSingularIndex", ",", "newSing", ",", "baseCycleMetric", 
                   ",", "basePoleList", ",", "newConjList", ",", 
                   "baseRemovableList", ",", "baseSeries", ",", 
                   "baseSheetLinks", ",", "baseSingSequence", ",", 
                   "baseBranchTypeArray", ",", "baseSeriesMIVPTable"}], "}"}],
                  "=", "dataList"}], ";"}]}], "\[IndentingNewLine]", "]"}], 
             ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"OptionValue", "[", "\"\<branches\>\"", "]"}], "===", 
             "\"\<All\>\""}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"branchList", "=", 
              RowBox[{"Length", "@", "baseBranchTypeArray"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{
             "Print", "[", 
              "\"\<Computing full Puiseux-summatory function\>\"", "]"}]}], 
            "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"branchList", "=", 
              RowBox[{"OptionValue", "[", "\"\<branches\>\"", "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"Print", "[", 
              RowBox[{
              "\"\<Computing partial Puiseux-summatory function with branch \
indexes \>\"", ",", 
               RowBox[{"OptionValue", "[", "\"\<branches\>\"", "]"}]}], "]"}],
              ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"(*", "\[IndentingNewLine]", " ", 
           RowBox[{"get", " ", "max", " ", "order", " ", "in", " ", "file"}], 
           " ", "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
          RowBox[{"maxOrderList", "=", 
           RowBox[{"Table", "[", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"seriesIndexes", "=", 
               RowBox[{"baseBranchTypeArray", "[", 
                RowBox[{"[", 
                 RowBox[{"branchIndex", ",", "2"}], "]"}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"branchSize", "=", 
               RowBox[{"Length", "@", "seriesIndexes"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"listOfRules", "=", 
               RowBox[{"getCoefficientRulesB", "[", 
                RowBox[{"baseSeries", "[", 
                 RowBox[{"[", "seriesIndexes", "]"}], "]"}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"theKeys", "=", 
               RowBox[{"Keys", "[", "listOfRules", "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"integerKeys", "=", 
               RowBox[{"Select", "[", 
                RowBox[{
                 RowBox[{"theKeys", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], ",", "IntegerQ"}], "]"}]}], 
              ";", "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Length", "@", "integerKeys"}], "==", "0"}], ",", 
                "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"Print", "[", 
                  RowBox[{"\"\<No integer powers in branch \>\"", ",", 
                   RowBox[{"baseBranchTypeArray", "[", 
                    RowBox[{"[", 
                    RowBox[{"branchIndex", ",", "1"}], "]"}], "]"}], ",", 
                   "\"\< series\>\""}], "]"}], ";", "\[IndentingNewLine]", 
                 RowBox[{"maxPow", "=", 
                  RowBox[{"10", "^", "6"}]}], ";"}], "\[IndentingNewLine]", 
                ",", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"maxPow", "=", 
                  RowBox[{"integerKeys", "[", 
                   RowBox[{"[", 
                    RowBox[{"-", "1"}], "]"}], "]"}]}], ";"}]}], 
               "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
              "maxPow"}], ",", "\[IndentingNewLine]", 
             RowBox[{"{", 
              RowBox[{"branchIndex", ",", "branchList"}], "}"}]}], 
            "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"maxSeriesOrder", "=", 
           RowBox[{"Min", "@", "maxOrderList"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", "\[IndentingNewLine]", " ", 
           RowBox[{"generate", " ", "summatory", " ", "terms"}], 
           "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
          RowBox[{"summatoryTable", "=", 
           RowBox[{"Table", "[", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"seriesIndexes", "=", 
               RowBox[{"baseBranchTypeArray", "[", 
                RowBox[{"[", 
                 RowBox[{"branchIndex", ",", "2"}], "]"}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"branchSize", "=", 
               RowBox[{"Length", "@", "seriesIndexes"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"listOfRules", "=", 
               RowBox[{"getCoefficientRulesB", "[", 
                RowBox[{"baseSeries", "[", 
                 RowBox[{"[", "seriesIndexes", "]"}], "]"}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"theKeys", "=", 
               RowBox[{"Keys", "[", "listOfRules", "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"integerKeys", "=", 
               RowBox[{"Select", "[", 
                RowBox[{
                 RowBox[{"theKeys", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], ",", "IntegerQ"}], "]"}]}], 
              ";", "\[IndentingNewLine]", 
              RowBox[{"powerList", "=", 
               RowBox[{"Select", "[", 
                RowBox[{"integerKeys", ",", 
                 RowBox[{
                  RowBox[{"#", "<=", "maxSeriesOrder"}], "&"}]}], "]"}]}], 
              ";", "\[IndentingNewLine]", 
              RowBox[{"Print", "[", 
               RowBox[{"\"\<Max integer key: \>\"", ",", 
                RowBox[{"integerKeys", "[", 
                 RowBox[{"[", 
                  RowBox[{"-", "1"}], "]"}], "]"}]}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"Plus", "@@", 
               RowBox[{"MapThread", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"Total", "[", "#1", "]"}], " ", 
                    RowBox[{"z", "^", "#2"}]}], ")"}], "&"}], ",", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"Flatten", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"#", "/.", "listOfRules"}], "}"}], "&"}], "/@", 
                    " ", "powerList"}], ",", "1"}], "]"}], ")"}], ",", 
                   "powerList"}], "}"}]}], "]"}]}]}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"{", 
              RowBox[{"branchIndex", ",", "branchList"}], "}"}]}], 
            "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", "\[IndentingNewLine]", 
           RowBox[{"return", " ", "summatory", " ", "function"}], 
           "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
          RowBox[{"return", "=", 
           RowBox[{"Plus", "@@", "summatoryTable"}]}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       "return"}]}], "\[IndentingNewLine]", "]"}]}], ";"}]}]}], "Input",
 CellChangeTimes->{{3.947235061150241*^9, 3.9472350616657724`*^9}, {
   3.947245582066713*^9, 3.9472455839854975`*^9}, {3.9474019746692057`*^9, 
   3.947401978527464*^9}, {3.9474033801620307`*^9, 3.9474034128426514`*^9}, 
