Cell["\<\
Section 7.6.5:  Compute upper limit of convergence of summatory series using \
root test of analytic terms\
\>", "Subsection",
 CellChangeTimes->{{3.9830268277065988`*^9, 3.9830268389964914`*^9}, {
  3.9830269294035254`*^9, 3.983026932357588*^9}, {3.9830286952528906`*^9, 
  3.983028697389842*^9}},ExpressionUUID->"882ec480-19f4-41ab-8f24-\
86aa6e530761"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"$rootTestLabel", "=", "False"}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{"analyticSeries", "=", " ", 
    RowBox[{"Plus", "@@", 
     RowBox[{"alphaSummatoryTerms", "[", 
      RowBox[{"[", 
       RowBox[{
        RowBox[{"101", ";;"}], ",", "3"}], "]"}], "]"}]}]}], 
   ";"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"analyticSeries", "[", 
   RowBox[{"[", 
    RowBox[{"1", ";;", "5"}], "]"}], "]"}], "//", 
  "N"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"cycleSize", "=", "1"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"seriesLength", "=", 
   RowBox[{"Length", "@", "analyticSeries"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"theexp", "=", 
   RowBox[{"Exponent", "[", 
    RowBox[{"analyticSeries", ",", "z", ",", "List"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lcm", "=", 
   RowBox[{"LCM", "@@", 
    RowBox[{"(", 
     RowBox[{"Denominator", "@", "theexp"}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"numVals", "=", 
   RowBox[{"lcm", " ", "theexp"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"clist", "=", 
   RowBox[{"Coefficient", "[", 
    RowBox[{"analyticSeries", ",", "z", ",", "theexp"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"cTable", "=", 
    RowBox[{"Table", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "/", 
         RowBox[{"numVals", "[", 
          RowBox[{"[", "k", "]"}], "]"}]}], ",", 
        RowBox[{"N", "[", 
         RowBox[{
          RowBox[{"1", "/", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"clist", "[", 
               RowBox[{"[", "k", "]"}], "]"}], "]"}], "^", 
             RowBox[{"(", 
              RowBox[{"cycleSize", "/", 
               RowBox[{"numVals", "[", 
                RowBox[{"[", "k", "]"}], "]"}]}], ")"}]}], ")"}]}], ",", 
          "15"}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"k", ",", "15", ",", 
        RowBox[{"Length", "@", "clist"}]}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
