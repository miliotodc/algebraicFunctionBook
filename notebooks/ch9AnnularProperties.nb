Cell[CellGroupData[{

Cell["\<\
Section 8:  Generate summatory plots in extended domain based on root test\
\>", "Section",
 CellChangeTimes->{{3.9830300250466285`*^9, 
  3.983030040244772*^9}},ExpressionUUID->"7059903a-4ae0-49b2-b318-\
25ef00aa3866"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"    ", 
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{"Generate", " ", "summatory", " ", "series", " ", "plot"}], 
   "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"alphaSummatoryF", "[", "z_", "]"}], "=", 
     RowBox[{"Plus", "@@", 
      RowBox[{"alphaSummatoryTerms", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "3"}], "]"}], "]"}]}]}], ";", 
    RowBox[{"extendedSumPlot", "=", 
     RowBox[{"ParametricPlot3D", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Re", "@", 
           RowBox[{"(", 
            RowBox[{"z", "+", "translateFactor"}], ")"}]}], ",", 
          RowBox[{"Im", "@", 
           RowBox[{"(", 
            RowBox[{"z", "+", "translateFactor"}], ")"}]}], ",", 
          RowBox[{"Re", "@", 
           RowBox[{"alphaSummatoryF", "[", "z", "]"}]}]}], "}"}], "/.", 
        RowBox[{"z", "->", 
         RowBox[{"r", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"I", " ", "t"}], "]"}]}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", "annularLowerR", ",", "annularUpperR"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", 
         RowBox[{"-", "Pi"}], ",", "Pi"}], "}"}], ",", 
       RowBox[{"BoxRatios", "->", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "1", ",", " ", "1"}], "}"}]}], ",", 
       RowBox[{"AxesEdge", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", 
            RowBox[{"-", "1"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", 
            RowBox[{"-", "1"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", 
            RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], ",", 
       RowBox[{"AxesLabel", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{"\"\<Re[z]\>\"", ",", "12", ",", "Bold", ",", "Black"}], 
           "]"}], ",", 
          RowBox[{"Style", "[", 
           RowBox[{"\"\<Im[z]\>\"", ",", "12", ",", "Bold", ",", "Black"}], 
           "]"}], ",", 
          RowBox[{"Style", "[", 
           RowBox[{
           "\"\<Re(sF(z))\>\"", ",", "12", ",", "Bold", ",", "Black"}], 
           "]"}]}], "}"}]}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Opacity", "[", "0.5", "]"}], ",", "Blue"}], "}"}]}], ",", 
       RowBox[{"PlotPoints", "->", "100"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"summatoryPlotRange", "=", 
     RowBox[{"PlotRange", "[", "extendedSumPlot", "]"}]}], ";"}], 
   "\[IndentingNewLine]", " ", 
   RowBox[{"Show", "[", 
    RowBox[{
     RowBox[{"{", "extendedSumPlot", "}"}], ",", 
