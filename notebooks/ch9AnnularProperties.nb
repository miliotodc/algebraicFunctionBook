        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "@", "theZeroPoints"}], ">", "0"}], ",", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"zeroPrecision", "=", 
           RowBox[{"Floor", "@", 
            RowBox[{"Precision", "@", "theZeroPoints"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"duplicateError", "=", 
           RowBox[{
            RowBox[{"Min", "[", 
