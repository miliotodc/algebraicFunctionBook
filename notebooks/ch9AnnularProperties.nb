                    "1"}], ")"}], "/", "2"}], "+", "1"}]}], "]"}], "]"}]}], 
               "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"rStart", "=", "rNorm"}], ";", "\[IndentingNewLine]", 
           RowBox[{"rEnd", "=", "rMax"}], ";", "\[IndentingNewLine]", 
           RowBox[{"(*", " ", "*)"}], "\[IndentingNewLine]", 
           RowBox[{"wStart", "=", 
            RowBox[{"medialTrace", "[", "tStart", "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"wDeriv", "=", 
            RowBox[{
             RowBox[{
              RowBox[{"w", "'"}], "[", "r", "]"}], "\[Equal]", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"-", 
                  FractionBox[
                   RowBox[{"D", "[", 
                    RowBox[{"$theFunction", ",", "z"}], "]"}], 
                   RowBox[{"D", "[", 
                    RowBox[{"$theFunction", ",", "w"}], "]"}]]}], 
                 RowBox[{"D", "[", 
                  RowBox[{
                   RowBox[{"zRadiusF", "[", "r", "]"}], ",", "r"}], "]"}]}], 
                ")"}], "/.", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"w", "\[Rule]", 
                  RowBox[{"w", "[", "r", "]"}]}], ",", 
                 RowBox[{"z", "\[Rule]", 
                  RowBox[{"zRadiusF", "[", "r", "]"}]}]}], "}"}]}], ")"}]}]}],
            ";", "\[IndentingNewLine]", " ", 
           RowBox[{"outerRadialTrace", "=", 
            RowBox[{"NDSolveValue", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"wDeriv", ",", 
                RowBox[{
                 RowBox[{"w", "[", "rStart", "]"}], "\[Equal]", "wStart"}]}], 
               "}"}], ",", "w", ",", 
              RowBox[{"{", 
               RowBox[{"r", ",", "rStart", ",", "rEnd"}], "}"}], ",", 
              RowBox[{"MaxSteps", "\[Rule]", 
               RowBox[{
               "OptionValue", "[", "\"\<totalIntegrationSteps\>\"", "]"}]}], 
              ",", 
              RowBox[{"MaxStepSize", "\[Rule]", 
               RowBox[{"OptionValue", "[", "\"\<maxStepSize\>\"", "]"}]}]}], 
             "]"}]}], ";", " ", "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{
            "generate", " ", "point", " ", "along", " ", "green", " ", 
             "radial", " ", "contour", " ", "total", " ", "of", " ", 
             RowBox[{"1", "/", "2"}], " ", "of", " ", "annularSegments"}], 
            " ", "*)"}], "\[IndentingNewLine]", 
           RowBox[{"outerRValues", "=", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Re", "[", "z", "]"}], ",", 
                 RowBox[{"Im", "[", "z", "]"}], ",", 
                 RowBox[{"thePlotType", "[", 
                  RowBox[{"outerRadialTrace", "[", "r", "]"}], "]"}]}], "}"}],
                "/.", 
               RowBox[{"z", "\[Rule]", 
                RowBox[{"r", " ", 
                 RowBox[{"Exp", "[", 
                  RowBox[{"\[ImaginaryI]", " ", "tStart"}], "]"}]}]}]}], ",", 
              RowBox[{"{", 
               RowBox[{"r", ",", 
                RowBox[{"newRadiiTable", "[", 
                 RowBox[{"[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    "OptionValue", "[", "\"\<radialSegments\>\"", "]"}], "-", 
                    "1"}], ")"}], "/", "2"}], "+", "2"}], ";;", 
                   RowBox[{
                   "OptionValue", "[", "\"\<radialSegments\>\"", "]"}]}], 
                  "]"}], "]"}]}], "}"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Join", "[", 
            RowBox[{"innerRValues", ",", "outerRValues"}], "]"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"segmentNum", ",", "arcSegmentList"}], "}"}]}], 
         "]"}]}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
