                    RowBox[{
                    "WorkingPrecision", "\[Rule]", "singPrecision"}]}], 
                    "]"}]}], ",", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "@", "#1"}], "<=", 
                    RowBox[{"Abs", "@", "#2"}]}], "&"}]}], "]"}]}], ";"}], 
                    "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
                    RowBox[{"(*", 
                    RowBox[{
                    RowBox[{"Print", "[", 
                    RowBox[{"Style", "[", 
                    RowBox[{
                    "\"\<No zero key singular points\>\"", ",", "Red"}], 
                    "]"}], "]"}], ";"}], "*)"}], "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"theZeroPoints", "=", 
                    RowBox[{"{", "}"}]}], ";"}]}], "\[IndentingNewLine]", 
                    "]"}], ";"}], "\[IndentingNewLine]", ",", 
                  "\[IndentingNewLine]", 
                  RowBox[{"(*", " ", 
                   RowBox[{
                   "if", " ", "a1", " ", "is", " ", "a", " ", "constant", " ",
                     "zero", " ", "set", " ", "is", " ", "null"}], " ", 
                   "*)"}], "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"theZeroPoints", "=", 
                    RowBox[{"{", "}"}]}], ";"}]}], "\[IndentingNewLine]", 
                 "]"}], ";"}], "\[IndentingNewLine]", ",", 
               "\[IndentingNewLine]", 
               RowBox[{"(*", " ", 
                RowBox[{
                "have", " ", "no", " ", "a1", " ", "at", " ", "this", " ", 
                 "point"}], " ", "*)"}], "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"theZeroPoints", "=", 
