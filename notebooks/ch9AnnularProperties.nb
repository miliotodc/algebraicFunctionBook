Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
   "generate", " ", "nSumF", " ", "plot", " ", "in", " ", "extended", " ", 
    "domain"}], "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", " ", 
  RowBox[{
   RowBox[{"nSumPlot", "=", " ", 
    RowBox[{"ParametricPlot3D", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Re", "@", "z"}], ",", 
         RowBox[{"Im", "@", "z"}], ",", 
         RowBox[{"Re", "@", 
          RowBox[{"nSumF", "[", "z", "]"}]}]}], "}"}], "/.", 
       RowBox[{"z", "->", 
        RowBox[{"translateFactor", "+", 
         RowBox[{"r", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"I", " ", "t"}], "]"}]}]}]}]}], ",", 
      RowBox[{"{", 
       RowBox[{"r", ",", "annularLowerR", ",", "annularUpperR"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", 
        RowBox[{"2", " ", "Pi"}]}], "}"}], ",", 
      RowBox[{"BoxRatios", "->", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "1", ",", " ", "1"}], "}"}]}], ",", 
      RowBox[{"PlotPoints", "->", "100"}]}], "]"}]}], 
   "\[IndentingNewLine]"}]}]], "Input",
