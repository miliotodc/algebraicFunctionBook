Cell[CellGroupData[{

Cell["getMedialStartVals", "Subsection",
 CellChangeTimes->{{3.916247729484652*^9, 
  3.9162477335773087`*^9}},ExpressionUUID->"8dade4ce-c3c0-426c-a13c-\
b929808996a5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"getMedialStartVals", "[", 
    RowBox[{
    "annulusTable_", ",", "$selectedAnnulus_", ",", 
     "$selectedMonodromyIndex_", ",", "$thetaV_", ",", "implicitF_"}], "]"}], 
   ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "aIndex", ",", "sIndex", ",", "$selectedMonodromyList", ",", 
       "$selectedBranchSize", ",", "rNorm", ",", "zStart", ",", "theRoots", 
       ",", "wStart"}], "}"}], ",", "\[IndentingNewLine]", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"aIndex", ",", "sIndex"}], "}"}], "=", 
       RowBox[{"getSingTableIndexes", "[", 
        RowBox[{"annulusTable", ",", "$selectedAnnulus"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"$selectedMonodromyList", "=", 
       RowBox[{"annulusTable", "[", 
        RowBox[{"[", 
         RowBox[{"aIndex", ",", "6"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"$selectedBranchSize", "=", 
       RowBox[{"Length", "@", 
        RowBox[{"$selectedMonodromyList", "[", 
         RowBox[{"[", "$selectedMonodromyIndex", "]"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"rNorm", "=", 
       RowBox[{"annulusTable", "[", 
        RowBox[{"[", 
         RowBox[{"aIndex", ",", "4"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"rNorm", "=", 
        RowBox[{"Rationalize", "[", 
         RowBox[{
          RowBox[{"radiiTable", "[", 
           RowBox[{"[", 
            RowBox[{"$selectedAnnulus", ",", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"$radialSegments", "-", "1"}], ")"}], "/", "2"}], "+",
               "1"}]}], "]"}], "]"}], ",", 
          RowBox[{"10", "^", 
           RowBox[{"-", "6"}]}]}], "]"}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"zStart", "=", 
       RowBox[{"rNorm", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"I", " ", "$thetaV"}], "]"}]}]}], " ", ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"theRoots", "=", 
       RowBox[{"w", "/.", 
        RowBox[{"NSolve", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"implicitF", "[", 
            RowBox[{"zStart", ",", "w"}], "]"}], "\[Equal]", "0"}], ",", "w", 
          ",", 
          RowBox[{"WorkingPrecision", "->", "700"}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"wStart", "=", 
       RowBox[{"theRoots", "[", 
        RowBox[{"[", 
         RowBox[{"$selectedMonodromyList", "[", 
          RowBox[{"[", 
           RowBox[{"$selectedMonodromyIndex", ",", "1"}], "]"}], "]"}], "]"}],
         "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"rNorm", ",", "zStart", ",", "wStart"}], "}"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9351549335901175`*^9, 3.935154933605739*^9}, {
