                RowBox[{"Length", "@", "a1Rule"}], ">", "0"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"(*", " ", 
                RowBox[{
                "now", " ", "have", " ", "a0", " ", "and", " ", "a1", " ", 
                 "in", " ", "function"}], " ", "*)"}], "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Exponent", "[", 
                    RowBox[{
                    RowBox[{"a1Rule", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}], ",", "z"}], "]"}], 
                   ">", "0"}], ",", "\[IndentingNewLine]", 
                  RowBox[{"(*", " ", 
                   RowBox[{
                    RowBox[{
                    "a1", " ", "is", " ", "a", " ", "poly", " ", "degree"}], 
                    ">", "0"}], " ", "*)"}], "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"a0Rule", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}], "===", 
                    RowBox[{"a1Rule", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{"(*", " ", 
                    RowBox[{
                    RowBox[{"at", " ", "this", " ", "point", " ", "a0"}], "===", 
