               RowBox[{"OptionValue", "[", "\"\<maxStepSize\>\"", "]"}]}]}], 
             "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{
            "generate", " ", "points", " ", "along", " ", "blue", " ", 
