Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{"branchPoints", "=", 
    RowBox[{
     RowBox[{"theSings", "[", 
      RowBox[{"[", 
       RowBox[{"Complement", "[", 
        RowBox[{
         RowBox[{"Range", "[", 
          RowBox[{"Length", "@", "$theSingularList"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "7", ",", "8"}], "}"}]}], "]"}], "]"}], "]"}], "//",
      "N"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"contourColors", "=", 
     RowBox[{"{", 
      RowBox[{"Red", ",", 
       RowBox[{"Darker", "@", "Green"}], ",", "Blue", ",", 
       RowBox[{"Darker", "@", "Yellow"}], ",", "Purple", ",", "Cyan", ",", 
       "Orange", ",", "Brown", ",", "Pink", ",", "Gray", ",", "Black"}], 
      "}"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"contourTable", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"ppBlue", "=", 
         RowBox[{"ParametricPlot3D", "[", 
