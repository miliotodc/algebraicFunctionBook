       RowBox[{"\"\<polishPrec\>\"", "->", "$precision922"}], ",", 
       RowBox[{"\"\<accGoal\>\"", "->", 
        RowBox[{"$precision922", "/", "2"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
