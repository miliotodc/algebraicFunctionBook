Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"plotBranchSeries", "[", 
     RowBox[{
     "baseSingularPoint_", ",", "theBranchSeries_", ",", "sheetLinks_", ",", 
      "estR_", ",", "colors_", ",", "type_"}], "]"}], ":=", 
    "\[IndentingNewLine]", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "genF", ",", "theExp", ",", "theNum", ",", "cList", ",", "f", ",", 
        "thePlots", ",", "cycleSize", ",", "domain"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"cycleSize", "=", 
        RowBox[{"Length", "@", "sheetLinks"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"genF", "[", "u_", "]"}], "=", 
        RowBox[{"theBranchSeries", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"sheetLinks", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", 
           RowBox[{"1", ";;", "50"}]}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"theExp", "=", 
        RowBox[{"Exponent", "[", 
         RowBox[{
          RowBox[{"genF", "[", "z", "]"}], ",", "z", ",", "List"}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"theNum", "=", 
        RowBox[{"Numerator", "@", "theExp"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"cList", "=", 
        RowBox[{"Coefficient", "[", 
         RowBox[{
          RowBox[{"genF", "[", "z", "]"}], ",", "z", ",", "theExp"}], "]"}]}],
        ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"f", "[", 
         RowBox[{"z_", ",", "k_"}], "]"}], ":=", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"cList", "[", 
            RowBox[{"[", "n", "]"}], "]"}], " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"Exp", "[", 
              RowBox[{"2", " ", "k", " ", "\[Pi]", " ", 
               RowBox[{"\[ImaginaryI]", "/", "cycleSize"}]}], "]"}], ")"}], 
            "^", 
            RowBox[{"(", 
             RowBox[{"cycleSize", " ", 
              RowBox[{"theExp", "[", 
               RowBox[{"[", "n", "]"}], "]"}]}], ")"}]}], " ", 
           RowBox[{"z", "^", 
            RowBox[{"theExp", "[", 
             RowBox[{"[", "n", "]"}], "]"}]}]}], ",", 
          RowBox[{"{", 
           RowBox[{"n", ",", "1", ",", 
            RowBox[{"Length", "[", "cList", "]"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"domain", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"1", "/", "50"}], ",", "estR"}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Table", "[", "\[IndentingNewLine]", " ", 
        RowBox[{
         RowBox[{"ParametricPlot3D", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"Re", "[", "z", "]"}], "+", 
               RowBox[{"Re", "[", "baseSingularPoint", "]"}]}], ",", 
              RowBox[{
               RowBox[{"Im", "[", "z", "]"}], "+", 
               RowBox[{"Im", "[", "baseSingularPoint", "]"}]}], ",", 
              RowBox[{"type", "[", 
               RowBox[{"f", "[", 
                RowBox[{"z", ",", 
                 RowBox[{"i", "-", "1"}]}], "]"}], "]"}]}], "}"}], "/.", 
            RowBox[{"z", "\[Rule]", 
             RowBox[{"r", " ", 
              RowBox[{"Exp", "[", 
               RowBox[{"\[ImaginaryI]", " ", "t"}], "]"}]}]}]}], ",", 
           RowBox[{"{", 
            RowBox[{"r", ",", 
             RowBox[{"domain", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", 
             RowBox[{"domain", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", 
             RowBox[{"-", "\[Pi]"}], ",", "\[Pi]"}], "}"}], ",", 
           RowBox[{"BoxRatios", "\[Rule]", 
            RowBox[{"{", 
             RowBox[{"1", ",", "1", ",", "1"}], "}"}]}], ",", 
           RowBox[{"PlotStyle", "->", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Opacity", "[", "0.55", "]"}], ",", 
              RowBox[{"colors", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], "}"}]}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "cycleSize"}], "}"}]}], "]"}]}]}], 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Show", "[", 
       RowBox[{"thePlots", ",", 
        RowBox[{"BoxRatios", "->", 
         RowBox[{"{", 
          RowBox[{"1", ",", "1", ",", "1"}], "}"}]}], ",", 
        RowBox[{"AxesEdge", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1"}], ",", 
             RowBox[{"-", "1"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", 
             RowBox[{"-", "1"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1"}], ",", 
             RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], ",", 
        RowBox[{"Axes", "->", "True"}], ",", 
        RowBox[{"FaceGridsStyle", "\[Rule]", 
         RowBox[{"Directive", "[", 
          RowBox[{"Black", ",", "Bold"}], "]"}]}], ",", 
        RowBox[{"AxesLabel", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Style", "[", 
            RowBox[{"\"\<Re[z]\>\"", ",", "12", ",", "Bold", ",", "Black"}], 
            "]"}], ",", 
           RowBox[{"Style", "[", 
            RowBox[{"\"\<Im[z]\>\"", ",", "12", ",", "Bold", ",", "Black"}], 
            "]"}], ",", 
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"ToString", "@", "type"}], "<>", "\"\<(w)\>\""}], ",", 
             "12", ",", "Bold", ",", "Black"}], "]"}]}], "}"}]}], ",", 
        RowBox[{"PlotRange", "->", "All"}], ",", 
        RowBox[{"ImageSize", "->", "300"}]}], "]"}], "*)"}], 
     "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]"}]}]], "Input",
