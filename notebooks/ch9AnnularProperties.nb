Cell[CellGroupData[{

Cell["Compute a set of summatory expansion terms", "Subsubsection",
 CellChangeTimes->{{3.9624637477887106`*^9, 
  3.9624637600456066`*^9}},ExpressionUUID->"b79371dd-f5cc-47c0-903f-\
f02e0aac6782"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
   "compute", " ", "summatory", " ", "function", " ", "power", " ", 
    "expansion", " ", "residue"}], " ", "\[IndentingNewLine]", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"contourRadius", "=", 
     RowBox[{"annularCenters", "[", 
      RowBox[{"[", "$selectedAnnulus932", "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"contourF", "[", "t_", "]"}], ":=", 
     RowBox[{"contourRadius", " ", 
      RowBox[{"Exp", "[", 
       RowBox[{"I", " ", "t"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"summatoryTermIndexes", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "5"}], ",", 
      RowBox[{"-", "4"}], ",", 
      RowBox[{"-", "3"}], ",", 
      RowBox[{"-", "2"}], ",", 
      RowBox[{"-", "1"}], ",", "0", ",", "1", ",", "2", ",", "3"}], "}"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"summatoryTerms", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{"\"\<theK: \>\"", ",", "theK"}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{"$doPolishFlag932", ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"intVal", "=", " ", 
            RowBox[{"NIntegrate", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"sF", "[", 
                RowBox[{
                 RowBox[{"contourF", "[", "t", "]"}], ",", 
                 RowBox[{"\"\<sumWP\>\"", "->", "$polishPrecision932"}]}], 
                "]"}], 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"Cos", "[", 
                  RowBox[{"t", " ", "theK"}], "]"}], "-", 
                 RowBox[{"I", " ", 
                  RowBox[{"Sin", "[", 
                   RowBox[{"t", " ", "theK"}], "]"}]}]}], ")"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"t", ",", 
                RowBox[{"-", "Pi"}], ",", "Pi"}], "}"}], ",", 
              RowBox[{"WorkingPrecision", "->", "$polishPrecision932"}]}], 
             "]"}]}], ";"}], "\[IndentingNewLine]", ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"intVal", "=", " ", 
            RowBox[{"NIntegrate", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"sF", "[", 
                RowBox[{
                 RowBox[{"contourF", "[", "t", "]"}], ",", 
                 RowBox[{"\"\<sumWP\>\"", "->", "MachinePrecision"}]}], "]"}], 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"Cos", "[", 
                  RowBox[{"t", " ", "theK"}], "]"}], "-", 
                 RowBox[{"I", " ", 
                  RowBox[{"Sin", "[", 
                   RowBox[{"t", " ", "theK"}], "]"}]}]}], ")"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"t", ",", 
                RowBox[{"-", "Pi"}], ",", "Pi"}], "}"}], ",", 
              RowBox[{"WorkingPrecision", "->", "MachinePrecision"}]}], 
             "]"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"coeff", "=", 
         RowBox[{
          FractionBox["1", 
           RowBox[{"2", " ", "Pi", " ", 
            RowBox[{"contourRadius", "^", 
             RowBox[{"(", "theK", ")"}]}]}]], "intVal"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"theK", ",", "coeff", ",", 
          RowBox[{"coeff", " ", 
           RowBox[{"z", "^", "theK"}]}]}], "}"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"theK", ",", "summatoryTermIndexes"}], "}"}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sumSeries", "=", 
     RowBox[{"Plus", "@@", 
      RowBox[{"summatoryTerms", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", 
         RowBox[{"-", "1"}]}], "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<summatory terms: \>\"", ",", 
      RowBox[{"sumSeries", "//", "N"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"residueTerm", "=", 
    RowBox[{"Coefficient", "[", 
     RowBox[{"sumSeries", ",", "z", ",", 
      RowBox[{"-", "1"}]}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<residueTerm: \>\"", ",", 
      RowBox[{"residueTerm", "//", "N"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<2PiI times residue: \>\"", ",", 
     RowBox[{
      RowBox[{"2", " ", "Pi", " ", "I", " ", "residueTerm"}], "//", "N"}]}], 
    "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<summatoryIntegral: \>\"", ",", 
      RowBox[{"summatoryIntegral", "//", "N"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.962192519981392*^9, 3.962192724337553*^9}, {
