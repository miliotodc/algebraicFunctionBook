       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"do", " ", "radial", " ", "integrations"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"theBranchSet", "=", 
