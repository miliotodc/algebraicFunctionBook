Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"getConjugateDataAtBAndC", "[", 
     RowBox[{
     "bVal_", ",", "cVal_", ",", "remSingPoint_", ",", "intVals_", ",", 
      "bSeries_", ",", "remConjList_", ",", "remPoleList_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "wVals", ",", "conjugatesAtB", ",", "difTable", ",", "pos", ",", 
        "bSeriesVals", ",", "bSeriesAtC", ",", "polishedValues"}], "}"}], ",",
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"bSeriesVals", "=", 
        RowBox[{"bSeries", "/.", 
         RowBox[{"z", "->", 
          RowBox[{"bVal", "-", "remSingPoint"}]}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"conjugatesAtB", "=", 
        RowBox[{"Table", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"difTable", "=", 
            RowBox[{
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{
                RowBox[{"intVals", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "-", "#"}], "]"}], "&"}], "/@",
              " ", "bSeriesVals"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"pos", "=", 
            RowBox[{
             RowBox[{"Position", "[", 
