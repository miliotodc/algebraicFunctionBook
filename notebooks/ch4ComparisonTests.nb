        "\"\<Results from both test are not consistent\>\"", ",", "Red"}], 
        "]"}], "]"}], ";"}], "\[IndentingNewLine]", ",", 
     "\[IndentingNewLine]", 
     RowBox[{
     "Print", "[", "\"\<Results from both test are consistent\>\"", "]"}]}], 
