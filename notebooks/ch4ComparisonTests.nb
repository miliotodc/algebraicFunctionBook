         "c1", ",", "c2", ",", "c3", ",", "estCLSPIndexes", ",", "dataTable", 
         ",", "m", ",", "k"}], "}"}], ",", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"cycleBaseSheets", "=", 
         RowBox[{"baseSheetLinks", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2", ",", "1"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"plotFlag", "=", "True"}], ";", "\[IndentingNewLine]", 
        RowBox[{"startTerms", "=", "10"}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"totalSheets", "=", 
         RowBox[{"Length", "@", "baseConjList"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"graphicsData", "=", 
         RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"at", "=", 
         RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"dataTable", "=", 
            RowBox[{"Table", "[", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"Print", "[", 
                RowBox[{
                "\"\<Analyzing base sheet for cycle  \>\"", ",", 
                 "theBranchNum"}], "]"}], ";", "\[IndentingNewLine]", 
               RowBox[{"seriesType", "=", 
                RowBox[{"theTypeTable", "[", 
                 RowBox[{"[", "theBranchNum", "]"}], "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"theSeriesNum", "=", 
                RowBox[{"cycleBaseSheets", "[", 
                 RowBox[{"[", "theBranchNum", "]"}], "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"cycleType", "=", 
                RowBox[{"baseSheetLinks", "[", 
