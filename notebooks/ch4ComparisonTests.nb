Cell[CellGroupData[{

Cell[TextData[StyleBox["getBranchContinuations",
 FontColor->RGBColor[1, 0, 0]]], "Subsection",
 CellChangeTimes->{{3.9289115079831915`*^9, 
  3.9289115115448947`*^9}},ExpressionUUID->"fe664503-8f3c-4fa1-a7bf-\
848dfb7409d0"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"getBranchContinuations", "[", 
     RowBox[{
     "nextSingularIndex_", ",", "currentBranchList_", ",", 
      "continuationSummary_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "tempBranchList", ",", "nextBranch", ",", "nextBranchSheets", ",", 
        "currentPos", ",", "basePoleLinks", ",", "nextPoleLinks", ",", 
        "nextLinks", ",", "tempCLSPList"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"tempBranchList", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"tempCLSPList", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"nextBranch", "=", 
           RowBox[{"currentBranchList", "[", 
            RowBox[{"[", "index", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"nextBranchSheets", "=", 
           RowBox[{"nextBranch", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{"$getBranchContinuationsFlag", ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{"\"\<nextBranch: \>\"", ",", "nextBranch"}], "]"}], ";",
              "\[IndentingNewLine]", 
             RowBox[{"Print", "[", 
              RowBox[{"\"\<nextBranchSheets: \>\"", ",", "nextBranchSheets"}],
               "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", "\[IndentingNewLine]", " ", 
           RowBox[{
           "now", " ", "check", " ", "if", " ", "these", " ", "branch", " ", 
            "sheets", " ", "are", " ", "continuous", " ", "to", " ", "last", 
            " ", "next", " ", "singular", " ", "point"}], 
           "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
          RowBox[{"(*", "  ", "*)"}], "\[IndentingNewLine]", 
          RowBox[{"currentPos", "=", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"Position", "[", 
                RowBox[{
                 RowBox[{"continuationSummary", "[", 
                  RowBox[{"[", 
                   RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", 
                 RowBox[{"x_", "/;", 
                  RowBox[{"x", "==", "#"}]}]}], "]"}], "&"}], "/@", " ", 
              "nextBranchSheets"}], ")"}], "//", "Flatten"}]}], " ", ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"basePoleLinks", "=", 
           RowBox[{
            RowBox[{"continuationSummary", "[", 
             RowBox[{"[", 
              RowBox[{"currentPos", ",", "3", ",", "2"}], "]"}], "]"}], "//", 
            "Flatten"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"nextPoleLinks", "=", 
           RowBox[{
            RowBox[{"continuationSummary", "[", 
             RowBox[{"[", 
              RowBox[{"currentPos", ",", "5", ",", "2"}], "]"}], "]"}], "//", 
            "Flatten"}]}], ";", "\[IndentingNewLine]", " ", 
          RowBox[{"nextLinks", "=", 
           RowBox[{"continuationSummary", "[", 
            RowBox[{"[", 
             RowBox[{"currentPos", ",", "4"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{"$getBranchContinuationsFlag", ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{
              "\"\<     Branch \>\"", ",", "nextBranch", ",", 
               "\"\< currentContinuationDataPos: \>\"", ",", "currentPos"}], 
              "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"Print", "[", 
              RowBox[{"\"\<     basePoleLinks: \>\"", ",", "basePoleLinks"}], 
              "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"Print", "[", 
              RowBox[{"\"\<     nextPoleLinks: \>\"", ",", "nextPoleLinks"}], 
              "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"Print", "[", 
              RowBox[{
               RowBox[{"Style", "[", 
                RowBox[{"\"\<     nextLinks: \>\"", ",", "Red"}], "]"}], ",", 
               "nextLinks"}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], 
          ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"nextLinks", "==", 
              RowBox[{"ConstantArray", "[", 
               RowBox[{"1", ",", 
                RowBox[{"Length", "@", "nextBranchSheets"}]}], "]"}]}], "  ", 
             "&&", "\[IndentingNewLine]", 
             RowBox[{"basePoleLinks", "==", 
              RowBox[{"{", "}"}]}], "  ", "&&", "\[IndentingNewLine]", 
             RowBox[{"nextPoleLinks", "==", 
              RowBox[{"{", "}"}]}]}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{
               RowBox[{"Style", "[", 
                RowBox[{"\"\<     Branch \>\"", ",", "Blue"}], "]"}], ",", 
               RowBox[{"Style", "[", 
                RowBox[{"nextBranch", ",", "Blue"}], "]"}], ",", 
               RowBox[{"Style", "[", 
                RowBox[{"\"\< continues onto sing index \>\"", ",", "Blue"}], 
                "]"}], ",", 
               RowBox[{"Style", "[", 
                RowBox[{"nextSingularIndex", ",", "Blue"}], "]"}]}], "]"}], 
             ";", "\[IndentingNewLine]", 
             RowBox[{"AppendTo", "[", 
              RowBox[{"tempBranchList", ",", "nextBranch"}], "]"}], ";"}], 
            "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{
               RowBox[{"Style", "[", 
                RowBox[{"\"\<     Branch \>\"", ",", "Red"}], "]"}], ",", 
               RowBox[{"Style", "[", 
                RowBox[{"nextBranch", ",", "Red"}], "]"}], ",", 
               RowBox[{"Style", "[", 
                RowBox[{
                "\"\< doesn't continue to next sing point \>\"", ",", "Red"}],
                 "]"}], ",", "nextSingularIndex"}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
              "$getBranchContinuationsFlag", ",", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"Print", "[", 
                 RowBox[{
                 "\"\<     assigning \>\"", ",", "nextSingularIndex", ",", 
                  " ", "\"\< to CLSP\>\""}], "]"}], ";"}]}], 
              "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"AppendTo", "[", 
              RowBox[{"tempCLSPList", ",", 
               RowBox[{"{", 
                RowBox[{"nextBranch", ",", "nextSingularIndex"}], "}"}]}], 
              "]"}], ";"}]}], "\[IndentingNewLine]", "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"index", ",", "1", ",", 
           RowBox[{"Length", "@", "currentBranchList"}]}], "}"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"\"\<     tempBranchList: \>\"", ",", "tempBranchList"}], 
          "]"}], ";"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"tempBranchList", ",", "tempCLSPList"}], "}"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]"}]], "Input",
