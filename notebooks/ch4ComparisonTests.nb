                  RowBox[{"theBranchNum", ",", "1"}], "]"}], "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"seriesLength", "=", 
                RowBox[{"Length", "@", 
                 RowBox[{"baseSeries", "[", 
                  RowBox[{"[", "theSeriesNum", "]"}], "]"}]}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"theexp", "=", 
                RowBox[{"Exponent", "[", 
                 RowBox[{
                  RowBox[{"baseSeries", "[", 
                   RowBox[{"[", "theSeriesNum", "]"}], "]"}], ",", "z", ",", 
                  "List"}], "]"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"lcm", "=", 
                RowBox[{"LCM", "@@", 
                 RowBox[{"(", 
                  RowBox[{"Denominator", "@", "theexp"}], ")"}]}]}], ";", 
               "\n", "                      ", 
               RowBox[{"numVals", "=", 
                RowBox[{"lcm", " ", "theexp"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"clist", "=", 
                RowBox[{"Coefficient", "[", 
