                    RowBox[{"(", 
                    RowBox[{"c0", "+", 
                    RowBox[{"c1", " ", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}]}], ")"}]}], ")"}], "&"}],
                     "/@", "dataVals"}], "]"}], ",", 
