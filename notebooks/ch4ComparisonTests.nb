Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{"uniquely", " ", "name", " ", "each", " ", "branch"}], 
   "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"baseSheetNumbers", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Min", "@", "#"}], "&"}], " ", "/@", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "&"}], "/@", "baseSheetLinks"}], 
       ")"}]}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"seriesLengths", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", "#", "]"}], "&"}], "/@", " ", 
      RowBox[{"baseSeries", "[", 
       RowBox[{"[", "baseSheetNumbers", "]"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{"theExpList", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Exponent", "[", 
        RowBox[{"#", ",", "z", ",", "List"}], "]"}], "&"}], "/@", " ", 
      RowBox[{"baseSeries", "[", 
       RowBox[{"[", "baseSheetNumbers", "]"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"minExpList", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Min", "[", "#", "]"}], "&"}], " ", "/@", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"Select", "[", 
          RowBox[{"#", ",", 
           RowBox[{
            RowBox[{"#", "!=", "0"}], "&"}]}], "]"}], "&"}], "/@", " ", 
        "theExpList"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cycleTypes", "=", 
     RowBox[{"baseSheetLinks", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"multiType", "[", 
      RowBox[{"a_Integer", ",", "b_String"}], "]"}], ":=", 
     RowBox[{
      RowBox[{
      "StringTemplate", "[", 
       "\"\<\!\(\*SubscriptBox[\(\[InvisiblePrefixScriptBase]\), \
\((`1`)\)]\)`2`\>\"", "]"}], "[", 
      RowBox[{
       RowBox[{"ToString", "@", "a"}], ",", "b"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"newType", "[", 
