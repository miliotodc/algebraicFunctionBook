        "j", ",", "typeLoc", ",", "i", ",", "typeTable", ",", "typeLinks"}], 
       " ", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", "\[IndentingNewLine]", " ", 
       RowBox[{"uniquely", " ", "name", " ", "each", " ", "branch"}], 
       "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"baseSheetNumbers", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"Min", "@", "#"}], "&"}], " ", "/@", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "&"}], "/@", "baseSheetLinks"}], 
          ")"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"seriesLengths", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "#", "]"}], "&"}], "/@", " ", 
         RowBox[{"baseSeries", "[", 
          RowBox[{"[", "baseSheetNumbers", "]"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", " ", 
       RowBox[{"theExpList", "=", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"Exponent", "[", 
           RowBox[{"#", ",", "z", ",", "List"}], "]"}], "&"}], "/@", " ", 
         RowBox[{"baseSeries", "[", 
          RowBox[{"[", "baseSheetNumbers", "]"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"minExpList", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"Min", "[", "#", "]"}], "&"}], " ", "/@", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Select", "[", 
             RowBox[{"#", ",", 
              RowBox[{
               RowBox[{"#", "!=", "0"}], "&"}]}], "]"}], "&"}], "/@", " ", 
           "theExpList"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"cycleTypes", "=", 
        RowBox[{"baseSheetLinks", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"multiType", "[", 
         RowBox[{"a_Integer", ",", "b_String"}], "]"}], ":=", 
        RowBox[{
         RowBox[{
         "StringTemplate", "[", 
          "\"\<\!\(\*SubscriptBox[\(\[InvisiblePrefixScriptBase]\), \
\((`1`)\)]\)`2`\>\"", "]"}], "[", 
         RowBox[{
          RowBox[{"ToString", "@", "a"}], ",", "b"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"newType", "[", 
         RowBox[{
