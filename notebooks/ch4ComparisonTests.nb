         RowBox[{"Style", "[", 
          RowBox[{
           SubscriptBox["s", "baseSingularIndex"], ",", "16", ",", "Black", 
           ",", "Bold"}], "]"}]}], "}"}], ",", 
       RowBox[{"Alignment", "\[Rule]", "Center"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"finalSummaryReport", "=", 
     RowBox[{"Prepend", "[", 
      RowBox[{"finalSummary", ",", 
       RowBox[{"{", 
        RowBox[{
        "\"\<Index\>\"", ",", "\"\<Sheet\>\"", ",", "\"\<Type\>\"", ",", 
         "\"\<Group\>\"", ",", "\"\<est. CLSP\>\"", ",", "\"\<act. CLSP\>\"", 
         ",", "\"\<est. R\>\"", ",", "\"\<act. R\>\"", ",", "\"\<Dif\>\"", 
         ",", "\"\<Series Size\>\""}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Column", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"finalConvergenceReportHeader", ",", 
       RowBox[{"Grid", "[", 
        RowBox[{"finalSummaryReport", ",", 
         RowBox[{"Dividers", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"{", "True", "}"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"True", ",", "True", ",", 
              RowBox[{"{", "False", "}"}], ",", "True"}], "}"}]}], "}"}]}]}], 
        "]"}]}], "}"}], ",", 
     RowBox[{"Alignment", "\[Rule]", "Center"}]}], "]"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{
    "generate", " ", "condensed", " ", "convergence", " ", "report", " ", 
     "for", " ", "all", " ", "Covergence", " ", "Results", " ", "for", " ", 
     "book"}], "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{"maxGenOrders", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"getMaxOrder", "[", "#", "]"}], "&"}], "/@", " ", 
      RowBox[{"Range", "[", 
       RowBox[{"Length", "@", "finalSummary"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"genPrecisions", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Precision", "@", 
        RowBox[{"baseSeries", "[", 
         RowBox[{"[", "#", "]"}], "]"}]}], "&"}], "/@", " ", 
      RowBox[{"finalSummary", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "2"}], "]"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"convergenceSummaryArray", "=", 
     RowBox[{"MapThread", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"#1", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", 
          RowBox[{"#1", "[", 
           RowBox[{"[", "3", "]"}], "]"}], ",", 
          RowBox[{"#1", "[", 
           RowBox[{"[", "4", "]"}], "]"}], ",", 
          RowBox[{"#1", "[", 
