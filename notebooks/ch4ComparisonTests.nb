Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
   "find", " ", "list", " ", "of", " ", "removable", " ", "singular", " ", 
    "points"}], "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"theSequence", "=", 
     RowBox[{"Range", "[", 
      RowBox[{"Length", "@", "$theSingularList"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"PrintTemporary", "[", 
     RowBox[{"\"\<File index: \>\"", ",", 
      RowBox[{"Dynamic", "@", "fIndex"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"removableTable", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"fIndex", "=", "cIndex"}], ";", "\[IndentingNewLine]", 
        RowBox[{"nextIndex", "=", 
         RowBox[{"theSequence", "[", 
          RowBox[{"[", "cIndex", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"TrueQ", "@", 
           RowBox[{"FileExistsQ", "@", 
            RowBox[{"seriesFileName", "[", 
             RowBox[{"$theTestCase", ",", "nextIndex"}], "]"}]}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
             "newSingularIndex", ",", "newSing", ",", "baseCycleMetric", ",", 
              "basePoleList", ",", "newConjList", ",", "baseRemovableList", 
              ",", "baseSeries", ",", "baseSheetLinks", ",", 
              "baseSingSequence", ",", "baseBranchTypeArray", ",", 
              "baseSeriesMIVPTable"}], "}"}], "=", 
            RowBox[{"Import", "[", 
             RowBox[{"seriesFileName", "[", 
              RowBox[{"$theTestCase", ",", "nextIndex"}], "]"}], "]"}]}], 
           ";"}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{
             RowBox[{"Style", "[", 
              RowBox[{"\"\<File not found: \>\"", ",", "Red"}], "]"}], ",", 
             RowBox[{"seriesFileName", "[", "nextIndex", "]"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Abort", "[", "]"}], ";"}]}], "\[IndentingNewLine]", "]"}],
         ";", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"nextIndex", ",", "theSequence"}], "}"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"cIndex", ",", "1", ",", "2"}], "}"}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"removableSingularFlag", "=", "False"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "@", 
        RowBox[{"Flatten", "@", 
         RowBox[{"removableTable", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2"}], "]"}], "]"}]}]}], ">", "0"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Print", "[", "\"\<found removable singular points\>\"", "]"}],
        ";", "\[IndentingNewLine]", 
       RowBox[{"removableSingularFlag", "=", "True"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<removableTable: \>\"", ",", 
         RowBox[{"removableTable", "//", "N"}]}], "]"}], ";"}], 
      "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
      RowBox[{
      "Print", "[", "\"\<No removable singular points found\>\"", "]"}]}], 
     "\[IndentingNewLine]", "]"}], ";"}], "\n"}]}]], "Input",
