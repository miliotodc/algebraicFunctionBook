    RowBox[{"Dynamic", "@", "indexName"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"removableList", "=", 
   RowBox[{"Table", "[", " ", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"indexName", "=", "index"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", " ", 
      RowBox[{"dataList", "=", 
       RowBox[{"Import", "[", 
        RowBox[{"seriesFileName", "[", 
         RowBox[{"$theTestCase", ",", "index"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
