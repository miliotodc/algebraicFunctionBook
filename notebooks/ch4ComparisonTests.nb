       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"baseSeriesMIVPTable", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "@", "dataList"}], "==", "9"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "newSingularIndex", ",", "newSing", ",", "baseCycleMetric", ",", 
            "basePoleList", ",", "newConjList", ",", "baseRemovableList", ",",
             "baseSeries", ",", "baseSheetLinks", ",", "baseSingSequence"}], 
           "}"}], "=", "dataList"}], ";"}], "\[IndentingNewLine]", ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "@", "dataList"}], "==", "10"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{
              "newSingularIndex", ",", "newSing", ",", "baseCycleMetric", ",",
                "basePoleList", ",", "newConjList", ",", "baseRemovableList", 
               ",", "baseSeries", ",", "baseSheetLinks", ",", 
               "baseSingSequence", ",", "baseBranchTypeArray"}], "}"}], "=", 
             "dataList"}], ";"}], "\[IndentingNewLine]", ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{
              "newSingularIndex", ",", "newSing", ",", "baseCycleMetric", ",",
                "basePoleList", ",", "newConjList", ",", "baseRemovableList", 
