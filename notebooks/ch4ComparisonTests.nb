                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"1", "/", 
                    RowBox[{"numVals", "[", 
                    RowBox[{"[", "k", "]"}], "]"}]}], ",", 
                    RowBox[{"N", "[", 
                    RowBox[{
                    RowBox[{"1", "/", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Abs", "[", 
                    RowBox[{"clist", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], "]"}], "^", 
                    RowBox[{"(", 
                    RowBox[{"cycleType", "/", 
                    RowBox[{"numVals", "[", 
                    RowBox[{"[", "k", "]"}], "]"}]}], ")"}]}], ")"}]}], ",", 
                    "25"}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
                  RowBox[{"{", 
