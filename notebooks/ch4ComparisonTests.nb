        "singularSequence_", ",", "theSingularList_", ",", 
       "baseSingularIndex_", ",", "baseConjList_", ",", "theTestCase_"}], 
      "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
