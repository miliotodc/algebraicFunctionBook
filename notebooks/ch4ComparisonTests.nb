  3.9786273984936533`*^9}},ExpressionUUID->"19208384-40dd-4d81-8933-\
37b8053c4054"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
   "retrieve", " ", "singular", " ", "points", " ", "from", " ", "disc"}], 
   "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"TrueQ", "@", 
       RowBox[{"FileExistsQ", "@", 
        RowBox[{"singularDataFileName", "[", "$theTestCase", "]"}]}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"theData", "=", 
        RowBox[{"Import", "[", 
         RowBox[{"singularDataFileName", "[", "$theTestCase", "]"}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"\"\<sing file length: \>\"", ",", 
           RowBox[{"Length", "@", "theData"}]}], "]"}], ";"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "$theSingularList", ",", "$poleIndexes", ",", "$minRadiusArray", ",",
           "res", ",", "$zeroIndexes", ",", "$nearestDistanceArray", ",", 
          "$rNormArray"}], "}"}], "=", "theData"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Total singular points: \>\"", ",", 
         RowBox[{"Length", "@", "$theSingularList"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Precision of singular points: \>\"", ",", 
         RowBox[{"Precision", "@", "$theSingularList"}]}], "]"}], ";", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Total poles: \>\"", ",", 
         RowBox[{"Length", "@", "$poleIndexes"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{
         RowBox[{
         "Style", "[", "\"\<\!\(\*SubscriptBox[\(s\), \(p\)]\) indexes: \>\"",
           "]"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{"$poleIndexes", ",", "Red"}], "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{
         RowBox[{
         "Style", "[", "\"\<\!\(\*SubscriptBox[\(s\), \(q\)]\) indexes: \>\"",
           "]"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{"$zeroIndexes", ",", "Blue"}], "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"cList", "=", 
        RowBox[{"CoefficientList", "[", 
         RowBox[{"$theFunction", ",", "w"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"maxZ", "=", 
        RowBox[{"Max", "@", 
         RowBox[{"Flatten", "@", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"Exponent", "[", 
              RowBox[{"#", ",", "z", ",", "List"}], "]"}], "&"}], "/@", " ", 
            "cList"}], ")"}]}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"$theSingularList", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "==", "0"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"\"\<Smallest sing power: \>\"", ",", 
            RowBox[{"N", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"$theSingularList", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "^", "maxZ"}], ",", "10"}], 
             "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"\"\<Smallest sing power: \>\"", ",", 
            RowBox[{"N", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"$theSingularList", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "^", "maxZ"}], ",", "10"}], 
             "]"}]}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", " ", 
       "\[IndentingNewLine]", 
       RowBox[{"minSingSeparation", "=", 
        RowBox[{
         RowBox[{"3", 
          RowBox[{"Min", "@", "$minRadiusArray"}]}], "//", "N"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"minSingAccFactor", "=", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{
           RowBox[{"MantissaExponent", "[", "minSingSeparation", "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], "+", "5"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<minSingAccFactor: \>\"", ",", "minSingAccFactor"}], 
        "]"}], ";"}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"singularDataFileName", "[", "$theTestCase", "]"}], "<>", 
           "\"\< not found during import.\>\""}], " ", ",", "Red"}], "]"}], 
        "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], 
   "\[IndentingNewLine]"}]}]], "Input",
