Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"getZeroIndexes", "[", 
     RowBox[{"theFunction_", ",", "theSingularList_", ",", 
      RowBox[{"diag_", ":", "False"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "wKeys", ",", "a0Rule", ",", "a1Rule", ",", "theZeroPoints", ",", 
        "zeroPrecision", ",", "duplicateError", ",", "zeroIndexes", ",", 
        "theZeroList", ",", "singPrecision", ",", "difTable", ",", "maxDif", 
        ",", "rootPrecisionTable", ",", "dif"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"wKeys", "=", 
        RowBox[{"CoefficientRules", "[", 
         RowBox[{
         "theFunction", ",", "w", ",", "\"\<NegativeLexicographic\>\""}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"a0Rule", "=", 
        RowBox[{"Normal", "@", 
         RowBox[{"KeyTake", "[", 
          RowBox[{"wKeys", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", "0", "}"}], ",", "z"}], "}"}]}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"singPrecision", "=", 
        RowBox[{"Floor", "@", 
         RowBox[{"Precision", "@", "theSingularList"}]}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "@", "a0Rule"}], ">", "0"}], " ", ",", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{"found", " ", "a_", "0"}], " ", "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Exponent", "[", 
              RowBox[{
               RowBox[{"a0Rule", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "2"}], "]"}], "]"}], ",", "z"}], "]"}], 
             ">", "0"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"a1Rule", "=", 
              RowBox[{"Normal", "@", 
               RowBox[{"KeyTake", "[", 
                RowBox[{"wKeys", ",", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"{", "1", "}"}], ",", "z"}], "}"}]}], "]"}]}]}], 
             ";", "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Length", "@", "a1Rule"}], ">", "0"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"(*", " ", 
                RowBox[{
                "now", " ", "have", " ", "a0", " ", "and", " ", "a1", " ", 
                 "in", " ", "function"}], " ", "*)"}], "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Exponent", "[", 
                    RowBox[{
                    RowBox[{"a1Rule", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}], ",", "z"}], "]"}], 
                   ">", "0"}], ",", "\[IndentingNewLine]", 
                  RowBox[{"(*", " ", 
                   RowBox[{
                    RowBox[{
                    "a1", " ", "is", " ", "a", " ", "poly", " ", "degree"}], 
                    ">", "0"}], " ", "*)"}], "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"a0Rule", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}], "===", 
                    RowBox[{"a1Rule", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{"(*", " ", 
                    RowBox[{
