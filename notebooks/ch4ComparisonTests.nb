                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "^", "2"}]}]}], ")"}]}], 
                    ")"}], "&"}], "/@", " ", "dataVals"}], "]"}], ",", 
                    RowBox[{"And", "@@", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"c0", "+", 
                    RowBox[{"c1", " ", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "+", 
                    RowBox[{"c2", " ", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "^", "2"}]}]}], ")"}], "<=", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "&"}], "/@", " ",
                     "dataVals"}], ")"}]}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"c0", ",", "c1", ",", "c2"}], "}"}]}], "]"}], "[", 
                   RowBox[{"[", "2", "]"}], "]"}]}], "//", "N"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"cubicLine", "=", 
                RowBox[{
                 RowBox[{"c0", "+", 
                  RowBox[{"c1", " ", "x"}], "+", 
                  RowBox[{"c2", " ", 
