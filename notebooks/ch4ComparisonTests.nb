8f8706715a37"],

Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{
   RowBox[{
    RowBox[{"getContinuationsC", "[", 
     RowBox[{
     "aIndex_", ",", "bIndex_", ",", "pointA_", ",", "aSingularPoint_", ",", 
      "aSeries_", ",", "aConjList_", ",", "aPoleList_", ",", "polishWAtA_", 
      ",", "pointB_", ",", "pointC_", ",", "bSingularPoint_", ",", "bSeries_",
       ",", "bConjList_", ",", "bPoleList_", ",", 
      "currentRootTableIndexes_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "wAtA", ",", "intResultsAtB", ",", "w0", ",", "theSol", ",", 
        "conjDataAtBAndC", ",", "integrationPath", ",", "wDeriv", ",", 
        "bSeriesVals", ",", "conjugatesAtB", ",", "difTable", ",", "pos", ",",
         "bSeriesAtC", ",", "polishedValues", ",", "aData"}], "}"}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"integrationPath", "[", "t_", "]"}], ":=", 
        RowBox[{
         RowBox[{"pointA", 
          RowBox[{"(", 
           RowBox[{"1", "-", "t"}], ")"}]}], "+", 
         RowBox[{"pointB", " ", "t"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"integrationPathSave", ",", 
         RowBox[{"integrationPath", "[", "t", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{"$getContinuationsCFlag", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"\"\<integrationPath: \>\"", ",", 
            RowBox[{"N", "[", 
             RowBox[{
              RowBox[{"Expand", "@", 
               RowBox[{"integrationPath", "[", "t", "]"}]}], ",", "15"}], 
             "]"}]}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"wDeriv", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"w", "'"}], "[", "t", "]"}], "\[Equal]", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", 
              RowBox[{"(", 
               FractionBox[
                RowBox[{"D", "[", 
                 RowBox[{"$theFunction", ",", "z"}], "]"}], 
                RowBox[{"D", "[", 
                 RowBox[{"$theFunction", ",", "w"}], "]"}]], ")"}]}], " ", 
             RowBox[{"D", "[", 
              RowBox[{
               RowBox[{"integrationPath", "[", "t", "]"}], ",", "t"}], 
              "]"}]}], ")"}], "/.", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"w", "\[Rule]", 
              RowBox[{"w", "[", "t", "]"}]}], ",", 
             RowBox[{"z", "\[Rule]", 
              RowBox[{"integrationPath", "[", "t", "]"}]}]}], "}"}]}], 
          ")"}]}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{"$getContinuationsCFlag", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{
           "\"\<Entering getContinuationsC from singular index \>\"", ",", 
            "aIndex", ",", "\"\< to \>\"", ",", "bIndex"}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<     Precision of integration path: \>\"", ",", 
            RowBox[{"Precision", "@", 
             RowBox[{"integrationPath", "[", "t", "]"}]}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<     pointA: \>\"", ",", 
            RowBox[{"N", "[", 
             RowBox[{"pointA", ",", "15"}], "]"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<     pointB: \>\"", ",", 
            RowBox[{"N", "[", 
             RowBox[{"pointB", ",", "15"}], "]"}]}], "]"}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"aData", "=", 
        RowBox[{"MapThread", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"#1", ",", "#2", ",", "#3"}], "}"}], "&"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Range", "[", 
             RowBox[{"Length", "@", "aSeries"}], "]"}], ",", "aConjList", ",",
             "aPoleList"}], "}"}]}], "]"}]}], ";", " ", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"aData", "=", 
          RowBox[{"MapThread", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"#1", ",", "#2", ",", "#3"}], "}"}], "&"}], ",", 
            RowBox[{"{", 
             RowBox[{"currentRootTableIndexes", ",", 
              RowBox[{"aConjList", "[", 
               RowBox[{"[", "currentRootTableIndexes", "]"}], "]"}], ",", 
              RowBox[{"aPoleList", "[", 
               RowBox[{"[", "currentRootTableIndexes", "]"}], "]"}]}], 
             "}"}]}], "]"}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"intResultsAtB", "=", 
        RowBox[{"Table", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{"$getContinuationsCFlag", ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Print", "[", 
               RowBox[{
               "\"\<     Integrating index \>\"", ",", "n", ",", 
                "\"\< to B:\>\""}], "]"}], ";"}]}], "\[IndentingNewLine]", 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"w0", "=", 
            RowBox[{"polishWAtA", "[", 
             RowBox[{"[", "n", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{"$stiffnessSwitchingFlag", ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"theSol", "=", 
               RowBox[{"NDSolveValue", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"wDeriv", ",", 
                   RowBox[{
                    RowBox[{"w", "[", "0", "]"}], "\[Equal]", "w0"}]}], "}"}],
                  ",", "w", ",", 
                 RowBox[{"{", 
                  RowBox[{"t", ",", "0", ",", "1"}], "}"}], ",", 
                 RowBox[{"MaxSteps", "\[Rule]", "2000000"}], ",", 
                 RowBox[{"(*", 
                  RowBox[{
                   RowBox[{"MaxStepSize", "\[Rule]", 
                    RowBox[{"1", "/", "1000"}]}], ","}], "*)"}], 
                 RowBox[{"WorkingPrecision", "\[Rule]", "40"}], ",", 
                 RowBox[{"Method", " ", "\[Rule]", " ", 
                  RowBox[{"{", 
                   RowBox[{"\"\<StiffnessSwitching\>\"", ",", 
                    RowBox[{"\"\<NonstiffTest\>\"", "->", "False"}]}], 
                   "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"theSol", "=", 
               RowBox[{"NDSolveValue", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"wDeriv", ",", 
                   RowBox[{
                    RowBox[{"w", "[", "0", "]"}], "\[Equal]", "w0"}]}], "}"}],
                  ",", "w", ",", 
                 RowBox[{"{", 
                  RowBox[{"t", ",", "0", ",", "1"}], "}"}], ",", 
                 RowBox[{"MaxSteps", "\[Rule]", "2000000"}], ",", 
                 RowBox[{"(*", 
                  RowBox[{
                   RowBox[{"MaxStepSize", "\[Rule]", 
                    RowBox[{"1", "/", "1000"}]}], ","}], "*)"}], 
                 RowBox[{"WorkingPrecision", "\[Rule]", "40"}]}], "]"}]}], 
              ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"theSol", "[", "1", "]"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"n", ",", "1", ",", 
            RowBox[{"Length", "@", "polishWAtA"}]}], "}"}]}], 
         "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{"$getContinuationsCFlag", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"\"\<     integration results: \>\"", ",", 
            RowBox[{"intResultsAtB", "//", "N"}]}], "]"}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", "\[IndentingNewLine]", " ", 
        RowBox[{
        "now", " ", "get", " ", "conjugated", " ", "stats", " ", "at", " ", 
         "B", " ", "and", " ", 
         RowBox[{"C", ":"}]}], "\[IndentingNewLine]", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"bSeriesVals", "=", 
        RowBox[{"bSeries", "/.", 
         RowBox[{"z", "->", 
          RowBox[{"pointB", "-", "bSingularPoint"}]}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{"$getContinuationsCFlag", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"\"\<     bSingularPoint: \>\"", ",", 
            RowBox[{"bSingularPoint", "//", "N"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<     bSeriesVals: \>\"", ",", 
            RowBox[{"bSeriesVals", "//", "N"}]}], "]"}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"conjugatesAtB", "=", 
        RowBox[{"Table", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"difTable", "=", 
            RowBox[{
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{
                RowBox[{"intResultsAtB", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "-", "#"}], "]"}], "&"}], "/@",
              " ", "bSeriesVals"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{"$getContinuationsCFlag", ",", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"Print", "[", 
                 RowBox[{"\"\<     intResultsAtB[[i]]\>\"", ",", 
                  RowBox[{"intResultsAtB", "//", "N"}]}], "]"}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"Print", "[", 
                 RowBox[{"\"\<     difTable: \>\"", ",", 
                  RowBox[{"difTable", "//", "N"}]}], "]"}], ";"}]}], 
              "\[IndentingNewLine]", "]"}], ";"}], "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{"pos", "=", 
            RowBox[{
             RowBox[{"Position", "[", 
              RowBox[{"difTable", ",", 
               RowBox[{"Min", "@", "difTable"}]}], "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"bSeriesAtC", "=", 
            RowBox[{
             RowBox[{"bSeries", "[", 
              RowBox[{"[", "pos", "]"}], "]"}], "/.", 
             RowBox[{"z", "->", 
              RowBox[{"(", 
               RowBox[{"pointC", "-", "bSingularPoint"}], ")"}]}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"i", ",", 
             RowBox[{"bSeriesVals", "[", 
              RowBox[{"[", "pos", "]"}], "]"}], ",", "pos", ",", 
             RowBox[{"bConjList", "[", 
              RowBox[{"[", "pos", "]"}], "]"}], ",", 
             RowBox[{"bPoleList", "[", 
              RowBox[{"[", "pos", "]"}], "]"}], ",", "bSeriesAtC"}], "}"}]}], 
          ",", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", 
             RowBox[{"Length", "@", "intResultsAtB"}]}], "}"}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{"Length", "@", "intResultsAtB"}]}], "}"}]}], 
         "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"polishedValues", "=", 
        RowBox[{"polishSeries", "[", 
         RowBox[{"pointC", ",", "bSingularPoint", ",", 
          RowBox[{"conjugatesAtB", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "6"}], "]"}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{"$getContinuationsCFlag", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
          "Print", "[", "\"\<Exiting getContinuationsCFlag\>\"", "]"}], 
          ";"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"#1", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{"#1", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ",", 
            RowBox[{"#1", "[", 
             RowBox[{"[", "3", "]"}], "]"}], ",", 
            RowBox[{"#2", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ",", 
            RowBox[{"#2", "[", 
             RowBox[{"[", "3", "]"}], "]"}], ",", 
            RowBox[{"#2", "[", 
             RowBox[{"[", "4", "]"}], "]"}], ",", 
