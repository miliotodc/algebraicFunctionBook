          RowBox[{"#1", "[", 
           RowBox[{"[", "6", "]"}], "]"}], ",", 
          RowBox[{"#1", "[", 
           RowBox[{"[", "8", "]"}], "]"}], ",", 
          RowBox[{"#1", "[", 
           RowBox[{"[", "10", "]"}], "]"}], ",", "#3", ",", 
          RowBox[{"Floor", "@", "#2"}]}], "}"}], "&"}], ",", 
       RowBox[{"{", 
        RowBox[{"finalSummary", ",", "genPrecisions", ",", 
         RowBox[{"maxGenOrders", "[", 
          RowBox[{"[", 
