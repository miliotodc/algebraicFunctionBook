                    RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "&"}], "/@", " ",
                     "dataVals"}], ")"}]}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"c0", ",", "c1"}], "}"}]}], "]"}], "[", 
