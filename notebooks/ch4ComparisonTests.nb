            RowBox[{
             RowBox[{"Length", "@", "nextLocArray"}], "!=", "1"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{"Style", "[", 
               RowBox[{
               "\"\<getIntegrationData::Did not find next point \
location!\>\"", ",", "Red"}], "]"}], "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"Print", "[", 
              RowBox[{"\"\<     myNextPoints: \>\"", ",", 
               RowBox[{"N", "[", 
                RowBox[{"myNextPoints", ",", "45"}], "]"}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"Print", "[", 
              RowBox[{"\"\<     minVal:       \>\"", ",", 
               RowBox[{"N", "[", 
                RowBox[{"minVal", ",", "45"}], "]"}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"Abort", "[", "]"}], ";"}]}], "\[IndentingNewLine]", 
           "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"nextNDZ", "=", 
           RowBox[{"nextSol", "[", 
            RowBox[{"[", 
             RowBox[{"nextLocArray", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", "1"}], "]"}], "]"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"otherIndex", "=", "1"}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"Print", "[", 
             RowBox[{
              RowBox[{"Style", "[", 
               RowBox[{"\"\<nextLoc: \>\"", ",", "Red"}], "]"}], ",", 
