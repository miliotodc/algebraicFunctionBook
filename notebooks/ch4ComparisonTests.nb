                  RowBox[{"c3", " ", 
                   RowBox[{"x", "^", "3"}]}]}], "/.", " ", 
                 RowBox[{
                  RowBox[{"NMinimize", "[", 
                   RowBox[{
                    RowBox[{"{", 
