Cell[CellGroupData[{

Cell["integrateOverBeta", "Subsection",
 CellChangeTimes->{{3.928684164266532*^9, 
  3.928684167187718*^9}},ExpressionUUID->"fb9517b2-a267-4f27-9801-\
8579b0887b2e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"integrateOverBeta", "[", 
     RowBox[{"pointA_", ",", "pointB_", ",", "polishedWAtA_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "intTableAtB", ",", "integrationPath", ",", "wDeriv", ",", "theSol", 
        ",", "w0"}], "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"integrationPath", "[", "t_", "]"}], ":=", 
        RowBox[{
         RowBox[{"pointA", 
          RowBox[{"(", 
           RowBox[{"1", "-", "t"}], ")"}]}], "+", 
         RowBox[{"pointB", " ", "t"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"wDeriv", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"w", "'"}], "[", "t", "]"}], "\[Equal]", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", 
              RowBox[{"(", 
               FractionBox[
                RowBox[{"D", "[", 
                 RowBox[{"$theFunction", ",", "z"}], "]"}], 
                RowBox[{"D", "[", 
                 RowBox[{"$theFunction", ",", "w"}], "]"}]], ")"}]}], " ", 
             RowBox[{"D", "[", 
              RowBox[{
               RowBox[{"integrationPath", "[", "t", "]"}], ",", "t"}], 
              "]"}]}], ")"}], "/.", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"w", "\[Rule]", 
              RowBox[{"w", "[", "t", "]"}]}], ",", 
             RowBox[{"z", "\[Rule]", 
              RowBox[{"integrationPath", "[", "t", "]"}]}]}], "}"}]}], 
          ")"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"\"\<integrateOverBeta pointA: \>\"", ",", 
           RowBox[{"N", "[", 
            RowBox[{"pointA", ",", "30"}], "]"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{"\"\<integrateOverBeta pointB: \>\"", ",", 
           RowBox[{"N", "[", 
            RowBox[{"pointB", ",", "30"}], "]"}]}], "]"}], ";"}], 
        "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", " ", 
       RowBox[{"intTableAtB", "=", 
        RowBox[{"Table", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"w0", "=", 
            RowBox[{"polishedWAtA", "[", 
             RowBox[{"[", 
              RowBox[{"n", ",", "2"}], "]"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{"$integrateOverBetaFlag", ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Print", "[", 
               RowBox[{
               "\"\<integrateOverBeta index: \>\"", ",", "n", ",", 
                "\"\< from \>\"", ",", 
                RowBox[{"N", "[", 
                 RowBox[{"pointA", ",", "50"}], "]"}], ",", "\"\< to \>\"", 
                ",", 
                RowBox[{"N", "[", 
                 RowBox[{"pointB", ",", "50"}], "]"}]}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"Print", "[", 
               RowBox[{"\"\<Accuracy of w0: \>\"", ",", 
                RowBox[{"Accuracy", "@", "w0"}]}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"Print", "[", 
               RowBox[{"\"\<Precision of w0: \>\"", ",", 
                RowBox[{"Precision", "@", "w0"}]}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"Print", "[", 
               RowBox[{"\"\<w0: \>\"", ",", 
                RowBox[{"N", "[", 
                 RowBox[{"w0", ",", "10"}], "]"}]}], "]"}], ";"}]}], 
            "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{"Style", "[", 
               RowBox[{"\"\<integrateOverBeta start\>\"", ",", "Red"}], "]"}],
               "]"}], ";"}], "*)"}], "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{"$stiffnessSwitchingFlag", ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"theSol", "=", 
               RowBox[{"NDSolveValue", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"wDeriv", ",", 
                   RowBox[{
                    RowBox[{"w", "[", "0", "]"}], "\[Equal]", "w0"}]}], "}"}],
                  ",", "w", ",", 
                 RowBox[{"{", 
                  RowBox[{"t", ",", "0", ",", "1"}], "}"}], ",", 
                 RowBox[{"MaxSteps", "\[Rule]", "20000000"}], ",", 
                 RowBox[{"(*", 
                  RowBox[{
                   RowBox[{"MaxStepSize", "\[Rule]", 
                    RowBox[{"1", "/", "1000"}]}], ","}], "*)"}], 
                 RowBox[{
                 "WorkingPrecision", "\[Rule]", "$stiffnessPrecision"}], ",", 
                 RowBox[{"Method", " ", "\[Rule]", " ", 
                  RowBox[{"{", 
                   RowBox[{"\"\<StiffnessSwitching\>\"", ",", 
                    RowBox[{"\"\<NonstiffTest\>\"", "->", "False"}]}], 
                   "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"theSol", "=", 
               RowBox[{"NDSolveValue", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"wDeriv", ",", 
                   RowBox[{
                    RowBox[{"w", "[", "0", "]"}], "\[Equal]", "w0"}]}], "}"}],
                  ",", "w", ",", 
                 RowBox[{"{", 
                  RowBox[{"t", ",", "0", ",", "1"}], "}"}], ",", 
                 RowBox[{"MaxSteps", "\[Rule]", "20000000"}], ",", 
                 RowBox[{"(*", 
                  RowBox[{",", 
                   RowBox[{"MaxStepSize", "\[Rule]", 
                    RowBox[{"1", "/", "1000"}]}]}], "*)"}], 
                 RowBox[{
                 "WorkingPrecision", "\[Rule]", "$nonStiffnessPrecision"}]}], 
                "]"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
