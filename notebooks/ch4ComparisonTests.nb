Cell["Section 8.2:  Set up a branch plot", "Subsection",
 CellChangeTimes->{{3.9786300918430414`*^9, 
  3.9786301005598726`*^9}},ExpressionUUID->"1f26d653-744c-487a-960b-\
24a1b2a42ad9"],

Cell["\<\
In this section choose the number of series terms to use to generate the \
branch plot as well as the plotting domain which is usually (1/100, 1/10 R) \
with R the radius of convergence.  Note the branch plot domain is less than R \
to avoid unnecessary oscillations of the branch surfaces due to evaluating \
the series very close to its region of convergence.  In the case of \
testCase0026 with very small domain, use only a small series size, 10-15 \
terms, to avoid General::munfl error\
\>", "Text",
 CellChangeTimes->{{3.9786301121786566`*^9, 3.9786302344928427`*^9}, {
  3.9818987021004257`*^9, 
  3.9818987158372984`*^9}},ExpressionUUID->"a3d18eef-f640-430c-b5e4-\
460c9a09d776"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
   "choose", " ", "an", " ", "index", " ", "into", " ", "finalConvData", " ", 
    "for", " ", 
    RowBox[{"branch", "."}]}], " ", "\[IndentingNewLine]", "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"reportIndex", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"choose", " ", "number", " ", "of", " ", "series", " ", "terms"}],
     " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"baseSeriesMax", "=", "15"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"theBranchSpecs", "=", 
    RowBox[{"finalSummary", "[", 
     RowBox[{"[", "reportIndex", "]"}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{"generatorIndex", "=", 
    RowBox[{"theBranchSpecs", "[", 
     RowBox[{"[", "4", "]"}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{"cycleSize", "=", 
    RowBox[{"theBranchSpecs", "[", 
     RowBox[{"[", "3", "]"}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"theCLSP", "=", 
     RowBox[{"theBranchSpecs", "[", 
      RowBox[{"[", "5", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<theCLSP: \>\"", ",", "theCLSP"}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"theR", "=", 
     RowBox[{"Abs", "[", 
      RowBox[{"baseSingularPoint", "-", 
       RowBox[{"$theSingularList", "[", 
        RowBox[{"[", "theCLSP", "]"}], "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"theR", "//", "N"}], "\[IndentingNewLine]", 
   RowBox[{"Precision", "@", "theR"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rEnd", "=", 
     RowBox[{
      RowBox[{"9", "/", "10"}], "theR"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"rEnd", "=", 
      RowBox[{"8", "/", "10"}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rStart", "=", 
     RowBox[{"theR", "/", "100"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"myF1", "[", "u_", "]"}], "=", 
     RowBox[{"baseSeries", "[", 
      RowBox[{"[", 
       RowBox[{"generatorIndex", ",", 
        RowBox[{"1", ";;", "baseSeriesMax"}]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<First 5 terms of generator series: \>\"", ",", 
      RowBox[{
       RowBox[{"baseSeries", "[", 
        RowBox[{"[", 
         RowBox[{"generatorIndex", ",", 
          RowBox[{"1", ";;", "5"}]}], "]"}], "]"}], "//", "N"}]}], 
     "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"theexp", "=", 
     RowBox[{"Exponent", "[", 
      RowBox[{
       RowBox[{"myF1", "[", "z", "]"}], ",", "z", ",", "List"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"theNum", "=", 
     RowBox[{"Numerator", "@", "theexp"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"clist", "=", 
     RowBox[{"Coefficient", "[", 
      RowBox[{
       RowBox[{"myF1", "[", "z", "]"}], ",", "z", ",", "theexp"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"z_", ",", "k_"}], "]"}], ":=", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"clist", "[", 
         RowBox[{"[", "n", "]"}], "]"}], " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"Exp", "[", 
           RowBox[{"2", " ", "k", " ", "\[Pi]", " ", 
            RowBox[{"\[ImaginaryI]", "/", "cycleSize"}]}], "]"}], ")"}], "^", 
         RowBox[{"(", 
          RowBox[{"cycleSize", " ", 
           RowBox[{"theexp", "[", 
            RowBox[{"[", "n", "]"}], "]"}]}], ")"}]}], " ", 
        RowBox[{"z", "^", 
         RowBox[{"theexp", "[", 
          RowBox[{"[", "n", "]"}], "]"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "1", ",", 
         RowBox[{"Length", "[", "clist", "]"}]}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{"thePlot", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", " ", 
      RowBox[{
       RowBox[{"ParametricPlot3D", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Re", "[", "z", "]"}], ",", 
            RowBox[{"Im", "[", "z", "]"}], ",", 
            RowBox[{"Re", "[", 
             RowBox[{"f", "[", 
              RowBox[{"z", ",", 
               RowBox[{"i", "-", "1"}]}], "]"}], "]"}]}], "}"}], "/.", 
          RowBox[{"z", "\[Rule]", 
           RowBox[{"r", " ", 
            RowBox[{"Exp", "[", 
             RowBox[{"\[ImaginaryI]", " ", "t"}], "]"}]}]}]}], ",", 
         RowBox[{"{", 
          RowBox[{"r", ",", "rStart", ",", "rEnd"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", 
           RowBox[{"-", "\[Pi]"}], ",", "\[Pi]"}], "}"}], ",", 
         RowBox[{"BoxRatios", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"1", ",", "1", ",", "1"}], "}"}]}], ",", 
         RowBox[{"PlotStyle", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Opacity", "[", "0.2", "]"}], ",", "Blue"}], "}"}]}]}], 
        "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "cycleSize"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Show", "[", 
    RowBox[{"thePlot", ",", 
     RowBox[{"PlotRange", "->", "All"}]}], "]"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]"}]}]], "Input",
