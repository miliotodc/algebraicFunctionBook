      RowBox[{
      "StringTemplate", "[", 
       "\"\<\[InvisiblePrefixScriptBase]\!\(\*SubsuperscriptBox[\(`1`\), \
\(`2`\), \(`3`\)]\)\>\"", "]"}], "[", 
      RowBox[{
       RowBox[{"ToString", "@", "a"}], ",", 
       RowBox[{"ToString", "@", "b"}], ",", 
       RowBox[{"ToString", "@", "c"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"theLType", "[", 
