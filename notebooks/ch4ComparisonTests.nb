Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"getDaisyChainData", "[", 
     RowBox[{
     "theSingularList_", ",", "colinearList_", ",", "baseSingularIndex_", ",",
       "nextSingularIndex_", ",", "minRadiusArray_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "colinearFlag", ",", "daisyChainIndexes", ",", "daisyChainData", ",", 
        "singData", ",", "baSingularIndex", ",", "baSingularPoint", ",", 
        "baCycleMetric", ",", "baPoleList", ",", "baConjList", ",", 
        "baRemovableList", ",", "baSeries", ",", "baSheetLinks", ",", 
        "baSingSequence", ",", "baBranchTypeArray", ",", "pointSet", ",", 
        "nxSingularPoint", ",", "nxPerimeter", ",", "wAtA", ",", 
        "polishedWAtA", ",", "baPerimeter", ",", "colinearIndexes", ",", 
        "baSeriesMIVPTable", ",", "dataList"}], "}"}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"colinearIndexes", "=", "colinearList"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"daisyChainIndexes", "=", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"{", "baseSingularIndex", "}"}], ",", "colinearIndexes", 
          ",", 
          RowBox[{"{", "nextSingularIndex", "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{"$getDaisyChainDataFlag", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{
           "\"\<          daisyChainIndexes: \>\"", ",", 
            "daisyChainIndexes"}], "]"}], ";"}]}], "\[IndentingNewLine]", 
        "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"construct", " ", "daisy"}], "-", 
         RowBox[{
         "chain", " ", "using", " ", "all", " ", "branch", " ", "sheets", " ",
           "at", " ", "each", " ", "colinear", " ", "point"}]}], 
        "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", " ", 
       "\[IndentingNewLine]", 
       RowBox[{"daisyChainData", "=", 
        RowBox[{"Table", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{"$getDaisyChainDataFlag", ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"dIndex", "<", 
                 RowBox[{"Length", "@", "daisyChainIndexes"}]}], ",", 
                "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"Print", "[", 
                  RowBox[{
                  "\"\<          Processing daisy-chain index \>\"", ",", 
                   RowBox[{"daisyChainIndexes", "[", 
                    RowBox[{"[", "dIndex", "]"}], "]"}]}], "]"}], ";"}]}], 
               "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"TrueQ", "@", 
              RowBox[{"FileExistsQ", "@", 
               RowBox[{"seriesFileName", "[", 
                RowBox[{"$theTestCase", ",", "baseSingularIndex"}], "]"}]}]}],
              ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"baBranchTypeArray", "=", 
               RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"baSeriesMIVPTable", "=", 
               RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"dataList", "=", 
               RowBox[{"Import", "[", 
                RowBox[{"seriesFileName", "[", 
                 RowBox[{"$theTestCase", ",", 
                  RowBox[{"daisyChainIndexes", "[", 
                   RowBox[{"[", "dIndex", "]"}], "]"}]}], "]"}], "]"}]}], ";",
               "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Length", "@", "dataList"}], "==", "9"}], ",", 
                "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{
                   "baSingularIndex", ",", "baSingularPoint", ",", 
                    "baCycleMetric", ",", "baPoleList", ",", "baConjList", 
                    ",", "baRemovableList", ",", "baSeries", ",", 
                    "baSheetLinks", ",", "baSingSequence"}], "}"}], "=", 
                  "dataList"}], ";"}], "\[IndentingNewLine]", ",", 
                "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"Length", "@", "dataList"}], "==", "10"}], ",", 
                   "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    "baSingularIndex", ",", "baSingularPoint", ",", 
                    "baCycleMetric", ",", "baPoleList", ",", "baConjList", 
                    ",", "baRemovableList", ",", "baSeries", ",", 
                    "baSheetLinks", ",", "baSingSequence", ",", 
                    "baBranchTypeArray"}], "}"}], "=", "dataList"}], ";"}], 
                   "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    "baSingularIndex", ",", "baSingularPoint", ",", 
                    "baCycleMetric", ",", "baPoleList", ",", "baConjList", 
                    ",", "baRemovableList", ",", "baSeries", ",", 
                    "baSheetLinks", ",", "baSingSequence", ",", 
                    "baBranchTypeArray", ",", "baSeriesMIVPTable"}], "}"}], 
                    "=", "dataList"}], ";"}]}], "\[IndentingNewLine]", "]"}], 
                 ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], 
             "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Print", "[", 
               RowBox[{
                RowBox[{"Style", "[", 
                 RowBox[{"\"\<File not found: \>\"", ",", "Red"}], "]"}], ",", 
                RowBox[{"seriesFileName", "[", 
                 RowBox[{"$theTestCase", ",", "baseSingularIndex"}], "]"}]}], 
               "]"}], ";", "\[IndentingNewLine]", 
              RowBox[{"Abort", "[", "]"}], ";"}]}], "\[IndentingNewLine]", 
            "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"baPerimeter", "=", 
            RowBox[{"minRadiusArray", "[", 
             RowBox[{"[", "baSingularIndex", "]"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"dIndex", "==", 
              RowBox[{"Length", "@", "daisyChainIndexes"}]}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"pointSet", "=", 
               RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"nxSingularPoint", "=", 
               RowBox[{"theSingularList", "[", 
                RowBox[{"[", 
                 RowBox[{"daisyChainIndexes", "[", 
                  RowBox[{"[", 
                   RowBox[{"dIndex", "+", "1"}], "]"}], "]"}], "]"}], "]"}]}],
               ";", "\[IndentingNewLine]", 
              RowBox[{"nxPerimeter", "=", 
               RowBox[{"minRadiusArray", "[", 
                RowBox[{"[", 
                 RowBox[{"daisyChainIndexes", "[", 
                  RowBox[{"[", 
                   RowBox[{"dIndex", "+", "1"}], "]"}], "]"}], "]"}], "]"}]}],
               ";", "\[IndentingNewLine]", 
              RowBox[{"(*", " ", 
               RowBox[{"returns", ":", " ", 
                RowBox[{"{", 
                 RowBox[{"pointA", ",", "pointB", ",", "pointC"}], "}"}]}], 
               " ", "*)"}], "\[IndentingNewLine]", 
              RowBox[{"pointSet", "=", 
               RowBox[{"getIntegrationData", "[", 
                RowBox[{
                "baSingularPoint", ",", "baPerimeter", ",", "nxSingularPoint",
                  ",", "nxPerimeter"}], "]"}]}], ";"}]}], 
            "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{"$getDaisyChainDataFlag", ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Length", "@", "pointSet"}], "==", "3"}], ",", 
                "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"Print", "[", 
                  RowBox[{
                  "\"\<          daisyChain integration points: \>\"", ",", 
                   RowBox[{
                    RowBox[{"MapThread", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"#1", ",", "#2"}], "}"}], "&"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    "\"\<A: \>\"", ",", "\"\<B: \>\"", ",", "\"\<C: \>\""}], 
                    "}"}], ",", 
                    RowBox[{"pointSet", "//", "N"}]}], "}"}]}], "]"}], "//", 
                    "MatrixForm"}]}], "]"}], ";"}]}], "\[IndentingNewLine]", 
               "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{
               RowBox[{"Style", "[", 
                RowBox[{"\"\<daisyChain point sets: \>\"", ",", "Red"}], 
                "]"}], ",", 
               RowBox[{
                RowBox[{"N", "[", 
                 RowBox[{"pointSet", ",", "25"}], "]"}], "//", 
                "MatrixForm"}]}], "]"}], ";"}], "*)"}], "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"pointSet", ",", "dataList"}], "}"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"dIndex", ",", "1", ",", 
            RowBox[{"Length", "@", "daisyChainIndexes"}]}], "}"}]}], 
         "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"daisyChainIndexes", ",", "daisyChainData"}], "}"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], " ", "\[IndentingNewLine]"}]}]], "Input",
