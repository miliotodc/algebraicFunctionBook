        "\[IndentingNewLine]", 
        RowBox[{"graphicsData", "=", 
         RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"at", "=", 
         RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"dataTable", "=", 
            RowBox[{"Table", "[", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"Print", "[", 
                RowBox[{
                "\"\<Analyzing base sheet for cycle  \>\"", ",", 
                 "theBranchNum"}], "]"}], ";", "\[IndentingNewLine]", 
