         RowBox[{"1", ",", "2", ",", "1"}], "]"}], "]"}]}], "&"}]}], "]"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{
    "check", " ", "if", " ", "Comparison", " ", "and", " ", "Integration", 
     " ", "test", " ", "results", " ", "are", " ", "consistent"}], 
    "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Sort", "@", 
       RowBox[{"seriesComparisonCLSPTable", "[", 
