Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{"In", " ", "the", " ", "following", " ", "line"}], ",", " ", 
    RowBox[{
    "the", " ", "integrationCLSPTable", " ", "is", " ", "used", " ", "as", 
     " ", "the", " ", 
     RowBox[{"finalCLSPTable", ".", "  ", "the"}], " ", 
     "seriesComparisonCLSPTable", " ", "can", " ", "also", " ", "be", " ", 
     RowBox[{"used", ".", "  ", "Either"}], " ", "result", " ", "can", " ", 
     "be", " ", "used", " ", "if", " ", "there", " ", "is", " ", "an", " ", 
     "unresolved", " ", "problem", " ", "with", " ", "one", " ", 
     RowBox[{"test", "."}]}]}], "\[IndentingNewLine]", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"finalCLSPTable", "=", 
     RowBox[{"Sort", "[", 
      RowBox[{"integrationCLSPTable", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"#1", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "2", ",", "1"}], "]"}], "]"}], "<", 
         RowBox[{"#2", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "2", ",", "1"}], "]"}], "]"}]}], "&"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{"acLimits", "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"baseSingularPoint", "-", "#"}], "]"}], "&"}], "/@", " ", 
       RowBox[{"$theSingularList", "[", 
        RowBox[{"[", 
         RowBox[{"finalCLSPTable", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}], "]"}]}], "//", 
      "N"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"acLimitsG", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Graphics", "@", 
        RowBox[{"{", 
         RowBox[{"Red", ",", 
          RowBox[{"PointSize", "[", "0.01", "]"}], ",", 
          RowBox[{"Point", "@", 
           RowBox[{"{", 
            RowBox[{"0", ",", "#"}], "}"}]}]}], "}"}]}], "&"}], "/@", " ", 
      "acLimits"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"actR", "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"baseSingularPoint", "-", "#"}], "]"}], "&"}], "/@", " ", 
      RowBox[{"$theSingularList", "[", 
       RowBox[{"[", 
        RowBox[{"finalCLSPTable", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}], "]"}]}], "//", 
     "N"}]}], "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", "  ", 
    RowBox[{
    "make", " ", "graphics", " ", "points", " ", "for", " ", "Root", " ", 
     "Test", " ", "plots"}], "\[IndentingNewLine]", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"actRG", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Graphics", "@", 
        RowBox[{"{", 
         RowBox[{"Red", ",", 
          RowBox[{"PointSize", "[", "0.01", "]"}], ",", 
          RowBox[{"Point", "@", 
           RowBox[{"{", 
            RowBox[{"0", ",", "#"}], "}"}]}]}], "}"}]}], "&"}], "/@", " ", 
      "actR"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"difArray", "=", 
    RowBox[{
     RowBox[{"MapThread", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"#1", "-", "#2"}], "]"}], "&"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"rootTestData", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "5"}], "]"}], "]"}], ",", "actR"}], "}"}]}], 
      "]"}], "//", "N"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"finalSummary", "=", 
     RowBox[{"MapThread", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"#1", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", 
          RowBox[{"#1", "[", 
           RowBox[{"[", "2", "]"}], "]"}], ",", 
          RowBox[{"#1", "[", 
           RowBox[{"[", "3", "]"}], "]"}], ",", 
          RowBox[{"#1", "[", 
           RowBox[{"[", "4", "]"}], "]"}], ",", "#5", ",", "#2", ",", 
          RowBox[{"#1", "[", 
           RowBox[{"[", "5", "]"}], "]"}], ",", "#3", ",", "#4", ",", 
          RowBox[{"#1", "[", 
           RowBox[{"[", "7", "]"}], "]"}]}], "}"}], "&"}], ",", 
       RowBox[{"{", 
        RowBox[{"rootTestData", ",", 
         RowBox[{"finalCLSPTable", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", "actR", ",", 
         "difArray", ",", "estCLSPs"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"finalConvergenceReportHeader", "=", 
     RowBox[{"Row", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{"$theTestCase", ",", "16", ",", "Bold", ",", "Black"}], 
          "]"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{
          "\"\< Convergence Report at \>\"", ",", "16", ",", "Black", ",", 
