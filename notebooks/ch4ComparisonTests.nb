          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"nextLocArray", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", "1"}], "]"}], "]"}], "==", "1"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"otherIndex", "=", "2"}], ";"}]}], "\[IndentingNewLine]",
            "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"nextNDZ2", "=", 
           RowBox[{"nextSol", "[", 
            RowBox[{"[", "otherIndex", "]"}], "]"}]}], ";"}]}], 
        "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}], ";", 
