Cell[CellGroupData[{

Cell["Manual computation of theTypeTable", "Subsubsection",
 CellChangeTimes->{{3.9271821154914627`*^9, 
  3.9271821219741154`*^9}},ExpressionUUID->"f53efca0-4f30-49eb-bbb9-\
2da6dbabbca4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{"uniquely", " ", "name", " ", "each", " ", "branch"}], 
   "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"baseSheetNumbers", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Min", "@", "#"}], "&"}], " ", "/@", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "&"}], "/@", "baseSheetLinks"}], 
       ")"}]}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"seriesLengths", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", "#", "]"}], "&"}], "/@", " ", 
      RowBox[{"baseSeries", "[", 
       RowBox[{"[", "baseSheetNumbers", "]"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{"theExpList", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Exponent", "[", 
        RowBox[{"#", ",", "z", ",", "List"}], "]"}], "&"}], "/@", " ", 
      RowBox[{"baseSeries", "[", 
       RowBox[{"[", "baseSheetNumbers", "]"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"minExpList", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Min", "[", "#", "]"}], "&"}], " ", "/@", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"Select", "[", 
          RowBox[{"#", ",", 
           RowBox[{
            RowBox[{"#", "!=", "0"}], "&"}]}], "]"}], "&"}], "/@", " ", 
        "theExpList"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cycleTypes", "=", 
     RowBox[{"baseSheetLinks", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"multiType", "[", 
      RowBox[{"a_Integer", ",", "b_String"}], "]"}], ":=", 
     RowBox[{
      RowBox[{
      "StringTemplate", "[", 
       "\"\<\!\(\*SubscriptBox[\(\[InvisiblePrefixScriptBase]\), \
\((`1`)\)]\)`2`\>\"", "]"}], "[", 
      RowBox[{
       RowBox[{"ToString", "@", "a"}], ",", "b"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"newType", "[", 
      RowBox[{
      "a_Integer", ",", "b_String", ",", "c_Integer", ",", "d_Integer"}], 
      "]"}], ":=", 
     RowBox[{
      RowBox[{
      "StringTemplate", "[", 
       "\"\<\!\(\*SubscriptBox[\(\[InvisiblePrefixScriptBase]\), \(`1`\)]\)\!\
\(\*SubsuperscriptBox[\(`2`\), \(`3`\), \(`4`\)]\)\>\"", "]"}], "[", 
      RowBox[{
       RowBox[{"ToString", "@", "a"}], ",", "b", ",", 
       RowBox[{"ToString", "@", "c"}], ",", 
       RowBox[{"ToString", "@", "d"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"multiBranchType", "[", 
      RowBox[{"a_String", ",", "b_Integer", ",", "c_Integer"}], "]"}], ":=", 
     RowBox[{
      RowBox[{
      "StringTemplate", "[", 
       "\"\<\[InvisiblePrefixScriptBase]\!\(\*SubsuperscriptBox[\(`1`\), \
\(`2`\), \(`3`\)]\)\>\"", "]"}], "[", 
      RowBox[{
       RowBox[{"ToString", "@", "a"}], ",", 
       RowBox[{"ToString", "@", "b"}], ",", 
       RowBox[{"ToString", "@", "c"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"theLType", "[", 
      RowBox[{"a_String", ",", "b_Integer"}], "]"}], ":=", 
     RowBox[{
      RowBox[{
      "StringTemplate", "[", "\"\<\!\(\*SubscriptBox[\(`1`\), \(`2`\)]\)\>\"",
        "]"}], "[", 
      RowBox[{"a", ",", 
       RowBox[{"ToString", "@", "b"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", " ", 
   RowBox[{"(*", " ", "\[IndentingNewLine]", 
    RowBox[{"pick", " ", "out", " ", "Taylor", " ", "series"}], 
    "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"typeTable", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"minE", "=", 
         RowBox[{"minExpList", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"cycleTypes", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "==", "1"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"MemberQ", "[", 
              RowBox[{
               RowBox[{"baseRemovableList", "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", 
               RowBox[{"baseSheetNumbers", "[", 
                RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"type", "=", "\"\<E\>\""}], ";"}], 
             "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"minE", "<", "0"}], ",", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"theN", "=", 
                  RowBox[{"Numerator", "[", "minE", "]"}]}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"(*", 
                  RowBox[{
                   RowBox[{"type", "=", 
                    SubscriptBox["\"\<L\>\"", 
                    RowBox[{"ToString", "[", "theN", "]"}]]}], ";"}], "*)"}], 
                 "\[IndentingNewLine]", 
                 RowBox[{"type", "=", 
                  RowBox[{"theLType", "[", 
                   RowBox[{"\"\<L\>\"", ",", "theN"}], "]"}]}], ";"}], 
                "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"type", "=", "\"\<T\>\""}], ";"}]}], 
               "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", 
            "]"}], ";"}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"theD", "=", 
            RowBox[{"Denominator", "[", "minE", "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"theN", "=", 
            RowBox[{"Numerator", "[", "minE", "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"minE", ">", "0"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"minE", ">", "1"}], ",", "\[IndentingNewLine]", 
                RowBox[{"(*", 
                 RowBox[{
                  RowBox[{"type", "=", 
                   SubsuperscriptBox["F", 
                    RowBox[{"ToString", "[", "theD", "]"}], 
                    RowBox[{"ToString", "[", "theN", "]"}]]}], ";"}], "*)"}], 
                "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"type", "=", 
                  RowBox[{"multiBranchType", "[", 
                   RowBox[{"\"\<F\>\"", ",", 
                    RowBox[{"cycleTypes", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], ",", "theN"}], "]"}]}], 
                 ";"}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
                RowBox[{"(*", 
                 RowBox[{
                  RowBox[{"type", "=", 
                   SubsuperscriptBox["V", 
                    RowBox[{"ToString", "[", "theD", "]"}], 
                    RowBox[{"ToString", "[", "theN", "]"}]]}], ";"}], "*)"}], 
                "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"type", "=", 
                  RowBox[{"multiBranchType", "[", 
                   RowBox[{"\"\<V\>\"", ",", 
                    RowBox[{"cycleTypes", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], ",", "theN"}], "]"}]}], 
                 ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], 
             "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
             RowBox[{"(*", 
              RowBox[{
               RowBox[{"type", "=", 
                SubsuperscriptBox["P", 
                 RowBox[{"ToString", "[", "theD", "]"}], 
                 RowBox[{"ToString", "[", "theN", "]"}]]}], ";"}], "*)"}], 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"type", "=", 
               RowBox[{"multiBranchType", "[", 
                RowBox[{"\"\<P\>\"", ",", 
                 RowBox[{"cycleTypes", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], ",", "theN"}], "]"}]}], 
              ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]}], 
         "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", "type"}], 
       ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "@", "baseSheetNumbers"}]}], "}"}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<typeTable\>\"", ",", "typeTable"}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"theTally", "=", 
     RowBox[{"Tally", "[", "typeTable", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"mVals", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"theTally", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}], ">", "1"}], "&"}]}], "]"}]}], ";"}],
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"j", "=", "1"}], ",", 
      RowBox[{"j", "<=", 
       RowBox[{"Length", "@", "mVals"}]}], ",", 
      RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"typeLoc", "=", 
        RowBox[{"Flatten", "@", 
         RowBox[{"Position", "[", 
          RowBox[{"typeTable", ",", 
