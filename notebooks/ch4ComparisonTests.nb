                RowBox[{"Length", "@", "cTable"}]}], ";", 
               "\[IndentingNewLine]", "\[IndentingNewLine]", 
               RowBox[{"linearLine", "=", 
                RowBox[{
                 RowBox[{
                  RowBox[{"c0", "+", 
                   RowBox[{"c1", " ", "x"}]}], "/.", " ", 
                  RowBox[{
                   RowBox[{"NMinimize", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Total", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"#", "[", 
