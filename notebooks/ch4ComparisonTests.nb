           RowBox[{"[", 
            RowBox[{"All", ",", "6"}], "]"}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", "\"\<test\>\"", "]"}], ";", 
       "\[IndentingNewLine]", 
