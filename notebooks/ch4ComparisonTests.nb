              RowBox[{"[", "pos", "]"}], "]"}], ",", 
             RowBox[{"remPoleList", "[", 
              RowBox[{"[", "pos", "]"}], "]"}], ",", "bSeriesAtC"}], "}"}]}], 
          ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{"Length", "@", "intVals"}]}], "}"}]}], 
         "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"polishedValues", "=", 
