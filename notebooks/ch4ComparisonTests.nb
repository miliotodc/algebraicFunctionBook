Cell[BoxData[
 RowBox[{"   ", 
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{"function", " ", "for", " ", "Root", " ", "Test"}], 
   "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"getRootLogTestResults", "[", 
      RowBox[{
      "baseSeries_", ",", "baseSheetLinks_", ",", "baseSheetNumbers_", ",", 
       "theTypeTable_", ",", "seriesLengths_", ",", "baseSingularPoint_", ",",
        "singularSequence_", ",", "theSingularList_", ",", 
       "baseSingularIndex_", ",", "baseConjList_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "cycleBaseSheets", ",", "startTerms", ",", "plotFlag", ",", 
         "totalSheets", ",", "graphicsData", ",", "at", ",", "seriesType", 
         ",", "theSeriesNum", ",", "cycleType", ",", "seriesLength", ",", 
         "theexp", ",", "lcm", ",", "numVals", ",", "cList", ",", "cTable", 
         ",", "lp1", ",", "clist", ",", "k", ",", "dataVals", ",", 
         "plotXStart", ",", "plotXEnd", ",", "endTerms", ",", "linearLine", 
         ",", "quadraticLine", ",", "cubicLine", ",", " ", "linearResidue", 
         ",", "cubicResidue", ",", "quadraticResidue", ",", "residueSet", ",",
          "fitSet", ",", "bestFitPos", ",", "rTest", ",", "fitResults", ",", 
         "linearPlot", ",", "quadraticPlot", ",", "cubicPlot", ",", "plotSet",
          ",", "fitValueG", ",", "plotLabel", ",", "thePlotRange", ",", 
         "xCoord", ",", "yCoord", ",", "theSummary", ",", "fitRadius", ",", 
         "rootTestResults", ",", "rootTestReport1", ",", "rootTestReport", 
         ",", "theDistanceList", ",", "theNearList", ",", "nearestIndexes", 
         ",", "estCLSPs", ",", "rootTestResults2", ",", "rootTestReport2", 
         ",", "rootTestReportHeader", ",", "finalReport", ",", "c0", ",", 
         "c1", ",", "c2", ",", "c3", ",", "estCLSPIndexes", ",", 
         "dataTable"}], "}"}], ",", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"cycleBaseSheets", "=", 
         RowBox[{"baseSheetLinks", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2", ",", "1"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<cycleBaseSheets: \>\"", ",", "cycleBaseSheets"}], "]"}],
         ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"plotFlag", "=", "True"}], ";", "\[IndentingNewLine]", 
        RowBox[{"startTerms", "=", "10"}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"totalSheets", "=", 
         RowBox[{"Length", "@", "baseConjList"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"graphicsData", "=", 
         RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"at", "=", 
         RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"dataTable", "=", 
            RowBox[{"Table", "[", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"Print", "[", 
                RowBox[{
                "\"\<Analyzing base sheet for cycle  \>\"", ",", 
                 "theBranchNum"}], "]"}], ";", "\[IndentingNewLine]", 
               RowBox[{"seriesType", "=", 
                RowBox[{"theTypeTable", "[", 
                 RowBox[{"[", "theBranchNum", "]"}], "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"theSeriesNum", "=", 
                RowBox[{"cycleBaseSheets", "[", 
                 RowBox[{"[", "theBranchNum", "]"}], "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"cycleType", "=", 
                RowBox[{"baseSheetLinks", "[", 
                 RowBox[{"[", 
                  RowBox[{"theBranchNum", ",", "1"}], "]"}], "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"seriesLength", "=", 
                RowBox[{"Length", "@", 
                 RowBox[{"baseSeries", "[", 
                  RowBox[{"[", "theSeriesNum", "]"}], "]"}]}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"theexp", "=", 
                RowBox[{"Exponent", "[", 
                 RowBox[{
                  RowBox[{"baseSeries", "[", 
                   RowBox[{"[", "theSeriesNum", "]"}], "]"}], ",", "z", ",", 
                  "List"}], "]"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"lcm", "=", 
                RowBox[{"LCM", "@@", 
                 RowBox[{"(", 
                  RowBox[{"Denominator", "@", "theexp"}], ")"}]}]}], ";", 
               "\n", "                      ", 
               RowBox[{"numVals", "=", 
                RowBox[{"lcm", " ", "theexp"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"clist", "=", 
                RowBox[{"Coefficient", "[", 
                 RowBox[{
                  RowBox[{"baseSeries", "[", 
                   RowBox[{"[", "theSeriesNum", "]"}], "]"}], ",", "z", ",", 
                  "theexp"}], "]"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"cTable", "=", 
                RowBox[{"Table", "[", "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"1", "/", 
                    RowBox[{"numVals", "[", 
                    RowBox[{"[", "k", "]"}], "]"}]}], ",", 
                    RowBox[{"N", "[", 
                    RowBox[{
                    RowBox[{"1", "/", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Abs", "[", 
                    RowBox[{"clist", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], "]"}], "^", 
                    RowBox[{"(", 
                    RowBox[{"cycleType", "/", 
                    RowBox[{"numVals", "[", 
                    RowBox[{"[", "k", "]"}], "]"}]}], ")"}]}], ")"}]}], ",", 
                    "25"}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
                  RowBox[{"{", 
                   RowBox[{"k", ",", "15", ",", 
                    RowBox[{"Length", "@", "clist"}]}], "}"}]}], "]"}]}], ";",
                "\[IndentingNewLine]", "\[IndentingNewLine]", 
               "\[IndentingNewLine]", 
               RowBox[{"(*", 
                RowBox[{
                 RowBox[{"Print", "[", 
                  RowBox[{"\"\<cTable Len: \>\"", ",", 
                   RowBox[{"Length", "@", "cTable"}]}], "]"}], ";"}], "*)"}], 
               "\[IndentingNewLine]", 
               RowBox[{"lp1", "=", 
                RowBox[{"ListPlot", "[", 
                 RowBox[{"cTable", ",", 
                  RowBox[{"PlotStyle", "->", 
                   RowBox[{"{", 
                    RowBox[{"PointSize", "[", "0.005", "]"}], "}"}]}], ",", 
                  RowBox[{"AxesOrigin", "->", 
                   RowBox[{"{", 
                    RowBox[{"0", ",", "0"}], "}"}]}]}], "]"}]}], ";", 
               "\[IndentingNewLine]", "\[IndentingNewLine]", 
               RowBox[{"(*", " ", "\[IndentingNewLine]", "         ", 
                RowBox[{
                 RowBox[{"start", " ", "of", " ", "update", " ", "k"}], ",", 
                 "dataVAls", ",", "plotXStart", ",", "plotXend", ",", 
                 "endTerms", ",", "linearLine", ",", "quadraticLine", ",", 
                 "cubicLine"}], "\[IndentingNewLine]", " ", "*)"}], 
               "\[IndentingNewLine]", 
               RowBox[{"dataVals", "=", 
                RowBox[{
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", 
                    RowBox[{"Log", "[", 
                    RowBox[{"10", ",", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], "}"}], "&"}], "/@",
                  " ", 
                 RowBox[{"cTable", "[", 
                  RowBox[{"[", 
                   RowBox[{"startTerms", ";;"}], "]"}], "]"}]}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"plotXStart", "=", 
                RowBox[{"cTable", "[", 
                 RowBox[{"[", 
                  RowBox[{
                   RowBox[{"-", "1"}], ",", "1"}], "]"}], "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"plotXEnd", "=", 
                RowBox[{"cTable", "[", 
                 RowBox[{"[", 
                  RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"endTerms", "=", 
                RowBox[{"Length", "@", "cTable"}]}], ";", 
               "\[IndentingNewLine]", "\[IndentingNewLine]", 
               RowBox[{"linearLine", "=", 
                RowBox[{
                 RowBox[{
                  RowBox[{"c0", "+", 
                   RowBox[{"c1", " ", "x"}]}], "/.", " ", 
                  RowBox[{
                   RowBox[{"Minimize", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Total", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "-", 
                    RowBox[{"(", 
                    RowBox[{"c0", "+", 
                    RowBox[{"c1", " ", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}]}], ")"}]}], ")"}], "&"}],
                     "/@", "dataVals"}], "]"}], ",", 
                    RowBox[{"And", "@@", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"c0", "+", 
                    RowBox[{"c1", " ", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}]}], ")"}], "<=", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "&"}], "/@", " ",
                     "dataVals"}], ")"}]}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"c0", ",", "c1"}], "}"}]}], "]"}], "[", 
                   RowBox[{"[", "2", "]"}], "]"}]}], "//", "N"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"quadraticLine", "=", 
                RowBox[{
                 RowBox[{
                  RowBox[{"c0", "+", 
                   RowBox[{"c1", " ", "x"}], "+", 
                   RowBox[{"c2", " ", 
                    RowBox[{"x", "^", "2"}]}]}], "/.", " ", 
                  RowBox[{
                   RowBox[{"Minimize", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Total", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "-", 
                    RowBox[{"(", 
                    RowBox[{"c0", "+", 
                    RowBox[{"c1", " ", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "+", 
                    RowBox[{"c2", " ", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "^", "2"}]}]}], ")"}]}], 
                    ")"}], "&"}], "/@", " ", "dataVals"}], "]"}], ",", 
                    RowBox[{"And", "@@", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"c0", "+", 
                    RowBox[{"c1", " ", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "+", 
                    RowBox[{"c2", " ", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "^", "2"}]}]}], ")"}], "<=", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "&"}], "/@", " ",
                     "dataVals"}], ")"}]}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"c0", ",", "c1", ",", "c2"}], "}"}]}], "]"}], "[", 
                   RowBox[{"[", "2", "]"}], "]"}]}], "//", "N"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"cubicLine", "=", 
                RowBox[{
                 RowBox[{"c0", "+", 
                  RowBox[{"c1", " ", "x"}], "+", 
                  RowBox[{"c2", " ", 
                   RowBox[{"x", "^", "2"}]}], "+", 
                  RowBox[{"c3", " ", 
                   RowBox[{"x", "^", "3"}]}]}], "/.", " ", 
                 RowBox[{
                  RowBox[{"NMinimize", "[", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Total", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "-", 
                    RowBox[{"(", 
                    RowBox[{"c0", "+", 
                    RowBox[{"c1", " ", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "+", 
                    RowBox[{"c2", " ", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "^", "2"}]}], "+", 
                    RowBox[{"c3", " ", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "^", "3"}]}]}], ")"}]}], 
                    ")"}], "&"}], "/@", " ", "dataVals"}], "]"}], ",", 
                    RowBox[{"And", "@@", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"c0", "+", 
                    RowBox[{"c1", " ", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "+", 
                    RowBox[{"c2", " ", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "^", "2"}]}], "+", 
                    RowBox[{"c3", " ", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "^", "3"}]}]}], ")"}], "<=", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "&"}], "/@", " ",
                     "dataVals"}], ")"}]}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"c0", ",", "c1", ",", "c2", ",", "c3"}], "}"}]}], 
                   "]"}], "[", 
                  RowBox[{"[", "2", "]"}], "]"}]}]}], ";", 
               "\[IndentingNewLine]", "\[IndentingNewLine]", 
               "\[IndentingNewLine]", 
               RowBox[{"linearResidue", "=", 
                RowBox[{"Plus", "@@", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"Abs", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "-", "linearLine"}], "/.", 
                    RowBox[{"x", "->", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}]}], "]"}], "&"}], "/@", 
                   " ", "dataVals"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"cubicResidue", "=", 
                RowBox[{"Plus", "@@", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"Abs", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "-", "cubicLine"}], "/.", 
                    RowBox[{"x", "->", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}]}], "]"}], "&"}], "/@", 
                   " ", "dataVals"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"quadraticResidue", "=", 
                RowBox[{"Plus", "@@", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"Abs", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "-", "quadraticLine"}], "/.", 
                    RowBox[{"x", "->", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}]}], "]"}], "&"}], "/@", 
                   " ", "dataVals"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"residueSet", "=", 
                RowBox[{"{", 
                 RowBox[{
                 "linearResidue", ",", "quadraticResidue", ",", 
                  "cubicResidue"}], "}"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"fitSet", "=", 
                RowBox[{"{", 
                 RowBox[{
                 "linearLine", ",", "quadraticLine", ",", "cubicLine"}], 
                 "}"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
               RowBox[{"bestFitPos", "=", 
                RowBox[{
                 RowBox[{"Position", "[", 
                  RowBox[{"residueSet", ",", 
                   RowBox[{"Min", "[", "residueSet", "]"}]}], "]"}], "[", 
                 RowBox[{"[", 
                  RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{
               "Print", "[", "\"\<Best fit function for this branch: \>\"", 
                "]"}], ";", "\[IndentingNewLine]", 
               RowBox[{"Switch", "[", 
                RowBox[{"bestFitPos", ",", "1", ",", 
                 RowBox[{"Print", "[", 
                  RowBox[{"linearLine", "//", "N"}], "]"}], ",", "2", ",", 
                 RowBox[{"Print", "[", 
                  RowBox[{"quadraticLine", "//", "N"}], "]"}], ",", "3", ",", 
                 RowBox[{"Print", "[", 
                  RowBox[{"cubicLine", "//", "N"}], "]"}]}], "]"}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"rTest", "=", 
                RowBox[{"Switch", "[", 
                 RowBox[{"bestFitPos", ",", "1", ",", 
                  RowBox[{"linearLine", "/.", 
                   RowBox[{"x", "->", "0"}]}], ",", "2", ",", 
                  RowBox[{"quadraticLine", "/.", 
                   RowBox[{"x", "->", "0"}]}], ",", "3", ",", 
                  RowBox[{"cubicLine", "/.", 
