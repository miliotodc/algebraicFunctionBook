Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"getSeriesTypes", "[", 
     RowBox[{"baseSeries_", ",", "baseSheetLinks_", ",", "baseRemovalList_"}],
      "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "baseSheetNumbers", ",", "seriesLengths", ",", "theExpList", ",", 
        "minExpList", ",", "cycleTypes", ",", "multiType", ",", "newType", 
        ",", "multiBranchType", ",", "theLType", ",", "minE", ",", "type", 
