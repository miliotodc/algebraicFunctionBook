Cell[CellGroupData[{

Cell["\<\
Section 4.2:  Checking if comparison file set is available for import\
\>", "Subsection",
 CellChangeTimes->{{3.981888667461982*^9, 3.981888685469384*^9}, {
  3.9920887644060526`*^9, 
  3.992088764582285*^9}},ExpressionUUID->"714caf43-4428-4392-8cf8-\
1994898e018f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"checkContinuationFiles", "[", 
       RowBox[{
       "baseSingularIndex", ",", "rootTestData", ",", "singularSequence"}], 
       "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
       "Print", "[", 
        "\"\<All files needed for continuation analysis found!\>\"", "]"}], 
       ";"}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"Style", "[", 
         RowBox[{
         "\"\<Some files needed for continuation analysis are missing!\>\"", 
          ",", "Red"}], "]"}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Print", "[", "\"\<SingularPoints: \>\"", "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Grid", "@", 
      RowBox[{"MapThread", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"#1", ",", "#2"}], "}"}], "&"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Range", "@", 
           RowBox[{"Length", "@", "singularSequence"}]}], ",", 
          RowBox[{
           RowBox[{"$theSingularList", "[", 
            RowBox[{"[", "singularSequence", "]"}], "]"}], "//", "N"}]}], 
         "}"}]}], "]"}]}]}], "\[IndentingNewLine]", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"aForm", "[", "$theFunction", "]"}], "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{"theSings", "=", "$theSingularList"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"thePoles", "=", 
     RowBox[{"$theSingularList", "[", 
      RowBox[{"[", "$poleIndexes", "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"theRingList", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", "#", "]"}], "&"}], "/@", " ", "theSings"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"singG", "=", 
     RowBox[{"Graphics", "@", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"PointSize", "[", "0.015", "]"}], ",", "Blue", ",", 
        RowBox[{"Point", "@", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"ReIm", "@", "#"}], "&"}], "/@", " ", "theSings"}], 
          ")"}]}]}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"poleG", "=", 
     RowBox[{"Graphics", "@", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"PointSize", "[", ".015", "]"}], ",", "Red", ",", 
        RowBox[{"Point", "@", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"ReIm", "@", "#"}], "&"}], "/@", " ", "thePoles"}], 
          ")"}]}]}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"singularPerimetersG", "=", 
     RowBox[{"Graphics", "@", 
      RowBox[{"MapThread", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Circle", "[", 
          RowBox[{
           RowBox[{"ReIm", "@", "#1"}], ",", "#2"}], "]"}], "&"}], ",", 
        RowBox[{"{", 
         RowBox[{"theSings", ",", "$minRadiusArray"}], "}"}]}], "]"}]}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nearestDistancesG", "=", 
     RowBox[{"MapThread", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Dashed", ",", 
          RowBox[{"Circle", "[", 
           RowBox[{
            RowBox[{"ReIm", "@", "#1"}], ",", "#2"}], "]"}]}], "}"}], "&"}], 
       ",", 
       RowBox[{"{", 
        RowBox[{"theSings", ",", "$nearestDistanceArray"}], "}"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"annularRegionsG", "=", 
      RowBox[{"Graphics", "@", 
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"EdgeForm", "[", "]"}], ",", 
            RowBox[{"FaceForm", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Opacity", "[", "0.25", "]"}], ",", "#1"}], "}"}], 
             "]"}], ",", 
            RowBox[{"Annulus", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"0", ",", "0"}], "}"}], ",", "#2"}], "]"}]}], "}"}], 
          "&"}], ",", 
         RowBox[{"{", 
          RowBox[{
