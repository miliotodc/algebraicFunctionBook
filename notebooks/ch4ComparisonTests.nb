562b693ea81e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"getIntegrationData", "[", 
     RowBox[{
     "baseSingularity_", ",", "baseRadius_", ",", "nextSingularity_", ",", 
      "nextRadius_"}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "baseSingularPoint", ",", "nextSingularPoint", ",", "baseNDZ", ",", 
        "nextNDZ", ",", "baseEqn", ",", "nextEqn", ",", "p1", ",", "p2", ",", 
        "eqn3", ",", "myPoints", ",", "minVal", ",", "baseLoc", ",", 
        "nextSol", ",", "baseSol", ",", "nextLoc", ",", "theSolvePrec", ",", 
        "nextNDZ2", ",", "myBasePoints", ",", "myNextPoints", ",", 
        "otherIndex", ",", "singPrecision", ",", "baseLocArray", ",", 
        "nextLocArray", ",", "difArray", ",", "precList", ",", "accList", ",",
         "theSolveAcc", ",", "workPrec"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{"$getIntegrationDataFlag", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"Style", "[", 
            RowBox[{"\"\<Entering getIntegrationData\>\"", ",", "Red"}], 
            "]"}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"baseSingularPoint", "=", 
        RowBox[{"ReIm", "@", "baseSingularity"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"nextSingularPoint", "=", 
        RowBox[{"ReIm", "@", "nextSingularity"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"singPrecision", "=", 
        RowBox[{"Floor", "@", 
         RowBox[{"Min", "@", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Precision", "@", "baseSingularity"}], ",", 
            RowBox[{"Precision", "@", "nextSingularity"}]}], "}"}]}]}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"singPrecision", "==", "\[Infinity]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"singPrecision", "=", "1000"}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", "\[IndentingNewLine]", " ", 
        RowBox[{
        "first", " ", "check", "  ", "real", " ", "parts", " ", "for", " ", 
         "vertical", " ", "case"}], "\[IndentingNewLine]", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{"baseSingularPoint", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "-", 
            RowBox[{"nextSingularPoint", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "<", 
          RowBox[{"10", "^", 
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{"singPrecision", "-", "$accuracyComparisonFactor"}], 
             ")"}]}]}]}], ",", "\[IndentingNewLine]", 
         RowBox[{"(*", "\[IndentingNewLine]", " ", 
          RowBox[{
           RowBox[{"vertical", " ", "case"}], ",", " ", 
           RowBox[{
           "now", " ", "check", " ", "imaginary", " ", "parts", " ", "to", 
            " ", "see", " ", "which", " ", "one", " ", "is", " ", "on", " ", 
            "top"}]}], "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"baseSingularPoint", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ">", 
             RowBox[{"nextSingularPoint", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
            RowBox[{"(*", "\[IndentingNewLine]", 
             RowBox[{"base", " ", "above", " ", "next", " ", "point"}], 
             "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"baseNDZ", "=", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"baseSingularPoint", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", 
                RowBox[{
                 RowBox[{"baseSingularPoint", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], "-", "baseRadius"}]}], 
               "}"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"nextNDZ", "=", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"nextSingularPoint", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", 
                RowBox[{
                 RowBox[{"nextSingularPoint", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], "+", "nextRadius"}]}], 
               "}"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"nextNDZ2", "=", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"nextSingularPoint", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", 
                RowBox[{
                 RowBox[{"nextSingularPoint", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], "-", "nextRadius"}]}], 
               "}"}]}], ";"}], "\[IndentingNewLine]", ",", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", "\[IndentingNewLine]", 
             RowBox[{"base", " ", "below", " ", "next", " ", "point"}], 
             "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"baseNDZ", "=", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"baseSingularPoint", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", 
                RowBox[{
                 RowBox[{"baseSingularPoint", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], "+", "baseRadius"}]}], 
               "}"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"nextNDZ", "=", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"nextSingularPoint", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", 
                RowBox[{
                 RowBox[{"nextSingularPoint", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], "-", "nextRadius"}]}], 
               "}"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"nextNDZ2", "=", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"nextSingularPoint", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", 
                RowBox[{
                 RowBox[{"nextSingularPoint", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], "+", "nextRadius"}]}], 
               "}"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], 
         "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
         RowBox[{"(*", " ", "\[IndentingNewLine]", 
          RowBox[{"non", "-", 
           RowBox[{"vertical", " ", "case"}]}], "\[IndentingNewLine]", "*)"}],
          "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"baseEqn", "=", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"x", "-", 
                RowBox[{"baseSingularPoint", "[", 
                 RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "^", "2"}], "+", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"y", "-", 
                RowBox[{"baseSingularPoint", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "^", "2"}]}], "==", 
            RowBox[{"baseRadius", "^", "2"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"nextEqn", "=", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"x", "-", 
                RowBox[{"nextSingularPoint", "[", 
                 RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "^", "2"}], "+", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"y", "-", 
                RowBox[{"nextSingularPoint", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "^", "2"}]}], "==", 
            RowBox[{"nextRadius", "^", "2"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", "\[IndentingNewLine]", " ", 
           RowBox[{
           "get", " ", "equation", " ", "of", " ", "line", " ", "between", 
            " ", "singular", " ", "points"}], "\[IndentingNewLine]", "*)"}], 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"p1", "=", "baseSingularPoint"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"p2", "=", "nextSingularPoint"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"eqn3", "=", 
           RowBox[{"Expand", "[", 
            RowBox[{"y", "==", 
             RowBox[{
              RowBox[{
               FractionBox[
                RowBox[{
                 RowBox[{"p2", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], "-", 
                 RowBox[{"p1", "[", 
                  RowBox[{"[", "2", "]"}], "]"}]}], 
                RowBox[{
                 RowBox[{"p2", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], "-", 
                 RowBox[{"p1", "[", 
                  RowBox[{"[", "1", "]"}], "]"}]}]], 
               RowBox[{"(", 
                RowBox[{"x", "-", 
                 RowBox[{"p1", "[", 
                  RowBox[{"[", "1", "]"}], "]"}]}], ")"}]}], "+", 
              RowBox[{"p1", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"Print", "[", 
             RowBox[{"\"\<eqn3: \>\"", ",", "eqn3"}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"Print", "[", 
             RowBox[{"\"\<Prec of eqn3: \>\"", ",", 
              RowBox[{"Precision", "@", "eqn3"}]}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"Print", "[", 
             RowBox[{"\"\<Acc of eqn3: \>\"", ",", 
              RowBox[{"Accuracy", "@", "eqn3"}]}], "]"}], ";"}], 
           "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
          RowBox[{"precList", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"Precision", "@", "#"}], "&"}], "/@", 
            RowBox[{"{", 
             RowBox[{"baseEqn", ",", "nextEqn", ",", "eqn3"}], "}"}]}]}], ";",
           "\[IndentingNewLine]", 
          RowBox[{"accList", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"Accuracy", "@", "#"}], "&"}], "/@", 
            RowBox[{"{", 
             RowBox[{"baseEqn", ",", "nextEqn", ",", "eqn3"}], "}"}]}]}], ";",
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"theSolvePrec", "=", 
           RowBox[{"Min", "@", "precList"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"theSolveAcc", "=", 
           RowBox[{"Min", "@", "accList"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"workPrec", "=", 
           RowBox[{"Floor", "@", 
            RowBox[{"Max", "@", 
             RowBox[{"{", 
              RowBox[{"theSolvePrec", ",", "theSolveAcc"}], "}"}]}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"workPrec", ">", "900"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"workPrec", "=", "900"}], ";"}]}], "\[IndentingNewLine]",
            "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"theSolvePrec", "=", 
             RowBox[{"Floor", "@", 
              RowBox[{"Precision", "@", 
               RowBox[{"{", 
                RowBox[{"baseEqn", ",", "nextEqn", ",", "eqn3"}], "}"}]}]}]}],
             ";"}], "*)"}], "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"workPrec", "<", "$minNSolveAccuracy"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{"Style", "[", 
               RowBox[{
                RowBox[{
                "\"\<getIntegrationData::solve working precision \>\"", "<>", 
                 RowBox[{"ToString", "[", 
                  RowBox[{"N", "@", "workPrec"}], "]"}], "<>", " ", 
                 "\"\< is less than $minSolvePrecision \>\"", "<>", 
                 RowBox[{"ToString", "[", "$minNSolvePrecision", "]"}]}], ",",
                 "Red", ",", "14", ",", "Bold"}], "]"}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"Abort", "[", "]"}], ";"}]}], "\[IndentingNewLine]", 
           "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"Print", "[", 
             RowBox[{"\"\<prec baseEqn: \>\"", ",", 
              RowBox[{"Precision", "@", "baseEqn"}]}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"Print", "[", 
             RowBox[{"\"\<prec eqn3: \>\"", ",", 
              RowBox[{"Precision", "@", "eqn3"}]}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"Print", "[", 
             RowBox[{"\"\<prec nextEqn: \>\"", ",", 
              RowBox[{"Precision", "@", "nextEqn"}]}], "]"}], ";"}], 
           "\[IndentingNewLine]", "*)"}], "\n", "          ", 
          RowBox[{"baseSol", "=", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"x", ",", "y"}], "}"}], "/.", 
