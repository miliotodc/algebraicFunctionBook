         RowBox[{
         "annulusTable", ",", "annulusTableR", ",", "annulusTableReport"}], 
         "}"}], "=", 
        RowBox[{"Import", "[", 
         RowBox[{
         "annularTableWithMonodromiesFileName", "[", "$theTestCase", "]"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"annularResidueTable", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
