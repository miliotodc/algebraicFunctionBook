80c42da15d80"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"strictPolynomialQ", "[", 
     RowBox[{"myPoly_", ",", 
      RowBox[{"{", 
       RowBox[{"x_", ",", "y_"}], "}"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"levels", ",", "cList", ",", "finalList", ",", "return"}], 
       "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"PolynomialQ", "[", 
          RowBox[{"myPoly", ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", "y"}], "}"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"levels", "=", 
           RowBox[{"Level", "[", 
            RowBox[{"myPoly", ",", 
             RowBox[{"{", 
              RowBox[{"-", "1"}], "}"}], ",", 
             RowBox[{"Heads", "->", "True"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Length", "@", 
               RowBox[{"Position", "[", 
                RowBox[{"levels", ",", "x"}], "]"}]}], ">", "0"}], " ", "&&", 
             " ", 
             RowBox[{
              RowBox[{"Length", "@", 
               RowBox[{"Position", "[", 
                RowBox[{"levels", ",", "y"}], "]"}]}], ">", "0"}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"cList", "=", 
              RowBox[{"Complement", "[", 
               RowBox[{"levels", ",", 
                RowBox[{"{", 
                 RowBox[{
                 "Plus", ",", "Power", ",", "Times", ",", "x", ",", "y"}], 
                 "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"finalList", "=", 
              RowBox[{"Complement", "[", 
               RowBox[{"cList", ",", 
                RowBox[{"Select", "[", 
                 RowBox[{"cList", ",", "NumberQ"}], "]"}]}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Length", "@", "finalList"}], ">", "0"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"Print", "[", 
                 RowBox[{
                  RowBox[{"Style", "[", 
                   RowBox[{
                   "\"\<expression is not strict polynomial in \>\"", ",", 
                    "Red"}], "]"}], ",", 
                  RowBox[{"Style", "[", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"x", ",", "y"}], "}"}], ",", "Red"}], "]"}]}], 
                 "]"}], ";", "\[IndentingNewLine]", 
                RowBox[{"return", "=", "False"}], ";"}], 
               "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"return", "=", "True"}], ";"}]}], 
              "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", ",",
             "\[IndentingNewLine]", 
