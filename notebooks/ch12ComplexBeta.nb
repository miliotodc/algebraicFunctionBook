Cell[CellGroupData[{

Cell["\<\
Section 2:  Create general Pochhammer contour for complex exponents\
\>", "Section",
 CellChangeTimes->{{3.950343834585603*^9, 3.9503438410775733`*^9}, 
   3.950344400105214*^9, {3.950944188255266*^9, 3.950944195653516*^9}, {
   3.950948134445342*^9, 3.9509481555595837`*^9}, {3.989841149136459*^9, 
   3.9898411653296375`*^9}},ExpressionUUID->"75c0fc14-5afa-4fe8-bcc0-\
59d011811adc"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"(*", "\[IndentingNewLine]", "  ", 
   RowBox[{"general", " ", "pochhammer", " ", "contour"}], 
   "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"contourArray", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pocR1", "=", 
     RowBox[{"1", "/", "3"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pocR2", "=", 
     RowBox[{"1", "/", "2"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{"do", " ", "blue", " ", "contour"}], "\[IndentingNewLine]", 
    "*)"}], "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"blueContourF", "[", "t_", "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"pocR2", " ", "I"}], ")"}], 
       RowBox[{"(", 
        RowBox[{"1", "-", "t"}], ")"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"pocR2", " ", "I"}]}], ")"}], " ", "t"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"blueStartT", "=", "0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"blueEndT", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"blueArrowG", "=", 
     RowBox[{"Graphics", "@", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Arrowheads", "[", "0.025", "]"}], ",", 
        RowBox[{"Arrow", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"ReIm", "@", 
            RowBox[{"blueContourF", "[", "0.1", "]"}]}], ",", 
           RowBox[{"ReIm", "@", 
            RowBox[{"blueContourF", "[", "0.15", "]"}]}]}], "}"}], "]"}]}], 
       "}"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"blueContourPlot", "=", 
     RowBox[{"ParametricPlot", "[", 
      RowBox[{
       RowBox[{"ReIm", "@", 
        RowBox[{"blueContourF", "[", "t", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "blueStartT", ",", "blueEndT"}], "}"}], ",", 
       RowBox[{"AxesOrigin", "->", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}]}], ",", 
       RowBox[{"PlotRange", "->", "1.5"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Thickness", "[", "0.0025", "]"}], ",", "Blue"}], "}"}]}]}],
       "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"AppendTo", "[", 
     RowBox[{"contourArray", ",", 
      RowBox[{"{", 
       RowBox[{"blueContourF", ",", "blueStartT", ",", "blueEndT"}], "}"}]}], 
     "]"}], ";"}], "\[IndentingNewLine]", "  ", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{"do", " ", "purple", " ", "contour"}], "\[IndentingNewLine]", 
    "*)"}], "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"purpleContourF", "[", "t_", "]"}], ":=", 
     RowBox[{"1", "+", 
      RowBox[{"pocR2", " ", 
       RowBox[{"Exp", "[", 
        RowBox[{"I", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Pi", "/", "2"}], 
            RowBox[{"(", 
             RowBox[{"1", "-", "t"}], ")"}]}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "Pi"}], "/", "2"}], ")"}], " ", "t"}]}], ")"}]}], 
        "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"purpleStartT", "=", "0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"purpleEndT", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"purpleContourPlot", "=", 
     RowBox[{"ParametricPlot", "[", 
