     RowBox[{"\"\<ag\>\"", "->", "nextWP"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"val1", "=", 
   RowBox[{"logF", "[", 
    RowBox[{
     RowBox[{"purpleContourF", "[", "1", "]"}], ",", "0", ",", 
     RowBox[{"-", "1"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"val2", "=", 
   RowBox[{"contourBetaF", "[", "1", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Accuracy of purple contourBetaF[1]: \>\"", ",", 
     RowBox[{"Abs", "[", 
      RowBox[{"val1", "-", "val2"}], "]"}]}], "]"}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{"greenLog0WStart", "=", "purpleLog0WEnd"}], 
   ";"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"greenLog1WStart", "=", "purpleLog1WEnd"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nextWP", "=", 
   RowBox[{"Floor", "@", 
    RowBox[{"Precision", "@", "greenLog0WStart"}]}]}], 
