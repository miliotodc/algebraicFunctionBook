Cell[CellGroupData[{

Cell["polishValue", "Subsection",
 CellChangeTimes->{{3.9492481274557424`*^9, 3.9492481291350513`*^9}, 
   3.9500306189810457`*^9},ExpressionUUID->"698df872-83f3-48f5-942a-\
2ef6de02de78"],

Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"polishValue", "[", 
      RowBox[{"zVal_", ",", "wVal_", ",", "wp_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"wTemp", ",", "difArray", ",", "wPos", ",", "eqnPrecision"}], 
        "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"eqnPrecision", "=", 
         RowBox[{"Floor", "@", 
          RowBox[{"Precision", "@", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"theFunction", "==", "0"}], "/.", 
             RowBox[{"z", "->", "zVal"}]}], ")"}]}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"\"\<eqnPrecision: \>\"", ",", "eqnPrecision"}], "]"}], 
          ";"}], "*)"}], "\[IndentingNewLine]", " ", 
        RowBox[{"wTemp", "=", 
         RowBox[{"w", "/.", 
          RowBox[{"NSolve", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"theFunction", "==", "0"}], "/.", 
             RowBox[{"z", "->", "zVal"}]}], ",", "w", ",", 
            RowBox[{"WorkingPrecision", "->", "eqnPrecision"}]}], "]"}]}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"\"\<wTemp: \>\"", ",", "wTemp"}], "]"}], ";"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"difArray", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"wVal", "-", "#"}], "]"}], "&"}], "/@", " ", "wTemp"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"\"\<difArray: \>\"", ",", 
            RowBox[{"difArray", "//", "N"}]}], "]"}], ";"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"wPos", "=", 
         RowBox[{
          RowBox[{"Position", "[", 
           RowBox[{"difArray", ",", 
            RowBox[{"Min", "@", "difArray"}]}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"difArray", "[", 
            RowBox[{"[", "wPos", "]"}], "]"}], ">", 
           RowBox[{"10", "^", 
            RowBox[{"-", "9"}]}]}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"Style", "[", 
             RowBox[{"\"\<polishValue: min dif array>10^-9\>\"", ",", "Red"}],
              "]"}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<  difArray: \>\"", ",", 
             RowBox[{"N", "[", 
              RowBox[{"difArray", ",", "10"}], "]"}]}], "]"}], ";"}]}], 
         "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"wTemp", "[", 
         RowBox[{"[", "wPos", "]"}], "]"}]}]}], "\[IndentingNewLine]", 
      "]"}]}], ";"}], "\[IndentingNewLine]"}]}]], "Input",
