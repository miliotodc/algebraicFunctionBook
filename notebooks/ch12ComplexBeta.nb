Cell[CellGroupData[{

Cell["\<\
Using logF to compute contours without negative direction at branch cuts\
\>", "Section",
 CellChangeTimes->{{3.951041128414365*^9, 
  3.9510411445165*^9}},ExpressionUUID->"434f77ac-224c-47b3-a2f7-6ba312996675"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"wp", "=", "100"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", " ", 
  RowBox[{
   RowBox[{"logVal1", "=", 
    RowBox[{"NIntegrate", "[", 
     RowBox[{
      RowBox[{"logF", "[", 
       RowBox[{"z", ",", "0", ",", "0"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"z", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "1"}], "/", "2"}], "+", "I"}], ",", 
        RowBox[{
         RowBox[{"3", "/", "2"}], "+", "I"}]}], "}"}], ",", 
      RowBox[{"WorkingPrecision", "->", "wp"}]}], "]"}]}], ";", 
   "\[IndentingNewLine]", 
   RowBox[{"logVal2", "=", 
    RowBox[{"NIntegrate", "[", 
     RowBox[{
      RowBox[{"logF", "[", 
       RowBox[{"z", ",", "0", ",", "0"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"z", ",", 
        RowBox[{
         RowBox[{"3", "/", "2"}], "+", "I"}], ",", 
        RowBox[{"3", "/", "2"}]}], "}"}], ",", 
      RowBox[{"WorkingPrecision", "->", "wp"}]}], "]"}]}], ";", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"logVal3", "=", 
    RowBox[{"NIntegrate", "[", 
     RowBox[{
      RowBox[{"logF", "[", 
       RowBox[{"z", ",", "0", ",", 
        RowBox[{"-", "1"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"z", ",", 
        RowBox[{"3", "/", "2"}], ",", 
        RowBox[{
         RowBox[{"3", "/", "2"}], "-", "I"}]}], "}"}], ",", 
      RowBox[{"WorkingPrecision", "->", "wp"}]}], "]"}]}], ";", 
   "\[IndentingNewLine]", 
   RowBox[{"logVal4", "=", 
    RowBox[{"NIntegrate", "[", 
     RowBox[{
      RowBox[{"logF", "[", 
       RowBox[{"z", ",", "0", ",", 
        RowBox[{"-", "1"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"z", ",", 
        RowBox[{
         RowBox[{"3", "/", "2"}], "-", "I"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "1"}], "/", "4"}], "+", "I"}]}], "}"}], ",", 
      RowBox[{"WorkingPrecision", "->", "wp"}]}], "]"}]}], ";", 
   "\[IndentingNewLine]", 
   RowBox[{"logVal5", "=", 
    RowBox[{"NIntegrate", "[", 
     RowBox[{
      RowBox[{"logF", "[", 
       RowBox[{"z", ",", "0", ",", 
        RowBox[{"-", "1"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"z", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "1"}], "/", "4"}], "+", "I"}], ",", 
        RowBox[{
         RowBox[{"-", "1"}], "/", "4"}]}], "}"}], ",", 
      RowBox[{"WorkingPrecision", "->", "wp"}]}], "]"}]}], ";", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"logVal6", "=", 
    RowBox[{"NIntegrate", "[", 
     RowBox[{
      RowBox[{"logF", "[", 
       RowBox[{"z", ",", "1", ",", 
        RowBox[{"-", "1"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"z", ",", 
        RowBox[{
         RowBox[{"-", "1"}], "/", "4"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "1"}], "/", "4"}], "-", "I"}]}], "}"}], ",", 
      RowBox[{"WorkingPrecision", "->", "wp"}]}], "]"}]}], ";", 
   "\[IndentingNewLine]", 
   RowBox[{"logVal7", "=", 
    RowBox[{"NIntegrate", "[", 
     RowBox[{
      RowBox[{"logF", "[", 
       RowBox[{"z", ",", "1", ",", 
        RowBox[{"-", "1"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"z", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "1"}], "/", "4"}], "-", "I"}], ",", 
        RowBox[{
         RowBox[{"3", "/", "2"}], "-", "I"}]}], "}"}], ",", 
      RowBox[{"WorkingPrecision", "->", "wp"}]}], "]"}]}], ";", 
   "\[IndentingNewLine]", 
   RowBox[{"logVal8", "=", 
    RowBox[{"NIntegrate", "[", 
     RowBox[{
      RowBox[{"logF", "[", 
       RowBox[{"z", ",", "1", ",", 
        RowBox[{"-", "1"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"z", ",", 
        RowBox[{
         RowBox[{"3", "/", "2"}], "-", "I"}], ",", 
        RowBox[{"3", "/", "2"}]}], "}"}], ",", 
      RowBox[{"WorkingPrecision", "->", "wp"}]}], "]"}]}], ";", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"logVal9", "=", 
    RowBox[{"NIntegrate", "[", 
     RowBox[{
      RowBox[{"logF", "[", 
       RowBox[{"z", ",", "1", ",", "0"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"z", ",", 
        RowBox[{"3", "/", "2"}], ",", 
        RowBox[{
         RowBox[{"3", "/", "2"}], "+", "I"}]}], "}"}], ",", 
      RowBox[{"WorkingPrecision", "->", "wp"}]}], "]"}]}], ";", 
   "\[IndentingNewLine]", 
   RowBox[{"logVal10", "=", 
    RowBox[{"NIntegrate", "[", 
     RowBox[{
      RowBox[{"logF", "[", 
       RowBox[{"z", ",", "1", ",", "0"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"z", ",", 
        RowBox[{
         RowBox[{"3", "/", "2"}], "+", "I"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "1"}], "/", "2"}], "-", "I"}]}], "}"}], ",", 
      RowBox[{"WorkingPrecision", "->", "wp"}]}], "]"}]}], ";", 
   "\[IndentingNewLine]", 
   RowBox[{"logVal11", "=", 
    RowBox[{"NIntegrate", "[", 
     RowBox[{
      RowBox[{"logF", "[", 
       RowBox[{"z", ",", "1", ",", "0"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"z", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "1"}], "/", "2"}], "-", "I"}], ",", 
        RowBox[{
         RowBox[{"-", "1"}], "/", "2"}]}], "}"}], ",", 
      RowBox[{"WorkingPrecision", "->", "wp"}]}], "]"}]}], ";", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"logVal12", "=", 
    RowBox[{"-", 
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{"logF", "[", 
        RowBox[{"z", ",", "0", ",", "0"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"z", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "1"}], "/", "2"}], "+", "I"}], ",", 
         RowBox[{
          RowBox[{"-", "1"}], "/", "2"}]}], "}"}], ",", 
       RowBox[{"WorkingPrecision", "->", "wp"}]}], "]"}]}]}], ";", 
   "\[IndentingNewLine]", 
   RowBox[{"logSol", "=", 
    RowBox[{
    "logVal1", "+", "logVal2", "+", "logVal3", "+", "logVal4", "+", "logVal5",
      "+", "logVal6", "+", "logVal7", "+", "logVal8", "+", "logVal9", "+", 
     "logVal10", "+", "logVal11", "+", "logVal12"}]}], ";", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"contourValue2", "=", 
    FractionBox["logSol", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{"2", " ", "Pi", " ", "I", " ", "zeroOffset", " ", "theAlpha"}],
        "]"}], 
      RowBox[{"Exp", "[", 
       RowBox[{"2", " ", "Pi", " ", "I", " ", "oneOffset", " ", "theBeta"}], 
       "]"}], 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"Exp", "[", 
         RowBox[{"2", " ", "Pi", " ", "I", " ", "theAlpha"}], "]"}]}], ")"}], 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"Exp", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"-", "2"}], "Pi", " ", "I", " ", "theBeta"}], " ", "]"}]}], 
       ")"}]}]]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"betaValue", "=", 
    RowBox[{"Beta", "[", 
     RowBox[{"theAlpha", ",", "theBeta"}], "]"}]}], ";", 
   "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Error: \>\"", ",", 
     RowBox[{"Abs", "[", 
      RowBox[{"betaValue", "-", "contourValue2"}], "]"}]}], "]"}], ";"}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.95103671573697*^9, 3.951036716800686*^9}, {
  3.95103729885233*^9, 3.9510373247732644`*^9}, {3.951037480559889*^9, 
