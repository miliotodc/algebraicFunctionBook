Cell[BoxData[{
 RowBox[{
  RowBox[{"p3", "=", 
   RowBox[{"ParametricPlot", "[", 
    RowBox[{
     RowBox[{"ReIm", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"3", 
          RowBox[{"Sin", "[", "t", "]"}]}], "+", "theK"}], ")"}], "+", 
       RowBox[{"2", "I", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Sin", "[", "t", "]"}], " ", 
          RowBox[{"Cos", "[", "t", "]"}]}], ")"}]}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", 
       RowBox[{
        RowBox[{"-", "Pi"}], "/", "2"}], ",", 
       RowBox[{"Pi", "/", "2"}]}], "}"}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<x\>\"", ",", "\"\<y\>\""}], "}"}]}], ",", 
     RowBox[{"PlotRange", "->", "4"}], ",", 
     RowBox[{"PlotStyle", "->", "Yellow"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"blueMin", "[", "t_", "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"2.25", 
       RowBox[{"Cos", "[", 
        RowBox[{"Pi", "-", "t"}], "]"}]}], "-", "0.25"}], ")"}], "+", 
    RowBox[{"I", " ", "0.75", " ", 
     RowBox[{"Sin", "[", 
      RowBox[{"Pi", "-", "t"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"greenMin", "[", "t_", "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"1.5", 
       RowBox[{"Sin", "[", "t", "]"}]}], "+", 
      RowBox[{"1", "/", "2"}]}], ")"}], "+", 
    RowBox[{"I", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Sin", "[", "t", "]"}], " ", 
       RowBox[{"Cos", "[", "t", "]"}]}], ")"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"redMin", "[", "t_", "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"2.25", 
       RowBox[{"Cos", "[", "t", "]"}]}], "+", "1.25"}], ")"}], "+", 
    RowBox[{"I", " ", "1.25", " ", 
     RowBox[{"Sin", "[", "t", "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"yellowMin", "[", "t_", "]"}], ":=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"3", 
        RowBox[{"Sin", "[", "t", "]"}]}], "+", 
       RowBox[{"1", "/", "2"}]}], ")"}], "+", 
     RowBox[{"2", "I", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Sin", "[", "t", "]"}], " ", 
        RowBox[{"Cos", "[", "t", "]"}]}], ")"}]}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"AbsoluteTiming", "[", 
   RowBox[{
    RowBox[{"blueInt", "=", " ", 
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"H", "[", 
         RowBox[{
          RowBox[{"blueMin", "[", "t", "]"}], ",", "0", ",", "0"}], "]"}], 
        " ", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"blueMin", "[", "t", "]"}], ",", "t"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "Pi"}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"greenInt", "=", " ", 
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"H", "[", 
         RowBox[{
          RowBox[{"greenMin", "[", "t", "]"}], ",", "0", ",", 
          RowBox[{"-", "1"}]}], "]"}], " ", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"greenMin", "[", "t", "]"}], ",", "t"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", 
         RowBox[{
          RowBox[{"-", "3"}], " ", 
          RowBox[{"Pi", "/", "2"}]}], ",", 
         RowBox[{
          RowBox[{"-", "Pi"}], "/", "2"}]}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"redInt", "=", " ", 
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"H", "[", 
         RowBox[{
          RowBox[{"redMin", "[", "t", "]"}], ",", "1", ",", 
          RowBox[{"-", "1"}]}], "]"}], " ", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"redMin", "[", "t", "]"}], ",", "t"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "Pi", ",", 
         RowBox[{"2", " ", "Pi"}]}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"yellowInt", "=", 
     RowBox[{"-", 
      RowBox[{"NIntegrate", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"H", "[", 
          RowBox[{
           RowBox[{"yellowMin", "[", "t", "]"}], ",", "1", ",", "0"}], "]"}], 
         " ", 
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"yellowMin", "[", "t", "]"}], ",", "t"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", 
          RowBox[{
           RowBox[{"-", "Pi"}], "/", "2"}], ",", 
          RowBox[{"Pi", "/", "2"}]}], "}"}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"AbsoluteTiming", "[", 
