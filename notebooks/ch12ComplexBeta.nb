          RowBox[{
           RowBox[{
            RowBox[{"ToString", "@", "reim"}], "<>", "\"\<(w)\>\""}], ",", 
           "12", ",", "Bold", ",", "Black"}], "]"}]}], "}"}]}], ",", 
      RowBox[{"FaceGridsStyle", "\[Rule]", 
