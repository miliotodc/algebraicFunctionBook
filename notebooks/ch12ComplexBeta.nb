        "sing1G", ",", "sing2G"}], "}"}], ",", 
      RowBox[{"AxesEdge", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", 
           RowBox[{"-", "1"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", 
           RowBox[{"-", "1"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", 
           RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], ",", 
      RowBox[{"Axes", "->", "True"}], ",", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"FaceGrids", "->", 
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "0", ",", 
              RowBox[{"-", "1"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"xGrids", ",", "yGrids"}], "}"}]}], "}"}], "}"}]}], 
        ","}], "*)"}], 
      RowBox[{"AxesLabel", "->", 
       RowBox[{"{", 
        RowBox[{
