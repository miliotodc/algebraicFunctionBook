Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"contourF", "[", "t_", "]"}], ":=", 
     RowBox[{"0.75", " ", 
      RowBox[{"Exp", "[", 
       RowBox[{"I", " ", "t"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tStart", "=", 
     RowBox[{"Pi", "/", "2"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tEnd", "=", 
     RowBox[{"8", 
      RowBox[{"Pi", "/", "6"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wStart0", "=", 
     RowBox[{"Log", "[", 
      RowBox[{"contourF", "[", "tStart", "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wStart1", "=", 
     RowBox[{"Log", "[", 
      RowBox[{"1", "-", 
       RowBox[{"contourF", "[", "tStart", "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{"log0Deriv", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"w", "'"}], "[", "t", "]"}], "==", 
      RowBox[{"(", 
       RowBox[{
        FractionBox["1", 
         RowBox[{"contourF", "[", "t", "]"}]], " ", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"contourF", "[", "t", "]"}], ",", "t"}], "]"}]}], ")"}]}]}],
     ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"log0Sol", "=", 
     RowBox[{"NDSolveValue", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"log0Deriv", ",", 
         RowBox[{
          RowBox[{"w", "[", "tStart", "]"}], "\[Equal]", "wStart0"}]}], "}"}],
        ",", "w", ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "tStart", ",", "tEnd"}], "}"}], ",", 
       RowBox[{"MaxSteps", "\[Rule]", "2000000"}], ",", 
       RowBox[{"MaxStepSize", "\[Rule]", 
        RowBox[{"1", "/", "1000"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"log0WEnd", "=", 
     RowBox[{"log0Sol", "[", "tEnd", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"do", " ", "log", " ", "around", " ", "z"}], "=", 
      RowBox[{"1", " ", "log1Deriv"}]}], ",", "log1WStart", ",", "log1Sol", 
     ",", "log1WEnd"}], "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"log1Deriv", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"w", "'"}], "[", "t", "]"}], "==", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", 
         FractionBox["1", 
          RowBox[{"1", "-", 
           RowBox[{"contourF", "[", "t", "]"}]}]]}], " ", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"contourF", "[", "t", "]"}], ",", "t"}], "]"}]}], ")"}]}]}],
     ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"log1Sol", "=", 
     RowBox[{"NDSolveValue", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"log1Deriv", ",", 
         RowBox[{
          RowBox[{"w", "[", "tStart", "]"}], "\[Equal]", "wStart1"}]}], "}"}],
        ",", "w", ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "tStart", ",", "tEnd"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"log1WEnd", "=", 
     RowBox[{"log1Sol", "[", "tEnd", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{"now", " ", "compute", " ", "integral", " ", "over", " ", "leg"}],
     " ", "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"contourBetaF", "[", "t_", "]"}], ":=", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{"z1", " ", 
         RowBox[{"log0Sol", "[", "t", "]"}]}], "]"}], " ", 
       RowBox[{"Exp", "[", 
        RowBox[{"z2", " ", 
         RowBox[{"log1Sol", "[", "t", "]"}]}], "]"}]}], ")"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"wVal", "=", 
    RowBox[{"contourBetaF", "[", 
     RowBox[{"tStart", "+", "0.5"}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wPointG", "=", 
     RowBox[{"Graphics3D", "@", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"PointSize", "[", "0.025", "]"}], ",", "Yellow", ",", 
        RowBox[{"Point", "@", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Re", "@", 
            RowBox[{"contourF", "[", "tStart", "]"}]}], ",", 
           RowBox[{"Im", "@", 
            RowBox[{"contourF", "[", "tStart", "]"}]}], ",", 
           RowBox[{"reim", "@", "wVal"}]}], "}"}]}]}], "}"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "contourBF2", ",", "theContourPlot2", ",", "cVal2", ",", "pWEnd2", ",", 
       "pWEnd", ",", "tractPoints2"}], "}"}], "=", 
     RowBox[{"getLogContourTract", "[", 
      RowBox[{
      "contour1", ",", "tStart1", ",", "tEnd1", ",", "Blue", ",", "wStart0", 
       ",", "wStart1", ",", "z1", ",", "z2", ",", "reim"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tractArrowG2", "=", 
     RowBox[{"Graphics3D", "@", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Arrowheads", "[", "0.02", "]"}], ",", "Black", ",", 
        RowBox[{"Thickness", "[", "0.005", "]"}], ",", 
        RowBox[{"Arrow", "[", 
         RowBox[{"BSplineCurve", "[", "tractPoints2", "]"}], "]"}]}], 
       "}"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Show", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"plot00", ",", "plot00B", ",", "wPointG", ",", "tractArrowG2"}],
       "}"}], ",", 
     RowBox[{"PlotRange", "->", "All"}]}], "]"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]"}]}]], "Input",
