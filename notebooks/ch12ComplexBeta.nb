Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{
   RowBox[{
    RowBox[{"plot00", "=", 
     RowBox[{"ParametricPlot3D", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Re", "@", "z"}], ",", 
          RowBox[{"Im", "@", "z"}], ",", 
          RowBox[{"reim", "@", 
           RowBox[{"H", "[", 
            RowBox[{"z", ",", "0", ",", "0"}], "]"}]}]}], "}"}], "/.", 
        RowBox[{"z", "->", 
         RowBox[{
          RowBox[{"1", "/", "2"}], "+", 
          RowBox[{"r", " ", 
           RowBox[{"Exp", "[", 
            RowBox[{"I", " ", "t"}], "]"}]}]}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", "0", ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", 
         RowBox[{"-", "Pi"}], ",", "0"}], "}"}], ",", 
       RowBox[{"BoxRatios", "->", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "1", ",", " ", "1"}], "}"}]}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Opacity", "[", "0.5", "]"}], ",", "Red"}], "}"}]}], ",", 
       RowBox[{"RegionFunction", "->", 
        RowBox[{"Function", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"x", ",", "y", ",", "z"}], "}"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"x", "^", "2"}], "+", 
             RowBox[{"y", "^", "2"}]}], ">=", "0.01"}], " ", "&&", " ", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"1", "-", "x"}], ")"}], "^", "2"}], "+", 
             RowBox[{"y", "^", "2"}]}], ">=", "0.01"}]}]}], "]"}]}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"plot00B", "=", 
     RowBox[{"ParametricPlot3D", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Re", "@", "z"}], ",", 
          RowBox[{"Im", "@", "z"}], ",", 
          RowBox[{"reim", "@", 
           RowBox[{"H", "[", 
            RowBox[{"z", ",", "0", ",", "0"}], "]"}]}]}], "}"}], "/.", 
        RowBox[{"z", "->", 
         RowBox[{
          RowBox[{"1", "/", "2"}], "+", 
          RowBox[{"r", " ", 
           RowBox[{"Exp", "[", 
            RowBox[{"I", " ", "t"}], "]"}]}]}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", "0", ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "Pi"}], "}"}], ",", 
       RowBox[{"BoxRatios", "->", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "1", ",", " ", "1"}], "}"}]}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Opacity", "[", "0.5", "]"}], ",", "Red"}], "}"}]}], ",", 
       RowBox[{"RegionFunction", "->", 
        RowBox[{"Function", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"x", ",", "y", ",", "z"}], "}"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"x", "^", "2"}], "+", 
             RowBox[{"y", "^", "2"}]}], ">=", "0.01"}], " ", "&&", " ", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"1", "-", "x"}], ")"}], "^", "2"}], "+", 
             RowBox[{"y", "^", "2"}]}], ">=", "0.01"}]}]}], "]"}]}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
