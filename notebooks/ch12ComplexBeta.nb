Cell[CellGroupData[{

Cell["\<\
Section 3:  Integrating over Pochhammer contour using General contour\
\>", "Section",
 CellChangeTimes->{{3.971942456476884*^9, 3.971942462990687*^9}, {
  3.981191039354039*^9, 3.9811910431122637`*^9}, {3.981191154725024*^9, 
  3.9811911596858892`*^9}},ExpressionUUID->"12b395c8-cd84-4a37-93f5-\
b1f56570de4a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"selectedJ", "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"selectedK", "=", "0"}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"startWP", "=", "30"}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"working", " ", "precision"}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"startAC", "=", "15"}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"accuracy", " ", "goal"}], " ", "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<Blue contour\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{"blueLog0WStart", "=", 
    RowBox[{
     RowBox[{"Log", "[", 
      RowBox[{"blueContourF", "[", "0", "]"}], "]"}], "+", 
     RowBox[{"2", " ", "Pi", " ", "I", " ", "selectedJ"}]}]}], 
   ";"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"blueLog1WStart", "=", 
   RowBox[{
    RowBox[{"Log", "[", 
     RowBox[{"1", "-", 
      RowBox[{"blueContourF", "[", "0", "]"}]}], "]"}], "+", 
    RowBox[{"2", " ", "Pi", " ", "I", " ", "selectedK"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{
    "contourBetaF", ",", "blueLogPlot", ",", "blueContourVal", ",", 
     "blueLog0WEnd", ",", "blueLog1WEnd"}], "}"}], "=", 
   RowBox[{"getLogContour", "[", 
    RowBox[{
    "blueContourF", ",", "0", ",", "1", ",", "Blue", ",", "blueLog0WStart", 
     ",", "blueLog1WStart", ",", "z1", ",", "z2", ",", "reim", ",", 
     RowBox[{"\"\<wp\>\"", "->", "startWP"}], ",", 
     RowBox[{"\"\<ag\>\"", "->", "startWP"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<blueContourVal: \>\"", ",", 
    RowBox[{"blueContourVal", "//", "N"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"val1", "=", 
   RowBox[{"logF", "[", 
    RowBox[{
     RowBox[{"blueContourF", "[", "1", "]"}], ",", "0", ",", "0"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"val2", "=", 
   RowBox[{"contourBetaF", "[", "1", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Accuracy of contourBetaF[1]: \>\"", ",", 
     RowBox[{"Abs", "[", 
      RowBox[{"val1", "-", "val2"}], "]"}]}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"purpleLog0WStart", "=", "blueLog0WEnd"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"purpleLog1WStart", "=", "blueLog1WEnd"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nextWP", "=", 
   RowBox[{"Floor", "@", 
    RowBox[{"Precision", "@", "purpleLog0WStart"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<Purple contour\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{
    "contourBetaF", ",", "purpleLogPlot", ",", "purpleContourVal", ",", 
     "purpleLog0WEnd", ",", "purpleLog1WEnd"}], "}"}], "=", 
   RowBox[{"getLogContour", "[", 
    RowBox[{
    "purpleContourF", ",", "0", ",", "1", ",", "Purple", ",", 
     "purpleLog0WStart", ",", "purpleLog1WStart", ",", "z1", ",", "z2", ",", 
     "reim", ",", 
