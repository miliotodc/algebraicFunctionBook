Cell[CellGroupData[{

Cell["getLogContour", "Subsection",
 CellChangeTimes->{{3.987153803676215*^9, 
  3.9871538057259855`*^9}},ExpressionUUID->"89d523ca-fc0f-45fb-a502-\
255a3a9cbbdd"],

Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Options", "[", "getLogContour", "]"}], "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<wp\>\"", "->", "MachinePrecision"}], ",", 
       RowBox[{"\"\<ag\>\"", "->", "MachinePrecision"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{"getLogContour", "[", 
     RowBox[{
     "contourF_", ",", "tStart_", ",", "tEnd_", ",", "color_", ",", 
      "log0WStart_", ",", "log1WStart_", ",", "z1_", ",", "z2_", ",", "type_",
       ",", 
      RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "log0Deriv", ",", "log0Sol", ",", "log0WEnd", ",", "log1Deriv", ",", 
        "log1Sol", ",", "contourBetaF", ",", "contourLogPlot", ",", 
        "contourVal", ",", "log1WEnd"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", "\[IndentingNewLine]", " ", 
       RowBox[{"do", " ", "log0", " ", "trace"}], "\[IndentingNewLine]", 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"log0Deriv", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"w", "'"}], "[", "t", "]"}], "==", 
         RowBox[{"(", 
          RowBox[{
           FractionBox["1", 
            RowBox[{"contourF", "[", "t", "]"}]], " ", 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"contourF", "[", "t", "]"}], ",", "t"}], "]"}]}], 
          ")"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"log0Sol", "=", 
        RowBox[{"NDSolveValue", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"log0Deriv", ",", 
            RowBox[{
             RowBox[{"w", "[", "tStart", "]"}], "\[Equal]", "log0WStart"}]}], 
           "}"}], ",", "w", ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "tStart", ",", "tEnd"}], "}"}], ",", 
          RowBox[{"MaxSteps", "\[Rule]", "2000000"}], ",", 
          RowBox[{"MaxStepSize", "\[Rule]", 
           RowBox[{"1", "/", "1000"}]}], ",", 
          RowBox[{"WorkingPrecision", "->", 
           RowBox[{"OptionValue", "[", "\"\<wp\>\"", "]"}]}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Precision of log0Sol: \>\"", ",", 
         RowBox[{"Precision", "@", "log0Sol"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"log0WEnd", "=", 
        RowBox[{"log0Sol", "[", "tEnd", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", "\[IndentingNewLine]", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"do", " ", "log", " ", "around", " ", "z"}], "=", 
          RowBox[{"1", " ", "log1Deriv"}]}], ",", "log1WStart", ",", 
         "log1Sol", ",", "log1WEnd"}], "\[IndentingNewLine]", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"log1Deriv", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"w", "'"}], "[", "t", "]"}], "==", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", 
            FractionBox["1", 
             RowBox[{"1", "-", 
              RowBox[{"contourF", "[", "t", "]"}]}]]}], " ", 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"contourF", "[", "t", "]"}], ",", "t"}], "]"}]}], 
          ")"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"log1Sol", "=", 
        RowBox[{"NDSolveValue", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"log1Deriv", ",", 
            RowBox[{
             RowBox[{"w", "[", "tStart", "]"}], "\[Equal]", "log1WStart"}]}], 
           "}"}], ",", "w", ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "tStart", ",", "tEnd"}], "}"}], ",", 
          RowBox[{"WorkingPrecision", "->", 
           RowBox[{"OptionValue", "[", "\"\<wp\>\"", "]"}]}], ",", 
          RowBox[{"AccuracyGoal", "->", 
           RowBox[{"OptionValue", "[", "\"\<ag\>\"", "]"}]}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Precision of log1Sol: \>\"", ",", 
         RowBox[{"Precision", "@", "log1Sol"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"log1WEnd", "=", 
        RowBox[{"log1Sol", "[", "tEnd", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", "\[IndentingNewLine]", " ", 
        RowBox[{
        "now", " ", "compute", " ", "integral", " ", "over", " ", "leg"}], 
        " ", "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", " ", 
       RowBox[{
        RowBox[{"contourBetaF", "[", "t_", "]"}], ":=", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{"z1", " ", 
            RowBox[{"log0Sol", "[", "t", "]"}]}], "]"}], " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"z2", " ", 
            RowBox[{"log1Sol", "[", "t", "]"}]}], "]"}]}], ")"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"contourLogPlot", "=", 
        RowBox[{"ParametricPlot3D", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Re", "@", "z"}], ",", 
             RowBox[{"Im", "@", "z"}], ",", 
             RowBox[{"type", "@", 
              RowBox[{"contourBetaF", "[", "t", "]"}]}]}], "}"}], "/.", 
           RowBox[{"z", "->", 
            RowBox[{"contourF", "[", "t", "]"}]}]}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "tStart", ",", "tEnd"}], "}"}], ",", 
          RowBox[{"PlotStyle", "->", "color"}], ",", 
          RowBox[{"BoxRatios", "->", 
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "1", ",", " ", "1"}], "}"}]}]}], "]"}]}], 
       ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"contourVal", "=", 
        RowBox[{"NIntegrate", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"contourBetaF", "[", "t", "]"}], " ", 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"contourF", "[", "t", "]"}], ",", "t"}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "tStart", ",", "tEnd"}], "}"}], 
          RowBox[{"(*", 
           RowBox[{"Method", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<GlobalAdaptive\>\"", ",", 
              RowBox[{"\"\<MaxErrorIncreases\>\"", "->", "600"}], ",", 
              RowBox[{"Method", "->", "\"\<LevinRule\>\""}]}], "}"}]}], 
           "*)"}], ",", 
          RowBox[{"AccuracyGoal", "->", 
           RowBox[{"OptionValue", "[", "\"\<ag\>\"", "]"}]}], ",", 
          RowBox[{"WorkingPrecision", "->", 
           RowBox[{"OptionValue", "[", "\"\<wp\>\"", "]"}]}], ",", 
          RowBox[{"MaxRecursion", "->", "300"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"NIntegrate", "[", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"polishMedial", "[", 
             RowBox[{"t", ",", "rationalRNorm", ",", "implicitF", ",", 
              RowBox[{"lowPrecMedialSol", "[", "t", "]"}], ",", 
              "$preciseAnalyticPolishPrecision"}], "]"}], 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Cos", "[", 
               RowBox[{"t", " ", 
                RowBox[{"k", "/", "$selectedBranchSize"}]}], "]"}], "-", 
              RowBox[{"I", " ", 
               RowBox[{"Sin", "[", 
                RowBox[{"t", " ", 
                 RowBox[{"k", "/", "$selectedBranchSize"}]}], "]"}]}]}], 
             ")"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", 
             RowBox[{"thePartitions", "[", 
              RowBox[{"[", 
               RowBox[{"index", ",", "1"}], "]"}], "]"}], ",", 
             RowBox[{"thePartitions", "[", 
              RowBox[{"[", 
               RowBox[{"index", ",", "2"}], "]"}], "]"}]}], "}"}], ",", 
           RowBox[{"Method", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<GlobalAdaptive\>\"", ",", 
              RowBox[{"\"\<MaxErrorIncreases\>\"", "->", "600"}], ",", 
              RowBox[{"Method", "->", "\"\<LevinRule\>\""}]}], "}"}]}], ",", 
           RowBox[{
           "WorkingPrecision", "->", "$preciseAnalyticPolishPrecision"}], ",", 
           RowBox[{"AccuracyGoal", "->", 
            RowBox[{"$preciseAnalyticPolishPrecision", "/", "2"}]}], ",", 
           RowBox[{"MaxRecursion", "->", "Infinity"}]}], "]"}], ","}], 
        "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
        "contourBetaF", ",", "contourLogPlot", ",", "contourVal", ",", 
         "log0WEnd", ",", "log1WEnd"}], "}"}]}]}], "\[IndentingNewLine]", 
     "\[IndentingNewLine]", "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.9510342388626823`*^9, 3.9510342402309732`*^9}},
 CellLabel->"In[8]:=",ExpressionUUID->"28987db5-9af1-44ad-92af-ff75c6295019"]
}, Open  ]],

