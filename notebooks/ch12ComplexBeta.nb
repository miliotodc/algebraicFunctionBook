  3.971942726113469*^9}},ExpressionUUID->"b4a98c36-1951-4eed-ab02-\
acf427bbee62"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"zeroOffset", "=", "0"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"oneOffset", "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"logVal1", "=", 
   RowBox[{"NIntegrate", "[", 
    RowBox[{
     RowBox[{"H", "[", 
      RowBox[{"z", ",", "0", ",", "0"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"z", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "1"}], "/", "2"}], "+", "I"}], ",", 
       RowBox[{
        RowBox[{"3", "/", "2"}], "+", "I"}]}], "}"}], ",", 
     RowBox[{"WorkingPrecision", "->", "25"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"logVal2", "=", 
    RowBox[{"NIntegrate", "[", 
     RowBox[{
      RowBox[{"H", "[", 
       RowBox[{"z", ",", "0", ",", "0"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"z", ",", 
        RowBox[{
         RowBox[{"3", "/", "2"}], "+", "I"}], ",", 
        RowBox[{"3", "/", "2"}]}], "}"}], ",", 
      RowBox[{"WorkingPrecision", "->", "25"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"logVal3", "=", 
   RowBox[{"-", 
    RowBox[{"NIntegrate", "[", 
     RowBox[{
      RowBox[{"H", "[", 
       RowBox[{"z", ",", "0", ",", 
        RowBox[{"-", "1"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"z", ",", 
        RowBox[{
         RowBox[{"3", "/", "2"}], "-", "I"}], ",", 
        RowBox[{"3", "/", "2"}]}], "}"}], ",", 
      RowBox[{"WorkingPrecision", "->", "25"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"logVal4", "=", 
   RowBox[{"NIntegrate", "[", 
    RowBox[{
     RowBox[{"H", "[", 
      RowBox[{"z", ",", "0", ",", 
       RowBox[{"-", "1"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"z", ",", 
       RowBox[{
        RowBox[{"3", "/", "2"}], "-", "I"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "1"}], "/", "4"}], "+", "I"}]}], "}"}], ",", 
     RowBox[{"WorkingPrecision", "->", "25"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"logVal5", "=", 
    RowBox[{"NIntegrate", "[", 
     RowBox[{
      RowBox[{"H", "[", 
       RowBox[{"z", ",", "0", ",", 
        RowBox[{"-", "1"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"z", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "1"}], "/", "4"}], "+", "I"}], ",", 
        RowBox[{
         RowBox[{"-", "1"}], "/", "4"}]}], "}"}], ",", 
      RowBox[{"WorkingPrecision", "->", "25"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"logVal6", "=", 
   RowBox[{"-", 
    RowBox[{"NIntegrate", "[", 
     RowBox[{
      RowBox[{"H", "[", 
       RowBox[{"z", ",", "1", ",", 
        RowBox[{"-", "1"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"z", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "1"}], "/", "4"}], "-", "I"}], ",", 
        RowBox[{
         RowBox[{"-", "1"}], "/", "4"}]}], "}"}], ",", 
      RowBox[{"WorkingPrecision", "->", "25"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"logVal7", "=", 
   RowBox[{"NIntegrate", "[", 
    RowBox[{
     RowBox[{"H", "[", 
      RowBox[{"z", ",", "1", ",", 
       RowBox[{"-", "1"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"z", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "1"}], "/", "4"}], "-", "I"}], ",", 
       RowBox[{
        RowBox[{"3", "/", "2"}], "-", "I"}]}], "}"}], ",", 
     RowBox[{"WorkingPrecision", "->", "25"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"logVal8", "=", 
    RowBox[{"NIntegrate", "[", 
     RowBox[{
      RowBox[{"H", "[", 
       RowBox[{"z", ",", "1", ",", 
        RowBox[{"-", "1"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"z", ",", 
        RowBox[{
         RowBox[{"3", "/", "2"}], "-", "I"}], ",", 
        RowBox[{"3", "/", "2"}]}], "}"}], ",", 
      RowBox[{"WorkingPrecision", "->", "25"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"logVal9", "=", 
   RowBox[{"-", 
    RowBox[{"NIntegrate", "[", 
     RowBox[{
      RowBox[{"H", "[", 
       RowBox[{"z", ",", "1", ",", "0"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"z", ",", 
        RowBox[{
         RowBox[{"3", "/", "2"}], "+", "I"}], ",", 
        RowBox[{"3", "/", "2"}]}], "}"}], ",", 
      RowBox[{"WorkingPrecision", "->", "25"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"logVal10", "=", 
   RowBox[{"NIntegrate", "[", 
    RowBox[{
     RowBox[{"H", "[", 
      RowBox[{"z", ",", "1", ",", "0"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"z", ",", 
       RowBox[{
        RowBox[{"3", "/", "2"}], "+", "I"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "1"}], "/", "2"}], "-", "I"}]}], "}"}], ",", 
     RowBox[{"WorkingPrecision", "->", "25"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"logVal11", "=", 
    RowBox[{"NIntegrate", "[", 
     RowBox[{
      RowBox[{"H", "[", 
       RowBox[{"z", ",", "1", ",", "0"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"z", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "1"}], "/", "2"}], "-", "I"}], ",", 
        RowBox[{
         RowBox[{"-", "1"}], "/", "2"}]}], "}"}], ",", 
      RowBox[{"WorkingPrecision", "->", "25"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"logVal12", "=", 
   RowBox[{"-", 
    RowBox[{"NIntegrate", "[", 
     RowBox[{
      RowBox[{"logF", "[", 
       RowBox[{"z", ",", "0", ",", "0"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"z", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "1"}], "/", "2"}], "+", "I"}], ",", 
        RowBox[{
         RowBox[{"-", "1"}], "/", "2"}]}], "}"}], ",", 
      RowBox[{"WorkingPrecision", "->", "25"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"HSol", "=", 
   RowBox[{
   "logVal1", "+", "logVal2", "+", "logVal3", "+", "logVal4", "+", "logVal5", 
    "+", "logVal6", "+", "logVal7", "+", "logVal8", "+", "logVal9", "+", 
    "logVal10", "+", "logVal11", "+", "logVal12"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"contourValue2", "=", 
    FractionBox["HSol", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{"2", " ", "Pi", " ", "I", " ", "zeroOffset", " ", "theAlpha"}],
        "]"}], 
      RowBox[{"Exp", "[", 
       RowBox[{"2", " ", "Pi", " ", "I", " ", "oneOffset", " ", "theBeta"}], 
       "]"}], 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"Exp", "[", 
         RowBox[{"2", " ", "Pi", " ", "I", " ", "theAlpha"}], "]"}]}], ")"}], 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"Exp", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"-", "2"}], "Pi", " ", "I", " ", "theBeta"}], " ", "]"}]}], 
       ")"}]}]]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"betaValue", "=", 
   RowBox[{"Beta", "[", 
    RowBox[{"theAlpha", ",", "theBeta"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
