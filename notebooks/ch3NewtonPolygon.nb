       RowBox[{"w", "^", "5"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"z", "^", "5"}], "+", 
         RowBox[{"z", "^", "9"}]}], ")"}], " ", 
       RowBox[{"w", "^", "9"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"z", "+", 
         RowBox[{"z", "^", "3"}]}], ")"}], 
       RowBox[{"w", "^", "12"}]}], "+", 
      RowBox[{"6", 
       RowBox[{"w", "^", "14"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"2", "+", 
         RowBox[{"z", "^", "2"}]}], ")"}], 
       RowBox[{"w", "^", "15"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"$theTestCase", "=", "\"\<testCase0002\>\""}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"subDirectory", "=", "$theTestCase"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"!", 
       RowBox[{"TrueQ", "@", 
        RowBox[{"FileExistsQ", "@", 
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{"dataDir", ",", "subDirectory"}], "}"}], "]"}]}]}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"CreateDirectory", "[", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{"dataDir", ",", "subDirectory"}], "}"}], "]"}], "]"}], 
       ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Function: \>\"", ",", 
      RowBox[{"aForm", "[", "$theFunction", "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wExp", "=", 
     RowBox[{"Exponent", "[", 
      RowBox[{"$theFunction", ",", "w", ",", "List"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"functionDegree", "=", 
     RowBox[{"Last", "@", "wExp"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fVals", "=", 
     RowBox[{"Sort", "[", 
      RowBox[{"w", "/.", 
       RowBox[{"NSolve", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"$theFunction", "==", "0"}], "/.", 
          RowBox[{"z", "->", "0"}]}], ",", "w"}], "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dVals", "=", 
     RowBox[{"Sort", "[", 
      RowBox[{"w", "/.", 
       RowBox[{"NSolve", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{"$theFunction", ",", "w"}], "]"}], "==", "0"}], "/.", 
          RowBox[{"z", "->", "0"}]}], ",", "w"}], "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fValsPrec", "=", 
     RowBox[{"Precision", "@", "fVals"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "@", 
        RowBox[{"Intersection", "[", 
         RowBox[{"fVals", ",", "dVals"}], "]"}]}], "!=", "0"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"Style", "[", 
         RowBox[{"\"\<Origin is a singular point!\>\"", ",", "Red"}], "]"}], 
        "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]"}]}]], "Input",
