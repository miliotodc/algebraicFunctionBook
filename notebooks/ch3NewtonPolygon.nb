Cell[BoxData[{
 RowBox[{
  RowBox[{"zExpMax", "=", "5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"wExpMax", "=", "15"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sparseVal", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"randomNum", "[", "n_", "]"}], ":=", " ", 
   RowBox[{"RandomChoice", "[", 
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{"0", ",", 
        RowBox[{"{", "n", "}"}]}], "]"}], ",", 
      RowBox[{"{", "1", "}"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"getZPower", "[", "n_", "]"}], ":=", 
    RowBox[{
     RowBox[{"randomNum", "[", "sparseVal", "]"}], 
     RowBox[{"RandomInteger", "[", 
      RowBox[{"{", 
       RowBox[{"0", ",", "5"}], "}"}], "]"}]}]}], 
   ";"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"getWPower", "[", "n_", "]"}], ":=", " ", 
   RowBox[{
    RowBox[{"randomNum", "[", "sparseVal", "]"}], 
    RowBox[{"RandomInteger", "[", 
     RowBox[{"{", 
      RowBox[{"0", ",", "n"}], "}"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"getcoef", "[", 
    RowBox[{"a_", ",", "b_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"RandomInteger", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "a"}], ",", "a"}], "}"}], "]"}], "/", 
    RowBox[{"RandomInteger", "[", 
     RowBox[{"{", 
      RowBox[{"1", ",", "b"}], "}"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"$theFunction", "=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"randomNum", "[", "sparseVal", "]"}], " ", 
      RowBox[{"getcoef", "[", 
       RowBox[{"8", ",", "5"}], "]"}], 
      RowBox[{"z", "^", 
       RowBox[{"getZPower", "[", "zExpMax", "]"}]}], " ", 
      RowBox[{"w", "^", 
       RowBox[{"getWPower", "[", "wExpMax", "]"}]}]}], ",", 
     RowBox[{"{", "wExpMax", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
