Cell[CellGroupData[{

Cell["Section 3.3:  Compute comparison series", "Subsection",
 CellChangeTimes->{{3.976521231943103*^9, 3.9765212391038604`*^9}, {
  3.976521588190381*^9, 3.9765215907335615`*^9}, {3.9818243655570774`*^9, 
  3.9818243673080406`*^9}},ExpressionUUID->"5fcbc3f1-6c6e-4b0a-9254-\
928796bb135e"],

Cell["\<\
This routine is run after the Root Test results which create \
$comparisonSequence  as the list of singular points to check analytic \
continuation for a selected base singular point.  the command is
$puiseuxSaveTable=getInitialSegments[$theFunction,$comparisonSequence{{2;;]]];\
\>", "Text",
 CellChangeTimes->{{3.97652125632355*^9, 
  3.9765213341632967`*^9}},ExpressionUUID->"cb9cdbed-8b9e-4ae5-bb17-\
745ce6e56af0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"totalPoints", "=", 
     RowBox[{"Length", "@", "$theSingularList"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"PrintTemporary", "[", 
     RowBox[{"\"\<     Analzing root: \>\"", ",", 
      RowBox[{"Dynamic", "@", "theIndex"}], ",", "\"\</\>\"", ",", 
      "totalPoints"}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"$puiseuxSave", "=", 
     RowBox[{"{", "}"}]}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{
    "used", " ", "by", " ", "getNewtonData", " ", "and", " ", 
     "getInitialSegments", " ", "to", " ", "save", " ", "initial", " ", 
     "segment", " ", "data"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"$polygonFigures", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"zeroIndexTally", "=", "0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"poleIndexTally", "=", "0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"$rootTally", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{
    "variables", " ", "to", " ", "save", " ", "Newton", " ", "iteration", " ",
      "data", " ", "when", " ", "SaveNewtonDataFlag", " ", "is", " ", "set"}],
     "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"$pHatSave", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"$pBarSave", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"$currentIteratedW", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"charEqnsSave", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"$fIterates", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wTermsSave", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cValSave", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"$multipleRootCheck", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tempFunSave", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"$charDataSave", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{
    "main", " ", "routine", " ", "to", " ", "compute", " ", "segments"}], 
    "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"$puiseuxSaveTable", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"at", "=", 
     RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"$puiseuxSaveTable", "=", 
        RowBox[{"getInitialSegments", "[", 
         RowBox[{"$theFunction", ",", 
          RowBox[{"$comparisonSequence", "[", 
           RowBox[{"[", 
            RowBox[{"2", ";;"}], "]"}], "]"}]}], "]"}]}], ";"}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{
     RowBox[{
     "confirm", " ", "there", " ", "is", " ", "a", " ", "singularity", " ", 
      "at", " ", "each", " ", "singular", " ", "point"}], ",", " ", 
     RowBox[{
     "either", " ", "a", " ", "pole", " ", "or", " ", "ramified", " ", 
      "surface"}]}], "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"singularFlag", "=", "True"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"poleIndex", "=", "0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"segNum", "=", "1"}], ",", 
      RowBox[{"segNum", "<=", 
       RowBox[{"Length", "@", "$puiseuxSaveTable"}]}], ",", 
      RowBox[{"segNum", "++"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"singIndex", "=", 
        RowBox[{"$puiseuxSaveTable", "[", 
         RowBox[{"[", 
          RowBox[{"segNum", ",", "3"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", " ", 
       RowBox[{"cycleList", "=", 
        RowBox[{"$puiseuxSaveTable", "[", 
         RowBox[{"[", 
          RowBox[{"segNum", ",", "2", ",", "All", ",", "3"}], "]"}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{
          RowBox[{
          "first", " ", "check", " ", "if", " ", "have", " ", "all", " ", 
           "1"}], "-", 
          RowBox[{
          "cycles", " ", "at", " ", "this", " ", "singular", " ", "point"}]}],
          ",", " ", 
         RowBox[{
         "then", " ", "must", " ", "have", " ", "at", " ", "least", " ", 
          "one", " ", "pole"}]}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Length", "@", 
            RowBox[{"Cases", "[", 
             RowBox[{"cycleList", ",", 
              RowBox[{"x_", "/;", 
               RowBox[{"x", ">", "1"}]}]}], "]"}]}], "==", "0"}], " ", "&&", 
          " ", 
          RowBox[{"!", 
           RowBox[{"MemberQ", "[", 
            RowBox[{"$poleIndexes", ",", "singIndex"}], "]"}]}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{
             "\"\<Found only 1-cycles with no pole at singular index: \>\"", 
              ",", "Red"}], "]"}], ",", "singIndex"}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"singularFlag", "=", "False"}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", "\[IndentingNewLine]", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"If", " ", "all", " ", "1"}], "-", "cycle"}], ",", " ", 
         RowBox[{
         "confirm", " ", "this", " ", "singular", " ", "point", " ", "is", 
          " ", "a", " ", "pole"}]}], "\[IndentingNewLine]", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"MemberQ", "[", 
          RowBox[{"$poleIndexes", ",", "singIndex"}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"poleData", "=", 
           RowBox[{"$puiseuxSaveTable", "[", 
            RowBox[{"[", 
             RowBox[{"segNum", ",", "2", ",", "All", ",", 
              RowBox[{"{", 
               RowBox[{"4", ",", "8"}], "}"}]}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"netExpList", "=", 
           RowBox[{"Flatten", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"FoldList", "[", 
                RowBox[{"Plus", ",", 
                 RowBox[{"#1", "[", 
                  RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "-", 
               RowBox[{"#", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], "&"}], " ", "/@", " ", 
             "poleData"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"AnyTrue", "[", 
             RowBox[{"netExpList", ",", "Negative"}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{"Print", "[", 
               RowBox[{
                RowBox[{"Style", "[", 
                 RowBox[{
                 "\"\<Pole confirmed at singular index \>\"", ",", "Red"}], 
                 "]"}], ",", 
                RowBox[{"Style", "[", 
                 RowBox[{"singIndex", ",", "Red"}], "]"}]}], "]"}], ";"}], 
             "*)"}], "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"poleIndex", "++"}], ";"}], "\[IndentingNewLine]", ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{
               RowBox[{"Style", "[", 
                RowBox[{
                "\"\<Did not find pole at expected singular point\>\"", ",", 
                 "Red", ",", "14"}], "]"}], ",", 
               RowBox[{"Style", "[", 
                RowBox[{"singIndex", ",", "Red", ",", "14"}], "]"}]}], "]"}], 
             ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"poleIndex", "==", 
        RowBox[{"Length", "@", "$poleIndexes"}]}], " ", "&&", " ", 
       RowBox[{
        RowBox[{"Length", "@", "$poleIndexes"}], ">", "1"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"Style", "[", 
         RowBox[{"\"\<All poles confirmed\>\"", ",", "Red", ",", "Bold"}], 
         "]"}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Precision", "@", "$puiseuxSaveTable"}], "<", "900"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"Style", "[", 
         RowBox[{
         "\"\<$puiseuxSaveTable precision<900. \>\"", ",", "Red", ",", 
          "Bold"}], "]"}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"zeroIndexTally", "==", 
        RowBox[{"Length", "@", "$zeroIndexes"}]}], " ", "&&", " ", 
       RowBox[{
        RowBox[{"Length", "@", "$zeroIndexes"}], ">", "0"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"Style", "[", 
         RowBox[{
         "\"\<All zero singular points with higher ramifications\>\"", ",", 
          "Blue", ",", "Bold"}], "]"}], "]"}], ";"}]}], "\[IndentingNewLine]",
      "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"poleIndexTally", "==", 
