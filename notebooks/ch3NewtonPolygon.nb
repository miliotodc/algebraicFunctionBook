                "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
               "\[IndentingNewLine]", 
               RowBox[{"Plot", "[", 
                RowBox[{
                 RowBox[{"theY", "[", "x", "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"x", ",", "0", ",", "xStop"}], "}"}], ",", 
                 RowBox[{"PlotStyle", "->", 
                  RowBox[{"{", 
                   RowBox[{"Dashed", ",", 
                    RowBox[{"colorArray", "[", 
                    RowBox[{"[", "lineIndex", "]"}], "]"}]}], "}"}]}]}], 
                "]"}]}], ",", "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{"lineIndex", ",", "1", ",", 
                RowBox[{"Length", "@", "legArray"}]}], "}"}]}], 
             "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"legendPlot", "=", 
            RowBox[{"Plot", "[", 
             RowBox[{"0", ",", 
              RowBox[{"{", 
               RowBox[{"x", ",", "0", ",", 
                RowBox[{"10", "^", 
                 RowBox[{"-", "4"}]}]}], "}"}], ",", 
              RowBox[{"PlotLegends", "->", "thePlotLegend"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"Show", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
               "convexHullG", ",", "finalLegPointsG", ",", "lineG", ",", 
                "polygonPointsG", ",", "hullPointsG", ",", "dashPlots", ",", 
                "legendPlot"}], "}"}], ",", 
              RowBox[{"Axes", "->", "True"}], ",", 
              RowBox[{"GridLines", "->", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Table", "[", 
                  RowBox[{"i", ",", 
                   RowBox[{"{", 
                    RowBox[{"i", ",", "0", ",", "maxX"}], "}"}]}], "]"}], ",", 
                 RowBox[{"Table", "[", 
                  RowBox[{"i", ",", 
                   RowBox[{"{", 
                    RowBox[{"i", ",", "0", ",", "maxY"}], "}"}]}], "]"}]}], 
                "}"}]}], ",", 
              RowBox[{"AspectRatio", "\[Rule]", "1"}], ",", 
              RowBox[{"PlotRange", "\[Rule]", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"0", ",", "maxX"}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"0", ",", "maxY"}], "}"}]}], "}"}]}], ",", 
              RowBox[{"FrameLabel", "->", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Style", "[", 
                  RowBox[{"\"\<i\>\"", ",", "14", ",", "Bold", ",", "Black"}],
                   "]"}], ",", 
                 RowBox[{"Rotate", "[", 
                  RowBox[{
                   RowBox[{"Style", "[", 
                    RowBox[{
                    "\"\<ord(\!\(\*SubscriptBox[\(a\), \(i\)]\))\>\"", ",", 
                    "14", ",", "Bold", ",", "Black"}], "]"}], ",", 
                   RowBox[{
                    RowBox[{"-", "90"}], " ", "Degree"}]}], "]"}]}], "}"}]}], 
              ",", 
              RowBox[{"Frame", "->", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"True", ",", "False"}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"True", ",", "False"}], "}"}]}], "}"}]}]}], 
             RowBox[{"(*", 
              RowBox[{",", 
               RowBox[{"PlotLabel", "->", 
                RowBox[{"Row", "[", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"Style", "[", 
                    RowBox[{
                    SubscriptBox["f", "theK"], ",", "14", ",", "Bold", ",", 
                    "Black"}], "]"}], ",", 
                   RowBox[{"Style", "[", 
                    RowBox[{
                    "\"\< Newton Polygon\>\"", ",", "14", ",", "Bold", ",", 
                    "Black"}], "]"}]}], "}"}], "]"}]}]}], "*)"}], "]"}], 
            "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"subReturn", "=", 
            RowBox[{"{", 
             RowBox[{"legArray", ",", "polygonPoints", ",", "rotatedPoints"}],
              "}"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", "subReturn"}]}], 
      "\[IndentingNewLine]", "\[IndentingNewLine]", " ", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]"}]}]], "Input",
