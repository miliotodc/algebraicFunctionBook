Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"getSeriesTypes", "[", 
     RowBox[{"baseSeries_", ",", "baseSheetLinks_", ",", "baseRemovalList_"}],
      "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "baseSheetNumbers", ",", "seriesLengths", ",", "theExpList", ",", 
        "minExpList", ",", "cycleTypes", ",", "multiType", ",", "newType", 
        ",", "multiBranchType", ",", "theLType", ",", "minE", ",", "type", 
        ",", "theD", ",", "theN", ",", " ", "theTally", ",", "mVals", ",", 
        "j", ",", "typeLoc", ",", "i", ",", "typeTable"}], " ", "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", "\[IndentingNewLine]", " ", 
       RowBox[{"uniquely", " ", "name", " ", "each", " ", "branch"}], 
       "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"baseSheetNumbers", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"Min", "@", "#"}], "&"}], " ", "/@", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "&"}], "/@", "baseSheetLinks"}], 
          ")"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"seriesLengths", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "#", "]"}], "&"}], "/@", " ", 
         RowBox[{"baseSeries", "[", 
          RowBox[{"[", "baseSheetNumbers", "]"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", " ", 
       RowBox[{"theExpList", "=", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"Exponent", "[", 
           RowBox[{"#", ",", "z", ",", "List"}], "]"}], "&"}], "/@", " ", 
         RowBox[{"baseSeries", "[", 
          RowBox[{"[", "baseSheetNumbers", "]"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"minExpList", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"Min", "[", "#", "]"}], "&"}], " ", "/@", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Select", "[", 
             RowBox[{"#", ",", 
              RowBox[{
               RowBox[{"#", "!=", "0"}], "&"}]}], "]"}], "&"}], "/@", " ", 
           "theExpList"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"cycleTypes", "=", 
        RowBox[{"baseSheetLinks", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"multiType", "[", 
         RowBox[{"a_Integer", ",", "b_String"}], "]"}], ":=", 
        RowBox[{
         RowBox[{
         "StringTemplate", "[", 
          "\"\<\!\(\*SubscriptBox[\(\[InvisiblePrefixScriptBase]\), \
\((`1`)\)]\)`2`\>\"", "]"}], "[", 
         RowBox[{
          RowBox[{"ToString", "@", "a"}], ",", "b"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"newType", "[", 
         RowBox[{
         "a_Integer", ",", "b_String", ",", "c_Integer", ",", "d_Integer"}], 
         "]"}], ":=", 
        RowBox[{
         RowBox[{
         "StringTemplate", "[", 
          "\"\<\!\(\*SubscriptBox[\(\[InvisiblePrefixScriptBase]\), \
\(`1`\)]\)\!\(\*SubsuperscriptBox[\(`2`\), \(`3`\), \(`4`\)]\)\>\"", "]"}], 
         "[", 
         RowBox[{
          RowBox[{"ToString", "@", "a"}], ",", "b", ",", 
          RowBox[{"ToString", "@", "c"}], ",", 
          RowBox[{"ToString", "@", "d"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"multiBranchType", "[", 
         RowBox[{"a_String", ",", "b_Integer", ",", "c_Integer"}], "]"}], ":=", 
        RowBox[{
         RowBox[{
         "StringTemplate", "[", 
          "\"\<\[InvisiblePrefixScriptBase]\!\(\*SubsuperscriptBox[\(`1`\), \
\(`2`\), \(`3`\)]\)\>\"", "]"}], "[", 
         RowBox[{
          RowBox[{"ToString", "@", "a"}], ",", 
          RowBox[{"ToString", "@", "b"}], ",", 
          RowBox[{"ToString", "@", "c"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"theLType", "[", 
         RowBox[{"a_String", ",", "b_Integer"}], "]"}], ":=", 
        RowBox[{
         RowBox[{
         "StringTemplate", "[", 
          "\"\<\!\(\*SubscriptBox[\(`1`\), \(`2`\)]\)\>\"", "]"}], "[", 
         RowBox[{"a", ",", 
          RowBox[{"ToString", "@", "b"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", " ", 
       RowBox[{"(*", " ", "\[IndentingNewLine]", 
        RowBox[{"pick", " ", "out", " ", "Taylor", " ", 
         RowBox[{"series", ":"}]}], " ", "\[IndentingNewLine]", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"typeTable", "=", 
        RowBox[{"Table", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"minE", "=", 
            RowBox[{"minExpList", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"cycleTypes", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "==", "1"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"baseRemovableList", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", ",", "2"}], "]"}], "]"}], "!=", 
                 RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", 
                RowBox[{"(*", 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{"MemberQ", "[", 
                    RowBox[{
                    RowBox[{"baseRemovableList", "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", 
                    RowBox[{"baseSheetNumbers", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ","}]}], "*)"}], 
                "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"type", "=", "\"\<E\>\""}], ";"}], 
                "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{"minE", "<", "0"}], ",", "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"theN", "=", 
                    RowBox[{"Numerator", "[", "minE", "]"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"(*", 
                    RowBox[{
                    RowBox[{"type", "=", 
                    SubscriptBox["\"\<L\>\"", 
                    RowBox[{"ToString", "[", "theN", "]"}]]}], ";"}], "*)"}], 
                    "\[IndentingNewLine]", 
                    RowBox[{"type", "=", 
                    RowBox[{"theLType", "[", 
                    RowBox[{"\"\<L\>\"", ",", "theN"}], "]"}]}], ";"}], 
                   "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"type", "=", "\"\<T\>\""}], ";"}]}], 
                  "\[IndentingNewLine]", "]"}], ";"}]}], 
               "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
             ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"theD", "=", 
               RowBox[{"Denominator", "[", "minE", "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"theN", "=", 
               RowBox[{"Numerator", "[", "minE", "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"minE", ">", "0"}], ",", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{"minE", ">", "1"}], ",", "\[IndentingNewLine]", 
                   RowBox[{"(*", 
                    RowBox[{
                    RowBox[{"type", "=", 
                    SubsuperscriptBox["F", 
                    RowBox[{"ToString", "[", "theD", "]"}], 
                    RowBox[{"ToString", "[", "theN", "]"}]]}], ";"}], "*)"}], 
                   "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"type", "=", 
                    RowBox[{"multiBranchType", "[", 
                    RowBox[{"\"\<F\>\"", ",", 
                    RowBox[{"cycleTypes", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], ",", "theN"}], "]"}]}], 
                    ";"}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
                   RowBox[{"(*", 
                    RowBox[{
                    RowBox[{"type", "=", 
                    SubsuperscriptBox["V", 
                    RowBox[{"ToString", "[", "theD", "]"}], 
                    RowBox[{"ToString", "[", "theN", "]"}]]}], ";"}], "*)"}], 
                   "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"type", "=", 
                    RowBox[{"multiBranchType", "[", 
                    RowBox[{"\"\<V\>\"", ",", 
                    RowBox[{"cycleTypes", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], ",", "theN"}], "]"}]}], 
                    ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], 
                "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
                RowBox[{"(*", 
                 RowBox[{
                  RowBox[{"type", "=", 
                   SubsuperscriptBox["P", 
                    RowBox[{"ToString", "[", "theD", "]"}], 
                    RowBox[{"ToString", "[", "theN", "]"}]]}], ";"}], "*)"}], 
                "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"type", "=", 
                  RowBox[{"multiBranchType", "[", 
                   RowBox[{"\"\<P\>\"", ",", 
                    RowBox[{"cycleTypes", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], ",", "theN"}], "]"}]}], 
                 ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]}], 
            "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
           "type"}], ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{"Length", "@", "baseSheetNumbers"}]}], "}"}]}], 
         "\[IndentingNewLine]", "]"}]}], ";", " ", 
       RowBox[{"(*", " ", 
        RowBox[{
        "theTally", ",", "mVals", ",", "j", ",", "typeLoc", ",", "i", ",", 
         "typeTable"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"theTally", "=", 
        RowBox[{"Tally", "[", "typeTable", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"mVals", "=", 
        RowBox[{"Select", "[", 
         RowBox[{"theTally", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ">", "1"}], "&"}]}], "]"}]}], 
       ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"j", "=", "1"}], ",", 
