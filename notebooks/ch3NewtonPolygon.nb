Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"plotBranchSeries", "[", 
     RowBox[{
     "baseSingularPoint_", ",", "theBranchSeries_", ",", "sheetLinks_", ",", 
      "estR_", ",", "colors_", ",", "type_"}], "]"}], ":=", 
    "\[IndentingNewLine]", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "genF", ",", "theExp", ",", "theNum", ",", "cList", ",", "f", ",", 
        "thePlots", ",", "cycleSize", ",", "domain"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"cycleSize", "=", 
        RowBox[{"Length", "@", "sheetLinks"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"genF", "[", "u_", "]"}], "=", 
        RowBox[{"theBranchSeries", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"sheetLinks", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", 
           RowBox[{"1", ";;", "50"}]}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"theExp", "=", 
