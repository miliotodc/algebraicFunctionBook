            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{"Style", "[", 
               RowBox[{
               "\"\<getIntegrationData::Did not find next point \
location!\>\"", ",", "Red"}], "]"}], "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"Print", "[", 
              RowBox[{"\"\<     myNextPoints: \>\"", ",", 
               RowBox[{"N", "[", 
                RowBox[{"myNextPoints", ",", "45"}], "]"}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"Print", "[", 
              RowBox[{"\"\<     minVal:       \>\"", ",", 
               RowBox[{"N", "[", 
                RowBox[{"minVal", ",", "45"}], "]"}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"Abort", "[", "]"}], ";"}]}], "\[IndentingNewLine]", 
           "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"nextNDZ", "=", 
           RowBox[{"nextSol", "[", 
            RowBox[{"[", 
             RowBox[{"nextLocArray", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", "1"}], "]"}], "]"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"otherIndex", "=", "1"}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"Print", "[", 
             RowBox[{
              RowBox[{"Style", "[", 
               RowBox[{"\"\<nextLoc: \>\"", ",", "Red"}], "]"}], ",", 
              "nextLoc"}], "]"}], ";"}], "*)"}], "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"nextLocArray", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", "1"}], "]"}], "]"}], "==", "1"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"otherIndex", "=", "2"}], ";"}]}], "\[IndentingNewLine]",
            "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"nextNDZ2", "=", 
           RowBox[{"nextSol", "[", 
            RowBox[{"[", "otherIndex", "]"}], "]"}]}], ";"}]}], 
        "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{
           RowBox[{"Style", "[", 
            RowBox[{
            "\"\<     next sol in get integration data: \>\"", ",", "Red"}], 
            "]"}], ",", 
           RowBox[{"N", "[", 
            RowBox[{"nextSol", ",", "15"}], "]"}]}], "]"}], ";"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"baseNDZ", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "+", 
          RowBox[{
           RowBox[{"baseNDZ", "[", 
            RowBox[{"[", "2", "]"}], "]"}], " ", "I"}]}], ",", 
         RowBox[{
          RowBox[{"nextNDZ", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "+", 
          RowBox[{
           RowBox[{"nextNDZ", "[", 
