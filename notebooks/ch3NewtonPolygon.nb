             RowBox[{
              RowBox[{"(", 
               RowBox[{"x", "-", 
                RowBox[{"baseSingularPoint", "[", 
                 RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "^", "2"}], "+", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"y", "-", 
                RowBox[{"baseSingularPoint", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "^", "2"}]}], "==", 
            RowBox[{"baseRadius", "^", "2"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"nextEqn", "=", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"x", "-", 
                RowBox[{"nextSingularPoint", "[", 
                 RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "^", "2"}], "+", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"y", "-", 
                RowBox[{"nextSingularPoint", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "^", "2"}]}], "==", 
            RowBox[{"nextRadius", "^", "2"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", "\[IndentingNewLine]", " ", 
           RowBox[{
           "get", " ", "equation", " ", "of", " ", "line", " ", "between", 
            " ", "singular", " ", "points"}], "\[IndentingNewLine]", "*)"}], 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"p1", "=", "baseSingularPoint"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"p2", "=", "nextSingularPoint"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"eqn3", "=", 
           RowBox[{"Expand", "[", 
            RowBox[{"y", "==", 
             RowBox[{
              RowBox[{
               FractionBox[
                RowBox[{
                 RowBox[{"p2", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], "-", 
                 RowBox[{"p1", "[", 
                  RowBox[{"[", "2", "]"}], "]"}]}], 
                RowBox[{
                 RowBox[{"p2", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], "-", 
                 RowBox[{"p1", "[", 
                  RowBox[{"[", "1", "]"}], "]"}]}]], 
               RowBox[{"(", 
                RowBox[{"x", "-", 
                 RowBox[{"p1", "[", 
                  RowBox[{"[", "1", "]"}], "]"}]}], ")"}]}], "+", 
              RowBox[{"p1", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"theSolvePrec", "=", 
           RowBox[{"Floor", "@", 
            RowBox[{"Precision", "@", 
             RowBox[{"Min", "@", 
              RowBox[{"{", 
               RowBox[{"baseEqn", ",", "nextEqn", ",", "eqn3"}], 
               "}"}]}]}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"theSolvePrec", "<", "$minNSolvePrecision"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{"Style", "[", 
               RowBox[{
               "\"\<getIntegrationData::solve \
precision<$minSolvePrecision\>\"", ",", "Red", ",", "14", ",", "Bold"}], 
               "]"}], "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"Abort", "[", "]"}], ";"}]}], "\[IndentingNewLine]", 
           "]"}], ";", "\[IndentingNewLine]", "\n", "          ", 
          RowBox[{"baseSol", "=", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"x", ",", "y"}], "}"}], "/.", 
            RowBox[{"NSolve", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"baseEqn", ",", "eqn3"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"x", ",", "y"}], "}"}], ",", 
              RowBox[{"WorkingPrecision", "->", "theSolvePrec"}]}], "]"}]}]}],
           ";", "\[IndentingNewLine]", 
          RowBox[{"nextSol", "=", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"x", ",", "y"}], "}"}], "/.", 
            RowBox[{"NSolve", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"nextEqn", ",", "eqn3"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"x", ",", "y"}], "}"}], ",", 
              RowBox[{"WorkingPrecision", "->", "theSolvePrec"}]}], "]"}]}]}],
           ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"myBasePoints", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"EuclideanDistance", "[", 
              RowBox[{"p2", ",", "#"}], "]"}], "&"}], "/@", "baseSol"}]}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"minVal", "=", 
           RowBox[{"Min", "@", "myBasePoints"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"difArray", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"minVal", "-", "#"}], "]"}], "&"}], "/@", " ", 
            "myBasePoints"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"baseLocArray", "=", 
             RowBox[{"Position", "[", 
              RowBox[{"myBasePoints", ",", 
               RowBox[{"x_", "/;", 
                RowBox[{
                 RowBox[{"Abs", "[", 
                  RowBox[{"x", "-", "minVal"}], "]"}], "<", 
                 RowBox[{"10", "^", 
                  RowBox[{"-", 
                   RowBox[{"(", 
                    RowBox[{
                    "theSolvePrec", "-", "$accuracyComparisonFactor"}], 
                    ")"}]}]}]}]}]}], "]"}]}], ";"}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"baseLocArray", "=", 
           RowBox[{"Position", "[", 
            RowBox[{"difArray", ",", 
             RowBox[{"Min", "[", "difArray", "]"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "@", "baseLocArray"}], "!=", "1"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{"Style", "[", 
               RowBox[{
               "\"\<getIntegrationData::Did not find base point \
location!\>\"", ",", "Red"}], "]"}], "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"Print", "[", 
              RowBox[{"\"\<     myBasePoints: \>\"", ",", 
               RowBox[{"N", "[", 
                RowBox[{"myBasePoints", ",", "15"}], "]"}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"Print", "[", 
              RowBox[{"\"\<     minVal:       \>\"", ",", 
               RowBox[{"N", "[", 
                RowBox[{"minVal", ",", "15"}], "]"}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"Abort", "[", "]"}], ";"}]}], "\[IndentingNewLine]", 
           "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"baseNDZ", "=", 
           RowBox[{"baseSol", "[", 
            RowBox[{"[", 
             RowBox[{"baseLocArray", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", "1"}], "]"}], "]"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"myNextPoints", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"EuclideanDistance", "[", 
              RowBox[{"p1", ",", "#"}], "]"}], "&"}], "/@", "nextSol"}]}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"minVal", "=", 
           RowBox[{"Min", "@", "myNextPoints"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"nextLocArray", "=", 
             RowBox[{"Position", "[", 
              RowBox[{"myNextPoints", ",", 
               RowBox[{"x_", "/;", 
                RowBox[{
