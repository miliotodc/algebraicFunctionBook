Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{
    "start", " ", "of", " ", "a", " ", "routine", " ", "to", " ", "remove", 
     " ", "zero", " ", "residues", " ", "from", " ", "c"}], "-", 
    "substitutions"}], "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"removeCResidues", "[", 
      RowBox[{"theF_", ",", "theC_", ",", "residueFactor_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "functionCoeffRules", ",", "functionCoeffLen", ",", "zeroTable", ",", 
         "wKey", ",", "keyValue", ",", " ", "zTerms", ",", "cKeys", ",", 
         "cTable", ",", "theKey", ",", "reformedFCoeffs", ",", "cPos", ",", 
         "reformedF", ",", "cAcc"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"\"\<precision of theF entering removeCResidues: \>\"", ",", 
           RowBox[{"Precision", "@", "theF"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{"\"\<precision of theC: \>\"", ",", 
           RowBox[{"Precision", "@", "theC"}]}], "]"}], ";"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"If", "[", " ", 
         RowBox[{"$printCResidueKeyFlag", ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"\"\<z->z+c Chop factor: \>\"", ",", 
             RowBox[{"N", "[", 
              RowBox[{
               RowBox[{"10", "^", 
                RowBox[{"-", "residueFactor"}]}], ",", "8"}], "]"}]}], "]"}], 
           ";", "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<theC accuracy: \>\"", ",", 
             RowBox[{"Floor", "@", 
              RowBox[{"Accuracy", "@", "theC"}]}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<theF: \>\"", ",", 
             RowBox[{"theF", "//", "N"}]}], "]"}], ";"}]}], 
         "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"functionCoeffRules", "=", 
         RowBox[{"CoefficientRules", "[", 
          RowBox[{"theF", ",", "w", ",", "\"\<NegativeLexicographic\>\""}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"functionCoeffLen", "=", 
         RowBox[{"Length", "@", "functionCoeffRules"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"cAcc", "=", 
         RowBox[{"Floor", "@", 
          RowBox[{"Accuracy", "@", 
           RowBox[{"Expand", "@", "theC"}]}]}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"zeroTable", "=", 
         RowBox[{"Table", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"wKey", "=", 
             RowBox[{"functionCoeffRules", "[", 
              RowBox[{"[", 
               RowBox[{"wKeyIndex", ",", "1"}], "]"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"keyValue", "=", 
             RowBox[{"functionCoeffRules", "[", 
              RowBox[{"[", 
               RowBox[{"wKeyIndex", ",", "2"}], "]"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"zTerms", "=", 
             RowBox[{"getCoefficientRules", "[", "keyValue", "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{"zTerms", "=", 
               RowBox[{"CoefficientRules", "[", 
                RowBox[{
                "keyValue", ",", "z", ",", "\"\<NegativeLexicographic\>\""}], 
                " ", "]"}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
            RowBox[{"cKeys", "=", 
             RowBox[{"Keys", "[", "zTerms", "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"cTable", "=", 
             RowBox[{"Table", "[", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{
                RowBox[{"theKey", "=", 
                 RowBox[{"Normal", "@", 
                  RowBox[{"KeyTake", "[", 
                   RowBox[{"zTerms", ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"cKeys", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], ",", "c"}], "}"}]}], 
                   "]"}]}]}], ";", "\[IndentingNewLine]", 
                RowBox[{"(*", 
                 RowBox[{
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"MemberQ", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"1", ",", "2"}], "}"}], ",", "wKeyIndex"}], "]"}],
                     " ", "&&", " ", 
                    RowBox[{"i", "==", "1"}], " ", "&&", " ", 
                    "$printCResidueKeyFlag"}], ",", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"Print", "[", 
                    RowBox[{
                    "\"\<val of key (\>\"", ",", "wKeyIndex", ",", 
                    "\"\<,\>\"", ",", "i", ",", "\"\<): \>\"", ",", 
                    RowBox[{"N", "[", 
                    RowBox[{
                    RowBox[{"theKey", "/.", 
                    RowBox[{"c", "->", "theC"}]}], ",", "10"}], "]"}]}], 
                    "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], 
                 "*)"}], "\[IndentingNewLine]", 
                RowBox[{"theKey", "[", 
                 RowBox[{"[", 
                  RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"{", 
                RowBox[{"i", ",", "1", ",", 
                 RowBox[{"Length", "@", "cKeys"}]}], "}"}]}], 
              "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"Print", "[", "\"\<in removeCResidues: \>\"", "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"Print", "[", 
             RowBox[{"\"\<  cTable before chop: \>\"", ",", 
              RowBox[{"cTable", "//", "N"}]}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"Print", "[", 
             RowBox[{"\"\<  cTable after chop: \>\"", ",", 
              RowBox[{
               RowBox[{"Chop", "[", 
                RowBox[{
                 RowBox[{"cTable", "/.", 
                  RowBox[{"c", "->", "theC"}]}], ",", 
                 RowBox[{"10", "^", 
                  RowBox[{"-", 
                   RowBox[{"(", 
                    RowBox[{"cAcc", "-", "10"}], ")"}]}]}]}], "]"}], "//", 
               "N"}]}], "]"}], ";", "\[IndentingNewLine]", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"wKey", ",", "zTerms", ",", 
                RowBox[{"Chop", "[", 
                 RowBox[{
                  RowBox[{"cTable", "/.", 
                   RowBox[{"c", "->", "theC"}]}], ",", 
                  RowBox[{"10", "^", 
                   RowBox[{"-", 
                    RowBox[{"(", "residueFactor", ")"}]}]}]}], "]"}]}], "}"}],
               ","}], "*)"}], "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{"wKey", ",", "zTerms", ",", 
              RowBox[{"Chop", "[", 
               RowBox[{
                RowBox[{"cTable", "/.", 
                 RowBox[{"c", "->", "theC"}]}], ",", 
                RowBox[{"10", "^", 
                 RowBox[{"-", 
                  RowBox[{"(", 
                   RowBox[{"cAcc", "-", "10"}], ")"}]}]}]}], "]"}]}], "}"}]}],
            ",", "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"wKeyIndex", ",", "1", ",", "functionCoeffLen"}], "}"}]}],
           "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", "\[IndentingNewLine]", " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"reformedFCoeffs", "=", 
         RowBox[{"Table", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"cPos", "=", 
             RowBox[{"Flatten", "@", 
              RowBox[{"Position", "[", 
               RowBox[{
                RowBox[{"zeroTable", "[", 
                 RowBox[{"[", 
                  RowBox[{"index", ",", "3"}], "]"}], "]"}], ",", 
                RowBox[{"x_", "/;", 
                 RowBox[{"x", "!=", "0"}]}]}], "]"}]}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"FromCoefficientRules", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"zeroTable", "[", 
                  RowBox[{"[", 
                   RowBox[{"index", ",", "2", ",", "cPos"}], "]"}], "]"}], "/.", 
                 RowBox[{"c", "->", "theC"}]}], ",", "z"}], "]"}], ")"}], " ", 
             RowBox[{"w", "^", 
              RowBox[{"zeroTable", "[", 
               RowBox[{"[", 
                RowBox[{"index", ",", "1"}], "]"}], "]"}]}]}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"index", ",", "1", ",", 
             RowBox[{"Length", "@", "zeroTable"}]}], "}"}]}], 
          "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"reformedF", "=", 
         RowBox[{
          RowBox[{"Expand", "[", 
           RowBox[{"Plus", "@@", "reformedFCoeffs"}], "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"\"\<Precision of reformedF: \>\"", ",", 
            RowBox[{"Precision", "@", "reformedF"}]}], "]"}], ";"}], "*)"}], 
        "\[IndentingNewLine]", "reformedF"}]}], "\[IndentingNewLine]", 
      "]"}]}], ";"}], "\[IndentingNewLine]"}]}]], "Input",
