      RowBox[{"6", 
       RowBox[{"w", "^", "14"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"2", "+", 
         RowBox[{"z", "^", "2"}]}], ")"}], 
       RowBox[{"w", "^", "15"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cList", "=", 
     RowBox[{"CoefficientList", "[", 
      RowBox[{"$theFunction", ",", "w"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"maxZ", "=", 
     RowBox[{"Max", "@", 
      RowBox[{"Flatten", "@", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"Exponent", "[", 
           RowBox[{"#", ",", "z", ",", "List"}], "]"}], "&"}], "/@", " ", 
         "cList"}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"newFunction", "=", 
     RowBox[{"Expand", "[", 
      RowBox[{
       RowBox[{"z", "^", "maxZ"}], 
       RowBox[{"(", 
        RowBox[{"$theFunction", "/.", 
         RowBox[{"z", "->", 
          RowBox[{"1", "/", "z"}]}]}], ")"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"$theTestCase", "=", "\"\<testCase0005Inf\>\""}], ";"}], 
