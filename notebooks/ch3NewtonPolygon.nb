Cell[BoxData[{
 RowBox[{
  RowBox[{"tallyIndex", "=", "2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"$multiRootArray", "=", 
   RowBox[{"MapThread", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"#1", ",", "#2"}], "}"}], "&"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"$multipleRootCheck", "[", 
        RowBox[{"[", 
         RowBox[{"tallyIndex", ",", "1"}], "]"}], "]"}], ",", 
       RowBox[{"$multipleRootCheck", "[", 
        RowBox[{"[", 
         RowBox[{"tallyIndex", ",", "2"}], "]"}], "]"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"theTally", "=", "$multiRootArray"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"newRootArray", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{"tally", "=", "1"}], ",", 
    RowBox[{"tally", "<=", 
     RowBox[{"Length", "@", "theTally"}]}], ",", 
    RowBox[{"tally", "++"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"currentTallyData", "=", 
      RowBox[{"theTally", "[", 
       RowBox[{"[", "tally", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<currentTallyData: \>\"", ",", 
       RowBox[{"currentTallyData", "//", "N"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"root", "=", "1"}], ",", 
       RowBox[{"root", "<=", 
        RowBox[{"Length", "@", 
         RowBox[{"currentTallyData", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}]}], ",", 
       RowBox[{"root", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"currentTally", "=", 
         RowBox[{"currentTallyData", "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", "root"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<currentTally: \>\"", ",", 
          RowBox[{"currentTally", "//", "N"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"multiplicity", "=", 
         RowBox[{"currentTally", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"currentTally", "[", 
            RowBox[{"[", "2", "]"}], "]"}], ">", "1"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{
             RowBox[{"Style", "[", 
              RowBox[{"\"\<Detected multiple roots: \>\"", ",", "Red"}], 
              "]"}], ",", 
             RowBox[{"currentTally", "//", "N"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<     tally eqn: \>\"", ",", 
             RowBox[{
              RowBox[{"currentTallyData", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "//", "N"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<     tally eqn prec: \>\"", ",", 
             RowBox[{"Precision", "@", 
              RowBox[{"currentTallyData", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<     tally root: \>\"", ",", 
             RowBox[{
              RowBox[{"currentTally", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "//", "N"}]}], "]"}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{
               RowBox[{"Style", "[", 
                RowBox[{"\"\<     root location: \>\"", ",", "Blue"}], "]"}], 
               ",", 
               RowBox[{
                RowBox[{"theTally", "[", 
                 RowBox[{"[", 
                  RowBox[{
                  "tallyIndex", ",", "tally", ",", "2", ",", "root", ",", 
                   "1"}], "]"}], "]"}], "//", "N"}]}], "]"}], ";"}], "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<     tally root prec: \>\"", ",", 
             RowBox[{"Precision", "@", 
              RowBox[{"currentTally", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}]}], "]"}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<multiplicity: \>\"", ",", "multiplicity"}], "]"}], 
           ";", "\[IndentingNewLine]", 
           RowBox[{
           "Print", "[", "\"\<     Running derivative root eqn: \>\"", "]"}], 
           ";", "\[IndentingNewLine]", 
           RowBox[{"newX", "=", 
            RowBox[{"x", "/.", 
             RowBox[{"Solve", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"D", "[", 
                 RowBox[{
                  RowBox[{"currentTallyData", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"x", ",", 
                    RowBox[{"multiplicity", "-", "1"}]}], "}"}]}], "]"}], "==",
                 "0"}], ",", "x"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"(*", "\[IndentingNewLine]", 
            RowBox[{
            "find", " ", "tally", " ", "root", " ", "in", " ", "newX"}], 
            "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
           RowBox[{"tallyRootAcc", "=", 
            RowBox[{"Floor", "@", 
             RowBox[{"Accuracy", "@", 
              RowBox[{"currentTally", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<tallyRootAcc: \>\"", ",", "tallyRootAcc"}], "]"}], 
           ";", "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<root dif: \>\"", ",", 
             RowBox[{"N", "[", 
              RowBox[{
               RowBox[{"Abs", "[", 
                RowBox[{"newX", "-", 
                 RowBox[{"currentTally", "[", 
                  RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ",", "20"}], 
              "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"rootPos", "=", 
