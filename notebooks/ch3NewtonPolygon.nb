        "\[IndentingNewLine]", 
        RowBox[{"wRules", "=", 
         RowBox[{"CoefficientRules", "[", 
          RowBox[{"theF", ",", "w", ",", "\"\<NegativeLexicographic\>\""}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"zRules", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"CoefficientRules", "[", 
            RowBox[{"#", ",", "z", ",", "\"\<NegativeLexicographic\>\""}], 
            "]"}], "&"}], "/@", " ", 
          RowBox[{"wRules", "[", 
           RowBox[{"[", 
