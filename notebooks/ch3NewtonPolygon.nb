                RowBox[{
                 RowBox[{"Length", "@", "y"}], "!=", "0"}]}]}], "]"}]}]}], 
           ";", "\[IndentingNewLine]", 
           RowBox[{"(*", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"remove", " ", "from", " ", "oneCyclePos"}], ",", " ", 
