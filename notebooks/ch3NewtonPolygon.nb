Cell["getSegmentPlot2", "Subsection",
 CellChangeTimes->{{3.931439346765077*^9, 
  3.9314393505143785`*^9}},ExpressionUUID->"e49a3d34-7e8a-44a9-bfed-\
476392154669"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"getSegmentPlot2", "[", 
      RowBox[{"theF_", ",", "fLambda_", ",", "fMu_", ",", 
       RowBox[{"plotType_", ":", "1"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "wRules", ",", "zRules", ",", "polygonPoints", ",", "maxX", ",", 
         "maxY", ",", "hullIndexes", ",", "hullPoints", ",", "hullMin", ",", 
         "minPos", ",", " ", "lowLegFound", ",", "index", ",", "lowLegPoints",
          ",", "currentX", ",", "nextX", ",", "currentY", ",", "slope", ",", 
         "yIntercept", ",", "polygonPointsG", ",", "convexHullG", ",", 
         "hullPointsG", ",", "rotatedPoints", ",", "legArray", ",", 
         "currentLeg", ",", "legIndex", ",", "totalPts", ",", "colorArray", 
         ",", "finalLegIndexes", ",", "finalLegPoints", ",", "legIndexes", 
         ",", " ", "finalLegPointsG", ",", "lineG", " ", ",", " ", 
         "dashPlots", ",", "pData", ",", "pPoint", ",", "pSlope", ",", "theY",
          ",", "xStop", " ", ",", "subReturn", ",", "linePoints", ",", 
         "slopeLegendData", ",", "slopeColorData", ",", "thePlotLegend", ",", 
         "legendPlot", ",", "tableData", ",", "wCoef", ",", "fLambdaG", ",", 
         "fMuG", ",", "plotGraph"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"(*", "\[IndentingNewLine]", " ", 
        RowBox[{
        "requires", " ", "function", " ", "to", " ", "be", " ", 
         "normalized"}], "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]",
        "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"wCoef", "=", 
         RowBox[{
          RowBox[{"CoefficientRules", "[", 
           RowBox[{"theF", ",", "w", ",", "\"\<NegativeLexicographic\>\""}], 
           "]"}], "//", "N"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"tableData", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", 
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "}"}], "&"}], "/@", " ", 
          "wCoef"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", "\[IndentingNewLine]", " ", 
         RowBox[{
         "get", " ", "Newton", " ", "polygon", " ", "and", " ", "lower", " ", 
          "Newton", " ", "legs"}], "\[IndentingNewLine]", "*)"}], " ", 
        "\[IndentingNewLine]", 
        RowBox[{"wRules", "=", 
         RowBox[{"CoefficientRules", "[", 
          RowBox[{"theF", ",", "w", ",", "\"\<NegativeLexicographic\>\""}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"zRules", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"CoefficientRules", "[", 
            RowBox[{"#", ",", "z", ",", "\"\<NegativeLexicographic\>\""}], 
            "]"}], "&"}], "/@", " ", 
          RowBox[{"wRules", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "2"}], "]"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
          "for", " ", "each", " ", "coefficient", " ", "of", " ", "z"}], ",", 
          " ", 
          RowBox[{"save", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"power", " ", "of", " ", "w"}], ",", " ", 
             RowBox[{"power", " ", "of", " ", "z"}], ",", " ", 
             RowBox[{"coefficient", " ", "of", " ", "z"}]}], " ", "}"}], " ", 
           "in", " ", "polygonPoints"}]}], "\[IndentingNewLine]", "*)"}], " ",
         "\[IndentingNewLine]", 
        RowBox[{"polygonPoints", "=", 
         RowBox[{"MapThread", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"#1", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", "1"}], "]"}], "]"}], ",", 
              RowBox[{"#2", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", "1", ",", "1"}], "]"}], "]"}], ",", 
              RowBox[{"#2", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", "2"}], "]"}], "]"}]}], "}"}], "&"}], ",", 
           RowBox[{"{", 
            RowBox[{"wRules", ",", "zRules"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{"$getSegmentDataFlag", ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{
               RowBox[{"Style", "[", 
                RowBox[{
                "\"\<polygonPoints after MapThread: \>\"", ",", "Red"}], 
                "]"}], ",", 
               RowBox[{"polygonPoints", "//", "N"}]}], "]"}], ";"}]}], 
           "\[IndentingNewLine]", "]"}], ";"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"maxX", "=", 
         RowBox[{"Max", "@", 
          RowBox[{"polygonPoints", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "1"}], "]"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"maxY", "=", 
         RowBox[{"Max", "@", 
          RowBox[{"polygonPoints", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "2"}], "]"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"hullIndexes", "=", 
         RowBox[{"ConvexHull", "[", 
          RowBox[{"polygonPoints", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", 
             RowBox[{"{", 
              RowBox[{"1", ",", "2"}], "}"}]}], "]"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"hullPoints", "=", 
         RowBox[{"polygonPoints", "[", 
          RowBox[{"[", "hullIndexes", "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"polygonPointsG", "=", 
         RowBox[{"Graphics", "@", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"PointSize", "[", "0.01", "]"}], ",", "Black", ",", 
            RowBox[{"Point", "@", 
             RowBox[{"polygonPoints", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", 
                RowBox[{"{", 
                 RowBox[{"1", ",", "2"}], "}"}]}], "]"}], "]"}]}]}], 
           "}"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"convexHullG", "=", 
         RowBox[{"Graphics", "@", 
          RowBox[{"{", 
           RowBox[{"Line", "@", 
            RowBox[{"Append", "[", 
             RowBox[{
              RowBox[{"polygonPoints", "[", 
               RowBox[{"[", 
                RowBox[{"hullIndexes", ",", 
                 RowBox[{"{", 
                  RowBox[{"1", ",", "2"}], "}"}]}], "]"}], "]"}], ",", 
              RowBox[{"polygonPoints", "[", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{"hullIndexes", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"1", ",", "2"}], "}"}]}], "]"}], "]"}]}], "]"}]}], 
           "}"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"hullPointsG", "=", 
         RowBox[{"Graphics", "@", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"PointSize", "[", "0.02", "]"}], ",", "Black", ",", 
            RowBox[{"Point", "@", 
             RowBox[{"hullPoints", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", 
                RowBox[{"{", 
                 RowBox[{"1", ",", "2"}], "}"}]}], "]"}], "]"}]}]}], 
           "}"}]}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"hullMin", "=", 
         RowBox[{"Min", "@", 
          RowBox[{"hullPoints", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "1"}], "]"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"minPos", "=", 
         RowBox[{
          RowBox[{"Position", "[", 
           RowBox[{"hullPoints", ",", 
            RowBox[{"{", 
             RowBox[{"hullMin", ",", "_", ",", "_"}], "}"}]}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"rotatedPoints", "=", 
         RowBox[{"RotateLeft", "[", 
          RowBox[{"hullPoints", ",", 
           RowBox[{"minPos", "-", "1"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"lowLegFound", "=", "False"}], ";", "\[IndentingNewLine]", 
        RowBox[{"index", "=", "0"}], ";", "\[IndentingNewLine]", 
        RowBox[{"lowLegPoints", "=", 
         RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"While", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"!", "lowLegFound"}], " ", "&&", " ", 
           RowBox[{"index", "<", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"Length", "@", "rotatedPoints"}], ")"}], "-", "1"}]}]}],
           ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"index", "++"}], ";", "\[IndentingNewLine]", 
           RowBox[{"currentX", "=", 
            RowBox[{"rotatedPoints", "[", 
             RowBox[{"[", 
              RowBox[{"index", ",", "1"}], "]"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"nextX", "=", 
            RowBox[{"rotatedPoints", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"index", "+", "1"}], ",", "1"}], "]"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"currentY", "=", 
            RowBox[{"rotatedPoints", "[", 
             RowBox[{"[", 
              RowBox[{"index", ",", "2"}], "]"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"slope", "=", 
            FractionBox[
             RowBox[{
              RowBox[{"rotatedPoints", "[", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{"index", "+", "1"}], ",", "2"}], "]"}], "]"}], "-", 
              RowBox[{"rotatedPoints", "[", 
               RowBox[{"[", 
                RowBox[{"index", ",", "2"}], "]"}], "]"}]}], 
             RowBox[{
              RowBox[{"rotatedPoints", "[", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{"index", "+", "1"}], ",", "1"}], "]"}], "]"}], "-", 
              RowBox[{"rotatedPoints", "[", 
               RowBox[{"[", 
                RowBox[{"index", ",", "1"}], "]"}], "]"}]}]]}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"yIntercept", "=", 
            RowBox[{"currentY", "-", 
             RowBox[{"slope", " ", "currentX"}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"nextX", "<", "currentX"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"lowLegFound", "=", "True"}], ";"}], 
             "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"slope", "<", "0"}], ",", "\[IndentingNewLine]", 
                "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"AppendTo", "[", 
                  RowBox[{"lowLegPoints", ",", 
                   RowBox[{"{", 
                    RowBox[{"index", ",", 
                    RowBox[{"index", "+", "1"}], ",", 
                    RowBox[{"-", "slope"}], ",", "yIntercept"}], "}"}]}], 
                  "]"}], ";"}], "\[IndentingNewLine]", ",", 
                "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{"slope", "==", "0"}], ",", "\[IndentingNewLine]", 
                   RowBox[{"(*", 
                    RowBox[{
                    RowBox[{"If", "[", 
                    RowBox[{"$getSegmentDataFlag", ",", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"Print", "[", 
                    RowBox[{"Style", "[", 
                    RowBox[{
                    "\"\<Appending to lowLegPoints at k=1\>\"", ",", 
                    "Magenta", ",", "Bold"}], "]"}], "]"}], ";"}]}], 
                    "\[IndentingNewLine]", "]"}], ";"}], "*)"}], 
                   "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"AppendTo", "[", 
                    RowBox[{"lowLegPoints", ",", 
                    RowBox[{"{", 
                    RowBox[{"index", ",", 
                    RowBox[{"index", "+", "1"}], ",", 
                    RowBox[{"-", "slope"}], ",", "yIntercept"}], "}"}]}], 
                    "]"}], ";"}], "\[IndentingNewLine]", ",", 
                   "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"lowLegFound", "=", "True"}], ";"}]}], 
                  "\[IndentingNewLine]", "]"}], ";"}]}], 
               "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", 
            "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"maxY", "==", "0"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"maxY", "=", "10"}], ";"}]}], "\[IndentingNewLine]", "]"}],
         ";", "\[IndentingNewLine]", 
        RowBox[{"(*", "\[IndentingNewLine]", 
         RowBox[{
         "at", " ", "this", " ", "point", " ", "lowLegPoints", " ", "have", 
          " ", 
          RowBox[{"{", 
           RowBox[{"index1", ",", "index2", ",", 
            RowBox[{"neg", " ", "slope"}], ",", " ", 
            RowBox[{"y", "-", "intercept"}]}], "}"}], " ", "of", " ", "all", 
          " ", "points", " ", "on", " ", "lower", " ", "legs", " ", 
          "\[IndentingNewLine]", "with", " ", "index1", " ", "and", " ", 
          "index2", " ", "indexes", " ", "into", " ", "rotatedPoints"}], 
         "\[IndentingNewLine]", "*)"}], " ", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "@", "lowLegPoints"}], "==", "0"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"Style", "[", 
             RowBox[{
             "\"\<Did not find any lower Newton legs! Function is not \
normalized. Stopping.\>\"", ",", "Red", ",", "Bold", ",", "14"}], "]"}], 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"subReturn", "=", 
            RowBox[{"{", 
             RowBox[{
             "lowLegPoints", ",", "polygonPoints", ",", "rotatedPoints"}], 
             "}"}]}], ";"}], "\[IndentingNewLine]", ",", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", "\[IndentingNewLine]", " ", 
           RowBox[{
            RowBox[{
            "now", " ", "using", " ", "lower", " ", "leg", " ", "slopes"}], 
            ",", " ", 
            RowBox[{
