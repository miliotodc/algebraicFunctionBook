Cell[CellGroupData[{

Cell["Retrieve singular points  and reformed function tables", "Subsection",
 CellChangeTimes->{{3.8858013446464715`*^9, 3.8858013505825834`*^9}, {
  3.887386838265295*^9, 3.8873868419830008`*^9}, {3.9526900988825502`*^9, 
  3.9526901282897053`*^9}, {3.988175889924921*^9, 
  3.988175897225294*^9}},ExpressionUUID->"1cb0498e-2c24-4569-8a36-\
44962b7fb49f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
   "retrieve", " ", "singular", " ", "points", " ", "from", " ", "disc"}], 
   "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"FileExistsQ", "[", 
       RowBox[{"singularDataFileName", "[", "$theTestCase", "]"}], "]"}], ",",
       "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"theData", "=", 
        RowBox[{"Import", "[", 
         RowBox[{"singularDataFileName", "[", "$theTestCase", "]"}], "]"}]}], 
       ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "$theSingularList", ",", "$poleIndexes", ",", "$minRadiusArray", ",",
           "res", ",", "$zeroIndexes", ",", "$nearestDistanceArray", ",", 
          "$rNormArray"}], "}"}], "=", "theData"}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Total singular points: \>\"", ",", 
         RowBox[{"Length", "@", "$theSingularList"}]}], "]"}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Precision of singular points: \>\"", ",", 
         RowBox[{"Precision", "@", "$theSingularList"}]}], "]"}], ";", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Total poles: \>\"", ",", 
         RowBox[{"Length", "@", "$poleIndexes"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{
         RowBox[{
         "Style", "[", "\"\<\!\(\*SubscriptBox[\(s\), \(p\)]\) indexes: \>\"",
           "]"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{"$poleIndexes", ",", "Red"}], "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{
         RowBox[{
         "Style", "[", "\"\<\!\(\*SubscriptBox[\(s\), \(z\)]\) indexes: \>\"",
           "]"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{"$zeroIndexes", ",", "Blue"}], "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"cList", "=", 
        RowBox[{"CoefficientList", "[", 
         RowBox[{"$theFunction", ",", "w"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"maxZ", "=", 
        RowBox[{"Max", "@", 
         RowBox[{"Flatten", "@", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"Exponent", "[", 
              RowBox[{"#", ",", "z", ",", "List"}], "]"}], "&"}], "/@", " ", 
            "cList"}], ")"}]}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"$theSingularList", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "==", "0"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"\"\<Smallest sing power: \>\"", ",", 
            RowBox[{"N", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"$theSingularList", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "^", "maxZ"}], ",", "10"}], 
             "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"\"\<Smallest sing power: \>\"", ",", 
            RowBox[{"N", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"$theSingularList", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "^", "maxZ"}], ",", "10"}], 
             "]"}]}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", " ", 
       "\[IndentingNewLine]", 
       RowBox[{"minSingSeparation", "=", 
        RowBox[{
         RowBox[{"3", 
          RowBox[{"Min", "@", "$minRadiusArray"}]}], "//", "N"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"minSingAccFactor", "=", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{
           RowBox[{"MantissaExponent", "[", "minSingSeparation", "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], "+", "5"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<minSingAccFactor: \>\"", ",", "minSingAccFactor"}], 
        "]"}], ";"}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"singularDataFileName", "[", "$theTestCase", "]"}], "<>", 
          "\"\< not found during import\>\""}], "]"}], "]"}], ";"}]}], 
     "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{"get", " ", "reformed", " ", "functions"}], "\[IndentingNewLine]",
     "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"FileExistsQ", "[", 
       RowBox[{"reformedFunctionTableFileName", "[", "$theTestCase", "]"}], 
       "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"reformedFunctionTable", "=", 
        RowBox[{"Import", "[", 
         RowBox[{"reformedFunctionTableFileName", "[", "$theTestCase", "]"}], 
         "]"}]}], ";"}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
           "reformedFunctionTableFileName", "[", "$theTestCase", "]"}], "<>", 
           "\"\< not found during import.\>\""}], ",", "Red"}], "]"}], "]"}], 
       ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.884189907873234*^9, 3.884189924925452*^9}, {
