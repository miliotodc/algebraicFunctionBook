Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{"expansion", " ", "at", " ", "infinity"}], "\[IndentingNewLine]", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"$theFunction", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"z", "^", 
         RowBox[{"(", "30", ")"}]}], "+", 
        RowBox[{"z", "^", 
         RowBox[{"(", "32", ")"}]}]}], ")"}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"z", "^", "14"}], "+", 
         RowBox[{"z", "^", "20"}]}], ")"}], " ", 
       RowBox[{"w", "^", "5"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"z", "^", "5"}], "+", 
         RowBox[{"z", "^", "9"}]}], ")"}], " ", 
       RowBox[{"w", "^", "9"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"z", "+", 
         RowBox[{"z", "^", "3"}]}], ")"}], 
       RowBox[{"w", "^", "12"}]}], "+", 
      RowBox[{"6", 
       RowBox[{"w", "^", "14"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"2", "+", 
         RowBox[{"z", "^", "2"}]}], ")"}], 
       RowBox[{"w", "^", "15"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cList", "=", 
     RowBox[{"CoefficientList", "[", 
      RowBox[{"$theFunction", ",", "w"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"maxZ", "=", 
     RowBox[{"Max", "@", 
      RowBox[{"Flatten", "@", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"Exponent", "[", 
           RowBox[{"#", ",", "z", ",", "List"}], "]"}], "&"}], "/@", " ", 
         "cList"}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"newFunction", "=", 
     RowBox[{"Expand", "[", 
      RowBox[{
       RowBox[{"z", "^", "maxZ"}], 
       RowBox[{"(", 
        RowBox[{"$theFunction", "/.", 
         RowBox[{"z", "->", 
