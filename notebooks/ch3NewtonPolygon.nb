Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"zCoef", "=", "10"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"wCoef", "=", "15"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"a", "=", "5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"b", "=", "5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"randomZ", "[", "n_", "]"}], ":=", 
    RowBox[{"RandomInteger", "[", 
     RowBox[{"{", 
      RowBox[{"0", ",", "1"}], "}"}], "]"}]}], ";"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"randomW", "[", "n_", "]"}], ":=", " ", 
   RowBox[{"RandomInteger", "[", 
    RowBox[{"{", 
     RowBox[{"0", ",", "wCoef"}], "}"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"randomCoef", "[", "]"}], ":=", 
   RowBox[{
    RowBox[{"RandomInteger", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "a"}], ",", "a"}], "}"}], "]"}], "/", 
    RowBox[{"RandomInteger", "[", 
     RowBox[{"{", 
      RowBox[{"1", ",", "b"}], "}"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"wPowers", "=", 
  RowBox[{"DeleteDuplicates", "@", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"randomW", "[", "10", "]"}], ",", 
     RowBox[{"{", "20", "}"}]}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"poly", "=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"randomCoef", "[", "]"}], " ", 
      RowBox[{"z", "^", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"randomZ", "[", "1", "]"}], "+", " ", 
         RowBox[{"RandomInteger", "[", 
          RowBox[{"{", 
           RowBox[{"0", ",", 
            RowBox[{"zCoef", "-", "1"}]}], "}"}], "]"}]}], ")"}]}], " ", 
      RowBox[{"w", "^", 
       RowBox[{"wPowers", "[", 
        RowBox[{"[", "i", "]"}], "]"}]}]}], ")"}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", 
      RowBox[{"Length", "@", "wPowers"}]}], "}"}]}], 
   "]"}]}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.897484652984952*^9, 3.897484740867626*^9}, 
