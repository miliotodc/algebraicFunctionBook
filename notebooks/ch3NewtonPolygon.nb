          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"NearestTo", "[", 
              RowBox[{"#1", ",", "2"}], "]"}], "[", "wVals", "]"}], "&"}], "/@",
            " ", "wVals"}], ")"}], "[", 
