279385932f2f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"getTheOrder", "[", "p_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"clist", ",", "theorder", ",", "j"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"clist", "=", 
        RowBox[{"CoefficientList", "[", 
         RowBox[{"p", ",", "z"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"theorder", "=", "\[Infinity]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "clist", "]"}], "!=", "0"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"j", "=", "0"}], ";", "\[IndentingNewLine]", 
           RowBox[{"While", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"clist", "[", 
                RowBox[{"[", 
                 RowBox[{"j", "+", "1"}], "]"}], "]"}], "==", "0"}], " ", "&&",
               " ", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"j", "+", "1"}], ")"}], "\[LessEqual]", " ", 
               RowBox[{"Length", "[", "clist", "]"}]}]}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"{", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"j", "++"}], ";"}], "\[IndentingNewLine]", "}"}]}], 
            "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"theorder", "=", "j"}], ";"}], "\[IndentingNewLine]", 
          "}"}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"theorder", "=", "\[Infinity]"}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       "theorder"}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}]], "Input",
 InitializationCell->True,
 InitializationGroup->True,
