Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{
   RowBox[{
    RowBox[{"getRandomSingleCoeffPoly", "[", 
     RowBox[{
     "zExpMax_", ",", "zPolySize_", ",", "wExpMax_", ",", "sparseVal_"}], 
     "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "randomNum", ",", "getZPower", ",", "getWPower", ",", "getcoef", ",", 
        "foundFlag", ",", "index", ",", "functionDegree", ",", "$theFunction",
         ",", "wExp"}], "}"}], ",", "\[IndentingNewLine]", " ", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"randomNum", "[", "n_", "]"}], ":=", " ", 
        RowBox[{"RandomChoice", "[", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{"0", ",", 
             RowBox[{"{", "n", "}"}]}], "]"}], ",", 
           RowBox[{"{", "1", "}"}]}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", " ", 
       RowBox[{
        RowBox[{"getZPower", "[", "n_", "]"}], ":=", 
        RowBox[{
         RowBox[{"randomNum", "[", "sparseVal", "]"}], 
         RowBox[{"RandomInteger", "[", 
          RowBox[{"{", 
           RowBox[{"0", ",", "5"}], "}"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"getWPower", "[", "n_", "]"}], ":=", " ", 
        RowBox[{
         RowBox[{"randomNum", "[", "sparseVal", "]"}], 
         RowBox[{"RandomInteger", "[", 
          RowBox[{"{", 
           RowBox[{"0", ",", "n"}], "}"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"getcoef", "[", 
         RowBox[{"a_", ",", "b_"}], "]"}], ":=", 
        RowBox[{
         RowBox[{"RandomInteger", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "a"}], ",", "a"}], "}"}], "]"}], "/", 
         RowBox[{"RandomInteger", "[", 
          RowBox[{"{", 
           RowBox[{"1", ",", "b"}], "}"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"foundFlag", "=", "False"}], ";", "\[IndentingNewLine]", 
       RowBox[{"index", "=", "1"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"While", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"!", "foundFlag"}], " ", "&&", " ", 
          RowBox[{"index", "<", "25"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"$theFunction", "=", 
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"randomNum", "[", "sparseVal", "]"}], " ", 
              RowBox[{"getcoef", "[", 
               RowBox[{"8", ",", "5"}], "]"}], 
              RowBox[{"z", "^", 
               RowBox[{"getZPower", "[", "zExpMax", "]"}]}], " ", 
              RowBox[{"w", "^", 
               RowBox[{"getWPower", "[", "wExpMax", "]"}]}]}], ",", 
             RowBox[{"{", "wExpMax", "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"$theFunction", "=", 
             RowBox[{"Sum", "[", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"Sum", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"getcoef", "[", 
                    RowBox[{"8", ",", "5"}], "]"}], " ", 
                    RowBox[{"z", "^", 
                    RowBox[{"getZPower", "[", "zExpMax", "]"}]}]}], ",", 
                    RowBox[{"{", "zPolySize", "}"}]}], "]"}], ")"}], "  ", 
                 RowBox[{"w", "^", 
                  RowBox[{"getWPower", "[", "wExpMax", "]"}]}]}], ")"}], ",", 
               RowBox[{"{", "25", "}"}]}], "]"}]}], ";"}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"!", 
             RowBox[{"IrreduciblePolynomialQ", "[", "$theFunction", "]"}]}], 
            ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"index", "++"}], ";"}], "\[IndentingNewLine]", ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"foundFlag", "=", "True"}], ";"}]}], 
           "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", 
        "]"}], ";", "\[IndentingNewLine]", "$theFunction"}]}], 
     "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.8876298409550405`*^9, 3.8876298415484753`*^9}, {
  3.8877080980105114`*^9, 3.8877081118666625`*^9}, {3.8877083096684628`*^9, 
  3.887708312386538*^9}, {3.952165381314828*^9, 3.9521653813293347`*^9}},
 CellLabel->"In[71]:=",ExpressionUUID->"e1ac2038-f7f3-46c0-bf85-ee079139dc50"],

