          "\[IndentingNewLine]", 
          RowBox[{"iTab", "=", 
           RowBox[{"theEnd", "+", "1"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"cGroup", "[", 
