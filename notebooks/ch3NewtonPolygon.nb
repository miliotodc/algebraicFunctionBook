Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"checkRemovableSingularPointsNew", "[", 
      RowBox[{
      "$theFunction_", ",", "theSeries_", ",", "currentSing_", ",", 
       "conjList_", ",", "poleStatus_", ",", "diagFlag_", ",", "wp_"}], "]"}],
      ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "oneCyclePos", ",", "rArray", ",", "polePos", ",", "analyPos", ",", 
         "oneTable", ",", "zDeriv", ",", "numZero", ",", "removeFlag", ",", 
         "wDeriv", ",", "wZero", ",", "zDerivAcc", ",", "wDerivAcc"}], "}"}], 
       ",", "\[IndentingNewLine]", 
       RowBox[{"(*", "\[IndentingNewLine]", " ", 
        RowBox[{
        "check", " ", "if", " ", "this", " ", "singular", " ", "point", " ", 
         "is", " ", 
         RowBox[{"removable", ":", "  ", 
          RowBox[{
           RowBox[{
           "It", " ", "is", " ", "removable", " ", "if", " ", "series", " ", 
            "at", " ", "singular", " ", "point", " ", "has", " ", "no", " ", 
            "terms", " ", 
            RowBox[{"z", "^", 
             RowBox[{"(", 
              RowBox[{"n", "/", "k"}], ")"}]}], " ", "with", " ", "n"}], "<", 
           "k"}]}]}], "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"oneCyclePos", "=", 
         RowBox[{"Flatten", "@", 
          RowBox[{"Position", "[", 
           RowBox[{"conjList", ",", 
            RowBox[{"x_", "/;", 
             RowBox[{"x", "==", "1"}]}]}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"rArray", "=", 
         RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{"diagFlag", ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"\"\<oneCyclePos: \>\"", ",", "oneCyclePos"}], "]"}], 
           ";"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "@", "oneCyclePos"}], ">", "0"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"now", " ", "check", " ", "if", " ", "any", " ", "1"}], 
            "-", 
            RowBox[{"cycles", " ", "are", " ", "poles"}]}], 
           "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"polePos", "=", 
            RowBox[{"Flatten", "@", 
             RowBox[{"Position", "[", 
