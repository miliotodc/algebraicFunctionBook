      RowBox[{"z", "->", "0"}], ",", 
      RowBox[{"w", "->", "0"}]}], "}"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fVals", "=", 
     RowBox[{"Sort", "[", 
      RowBox[{"w", "/.", 
       RowBox[{"NSolve", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"$theFunction", "==", "0"}], "/.", 
          RowBox[{"z", "->", "0"}]}], ",", "w"}], "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dVals", "=", 
     RowBox[{"Sort", "[", 
      RowBox[{"w", "/.", 
       RowBox[{"NSolve", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{"$theFunction", ",", "w"}], "]"}], "==", "0"}], "/.", 
          RowBox[{"z", "->", "0"}]}], ",", "w"}], "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "@", 
        RowBox[{"Intersection", "[", 
         RowBox[{"fVals", ",", "dVals"}], "]"}]}], "!=", "0"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"Style", "[", 
         RowBox[{"\"\<Origin is a singular point!\>\"", ",", "Red"}], "]"}], 
        "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], 
