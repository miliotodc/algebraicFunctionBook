Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"tempTestCase", "=", "\"\<testCase0002\>\""}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"FileExistsQ", "[", 
     RowBox[{"seriesFileName", "[", 
      RowBox[{"tempTestCase", ",", "1"}], "]"}], "]"}], ",", 
    "\[IndentingNewLine]", " ", 
    RowBox[{
     RowBox[{"dataList", "=", 
      RowBox[{"Import", "[", 
       RowBox[{"seriesFileName", "[", 
        RowBox[{"tempTestCase", ",", "1"}], "]"}], "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "newSingularIndex", ",", "newSing", ",", "baseCycleMetric", ",", 
        "basePoleList", ",", "newConjList", ",", "baseRemovableList", ",", 
        "baseSeries", ",", "baseSheetLinks", ",", "baseSingSequence", ",", 
        "baseBranchTypeArray", ",", "baseSeriesMIVPTable"}], "}"}], "=", 
      "dataList"}], ";", "\[IndentingNewLine]", "\n", 
     RowBox[{"theConjugateSet", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"bTemp", "=", 
          RowBox[{
           RowBox[{"baseSeries", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", 
              RowBox[{"1", ";;", "10"}]}], "]"}], "]"}], "//", "N"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"expList", "=", 
          RowBox[{"Exponent", "[", 
           RowBox[{"bTemp", ",", "z", ",", "List"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"cList", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"Coefficient", "[", 
             RowBox[{"bTemp", ",", "z", ",", "#"}], "]"}], "&"}], "/@", 
           "expList"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"Plus", "@@", 
          RowBox[{"MapThread", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"#1", " ", 
               RowBox[{"Exp", "[", 
                RowBox[{"2", " ", "theK", " ", "Pi", " ", "I", " ", "#2"}], 
                "]"}], " ", 
               RowBox[{"z", "^", "#2"}]}], ")"}], "&"}], ",", 
            RowBox[{"{", 
             RowBox[{"cList", ",", "expList"}], "}"}]}], "]"}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"theK", ",", "0", ",", "4"}], "}"}]}], "]"}]}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<theConjugateSet: \>\"", ",", 
       RowBox[{
        RowBox[{"theConjugateSet", "//", "N"}], "//", "MatrixForm"}]}], "]"}],
      ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<baseSeries: \>\"", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"baseSeries", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"1", ";;", "5"}], ",", 
            RowBox[{"1", ";;", "10"}]}], "]"}], "]"}], "//", "N"}], "//", 
        "MatrixForm"}]}], "]"}], ";"}], "\[IndentingNewLine]", ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Print", "[", 
      RowBox[{"Style", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"seriesFileName", "[", 
          RowBox[{"tempTestCase", ",", "1"}], "]"}], "<>", 
         "\"\< not found during import\>\""}], ",", "Red"}], "]"}], "]"}], 
     ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]}], "Input",
 CellChangeTimes->{{3.981880798195154*^9, 3.9818808145531836`*^9}, {
