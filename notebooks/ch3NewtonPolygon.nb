             RowBox[{"coefficient", " ", "of", " ", "z"}]}], " ", "}"}], " ", 
           "in", " ", "polygonPoints"}]}], "\[IndentingNewLine]", "*)"}], " ",
         "\[IndentingNewLine]", 
        RowBox[{"polygonPoints", "=", 
         RowBox[{"MapThread", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"#1", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", "1"}], "]"}], "]"}], ",", 
              RowBox[{"#2", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", "1", ",", "1"}], "]"}], "]"}], ",", 
              RowBox[{"#2", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", "2"}], "]"}], "]"}]}], "}"}], "&"}], ",", 
           RowBox[{"{", 
            RowBox[{"wRules", ",", "zRules"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{"$getSegmentDataFlag", ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{
               RowBox[{"Style", "[", 
                RowBox[{
                "\"\<polygonPoints after MapThread: \>\"", ",", "Red"}], 
                "]"}], ",", 
               RowBox[{"polygonPoints", "//", "N"}]}], "]"}], ";"}]}], 
           "\[IndentingNewLine]", "]"}], ";"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"maxX", "=", 
         RowBox[{"Max", "@", 
          RowBox[{"polygonPoints", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "1"}], "]"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"maxY", "=", 
         RowBox[{"Max", "@", 
          RowBox[{"polygonPoints", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "2"}], "]"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"hullIndexes", "=", 
         RowBox[{"ConvexHull", "[", 
          RowBox[{"polygonPoints", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", 
             RowBox[{"{", 
              RowBox[{"1", ",", "2"}], "}"}]}], "]"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"hullPoints", "=", 
         RowBox[{"polygonPoints", "[", 
          RowBox[{"[", "hullIndexes", "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"polygonPointsG", "=", 
         RowBox[{"Graphics", "@", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"PointSize", "[", "0.01", "]"}], ",", "Black", ",", 
            RowBox[{"Point", "@", 
             RowBox[{"polygonPoints", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", 
                RowBox[{"{", 
                 RowBox[{"1", ",", "2"}], "}"}]}], "]"}], "]"}]}]}], 
           "}"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"convexHullG", "=", 
         RowBox[{"Graphics", "@", 
          RowBox[{"{", 
           RowBox[{"Line", "@", 
            RowBox[{"Append", "[", 
