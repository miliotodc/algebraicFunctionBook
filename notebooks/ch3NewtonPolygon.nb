Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"getNewtonData", "[", 
      RowBox[{"thef_", ",", "theK_", ",", "normalExp_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "j", ",", "rootnum", ",", "theftemp", ",", "theclist", ",", "expList",
          ",", "minVals", ",", "lcpsave", ",", "myPoints", ",", "pgp", ",", 
         "sg", ",", "newtonLeg", ",", "mylines", ",", "maxx", ",", "maxy", 
         ",", "slopeInterceptList", ",", "theCEquations", ",", "theRootTally",
          ",", "rootstatus", ",", "theSegmentData", ",", "mysegments", ",", 
         "currentRootTally", ",", "currentSegment", ",", "currentRootList", 
         ",", "theT", ",", "theD", ",", "mycurrentw", ",", "multinum", ",", 
         "myS", ",", "charRoots", ",", "theLegArray", ",", "thePolygonPoints",
          ",", "theRotatedPoints", ",", "hullIndexes", ",", "cZeroList", ",", 
         "cRemovalF"}], "}"}], ",", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"theftemp", "=", "thef"}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"theclist", "=", 
         RowBox[{"CoefficientList", "[", 
          RowBox[{"theftemp", ",", "w"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"expList", "=", 
         RowBox[{"Exponent", "[", 
          RowBox[{"theclist", ",", "z", ",", "Min"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"minVals", "=", 
         RowBox[{"MapThread", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Coefficient", "[", 
             RowBox[{"#1", ",", "z", ",", "#2"}], "]"}], "&"}], ",", 
           RowBox[{"{", 
            RowBox[{"theclist", ",", "expList"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", " ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "theLegArray", ",", "thePolygonPoints", ",", "theRotatedPoints"}], 
          "}"}], "=", 
         RowBox[{"getSegmentData", "[", 
          RowBox[{
           RowBox[{"Expand", "@", "thef"}], ",", "theK"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{"$getNewtonDataFlag", ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"\"\<theLegArray: \>\"", ",", 
             RowBox[{"theLegArray", "//", "N"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<thePolygonPoints: \>\"", ",", 
             RowBox[{"thePolygonPoints", "//", "N"}]}], "]"}], ";"}]}], 
         "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "theLegArray", "]"}], ">", "0"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"{", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"slopeInterceptList", ",", "theRootTally"}], "}"}], "=", 
             RowBox[{"getCharRoots", "[", 
              RowBox[{
              "theLegArray", ",", "thePolygonPoints", ",", 
               "theRotatedPoints"}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{"$getNewtonDataFlag", ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"Print", "[", 
                RowBox[{"\"\<slopeInterceptList: \>\"", ",", 
                 RowBox[{"slopeInterceptList", "//", "N"}]}], "]"}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"Print", "[", 
                RowBox[{"\"\<root tally: \>\"", ",", 
                 RowBox[{"theRootTally", "//", "N"}]}], "]"}], ";"}]}], 
             "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", " ", 
             RowBox[{
             "keep", " ", "copy", " ", "of", " ", "theRootTally", " ", "to", 
              " ", "detect", " ", "multiple", " ", "factors", " ", "of", " ", 
              "a", " ", "finite", " ", "series"}], " ", "*)"}], 
            "\[IndentingNewLine]", 
            RowBox[{"currentRootTally", "=", "theRootTally"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"theSegmentData", "=", 
             RowBox[{"MapThread", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"#1", ",", "#2"}], "}"}], "&"}], ",", 
               RowBox[{"{", 
                RowBox[{"slopeInterceptList", ",", "theRootTally"}], "}"}]}], 
              "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"Clear", "[", "x", "]"}], ";", "\[IndentingNewLine]", 
            "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"mysegments", "=", 
             RowBox[{"Range", "[", 
              RowBox[{"Length", "[", "theSegmentData", "]"}], "]"}]}], ";", 
            "\[IndentingNewLine]", "\[IndentingNewLine]", " ", 
            RowBox[{"Do", "[", " ", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"{", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{
                 RowBox[{"$fNewton", "[", 
                  RowBox[{"[", "theK", "]"}], "]"}], "=", "theftemp"}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"currentSegment", "=", 
                 RowBox[{"theSegmentData", "[", 
                  RowBox[{"[", "segmentnum", "]"}], "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"currentRootList", "=", 
                 RowBox[{"currentSegment", "[", 
                  RowBox[{"[", "2", "]"}], "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"If", "[", 
                 RowBox[{"$getNewtonDataFlag", ",", "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"Print", "[", 
                    RowBox[{"\"\<current root list size: \>\"", ",", 
                    RowBox[{"Length", "@", "currentRootList"}]}], "]"}], 
                   ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
                "\[IndentingNewLine]", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"$\[Lambda]Newton", "[", 
                    RowBox[{"[", "theK", "]"}], "]"}], ",", 
                   RowBox[{"$\[Beta]Newton", "[", 
                    RowBox[{"[", "theK", "]"}], "]"}]}], "}"}], "=", 
                 RowBox[{"currentSegment", "[", 
                  RowBox[{"[", "1", "]"}], "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"For", "[", 
                 RowBox[{
                  RowBox[{"rootnum", "=", "1"}], ",", 
                  RowBox[{"rootnum", "\[LessEqual]", 
                   RowBox[{"Length", "[", "currentRootList", "]"}]}], ",", 
                  RowBox[{"rootnum", "++"}], ",", "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"$cNewton", "[", 
                    RowBox[{"[", "theK", "]"}], "]"}], "=", 
                    RowBox[{"currentRootList", "[", 
                    RowBox[{"[", 
                    RowBox[{"rootnum", ",", "1"}], "]"}], "]"}]}], ";", 
                   "\[IndentingNewLine]", "\[IndentingNewLine]", 
                   RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"currentRootList", "[", 
                    RowBox[{"[", 
                    RowBox[{"rootnum", ",", "2"}], "]"}], "]"}], 
                    "\[NotEqual]", "1"}], ",", "\[IndentingNewLine]", 
                    RowBox[{"(*", " ", 
                    RowBox[{
                    "generate", " ", "next", " ", "polygon", " ", "leg"}], 
                    " ", "*)"}], "\[IndentingNewLine]", 
                    RowBox[{"{", "\[IndentingNewLine]", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"If", "[", 
                    RowBox[{"$getNewtonDataFlag", ",", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"Print", "[", 
                    RowBox[{
                    "\"\<$fNewton[[theK+1]] before remove residues: \>\"", 
                    ",", 
                    RowBox[{"N", "[", 
                    RowBox[{
                    RowBox[{"polyForm", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    FractionBox["1", 
                    SuperscriptBox["z", 
                    RowBox[{"$\[Beta]Newton", "[", 
                    RowBox[{"[", "theK", "]"}], "]"}]]], 
                    RowBox[{"$fNewton", "[", 
                    RowBox[{"[", "theK", "]"}], "]"}]}], "/.", 
                    RowBox[{"w", "\[Rule]", 
                    RowBox[{
                    SuperscriptBox["z", 
                    RowBox[{"$\[Lambda]Newton", "[", 
                    RowBox[{"[", "theK", "]"}], "]"}]], 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"$cNewton", "[", 
                    RowBox[{"[", "theK", "]"}], "]"}], "+", "w"}], 
                    ")"}]}]}]}], ",", "w"}], "]"}], ",", "10"}], "]"}]}], 
                    "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"cZeroList", ",", "cRemovalF"}], "}"}], "=", 
                    RowBox[{"identifyPolygonZeros", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    FractionBox["1", 
                    SuperscriptBox["z", 
                    RowBox[{"$\[Beta]Newton", "[", 
                    RowBox[{"[", "theK", "]"}], "]"}]]], 
                    RowBox[{"$fNewton", "[", 
                    RowBox[{"[", "theK", "]"}], "]"}]}], "/.", 
                    RowBox[{"w", "\[Rule]", 
                    RowBox[{
                    SuperscriptBox["z", 
                    RowBox[{"$\[Lambda]Newton", "[", 
                    RowBox[{"[", "theK", "]"}], "]"}]], 
                    RowBox[{"(", 
                    RowBox[{"c", "+", "w"}], ")"}]}]}]}], ",", 
                    RowBox[{"$cNewton", "[", 
                    RowBox[{"[", "theK", "]"}], "]"}]}], "]"}]}], ";", 
                    "\[IndentingNewLine]", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"$fNewton", "[", 
                    RowBox[{"[", 
                    RowBox[{"theK", "+", "1"}], "]"}], "]"}], "=", 
                    "cRemovalF"}], ";", "\[IndentingNewLine]", 
                    "\[IndentingNewLine]", 
                    RowBox[{"If", "[", 
                    RowBox[{"$getNewtonDataFlag", ",", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"Print", "[", 
                    RowBox[{
                    "\"\<$fNewton[[theK+1]] after removeCResidues: \>\"", ",", 
                    RowBox[{"polyForm", "[", 
                    RowBox[{
                    RowBox[{"N", "[", 
                    RowBox[{
                    RowBox[{"$fNewton", "[", 
                    RowBox[{"[", 
                    RowBox[{"theK", "+", "1"}], "]"}], "]"}], ",", "10"}], 
                    "]"}], ",", "w"}], "]"}]}], "]"}], ";"}]}], 
                    "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
                    "\[IndentingNewLine]", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"theK", "+", "1"}], ")"}], ">", "1"}], " ", "&&", 
                    " ", "$getSegmentDataFlag"}], ",", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"Print", "[", 
                    RowBox[{
                    RowBox[{"Style", "[", 
                    RowBox[{
                    "\"\<Entering polygon iteration \>\"", ",", "Purple", ",",
                     "Bold", ",", "20", ",", "Underlined"}], "]"}], ",", 
                    RowBox[{"Style", "[", 
                    RowBox[{
                    RowBox[{"theK", "+", "1"}], ",", "Purple", ",", "Bold", 
                    ",", "20"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
                    RowBox[{"Print", "[", 
                    RowBox[{"\"\<  for root: \>\"", ",", 
                    RowBox[{
