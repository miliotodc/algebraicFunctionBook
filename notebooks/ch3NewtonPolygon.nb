Cell[CellGroupData[{

Cell["getRandomRealPoly", "Subsection",
 CellChangeTimes->{{3.8893451765456877`*^9, 
  3.889345179544986*^9}},ExpressionUUID->"7042ae55-f94d-46a1-9fbd-\
6da4250d6c73"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"getRandomRealPoly", "[", 
      RowBox[{"wMax_", ",", "sparseVal_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "randomNum", ",", "getcoef", ",", "getZPower", ",", "totalLen", ",", 
         "zPolyTable", ",", "i", ",", "zPolyList", ",", "randomWIndex", ",", 
         "index", ",", "newFunction", ",", "reduceFlag"}], "}"}], ",", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"randomNum", "[", "n_", "]"}], ":=", " ", 
         RowBox[{"RandomChoice", "[", 
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{"0", ",", 
              RowBox[{"{", "n", "}"}]}], "]"}], ",", 
            RowBox[{"{", "1", "}"}]}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"getcoef", "[", 
          RowBox[{"a_", ",", "b_"}], "]"}], ":=", 
         RowBox[{
          RowBox[{"RandomInteger", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "a"}], ",", "a"}], "}"}], "]"}], "/", 
          RowBox[{"RandomInteger", "[", 
           RowBox[{"{", 
            RowBox[{"1", ",", "b"}], "}"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", " ", 
        RowBox[{
         RowBox[{"getZPower", "[", "n_", "]"}], ":=", 
         RowBox[{
          RowBox[{"randomNum", "[", "sparseVal", "]"}], 
          RowBox[{"RandomInteger", "[", 
           RowBox[{"{", 
            RowBox[{"0", ",", "n"}], "}"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"totalLen", "=", 
         RowBox[{"wMax", "+", "1"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"zPolyTable", "=", 
         RowBox[{"Table", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"getcoef", "[", 
             RowBox[{"8", ",", "5"}], "]"}], " ", 
            RowBox[{"z", "^", 
             RowBox[{"getZPower", "[", 
              RowBox[{"RandomInteger", "[", 
               RowBox[{"{", 
                RowBox[{"2", ",", "totalLen"}], "}"}], "]"}], "]"}]}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", "totalLen"}], "}"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"n", ",", "1", ",", 
             RowBox[{"RandomInteger", "[", 
              RowBox[{"{", 
               RowBox[{"2", ",", "totalLen"}], "}"}], "]"}]}], "}"}]}], 
          "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"zPolyList", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"Plus", "@@", "#"}], "&"}], "/@", " ", "zPolyTable"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"randomWIndex", "=", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"0", ",", "totalLen"}], "]"}]}], ";", "\[IndentingNewLine]",
         "\[IndentingNewLine]", 
        RowBox[{"index", "=", "0"}], ";", "\[IndentingNewLine]", 
        RowBox[{"reduceFlag", "=", "True"}], ";", "\[IndentingNewLine]", 
        RowBox[{"While", "[", 
         RowBox[{"reduceFlag", " ", ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"index", "++"}], ";", "\[IndentingNewLine]", 
           RowBox[{"randomWIndex", "=", 
            RowBox[{"RandomChoice", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"0", ",", "1"}], "}"}], ",", "totalLen"}], "]"}]}], 
           ";", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"randomWIndex", "[", 
               RowBox[{"[", 
                RowBox[{"-", "1"}], "]"}], "]"}], "==", "1"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"newFunction", "=", 
               RowBox[{"Plus", "@@", 
                RowBox[{"Table", "[", "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"randomWIndex", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "==", "1"}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"zPolyList", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], " ", 
                    RowBox[{"w", "^", 
                    RowBox[{"(", 
                    RowBox[{"i", "-", "1"}], ")"}]}]}], "\[IndentingNewLine]",
                     ",", "\[IndentingNewLine]", "0"}], "\[IndentingNewLine]",
                    "]"}], ",", "\[IndentingNewLine]", 
                  RowBox[{"{", 
                   RowBox[{"i", ",", "1", ",", 
                    RowBox[{"Length", "@", "randomWIndex"}]}], "}"}]}], 
                 "\[IndentingNewLine]", "]"}]}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"IrreduciblePolynomialQ", "[", "newFunction", "]"}], 
                ",", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"reduceFlag", "=", "False"}], ";"}]}], 
               "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", 
            "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", "newFunction"}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.8893451824193153`*^9, 3.8893451834503517`*^9}},
 CellLabel->
  "In[123]:=",ExpressionUUID->"82a3f928-16d4-47c5-8358-5f1354579f90"]
}, Closed]],

Cell[CellGroupData[{

Cell["strictPolynomialQ", "Subsection",
 CellChangeTimes->{{3.8893602934364414`*^9, 
  3.8893602965138407`*^9}},ExpressionUUID->"f7dda212-5d76-46d7-ba48-\
dc7e804d3425"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"strictPolynomialQ", "[", 
     RowBox[{"myPoly_", ",", 
      RowBox[{"{", 
       RowBox[{"x_", ",", "y_"}], "}"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"levels", ",", "cList", ",", "finalList", ",", "return"}], 
       "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"PolynomialQ", "[", 
          RowBox[{"myPoly", ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", "y"}], "}"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"levels", "=", 
           RowBox[{"Level", "[", 
            RowBox[{"myPoly", ",", 
             RowBox[{"{", 
              RowBox[{"-", "1"}], "}"}], ",", 
             RowBox[{"Heads", "->", "True"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Length", "@", 
               RowBox[{"Position", "[", 
                RowBox[{"levels", ",", "x"}], "]"}]}], ">", "0"}], " ", "&&", 
             " ", 
             RowBox[{
              RowBox[{"Length", "@", 
               RowBox[{"Position", "[", 
                RowBox[{"levels", ",", "y"}], "]"}]}], ">", "0"}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"cList", "=", 
              RowBox[{"Complement", "[", 
               RowBox[{"levels", ",", 
                RowBox[{"{", 
                 RowBox[{
                 "Plus", ",", "Power", ",", "Times", ",", "x", ",", "y"}], 
                 "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"finalList", "=", 
              RowBox[{"Complement", "[", 
               RowBox[{"cList", ",", 
                RowBox[{"Select", "[", 
                 RowBox[{"cList", ",", "NumberQ"}], "]"}]}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Length", "@", "finalList"}], ">", "0"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"Print", "[", 
                 RowBox[{
                  RowBox[{"Style", "[", 
                   RowBox[{
                   "\"\<expression is not strict polynomial in \>\"", ",", 
                    "Red"}], "]"}], ",", 
                  RowBox[{"Style", "[", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"x", ",", "y"}], "}"}], ",", "Red"}], "]"}]}], 
                 "]"}], ";", "\[IndentingNewLine]", 
                RowBox[{"return", "=", "False"}], ";"}], 
               "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"return", "=", "True"}], ";"}]}], 
              "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", ",",
             "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{
               RowBox[{"Style", "[", 
                RowBox[{
                "\"\<expression is not strict polynomial in \>\"", ",", 
                 "Red"}], "]"}], ",", 
               RowBox[{"Style", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"x", ",", "y"}], "}"}], ",", "Red"}], "]"}]}], 
              "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"return", "=", "False"}], ";"}]}], "\[IndentingNewLine]",
            "]"}], ";"}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"return", "=", "False"}], ";"}]}], "\[IndentingNewLine]", 
        "]"}], ";", "\[IndentingNewLine]", "return"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.8893602992317033`*^9, 3.8893603006690025`*^9}, {
  3.8893630345963316`*^9, 3.8893630418912425`*^9}, {3.894371500481982*^9, 
  3.8943715009192405`*^9}, {3.8970419131913157`*^9, 3.897041953096331*^9}},
 CellLabel->
  "In[124]:=",ExpressionUUID->"d691ce59-e4a6-4d96-a3f7-f7f01078bc00"]
}, Closed]],

Cell[CellGroupData[{

Cell["getZeroIndexes", "Subsection",
 CellChangeTimes->{{3.894362768159027*^9, 3.894362771564473*^9}, {
  3.8943648054975176`*^9, 
  3.8943648076554794`*^9}},ExpressionUUID->"2f85dd88-354b-4d21-86ab-\
be86327ef0e3"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"getZeroIndexes", "[", 
     RowBox[{"$theFunction_", ",", "$theSingularList_", ",", 
      RowBox[{"diag_", ":", "False"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "wKeys", ",", "a0Rule", ",", "a1Rule", ",", "theZeroPoints", ",", 
        "zeroPrecision", ",", "duplicateError", ",", "$zeroIndexes", ",", 
        "theZeroList", ",", "singPrecision", ",", "difTable", ",", "maxDif", 
        ",", "rootPrecisionTable"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"wKeys", "=", 
        RowBox[{"CoefficientRules", "[", 
         RowBox[{
         "$theFunction", ",", "w", ",", "\"\<NegativeLexicographic\>\""}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"a0Rule", "=", 
        RowBox[{"Normal", "@", 
         RowBox[{"KeyTake", "[", 
          RowBox[{"wKeys", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", "0", "}"}], ",", "z"}], "}"}]}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"singPrecision", "=", 
        RowBox[{"Floor", "@", 
         RowBox[{"Precision", "@", "$theSingularList"}]}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "@", "a0Rule"}], ">", "0"}], " ", ",", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{"found", " ", "a_", "0"}], " ", "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Exponent", "[", 
              RowBox[{
               RowBox[{"a0Rule", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "2"}], "]"}], "]"}], ",", "z"}], "]"}], 
             ">", "0"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"a1Rule", "=", 
              RowBox[{"Normal", "@", 
               RowBox[{"KeyTake", "[", 
                RowBox[{"wKeys", ",", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"{", "1", "}"}], ",", "z"}], "}"}]}], "]"}]}]}], 
             ";", "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Length", "@", "a1Rule"}], ">", "0"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"(*", " ", 
                RowBox[{
                "now", " ", "have", " ", "a0", " ", "and", " ", "a1", " ", 
                 "in", " ", "function"}], " ", "*)"}], "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Exponent", "[", 
                    RowBox[{
                    RowBox[{"a1Rule", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}], ",", "z"}], "]"}], 
                   ">", "0"}], ",", "\[IndentingNewLine]", 
                  RowBox[{"(*", " ", 
                   RowBox[{
                    RowBox[{
                    "a1", " ", "is", " ", "a", " ", "poly", " ", "degree"}], 
                    ">", "0"}], " ", "*)"}], "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"a0Rule", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}], "===", 
                    RowBox[{"a1Rule", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{"(*", " ", 
                    RowBox[{
                    RowBox[{"at", " ", "this", " ", "point", " ", "a0"}], "===", 
                    RowBox[{
                    RowBox[{"a1", " ", "poly", " ", "degree"}], ">", 
                    RowBox[{
                    "0", " ", "so", " ", "zero", " ", "terms", " ", "are", 
                    " ", "zeros", " ", "to", " ", "a0"}]}]}], " ", "*)"}], 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"theZeroPoints", "=", 
                    RowBox[{"Sort", "[", 
                    RowBox[{
                    RowBox[{"z", "/.", 
                    RowBox[{"NSolve", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Factor", "@", 
                    RowBox[{"a0Rule", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}]}], "\[Equal]", 
                    "0"}], ",", "z", ",", 
                    RowBox[{
                    "WorkingPrecision", "\[Rule]", "singPrecision"}]}], 
                    "]"}]}], ",", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "@", "#1"}], "<=", 
                    RowBox[{"Abs", "@", "#2"}]}], "&"}]}], "]"}]}], ";"}], 
                    "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
                    RowBox[{"(*", 
                    RowBox[{
                    RowBox[{"Print", "[", 
                    RowBox[{"Style", "[", 
                    RowBox[{
                    "\"\<No zero key singular points\>\"", ",", "Red"}], 
                    "]"}], "]"}], ";"}], "*)"}], "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"theZeroPoints", "=", 
                    RowBox[{"{", "}"}]}], ";"}]}], "\[IndentingNewLine]", 
                    "]"}], ";"}], "\[IndentingNewLine]", ",", 
                  "\[IndentingNewLine]", 
                  RowBox[{"(*", " ", 
                   RowBox[{
                   "if", " ", "a1", " ", "is", " ", "a", " ", "constant", " ",
                     "zero", " ", "set", " ", "is", " ", "null"}], " ", 
                   "*)"}], "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"theZeroPoints", "=", 
                    RowBox[{"{", "}"}]}], ";"}]}], "\[IndentingNewLine]", 
                 "]"}], ";"}], "\[IndentingNewLine]", ",", 
               "\[IndentingNewLine]", 
               RowBox[{"(*", " ", 
                RowBox[{
                "have", " ", "no", " ", "a1", " ", "at", " ", "this", " ", 
                 "point"}], " ", "*)"}], "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"theZeroPoints", "=", 
                 RowBox[{"Sort", "[", 
                  RowBox[{
                   RowBox[{"z", "/.", 
                    RowBox[{"NSolve", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Factor", "@", 
                    RowBox[{"a0Rule", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}]}], "\[Equal]", 
