Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"polishCharRoots", "[", 
     RowBox[{"eqnArray_", ",", "tallyArray_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "theTally", ",", "newRootArray", ",", "tally", ",", "currentTallyData",
         ",", "root", ",", "currentTally", ",", "multiplicity", ",", " ", 
        "newX", ",", "tallyRootAcc", ",", "rootPos", ",", "newRoot", ",", 
        "netArray", ",", "rootPosArray", ",", "multiRootPrec", ",", 
        "rootTallyPrec", ",", "difTable", ",", "altPos", ",", "altPosArray"}],
        "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"theTally", "=", 
        RowBox[{"MapThread", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"#1", ",", "#2"}], "}"}], "&"}], ",", 
          RowBox[{"{", 
           RowBox[{"eqnArray", ",", "tallyArray"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"netArray", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"tally", "=", "1"}], ",", 
         RowBox[{"tally", "<=", 
          RowBox[{"Length", "@", "theTally"}]}], ",", 
         RowBox[{"tally", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"currentTallyData", "=", 
           RowBox[{"theTally", "[", 
            RowBox[{"[", "tally", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{"$printPolishRootFlag", ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{"\"\<polishCharRoot: currentTallyData: \>\"", ",", 
               RowBox[{"currentTallyData", "//", "N"}]}], "]"}], ";"}]}], 
           "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"newRootArray", "=", 
           RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"root", "=", "1"}], ",", 
            RowBox[{"root", "<=", 
             RowBox[{"Length", "@", 
              RowBox[{"currentTallyData", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}]}], ",", 
            RowBox[{"root", "++"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"currentTally", "=", 
              RowBox[{"currentTallyData", "[", 
               RowBox[{"[", 
                RowBox[{"2", ",", "root"}], "]"}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{"$printPolishRootFlag", ",", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"Print", "[", 
                 RowBox[{"\"\<polishCharRoot: currentTally: \>\"", ",", 
                  RowBox[{"currentTally", "//", "N"}]}], "]"}], ";"}]}], 
              "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"multiplicity", "=", 
              RowBox[{"currentTally", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"currentTally", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], ">", "1"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"If", "[", 
                 RowBox[{"$printPolishRootFlag", ",", "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"Print", "[", 
                    RowBox[{"\"\<     currentTally: \>\"", ",", 
                    RowBox[{"N", "[", 
                    RowBox[{"currentTally", ",", "10"}], "]"}]}], "]"}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"Print", "[", 
                    RowBox[{
                    RowBox[{"Style", "[", 
                    RowBox[{"\"\<Detected multiple roots: \>\"", ",", "Red"}],
                     "]"}], ",", 
                    RowBox[{"currentTally", "//", "N"}]}], "]"}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"Print", "[", 
                    RowBox[{"\"\<     tally eqn: \>\"", ",", 
                    RowBox[{
                    RowBox[{"currentTallyData", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "//", "N"}]}], "]"}], ";",
                    "\[IndentingNewLine]", 
                   RowBox[{"Print", "[", 
                    RowBox[{"\"\<     tally eqn prec: \>\"", ",", 
                    RowBox[{"Precision", "@", 
                    RowBox[{"currentTallyData", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}]}], "]"}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"Print", "[", 
                    RowBox[{"\"\<     tally root: \>\"", ",", 
                    RowBox[{
                    RowBox[{"currentTally", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "//", "N"}]}], "]"}], ";",
                    "\[IndentingNewLine]", 
                   RowBox[{"Print", "[", 
                    RowBox[{"\"\<     tally root prec: \>\"", ",", 
                    RowBox[{"Precision", "@", 
                    RowBox[{"currentTally", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}]}], "]"}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"Print", "[", 
                    RowBox[{
                    "\"\<     multiplicity: \>\"", ",", "multiplicity"}], 
                    "]"}], ";", "\[IndentingNewLine]", 
                   RowBox[{
                   "Print", "[", "\"\<     Running derivative root eqn: \>\"",
                     "]"}], ";", "\[IndentingNewLine]", 
                   RowBox[{"Print", "[", 
                    RowBox[{
                    "\"\<     Precision of derivative equation: \>\"", ",", 
                    RowBox[{"Precision", "@", 
                    RowBox[{"D", "[", 
                    RowBox[{
                    RowBox[{"currentTallyData", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"x", ",", 
                    RowBox[{"multiplicity", "-", "1"}]}], "}"}]}], "]"}]}]}], 
                    "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"multiRootPrec", "=", 
                 RowBox[{"Floor", "@", 
                  RowBox[{"Precision", "@", 
                   RowBox[{"currentTallyData", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}]}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"(*", 
                 RowBox[{
                  RowBox[{"Print", "[", 
                   RowBox[{
                    RowBox[{"Style", "[", 
                    RowBox[{"\"\<multiRoot equation Prec: \>\"", ",", "Red"}],
                     "]"}], ",", "multiRootPrec"}], "]"}], ";"}], "*)"}], 
                "\[IndentingNewLine]", 
                RowBox[{"newX", "=", 
                 RowBox[{"x", "/.", 
                  RowBox[{"NSolve", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"D", "[", 
                    RowBox[{
                    RowBox[{"currentTallyData", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"x", ",", 
                    RowBox[{"multiplicity", "-", "1"}]}], "}"}]}], "]"}], "==",
                     "0"}], ",", "x"}], 
                   RowBox[{"(*", 
                    RowBox[{",", 
                    RowBox[{"WorkingPrecision", "->", 
                    RowBox[{"(", "multiRootPrec", ")"}]}]}], "*)"}], 
                   "]"}]}]}], ";", "\[IndentingNewLine]", 
                RowBox[{"If", "[", 
                 RowBox[{"$printPolishRootFlag", ",", "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"Print", "[", 
                    RowBox[{"\"\<Roots from derivative NSolve: \>\"", ",", 
                    RowBox[{"newX", "//", "N"}]}], "]"}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"Print", "[", 
                    RowBox[{
                    "\"\<Precision of roots from derivative NSolve: \>\"", 
                    ",", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Precision", "@", "#"}], "&"}], "/@", " ", 
                    "newX"}]}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], 
                ";", "\[IndentingNewLine]", 
                RowBox[{"(*", "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"find", " ", "tally", " ", "root", " ", "in", " ", 
                   RowBox[{"newX", ":", " ", "newX"}]}], ",", "tallyRootAcc", 
                  ",", "rootPos", ",", "newRoot"}], "\[IndentingNewLine]", 
                 "*)"}], "\[IndentingNewLine]", 
                RowBox[{"tallyRootAcc", "=", 
                 RowBox[{"Floor", "@", 
                  RowBox[{"Accuracy", "@", 
                   RowBox[{"currentTally", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}]}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"rootTallyPrec", "=", 
                 RowBox[{"Min", "@", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"Floor", "@", 
                    RowBox[{"Precision", "@", 
                    RowBox[{"currentTally", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}]}], ",", 
                    RowBox[{"Floor", "@", 
                    RowBox[{"Precision", "@", "newX"}]}]}], "}"}]}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"(*", 
                 RowBox[{
                  RowBox[{"Print", "[", 
                   RowBox[{
                    RowBox[{"Style", "[", 
                    RowBox[{"\"\<rootTallyPrec: \>\"", ",", "Red"}], "]"}], 
                    ",", "rootTallyPrec"}], "]"}], ";"}], "*)"}], 
                "\[IndentingNewLine]", 
                RowBox[{"difTable", "=", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Abs", "[", 
                    RowBox[{"#", "-", 
                    RowBox[{"currentTally", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "&"}], "/@", " ",
                   "newX"}]}], ";", "\[IndentingNewLine]", 
                RowBox[{"(*", 
                 RowBox[{
                  RowBox[{"Print", "[", 
                   RowBox[{
                    RowBox[{"Style", "[", 
                    RowBox[{"\"\<multi root difTable: \>\"", ",", "Red"}], 
                    "]"}], ",", 
                    RowBox[{"N", "[", 
                    RowBox[{"difTable", ",", "10"}], "]"}]}], "]"}], ";"}], 
                 "*)"}], "\[IndentingNewLine]", 
                RowBox[{"altPosArray", "=", 
                 RowBox[{"Position", "[", 
                  RowBox[{"difTable", ",", 
                   RowBox[{"Min", "[", "difTable", "]"}]}], "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"(*", 
                 RowBox[{
                  RowBox[{"Print", "[", 
                   RowBox[{
                    RowBox[{"Style", "[", 
                    RowBox[{"\"\<alt root pos: \>\"", ",", "Red"}], "]"}], 
                    ",", "altPos"}], "]"}], ";", "\[IndentingNewLine]", 
                  RowBox[{"Print", "[", 
                   RowBox[{
                    RowBox[{"Style", "[", 
                    RowBox[{"\"\<     altRoot: \>\"", ",", "Red"}], "]"}], 
                    ",", 
                    RowBox[{"N", "[", 
                    RowBox[{
                    RowBox[{"newX", "[", 
                    RowBox[{"[", "altPos", "]"}], "]"}], ",", "10"}], "]"}]}],
                    "]"}], ";"}], "\[IndentingNewLine]", "*)"}], 
                "\[IndentingNewLine]", 
                RowBox[{"(*", 
                 RowBox[{
                  RowBox[{"rootPosArray", "=", 
                   RowBox[{"Position", "[", 
                    RowBox[{"newX", ",", 
                    RowBox[{"x_", "/;", 
                    RowBox[{
                    RowBox[{"Abs", "[", 
                    RowBox[{"x", "-", 
                    RowBox[{"currentTally", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "<", 
                    RowBox[{"10", "^", 
                    RowBox[{"-", 
                    RowBox[{"(", 
                    RowBox[{"rootTallyPrec", "-", "50"}], ")"}]}]}]}]}]}], 
                    "]"}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Length", "@", "altPosArray"}], "==", "0"}], ",", 
                  "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"Print", "[", 
                    RowBox[{"Style", "[", 
                    RowBox[{
                    "\"\<polishCharRoot: Position error!\>\"", ",", "12", ",",
                     "Red"}], "]"}], "]"}], ";", "\[IndentingNewLine]", 
                   RowBox[{"Print", "[", 
                    RowBox[{"\"\<altPos: \>\"", ",", "altPosArray"}], "]"}], 
                   ";", "\[IndentingNewLine]", 
                   RowBox[{"Abort", "[", "]"}], ";"}]}], 
                 "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
                RowBox[{"(*", 
