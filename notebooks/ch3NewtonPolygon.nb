Cell[CellGroupData[{

Cell["createConjugateSeriesGroup", "Subsection",
 CellChangeTimes->{{3.969520275875775*^9, 
  3.9695202805016613`*^9}},ExpressionUUID->"9603dc35-8684-43e6-919a-\
ba04f437351a"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"createConjugateSeriesGroup", "[", 
     RowBox[{"genSeries_", ",", "cycleSize_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"theExpList", ",", "theCList", ",", "theK"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"cycleSize", ">", "1"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"theExpList", "=", 
          RowBox[{
           RowBox[{"Exponent", "[", 
            RowBox[{"genSeries", ",", "z", ",", "List"}], "]"}], "//", 
           "Flatten"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"theCList", "=", 
          RowBox[{
           RowBox[{"Coefficient", "[", 
            RowBox[{"genSeries", ",", "z", ",", "theExpList"}], "]"}], "//", 
           "Flatten"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"Table", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Plus", "@@", 
            RowBox[{"MapThread", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"#1", " ", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"Exp", "[", 
                   RowBox[{"2", " ", "theK", " ", "Pi", " ", "I", " ", "#2"}],
                    "]"}], " ", 
                  RowBox[{"z", "^", "#2"}]}], ")"}]}], "&"}], ",", 
              RowBox[{"{", 
               RowBox[{"theCList", ",", "theExpList"}], "}"}]}], "]"}]}], ",",
            "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"theK", ",", "0", ",", 
             RowBox[{"cycleSize", "-", "1"}]}], "}"}]}], 
          "\[IndentingNewLine]", "]"}]}], ",", "\[IndentingNewLine]", 
        "genSeries"}], "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}]}]], "Input",
