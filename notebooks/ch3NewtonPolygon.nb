                    "\"\<Found insufficiently small root difference >10^-100!\
\>\"", ",", "Red", ",", "Bold", ",", "14"}], "]"}], "]"}], ";"}]}], 
                    "\[IndentingNewLine]", "]"}], ";"}], 
                    "\[IndentingNewLine]", "}"}]}], "\[IndentingNewLine]", 
                    "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], 
