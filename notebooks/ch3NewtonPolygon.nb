Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"singularSequence", "\[IndentingNewLine]", 
   RowBox[{"$theSingularList", "//", "N"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{
    "find", " ", "list", " ", "of", " ", "removable", " ", "singular", " ", 
     "points"}], "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"removableTable", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"nextIndex", "=", 
         RowBox[{"singularSequence", "[", 
          RowBox[{"[", "cIndex", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"TrueQ", "@", 
           RowBox[{"FileExistsQ", "@", 
            RowBox[{"seriesFileName", "[", "nextIndex", "]"}]}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
             "newSingularIndex", ",", "nextSing", ",", "nextCycleMetric", ",",
               "nextPoleList", ",", "nextConjList", ",", "removableList", ",",
               "nextSeries", ",", "nextSheetLinks", ",", "nextSingSequence"}],
              "}"}], "=", 
            RowBox[{"Import", "[", 
             RowBox[{"seriesFileName", "[", "nextIndex", "]"}], "]"}]}], 
           ";"}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{
             RowBox[{"Style", "[", 
              RowBox[{"\"\<File not found: \>\"", ",", "Red"}], "]"}], ",", 
             RowBox[{"seriesFileName", "[", "nextIndex", "]"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Abort", "[", "]"}], ";"}]}], "\[IndentingNewLine]", "]"}],
         ";", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"nextIndex", ",", "removableList"}], "}"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"cIndex", ",", "1", ",", 
         RowBox[{"Length", "@", "singularSequence"}]}], "}"}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
   "removableTable", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"removableSingularFlag", "=", "False"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"removableTable", "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", "2"}], "]"}], "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "@", 
        RowBox[{"Flatten", "[", 
         RowBox[{"removableTable", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], ">", "0"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Print", "[", "\"\<found removable singular points\>\"", "]"}],
        ";", "\[IndentingNewLine]", 
       RowBox[{"removableSingularFlag", "=", "True"}], ";"}], 
      "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
       "Print", "[", 
        "\"\<No removable singular points found for this function\>\"", "]"}],
        ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], "\n"}]}]], "Input",
 CellChangeTimes->{{3.927380865446432*^9, 3.9273808702736144`*^9}, {
