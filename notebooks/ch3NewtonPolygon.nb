Cell[CellGroupData[{

Cell["\<\
Section 3.8:  Routine to compute ramification of generic singular points \
using NSolve\
\>", "Subsection",
 CellChangeTimes->{{3.901734114588949*^9, 3.9017341325075445`*^9}, {
  3.9818243970732584`*^9, 
  3.9818244083407354`*^9}},ExpressionUUID->"48f1cfbe-24b3-4205-98ef-\
103b77a13592"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{"aForm", "@", "$theFunction"}], "\[IndentingNewLine]", 
   "$zeroIndexes", "\[IndentingNewLine]", "$poleIndexes", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"simpleSings", "=", 
     RowBox[{"Complement", "[", 
      RowBox[{
       RowBox[{"Range", "[", 
        RowBox[{"1", ",", 
         RowBox[{"Length", "@", "$theSingularList"}]}], "]"}], ",", 
       "$zeroIndexes", ",", "$poleIndexes"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"simpleSings", "=", "$zeroIndexes"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"minRams", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"theRoots", "=", 
         RowBox[{"w", "/.", 
          RowBox[{"Sort", "@", 
           RowBox[{"NSolve", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"$theFunction", "==", "0"}], "/.", 
              RowBox[{"z", "->", 
               RowBox[{"$theSingularList", "[", 
                RowBox[{"[", 
                 RowBox[{"simpleSings", "[", 
                  RowBox[{"[", "sIndex", "]"}], "]"}], "]"}], "]"}]}]}], ",", 
             "w"}], "]"}]}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"rootAcc", "=", 
         RowBox[{"Floor", "@", 
          RowBox[{"Accuracy", "@", "theRoots"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"netTolerance", "=", 
         RowBox[{"rootAcc", "-", "$acf"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"rootTallyList", "=", 
         RowBox[{
          RowBox[{"Tally", "[", 
           RowBox[{"theRoots", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{"#1", "-", "#2"}], "]"}], "<", 
              RowBox[{"10", "^", 
               RowBox[{"(", 
                RowBox[{"-", 
                 RowBox[{"Ceiling", "[", "netTolerance", "]"}]}], ")"}]}]}], 
             "&"}]}], "]"}], "//", "N"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"cycleTally", "=", 
         RowBox[{"Select", "[", 
          RowBox[{"rootTallyList", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ">", "1"}], "&"}]}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "@", "cycleTally"}], ">", "0"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"cycleList", "=", 
            RowBox[{"cycleTally", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";"}], 
          "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"cycleList", "=", 
            RowBox[{"{", "}"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"sIndex", ",", "cycleList"}], "}"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"sIndex", ",", "1", ",", 
         RowBox[{"Length", "@", "simpleSings"}]}], "}"}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
   "minRams"}]}]], "Input",
