Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"createpBar", "[", 
     RowBox[{"pval_", ",", "denom_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "wsum", ",", "zsum", ",", "wexplist", ",", "myzlist", ",", "zexplist", 
        ",", "i", ",", "j"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"wsum", "=", "0"}], ";", "\[IndentingNewLine]", 
       RowBox[{"zsum", "=", "0"}], ";", "\[IndentingNewLine]", 
       RowBox[{"wexplist", "=", 
        RowBox[{"Exponent", "[", 
         RowBox[{"pval", ",", "w", ",", "List"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"i", "=", "1"}], ",", 
         RowBox[{"i", "\[LessEqual]", 
          RowBox[{"Length", "[", "wexplist", "]"}]}], ",", 
         RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"myzlist", "=", 
           RowBox[{"Coefficient", "[", 
            RowBox[{"pval", ",", "w", ",", 
             RowBox[{"wexplist", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"zexplist", "=", 
           RowBox[{"Exponent", "[", 
            RowBox[{"myzlist", ",", "z", ",", "List"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"zsum", "=", "0"}], ";", "\[IndentingNewLine]", 
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"j", "=", "1"}], ",", 
            RowBox[{"j", "\[LessEqual]", 
             RowBox[{"Length", "[", "zexplist", "]"}]}], ",", 
            RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"zsum", "+=", 
              RowBox[{
               RowBox[{"Coefficient", "[", 
                RowBox[{"myzlist", ",", "z", ",", 
                 RowBox[{"zexplist", "[", 
                  RowBox[{"[", "j", "]"}], "]"}]}], "]"}], 
               RowBox[{"z", "^", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"zexplist", "[", 
                   RowBox[{"[", "j", "]"}], "]"}], " ", "denom"}], 
                 ")"}]}]}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"wsum", "+=", 
           RowBox[{"zsum", " ", 
            RowBox[{"w", "^", 
             RowBox[{"wexplist", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}]}]}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", "wsum"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"getSingleSeries", "[", 
     RowBox[{
     "baseSheets_", ",", "sNum_", ",", "pSave_", ",", "size_", ",", 
      "diagFlag_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "currentSize", ",", "currentBase", ",", "currentCycle", ",", 
        "currentP", ",", "theT", ",", "theD", ",", "currentNormExp", ",", 
        "theexp", ",", "pHat", ",", "pBar", ",", "mycurrentw", ",", 
        "myderivval", ",", "netTime", ",", "maxSize", ",", "totalTime", ",", 
        "ap1", ",", "mynumerator", ",", "ap3", ",", "myderiv", ",", "ap4", 
        ",", "polymodval", ",", "ap5", ",", "myS", ",", "i", ",", "theSeries",
         ",", "myS1", ",", "myS2", ",", "theQ", ",", "zeroPolyModalIndex", 
        ",", "currentSizeIndex"}], "}"}], ",", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"currentSize", "=", "1"}], ";", "\[IndentingNewLine]", 
       RowBox[{"currentBase", "=", 
        RowBox[{"baseSheets", "[", 
         RowBox[{"[", 
          RowBox[{"sNum", ",", "2"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"currentCycle", "=", 
        RowBox[{"baseSheets", "[", 
         RowBox[{"[", 
          RowBox[{"sNum", ",", "1"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{"diagFlag", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"\"\<currentCycle: \>\"", ",", "currentCycle"}], "]"}], 
          ";"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"currentP", "=", 
        RowBox[{"pSave", "[", 
         RowBox[{"[", "currentBase", "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{"diagFlag", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"\"\<currentP: \>\"", ",", 
            RowBox[{"aForm", "[", 
             RowBox[{
              RowBox[{"currentP", "[", 
               RowBox[{"[", "5", "]"}], "]"}], "//", "N"}], "]"}]}], "]"}], 
          ";"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"theT", "=", 
        RowBox[{"currentP", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"theD", "=", 
        RowBox[{"currentP", "[", 
         RowBox[{"[", "3", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"currentNormExp", "=", 
        RowBox[{"currentP", "[", 
         RowBox[{"[", "8", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"theexp", "=", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{"currentP", "[", 
           RowBox[{"[", 
            RowBox[{"4", ",", "j"}], "]"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "1", ",", 
            RowBox[{"currentP", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "now", " ", "check", " ", "for", " ", "duplicate", " ", "series"}], 
        " ", "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"pHat", "=", 
        RowBox[{
         FractionBox[
          RowBox[{"currentP", "[", 
           RowBox[{"[", "5", "]"}], "]"}], 
          SuperscriptBox["z", 
           RowBox[{"currentP", "[", 
            RowBox[{"[", "6", "]"}], "]"}]]], "/.", 
         RowBox[{"w", "->", 
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox["z", 
             RowBox[{
              RowBox[{"currentP", "[", 
               RowBox[{"[", 
                RowBox[{"4", ",", "theT"}], "]"}], "]"}], " "}]], "w"}], 
           ")"}]}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{"$saveNewtonIterationDataFlag", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"Style", "[", 
            RowBox[{"\"\<in pHat routine\>\"", ",", "Red"}], "]"}], "]"}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<pHat: \>\"", ",", 
            RowBox[{"aForm", "[", 
             RowBox[{
              RowBox[{"Expand", "@", "pHat"}], "//", "N"}], "]"}]}], "]"}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"$pHatSave", ",", "pHat"}], "]"}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", "\[IndentingNewLine]", 
        RowBox[{"pBar", "=", 
         RowBox[{"pHat", "/.", 
          RowBox[{"z", "->", 
           RowBox[{"z", "^", "theD"}]}]}]}], "\[IndentingNewLine]", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"pBar", "=", 
        RowBox[{"createpBar", "[", 
         RowBox[{"pHat", ",", "theD"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{"$saveNewtonIterationDataFlag", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"\"\<pBar: \>\"", ",", 
            RowBox[{"aForm", "[", 
             RowBox[{
              RowBox[{"Expand", "@", "pBar"}], "//", "N"}], "]"}]}], "]"}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"$pBarSave", ",", "pBar"}], "]"}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"\"\<pBar: \>\"", ",", 
           RowBox[{"pBar", "//", "N"}]}], "]"}], ";"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"mycurrentw", "=", 
        RowBox[{"currentP", "[", 
         RowBox[{"[", "7", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"\"\<mycurrentw: \>\"", ",", 
           RowBox[{"mycurrentw", "//", "N"}]}], "]"}], ";"}], 
        "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", "\[IndentingNewLine]", " ", 
        RowBox[{
        "first", " ", "check", " ", "if", " ", "deriv", " ", "has", " ", 
         "low", " ", "precision"}], "\[IndentingNewLine]", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"myderivval", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{"pBar", ",", "w"}], "]"}], "//", "N"}], ")"}], "/.", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"w", "\[Rule]", "mycurrentw"}], ",", 
           RowBox[{"z", "\[Rule]", "0"}]}], "}"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"\"\<myderivval: \>\"", ",", 
           RowBox[{"myderivval", "//", "N"}]}], "]"}], ";"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Precision", "[", "myderivval", "]"}], "<", "5"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{
             RowBox[{"Style", "[", 
              RowBox[{"\"\<deriv too close to zero\>\"", ",", "Red"}], "]"}], 
             ",", 
             RowBox[{"N", "[", 
              RowBox[{"myderivval", ",", "10"}], "]"}]}], "]"}], ";"}], 
          "\[IndentingNewLine]", "}"}]}], "\[IndentingNewLine]", "]"}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"i", "=", "0"}], ";", "\[IndentingNewLine]", 
       RowBox[{"zeroPolyModalIndex", "=", "0"}], ";", "\[IndentingNewLine]", 
       RowBox[{"netTime", "=", 
        RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"While", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"currentSize", "<", "size"}], " ", "&&", " ", 
             RowBox[{"zeroPolyModalIndex", "<", "$maxPolymodalIteration"}]}], 
            " ", ",", "\[IndentingNewLine]", 
            RowBox[{"{", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
               "$saveNewtonIterationDataFlag", ",", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"Print", "[", 
                  RowBox[{
                  "\"\<Iteration num: \>\"", ",", "i", ",", 
                   "\"\<  mycurrentw: \>\"", ",", 
                   RowBox[{"mycurrentw", "//", "N"}]}], "]"}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"AppendTo", "[", 
                  RowBox[{"$currentIteratedW", ",", 
                   RowBox[{"{", 
                    RowBox[{"i", ",", "mycurrentw"}], "}"}]}], "]"}], ";"}]}],
                "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
              RowBox[{"totalTime", "=", 
               RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"ap1", "=", 
                  RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"mynumerator", "=", 
                    RowBox[{"pBar", "/.", 
                    RowBox[{"w", "\[Rule]", "mycurrentw"}]}]}], ";"}], 
                   "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]",
                  "\[IndentingNewLine]", 
                 RowBox[{"ap3", "=", 
                  RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"myderiv", "=", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"D", "[", 
                    RowBox[{"pBar", ",", "w"}], "]"}], "/.", 
                    RowBox[{"{", 
                    RowBox[{"w", "\[Rule]", "mycurrentw"}], "}"}]}], ")"}]}], 
                    ";"}], "\[IndentingNewLine]", "]"}]}], ";", 
                 "\[IndentingNewLine]", "\[IndentingNewLine]", 
                 RowBox[{"ap4", "=", 
                  RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"polymodval", "=", 
                    RowBox[{"Normal", "[", 
                    RowBox[{"Series", "[", 
                    RowBox[{
                    RowBox[{"mynumerator", "/", "myderiv"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"z", ",", "0", ",", 
                    RowBox[{
                    RowBox[{"2", "^", 
                    RowBox[{"(", 
                    RowBox[{"i", "+", "1"}], ")"}]}], "-", "1"}]}], "}"}]}], 
                    "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", "]"}]}], 
                 ";", "\[IndentingNewLine]", 
                 RowBox[{"If", "[", 
                  RowBox[{
                  "$tallyNewtonIterationIndexFlag", ",", 
                   "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"Print", "[", 
                    RowBox[{"\"\<Series mod iteration: \>\"", ",", 
                    RowBox[{
                    RowBox[{"2", "^", 
                    RowBox[{"(", 
                    RowBox[{"i", "+", "1"}], ")"}]}], "-", "1"}]}], "]"}], 
                    ";", "\[IndentingNewLine]", 
                    RowBox[{"Print", "[", 
                    RowBox[{"\"\<Time for polymodval: \>\"", ",", 
                    RowBox[{"ap4", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ";"}]}], 
                  "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{"polymodval", "==", "0"}], ",", 
                   "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"zeroPolyModalIndex", "++"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"Print", "[", 
                    RowBox[{
                    RowBox[{"Style", "[", 
                    RowBox[{"\"\<zero polymodval index: \>\"", ",", "Red"}], 
                    "]"}], ",", 
                    RowBox[{"Style", "[", 
                    RowBox[{"zeroPolyModalIndex", ",", "Red"}], "]"}]}], 
                    "]"}], ";", "\[IndentingNewLine]", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    "zeroPolyModalIndex", "==", "$maxPolymodalIteration"}], 
                    ",", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"Print", "[", 
                    RowBox[{"Style", "[", 
                    RowBox[{
                    "\"\<maxPolyModal zeros reached.  Stopping \
iteration!\>\"", ",", "Red"}], "]"}], "]"}], ";"}]}], "\[IndentingNewLine]", 
                    "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
                 "\[IndentingNewLine]", "\[IndentingNewLine]", 
                 RowBox[{"ap5", "=", 
                  RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"mycurrentw", "=", 
                    RowBox[{"mycurrentw", "-", "polymodval"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"currentSize", "=", 
                    RowBox[{"Length", "@", "mycurrentw"}]}], ";"}], 
                   "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]",
                  "\[IndentingNewLine]", 
                 RowBox[{"If", "[", 
                  RowBox[{
                  "$saveNewtonIterationDataFlag", ",", "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"Print", "[", 
                    RowBox[{
                    RowBox[{"Style", "[", 
                    RowBox[{"\"\<currentSize: \>\"", ",", "Blue"}], "]"}], 
                    ",", "currentSize"}], "]"}], ";"}]}], 
                  "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
                 RowBox[{"If", "[", 
                  RowBox[{"diagFlag", ",", "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"Print", "[", 
                    RowBox[{"\"\<time for ap5: \>\"", ",", 
                    RowBox[{"ap5", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ";"}]}], 
                  "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
                "]"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
               "$tallyNewtonIterationIndexFlag", " ", ",", 
                "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"Print", "[", 
                  RowBox[{
                   RowBox[{"Style", "[", 
                    RowBox[{
                    "\"\<{i,order,currentSize,precision}: \>\"", ",", "Red"}],
                     "]"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"i", ",", 
                    RowBox[{
                    RowBox[{"2", "^", 
                    RowBox[{"(", 
                    RowBox[{"i", "+", "1"}], ")"}]}], "-", "1"}], ",", 
                    "currentSize", ",", 
                    RowBox[{"Precision", "@", "mycurrentw"}]}], "}"}]}], 
                  "]"}], ";", "\[IndentingNewLine]", 
                 RowBox[{"Print", "[", 
                  RowBox[{"\"\<current w: \>\"", ",", 
                   RowBox[{"mycurrentw", "//", "N"}]}], "]"}], ";"}]}], 
               "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
               "$tallyNewtonIterationIndexFlag", " ", ",", 
                "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{"currentSize", "<", "size"}], ",", 
                   "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"Print", "[", 
                    RowBox[{"Style", "[", 
                    RowBox[{
                    "\"\<currentSize<size, starting new iteration\>\"", ",", 
                    "Blue"}], "]"}], "]"}], ";", "\[IndentingNewLine]", 
                    RowBox[{"Print", "[", 
                    RowBox[{"\"\<currentSize: \>\"", ",", "currentSize"}], 
                    "]"}], ";", "\[IndentingNewLine]", 
                    RowBox[{"Print", "[", 
                    RowBox[{"\"\<size: \>\"", ",", "size"}], "]"}], ";"}]}], 
                  "\[IndentingNewLine]", "]"}], ";"}]}], 
               "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
              RowBox[{"i", "++"}], ";"}], "\[IndentingNewLine]", "}"}]}], 
           "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
         "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"{", 
         RowBox[{"theK", ",", 
          RowBox[{"Table", "[", 
           RowBox[{
            SubscriptBox["c", "i"], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "1", ",", "theK"}], "}"}]}], "]"}], ",", 
          "theD", ",", 
          RowBox[{"Table", "[", 
           RowBox[{
            SubscriptBox["\[Lambda]", "j"], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "1", ",", "theK"}], "}"}]}], "]"}], ",", 
          SubscriptBox["f", "theT"], ",", 
          SubscriptBox["\[Beta]", "theT"], ",", "mycurrentw", ",", 
          "totalIter"}], " "}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{"$saveNewtonIterationDataFlag", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"myS1", "=", 
           RowBox[{
            UnderoverscriptBox["\[Sum]", 
             RowBox[{"i", "=", "1"}], 
             RowBox[{"theT", "-", "1"}]], 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"currentP", "[", 
               RowBox[{"[", 
                RowBox[{"2", ",", "i"}], "]"}], "]"}], 
              RowBox[{"(", " ", 
               RowBox[{"z", "^", 
                RowBox[{
                 UnderoverscriptBox["\[Sum]", 
                  RowBox[{"k", "=", "1"}], "i"], 
                 RowBox[{"currentP", "[", 
                  RowBox[{"[", 
                   RowBox[{"4", ",", "k"}], "]"}], "]"}]}]}], ")"}]}], 
             ")"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{"\"\<mySa: \>\"", ",", "Red"}], "]"}], ",", 
            RowBox[{
             RowBox[{"Expand", "@", "myS1"}], "//", "N"}]}], "]"}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{"$saveNewtonIterationDataFlag", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"\"\<leading z: \>\"", ",", 
            RowBox[{"(", 
             RowBox[{"z", "^", 
              RowBox[{"(", 
               RowBox[{
                UnderoverscriptBox["\[Sum]", 
                 RowBox[{"k", "=", "1"}], "theT"], 
                RowBox[{"currentP", "[", 
                 RowBox[{"[", 
