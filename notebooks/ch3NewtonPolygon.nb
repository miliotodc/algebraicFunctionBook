  3.952681825516302*^9}},ExpressionUUID->"06f7d749-f3da-475c-ada9-\
54e4a960577c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{"input", " ", "singular", " ", "index"}], "\[IndentingNewLine]", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"baseSingularIndex", "=", "2"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"TrueQ", "@", 
       RowBox[{"FileExistsQ", "@", 
        RowBox[{"seriesFileName", "[", 
         RowBox[{"$theTestCase", ",", "baseSingularIndex"}], "]"}]}]}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"baseSingularPoint", "=", 
        RowBox[{"$theSingularList", "[", 
         RowBox[{"[", "baseSingularIndex", "]"}], "]"}]}], ";", " ", 
       "\[IndentingNewLine]", 
       RowBox[{"baseRadius", "=", 
        RowBox[{"$minRadiusArray", "[", 
         RowBox[{"[", "baseSingularIndex", "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<baseSingularPoint: \>\"", ",", 
         RowBox[{
          RowBox[{"$theSingularList", "[", 
           RowBox[{"[", "baseSingularIndex", "]"}], "]"}], "//", "N"}]}], 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Importing file: \>\"", ",", 
         RowBox[{"seriesFileName", "[", 
          RowBox[{"$theTestCase", ",", "baseSingularIndex"}], "]"}]}], "]"}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"dataList", "=", 
        RowBox[{"Import", "[", 
         RowBox[{"seriesFileName", "[", 
          RowBox[{"$theTestCase", ",", "baseSingularIndex"}], "]"}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Len dataList: \>\"", ",", 
         RowBox[{"Length", "@", "dataList"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"baseBranchTypeArray", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"baseSeriesMIVPTable", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "newSingularIndex", ",", "newSing", ",", "baseCycleMetric", ",", 
          "basePoleList", ",", "newConjList", ",", "baseRemovableList", ",", 
          "baseSeries", ",", "baseSheetLinks", ",", "baseSingSequence", ",", 
          "baseBranchTypeArray", ",", "baseSeriesMIVPTable"}], "}"}], "=", 
        "dataList"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", "\[IndentingNewLine]", " ", 
        RowBox[{"report", " ", "data", " ", "in", " ", 
         RowBox[{"file", ":"}]}], "\[IndentingNewLine]", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<baseRemovableList: \>\"", ",", 
         RowBox[{"baseRemovableList", "//", "N"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<baseSeries precision: \>\"", ",", 
         RowBox[{"Precision", "@", "baseSeries"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<baseSheetLinks: \>\"", ",", "baseSheetLinks"}], "]"}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Chosen singular point: \>\"", ",", 
         RowBox[{"N", "[", 
          RowBox[{"baseSingularPoint", ",", "25"}], "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<File singular point:   \>\"", ",", 
         RowBox[{"N", "[", 
          RowBox[{"newSing", ",", "25"}], "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"\"\<Base sheet min lengths: \>\"", ",", "baseMinLengths"}],
           "]"}], ";"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Base poleList:          \>\"", ",", "basePoleList"}], 
