              RowBox[{"polygonPoints", "[", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{"hullIndexes", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"1", ",", "2"}], "}"}]}], "]"}], "]"}]}], "]"}]}], 
           "}"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"hullPointsG", "=", 
         RowBox[{"Graphics", "@", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"PointSize", "[", "0.02", "]"}], ",", "Black", ",", 
            RowBox[{"Point", "@", 
             RowBox[{"hullPoints", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", 
                RowBox[{"{", 
                 RowBox[{"1", ",", "2"}], "}"}]}], "]"}], "]"}]}]}], 
           "}"}]}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"hullMin", "=", 
         RowBox[{"Min", "@", 
          RowBox[{"hullPoints", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "1"}], "]"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"minPos", "=", 
         RowBox[{
          RowBox[{"Position", "[", 
           RowBox[{"hullPoints", ",", 
            RowBox[{"{", 
             RowBox[{"hullMin", ",", "_", ",", "_"}], "}"}]}], "]"}], "[", 
