  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Options", "[", "getSingularPoints2", "]"}], "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<diag\>\"", "->", "False"}], ",", 
       RowBox[{"\"\<workingPrecision\>\"", "->", "1000"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"getSingularPoints2", "[", 
      RowBox[{"$theFunction_", ",", 
       RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
