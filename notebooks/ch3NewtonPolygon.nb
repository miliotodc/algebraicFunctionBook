                    "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
                   RowBox[{"Print", "[", 
                    RowBox[{"\"\<     root position: \>\"", ",", "altPos"}], 
                    "]"}], ";", "\[IndentingNewLine]", 
                   RowBox[{"Print", "[", 
                    RowBox[{"\"\<     newX vals: \>\"", ",", 
                    RowBox[{
                    RowBox[{"newX", "[", 
                    RowBox[{"[", "altPos", "]"}], "]"}], "//", "N"}]}], "]"}],
                    ";", "\[IndentingNewLine]", 
                   RowBox[{"Print", "[", 
                    RowBox[{"\"\<     Prec of newX vals: \>\"", ",", 
                    RowBox[{"Precision", "@", 
                    RowBox[{"newX", "[", 
                    RowBox[{"[", "altPos", "]"}], "]"}]}]}], "]"}], ";"}]}], 
                 "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
                RowBox[{"(*", "\[IndentingNewLine]", " ", 
                 RowBox[{
                  RowBox[{
                  "now", " ", "replace", " ", "root", " ", "with", " ", 
                   "higher"}], "-", 
                  RowBox[{"precision", " ", "version"}]}], 
                 "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
                RowBox[{"(*", 
                 RowBox[{
                  RowBox[{"newRoot", "=", 
                   RowBox[{"newX", "[", 
                    RowBox[{"[", "rootPos", "]"}], "]"}]}], ";"}], "*)"}], 
                "\[IndentingNewLine]", 
                RowBox[{"newRoot", "=", 
                 RowBox[{"newX", "[", 
                  RowBox[{"[", "altPos", "]"}], "]"}]}], ";"}], 
               "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"newRoot", "=", 
                 RowBox[{"currentTally", "[", 
                  RowBox[{"[", "1", "]"}], "]"}]}], ";"}]}], 
              "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"AppendTo", "[", 
              RowBox[{"newRootArray", ",", 
               RowBox[{"{", 
                RowBox[{"newRoot", ",", "multiplicity"}], "}"}]}], "]"}], 
             ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"netArray", ",", "newRootArray"}], "]"}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       "netArray"}]}], "\[IndentingNewLine]", "]"}]}], ";"}]}]], "Input",
