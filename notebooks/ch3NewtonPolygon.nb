Cell[BoxData[{"baseSheetLinks", "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"branchTypes", "=", 
   RowBox[{"rootTestData", "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", "3"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"aTable", "=", 
   RowBox[{"Table", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"bIndex", "=", 
       RowBox[{"baseSheetLinks", "[", 
        RowBox[{"[", 
         RowBox[{"genIndex", ",", "2", ",", "1"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Table", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
