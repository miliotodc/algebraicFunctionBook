                  RowBox[{"x", "-", "minVal"}], "]"}], "<", 
                 RowBox[{"10", "^", 
                  RowBox[{"-", 
                   RowBox[{"(", 
                    RowBox[{
                    "theSolvePrec", "-", "$accuracyComparisonFactor"}], 
                    ")"}]}]}]}]}]}], "]"}]}], ";"}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"difArray", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"minVal", "-", "#"}], "]"}], "&"}], "/@", " ", 
            "myNextPoints"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"nextLocArray", "=", 
           RowBox[{"Position", "[", 
            RowBox[{"difArray", ",", 
             RowBox[{"Min", "@", "difArray"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "@", "nextLocArray"}], "!=", "1"}], ",", 
