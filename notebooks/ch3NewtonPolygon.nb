             RowBox[{"Position", "[", 
              RowBox[{"newX", ",", 
               RowBox[{"x_", "/;", 
                RowBox[{
                 RowBox[{"Abs", "[", 
                  RowBox[{"x", "-", 
                   RowBox[{"currentTally", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "<", 
                 RowBox[{"10", "^", 
                  RowBox[{"-", 
                   RowBox[{"(", 
                    RowBox[{"tallyRootAcc", "-", "20"}], ")"}]}]}]}]}]}], 
              "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<     root position: \>\"", ",", "rootPos"}], "]"}], 
           ";", "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<     newX vals: \>\"", ",", 
             RowBox[{
              RowBox[{"newX", "[", 
               RowBox[{"[", "rootPos", "]"}], "]"}], "//", "N"}]}], "]"}], 
           ";", "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<     Prec of newX vals: \>\"", ",", 
             RowBox[{"Precision", "@", "newX"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", "\[IndentingNewLine]", " ", 
            RowBox[{
             RowBox[{
             "now", " ", "replace", " ", "root", " ", "with", " ", "higher"}],
              "-", 
             RowBox[{"precision", " ", "version"}]}], "\[IndentingNewLine]", 
            "*)"}], "\[IndentingNewLine]", 
           RowBox[{"newRoot", "=", 
            RowBox[{"newX", "[", 
             RowBox[{"[", "rootPos", "]"}], "]"}]}], ";"}], 
          "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"newRoot", "=", 
            RowBox[{"currentTally", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ";"}]}], "\[IndentingNewLine]",
          "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"newRootArray", ",", 
          RowBox[{"{", 
           RowBox[{"newRoot", ",", "multiplicity"}], "}"}]}], "]"}], ";"}]}], 
      "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], 
  ";"}], "\[IndentingNewLine]", 
