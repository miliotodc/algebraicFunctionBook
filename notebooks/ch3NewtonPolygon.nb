Cell[CellGroupData[{

Cell["getNormalVals using Max[ord(an)-ord(ai)/(n-1)]", "Subsection",
 CellChangeTimes->{{3.9050722328771076`*^9, 3.9050722346893744`*^9}, {
  3.9051650614090443`*^9, 
  3.905165085997493*^9}},ExpressionUUID->"d72afd26-a1eb-438e-8c2e-\
49f3ab06e7bc"],

Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{
   RowBox[{"getNormalVals", "[", "$theFunction_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "wExp", ",", "functionDegree", ",", "wCoef", ",", "orderList", ",", 
       "theLambda", ",", "theMu", ",", "lambdaList", ",", "theReturn"}], 
      "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"wExp", "=", 
       RowBox[{"Exponent", "[", 
        RowBox[{"$theFunction", ",", "w", ",", "List"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"functionDegree", "=", 
       RowBox[{"Last", "@", "wExp"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"wCoef", "=", 
       RowBox[{"CoefficientRules", "[", 
        RowBox[{
        "$theFunction", ",", "w", ",", "\"\<NegativeLexicographic\>\""}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "@", "wCoef"}], "<", "3"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"Style", "[", 
           RowBox[{
           "\"\<Function needs more than three terms to use \
getNormalVals!\>\"", ",", "Red", ",", "Bold"}], "]"}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"theReturn", "=", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", 
            RowBox[{"-", "1"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"orderList", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", "1"}], "]"}], "]"}], ",", 
              RowBox[{
               RowBox[{"Exponent", "[", 
                RowBox[{
                 RowBox[{"#", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], ",", "z", ",", "List"}], 
                "]"}], "//", "First"}]}], "}"}], "&"}], "/@", " ", 
           "wCoef"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"\"\<orderList: \>\"", ",", 
             RowBox[{"orderList", "[", 
              RowBox[{"[", 
               RowBox[{"2", ";;", 
                RowBox[{"-", "2"}]}], "]"}], "]"}]}], "]"}], ";"}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"lambdaList", "=", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             FractionBox[
              RowBox[{
               RowBox[{"orderList", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"-", "1"}], ",", "2"}], "]"}], "]"}], "-", 
               RowBox[{"#", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], 
              RowBox[{
               RowBox[{"orderList", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"-", "1"}], ",", "1"}], "]"}], "]"}], "-", 
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}]], "&"}], "/@", " ", 
            RowBox[{"orderList", "[", 
             RowBox[{"[", 
              RowBox[{"2", ";;", 
               RowBox[{"-", "2"}]}], "]"}], "]"}]}], ")"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"\"\<Lambda list: \>\"", ",", "lambdaList"}], "]"}], 
           ";"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"theLambda", "=", 
          RowBox[{"Max", "[", 
           RowBox[{"Ceiling", "@", "lambdaList"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"theMu", "=", 
          RowBox[{
           RowBox[{"theLambda", " ", "functionDegree"}], "-", 
           RowBox[{"orderList", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"-", "1"}], ",", "2"}], "]"}], "]"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"theReturn", "=", 
          RowBox[{"{", 
           RowBox[{"theLambda", ",", "theMu"}], "}"}]}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      "theReturn"}]}], "\[IndentingNewLine]", "]"}]}]}]], "Input",
 CellChangeTimes->{{3.905072224191885*^9, 3.905072225644436*^9}, {
   3.905610328055468*^9, 3.9056103758721666`*^9}, {3.9056104323282266`*^9, 
   3.905610433468581*^9}, {3.9056757554303813`*^9, 3.9056757727702227`*^9}, {
   3.905676247401864*^9, 3.9056762800821495`*^9}, {3.905677778920895*^9, 
   3.9056779186847706`*^9}, {3.9057678779071617`*^9, 3.905767882531036*^9}, {
   3.905767986381446*^9, 3.905768015530565*^9}, {3.9521653812845287`*^9, 
   3.952165381293453*^9}, 3.9526072305731087`*^9},
 CellLabel->"In[51]:=",ExpressionUUID->"ff971d05-cfb0-4f9b-8148-46655726fb4e"]
}, Closed]],

Cell[CellGroupData[{

Cell["ConvertToNormalForm", "Subsection",
 CellChangeTimes->{{3.876734006497882*^9, 3.8767340122152953`*^9}, 
   3.8946176149708014`*^9},ExpressionUUID->"04fd5ffa-8d13-4e84-be06-\
4162d7b52eeb"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"convertToNormalForm", "[", "theF_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "wRules", ",", "wKeys", ",", "zRules", ",", "theOrders", ",", 
        "positiveOrders", ",", "fDegree", ",", "normalEqn", ",", 
        "normalConstraints", ",", "eqnA", ",", "i", ",", "minData", ",", 
        "currentmu", ",", "mylambda", ",", "thepoly", ",", "\[Mu]", ",", 
        "\[Lambda]", ",", "lVal", ",", "mVal"}], "}"}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", " ", 
      RowBox[{
       RowBox[{"wRules", "=", 
        RowBox[{"CoefficientRules", "[", 
         RowBox[{"theF", ",", "w", ",", "\"\<NegativeLexicographic\>\""}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"wKeys", "=", 
        RowBox[{"wRules", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"zRules", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "1"}], "]"}], "]"}], ",", 
            RowBox[{"CoefficientRules", "[", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}], ",", "z", ",", 
              "\"\<NegativeLexicographic\>\""}], "]"}]}], "}"}], "&"}], "/@", 
         " ", "wRules"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"theOrders", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{"#", "[", 
             RowBox[{"[", 
              RowBox[{"2", ",", "1", ",", "1", ",", "1"}], "]"}], "]"}]}], 
           "}"}], "&"}], "/@", " ", "zRules"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"positiveOrders", "=", 
        RowBox[{"Select", "[", 
         RowBox[{"theOrders", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ">", "0"}], "&"}]}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"fDegree", "=", 
        RowBox[{"Max", "@", 
         RowBox[{"Exponent", "[", 
          RowBox[{"theF", ",", "w", ",", "List"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"normalEqn", "=", 
        RowBox[{
         RowBox[{"\[Mu]", "+", 
          RowBox[{"positiveOrders", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"-", "1"}], ",", "2"}], "]"}], "]"}]}], "==", 
         RowBox[{"fDegree", " ", "\[Lambda]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"normalConstraints", "=", 
        RowBox[{"Table", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"eqnA", "=", 
            RowBox[{
             RowBox[{"\[Mu]", "+", 
              RowBox[{"positiveOrders", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "2"}], "]"}], "]"}]}], ">=", 
             RowBox[{
              RowBox[{"positiveOrders", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "1"}], "]"}], "]"}], " ", "\[Lambda]"}]}]}],
            ";", "\[IndentingNewLine]", "eqnA"}], ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{
             RowBox[{"Length", "[", "positiveOrders", "]"}], "-", "1"}]}], 
           "}"}]}], "\[IndentingNewLine]", "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"minData", "=", 
        RowBox[{"Minimize", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\[Lambda]", ",", 
            RowBox[{"normalEqn", " ", "&&", 
             RowBox[{"(", 
              RowBox[{"And", "@@", "normalConstraints"}], ")"}], "&&", " ", 
             RowBox[{"Element", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"\[Mu]", ",", "\[Lambda]"}], "}"}], ",", 
               "PositiveIntegers"}], "]"}]}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"\[Mu]", ",", "\[Lambda]"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"currentmu", ",", "mylambda"}], "}"}], "=", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\[Mu]", ",", "\[Lambda]"}], "}"}], "/.", 
         RowBox[{"minData", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"thepoly", "=", 
        RowBox[{"Expand", "[", 
         RowBox[{
          RowBox[{"z", "^", "currentmu"}], 
          RowBox[{"(", 
           RowBox[{"theF", "/.", 
            RowBox[{"w", "\[Rule]", 
             RowBox[{"w", "/", 
              RowBox[{"(", 
               RowBox[{"z", "^", "mylambda"}], ")"}]}]}]}], ")"}]}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{"$showNormalizedConstants", ",", "\[IndentingNewLine]", 
         RowBox[{"(*", "\[IndentingNewLine]", " ", 
          RowBox[{"now", " ", "check", " ", "against", " ", "getNormalVals"}],
           "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"\"\<the eta: \>\"", ",", "mylambda"}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<the mu: \>\"", ",", "currentmu"}], "]"}], ";"}]}], 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"lVal", ",", "mVal"}], "}"}], "=", 
           RowBox[{"getNormalVals", "[", "theF", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{
          "Print", "[", "\"\<Normal vals from getNormalVals:\>\"", "]"}], ";",
           "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<mu: \>\"", ",", "lVal"}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<eta:     \>\"", ",", "mVal"}], "]"}], ";"}], "*)"}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"thepoly", ",", "mylambda", ",", "currentmu"}], "}"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"convertToNormalForm2", "[", "theF_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "wRules", ",", "wKeys", ",", "zRules", ",", "theOrders", ",", 
        "positiveOrders", ",", "fDegree", ",", "normalEqn", ",", 
        "normalConstraints", ",", "eqnA", ",", "i", ",", "minData", ",", 
        "currentmu", ",", "mylambda", ",", "thepoly", ",", "\[Mu]", ",", 
        "\[Lambda]", ",", "lVal", ",", "mVal"}], "}"}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", " ", 
      RowBox[{
       RowBox[{"wRules", "=", 
        RowBox[{"CoefficientRules", "[", 
         RowBox[{"theF", ",", "w", ",", "\"\<NegativeLexicographic\>\""}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"wKeys", "=", 
        RowBox[{"wRules", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"zRules", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "1"}], "]"}], "]"}], ",", 
            RowBox[{"CoefficientRules", "[", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}], ",", "z", ",", 
              "\"\<NegativeLexicographic\>\""}], "]"}]}], "}"}], "&"}], "/@", 
         " ", "wRules"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"theOrders", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{"#", "[", 
             RowBox[{"[", 
              RowBox[{"2", ",", "1", ",", "1", ",", "1"}], "]"}], "]"}]}], 
           "}"}], "&"}], "/@", " ", "zRules"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"positiveOrders", "=", 
        RowBox[{"Select", "[", 
         RowBox[{"theOrders", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ">", "0"}], "&"}]}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"fDegree", "=", 
        RowBox[{"Max", "@", 
         RowBox[{"Exponent", "[", 
          RowBox[{"theF", ",", "w", ",", "List"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"normalEqn", "=", 
        RowBox[{
         RowBox[{"\[Mu]", "+", 
          RowBox[{"positiveOrders", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"-", "1"}], ",", "2"}], "]"}], "]"}]}], "==", 
         RowBox[{"fDegree", " ", "\[Lambda]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"normalConstraints", "=", 
        RowBox[{"Table", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"eqnA", "=", 
            RowBox[{
             RowBox[{"\[Mu]", "+", 
              RowBox[{"positiveOrders", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "2"}], "]"}], "]"}]}], ">=", 
             RowBox[{
              RowBox[{"positiveOrders", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "1"}], "]"}], "]"}], " ", "\[Lambda]"}]}]}],
            ";", "\[IndentingNewLine]", "eqnA"}], ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{
             RowBox[{"Length", "[", "positiveOrders", "]"}], "-", "1"}]}], 
           "}"}]}], "\[IndentingNewLine]", "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"minData", "=", 
        RowBox[{"Minimize", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\[Lambda]", ",", 
            RowBox[{"normalEqn", " ", "&&", 
             RowBox[{"(", 
              RowBox[{"And", "@@", "normalConstraints"}], ")"}], "&&", " ", 
             RowBox[{"Element", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"\[Mu]", ",", "\[Lambda]"}], "}"}], ",", 
               "PositiveIntegers"}], "]"}]}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"\[Mu]", ",", "\[Lambda]"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"currentmu", ",", "mylambda"}], "}"}], "=", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\[Mu]", ",", "\[Lambda]"}], "}"}], "/.", 
         RowBox[{"minData", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"\"\<the eta: \>\"", ",", "mylambda"}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{"\"\<the mu: \>\"", ",", "currentmu"}], "]"}], ";"}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"thepoly", "=", 
        RowBox[{"Expand", "[", 
         RowBox[{
          RowBox[{"z", "^", "currentmu"}], 
          RowBox[{"(", 
           RowBox[{"theF", "/.", 
            RowBox[{"w", "\[Rule]", 
             RowBox[{"w", "/", 
              RowBox[{"(", 
               RowBox[{"z", "^", "mylambda"}], ")"}]}]}]}], ")"}]}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"thepoly", ",", "mylambda", ",", "currentmu"}], "}"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.8896001819276114`*^9, 3.8896001981314096`*^9}, {
   3.894617465155517*^9, 3.894617470638792*^9}, {3.894687061603154*^9, 
   3.894687094611042*^9}, {3.8947839676742015`*^9, 3.894784048828723*^9}, {
   3.8947840824863825`*^9, 3.894784087625772*^9}, {3.8947844501339207`*^9, 
   3.894784617420576*^9}, {3.894784774589361*^9, 3.894784775214012*^9}, {
   3.894785464024268*^9, 3.8947854781613874`*^9}, {3.8948692646389823`*^9, 
   3.894869269340999*^9}, {3.8963793689114857`*^9, 3.8963793807053137`*^9}, 
   3.896444346875984*^9, {3.8976653997099915`*^9, 3.8976654042403603`*^9}, {
   3.899470017649645*^9, 3.8994700247259097`*^9}, {3.9050722747109785`*^9, 
