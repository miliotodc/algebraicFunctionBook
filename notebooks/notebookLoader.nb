Notebook[{
Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{
    "This", " ", "notebook", " ", "transfers", " ", "notebooks", " ", "from", 
     " ", "the", " ", "GitHub", " ", "repository", " ", "to", " ", "either", 
     " ", "a", " ", "default", " ", "directory", " ", "or", " ", "user"}], 
    "-", 
    RowBox[{"defined", " ", "directory"}]}], "\[IndentingNewLine]", "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "  ", 
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{"restore", " ", "classic", " ", 
    RowBox[{"brackets", " ", "[", 
     RowBox[{"[", "]"}], "]"}]}], "\[IndentingNewLine]", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"SetOptions", "[", 
    RowBox[{"$FrontEndSession", ",", 
     RowBox[{"BoxForm`UseScriptLevelPart", "->", "False"}]}], "]"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{"defaultProjectRoot", "=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{"$HomeDirectory", ",", "\"\<algebraicFunctions\>\""}], "}"}], 
      "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"choice", "=", 
     RowBox[{"ChoiceDialog", "[", 
      RowBox[{
       RowBox[{
       "\"\<Use default project folder?\\n\\n\>\"", "<>", 
        "\"\<Default location:\\n\>\"", "<>", "defaultProjectRoot"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\"\<Use Default\>\"", "->", "\"\<default\>\""}], ",", 
         RowBox[{
         "\"\<Choose drive or folder\[Ellipsis]\>\"", "->", 
          "\"\<choose\>\""}]}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"projectRoot", "=", "\"\<\>\""}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"choice", "===", "\"\<default\>\""}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"projectRoot", "=", "defaultProjectRoot"}], ";"}], 
      "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"iVal", "=", 
        RowBox[{"SystemDialogInput", "[", "\"\<Directory\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"iVal", "===", "$Canceled"}], ",", "\[IndentingNewLine]", 
         ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"projectRoot", "=", "iVal"}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"choice", "===", "\"\<default\>\""}], " ", ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{
        "\"\<Proceeding with default setup to \>\"", ",", "projectRoot"}], 
        "]"}], ";"}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"iVal", "===", "$Canceled"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", "\"\<Setup canceled\>\"", "]"}], ";"}], 
         "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"projectRoot", "=", 
           RowBox[{"FileNameJoin", "[", 
            RowBox[{"{", 
             RowBox[{"iVal", ",", "\"\<algebraicFunctions\>\""}], "}"}], 
            "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{
           "\"\<Proceeding with user-defined projectRoot: \>\"", ",", 
            "projectRoot"}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], 
       ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"projectRoot", "!=", "\"\<\>\""}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"safeProjectRoot", "=", 
        RowBox[{"StringReplace", "[", 
         RowBox[{"projectRoot", ",", 
          RowBox[{"\"\<\\\\\>\"", "->", "\"\</\>\""}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"4.", " ", "Define", " ", "subfolders"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"notebookDir", "=", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{"projectRoot", ",", "\"\<notebooks\>\""}], "}"}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"PDFDir", "=", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{"projectRoot", ",", "\"\<PDF\>\""}], "}"}], "]"}]}], ";", 
       "\n", 
       RowBox[{"dataDir", "=", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{"projectRoot", ",", "\"\<data\>\""}], "}"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\n", 
       RowBox[{"configFile", "=", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{"projectRoot", ",", "\"\<config.wl\>\""}], "}"}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{
        "\"\<Downloading configuration file: \>\"", ",", "configFile"}], 
        "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"safeProjectRoot", "=", 
        RowBox[{"StringReplace", "[", 
         RowBox[{"projectRoot", ",", 
          RowBox[{"\"\<\\\\\>\"", "->", "\"\</\>\""}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"Export", "[", 
        RowBox[{"configFile", ",", 
         RowBox[{
         "\"\<projectRoot = \\\"\>\"", "<>", "safeProjectRoot", "<>", 
          "\"\<\\\";\\n\>\"", "<>", 
          "\"\<notebookDir = FileNameJoin[{projectRoot, \
\\\"notebooks\\\"}];\\n\>\"", "<>", "\[IndentingNewLine]", 
          "\"\<PDFDir = FileNameJoin[{projectRoot, \\\"PDF\\\"}];\\n\>\"", "<>",
           "\[IndentingNewLine]", 
          "\"\<dataDir     = FileNameJoin[{projectRoot, \
\\\"data\\\"}];\>\""}], ",", "\"\<String\>\""}], "]"}], ";", 
       "\[IndentingNewLine]", "\n", "\n", 
       RowBox[{"(*", 
        RowBox[{
        "5.", " ", "Ensure", " ", "both", " ", "subdirectories", " ", 
         "exist"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"!", 
            RowBox[{"DirectoryQ", "[", "dir", "]"}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"CreateDirectory", "[", 
            RowBox[{"dir", ",", 
             RowBox[{"CreateIntermediateDirectories", "->", "True"}]}], 
            "]"}]}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"dir", ",", 
           RowBox[{"{", 
            RowBox[{"notebookDir", ",", "dataDir", ",", "PDFDir"}], "}"}]}], 
          "}"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       "\n", 
       RowBox[{"(*", 
        RowBox[{
        "6.", " ", "List", " ", "of", " ", "notebooks", " ", "to", " ", 
         "download"}], "*)"}], "\n", "\n", 
       RowBox[{"notebooks", "=", 
        RowBox[{"{", 
         RowBox[{
         "\"\<ch1Introduction.nb\>\"", ",", "\"\<ch2BranchPlots.nb\>\"", ",", 
          "\"\<ch3NewtonPolygon.nb\>\"", ",", "\"\<ch4ComparisonTests.nb\>\"",
           ",", "\"\<ch5CentralProfiles.nb\>\"", ",", 
          "\"\<ch6AnnularExpansions.nb\>\"", ",", 
          "\"\<ch7AnnularContinuations.nb\>\"", ",", 
          "\"\<ch8AnnularAccuracyProfiles.nb\>\"", ",", 
          "\"\<ch9AnnularProperties.nb\>\"", ",", 
          "\"\<ch10NewtonPolygonTypes.nb\>\"", ",", 
          "\"\<ch11FunctionGenus.nb\>\"", ",", "\"\<ch12ComplexBeta.nb\>\"", 
          ",", "\"\<ch12RationalBeta.nb\>\"", ",", 
          "\"\<ch12BranchLinks.nb\>\""}], "}"}]}], ";", "\[IndentingNewLine]",
        "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "7.", " ", "Download", " ", "each", " ", "notebook", " ", "from", " ",
          "GitHub"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{
           "\"\<Downloading \>\"", ",", "nb", ",", "\"\< to \>\"", ",", 
            "notebookDir"}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"URLDownload", "[", 
           RowBox[{
            RowBox[{
            "\"\<https://raw.githubusercontent.com/miliotodc/\
algebraicFunctionBook/main/notebooks/\>\"", "<>", "nb"}], ",", 
            RowBox[{"FileNameJoin", "[", 
             RowBox[{"{", 
              RowBox[{"notebookDir", ",", "nb"}], "}"}], "]"}]}], "]"}]}], 
         ",", 
         RowBox[{"{", 
          RowBox[{"nb", ",", "notebooks"}], "}"}]}], "]"}], ";"}]}], 
     "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Print", "[", "\"\<Download completed\>\"", "]"}], 
   "\[IndentingNewLine]"}]}]], "Input",
