   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"projectRoot", "!=", "\"\<\>\""}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"safeProjectRoot", "=", 
        RowBox[{"StringReplace", "[", 
         RowBox[{"projectRoot", ",", 
          RowBox[{"\"\<\\\\\>\"", "->", "\"\</\>\""}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"4.", " ", "Define", " ", "subfolders"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"notebookDir", "=", 
