Cell[BoxData[
 RowBox[{"\n", " ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Options", "[", "getBranchData", "]"}], "=", 
     RowBox[{"{", 
      RowBox[{"\"\<diag\>\"", "->", "False"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"getBranchData2", "[", 
      RowBox[{
      "currentSingularIndex_", ",", "mivTable_", ",", "branchNameArray_", ",",
        "currentSeries_", ",", "currentZStart_", ",", "currentWStart_", ",", 
       "tStart_", ",", "tEnd_", ",", 
       RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "contour", ",", "branchSol", ",", "zEnd", ",", "wEnd", ",", 
         "seriesResults", ",", "difTable", ",", "mivPSeriesIndex", ",", 
         "branchArrayPos", ",", "branchName", ",", " ", "mivSeriesRecord", 
         ",", "mivRootIndex", ",", "plotIndex", ",", "branchNamePos", ",", 
         "rootPosArray"}], "}"}], ",", "\[IndentingNewLine]", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"contour", "[", "t_", "]"}], ":=", 
         RowBox[{
          RowBox[{"currentZStart", 
           RowBox[{"(", 
            RowBox[{"1", "-", "t"}], ")"}]}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"theSingularList", "[", 
              RowBox[{"[", "currentSingularIndex", "]"}], "]"}], "+", 
             RowBox[{
              RowBox[{"minRadiusArray", "[", 
               RowBox[{"[", "currentSingularIndex", "]"}], "]"}], " ", 
              RowBox[{"Exp", "[", 
               RowBox[{"Pi", " ", 
                RowBox[{"I", "/", "6"}]}], "]"}]}]}], ")"}], " ", "t"}]}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"(*", "\[IndentingNewLine]", " ", 
         RowBox[{
         "integrate", " ", "to", " ", "mIVP", " ", "point", " ", "at", " ", 
          "this", " ", "singular", " ", "point", " ", "and", " ", "polish", 
          " ", "value"}], "\[IndentingNewLine]", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<currentWStart: \>\"", ",", "currentWStart"}], "]"}], 
        ";", "\[IndentingNewLine]", " ", 
        RowBox[{"branchSol", "=", 
         RowBox[{"ndSolveOverBranch", "[", 
          RowBox[{
          "contour", ",", "currentWStart", ",", "tStart", ",", "tEnd"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"zEnd", "=", 
         RowBox[{"contour", "[", "tEnd", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"wEnd", "=", "  ", 
         RowBox[{"polishValue", "[", 
          RowBox[{"zEnd", ",", 
           RowBox[{"branchSol", "[", "tEnd", "]"}], ",", "55"}], "]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"(*", "\[IndentingNewLine]", " ", 
         RowBox[{
         "determine", " ", "which", " ", "Puiseux", " ", "series", " ", 
          "blue", " ", "contour", " ", "lands", " ", "on", " ", "at", " ", 
          "mIVP", " ", "point"}], "\[IndentingNewLine]", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"seriesResults", "=", 
         RowBox[{"currentSeries", "/.", 
          RowBox[{"z", "->", 
           RowBox[{"(", 
            RowBox[{"zEnd", "-", 
             RowBox[{"theSingularList", "[", 
              RowBox[{"[", "currentSingularIndex", "]"}], "]"}]}], 
            ")"}]}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"difTable", "=", 
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"wEnd", "-", "#"}], "]"}], "&"}], "/@", " ", 
            "seriesResults"}], ",", "10"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"mivPSeriesIndex", "=", 
         RowBox[{
          RowBox[{"Position", "[", 
           RowBox[{"difTable", ",", 
            RowBox[{"Min", "@", "difTable"}]}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"OptionValue", "[", "\"\<diag\>\"", "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"\"\<mivPSeriesIndex: \>\"", ",", "mivPSeriesIndex"}], 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<Min dif: \>\"", ",", 
             RowBox[{"N", "[", 
              RowBox[{"difTable", "[", 
               RowBox[{"[", "mivPSeriesIndex", "]"}], "]"}], "]"}]}], "]"}], 
           ";"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", "\[IndentingNewLine]", " ", 
         RowBox[{
          RowBox[{
          "get", " ", "mIVP", " ", "root", " ", "associated", " ", "with", 
           " ", "this", " ", "series", " ", "index"}], " ", ","}], 
         "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"mivSeriesRecord", "=", 
         RowBox[{
          RowBox[{"Cases", "[", 
           RowBox[{"mivTable", ",", 
            RowBox[{"{", 
             RowBox[{"mivPSeriesIndex", ",", "_"}], "}"}], ",", "Infinity"}], 
           "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"mivRootIndex", "=", 
         RowBox[{"mivSeriesRecord", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"OptionValue", "[", "\"\<diag\>\"", "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{
            "\"\<mivRootIndex associated with this series: \>\"", ",", 
             "mivRootIndex"}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<mivTable: \>\"", ",", "mivTable"}], "]"}]}]}], 
         "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", "\[IndentingNewLine]", " ", 
         RowBox[{
         "get", " ", "branch", " ", "name", " ", "associated", " ", "with", 
          " ", "this", " ", "series"}], "\[IndentingNewLine]", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"branchArrayPos", "=", 
         RowBox[{
          RowBox[{"Position", "[", 
           RowBox[{
            RowBox[{"branchNameArray", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
            RowBox[{"x_", "/;", 
             RowBox[{"x", "==", "mivPSeriesIndex"}]}]}], "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"branchName", "=", 
         RowBox[{"branchNameArray", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"branchArrayPos", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", "1"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"rootPosArray", "=", 
         RowBox[{
          RowBox[{"Position", "[", 
           RowBox[{
            RowBox[{"mivTable", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "2", ",", "All", ",", "2"}], "]"}], "]"}], 
            ",", 
            RowBox[{"x_", "/;", 
             RowBox[{"x", "==", "mivRootIndex"}]}]}], "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"plotIndex", "=", 
         RowBox[{"rootPosArray", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
         "branchName", ",", "mivPSeriesIndex", ",", "mivRootIndex", ",", 
          "plotIndex"}], "}"}]}]}], "\[IndentingNewLine]", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}], ";"}], 
   "\[IndentingNewLine]"}]}]], "Input",
