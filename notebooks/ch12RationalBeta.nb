Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{
   RowBox[{
    RowBox[{"polishBranchTerms", "[", 
     RowBox[{"zVal_", ",", "terms_", ",", "maxErrorTolerance_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "wVals", ",", "polishedValues", ",", "difTable", ",", "pos", ",", 
        "wValsPrec", ",", "termsPrec"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"seriesValues", " ", 
        RowBox[{"format", ":", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"baseSeriesIndexK", ",", " ", "seriesValK"}], "}"}], 
            "..."}], 
           RowBox[{"{", 
            RowBox[{"baseSeriesIndexM", ",", "seriesValM"}], "}"}]}], 
          "}"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"termsPrec", "=", 
        RowBox[{"Floor", "@", 
         RowBox[{"Precision", "@", 
          RowBox[{"terms", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "2"}], "]"}], "]"}]}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"wVals", "=", 
        RowBox[{"w", "/.", 
         RowBox[{"NSolve", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"theFunction", "==", "0"}], "/.", 
            RowBox[{"z", "->", "zVal"}]}], ",", "w", ",", 
           RowBox[{"WorkingPrecision", "->", "termsPrec"}]}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"polishedValues", "=", 
        RowBox[{"Table", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"difTable", "=", 
            RowBox[{
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{
                RowBox[{"terms", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", "3"}], "]"}], "]"}], "-", "#"}], "]"}], 
              "&"}], "/@", " ", "wVals"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"pos", "=", 
            RowBox[{
             RowBox[{"Position", "[", 
              RowBox[{"difTable", ",", 
               RowBox[{"Min", "@", "difTable"}]}], "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{"difTable", "[", 
                RowBox[{"[", "pos", "]"}], "]"}], "]"}], ">", 
              RowBox[{"10", "^", 
               RowBox[{"(", 
                RowBox[{"-", "maxErrorTolerance"}], ")"}]}]}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Print", "[", 
               RowBox[{"Style", "[", 
                RowBox[{
                "\"\<polishTerms error below $maxErrorTolerance: \>\"", ",", 
                 "Red", ",", "Bold", ",", "14"}], "]"}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"Print", "[", 
               RowBox[{"\"\<     difTable: \>\"", ",", 
                RowBox[{"difTable", "//", "N"}]}], "]"}], ";"}]}], 
            "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"terms", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", 
             RowBox[{"terms", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "2"}], "]"}], "]"}], ",", 
             RowBox[{"wVals", "[", 
              RowBox[{"[", "pos", "]"}], "]"}]}], "}"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{"Length", "@", "terms"}]}], "}"}]}], 
         "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"return", ":", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"seriesIndexK", ",", "polishedValK"}], "}"}], "..."}], 
           RowBox[{"{", 
            RowBox[{"seriesIndexM", ",", "polishedValM"}], "}"}]}], "}"}]}], 
        " ", "*)"}], "\[IndentingNewLine]", "polishedValues"}]}], 
     "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.929114884030032*^9, 3.929114884436383*^9}, {
  3.929115110430355*^9, 3.929115110821054*^9}},
