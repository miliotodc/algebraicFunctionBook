     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"zStart", "=", 
       RowBox[{"contourF", "[", "tStart", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"wStart", "=", "  ", 
       RowBox[{"polishValue", "[", 
        RowBox[{"zStart", ",", 
         RowBox[{"contourTrace", "[", "tStart", "]"}], ",", "55"}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"(*", "\[IndentingNewLine]", " ", 
       RowBox[{
       "determine", " ", "which", " ", "Puiseux", " ", "series", " ", 
        "wStart", " ", "lands", " ", "on", " ", "at", " ", "mIVP", " ", 
        "point"}], "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"seriesResults", "=", 
       RowBox[{"series", "/.", 
        RowBox[{"z", "->", 
         RowBox[{"(", 
          RowBox[{"zStart", "-", 
           RowBox[{"theSingularList", "[", 
            RowBox[{"[", "singularIndex", "]"}], "]"}]}], ")"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"difTable", "=", 
