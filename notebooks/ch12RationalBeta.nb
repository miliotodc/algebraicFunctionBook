Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{"next", ",", " ", 
    RowBox[{
    "generate", " ", "medial", " ", "contour", " ", "for", " ", "branch", " ",
      "expansions"}]}], "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"tStart", "=", 
     RowBox[{"Pi", "/", "2"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tEnd", "=", 
     RowBox[{"5", " ", 
      RowBox[{"Pi", "/", "2"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rVal", "=", 
     RowBox[{"3", "/", "2"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"zStart", "=", 
     RowBox[{"rVal", " ", 
      RowBox[{"Exp", "[", 
       RowBox[{"\[ImaginaryI]", " ", "tStart"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"theZ", "[", "t_", "]"}], ":=", 
     RowBox[{
      RowBox[{"1", "/", "4"}], "+", 
      RowBox[{"rVal", " ", 
       RowBox[{"Exp", "[", 
        RowBox[{"I", " ", "t"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wDeriv", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"w", "'"}], "[", "t", "]"}], "\[Equal]", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            FractionBox[
             RowBox[{"D", "[", 
              RowBox[{"theFunction", ",", "z"}], "]"}], 
             RowBox[{"D", "[", 
              RowBox[{"theFunction", ",", "w"}], "]"}]], ")"}]}], " ", 
          RowBox[{"(", 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"theZ", "[", "t", "]"}], ",", "t"}], "]"}], ")"}]}], 
         ")"}], "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"w", "\[Rule]", 
           RowBox[{"w", "[", "t", "]"}]}], ",", 
          RowBox[{"z", "\[Rule]", 
           RowBox[{"theZ", "[", "t", "]"}]}]}], "}"}]}], ")"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"solF", "=", 
     RowBox[{"NDSolveValue", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"wDeriv", ",", 
         RowBox[{
          RowBox[{"w", "[", "tStart", "]"}], "\[Equal]", "branchW0"}]}], 
        "}"}], ",", "w", ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "tStart", ",", "tEnd"}], "}"}], ",", 
       RowBox[{"MaxStepSize", "\[Rule]", "500"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"solPlot", "=", 
     RowBox[{"ParametricPlot3D", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Re", "@", "z"}], ",", 
          RowBox[{"Im", "@", "z"}], ",", 
          RowBox[{"Re", "@", 
           RowBox[{"solF", "[", "t", "]"}]}]}], "}"}], "/.", 
        RowBox[{"z", "->", 
         RowBox[{"theZ", "[", "t", "]"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "tStart", ",", "tEnd"}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", "Yellow"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", " ", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{"now", " ", "define", " ", "a_", 
     RowBox[{"{", 
      RowBox[{"-", "1"}], "}"}], " ", 
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", "Pi", " ", "i"}], ")"}]}], " ", "Integral", " ", 
     "of", " ", 
     RowBox[{"solF", "[", "t", "]"}], 
     RowBox[{"d", "/", "dt"}], " ", "C", 
     RowBox[{"(", "t", ")"}], "dt"}], "\[IndentingNewLine]", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"intVal", "=", 
    RowBox[{"NIntegrate", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"solF", "[", "t", "]"}], " ", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"theZ", "[", "t", "]"}], ",", "t"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "tStart", ",", "tEnd"}], "}"}]}], "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   FractionBox["intVal", 
    RowBox[{
     RowBox[{"Exp", "[", 
      RowBox[{"2", " ", "Pi", " ", "I", 
       RowBox[{"(", 
        RowBox[{"theP", "/", "theQ"}], ")"}]}], "]"}], "-", "1"}]], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Beta", "[", 
     RowBox[{
      RowBox[{"1", "+", 
