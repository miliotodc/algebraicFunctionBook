        RowBox[{"(", 
         RowBox[{
          RowBox[{"Arg", "[", 
           RowBox[{"1", "-", "z"}], "]"}], "+", 
          RowBox[{"2", " ", "k", " ", "Pi"}]}], ")"}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"radicalF", "[", "z_", "]"}], ":=", 
     RowBox[{"G", "[", "z", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"implicitF", "[", 
