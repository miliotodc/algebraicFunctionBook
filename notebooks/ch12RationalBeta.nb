Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
   "now", " ", "integrate", " ", "from", " ", "mrp", " ", "to", " ", "point", 
    " ", "A"}], "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"crossLinkTablePosition", "=", 
    RowBox[{
     RowBox[{"Position", "[", 
      RowBox[{"crossLinkTable", ",", 
       RowBox[{"{", 
        RowBox[{"wJ", ",", "wK", ",", "___"}], "}"}]}], "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<crossLinkTableEntry: \>\"", ",", 
      RowBox[{"crossLinkTable", "[", 
       RowBox[{"[", 
        RowBox[{"Sequence", "@@", "crossLinkTablePosition"}], "]"}], "]"}]}], 
     "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"branchFactor", "=", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{"2", " ", "wJ", " ", "Pi", " ", "I", 
        RowBox[{"(", "theAlpha", ")"}]}], "]"}], " ", 
      RowBox[{"Exp", "[", 
       RowBox[{"2", " ", "wK", " ", "Pi", " ", "I", 
        RowBox[{"(", "theBeta", ")"}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<branchFactor: \>\"", ",", "branchFactor"}], "]"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{"w0", "=", 
     RowBox[{"H", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"1", "/", "3"}], " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"Pi", " ", 
          RowBox[{"I", "/", "6"}]}], "]"}]}], ",", "wJ", ",", "wK"}], "]"}]}],
     ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"mrpPath", "[", "t_", "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"1", "/", "3"}], " ", 
       RowBox[{"Exp", "[", 
        RowBox[{"Pi", " ", 
         RowBox[{"I", "/", "6"}]}], "]"}], 
       RowBox[{"(", 
        RowBox[{"1", "-", "t"}], ")"}]}], "+", 
      RowBox[{"pocR2", " ", "I", " ", "t"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wDeriv", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"w", "'"}], "[", "t", "]"}], "\[Equal]", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            FractionBox[
             RowBox[{"D", "[", 
              RowBox[{"theFunction", ",", "z"}], "]"}], 
             RowBox[{"D", "[", 
              RowBox[{"theFunction", ",", "w"}], "]"}]], ")"}]}], " ", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"mrpPath", "[", "t", "]"}], ",", "t"}], "]"}]}], ")"}], "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"w", "\[Rule]", 
           RowBox[{"w", "[", "t", "]"}]}], ",", 
          RowBox[{"z", "\[Rule]", 
           RowBox[{"mrpPath", "[", "t", "]"}]}]}], "}"}]}], ")"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"mrpSol", "=", 
     RowBox[{"NDSolveValue", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"wDeriv", ",", 
         RowBox[{
          RowBox[{"w", "[", "0", "]"}], "\[Equal]", "w0"}]}], "}"}], ",", "w",
        ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "1"}], "}"}], ",", 
       RowBox[{"WorkingPrecision", "->", "50"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"pointAValue", "=", 
    RowBox[{"mrpSol", "[", "1", "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wList2", "=", 
     RowBox[{"NSolveValues", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"theFunction", "==", "0"}], "/.", 
        RowBox[{"z", "->", 
         RowBox[{"pocR2", " ", "I"}]}]}], ",", "w", ",", 
       RowBox[{"WorkingPrecision", "->", "50"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"wList2", "//", "N"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"difTable2", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"#", "-", "pointAValue"}], "]"}], "&"}], "/@", " ", 
      "wList2"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"index2", "=", 
    RowBox[{
     RowBox[{"Position", "[", 
      RowBox[{"difTable2", ",", 
       RowBox[{"Min", "@", "difTable2"}]}], "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"1", ",", "1"}], "]"}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{"principalBranchAtA", "=", 
    RowBox[{"wList2", "[", 
     RowBox[{"[", "index2", "]"}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{
    "index2", " ", "now", " ", "has", " ", "starting", " ", "w0", " ", "for", 
     " ", "principal", " ", "branch"}], "\[IndentingNewLine]", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Precision", "@", "principalBranchAtA"}], 
   "\[IndentingNewLine]"}]}]], "Input",
