Cell[CellGroupData[{

Cell["Notebook Section 5:  Create cross-link table", "Section",
 CellChangeTimes->{{3.9501913834857674`*^9, 3.9501913992290287`*^9}, {
  3.950950025503091*^9, 3.950950045451892*^9}, {3.9714186930749483`*^9, 
  3.9714187000941343`*^9}, {3.9714439673099403`*^9, 3.9714439740917253`*^9}, {
  3.9716064580523605`*^9, 3.9716064620365634`*^9}, {3.9751499049691005`*^9, 
  3.975149907168511*^9}, {3.9897480965417976`*^9, 
  3.98974809691182*^9}},ExpressionUUID->"f170526e-4c73-489c-81b4-\
ebe6294ef865"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{"automatic", " ", "version"}], " ", "\[IndentingNewLine]", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"seriesResults", "=", 
     RowBox[{"zeroBaseSeries", "/.", 
      RowBox[{"z", "->", 
       RowBox[{"pocR2", " ", "I"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"totalBranches", "=", 
    RowBox[{"functionDegree", "/", "theQ"}]}], "\[IndentingNewLine]", 
   RowBox[{"branchSize", "=", "theQ"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"crossLinkTable", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"wStart", "=", 
         RowBox[{"H", "[", 
          RowBox[{
           RowBox[{"pocR2", " ", "I"}], ",", "wJ", ",", "wK"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"difTable", "=", 
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"wStart", "-", "#"}], "]"}], "&"}], "/@", " ", 
            "seriesResults"}], ",", "10"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"posArray", "=", 
         RowBox[{"Position", "[", 
          RowBox[{"difTable", ",", 
           RowBox[{"Min", "@", "difTable"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"mivPSeriesIndex", "=", 
         RowBox[{"posArray", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", "\[IndentingNewLine]", " ", 
         RowBox[{
          RowBox[{
          "get", " ", "mIVP", " ", "root", " ", "associated", " ", "with", 
           " ", "this", " ", "series", " ", "index"}], " ", ","}], 
         "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"mivTableIndex", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Position", "[", 
             RowBox[{"zeroMIVTable", ",", 
              RowBox[{"{", 
               RowBox[{"mivPSeriesIndex", ",", "_"}], "}"}]}], "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}], ")"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"monodromy", "=", 
         RowBox[{"zeroMIVTable", "[", 
          RowBox[{"[", 
           RowBox[{"mivTableIndex", ",", "2", ",", "All", ",", "2"}], "]"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"mivSeriesRecord", "=", 
         RowBox[{
          RowBox[{"Cases", "[", 
           RowBox[{"zeroMIVTable", ",", 
            RowBox[{"{", 
             RowBox[{"mivPSeriesIndex", ",", "_"}], "}"}], ",", "Infinity"}], 
           "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Print", "[", 
          RowBox[{"\"\<mivSeriesRecord: \>\"", ",", "mivSeriesRecord"}], 
          "]"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"mivRootIndex", "=", 
         RowBox[{"mivSeriesRecord", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", "\[IndentingNewLine]", " ", 
         RowBox[{
         "get", " ", "branch", " ", "name", " ", "associated", " ", "with", 
          " ", "this", " ", "series"}], " ", "\[IndentingNewLine]", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"branchArrayPos", "=", 
         RowBox[{
          RowBox[{"Position", "[", 
           RowBox[{
            RowBox[{"zeroBranchTypeArray", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
            RowBox[{"x_", "/;", 
             RowBox[{"x", "==", "mivPSeriesIndex"}]}]}], "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"branchName", "=", 
         RowBox[{"zeroBranchTypeArray", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"branchArrayPos", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", "1"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"rootPosArray", "=", 
         RowBox[{
          RowBox[{"Position", "[", 
           RowBox[{
            RowBox[{"zeroMIVTable", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "2", ",", "All", ",", "2"}], "]"}], "]"}], 
            ",", 
            RowBox[{"x_", "/;", 
             RowBox[{"x", "==", "mivRootIndex"}]}]}], "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
