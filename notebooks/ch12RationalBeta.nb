Cell["ndSolveOverBranch", "Subsection",
 CellChangeTimes->{{3.949248175655219*^9, 
  3.9492481785341606`*^9}},ExpressionUUID->"cb8c7076-a49c-4a3f-ae3e-\
4d1c0dacda49"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Options", "[", "ndSolveOverBranch", "]"}], "=", 
     RowBox[{"{", 
      RowBox[{"\"\<stiffnessSwitching\>\"", "->", "False"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{"ndSolveOverBranch", "[", 
     RowBox[{"contour_", ",", "wStart_", ",", "tStart_", ",", "tEnd_", ",", 
      RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "wDeriv", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"wDeriv", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"w", "'"}], "[", "t", "]"}], "\[Equal]", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", 
              RowBox[{"(", 
               FractionBox[
                RowBox[{"D", "[", 
                 RowBox[{"theFunction", ",", "z"}], "]"}], 
                RowBox[{"D", "[", 
                 RowBox[{"theFunction", ",", "w"}], "]"}]], ")"}]}], " ", 
             RowBox[{"(", 
              RowBox[{"D", "[", 
               RowBox[{
                RowBox[{"contour", "[", "t", "]"}], ",", "t"}], "]"}], 
              ")"}]}], ")"}], "/.", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"w", "\[Rule]", 
              RowBox[{"w", "[", "t", "]"}]}], ",", 
             RowBox[{"z", "\[Rule]", 
              RowBox[{"contour", "[", "t", "]"}]}]}], "}"}]}], ")"}]}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"OptionValue", "[", "\"\<stiffnessSwitching\>\"", "]"}], ",",
          "\[IndentingNewLine]", 
         RowBox[{"NDSolveValue", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"wDeriv", ",", 
             RowBox[{
              RowBox[{"w", "[", "tStart", "]"}], "\[Equal]", "wStart"}]}], 
            "}"}], ",", "w", ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", "tStart", ",", "tEnd"}], "}"}], ",", 
           RowBox[{"MaxSteps", "\[Rule]", "1000000"}], ",", 
           RowBox[{"MaxStepSize", "\[Rule]", 
            RowBox[{"1", "/", "1000"}]}], ",", 
           RowBox[{"PrecisionGoal", "->", "55"}], ",", 
           RowBox[{"WorkingPrecision", "->", "50"}], ",", 
           RowBox[{"Method", "->", "\"\<StiffnessSwitching\>\""}]}], "]"}], 
         "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
         RowBox[{"NDSolveValue", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"wDeriv", ",", 
             RowBox[{
              RowBox[{"w", "[", "tStart", "]"}], "\[Equal]", "wStart"}]}], 
            "}"}], ",", "w", ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", "tStart", ",", "tEnd"}], "}"}], ",", 
           RowBox[{"MaxSteps", "\[Rule]", "1000000"}], ",", 
           RowBox[{"MaxStepSize", "\[Rule]", 
            RowBox[{"1", "/", "1000"}]}], ",", 
           RowBox[{"PrecisionGoal", "->", "55"}], ",", 
           RowBox[{"WorkingPrecision", "->", "50"}]}], "]"}]}], 
        "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", "]"}]}], 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.9492367622163615`*^9, 3.9492367635874434`*^9}, {
