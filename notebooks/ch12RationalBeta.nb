Cell[CellGroupData[{

Cell["Notebook Section 4:  Create general Pochhammer contour ", "Section",
 CellChangeTimes->{{3.950343834585603*^9, 3.9503438410775733`*^9}, 
   3.950344400105214*^9, {3.950944188255266*^9, 3.950944195653516*^9}, {
   3.950948134445342*^9, 3.9509481555595837`*^9}, 3.950948562327368*^9, {
   3.9509494492267523`*^9, 3.9509494517676744`*^9}, {3.950949544406133*^9, 
   3.950949545337508*^9}, {3.971604012382448*^9, 3.971604016267197*^9}, {
   3.9832572052750072`*^9, 
   3.9832572056764684`*^9}},ExpressionUUID->"3dfa662f-8683-4ede-83a8-\
0ab3a6574155"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"(*", "\[IndentingNewLine]", "  ", 
   RowBox[{"general", " ", "pochhammer", " ", "contour"}], 
   "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"contourArray", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"pocR1", "=", 
    RowBox[{"1", "/", "6"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pocR2", "=", 
     RowBox[{"5", "/", "16"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{"do", " ", "blue", " ", "contour"}], "\[IndentingNewLine]", 
    "*)"}], "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"blueContourF", "[", "t_", "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"pocR2", " ", "I"}], ")"}], 
       RowBox[{"(", 
        RowBox[{"1", "-", "t"}], ")"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"pocR2", " ", "I"}]}], ")"}], " ", "t"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"blueStartT", "=", "0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"blueEndT", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"blueArrowG", "=", 
     RowBox[{"Graphics", "@", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Arrowheads", "[", "0.025", "]"}], ",", 
        RowBox[{"Arrow", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"ReIm", "@", 
            RowBox[{"blueContourF", "[", "0.1", "]"}]}], ",", 
           RowBox[{"ReIm", "@", 
            RowBox[{"blueContourF", "[", "0.15", "]"}]}]}], "}"}], "]"}]}], 
       "}"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"blueContourPlot", "=", 
     RowBox[{"ParametricPlot", "[", 
      RowBox[{
       RowBox[{"ReIm", "@", 
        RowBox[{"blueContourF", "[", "t", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "blueStartT", ",", "blueEndT"}], "}"}], ",", 
       RowBox[{"AxesOrigin", "->", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}]}], ",", 
       RowBox[{"PlotRange", "->", "1.5"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Thickness", "[", "0.0025", "]"}], ",", "Blue"}], "}"}]}]}],
       "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"AppendTo", "[", 
     RowBox[{"contourArray", ",", 
      RowBox[{"{", 
       RowBox[{"blueContourF", ",", "blueStartT", ",", "blueEndT"}], "}"}]}], 
     "]"}], ";"}], "\[IndentingNewLine]", "  ", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{"do", " ", "purple", " ", "contour"}], "\[IndentingNewLine]", 
    "*)"}], "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"purpleContourF", "[", "t_", "]"}], ":=", 
     RowBox[{"1", "+", 
      RowBox[{"pocR2", " ", 
       RowBox[{"Exp", "[", 
        RowBox[{"I", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Pi", "/", "2"}], 
            RowBox[{"(", 
             RowBox[{"1", "-", "t"}], ")"}]}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "Pi"}], "/", "2"}], ")"}], " ", "t"}]}], ")"}]}], 
        "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"purpleStartT", "=", "0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"purpleEndT", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"purpleContourPlot", "=", 
     RowBox[{"ParametricPlot", "[", 
      RowBox[{
       RowBox[{"ReIm", "@", 
        RowBox[{"purpleContourF", "[", "t", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "purpleStartT", ",", "purpleEndT"}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Thickness", "[", "0.0025", "]"}], ",", "Purple"}], "}"}]}],
        ",", 
       RowBox[{"PlotRange", "->", "2"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", " ", 
   RowBox[{"(*", " ", "\[IndentingNewLine]", " ", 
    RowBox[{"green", " ", "contour"}], "\[IndentingNewLine]", "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"greenStartT", "=", "0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"greenEndT", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"greenContourF", "[", "t_", "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"pocR2", " ", "I"}]}], ")"}], 
       RowBox[{"(", 
        RowBox[{"1", "-", "t"}], ")"}]}], "+", 
      RowBox[{"pocR1", " ", "I", " ", "t"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"greenArrowG", "=", 
     RowBox[{"Graphics", "@", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Arrowheads", "[", "0.025", "]"}], ",", 
        RowBox[{"Arrow", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"ReIm", "@", 
            RowBox[{"greenContourF", "[", "0.1", "]"}]}], ",", 
