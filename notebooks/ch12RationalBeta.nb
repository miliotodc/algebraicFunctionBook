Cell["integratePochhammer", "Subsection",
 CellChangeTimes->{{3.9492481554624195`*^9, 
  3.949248158678441*^9}},ExpressionUUID->"6c659819-3a3b-4dd2-94e1-\
f4395c1392c5"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Options", "[", "integratePochhammer", "]"}], "=", 
     RowBox[{"{", 
      RowBox[{"\"\<stiffnessSwitching\>\"", "->", "False"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{"integratePochhammer", "[", 
     RowBox[{"contourF_", ",", "startT_", ",", "endT_", ",", "startW_", ",", 
      RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "startZ", ",", "contourTraceF", ",", "endW", ",", "endZ", ",", 
        "intVal", ",", "polishedEndW"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"startZ", "=", 
        RowBox[{"contourF", "[", "startT", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"contourTraceF", "=", 
        RowBox[{"ndSolveOverBranch", "[", 
         RowBox[{"contourF", ",", "startW", ",", "startT", ",", "endT", ",", 
          RowBox[{"\"\<stiffnessSwitching\>\"", "->", 
           RowBox[{
           "OptionValue", "[", "\"\<stiffnessSwitching\>\"", "]"}]}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"\"\< precision of contourTraceF: \>\"", ",", 
           RowBox[{"Precision", "@", 
            RowBox[{"contourTraceF", "[", "t", "]"}]}]}], "]"}], ";"}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"startZ", "=", 
        RowBox[{"contourF", "[", "startT", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"endZ", "=", 
        RowBox[{"contourF", "[", "endT", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"endW", "=", 
        RowBox[{"contourTraceF", "[", "endT", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"intVal", "=", 
        RowBox[{"NIntegrate", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"contourTraceF", "[", "t", "]"}], " ", 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"contourF", "[", "t", "]"}], ",", "t"}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "startT", ",", "endT"}], "}"}], ",", 
          RowBox[{"WorkingPrecision", "->", "20"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"polishedEndW", "=", 
        RowBox[{"polishValue", "[", 
         RowBox[{"endZ", ",", "endW", ",", "75"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"intVal", ",", "polishedEndW", ",", "contourTraceF"}], 
        "}"}]}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
     "]"}]}]}]}]], "Input",
