Cell[CellGroupData[{

Cell["\<\
Section 7:  Integrate over Pochhammer contour and create branchLinkTable\
\>", "Section",
 CellChangeTimes->{{3.9715432608877497`*^9, 3.971543266751377*^9}, {
  3.9716065646368666`*^9, 3.9716065685158567`*^9}, {3.971606663544446*^9, 
  3.971606667073671*^9}, {3.9897481497098193`*^9, 
  3.989748153280938*^9}},ExpressionUUID->"b60494f7-07f8-4749-95e4-\
98fe6503a0a4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{"Integrate", " ", "over", " ", "Pochhammer", " ", "contour"}], 
   "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"branchLinkTable", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"$stiffnessFlag", "=", "True"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wBlueStart", "=", "principalBranchAtA"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"blueContourF", "[", "t_", "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"pocR2", " ", "I"}], ")"}], 
       RowBox[{"(", 
        RowBox[{"1", "-", "t"}], ")"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"pocR2", " ", "I"}]}], ")"}], " ", "t"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"blueStartT", "=", "0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"blueEndT", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Integrating blue contour\>\"", "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"blueInt", ",", "bluePolishedEndW", ",", "blueTraceF"}], "}"}], 
     "=", 
     RowBox[{"integratePochhammer", "[", 
      RowBox[{"blueContourF", ",", "0", ",", "1", ",", "wBlueStart", ",", 
       RowBox[{"\"\<stiffnessSwitching\>\"", "->", "$stiffnessFlag"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{
    "get", " ", "branch", " ", "data", " ", "at", " ", "point", " ", "A"}], 
    "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "branchName", ",", "mivPSeriesIndex", ",", "mivRootIndex", ",", 
       "bluePlotIndex"}], "}"}], "=", 
     RowBox[{"getBranchData", "[", 
      RowBox[{
      "1", ",", "blueTraceF", ",", "blueContourF", ",", "zeroMIVTable", ",", 
       "zeroBranchTypeArray", ",", "zeroBaseSeries", ",", "blueStartT", ",", 
       "blueEndT"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"AppendTo", "[", 
     RowBox[{"branchLinkTable", ",", " ", 
      RowBox[{"{", 
       RowBox[{
       "\"\<A\>\"", ",", "\"\<\!\(\*SubscriptBox[\(s\), \(1\)]\)\>\"", ",", 
        "branchName", ",", "mivPSeriesIndex", ",", "mivRootIndex", ",", 
        "bluePlotIndex"}], "}"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{"plot", " ", "solution", " ", "trace"}], "\[IndentingNewLine]", 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"blueTrace", "=", 
     RowBox[{"ParametricPlot3D", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Re", "@", "z"}], ",", 
          RowBox[{"Im", "@", "z"}], ",", 
          RowBox[{"$reim", "@", 
           RowBox[{"blueTraceF", "[", "t", "]"}]}]}], "}"}], "/.", 
        RowBox[{"z", "->", 
         RowBox[{"blueContourF", "[", "t", "]"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "blueStartT", ",", "blueEndT"}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Thickness", "[", "0.0055", "]"}], ",", "Blue"}], "}"}]}]}],
       "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{"do", " ", "purple", " ", "contour"}], "\[IndentingNewLine]", 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"purpleContourF", "[", "t_", "]"}], ":=", 
