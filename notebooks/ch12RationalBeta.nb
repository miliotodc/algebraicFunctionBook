Cell["polishValues", "Subsection",
 CellChangeTimes->{{3.9492481274557424`*^9, 
  3.9492481291350513`*^9}},ExpressionUUID->"0cc4c41c-1b02-4a99-aa8b-\
a51beb0b8717"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"polishValue", "[", 
      RowBox[{"zVal_", ",", "wVal_", ",", "wp_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"wTemp", ",", "difArray", ",", "wPos", ",", "eqnPrecision"}], 
        "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"eqnPrecision", "=", 
         RowBox[{"Floor", "@", 
          RowBox[{"Precision", "@", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"theFunction", "==", "0"}], "/.", 
             RowBox[{"z", "->", "zVal"}]}], ")"}]}]}]}], ";", 
        "\[IndentingNewLine]", " ", 
        RowBox[{"wTemp", "=", 
         RowBox[{"w", "/.", 
          RowBox[{"NSolve", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"theFunction", "==", "0"}], "/.", 
             RowBox[{"z", "->", "zVal"}]}], ",", "w", ",", 
            RowBox[{"WorkingPrecision", "->", "eqnPrecision"}]}], "]"}]}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"difArray", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"wVal", "-", "#"}], "]"}], "&"}], "/@", " ", "wTemp"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"wPos", "=", 
         RowBox[{
          RowBox[{"Position", "[", 
           RowBox[{"difArray", ",", 
            RowBox[{"Min", "@", "difArray"}]}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"difArray", "[", 
            RowBox[{"[", "wPos", "]"}], "]"}], ">", 
           RowBox[{"10", "^", 
            RowBox[{"-", "6"}]}]}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"Style", "[", 
             RowBox[{"\"\<polishValue: min dif array>10^-9\>\"", ",", "Red"}],
              "]"}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<difArray: \>\"", ",", 
             RowBox[{"difArray", "//", "N"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<  minDif: \>\"", ",", 
             RowBox[{"N", "[", 
              RowBox[{
               RowBox[{"difArray", "[", 
                RowBox[{"[", "wPos", "]"}], "]"}], ",", "10"}], "]"}]}], 
            "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"wTemp", "[", 
         RowBox[{"[", "wPos", "]"}], "]"}]}]}], "\[IndentingNewLine]", 
      "]"}]}], ";"}], "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.949246093509333*^9, 3.9492460946634593`*^9}, {
