        RowBox[{"theP", "/", "theQ"}], ")"}]}], " ", 
      RowBox[{"Exp", "[", 
       RowBox[{"theP", " ", 
        RowBox[{"I", "/", "theQ"}], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Arg", "[", "z", "]"}], "+", 
          RowBox[{"2", " ", "j", " ", "Pi"}]}], ")"}]}], "]"}], " ", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"1", "-", "z"}], "]"}], "^", 
       RowBox[{"(", 
        RowBox[{"theR", "/", "theS"}], ")"}]}], " ", 
      RowBox[{"Exp", "[", 
