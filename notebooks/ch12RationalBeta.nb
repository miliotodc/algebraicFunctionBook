Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{"next", ",", " ", 
    RowBox[{
    "generate", " ", "medial", " ", "contour", " ", "for", " ", "branch", " ",
      "expansions"}]}], "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"tStart", "=", 
     RowBox[{"Pi", "/", "2"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tEnd", "=", 
     RowBox[{"5", " ", 
      RowBox[{"Pi", "/", "2"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rVal", "=", 
     RowBox[{"3", "/", "2"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"zStart", "=", 
     RowBox[{"rVal", " ", 
      RowBox[{"Exp", "[", 
       RowBox[{"\[ImaginaryI]", " ", "tStart"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"theZ", "[", "t_", "]"}], ":=", 
     RowBox[{
      RowBox[{"1", "/", "4"}], "+", 
      RowBox[{"rVal", " ", 
       RowBox[{"Exp", "[", 
        RowBox[{"I", " ", "t"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"branchW0", "=", 
     RowBox[{"H", "[", 
      RowBox[{
       RowBox[{"theZ", "[", "tStart", "]"}], ",", "0", ",", "0"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wDeriv", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"w", "'"}], "[", "t", "]"}], "\[Equal]", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            FractionBox[
             RowBox[{"D", "[", 
              RowBox[{"theFunction", ",", "z"}], "]"}], 
             RowBox[{"D", "[", 
              RowBox[{"theFunction", ",", "w"}], "]"}]], ")"}]}], " ", 
          RowBox[{"(", 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"theZ", "[", "t", "]"}], ",", "t"}], "]"}], ")"}]}], 
         ")"}], "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"w", "\[Rule]", 
           RowBox[{"w", "[", "t", "]"}]}], ",", 
          RowBox[{"z", "\[Rule]", 
           RowBox[{"theZ", "[", "t", "]"}]}]}], "}"}]}], ")"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"solF", "=", 
     RowBox[{"NDSolveValue", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"wDeriv", ",", 
         RowBox[{
          RowBox[{"w", "[", "tStart", "]"}], "\[Equal]", "branchW0"}]}], 
        "}"}], ",", "w", ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "tStart", ",", "tEnd"}], "}"}], ",", 
       RowBox[{"MaxStepSize", "\[Rule]", "500"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"solPlot", "=", 
     RowBox[{"ParametricPlot3D", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Re", "@", "z"}], ",", 
          RowBox[{"Im", "@", "z"}], ",", 
          RowBox[{"Re", "@", 
           RowBox[{"solF", "[", "t", "]"}]}]}], "}"}], "/.", 
        RowBox[{"z", "->", 
         RowBox[{"theZ", "[", "t", "]"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", 
         RowBox[{"tStart", "+", "0.05"}], ",", 
         RowBox[{"tEnd", "-", "0.05"}]}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", "Black"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"arrowPoints", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Re", "@", "z"}], ",", 
          RowBox[{"Im", "@", "z"}], ",", 
          RowBox[{"Re", "@", 
           RowBox[{"solF", "[", "t", "]"}]}]}], "}"}], "/.", 
        RowBox[{"z", "->", 
         RowBox[{"theZ", "[", "t", "]"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "tStart", ",", 
         RowBox[{"tStart", "+", 
          RowBox[{"3", "/", "4"}]}], ",", "0.01"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"arrowG", "=", 
     RowBox[{"Graphics3D", "@", 
      RowBox[{"{", 
       RowBox[{"Arrow", "[", 
        RowBox[{"BSplineCurve", "[", "arrowPoints", "]"}], "]"}], "}"}]}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"startPtG", "=", 
     RowBox[{"Graphics3D", "@", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"PointSize", "[", "0.025", "]"}], ",", "Yellow", ",", 
        RowBox[{"Point", "@", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Re", "@", 
            RowBox[{"theZ", "[", "tStart", "]"}]}], ",", 
           RowBox[{"Im", "@", 
            RowBox[{"theZ", "[", "tStart", "]"}]}], ",", 
           RowBox[{"Re", "@", 
            RowBox[{"solF", "[", "tStart", "]"}]}]}], "}"}]}]}], "}"}]}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"s1G", "=", 
     RowBox[{"Graphics3D", "@", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"PointSize", "[", "0.025", "]"}], ",", "Red", ",", 
        RowBox[{"Point", "[", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", "0"}], "}"}], "]"}]}], "}"}]}]}], ";"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"s2G", "=", 
     RowBox[{"Graphics3D", "@", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"PointSize", "[", "0.025", "]"}], ",", "Cyan", ",", 
        RowBox[{"Point", "[", 
         RowBox[{"{", 
          RowBox[{"1", ",", "0", ",", "0"}], "}"}], "]"}]}], "}"}]}]}], ";"}],
    "\[IndentingNewLine]", 
   RowBox[{"Show", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "p1", ",", "p1b", ",", "p2", ",", "p2b", ",", "solPlot", ",", "arrowG", 
       ",", "startPtG", ",", "s1G", ",", "s2G"}], "}"}], ",", 
     RowBox[{"PlotRange", "->", "2"}], ",", 
     RowBox[{"BoxRatios", "->", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "1", ",", " ", "1"}], "}"}]}]}], "]"}], 
   "\[IndentingNewLine]", " ", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{"now", " ", "define", " ", "a_", 
     RowBox[{"{", 
      RowBox[{"-", "1"}], "}"}], " ", 
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", "Pi", " ", "i"}], ")"}]}], " ", "Integral", " ", 
     "of", " ", 
     RowBox[{"solF", "[", "t", "]"}], 
     RowBox[{"d", "/", "dt"}], " ", "C", 
     RowBox[{"(", "t", ")"}], "dt"}], "\[IndentingNewLine]", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"intVal", "=", 
    RowBox[{"NIntegrate", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"solF", "[", "t", "]"}], " ", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"theZ", "[", "t", "]"}], ",", "t"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "tStart", ",", "tEnd"}], "}"}]}], "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   FractionBox["intVal", 
    RowBox[{
     RowBox[{"Exp", "[", 
      RowBox[{"2", " ", "Pi", " ", "I", 
       RowBox[{"(", 
        RowBox[{"theP", "/", "theQ"}], ")"}]}], "]"}], "-", "1"}]], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Beta", "[", 
     RowBox[{
      RowBox[{"1", "+", 
       RowBox[{"theP", "/", "theQ"}]}], ",", 
      RowBox[{"1", "+", 
       RowBox[{"theR", "/", "theS"}]}]}], "]"}], "//", "N"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.9724612549141397`*^9, 3.9724613251287065`*^9}, {
