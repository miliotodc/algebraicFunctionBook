Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"subDirectory", "=", "\"\<testCase0039\>\""}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"$theTestCase", "=", "subDirectory"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{"theP", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"theQ", "=", "2"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"theR", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"theS", "=", "2"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"theM", "=", 
     RowBox[{"LCM", "[", 
      RowBox[{"theQ", ",", "theS"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fact1", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"theP", "<", "0"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"fact1", "=", 
        RowBox[{"z", "^", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "theP"}], "/", "theQ"}], ")"}], "theM"}], ")"}]}]}],
        ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fact2", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"theR", "<", "0"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"fact2", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", "z"}], ")"}], "^", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "theR"}], "/", "theS"}], ")"}], " ", "theM"}], 
          ")"}]}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<fact1: \>\"", ",", "fact1"}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<fact2: \>\"", ",", "fact2"}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"theM", "=", 
     RowBox[{"LCM", "[", 
      RowBox[{"theQ", ",", "theS"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<theM: \>\"", ",", "theM"}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"theG", "=", 
    RowBox[{
     RowBox[{"G", "[", "z", "]"}], "^", "theM"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"theW", "=", 
     RowBox[{"fact1", " ", "fact2", " ", 
      RowBox[{"w", "^", "theM"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
