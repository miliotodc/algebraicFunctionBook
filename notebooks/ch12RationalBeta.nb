Cell[CellGroupData[{

Cell["getPochhammerMonodromy", "Subsection",
 CellChangeTimes->{{3.94939577952164*^9, 
  3.949395783760521*^9}},ExpressionUUID->"34e1910e-89b3-483b-baa9-\
f764c32e3675"],

Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
   "get", " ", "differential", " ", "monodromy", " ", "around", " ", "a", " ",
     "singular", " ", "point"}], "\[IndentingNewLine]", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Options", "[", "getPochhammerMonodromy", "]"}], "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<nSolveWP\>\"", "->", "50"}], ",", 
       RowBox[{"\"\<integrateWP\>\"", "->", "50"}], ",", 
       RowBox[{"\"\<polishWP\>\"", "->", "20"}], ",", 
       RowBox[{"\"\<diagFlag\>\"", "->", "False"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"getPochhammerMonodromy", "[", 
     RowBox[{"singularPoint_", ",", "perimeter_", ",", 
      RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "z0", ",", "singularRoots", ",", "wArray", ",", "branchVals", ",", 
        "polishedVals", ",", "pArray", ",", "theCycles", ",", "theLinks", ",",
         "oneCycles", ",", "finalCycles"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"\"\<nSolveWP: \>\"", ",", 
         RowBox[{"OptionValue", "[", "\"\<nSolveWP\>\"", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"z0", "=", 
        RowBox[{"singularPoint", "+", 
         RowBox[{"perimeter", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"Pi", " ", 
            RowBox[{"I", "/", "2"}]}], "]"}]}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<z0: \>\"", ",", 
         RowBox[{"z0", "//", "N"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"singularRoots", "=", 
        RowBox[{"Sort", "[", 
         RowBox[{"w", "/.", 
          RowBox[{"NSolve", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"theFunction", "==", "0"}], "/.", 
             RowBox[{"z", "->", "z0"}]}], ",", "w", ",", 
            RowBox[{"WorkingPrecision", "->", 
             RowBox[{"OptionValue", "[", "\"\<nSolveWP\>\"", "]"}]}]}], 
           "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"wArray", "=", 
        RowBox[{"MapThread", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"#1", ",", "#2"}], "}"}], "&"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Range", "[", 
             RowBox[{"Length", "@", "singularRoots"}], "]"}], ",", 
            "singularRoots"}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", " ", 
       RowBox[{"branchVals", "=", 
        RowBox[{"integrateOverPochhammerSheet", "[", 
         RowBox[{"z0", ",", "singularPoint", ",", 
          RowBox[{"Pi", "/", "2"}], ",", "wArray", ",", "perimeter", ",", 
          "False", ",", 
          RowBox[{"OptionValue", "[", "\"\<integrateWP\>\"", "]"}]}], "]"}]}],
        ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"polishedVals", "=", 
        RowBox[{"polishBranchTerms", "[", 
         RowBox[{"z0", ",", "branchVals", ",", 
          RowBox[{"OptionValue", "[", "\"\<polishWP\>\"", "]"}]}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"OptionValue", "[", "\"\<diagFlag\>\"", "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"\"\<polishedVals: \>\"", ",", 
            RowBox[{
             RowBox[{"polishedVals", "//", "N"}], "//", "MatrixForm"}]}], 
           "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"pArray", "=", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Position", "[", 
            RowBox[{
             RowBox[{"polishedVals", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
             RowBox[{"x_", "/;", 
              RowBox[{
               RowBox[{"Abs", "[", 
                RowBox[{"x", "-", "#"}], "]"}], "<", 
               RowBox[{"10", "^", 
                RowBox[{"-", "20"}]}]}]}]}], "]"}], "&"}], "/@", " ", 
          RowBox[{"polishedVals", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "3"}], "]"}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"theCycles", "=", 
        RowBox[{"PermutationCycles", "[", "pArray", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"theLinks", "=", 
        RowBox[{"theCycles", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"oneCycles", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"{", "#", "}"}], "&"}], "/@", 
         RowBox[{"Complement", "[", 
          RowBox[{
           RowBox[{"Range", "[", "functionDegree", "]"}], ",", 
           RowBox[{"Flatten", "[", "theLinks", "]"}]}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"finalCycles", "=", 
        RowBox[{"Join", "[", 
         RowBox[{"theLinks", ",", "oneCycles"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Sort", "[", 
           RowBox[{"Flatten", "@", "finalCycles"}], "]"}], "!=", 
          RowBox[{"Range", "[", 
           RowBox[{"Length", "@", 
            RowBox[{"Flatten", "@", "finalCycles"}]}], "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"Style", "[", 
            RowBox[{
            "\"\<Monodromy is not consistent!\>\"", ",", "Purple", ",", 
             "14"}], "]"}], "]"}], ";"}], "\[IndentingNewLine]", ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"Style", "[", 
            RowBox[{"\"\<Monodromy is consistent\>\"", ",", 
             RowBox[{"Darker", "@", "Green"}], ",", "12"}], "]"}], "]"}], 
          ";"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"finalCycles", ",", "polishedVals"}], "}"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.94930377153995*^9, 3.9493038462344427`*^9}, {
  3.949303934162876*^9, 3.949303935593416*^9}, {3.949304031663136*^9, 
  3.9493040333535357`*^9}, {3.949304153487504*^9, 3.9493041703351526`*^9}, {
  3.9493044109394855`*^9, 3.9493044152520227`*^9}, {3.9493046058147945`*^9, 
  3.949304615012755*^9}, {3.9493046564610715`*^9, 3.9493046943914814`*^9}, {
  3.9493047246899967`*^9, 3.94930475483401*^9}},
 CellLabel->"In[48]:=",ExpressionUUID->"d44b2976-d3c0-4550-98da-d35b80fef6d3"]
}, Closed]],

Cell[CellGroupData[{

Cell["integrateOverSheet", "Subsection",
 CellChangeTimes->{{3.928684164266532*^9, 3.928684167187718*^9}, {
  3.9290869223801203`*^9, 
  3.92908692511351*^9}},ExpressionUUID->"95b1e6db-3bde-4881-98f0-\
ab7997bf2896"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"integrateOverPochhammerSheet", "[", 
      RowBox[{
      "startPoint_", ",", "singPoint_", ",", "startTheta_", ",", "w0Table_", 
       ",", "radius_", ",", "stiffnessFlag_", ",", "wp_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "intTable", ",", "integrationPath", ",", "wDeriv", ",", "theSol", ",",
          "w0"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"PrintTemporary", "[", 
         RowBox[{"\"\<Integrating index \>\"", ",", 
          RowBox[{"Dynamic", "@", "np"}]}], "]"}], ";", "\[IndentingNewLine]",
         " ", 
        RowBox[{"intTable", "=", 
         RowBox[{"Table", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"np", "=", "n"}], ";", "\[IndentingNewLine]", 
            RowBox[{"w0", "=", 
             RowBox[{"w0Table", "[", 
              RowBox[{"[", 
               RowBox[{"n", ",", "2"}], "]"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"integrationPath", "[", "t_", "]"}], ":=", 
             RowBox[{"singPoint", "+", 
              RowBox[{"radius", " ", 
               RowBox[{"Exp", "[", 
                RowBox[{"I", " ", "t"}], "]"}]}]}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"wDeriv", "=", 
             RowBox[{
              RowBox[{
               RowBox[{"w", "'"}], "[", "t", "]"}], "\[Equal]", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"-", 
                   RowBox[{"(", 
                    FractionBox[
                    RowBox[{"D", "[", 
                    RowBox[{"theFunction", ",", "z"}], "]"}], 
                    RowBox[{"D", "[", 
                    RowBox[{"theFunction", ",", "w"}], "]"}]], ")"}]}], " ", 
                  RowBox[{"D", "[", 
                   RowBox[{
                    RowBox[{"integrationPath", "[", "t", "]"}], ",", "t"}], 
                   "]"}]}], ")"}], "/.", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"w", "\[Rule]", 
                   RowBox[{"w", "[", "t", "]"}]}], ",", 
                  RowBox[{"z", "\[Rule]", 
                   RowBox[{"integrationPath", "[", "t", "]"}]}]}], "}"}]}], 
               ")"}]}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{"stiffnessFlag", ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"theSol", "=", 
                RowBox[{"NDSolveValue", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"wDeriv", ",", 
                    RowBox[{
                    RowBox[{"w", "[", "startTheta", "]"}], "\[Equal]", 
                    "w0"}]}], "}"}], ",", "w", ",", 
                  RowBox[{"{", 
                   RowBox[{"t", ",", "startTheta", ",", 
                    RowBox[{"startTheta", "+", 
                    RowBox[{"2", " ", "Pi"}]}]}], "}"}], ",", 
                  RowBox[{"MaxSteps", "\[Rule]", "2000000"}], ",", 
                  RowBox[{"MaxStepSize", "\[Rule]", 
                   RowBox[{"1", "/", "1000"}]}], ",", 
                  RowBox[{"WorkingPrecision", "\[Rule]", "wp"}], ",", 
                  RowBox[{"Method", " ", "\[Rule]", " ", 
                   RowBox[{"{", 
                    RowBox[{"\"\<StiffnessSwitching\>\"", ",", 
                    RowBox[{"\"\<NonstiffTest\>\"", "->", "False"}]}], 
                    "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", ",", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"theSol", "=", 
                RowBox[{"NDSolveValue", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"wDeriv", ",", 
                    RowBox[{
                    RowBox[{"w", "[", "startTheta", "]"}], "\[Equal]", 
                    "w0"}]}], "}"}], ",", "w", ",", 
                  RowBox[{"{", 
                   RowBox[{"t", ",", "startTheta", ",", 
                    RowBox[{"startTheta", "+", 
                    RowBox[{"2", " ", "Pi"}]}]}], "}"}], ",", 
                  RowBox[{"MaxSteps", "\[Rule]", "2000000"}], ",", 
                  RowBox[{"MaxStepSize", "\[Rule]", 
                   RowBox[{"1", "/", "1000"}]}], ",", 
                  RowBox[{"WorkingPrecision", "\[Rule]", "wp"}]}], "]"}]}], 
               ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", " ", 
             RowBox[{"save", " ", 
              RowBox[{"{", 
               RowBox[{"seriesIndex", ",", 
                RowBox[{"theSol", "[", "1", "]"}]}], "}"}]}], " ", "*)"}], 
            "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"w0Table", "[", 
               RowBox[{"[", 
                RowBox[{"n", ",", "1"}], "]"}], "]"}], ",", 
              RowBox[{"w0Table", "[", 
               RowBox[{"[", 
                RowBox[{"n", ",", "2"}], "]"}], "]"}], ",", 
              RowBox[{"theSol", "[", 
               RowBox[{"startTheta", "+", 
                RowBox[{"2", " ", "Pi"}]}], "]"}]}], "}"}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"n", ",", "1", ",", 
             RowBox[{"Length", "@", "w0Table"}]}], "}"}]}], 
          "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
        "intTable"}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.9286838213459244`*^9, 3.9286839392565193`*^9}, {
