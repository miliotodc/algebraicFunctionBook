      RowBox[{"(", 
       RowBox[{"1", "-", "z"}], ")"}], "^", 
      RowBox[{"(", 
       RowBox[{"theR", "/", "theS"}], ")"}]}]}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"H", "[", 
      RowBox[{"z_", ",", "j_", ",", "k_"}], "]"}], ":=", 
