Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"sortPermutations", "[", "perm_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "rotatedPerm", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"rotatedPerm", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"RotateLeft", "[", 
           RowBox[{"#", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"FirstPosition", "[", 
               RowBox[{"#", ",", 
                RowBox[{"Min", "[", "#", "]"}]}], "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}], "-", "1"}]}], "]"}], "&"}], "/@",
          " ", "perm"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Sort", "[", 
        RowBox[{"rotatedPerm", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"#1", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "<", 
           RowBox[{"#2", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], "&"}]}], "]"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}]}]], "Input",
