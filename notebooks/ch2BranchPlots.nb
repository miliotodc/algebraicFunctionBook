Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{"expansion", " ", "at", " ", "infinity"}], "\[IndentingNewLine]", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"iterationMax", "=", "5"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tempFunction", "=", 
     RowBox[{"z", "-", 
      RowBox[{"Product", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"w", "-", "j"}], ")"}], "^", "j"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "1", ",", "iterationMax"}], "}"}]}], "]"}]}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"aForm", "[", "tempFunction", "]"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"subDirectory", "=", 
     RowBox[{"\"\<testCase0025Inf\>\"", "<>", "\"\<\\\\Iteration\>\"", "<>", 
      RowBox[{"ToString", "[", "iterationMax", "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"$theTestCase", "=", "subDirectory"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"!", 
       RowBox[{"TrueQ", "@", 
        RowBox[{"FileExistsQ", "@", 
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{"dataDir", ",", "subDirectory"}], "}"}], "]"}]}]}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"CreateDirectory", "[", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{"dataDir", ",", "subDirectory"}], "}"}], "]"}], "]"}], 
       ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cList", "=", 
     RowBox[{"CoefficientList", "[", 
      RowBox[{"tempFunction", ",", "w"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"maxZ", "=", 
     RowBox[{"Max", "@", 
      RowBox[{"Flatten", "@", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"Exponent", "[", 
           RowBox[{"#", ",", "z", ",", "List"}], "]"}], "&"}], "/@", " ", 
         "cList"}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"$theFunction", "=", 
     RowBox[{"Expand", "[", 
      RowBox[{
       RowBox[{"z", "^", "maxZ"}], 
       RowBox[{"(", 
        RowBox[{"tempFunction", "/.", 
         RowBox[{"z", "->", 
          RowBox[{"1", "/", "z"}]}]}], ")"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"aForm", "[", "$theFunction", "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wExp", "=", 
