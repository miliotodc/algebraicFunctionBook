   RowBox[{
    RowBox[{"$showNormalizedConstants", "=", "False"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"$minNSolvePrecision", "=", "100"}], ";"}], "\[IndentingNewLine]",
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
