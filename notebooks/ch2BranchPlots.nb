    RowBox[{"DistributeDefinitions", "[", "ConvexHull", "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{"$separationFactor", "=", "10"}], ";"}], "\[IndentingNewLine]", 
   " ", 
