Cell[CellGroupData[{

Cell["Figure 8 contour over z^{1/3}(1-z)^{4/3}", "Subsection",
 CellChangeTimes->{{3.9693473434994373`*^9, 3.9693473455673513`*^9}, {
  3.969368379390811*^9, 3.969368386328555*^9}, {3.9701288060199623`*^9, 
  3.970128810486219*^9}},ExpressionUUID->"ae175659-b506-454e-86a0-\
d05853e3a8d2"],

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"G", "[", "z_", "]"}], ":=", 
   RowBox[{
    RowBox[{"z", "^", 
     RowBox[{"(", 
      RowBox[{"1", "/", "3"}], ")"}]}], 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", "z"}], ")"}], "^", 
     RowBox[{"(", 
      RowBox[{"4", "/", "3"}], ")"}]}]}]}]}]], "Input",
 CellChangeTimes->{{3.9700476575944357`*^9, 3.970047669320365*^9}, {
  3.970128817776304*^9, 3.9701288213197365`*^9}},
 CellLabel->
  "In[182]:=",ExpressionUUID->"45d570bb-c798-4428-9976-fd76655d5374"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"tempF", "[", 
      RowBox[{"t_", ",", "a_", ",", "b_", ",", "c_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"a", " ", 
         RowBox[{"Sin", "[", "t", "]"}]}], "+", "b"}], ")"}], "+", 
      RowBox[{"I", 
       RowBox[{"(", 
        RowBox[{"c", " ", 
         RowBox[{"Sin", "[", "t", "]"}], " ", 
         RowBox[{"Cos", "[", "t", "]"}]}], ")"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ParametricPlot", "[", 
      RowBox[{
       RowBox[{"ReIm", "@", 
        RowBox[{"tempF", "[", 
         RowBox[{"t", ",", "a", ",", "b", ",", "c"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", 
         RowBox[{"-", "Pi"}], ",", "Pi"}], "}"}], ",", 
       RowBox[{"PlotRange", "->", "2"}]}], "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", "1"}], "}"}], ",", "0.5", ",", "2"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"b", ",", 
         RowBox[{"1", "/", "2"}]}], "}"}], ",", "0.1", ",", "2"}], "}"}], ",",
      "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"c", ",", "1"}], "}"}], ",", "0.25", ",", "2"}], "}"}]}], 
    "\[IndentingNewLine]", "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9695428748412113`*^9, 3.9695430166421432`*^9}, {
  3.9695437554864426`*^9, 3.9695437556953597`*^9}},
