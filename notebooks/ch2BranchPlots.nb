39654c11caab"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{"expansion", " ", "at", " ", "infinity"}], "\[IndentingNewLine]", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"$theFunction", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"z", "^", 
         RowBox[{"(", "30", ")"}]}], "+", 
        RowBox[{"z", "^", 
         RowBox[{"(", "32", ")"}]}]}], ")"}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"z", "^", "14"}], "+", 
         RowBox[{"z", "^", "20"}]}], ")"}], " ", 
       RowBox[{"w", "^", "5"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"z", "^", "5"}], "+", 
         RowBox[{"z", "^", "9"}]}], ")"}], " ", 
       RowBox[{"w", "^", "9"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"z", "+", 
         RowBox[{"z", "^", "3"}]}], ")"}], 
       RowBox[{"w", "^", "12"}]}], "+", 
      RowBox[{"6", 
       RowBox[{"w", "^", "14"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"2", "+", 
         RowBox[{"z", "^", "2"}]}], ")"}], 
       RowBox[{"w", "^", "15"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cList", "=", 
     RowBox[{"CoefficientList", "[", 
      RowBox[{"$theFunction", ",", "w"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"maxZ", "=", 
     RowBox[{"Max", "@", 
      RowBox[{"Flatten", "@", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"Exponent", "[", 
           RowBox[{"#", ",", "z", ",", "List"}], "]"}], "&"}], "/@", " ", 
         "cList"}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"newFunction", "=", 
     RowBox[{"Expand", "[", 
      RowBox[{
       RowBox[{"z", "^", "maxZ"}], 
       RowBox[{"(", 
        RowBox[{"$theFunction", "/.", 
         RowBox[{"z", "->", 
          RowBox[{"1", "/", "z"}]}]}], ")"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"$theFunction", "=", "newFunction"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"$theTestCase", "=", "\"\<testCase0002Inf\>\""}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"subDirectory", "=", "$theTestCase"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"$theTestCase", "=", "\"\<testCase0001\>\""}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"subDirectory", "=", "$theTestCase"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"!", 
       RowBox[{"TrueQ", "@", 
        RowBox[{"FileExistsQ", "@", 
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{"dataDir", ",", "subDirectory"}], "}"}], "]"}]}]}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"CreateDirectory", "[", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{"dataDir", ",", "subDirectory"}], "}"}], "]"}], "]"}], 
       ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"aForm", "[", "$theFunction", "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wExp", "=", 
     RowBox[{"Exponent", "[", 
      RowBox[{"$theFunction", ",", "w", ",", "List"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"functionDegree", "=", 
    RowBox[{"Last", "@", "wExp"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{"$theFunction", ",", "z"}], "]"}], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"z", "->", "0"}], ",", 
      RowBox[{"w", "->", "0"}]}], "}"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"D", "[", 
