Cell[CellGroupData[{

Cell["getIntegrationData", "Subsection",
 CellChangeTimes->{{3.876756997574633*^9, 
  3.8767570027765555`*^9}},ExpressionUUID->"119edd53-ed70-4dfc-869b-\
7d634035cce2"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"getIntegrationData", "[", 
     RowBox[{
     "baseSingularity_", ",", "baseRadius_", ",", "nextSingularity_", ",", 
      "nextRadius_"}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "baseSingularPoint", ",", "nextSingularPoint", ",", "baseNDZ", ",", 
        "nextNDZ", ",", "baseEqn", ",", "nextEqn", ",", "p1", ",", "p2", ",", 
        "eqn3", ",", "myPoints", ",", "minVal", ",", "baseLoc", ",", 
        "nextSol", ",", "baseSol", ",", "nextLoc", ",", "theSolvePrec", ",", 
        "nextNDZ2", ",", "myBasePoints", ",", "myNextPoints", ",", 
        "otherIndex", ",", "singPrecision"}], "}"}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"baseSingularPoint", "=", 
        RowBox[{"ReIm", "@", "baseSingularity"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"nextSingularPoint", "=", 
        RowBox[{"ReIm", "@", "nextSingularity"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"singPrecision", "=", 
        RowBox[{"Floor", "@", 
         RowBox[{"Min", "@", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Precision", "@", "baseSingularity"}], ",", 
            RowBox[{"Precision", "@", "nextSingularity"}]}], "}"}]}]}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"singPrecision", "==", "\[Infinity]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"singPrecision", "=", "1000"}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", "\[IndentingNewLine]", " ", 
        RowBox[{
        "first", " ", "check", "  ", "real", " ", "parts", " ", "for", " ", 
         "vertical", " ", "case"}], "\[IndentingNewLine]", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{"baseSingularPoint", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "-", 
            RowBox[{"nextSingularPoint", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "<", 
          RowBox[{"10", "^", 
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{"singPrecision", "-", "$accuracyComparisonFactor"}], 
             ")"}]}]}]}], ",", "\[IndentingNewLine]", 
         RowBox[{"(*", "\[IndentingNewLine]", " ", 
          RowBox[{
           RowBox[{"vertical", " ", "case"}], ",", " ", 
           RowBox[{
           "now", " ", "check", " ", "imaginary", " ", "parts", " ", "to", 
            " ", "see", " ", "which", " ", "one", " ", "is", " ", "on", " ", 
            "top"}]}], "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"baseSingularPoint", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ">", 
             RowBox[{"nextSingularPoint", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
            RowBox[{"(*", "\[IndentingNewLine]", 
             RowBox[{"base", " ", "above", " ", "next", " ", "point"}], 
             "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"baseNDZ", "=", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"baseSingularPoint", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", 
                RowBox[{
                 RowBox[{"baseSingularPoint", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], "-", "baseRadius"}]}], 
               "}"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"nextNDZ", "=", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"nextSingularPoint", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", 
                RowBox[{
                 RowBox[{"nextSingularPoint", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], "+", "nextRadius"}]}], 
               "}"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"nextNDZ2", "=", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"nextSingularPoint", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", 
                RowBox[{
                 RowBox[{"nextSingularPoint", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], "-", "nextRadius"}]}], 
               "}"}]}], ";"}], "\[IndentingNewLine]", ",", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", "\[IndentingNewLine]", 
             RowBox[{"base", " ", "below", " ", "next", " ", "point"}], 
             "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"baseNDZ", "=", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"baseSingularPoint", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", 
                RowBox[{
                 RowBox[{"baseSingularPoint", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], "+", "baseRadius"}]}], 
               "}"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"nextNDZ", "=", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"nextSingularPoint", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", 
                RowBox[{
                 RowBox[{"nextSingularPoint", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], "-", "nextRadius"}]}], 
               "}"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"nextNDZ2", "=", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"nextSingularPoint", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", 
                RowBox[{
                 RowBox[{"nextSingularPoint", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], "+", "nextRadius"}]}], 
               "}"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], 
         "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
         RowBox[{"(*", " ", "\[IndentingNewLine]", 
          RowBox[{"non", "-", 
           RowBox[{"vertical", " ", "case"}]}], "\[IndentingNewLine]", "*)"}],
          "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"baseEqn", "=", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"x", "-", 
                RowBox[{"baseSingularPoint", "[", 
                 RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "^", "2"}], "+", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"y", "-", 
                RowBox[{"baseSingularPoint", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "^", "2"}]}], "==", 
            
            RowBox[{"baseRadius", "^", "2"}]}]}], ";", "\[IndentingNewLine]", 
          
          RowBox[{"nextEqn", "=", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"x", "-", 
                RowBox[{"nextSingularPoint", "[", 
                 RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "^", "2"}], "+", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"y", "-", 
                RowBox[{"nextSingularPoint", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "^", "2"}]}], "==", 
            
            RowBox[{"nextRadius", "^", "2"}]}]}], ";", "\[IndentingNewLine]", 
          
          RowBox[{"(*", "\[IndentingNewLine]", " ", 
           RowBox[{
           "get", " ", "equation", " ", "of", " ", "line", " ", "between", 
            " ", "singular", " ", "points"}], "\[IndentingNewLine]", "*)"}], 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"p1", "=", "baseSingularPoint"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"p2", "=", "nextSingularPoint"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"eqn3", "=", 
           RowBox[{"Expand", "[", 
            RowBox[{"y", "==", 
             RowBox[{
              RowBox[{
               FractionBox[
                RowBox[{
                 RowBox[{"p2", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], "-", 
                 RowBox[{"p1", "[", 
                  RowBox[{"[", "2", "]"}], "]"}]}], 
                RowBox[{
                 RowBox[{"p2", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], "-", 
                 RowBox[{"p1", "[", 
                  RowBox[{"[", "1", "]"}], "]"}]}]], 
               RowBox[{"(", 
                RowBox[{"x", "-", 
                 RowBox[{"p1", "[", 
                  RowBox[{"[", "1", "]"}], "]"}]}], ")"}]}], "+", 
              RowBox[{"p1", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"theSolvePrec", "=", 
           RowBox[{"Floor", "@", 
            RowBox[{"Precision", "@", 
             RowBox[{"{", 
              RowBox[{"baseEqn", ",", "nextEqn", ",", "eqn3"}], "}"}]}]}]}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"theSolvePrec", "<", "$minNSolvePrecision"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{"Style", "[", 
               RowBox[{
               "\"\<getIntegrationData::solve \
precision<$minSolvePrecision\>\"", ",", "Red", ",", "14", ",", "Bold"}], 
               "]"}], "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"Abort", "[", "]"}], ";"}], "\[IndentingNewLine]", ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"theSolvePrec", "=", "$minNSolvePrecision"}], ";"}]}], 
           "\[IndentingNewLine]", "]"}], ";", "\n", "          ", 
          RowBox[{"baseSol", "=", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"x", ",", "y"}], "}"}], "/.", 
            RowBox[{"NSolve", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"baseEqn", ",", "eqn3"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"x", ",", "y"}], "}"}], ",", 
              RowBox[{"WorkingPrecision", "->", "theSolvePrec"}]}], "]"}]}]}],
           ";", "\[IndentingNewLine]", 
          RowBox[{"nextSol", "=", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"x", ",", "y"}], "}"}], "/.", 
            RowBox[{"NSolve", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"nextEqn", ",", "eqn3"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"x", ",", "y"}], "}"}], ",", 
              RowBox[{"WorkingPrecision", "->", "theSolvePrec"}]}], "]"}]}]}],
           ";", "\[IndentingNewLine]", 
          RowBox[{"myBasePoints", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"EuclideanDistance", "[", 
              RowBox[{"p2", ",", "#"}], "]"}], "&"}], "/@", "baseSol"}]}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"minVal", "=", 
           RowBox[{"Min", "@", "myBasePoints"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"baseLoc", "=", 
           RowBox[{
            RowBox[{"Position", "[", 
             RowBox[{"myBasePoints", ",", 
              RowBox[{"x_", "/;", 
               RowBox[{
                RowBox[{"Abs", "[", 
                 RowBox[{"x", "-", "minVal"}], "]"}], "<", 
                RowBox[{"10", "^", 
                 RowBox[{"-", 
                  RowBox[{"(", 
                   RowBox[{"theSolvePrec", "-", "$accuracyComparisonFactor"}],
                    ")"}]}]}]}]}]}], "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"baseNDZ", "=", 
           RowBox[{"baseSol", "[", 
            RowBox[{"[", "baseLoc", "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"myNextPoints", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"EuclideanDistance", "[", 
              RowBox[{"p1", ",", "#"}], "]"}], "&"}], "/@", "nextSol"}]}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"minVal", "=", 
           RowBox[{"Min", "@", "myNextPoints"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"nextLoc", "=", 
