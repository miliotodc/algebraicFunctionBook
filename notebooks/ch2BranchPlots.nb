Cell[CellGroupData[{

Cell["\<\
Section 5:  Compute/retrieve annular monodromies, update annular table and \
export singular data to file\
\>", "Section",
 CellChangeTimes->{{3.9942274812659245`*^9, 
  3.994227490227192*^9}},ExpressionUUID->"5f269621-f6ab-4f24-b71d-\
7bcb460d96e2"],

Cell[CellGroupData[{

Cell["\<\
Section 5.1:  Compute annular monodromies and update annular table with \
annular monodromies\
\>", "Subsection",
 CellChangeTimes->{{3.9403190826991596`*^9, 3.9403190866667633`*^9}, {
  3.981989164661481*^9, 3.9819891768170185`*^9}, {3.9819937863460884`*^9, 
  3.9819937933744726`*^9}, {3.9819939187671366`*^9, 3.98199392038151*^9}, {
  3.9858569807267914`*^9, 3.9858569809830956`*^9}, {3.994227429575547*^9, 
  3.994227430153537*^9}, {3.9942275023611965`*^9, 
  3.99422750416352*^9}},ExpressionUUID->"37bb909d-85b2-4881-b9b9-\
a7efc7613338"],

Cell["\<\
This routine will attempt to compute the monodromies with stiffness switching \
set to false first for speed.  If an inconsistent monodromy is encountered, \
then the method changes to stiffness switching True.  If the monodromy is \
still inconsistent, an error message is reported and the analysis stops.  At \
this point, the affected annular domain should be analyzed separately with \
higher nSolveWP, integrateWP and or polishWP to obtain if possible a \
consistent monodromy.\
\>", "Text",
 CellChangeTimes->{{3.9942625095689096`*^9, 
  3.994262517012904*^9}},ExpressionUUID->"f5b8645b-8621-4638-91e2-\
763225bc69f9"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"annularMonodromyData", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"consistencyFlag", "=", "True"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"aIndex", "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"While", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"aIndex", "<", 
      RowBox[{"Length", "@", "theAnnuli"}]}], " ", "&&", " ", 
     RowBox[{"consistencyFlag", "==", "True"}]}], ",", "\[IndentingNewLine]", 
    
    RowBox[{
     RowBox[{"aIndex", "++"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"Style", "[", 
       RowBox[{
        RowBox[{"\"\<Analyzing Annular index: \>\"", "<>", 
         RowBox[{"ToString", "@", "aIndex"}]}], ",", "Bold", ",", "Black"}], 
       "]"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "finalCycles", ",", "polishedVals", ",", "flag", ",", 
        "integrationData"}], "}"}], "=", 
      RowBox[{"getAnnularMonodromyNew", "[", 
       RowBox[{"aIndex", ",", "annularCenters", ",", 
        RowBox[{"\"\<stiffFlag\>\"", "->", "False"}], ",", 
        RowBox[{"\"\<nSolveWP\>\"", "->", "50"}], ",", 
        RowBox[{"\"\<integrateWP\>\"", "->", "50"}], ",", 
        RowBox[{"\"\<polishWP\>\"", "->", "20"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"flag", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "==", "False"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{"Style", "[", 
          RowBox[{
          "\"\<     Inconsistent monodromy.  Switching to Stiffness Method . \
. .\>\"", ",", "Bold", ",", "Black"}], "]"}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "finalCycles", ",", "polishedVals", ",", "flag", ",", 
           "integrationData"}], "}"}], "=", 
         RowBox[{"getAnnularMonodromyNew", "[", 
          RowBox[{"aIndex", ",", "annularCenters", ",", 
           RowBox[{"\"\<stiffFlag\>\"", "->", "True"}], ",", 
           RowBox[{"\"\<nSolveWP\>\"", "->", "50"}], ",", 
           RowBox[{"\"\<integrateWP\>\"", "->", "50"}], ",", 
           RowBox[{"\"\<polishWP\>\"", "->", "20"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"flag", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "==", "False"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"Style", "[", 
             RowBox[{
             "\"\<     Inconsistent monodromy found with Stiffness method.  \
Try increasing precision for nSolveWP, integrateWP and polishWP.\>\"", ",", 
              "Red"}], "]"}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"consistencyFlag", "=", "False"}], ";"}], 
          "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{
              "\"\<     Found consistent monodromy for annular domain \>\"", "<>", 
               RowBox[{"ToString", "[", "aIndex", "]"}], "<>", 
               "\"\< using stiffness switching method\>\""}], ",", "Black", 
              ",", "Bold"}], "]"}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"annularMonodromyData", ",", 
             RowBox[{"{", 
              RowBox[{"finalCycles", ",", "flag", ",", "integrationData"}], 
              "}"}]}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], 
       "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{
           "\"\<     Found consistent monodromy for annular domain \>\"", "<>", 
            RowBox[{"ToString", "[", "aIndex", "]"}]}], ",", "Black", ",", 
           "Bold"}], "]"}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"annularMonodromyData", ",", 
          RowBox[{"{", 
           RowBox[{"finalCycles", ",", "flag", ",", "integrationData"}], 
           "}"}]}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]}], 
   "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"consistencyFlag", "==", "True"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"annularMonodromies", "=", 
      RowBox[{"annularMonodromyData", "[", 
