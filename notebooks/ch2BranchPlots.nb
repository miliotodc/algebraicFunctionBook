             RowBox[{"polishedVals", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
             RowBox[{"x_", "/;", 
              RowBox[{
               RowBox[{"Abs", "[", 
                RowBox[{"x", "-", "#"}], "]"}], "<", 
               RowBox[{"10", "^", 
                RowBox[{"-", "20"}]}]}]}]}], "]"}], "&"}], "/@", " ", 
          RowBox[{"polishedVals", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "3"}], "]"}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"theCycles", "=", 
        RowBox[{"PermutationCycles", "[", "pArray", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"theLinks", "=", 
        RowBox[{"theCycles", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"oneCycles", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"{", "#", "}"}], "&"}], "/@", 
         RowBox[{"Complement", "[", 
          RowBox[{
           RowBox[{"Range", "[", "functionDegree", "]"}], ",", 
           RowBox[{"Flatten", "[", "theLinks", "]"}]}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"finalCycles", "=", 
        RowBox[{"Join", "[", 
         RowBox[{"theLinks", ",", "oneCycles"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Sort", "[", 
           RowBox[{"Flatten", "@", "finalCycles"}], "]"}], "!=", 
          RowBox[{"Range", "[", 
           RowBox[{"Length", "@", 
            RowBox[{"Flatten", "@", "finalCycles"}]}], "]"}]}], ",", 
         "\[IndentingNewLine]", 
