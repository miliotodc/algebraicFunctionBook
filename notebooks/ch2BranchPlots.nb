Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"G", "[", "z_", "]"}], ":=", 
   RowBox[{
    RowBox[{"z", "^", 
     RowBox[{"(", 
      RowBox[{"1", "/", "2"}], ")"}]}], 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", "z"}], ")"}], "^", 
     RowBox[{"(", 
      RowBox[{"1", "/", "2"}], ")"}]}]}]}]}]], "Input",
 CellChangeTimes->{{3.9700476575944357`*^9, 3.970047669320365*^9}},
 CellLabel->
  "In[186]:=",ExpressionUUID->"39637d4c-5a3b-48c6-802c-6743f503aaa3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"rStart", "=", 
     RowBox[{"1", "/", "100"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rEnd", "=", 
     RowBox[{"99", "/", "100"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"theZ", "[", "r_", "]"}], ":=", "r"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"zStart", "=", 
     RowBox[{"theZ", "[", "rStart", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"wVals", "=", 
    RowBox[{"NSolveValues", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"$theFunction", "==", "0"}], "/.", 
       RowBox[{"z", "->", 
        RowBox[{"theZ", "[", "rStart", "]"}]}]}], ",", "w", ",", 
      RowBox[{"WorkingPrecision", "->", "25"}]}], "]"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wStart", "=", 
     RowBox[{"wVals", "[", 
      RowBox[{"[", "2", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wDeriv", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"w", "'"}], "[", "r", "]"}], "\[Equal]", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            FractionBox[
             RowBox[{"D", "[", 
              RowBox[{"$theFunction", ",", "z"}], "]"}], 
             RowBox[{"D", "[", 
              RowBox[{"$theFunction", ",", "w"}], "]"}]], ")"}]}], " ", 
          RowBox[{"(", 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"theZ", "[", "r", "]"}], ",", "r"}], "]"}], ")"}]}], 
         ")"}], "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"w", "\[Rule]", 
           RowBox[{"w", "[", "r", "]"}]}], ",", 
          RowBox[{"z", "\[Rule]", 
           RowBox[{"theZ", "[", "r", "]"}]}]}], "}"}]}], ")"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"solF1", "=", 
     RowBox[{"NDSolveValue", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"wDeriv", ",", 
         RowBox[{
          RowBox[{"w", "[", "rStart", "]"}], "\[Equal]", "wStart"}]}], "}"}], 
       ",", "w", ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", "rStart", ",", "rEnd"}], "}"}], ",", 
       RowBox[{"WorkingPrecision", "->", "20"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pp1", "=", 
     RowBox[{"ParametricPlot3D", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Re", "@", "z"}], ",", 
          RowBox[{"Im", "@", "z"}], ",", 
          RowBox[{"$reim", "@", 
           RowBox[{"solF1", "[", "r", "]"}]}]}], "}"}], "/.", 
        RowBox[{"z", "->", 
         RowBox[{"theZ", "[", "r", "]"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", "rStart", ",", "rEnd"}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Thickness", "[", "0.01", "]"}], ",", "Blue"}], "}"}]}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wStart", "=", 
     RowBox[{"wVals", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wDeriv", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"w", "'"}], "[", "r", "]"}], "\[Equal]", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            FractionBox[
             RowBox[{"D", "[", 
              RowBox[{"$theFunction", ",", "z"}], "]"}], 
             RowBox[{"D", "[", 
              RowBox[{"$theFunction", ",", "w"}], "]"}]], ")"}]}], " ", 
          RowBox[{"(", 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"theZ", "[", "r", "]"}], ",", "r"}], "]"}], ")"}]}], 
         ")"}], "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"w", "\[Rule]", 
           RowBox[{"w", "[", "r", "]"}]}], ",", 
          RowBox[{"z", "\[Rule]", 
           RowBox[{"theZ", "[", "r", "]"}]}]}], "}"}]}], ")"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"solF2", "=", 
     RowBox[{"NDSolveValue", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"wDeriv", ",", 
         RowBox[{
          RowBox[{"w", "[", "rStart", "]"}], "\[Equal]", "wStart"}]}], "}"}], 
       ",", "w", ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", "rStart", ",", "rEnd"}], "}"}], ",", 
       RowBox[{"WorkingPrecision", "->", "20"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pp2", "=", 
     RowBox[{"ParametricPlot3D", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Re", "@", "z"}], ",", 
          RowBox[{"Im", "@", "z"}], ",", 
          RowBox[{"$reim", "@", 
           RowBox[{"solF2", "[", "r", "]"}]}]}], "}"}], "/.", 
        RowBox[{"z", "->", 
         RowBox[{"theZ", "[", "r", "]"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", "rStart", ",", "rEnd"}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Thickness", "[", "0.01", "]"}], ",", "Red"}], "}"}]}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Show", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"difPlot", ",", "pp1", ",", "pp2"}], "}"}], ",", 
     RowBox[{"PlotRange", "->", "All"}]}], "]"}], 
   "\[IndentingNewLine]"}]}]], "Input",
