Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"tempF", "[", 
      RowBox[{"t_", ",", "a_", ",", "b_", ",", "c_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"a", " ", 
         RowBox[{"Sin", "[", "t", "]"}]}], "+", "b"}], ")"}], "+", 
      RowBox[{"I", 
       RowBox[{"(", 
