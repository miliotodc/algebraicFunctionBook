Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{"start", " ", "of", " ", "new", " ", "function"}], 
   "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{"first", " ", "get", " ", "checked", " ", "branches"}], 
   "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"checkedBranches", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"j", "=", "1"}], ",", 
      RowBox[{"j", "<=", 
       RowBox[{"Length", "@", "userSingRange"}]}], ",", 
      RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"theSingularChecks", "[", 
          RowBox[{"[", 
           RowBox[{"j", ",", "1"}], "]"}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"AppendTo", "[", 
           RowBox[{"checkedBranches", ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", 
              RowBox[{"userSingRange", "[", 
               RowBox[{"[", "j", "]"}], "]"}], ",", 
              RowBox[{"theBranchChecks", "[", 
               RowBox[{"[", 
                RowBox[{"j", ",", "All", ",", "1"}], "]"}], "]"}]}], "}"}]}], 
           "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]}], 
     "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
   "checkedBranches", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "@", "checkedBranches"}], "!=", "0"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", "\[IndentingNewLine]", " ", 
       RowBox[{"plots", " ", "selected"}], " ", "\[IndentingNewLine]", "*)"}],
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"branchPosArray", "=", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Flatten", "[", 
            RowBox[{"Position", "[", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "3", "]"}], "]"}], ",", 
              RowBox[{"y_", "/;", 
               RowBox[{"y", "==", "True"}]}]}], "]"}], "]"}], "&"}], "/@", 
          " ", "checkedBranches"}], ")"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"checkedSingularIndexes", "=", 
        RowBox[{"checkedBranches", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"branchMonodromies", "=", 
        RowBox[{"MapThread", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"singularMonodromyList", "[", 
            RowBox[{"[", 
             RowBox[{"#1", ",", "#2"}], "]"}], "]"}], "&"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"checkedBranches", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", " ", 
            "branchPosArray"}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{"$printMenuDiagnostics", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"\"\<checkedBranches: \>\"", ",", "checkedBranches"}], 
           "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<branchPosArray: \>\"", ",", "branchPosArray"}], "]"}],
           ";", "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{
           "\"\<singular indexes: \>\"", ",", "checkedSingularIndexes"}], 
           "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<branch indexes: \>\"", ",", "branchPosArray"}], "]"}],
           ";", "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<branchMonodromies: \>\"", ",", "branchMonodromies"}], 
           "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"selectedColorList", "=", 
        RowBox[{"branchColors", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"$colorOffset", "+", "1"}], ";;", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Length", "@", 
              RowBox[{"Flatten", "@", "branchMonodromies"}]}], "+", 
             "$colorOffset"}], ")"}]}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"colorIndex", "=", "0"}], ";", "\[IndentingNewLine]", 
       RowBox[{"plotTable", "=", 
        RowBox[{"Table", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"colorIndex", "++"}], ";", "\[IndentingNewLine]", 
            RowBox[{"currentSingIndex", "=", 
             RowBox[{"checkedBranches", "[", 
              RowBox[{"[", 
               RowBox[{"userSingIndex", ",", "2"}], "]"}], "]"}]}], ";", 
            "\[IndentingNewLine]", " ", 
            RowBox[{"theSingularPoint", "=", 
             RowBox[{"$theSingularList", "[", 
              RowBox[{"[", "currentSingIndex", "]"}], "]"}]}], ";", 
            "\[IndentingNewLine]", "\[IndentingNewLine]", 
            "\[IndentingNewLine]", 
            RowBox[{"singularMonodromy", "=", 
             RowBox[{"branchMonodromies", "[", 
