Cell[CellGroupData[{

Cell["Section 4.3:  Update annulusTable with singular monodromies", \
"Subsection",
 CellChangeTimes->{{3.9403188395646243`*^9, 3.940318851499324*^9}, {
  3.9819889107176156`*^9, 3.981988913528361*^9}, {3.9819918191005573`*^9, 
  3.981991819727728*^9}, {3.994227424807334*^9, 
  3.9942274250989485`*^9}},ExpressionUUID->"aa32e60a-b418-40bd-8af9-\
e42698607cbf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"singularMonodromyFlag", "==", "True"}], ",", 
     "\[IndentingNewLine]", "    ", 
     RowBox[{
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "1"}], ",", 
        RowBox[{"i", "<=", 
         RowBox[{"Length", "@", "singularMonodromies"}]}], ",", 
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"pos", "=", 
          RowBox[{
           RowBox[{"Position", "[", 
            RowBox[{
             RowBox[{"annulusTableR", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
             RowBox[{"x_", "/;", 
              RowBox[{"x", "==", "i"}]}]}], "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"annulusTableR", "[", 
           RowBox[{"[", 
            RowBox[{"pos", ",", "6"}], "]"}], "]"}], "=", 
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"singularMonodromies", "[", 
             RowBox[{"[", "i", "]"}], "]"}], ",", "Blue", ",", "12"}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"pos", "=", 
          RowBox[{
           RowBox[{"Position", "[", 
            RowBox[{
             RowBox[{"annulusTable", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
             RowBox[{"x_", "/;", 
              RowBox[{"x", "==", "i"}]}]}], "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", " ", 
         RowBox[{
          RowBox[{"annulusTable", "[", 
           RowBox[{"[", 
            RowBox[{"pos", ",", "6"}], "]"}], "]"}], "=", 
          RowBox[{"singularMonodromies", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], ";"}]}], "\[IndentingNewLine]", 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"annulusTableReport", "=", 
       RowBox[{"Prepend", "[", 
        RowBox[{"annulusTableR", ",", 
         RowBox[{"{", 
          RowBox[{
          "\"\<\!\(\*SubscriptBox[\(a\), \(n\)]\)\>\"", ",", 
           "\"\<\!\(\*SubscriptBox[\(s\), \(n\)]\)\>\"", ",", 
           "\"\<Annuli\>\"", ",", "\"\<Perim\>\"", ",", "\"\<Arg\>\"", ",", 
           "\"\<Monodromy\>\"", ",", "\"\<support\>\"", ",", "\"\<Cont\>\"", 
           ",", "\"\< \>\"", ",", "\"\< \>\""}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"Labeled", "[", 
        RowBox[{
         RowBox[{"Grid", "[", 
          RowBox[{"annulusTableReport", ",", 
           RowBox[{"Dividers", "\[Rule]", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"{", "True", "}"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"True", ",", "True", ",", 
                RowBox[{"{", "False", "}"}], ",", "True"}], "}"}]}], 
             "}"}]}]}], "]"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{"$theTestCase", ",", "14", ",", "Bold"}], "]"}], ",", 
         "Top"}], "]"}], "]"}], ";"}], "\[IndentingNewLine]", ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Print", "[", 
       RowBox[{"Style", "[", 
        RowBox[{
        "\"\<Unable to update annular table due to inconsistent singular \
monodromies!\>\"", ",", "Red"}], "]"}], "]"}], ";"}]}], "\[IndentingNewLine]",
     "]"}], ";"}], "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.993798518177799*^9, 3.99379851874949*^9}, {
  3.993895648643669*^9, 3.99389566544037*^9}, {3.993898303569831*^9, 
  3.993898349061386*^9}, {3.993898381082786*^9, 3.9938983954875937`*^9}, {
  3.9940585676329784`*^9, 3.9940585687307696`*^9}, {3.994144297770688*^9, 
  3.9941443567810106`*^9}, {3.9942624397665715`*^9, 3.9942624513979254`*^9}},
 CellLabel->
  "In[143]:=",ExpressionUUID->"de839241-5092-4f9e-bb99-34dbad2cc8a9"],

Cell[BoxData[
 TemplateBox[{
   TagBox[
    GridBox[{{
      "\"\\!\\(\\*SubscriptBox[\\(a\\), \\(n\\)]\\)\"", 
       "\"\\!\\(\\*SubscriptBox[\\(s\\), \\(n\\)]\\)\"", "\"Annuli\"", 
       "\"Perim\"", "\"Arg\"", "\"Monodromy\"", "\"support\"", "\"Cont\"", 
       "\" \"", "\" \""}, {"\" \"", "1", 
       StyleBox[
       "0", StripOnInput -> False, LineColor -> RGBColor[1, 0, 0], 
        FrontFaceColor -> RGBColor[1, 0, 0], BackFaceColor -> 
        RGBColor[1, 0, 0], GraphicsColor -> RGBColor[1, 0, 0], FontColor -> 
        RGBColor[1, 0, 0]], "0.16666666666666666`", "\" \"", 
       StyleBox[
        RowBox[{"{", 
          RowBox[{
            RowBox[{"{", "1", "}"}], ",", 
            RowBox[{"{", "2", "}"}], ",", 
            RowBox[{"{", "3", "}"}]}], "}"}], StripOnInput -> False, 
        LineColor -> RGBColor[0, 0, 1], FrontFaceColor -> RGBColor[0, 0, 1], 
        BackFaceColor -> RGBColor[0, 0, 1], GraphicsColor -> 
        RGBColor[0, 0, 1], FontSize -> 12, FontColor -> RGBColor[0, 0, 1]], 
       "\" \"", 
       RowBox[{"{", "}"}], "\" \"", "\" \""}, {"1", "\" \"", 
