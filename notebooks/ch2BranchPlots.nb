           RowBox[{"Re", "@", 
            RowBox[{"solF1", "[", 
             RowBox[{"Pi", "/", "4"}], "]"}]}]}], "}"}], "]"}]}], "}"}]}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"arrow1", "=", 
     RowBox[{"Graphics3D", "@", 
      RowBox[{"{", 
       RowBox[{"Yellow", ",", 
        RowBox[{"Arrowheads", "[", "0.04", "]"}], ",", 
        RowBox[{"Arrow", "[", "arrowPts", "]"}]}], "}"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"p03D", "=", 
