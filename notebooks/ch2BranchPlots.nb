Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"tempF", "[", 
      RowBox[{"t_", ",", "a_", ",", "b_", ",", "c_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"a", " ", 
         RowBox[{"Sin", "[", "t", "]"}]}], "+", "b"}], ")"}], "+", 
      RowBox[{"I", 
       RowBox[{"(", 
        RowBox[{"c", " ", 
         RowBox[{"Sin", "[", "t", "]"}], " ", 
         RowBox[{"Cos", "[", "t", "]"}]}], ")"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ParametricPlot", "[", 
      RowBox[{
       RowBox[{"ReIm", "@", 
        RowBox[{"tempF", "[", 
         RowBox[{"t", ",", "a", ",", "b", ",", "c"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", 
         RowBox[{"-", "Pi"}], ",", "Pi"}], "}"}], ",", 
       RowBox[{"PlotRange", "->", "2"}]}], "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", "1"}], "}"}], ",", "0.5", ",", "2"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"b", ",", 
         RowBox[{"1", "/", "2"}]}], "}"}], ",", "0.1", ",", "2"}], "}"}], ",",
      "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"c", ",", "1"}], "}"}], ",", "0.25", ",", "2"}], "}"}]}], 
    "\[IndentingNewLine]", "]"}]}]}]], "Input",
