    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"wDeriv", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"w", "'"}], "[", "t", "]"}], "\[Equal]", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", 
