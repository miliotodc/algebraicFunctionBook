   "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"toMonomialBoxes", "[", 
      RowBox[{"power_", ",", 
       RowBox[{"RowBox", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<-\>\"", ",", "\"\<1\>\""}], "}"}], "]"}]}], "]"}], ":=", 
     RowBox[{"RowBox", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<-\>\"", ",", "power"}], "}"}], "]"}]}], ";"}], "\n", 
   RowBox[{
