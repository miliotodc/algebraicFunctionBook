                "\"\<Found one cycle indeterminants at this singular \
point\>\"", ",", "Red"}], "]"}], "]"}], ";", "\[IndentingNewLine]", 
              RowBox[{"resultGrid", "=", 
               RowBox[{"MapThread", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"#1", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", 
                    RowBox[{
                    RowBox[{"#1", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "//", "N"}], ",", 
