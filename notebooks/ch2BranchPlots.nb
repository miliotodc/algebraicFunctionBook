Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{"integrate", " ", "G", 
     RowBox[{"(", "t", ")"}]}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"z", "^", 
       RowBox[{"(", 
        RowBox[{"1", "/", "4"}], ")"}]}], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", "z"}], ")"}], "^", 
       RowBox[{"(", 
        RowBox[{"1", "/", "4"}], ")"}]}], " ", "over", " ", "figure"}], "-", 
     RowBox[{"8", " ", "contour"}]}]}], "\[IndentingNewLine]", "*)"}], " ", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"tStart", "=", 
     RowBox[{"-", "Pi"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tEnd", "=", "Pi"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"theZ", "[", "t_", "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Sin", "[", "t", "]"}], "+", 
        RowBox[{"1", "/", "2"}]}], ")"}], "+", 
      RowBox[{"I", "  ", 
       RowBox[{"Sin", "[", "t", "]"}], " ", 
       RowBox[{"Cos", "[", "t", "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wVals1", "=", 
     RowBox[{"Sort", "@", 
      RowBox[{"NSolveValues", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"$theFunction", "==", "0"}], "/.", 
         RowBox[{"z", "->", 
          RowBox[{"theZ", "[", "tStart", "]"}]}]}], ",", "w", ",", 
        RowBox[{"WorkingPrecision", "->", "20"}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wStart1", "=", 
     RowBox[{"wVals1", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wDeriv", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"w", "'"}], "[", "t", "]"}], "\[Equal]", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            FractionBox[
             RowBox[{"D", "[", 
              RowBox[{"$theFunction", ",", "z"}], "]"}], 
             RowBox[{"D", "[", 
              RowBox[{"$theFunction", ",", "w"}], "]"}]], ")"}]}], " ", 
          RowBox[{"(", 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"theZ", "[", "t", "]"}], ",", "t"}], "]"}], ")"}]}], 
         ")"}], "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"w", "\[Rule]", 
           RowBox[{"w", "[", "t", "]"}]}], ",", 
          RowBox[{"z", "\[Rule]", 
           RowBox[{"theZ", "[", "t", "]"}]}]}], "}"}]}], ")"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"solF1", "=", 
     RowBox[{"NDSolveValue", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"wDeriv", ",", 
         RowBox[{
          RowBox[{"w", "[", "tStart", "]"}], "\[Equal]", "wStart1"}]}], "}"}],
        ",", "w", ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "tStart", ",", "tEnd"}], "}"}], ",", 
       RowBox[{"WorkingPrecision", "->", "20"}]}], "]"}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9672085942206593`*^9, 3.9672085958092813`*^9}, {
   3.9672197033638287`*^9, 3.967219704966821*^9}, 3.96753481670501*^9, {
