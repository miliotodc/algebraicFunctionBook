Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"tStart", "=", 
   RowBox[{"Pi", "/", "6"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"tEnd", "=", 
    RowBox[{
     RowBox[{"2", " ", "Pi"}], "+", 
     RowBox[{"Pi", "/", "6"}]}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"theZ", "[", "t_", "]"}], ":=", 
   RowBox[{"Exp", "[", 
    RowBox[{"I", " ", "t"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"wVals", "=", 
    RowBox[{"NSolveValues", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"$theFunction", "==", "0"}], "/.", 
       RowBox[{"z", "->", 
        RowBox[{"theZ", "[", "tStart", "]"}]}]}], ",", "w", ",", 
      RowBox[{"WorkingPrecision", "->", "25"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"wStart1", "=", 
   RowBox[{"Sqrt", "[", 
    RowBox[{"theZ", "[", "tStart", "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"wDeriv", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"w", "'"}], "[", "t", "]"}], "\[Equal]", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"(", 
           FractionBox[
            RowBox[{"D", "[", 
             RowBox[{"$theFunction", ",", "z"}], "]"}], 
            RowBox[{"D", "[", 
             RowBox[{"$theFunction", ",", "w"}], "]"}]], ")"}]}], " ", 
         RowBox[{"(", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"theZ", "[", "t", "]"}], ",", "t"}], "]"}], ")"}]}], 
        ")"}], "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"w", "\[Rule]", 
          RowBox[{"w", "[", "t", "]"}]}], ",", 
         RowBox[{"z", "\[Rule]", 
          RowBox[{"theZ", "[", "t", "]"}]}]}], "}"}]}], ")"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"solF1", "=", 
   RowBox[{"NDSolveValue", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"wDeriv", ",", 
       RowBox[{
        RowBox[{"w", "[", "tStart", "]"}], "\[Equal]", "wStart1"}]}], "}"}], 
     ",", "w", ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "tStart", ",", "tEnd"}], "}"}], ",", 
     RowBox[{"WorkingPrecision", "->", "20"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pp1", "=", 
   RowBox[{"ParametricPlot3D", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Re", "@", "z"}], ",", 
        RowBox[{"Im", "@", "z"}], ",", 
        RowBox[{"Re", "@", 
         RowBox[{"solF1", "[", "t", "]"}]}]}], "}"}], "/.", 
      RowBox[{"z", "->", 
       RowBox[{"theZ", "[", "t", "]"}]}]}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", 
       RowBox[{"tStart", "+", "0.1"}], ",", 
       RowBox[{"tEnd", "-", "0.1"}]}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Thickness", "[", "0.01", "]"}], ",", "Yellow"}], "}"}]}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"blackPt", "=", 
   RowBox[{"Graphics3D", "@", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"PointSize", "[", "0.025", "]"}], ",", "Black", ",", 
      RowBox[{"Point", "@", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Re", "@", 
          RowBox[{"theZ", "[", "tStart", "]"}]}], ",", 
         RowBox[{"Im", "@", 
          RowBox[{"theZ", "[", "tStart", "]"}]}], ",", 
         RowBox[{"Re", "@", 
          RowBox[{"solF1", "[", "tStart", "]"}]}]}], "}"}]}]}], "}"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"greenPt", "=", 
   RowBox[{"Graphics3D", "@", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"PointSize", "[", "0.025", "]"}], ",", 
      RowBox[{"Darker", "@", "Green"}], ",", 
      RowBox[{"Point", "@", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Re", "@", 
          RowBox[{"theZ", "[", "tEnd", "]"}]}], ",", 
         RowBox[{"Im", "@", 
          RowBox[{"theZ", "[", "tEnd", "]"}]}], ",", 
         RowBox[{"Re", "@", 
          RowBox[{"solF1", "[", "tEnd", "]"}]}]}], "}"}]}]}], "}"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<red point: \>\"", ",", 
   RowBox[{"solF1", "[", "tStart", "]"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<black point: \>\"", ",", 
   RowBox[{"solF1", "[", "tEnd", "]"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
