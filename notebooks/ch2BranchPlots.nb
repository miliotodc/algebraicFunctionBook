          RowBox[{"theZT39", "[", "t", "]"}], ",", "t"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "tStart", ",", "tEnd"}], "}"}]}], "]"}]}], ";"}], 
