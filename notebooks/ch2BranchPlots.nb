Cell[CellGroupData[{

Cell["Figure 8 contour over z^{1/2}(1-z)^{1/2}", "Subsection",
 CellChangeTimes->{{3.9693473434994373`*^9, 3.9693473455673513`*^9}, {
  3.969368379390811*^9, 
  3.969368386328555*^9}},ExpressionUUID->"5c58a70a-96dc-4e0b-9fd2-\
40d92bd34979"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"  ", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"G", "[", "z_", "]"}], ":=", 
    RowBox[{
     RowBox[{"z", "^", 
      RowBox[{"(", 
       RowBox[{"1", "/", "2"}], ")"}]}], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", "z"}], ")"}], "^", 
      RowBox[{"(", 
       RowBox[{"1", "/", "2"}], ")"}]}]}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"theZ", "[", "x_", "]"}], ":=", 
     RowBox[{"x", "+", 
      RowBox[{
       RowBox[{"1", "/", "4"}], " ", "I"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"xStart", "=", "0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"xEnd", "=", 
     RowBox[{"8", "/", "10"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wStart", "=", 
     RowBox[{"G", "[", 
      RowBox[{"theZ", "[", "xStart", "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wDeriv", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"w", "'"}], "[", "x", "]"}], "\[Equal]", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            FractionBox[
             RowBox[{"D", "[", 
              RowBox[{"$theFunction", ",", "z"}], "]"}], 
             RowBox[{"D", "[", 
              RowBox[{"$theFunction", ",", "w"}], "]"}]], ")"}]}], " ", 
          RowBox[{"(", 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"theZ", "[", "x", "]"}], ",", "x"}], "]"}], ")"}]}], 
         ")"}], "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"w", "\[Rule]", 
           RowBox[{"w", "[", "x", "]"}]}], ",", 
          RowBox[{"z", "\[Rule]", 
           RowBox[{"theZ", "[", "x", "]"}]}]}], "}"}]}], ")"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"leg1SolF", "=", 
     RowBox[{"NDSolveValue", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"wDeriv", ",", 
         RowBox[{
          RowBox[{"w", "[", "xStart", "]"}], "\[Equal]", "wStart"}]}], "}"}], 
       ",", "w", ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "xStart", ",", "xEnd"}], "}"}], ",", 
       RowBox[{"WorkingPrecision", "->", "20"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"leg2WStart", "=", 
     RowBox[{"leg1SolF", "[", "xEnd", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"leg1Plot", "=", 
     RowBox[{"ParametricPlot3D", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Re", "@", "z"}], ",", 
          RowBox[{"Im", "@", "z"}], ",", 
          RowBox[{"$reim", "@", 
           RowBox[{"leg1SolF", "[", "x", "]"}]}]}], "}"}], "/.", 
        RowBox[{"z", "->", 
         RowBox[{"theZ", "[", "x", "]"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "xStart", ",", "xEnd"}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Thickness", "[", "0.01", "]"}], ",", "Blue"}], "}"}]}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Show", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"difPlot", ",", "leg1Plot"}], "}"}], ",", 
     RowBox[{"PlotRange", "->", "All"}]}], "]"}], 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.970148792235094*^9, 3.9701490582034693`*^9}, {
  3.97014914744549*^9, 3.9701491566591196`*^9}, {3.970150396725398*^9, 
