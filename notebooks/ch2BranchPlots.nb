Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{"Length", "@", "plotTable"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dualPlot", "=", 
     RowBox[{"Show", "[", 
      RowBox[{"plotTable", ",", 
       RowBox[{"BoxRatios", "->", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1", ",", "1"}], "}"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"plotRange", "=", 
    RowBox[{"PlotRange", "[", "dualPlot", "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"xGrids", "=", 
     RowBox[{"Array", "[", 
      RowBox[{
       RowBox[{"#", "&"}], ",", "10", ",", 
       RowBox[{"plotRange", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"yGrids", "=", 
     RowBox[{"Array", "[", 
      RowBox[{
       RowBox[{"#", "&"}], ",", "10", ",", 
       RowBox[{"plotRange", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"difPlot", "=", 
    RowBox[{"Show", "[", 
     RowBox[{
      RowBox[{"{", "plotTable", "}"}], ",", 
      RowBox[{"AxesEdge", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", 
           RowBox[{"-", "1"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", 
           RowBox[{"-", "1"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", 
           RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], ",", 
      RowBox[{"Axes", "->", "True"}], ",", 
      RowBox[{"FaceGrids", "->", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "0", ",", 
            RowBox[{"-", "1"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"xGrids", ",", "yGrids"}], "}"}]}], "}"}], "}"}]}], ",", 
      RowBox[{"AxesLabel", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{"\"\<Re(z)\>\"", ",", "12", ",", "Bold", ",", "Black"}], 
          "]"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{"\"\<Im(z)\>\"", ",", "12", ",", "Bold", ",", "Black"}], 
          "]"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ToString", "@", "$reim"}], "<>", "\"\<(w)\>\""}], ",", 
           "12", ",", "Bold", ",", "Black"}], "]"}]}], "}"}]}], ",", 
      RowBox[{"FaceGridsStyle", "\[Rule]", 
       RowBox[{"Directive", "[", 
        RowBox[{"Black", ",", "Dotted"}], "]"}]}], ",", 
      RowBox[{"BoxRatios", "->", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "1", ",", "1"}], "}"}]}], ",", 
      RowBox[{"If", "[", 
       RowBox[{"$plotLabel", ",", 
        RowBox[{"PlotLabel", "->", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{"$reim", ",", "Bold", ",", "12", ",", "Black"}], "]"}], 
            ",", "\"\< \>\"", ",", 
            RowBox[{"Style", "[", 
             RowBox[{
              SubscriptBox["s", "currentSingIndex"], ",", "12", ",", "Bold", 
              ",", "Black"}], "]"}], ",", 
            RowBox[{"Style", "[", 
             RowBox[{"\"\<: \>\"", ",", "12", ",", "Bold", ",", "Black"}], 
             "]"}], ",", 
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"ToString", "@", "singularMonodromy"}], ",", "12", ",", 
              "Bold", ",", "Black"}], "]"}]}], "}"}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"PlotLabel", "->", "\"\<\>\""}]}], "\[IndentingNewLine]", 
       "]"}], ",", 
      RowBox[{"PlotRange", "->", "plotRange"}], ",", 
      RowBox[{"ImageSize", "->", "400"}]}], "]"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", "\[IndentingNewLine]", " ", 
    RowBox[{"save", " ", "plot", " ", "to", " ", "file"}], 
    "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{"$exportPlot", ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"$reim", "==", "Re"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"\"\<Exporting plot to \>\"", "<>", 
            RowBox[{"realPlotDataFileName", "[", "$theTestCase", "]"}]}], 
           "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"Export", "[", 
           RowBox[{
            RowBox[{"realPlotDataFileName", "[", "$theTestCase", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"plotTable", ",", "plotRange"}], "}"}]}], "]"}], ";"}], 
         "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"\"\<Exporting plot to \>\"", "<>", 
            RowBox[{"imagPlotDataFileName", "[", "$theTestCase", "]"}]}], 
           "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"Export", "[", 
           RowBox[{
            RowBox[{"imagPlotDataFileName", "[", "$theTestCase", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"plotTable", ",", "plotRange"}], "}"}]}], "]"}], ";"}]}],
         "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]"}]}]], "Input",
