                 RowBox[{"Print", "[", 
                  RowBox[{"cubicLine", "//", "N"}], "]"}]}], "]"}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"rTest", "=", 
                RowBox[{"Switch", "[", 
                 RowBox[{"bestFitPos", ",", "1", ",", 
                  RowBox[{"linearLine", "/.", 
                   RowBox[{"x", "->", "0"}]}], ",", "2", ",", 
                  RowBox[{"quadraticLine", "/.", 
                   RowBox[{"x", "->", "0"}]}], ",", "3", ",", 
