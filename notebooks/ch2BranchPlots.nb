Cell[BoxData[{
 RowBox[{
  RowBox[{"colors", "=", 
   RowBox[{"{", 
    RowBox[{
    "Red", ",", "Blue", ",", "Yellow", ",", "Green", ",", "Purple", ",", 
     "Orange", ",", "Magenta", ",", "Pink"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"colorIndex", "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"annularPlots", "=", 
   RowBox[{"Table", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"colorIndex", "++"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{
       "\"\<Generating plot for anulus \>\"", ",", "annularIndex", ",", 
        "\"\< branch index \>\"", ",", "branchIndex"}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"theBranchSet", "=", 
       RowBox[{"fullAnnularData", "[", 
        RowBox[{"[", 
         RowBox[{"annularIndex", ",", "branchIndex"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"totPts", "=", 
       RowBox[{"Length", "@", 
        RowBox[{"theBranchSet", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}]}], ";", " ", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"branchData", "=", "theBranchSet"}], ";", "\[IndentingNewLine]", 
      RowBox[{"pTable2", "=", 
       RowBox[{"Table", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"set1", "=", 
           RowBox[{"branchData", "[", 
            RowBox[{"[", "k", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"set2", "=", 
           RowBox[{"branchData", "[", 
            RowBox[{"[", 
             RowBox[{"k", "+", "1"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"set1", "[", 
             RowBox[{"[", "j", "]"}], "]"}], ",", 
            RowBox[{"set2", "[", 
             RowBox[{"[", "j", "]"}], "]"}], ",", 
            RowBox[{"set2", "[", 
             RowBox[{"[", 
              RowBox[{"j", "+", "1"}], "]"}], "]"}], ",", 
            RowBox[{"set1", "[", 
             RowBox[{"[", 
              RowBox[{"j", "+", "1"}], "]"}], "]"}]}], "}"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"k", ",", "1", ",", 
           RowBox[{
            RowBox[{"Length", "@", "branchData"}], "-", "1"}]}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"j", ",", "1", ",", 
           RowBox[{"totPts", "-", "1"}]}], "}"}]}], "\[IndentingNewLine]", 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"thePlot", "=", 
       RowBox[{"Graphics3D", "@", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Opacity", "[", "$opacity", "]"}], ",", 
          RowBox[{"branchColors", "[", 
           RowBox[{"[", "colorIndex", "]"}], "]"}], ",", 
          RowBox[{"Polygon", "[", 
           RowBox[{"Flatten", "[", 
            RowBox[{"pTable2", ",", "1"}], "]"}], "]"}]}], "}"}]}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"thePlot", "=", 
         RowBox[{"Graphics3D", "@", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Opacity", "[", "$opacity", "]"}], ",", 
            RowBox[{"theColorList", "[", 
             RowBox[{"[", "colorIndex", "]"}], "]"}], ",", 
            RowBox[{"Polygon", "[", 
             RowBox[{"Flatten", "[", 
              RowBox[{"pTable2", ",", "1"}], "]"}], "]"}]}], "}"}]}]}], ";"}],
        "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"fullPlot4", "=", 
       RowBox[{"Show", "[", 
        RowBox[{"thePlot", ",", 
         RowBox[{"AxesEdge", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", 
              RowBox[{"-", "1"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"1", ",", 
              RowBox[{"-", "1"}]}], "}"}], ",", 
            RowBox[{"{", 
