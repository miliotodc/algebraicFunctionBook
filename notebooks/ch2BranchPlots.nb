               RowBox[{
                RowBox[{"{", 
                 RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}], "/;", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Abs", "[", "b", "]"}], "<", 
                  RowBox[{"10", "^", 
                   RowBox[{"-", "20"}]}]}], " ", "&&", " ", 
                 RowBox[{
                  RowBox[{"Abs", "[", "c", "]"}], "<", 
                  RowBox[{"10", "^", 
                   RowBox[{"-", "20"}]}]}]}]}]}], "]"}], "//", "Flatten"}]}], 
