      RowBox[{"{", 
       RowBox[{"coeff", ",", "\"\< \>\"", ",", "power"}], "}"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"aForm", "[", "f_", "]"}], ":=", 
