                    ")"}]}]}]}]}]}], "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"nextNDZ", "=", 
           RowBox[{"nextSol", "[", 
