Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"G", "[", "z_", "]"}], ":=", 
   RowBox[{
    RowBox[{"z", "^", 
     RowBox[{"(", 
      RowBox[{"1", "/", "3"}], ")"}]}], 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", "z"}], ")"}], "^", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "2"}], "/", "3"}], ")"}]}]}]}]}]], "Input",
