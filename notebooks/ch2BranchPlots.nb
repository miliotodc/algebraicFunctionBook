Cell[CellGroupData[{

Cell["Section 5.2:  Update annular table with annular monodromies", \
"Subsection",
 CellChangeTimes->{{3.994140767376676*^9, 3.99414077869566*^9}, {
  3.994144401856537*^9, 3.9941444037226963`*^9}, {3.9942276277755923`*^9, 
  3.9942276289321356`*^9}},ExpressionUUID->"eaabc25f-8276-42a9-8080-\
8dbeb8f9c07f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"If", "[", 
    RowBox[{"checkMonodromyFlag", ",", "\[IndentingNewLine]", "    ", 
     RowBox[{
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "1"}], ",", 
