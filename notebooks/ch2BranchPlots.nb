Cell[CellGroupData[{

Cell["getBranchContinuations", "Subsection",
 CellChangeTimes->{{3.9289115079831915`*^9, 
  3.9289115115448947`*^9}},ExpressionUUID->"50af243e-844c-4fb5-ad11-\
985d4a20b703"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"getBranchContinuations", "[", 
     RowBox[{
     "nextSingularIndex_", ",", "currentBranchList_", ",", 
      "continuationSummary_", ",", "diagFlag_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "tempBranchList", ",", "nextBranch", ",", "nextBranchSheets", ",", 
        "currentPos", ",", "basePoleLinks", ",", "nextPoleLinks", ",", 
        "nextLinks", ",", "tempCLSPList"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"tempBranchList", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"tempCLSPList", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"nextBranch", "=", 
           RowBox[{"currentBranchList", "[", 
            RowBox[{"[", "index", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          
          RowBox[{"nextBranchSheets", "=", 
           RowBox[{"nextBranch", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{"diagFlag", ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{"\"\<nextBranch: \>\"", ",", "nextBranch"}], "]"}], ";",
              "\[IndentingNewLine]", 
             RowBox[{"Print", "[", 
              RowBox[{"\"\<nextBranchSheets: \>\"", ",", "nextBranchSheets"}],
               "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", "\[IndentingNewLine]", " ", 
           RowBox[{
           "now", " ", "check", " ", "if", " ", "these", " ", "branch", " ", 
            "sheets", " ", "are", " ", "continuous", " ", "to", " ", "last", 
            " ", "next", " ", "singular", " ", "point"}], 
           "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
          RowBox[{"(*", "  ", "*)"}], "\[IndentingNewLine]", 
          RowBox[{"currentPos", "=", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"Position", "[", 
                RowBox[{
                 RowBox[{"continuationSummary", "[", 
                  RowBox[{"[", 
                   RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", 
                 RowBox[{"x_", "/;", 
                  RowBox[{"x", "==", "#"}]}]}], "]"}], "&"}], "/@", " ", 
              "nextBranchSheets"}], ")"}], "//", "Flatten"}]}], " ", ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"basePoleLinks", "=", 
           RowBox[{
            RowBox[{"continuationSummary", "[", 
             RowBox[{"[", 
              RowBox[{"currentPos", ",", "3", ",", "2"}], "]"}], "]"}], "//", 
            "Flatten"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"nextPoleLinks", "=", 
           RowBox[{
            RowBox[{"continuationSummary", "[", 
             RowBox[{"[", 
              RowBox[{"currentPos", ",", "5", ",", "2"}], "]"}], "]"}], "//", 
            "Flatten"}]}], ";", "\[IndentingNewLine]", " ", 
          RowBox[{"nextLinks", "=", 
           RowBox[{"continuationSummary", "[", 
            RowBox[{"[", 
             RowBox[{"currentPos", ",", "4"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{"diagFlag", ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{
              "\"\<     Branch \>\"", ",", "nextBranch", ",", 
               "\"\< currentContinuationDataPos: \>\"", ",", "currentPos"}], 
              "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"Print", "[", 
              RowBox[{"\"\<     basePoleLinks: \>\"", ",", "basePoleLinks"}], 
              "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"Print", "[", 
              RowBox[{"\"\<     nextPoleLinks: \>\"", ",", "nextPoleLinks"}], 
              "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"Print", "[", 
              RowBox[{
               RowBox[{"Style", "[", 
                RowBox[{"\"\<     nextLinks: \>\"", ",", "Red"}], "]"}], ",", 
               "nextLinks"}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], 
          ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"nextLinks", "==", 
              RowBox[{"ConstantArray", "[", 
               RowBox[{"1", ",", 
                RowBox[{"Length", "@", "nextBranchSheets"}]}], "]"}]}], "  ", 
             "&&", "\[IndentingNewLine]", 
             RowBox[{"basePoleLinks", "==", 
              RowBox[{"{", "}"}]}], "  ", "&&", "\[IndentingNewLine]", 
             RowBox[{"nextPoleLinks", "==", 
              RowBox[{"{", "}"}]}]}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{
               RowBox[{"Style", "[", 
                RowBox[{"\"\<     Branch \>\"", ",", "Blue"}], "]"}], ",", 
               RowBox[{"Style", "[", 
                RowBox[{"nextBranch", ",", "Blue"}], "]"}], ",", 
               RowBox[{"Style", "[", 
                RowBox[{"\"\< continues onto sing index \>\"", ",", "Blue"}], 
                "]"}], ",", 
               RowBox[{"Style", "[", 
                RowBox[{"nextSingularIndex", ",", "Blue"}], "]"}]}], "]"}], 
             ";", "\[IndentingNewLine]", 
             RowBox[{"AppendTo", "[", 
              RowBox[{"tempBranchList", ",", "nextBranch"}], "]"}], ";"}], 
            "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{
               RowBox[{"Style", "[", 
                RowBox[{"\"\<     Branch \>\"", ",", "Red"}], "]"}], ",", 
               RowBox[{"Style", "[", 
                RowBox[{"nextBranch", ",", "Red"}], "]"}], ",", 
               RowBox[{"Style", "[", 
                RowBox[{
                "\"\< doesn't continue to next sing point\>\"", ",", "Red"}], 
                "]"}], ",", "nextSingularIndex"}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{"diagFlag", ",", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"Print", "[", 
                 RowBox[{
                 "\"\<     assigning \>\"", ",", "nextSingularIndex", ",", 
                  " ", "\"\< to CLSP\>\""}], "]"}], ";"}]}], 
              "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"AppendTo", "[", 
              RowBox[{"tempCLSPList", ",", 
               RowBox[{"{", 
                RowBox[{"nextBranch", ",", "nextSingularIndex"}], "}"}]}], 
              "]"}], ";"}]}], "\[IndentingNewLine]", "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"index", ",", "1", ",", 
           RowBox[{"Length", "@", "currentBranchList"}]}], "}"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<     tempCLSPList: \>\"", ",", "CLSPTable"}], "]"}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<     tempBranchList: \>\"", ",", "tempBranchList"}], 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"tempBranchList", ",", "tempCLSPList"}], "}"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.928826887868777*^9, 3.9288271983613696`*^9}, {
  3.9289116994556704`*^9, 3.928911729011155*^9}},
 CellLabel->"In[76]:=",ExpressionUUID->"0e050ec2-6729-423d-b179-784a7a2e88fb"]
}, Closed]],

