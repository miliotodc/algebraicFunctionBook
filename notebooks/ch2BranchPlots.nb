Cell[CellGroupData[{

Cell["getSingularMonodromyNew", "Subsection",
 CellChangeTimes->{{3.9292797409201126`*^9, 3.9292797439821234`*^9}, {
  3.994057170133586*^9, 
  3.9940571704404774`*^9}},ExpressionUUID->"57c39651-843e-4978-a730-\
ef7f3fec8fb6"],

Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
   "get", " ", "differential", " ", "monodromy", " ", "around", " ", "a", " ",
     "singular", " ", "point"}], "\[IndentingNewLine]", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Options", "[", "getSingularMonodromyNew", "]"}], "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<nSolveWP\>\"", "->", "50"}], ",", 
       RowBox[{"\"\<integrateWP\>\"", "->", "50"}], ",", 
       RowBox[{"\"\<polishWP\>\"", "->", "20"}], ",", 
       RowBox[{"\"\<diagFlag\>\"", "->", "False"}], ",", 
       RowBox[{"\"\<stiffFlag\>\"", "->", "False"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"getSingularMonodromyNew", "[", 
     RowBox[{"theSingularIndex_", ",", "rNorm_", ",", 
      RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "z0", ",", "singularRoots", ",", "wArray", ",", "branchVals", ",", 
        "polishedVals", ",", "pArray", ",", "theCycles", ",", "theLinks", ",",
         "oneCycles", ",", "finalCycles", ",", "flag", ",", 
        "theSingularPoint"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{"\"\<nSolveWP: \>\"", ",", 
          RowBox[{"OptionValue", "[", "\"\<nSolveWP\>\"", "]"}]}], "]"}], 
        ";"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"theSingularPoint", "=", 
        RowBox[{"$theSingularList", "[", 
         RowBox[{"[", "theSingularIndex", "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"z0", "=", 
        RowBox[{"theSingularPoint", "+", 
         RowBox[{"rNorm", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"I", " ", "$thetaV"}], "]"}]}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"\"\<z0: \>\"", ",", 
           RowBox[{"z0", "//", "N"}]}], "]"}], ";"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"singularRoots", "=", 
        RowBox[{"Sort", "[", 
         RowBox[{"w", "/.", 
          RowBox[{"NSolve", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"$theFunction", "==", "0"}], "/.", 
             RowBox[{"z", "->", "z0"}]}], ",", "w", ",", 
            RowBox[{"WorkingPrecision", "->", 
             RowBox[{"OptionValue", "[", "\"\<nSolveWP\>\"", "]"}]}]}], 
           "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"wArray", "=", 
        RowBox[{"MapThread", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"#1", ",", "#2"}], "}"}], "&"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Range", "[", 
             RowBox[{"Length", "@", "singularRoots"}], "]"}], ",", 
            "singularRoots"}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", " ", 
       RowBox[{"branchVals", "=", 
        RowBox[{"integrateOverSheet", "[", 
         RowBox[{
         "z0", ",", "theSingularPoint", ",", "$thetaV", ",", "wArray", ",", 
          "rNorm", ",", 
          RowBox[{"OptionValue", "[", "\"\<stiffFlag\>\"", "]"}], ",", 
          RowBox[{"OptionValue", "[", "\"\<integrateWP\>\"", "]"}]}], "]"}]}],
        ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"polishedVals", "=", 
        RowBox[{"polishBranchTerms", "[", 
         RowBox[{"z0", ",", "branchVals", ",", 
          RowBox[{"OptionValue", "[", "\"\<polishWP\>\"", "]"}]}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"OptionValue", "[", "\"\<diagFlag\>\"", "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"\"\<     polishedVals: \>\"", ",", 
            RowBox[{
             RowBox[{"polishedVals", "//", "N"}], "//", "MatrixForm"}]}], 
           "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"pArray", "=", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Position", "[", 
            RowBox[{
             RowBox[{"polishedVals", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
             RowBox[{"x_", "/;", 
              RowBox[{
               RowBox[{"Abs", "[", 
                RowBox[{"x", "-", "#"}], "]"}], "<", 
               RowBox[{"10", "^", 
                RowBox[{"-", "20"}]}]}]}]}], "]"}], "&"}], "/@", " ", 
          RowBox[{"polishedVals", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "3"}], "]"}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"theCycles", "=", 
        RowBox[{"PermutationCycles", "[", "pArray", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"theLinks", "=", 
        RowBox[{"theCycles", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"oneCycles", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"{", "#", "}"}], "&"}], "/@", 
         RowBox[{"Complement", "[", 
          RowBox[{
           RowBox[{"Range", "[", "functionDegree", "]"}], ",", 
           RowBox[{"Flatten", "[", "theLinks", "]"}]}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"finalCycles", "=", 
        RowBox[{"Join", "[", 
         RowBox[{"theLinks", ",", "oneCycles"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<     finalCycles: \>\"", ",", "finalCycles"}], "]"}], 
       ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Sort", "[", 
           RowBox[{"Flatten", "@", "finalCycles"}], "]"}], "!=", 
          RowBox[{"Range", "[", 
           RowBox[{"Length", "@", 
            RowBox[{"Flatten", "@", "finalCycles"}]}], "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"Style", "[", 
             RowBox[{"\"\<Monodromy is not consistent!\>\"", ",", "Red"}], 
             "]"}], "]"}], ";"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"flag", "=", "False"}], ";"}], "\[IndentingNewLine]", ",", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"Style", "[", "\"\<Monodromy is consistent\>\"", "]"}], 
            "]"}], ";"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"flag", "=", "True"}], ";"}]}], "\[IndentingNewLine]", 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"finalCycles", ",", "polishedVals", ",", 
         RowBox[{"{", 
          RowBox[{"theSingularIndex", ",", "flag"}], "}"}]}], "}"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]"}]}]], "Input",
