Cell[CellGroupData[{

Cell["\<\
Section 4:  Compute/retrieve singular monodromies, update annular table and \
export singular data to file\
\>", "Section",
 CellChangeTimes->{
  3.9942279704785643`*^9},ExpressionUUID->"c72035eb-9a24-4cd0-8e5a-\
4b2d29d296fe"],

Cell["\<\
This section need be executed once to compute the singular and annular \
monodromies and update the annular table and export it to file.  After which, \
reopening the notebook and selecting the same test case, the user can go \
directly to Section 4 and import the annular table and proceed with the next \
sections.\
\>", "Text",
 CellChangeTimes->{{3.981995415052065*^9, 
  3.9819955374818697`*^9}},ExpressionUUID->"5374335e-0621-440e-a9d2-\
36f225079d61"],

Cell[CellGroupData[{

Cell["\<\
Section 4.1:  Compute  singular monodromies using getSingularMonodromy \
\>", "Subsection",
 CellChangeTimes->{{3.9569936670016565`*^9, 3.9569936713671722`*^9}, {
   3.9819889012984695`*^9, 3.981988903873689*^9}, {3.981991271438119*^9, 
   3.9819912763752155`*^9}, {3.981991762056699*^9, 3.9819917696675572`*^9}, {
   3.981991814613413*^9, 3.981991815240613*^9}, {3.981992316214319*^9, 
   3.9819923288616285`*^9}, {3.9861341342275496`*^9, 3.986134140725154*^9}, 
   3.98648756769886*^9, {3.99408543252847*^9, 3.994085432802682*^9}, {
   3.9942279856614656`*^9, 
   3.9942279860640917`*^9}},ExpressionUUID->"d013935e-bd81-44d4-a464-\
2323423f3bf8"],

Cell["\<\
This routine will attempt to compute the monodromies with stiffness switching \
set to false first for speed.  If an inconsistent monodromy is encountered,  \
then the method changes to stiffness switching True.  If the monodromy is \
still inconsistent, an error message is reported and the analysis stops.  At \
this point, the affected annular domain should be analyzed separately with \
higher nSolveWP, integrateWP and or polishWP to obtain if possible a \
consistent monodromy.\
\>", "Text",
 CellChangeTimes->{{3.9942622601209617`*^9, 
  3.9942622681894817`*^9}},ExpressionUUID->"6c5a3606-b101-4fa8-8acb-\
93bafd1be2bf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"singularMonodromyData", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"singularIndexes", "=", 
     RowBox[{"Range", "[", 
      RowBox[{"Length", "@", "$theSingularList"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"consistencyFlag", "=", "True"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sIndex", "=", "0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"While", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"sIndex", "<", 
        RowBox[{"Length", "@", "$theSingularList"}]}], " ", "&&", " ", 
       RowBox[{"consistencyFlag", "==", "True"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"sIndex", "++"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"\"\<Analyzing singular index: \>\"", "<>", 
           RowBox[{"ToString", "@", "sIndex"}]}], ",", "Bold", ",", "Black"}],
          "]"}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"rNorm", "=", 
        RowBox[{"$minRadiusArray", "[", 
         RowBox[{"[", "sIndex", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"\"\<rNorm: \>\"", ",", 
           RowBox[{"rNorm", "//", "N"}]}], "]"}], ";"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "baseSingularMonodromy", ",", "basePolishedValues", ",", "flag"}], 
         "}"}], "=", 
        RowBox[{"getSingularMonodromyNew", "[", 
         RowBox[{"sIndex", ",", "rNorm", ",", 
          RowBox[{"\"\<stiffFlag\>\"", "->", "False"}], ",", 
          RowBox[{"\"\<nSolveWP\>\"", "->", "50"}], ",", 
          RowBox[{"\"\<integrateWP\>\"", "->", "50"}], ",", 
          RowBox[{"\"\<polishWP\>\"", "->", "20"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"flag", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "==", "False"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"Style", "[", 
            RowBox[{
            "\"\<     Inconsistent monodromy.  Switching to Stiffness Method \
. . .\>\"", ",", "Red"}], "]"}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
            "baseSingularMonodromy", ",", "basePolishedValues", ",", "flag"}],
             "}"}], "=", 
           RowBox[{"getSingularMonodromyNew", "[", 
            RowBox[{"sIndex", ",", "rNorm", ",", 
             RowBox[{"\"\<stiffFlag\>\"", "->", "True"}], ",", 
             RowBox[{"\"\<nSolveWP\>\"", "->", "50"}], ",", 
             RowBox[{"\"\<integrateWP\>\"", "->", "50"}], ",", 
             RowBox[{"\"\<polishWP\>\"", "->", "20"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"flag", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "==", "False"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{"Style", "[", 
               RowBox[{
               "\"\<     Inconsistent monodromy found with Stiffness method.  \
Try increasing precision for nSolveWP, integrateWP and polishWP.\>\"", ",", 
                "Red"}], "]"}], "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"consistencyFlag", "=", "False"}], ";"}], 
            "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{"Style", "[", 
               RowBox[{
                RowBox[{
                "\"\<     Found consistent monodromy for singular index \>\"",
                  "<>", 
                 RowBox[{"ToString", "[", "sIndex", "]"}], "<>", 
                 "\"\< using stiffness switching method\>\""}], ",", "Black", 
                ",", "Bold"}], "]"}], "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"AppendTo", "[", 
              RowBox[{"singularMonodromyData", ",", 
               RowBox[{"{", 
                RowBox[{"baseSingularMonodromy", ",", "flag"}], "}"}]}], 
              "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], 
         "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{
             "\"\<     Found consistent monodromy for singular index \>\"", "<>", 
              RowBox[{"ToString", "[", "sIndex", "]"}]}], ",", "Black", ",", 
             "Bold"}], "]"}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"singularMonodromyData", ",", 
            RowBox[{"{", 
             RowBox[{"baseSingularMonodromy", ",", "flag"}], "}"}]}], "]"}], 
          ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]}], 
     "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"singularMonodromies", "=", 
     RowBox[{"singularMonodromyData", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"singularMonodromiesR", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{"#1", ",", "Blue", ",", "Bold"}], "]"}], "&"}], ",", 
         RowBox[{"singularMonodromies", "[", 
          RowBox[{"[", "sIndex", "]"}], "]"}]}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"sIndex", ",", "singularIndexes"}], "}"}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"MemberQ", "[", 
       RowBox[{
        RowBox[{"singularMonodromyData", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2", ",", "2"}], "]"}], "]"}], ",", "False"}], 
       "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"Style", "[", 
         RowBox[{"\"\<Found inconsistent monodromies!\>\"", ",", "Red"}], 
         "]"}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"singularMonodromyFlag", "=", "False"}], ";"}], 
      "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"Style", "[", 
         RowBox[{
         "\"\<All singular monodrimes are consistent!\>\"", ",", "Black", ",",
           "Bold", ",", "12"}], "]"}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"singularMonodromyFlag", "=", "True"}], ";"}]}], 
