Cell[CellGroupData[{

Cell["integrateOverAnnulus", "Subsection",
 CellChangeTimes->{{3.9291224122893615`*^9, 
  3.9291224164758153`*^9}},ExpressionUUID->"8656094c-f698-4ce5-a795-\
495b50ccd687"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"integrateOverAnnulus", "[", 
      RowBox[{
      "startTheta_", ",", "w0Table_", ",", "radius_", ",", "stiffnessFlag_", 
       ",", "wp_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "intTable", ",", "integrationPath", ",", "wDeriv", ",", "theSol", ",",
          "w0"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"PrintTemporary", "[", 
         RowBox[{"\"\<Integrating index \>\"", ",", 
          RowBox[{"Dynamic", "@", "np"}]}], "]"}], ";", "\[IndentingNewLine]",
         " ", 
        RowBox[{"intTable", "=", 
         RowBox[{"Table", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"np", "=", "n"}], ";", "\[IndentingNewLine]", 
            RowBox[{"w0", "=", 
             RowBox[{"w0Table", "[", 
              RowBox[{"[", 
               RowBox[{"n", ",", "2"}], "]"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"integrationPath", "[", "t_", "]"}], ":=", 
             RowBox[{"radius", " ", 
              RowBox[{"Exp", "[", 
               RowBox[{"I", " ", "t"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"wDeriv", "=", 
             RowBox[{
              RowBox[{
               RowBox[{"w", "'"}], "[", "t", "]"}], "\[Equal]", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"-", 
                   RowBox[{"(", 
                    FractionBox[
                    RowBox[{"D", "[", 
                    RowBox[{"$theFunction", ",", "z"}], "]"}], 
                    RowBox[{"D", "[", 
                    RowBox[{"$theFunction", ",", "w"}], "]"}]], ")"}]}], " ", 
                  
                  RowBox[{"D", "[", 
                   RowBox[{
                    RowBox[{"integrationPath", "[", "t", "]"}], ",", "t"}], 
                   "]"}]}], ")"}], "/.", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"w", "\[Rule]", 
                   RowBox[{"w", "[", "t", "]"}]}], ",", 
                  RowBox[{"z", "\[Rule]", 
                   RowBox[{"integrationPath", "[", "t", "]"}]}]}], "}"}]}], 
               ")"}]}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{"stiffnessFlag", ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"theSol", "=", 
                RowBox[{"NDSolveValue", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"wDeriv", ",", 
                    RowBox[{
                    RowBox[{"w", "[", "startTheta", "]"}], "\[Equal]", 
                    "w0"}]}], "}"}], ",", "w", ",", 
                  RowBox[{"{", 
                   RowBox[{"t", ",", "startTheta", ",", 
                    RowBox[{"startTheta", "+", 
                    RowBox[{"2", " ", "Pi"}]}]}], "}"}], ",", 
                  RowBox[{"MaxSteps", "\[Rule]", "2000000"}], ",", 
                  RowBox[{"MaxStepSize", "\[Rule]", 
                   RowBox[{"1", "/", "1000"}]}], ",", 
                  RowBox[{"WorkingPrecision", "\[Rule]", "wp"}], ",", 
                  RowBox[{"Method", " ", "\[Rule]", " ", 
                   RowBox[{"{", 
                    RowBox[{"\"\<StiffnessSwitching\>\"", ",", 
                    RowBox[{"\"\<NonstiffTest\>\"", "->", "False"}]}], 
                    "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", ",", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"theSol", "=", 
                RowBox[{"NDSolveValue", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"wDeriv", ",", 
                    RowBox[{
                    RowBox[{"w", "[", "startTheta", "]"}], "\[Equal]", 
                    "w0"}]}], "}"}], ",", "w", ",", 
                  RowBox[{"{", 
                   RowBox[{"t", ",", "startTheta", ",", 
                    RowBox[{"startTheta", "+", 
                    RowBox[{"2", " ", "Pi"}]}]}], "}"}], ",", 
                  RowBox[{"MaxSteps", "\[Rule]", "2000000"}], ",", 
                  RowBox[{"MaxStepSize", "\[Rule]", 
                   RowBox[{"1", "/", "1000"}]}], ",", 
                  RowBox[{"WorkingPrecision", "\[Rule]", "wp"}]}], "]"}]}], 
               ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", " ", 
             RowBox[{"save", " ", 
              RowBox[{"{", 
               RowBox[{"seriesIndex", ",", 
                RowBox[{"theSol", "[", "1", "]"}]}], "}"}]}], " ", "*)"}], 
            "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"w0Table", "[", 
               RowBox[{"[", 
                RowBox[{"n", ",", "1"}], "]"}], "]"}], ",", 
              RowBox[{"w0Table", "[", 
               RowBox[{"[", 
                RowBox[{"n", ",", "2"}], "]"}], "]"}], ",", 
              RowBox[{"theSol", "[", 
               RowBox[{"startTheta", "+", 
                RowBox[{"2", " ", "Pi"}]}], "]"}]}], "}"}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"n", ",", "1", ",", 
             RowBox[{"Length", "@", "w0Table"}]}], "}"}]}], 
          "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
        "intTable"}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.929122364473211*^9, 3.929122380781461*^9}, 
   3.9293631706805296`*^9, {3.972927012625284*^9, 3.9729270159524994`*^9}},
 CellLabel->"In[78]:=",ExpressionUUID->"181e87ff-4d5e-46e7-83bc-c29a686a288c"]
}, Closed]],

Cell[CellGroupData[{

Cell["getAnnularTemplate", "Subsection",
 CellChangeTimes->{{3.941905389118188*^9, 
  3.941905392195545*^9}},ExpressionUUID->"cc393654-812d-43a2-b9da-\
06c0e762f0f7"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"getAnnularTemplate", "[", "theFunction_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "res", ",", "theSingularSet", ",", "singAccuracy", ",", 
         "theSingularList", ",", "argList", ",", "zeroIndexes", ",", 
         "poleIndexes", ",", "nearestSing", ",", "nearestDist", ",", 
         "minRadiusArray", ",", "singularPerimeters", ",", "absVals", ",", 
         "ringSize", ",", "tempRings", ",", "theAnnuli", ",", 
         "ringMemberSingularIndexes", ",", "radiiTable", ",", "annularSizes", 
         ",", "annularCenters", ",", "singTable", ",", "annulusTable", ",", 
         "annulusTableR", ",", "ringSizes", ",", "minRingSize", ",", 
         "tableIndex", ",", "j", ",", "annulusTableReport", ",", 
         "annularTableAnnularIndexes", ",", "plottingRadiiTable", ",", 
         "newTable", ",", "theReturn", ",", "annularTableSingularIndexes", 
         ",", "i", " ", ",", "theNormDist", ",", "thePerimDist", ",", 
         "theNearestDistance"}], "}"}], ",", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"totalIntegrationSteps", "=", "1500000"}], ";"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"maxStepSize", "=", "0.0001"}], ";"}], "*)"}], 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"ringDelta", "=", 
          RowBox[{"1", "/", "20000"}]}], ";"}], "*)"}], " ", 
       RowBox[{"(*", " ", 
        RowBox[{"ring", " ", "separation", " ", "threshold"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"minRingSize", "=", 
         RowBox[{"1", "/", "2000"}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"res", "=", 
         RowBox[{"Resultant", "[", 
          RowBox[{"theFunction", ",", 
           RowBox[{"D", "[", 
            RowBox[{"theFunction", ",", "w"}], "]"}], ",", "w"}], "]"}]}], 
        ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"theSingularSet", "=", 
         RowBox[{"Sort", "[", 
          RowBox[{
           RowBox[{"z", "/.", 
            RowBox[{"NSolve", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Simplify", "@", "res"}], "\[Equal]", "0"}], ",", "z", 
              ",", 
              RowBox[{"WorkingPrecision", "\[Rule]", "$workingPrecision"}]}], 
             "]"}]}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "@", "#1"}], "<=", " ", 
             RowBox[{"Abs", "@", "#2"}]}], "&"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"\"\<theSingularSet: \>\"", ",", 
            RowBox[{"theSingularSet", "//", "N"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<Precision of theSingularSet: \>\"", ",", 
            RowBox[{"Precision", "@", "theSingularSet"}]}], "]"}], ";"}], 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{"singAccuracy", "=", 
         RowBox[{"Floor", "@", 
          RowBox[{"Accuracy", "@", "theSingularSet"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"\"\<singAccuracy: \>\"", ",", "singAccuracy"}], "]"}], 
          ";"}], "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"(*", "\[IndentingNewLine]", " ", 
         RowBox[{
         "final", " ", "form", " ", "of", " ", "the", " ", "singular", " ", 
          "list"}], "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Precision", "@", "theSingularSet"}], "==", 
           "\[Infinity]"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"theSingularList", "=", 
            RowBox[{"DeleteDuplicates", "[", "theSingularSet", "]"}]}], ";"}],
           "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"Print", "[", "\"\<finite precision\>\"", "]"}], ";"}], 
           "*)"}], "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"theSingularList", "=", 
            RowBox[{"DeleteDuplicates", "[", 
             RowBox[{"theSingularSet", ",", 
              RowBox[{
               RowBox[{
                RowBox[{"Abs", "[", 
                 RowBox[{"#1", "-", "#2"}], "]"}], "<", 
                RowBox[{"10", "^", 
                 RowBox[{"-", 
                  RowBox[{"(", 
                   RowBox[{"singAccuracy", "-", "$accuracyComparisonFactor"}],
                    ")"}]}]}]}], "&"}]}], "]"}]}], ";"}]}], 
         "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"\"\<Unique singular points: \>\"", ",", 
            RowBox[{"theSingularList", "//", "N"}]}], "]"}], ";"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"(*", "\[IndentingNewLine]", " ", 
         RowBox[{
          RowBox[{
          "get", " ", "arguments", " ", "of", " ", "singular", " ", "points", 
           " ", "argList"}], ",", "zeroIndexes", ",", "poleIndexes", ",", 
          "nearestSing", ",", "nearestDist"}], "\[IndentingNewLine]", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"argList", "=", 
         RowBox[{"Arg", "@", "theSingularList"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", "\[IndentingNewLine]", " ", 
         RowBox[{
          RowBox[{
          "now", " ", "get", " ", "zero", " ", "points", " ", "a_", "0", 
           RowBox[{"(", "z", ")"}]}], "=", 
          RowBox[{
           RowBox[{"0", " ", "when", " ", "either", " ", "$a_", "1", 
            RowBox[{"(", "z", ")"}]}], "=", 
           RowBox[{
            RowBox[{"0", " ", "or", " ", "$a_", "0"}], "=", 
            RowBox[{"a_", "1"}]}]}]}], "\[IndentingNewLine]", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"zeroIndexes", "=", 
         RowBox[{"getZeroIndexes", "[", 
          RowBox[{"theFunction", ",", "theSingularList", ",", "False"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", "\[IndentingNewLine]", 
         RowBox[{"get", " ", "poles"}], " ", "\[IndentingNewLine]", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"poleIndexes", "=", 
         RowBox[{"getPoles", "[", 
          RowBox[{"theFunction", ",", "theSingularList", ",", "False"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"\"\<$poleIndexes: \>\"", ",", "poleIndexes"}], "]"}], 
          ";"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"(*", "\[IndentingNewLine]", " ", 
         RowBox[{
          RowBox[{
          "compute", " ", "minArray", " ", "of", " ", "integration", " ", 
           "region", " ", "around", " ", "each", " ", "singular", " ", 
           "point", " ", "if", " ", "total"}], " ", ">", " ", "1"}], " ", 
         "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "@", "theSingularList"}], ">", "1"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"nearestSing", "=", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"NearestTo", "[", 
                  RowBox[{"#1", ",", "2"}], "]"}], "[", "theSingularList", 
                 "]"}], "&"}], "/@", " ", "theSingularList"}], ")"}], "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"nearestDist", "=", 
            RowBox[{"MapThread", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"1", "/", "3"}], 
                RowBox[{"Abs", "[", 
                 RowBox[{"#1", "-", "#2"}], "]"}]}], "&"}], ",", 
              RowBox[{"{", 
               RowBox[{"theSingularList", ",", "nearestSing"}], "}"}]}], 
             "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{"theNormDist", "=", 
              RowBox[{"MapThread", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"1", "/", "2"}], 
                  RowBox[{"Abs", "[", 
                   RowBox[{"#1", "-", "#2"}], "]"}]}], "&"}], ",", 
                RowBox[{"{", 
                 RowBox[{"theSingularList", ",", "nearestSing"}], "}"}]}], 
               "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"thePerimDist", "=", 
              RowBox[{"MapThread", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"1", "/", "3"}], 
                  RowBox[{"Abs", "[", 
                   RowBox[{"#1", "-", "#2"}], "]"}]}], "&"}], ",", 
                RowBox[{"{", 
                 RowBox[{"theSingularList", ",", "nearestSing"}], "}"}]}], 
               "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"theNearestDistance", "=", 
              RowBox[{"MapThread", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Abs", "[", 
                  RowBox[{"#1", "-", "#2"}], "]"}], "&"}], ",", 
                RowBox[{"{", 
                 RowBox[{"theSingularList", ",", "nearestSing"}], "}"}]}], 
               "]"}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{"nearestSingDist", "=", 
              RowBox[{"MapThread", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Abs", "[", 
                  RowBox[{"#1", "-", "#2"}], "]"}], "&"}], ",", 
                RowBox[{"{", 
                 RowBox[{"theSingularList", ",", "nearestSing"}], "}"}]}], 
               "]"}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
           RowBox[{"$singularPerimeters", "=", 
            RowBox[{"MapThread", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"1", "/", "3"}], 
                RowBox[{"Abs", "[", 
                 RowBox[{"#1", "-", "#2"}], "]"}]}], "&"}], ",", 
              RowBox[{"{", 
               RowBox[{"theSingularList", ",", "nearestSing"}], "}"}]}], 
             "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"$singularNorms", "=", 
            RowBox[{"MapThread", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"1", "/", "2"}], 
                RowBox[{"Abs", "[", 
                 RowBox[{"#1", "-", "#2"}], "]"}]}], "&"}], ",", 
              RowBox[{"{", 
               RowBox[{"theSingularList", ",", "nearestSing"}], "}"}]}], 
             "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"$singularDistances", "=", 
            RowBox[{"MapThread", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Abs", "[", 
                RowBox[{"#1", "-", "#2"}], "]"}], "&"}], ",", 
              RowBox[{"{", 
               RowBox[{"theSingularList", ",", "nearestSing"}], "}"}]}], 
             "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"For", "[", 
            RowBox[{
             RowBox[{"i", "=", "1"}], ",", 
             RowBox[{"i", "<=", 
              RowBox[{"Length", "@", "nearestDist"}]}], ",", 
             RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"nearestDist", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], ">", "10"}], ",", 
                "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{
                  RowBox[{"nearestDist", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], "=", "10"}], ";"}]}], 
               "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", 
            "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"minRadiusArray", "=", "nearestDist"}], ";", 
