Cell[CellGroupData[{

Cell["getAnnularMonodromy", "Subsection",
 CellChangeTimes->{{3.9292776480259233`*^9, 
  3.9292776510097303`*^9}},ExpressionUUID->"dea97395-c2be-4fa1-95c9-\
ddf3ad83c1af"],

Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
   "get", " ", "differential", " ", "monodromy", " ", "around", " ", "a", " ",
     "selected", " ", "annulus"}], "\[IndentingNewLine]", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Options", "[", "getAnnularMonodromy", "]"}], "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<nSolveWP\>\"", "->", "50"}], ",", 
       RowBox[{"\"\<integrateWP\>\"", "->", "50"}], ",", 
       RowBox[{"\"\<polishWP\>\"", "->", "20"}], ",", 
       RowBox[{"\"\<stiffFlag\>\"", "->", "False"}], ",", 
       RowBox[{"\"\<diagFlag\>\"", "->", "False"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"getAnnularMonodromy", "[", 
      RowBox[{"annulusIndex_", ",", "annularNorms_", ",", 
       RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "rNorm", ",", "z0", ",", "annularMedialVals", ",", "wArray", ",", 
         "branchVals", ",", "polishedVals", ",", "pArray", ",", "theCycles", 
         ",", "theLinks", ",", "oneCycles", ",", "finalCycles", ",", 
         "monodromyTable", ",", "annularMonodromy"}], "}"}], ",", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"rNorm", "=", 
          RowBox[{"annularNorms", "[", 
           RowBox[{"[", "annulusIndex", "]"}], "]"}]}], ";"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"rNorm", "=", 
         RowBox[{"$annularNorms", "[", 
          RowBox[{"[", "annulusIndex", "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"z0", "=", 
         RowBox[{"rNorm", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"I", " ", "$thetaV"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"OptionValue", "[", "\"\<diagFlag\>\"", "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"\"\<z0: \>\"", ",", 
             RowBox[{"z0", "//", "N"}]}], "]"}], ";"}]}], 
         "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"annularMedialVals", "=", 
         RowBox[{"Sort", "[", 
          RowBox[{"w", "/.", 
           RowBox[{"NSolve", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"$theFunction", "==", "0"}], "/.", 
              RowBox[{"z", "->", "z0"}]}], ",", "w", ",", 
             RowBox[{"WorkingPrecision", "->", 
              RowBox[{"OptionValue", "[", "\"\<nSolveWP\>\"", "]"}]}]}], 
            "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"\"\<annularMedialVals: \>\"", ",", 
            RowBox[{"annularMedialVals", "//", "N"}]}], "]"}], ";"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"wArray", "=", 
         RowBox[{"MapThread", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"#1", ",", "#2"}], "}"}], "&"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Range", "[", 
              RowBox[{"Length", "@", "annularMedialVals"}], "]"}], ",", 
             "annularMedialVals"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"OptionValue", "[", "\"\<diagFlag\>\"", "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"Grid", "[", 
             RowBox[{"SetPrecision", "[", 
              RowBox[{"wArray", ",", "4"}], "]"}], "]"}], "]"}], ";"}]}], 
         "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", " ", 
        RowBox[{"branchVals", "=", 
         RowBox[{"integrateOverAnnulus", "[", 
          RowBox[{"$thetaV", ",", "wArray", ",", "rNorm", ",", 
           RowBox[{"OptionValue", "[", "\"\<integrateWP\>\"", "]"}], ",", 
           RowBox[{"OptionValue", "[", "\"\<stiffFlag\>\"", "]"}]}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"polishedVals", "=", 
         RowBox[{"polishBranchTerms", "[", 
          RowBox[{"z0", ",", "branchVals", ",", "20"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"OptionValue", "[", "\"\<diagFlag\>\"", "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{
             RowBox[{"polishedVals", "//", "N"}], "//", "MatrixForm"}], "]"}],
            ";"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"pArray", "=", 
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Position", "[", 
             RowBox[{
              RowBox[{"polishedVals", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
              RowBox[{"x_", "/;", 
               RowBox[{
                RowBox[{"Abs", "[", 
                 RowBox[{"x", "-", "#"}], "]"}], "<", 
                RowBox[{"10", "^", 
                 RowBox[{"-", "20"}]}]}]}]}], "]"}], "&"}], "/@", " ", 
           RowBox[{"polishedVals", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "3"}], "]"}], "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"OptionValue", "[", "\"\<diagFlag\>\"", "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"monodromyTable", "=", 
            RowBox[{"MapThread", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"#1", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], ",", 
                 RowBox[{"N", "[", 
                  RowBox[{
                   RowBox[{"#1", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], ",", "5"}], "]"}], ",", 
                 RowBox[{"N", "[", 
                  RowBox[{
                   RowBox[{"#1", "[", 
                    RowBox[{"[", "3", "]"}], "]"}], ",", "5"}], "]"}], ",", 
                 "#2"}], "}"}], "&"}], ",", 
              RowBox[{"{", 
               RowBox[{"polishedVals", ",", "pArray"}], "}"}]}], "]"}]}], ";",
            "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"Grid", "[", "monodromyTable", "]"}], "]"}], ";"}]}], 
         "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"theCycles", "=", 
         RowBox[{"PermutationCycles", "[", "pArray", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"theLinks", "=", 
         RowBox[{"theCycles", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"oneCycles", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"{", "#", "}"}], "&"}], "/@", 
          RowBox[{"Complement", "[", 
           RowBox[{
            RowBox[{"Range", "[", "functionDegree", "]"}], ",", 
            RowBox[{"Flatten", "[", "theLinks", "]"}]}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"finalCycles", "=", 
         RowBox[{"Join", "[", 
          RowBox[{"theLinks", ",", "oneCycles"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", "\[IndentingNewLine]", " ", 
         RowBox[{
         "now", " ", "sort", " ", "permutations", " ", "to", " ", "standard", 
          " ", "order"}], "\[IndentingNewLine]", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"annularMonodromy", "=", 
         RowBox[{"sortPermutations", "[", "finalCycles", "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<finalCycles: \>\"", ",", "finalCycles"}], "]"}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Sort", "[", 
            RowBox[{"Flatten", "@", "finalCycles"}], "]"}], "!=", 
           RowBox[{"Range", "[", 
            RowBox[{"Length", "@", 
             RowBox[{"Flatten", "@", "finalCycles"}]}], "]"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"Style", "[", 
             RowBox[{"\"\<monodromy is inconsistent!\>\"", ",", "Red"}], 
             "]"}], "]"}], ";"}], "\[IndentingNewLine]", ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"Style", "[", 
             RowBox[{
             "\"\<monodromy is consistent\>\"", ",", "Black", ",", "Bold"}], 
             "]"}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
         "z0", ",", "rNorm", ",", "finalCycles", ",", "polishedVals"}], 
         "}"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.929277637981455*^9, 3.9292776384032297`*^9}, {
   3.9292814135495048`*^9, 3.929281416798893*^9}, {3.929281451071888*^9, 
   3.9292814553990407`*^9}, {3.929352102631076*^9, 3.929352105677422*^9}, {
   3.929352138638749*^9, 3.9293521658353024`*^9}, {3.9293632091245937`*^9, 
   3.9293632097338142`*^9}, {3.9293644180347548`*^9, 3.9293644680541134`*^9}, 
   3.929364522338019*^9, {3.9398255617155447`*^9, 3.9398255719623356`*^9}, {
   3.939825627054634*^9, 3.93982563422408*^9}, 3.9403189323716106`*^9, {
   3.941800025271597*^9, 3.9418000370499353`*^9}, {3.941800118668891*^9, 
   3.9418001562224846`*^9}, {3.941800277006811*^9, 3.941800307530935*^9}, {
   3.941800344897352*^9, 3.9418003505991955`*^9}, {3.9418212662020516`*^9, 
   3.941821268998273*^9}, {3.9418218045351753`*^9, 3.941821835090381*^9}, {
   3.9418223189014072`*^9, 3.9418223195107093`*^9}, 3.941822354538642*^9, {
   3.942051673610056*^9, 3.9420518407897635`*^9}, {3.942051920723549*^9, 
   3.94205192511312*^9}, {3.9420519928313675`*^9, 3.942051993487488*^9}, {
   3.9489021155503063`*^9, 3.9489021310891933`*^9}, {3.9516368252432165`*^9, 
   3.951636866809989*^9}, 3.972926796113944*^9, {3.9881749247858458`*^9, 
   3.988174931910128*^9}, {3.9881749893038473`*^9, 3.9881749912828846`*^9}, {
   3.988175027628716*^9, 3.988175028592637*^9}},
 CellLabel->"In[92]:=",ExpressionUUID->"e2099b5b-2d0f-4892-9219-2b3969ba9894"]
}, Closed]],

Cell[CellGroupData[{

Cell["integrateOverAnnulus", "Subsection",
 CellChangeTimes->{{3.9291224122893615`*^9, 
  3.9291224164758153`*^9}},ExpressionUUID->"d8583d81-f0f1-4d66-b10c-\
71d1c67d2137"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"integrateOverAnnulus", "[", 
      RowBox[{
      "startTheta_", ",", "w0Table_", ",", "radius_", ",", "wp_", ",", 
       "stiffnessFlag_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "intTable", ",", "integrationPath", ",", "wDeriv", ",", "theSol", ",",
          "w0"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"PrintTemporary", "[", 
         RowBox[{"\"\<Integrating index \>\"", ",", 
          RowBox[{"Dynamic", "@", "np"}]}], "]"}], ";", "\[IndentingNewLine]",
         " ", 
        RowBox[{"intTable", "=", 
         RowBox[{"Table", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"np", "=", "n"}], ";", "\[IndentingNewLine]", 
            RowBox[{"w0", "=", 
             RowBox[{"w0Table", "[", 
              RowBox[{"[", 
               RowBox[{"n", ",", "2"}], "]"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"integrationPath", "[", "t_", "]"}], ":=", 
             RowBox[{"radius", " ", 
              RowBox[{"Exp", "[", 
               RowBox[{"I", " ", "t"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"wDeriv", "=", 
             RowBox[{
              RowBox[{
               RowBox[{"w", "'"}], "[", "t", "]"}], "\[Equal]", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"-", 
                   RowBox[{"(", 
                    FractionBox[
                    RowBox[{"D", "[", 
                    RowBox[{"$theFunction", ",", "z"}], "]"}], 
                    RowBox[{"D", "[", 
                    RowBox[{"$theFunction", ",", "w"}], "]"}]], ")"}]}], " ", 
                  
                  RowBox[{"D", "[", 
                   RowBox[{
                    RowBox[{"integrationPath", "[", "t", "]"}], ",", "t"}], 
                   "]"}]}], ")"}], "/.", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"w", "\[Rule]", 
                   RowBox[{"w", "[", "t", "]"}]}], ",", 
                  RowBox[{"z", "\[Rule]", 
                   RowBox[{"integrationPath", "[", "t", "]"}]}]}], "}"}]}], 
               ")"}]}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{"stiffnessFlag", ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"theSol", "=", 
                RowBox[{"NDSolveValue", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"wDeriv", ",", 
                    RowBox[{
                    RowBox[{"w", "[", "startTheta", "]"}], "\[Equal]", 
                    "w0"}]}], "}"}], ",", "w", ",", 
                  RowBox[{"{", 
                   RowBox[{"t", ",", "startTheta", ",", 
                    RowBox[{"startTheta", "+", 
                    RowBox[{"2", " ", "Pi"}]}]}], "}"}], ",", 
                  RowBox[{"MaxSteps", "\[Rule]", "2000000"}], ",", 
                  RowBox[{"MaxStepSize", "\[Rule]", 
                   RowBox[{"1", "/", "1000"}]}], ",", 
                  RowBox[{"WorkingPrecision", "\[Rule]", "wp"}], ",", 
                  RowBox[{"Method", " ", "\[Rule]", " ", 
                   RowBox[{"{", 
                    RowBox[{"\"\<StiffnessSwitching\>\"", ",", 
                    RowBox[{"\"\<NonstiffTest\>\"", "->", "False"}]}], 
                    "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", ",", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"theSol", "=", 
                RowBox[{"NDSolveValue", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"wDeriv", ",", 
                    RowBox[{
                    RowBox[{"w", "[", "startTheta", "]"}], "\[Equal]", 
                    "w0"}]}], "}"}], ",", "w", ",", 
                  RowBox[{"{", 
                   RowBox[{"t", ",", "startTheta", ",", 
                    RowBox[{"startTheta", "+", 
                    RowBox[{"2", " ", "Pi"}]}]}], "}"}], ",", 
                  RowBox[{"MaxSteps", "\[Rule]", "2000000"}], ",", 
                  RowBox[{"MaxStepSize", "\[Rule]", 
                   RowBox[{"1", "/", "1000"}]}], ",", 
                  RowBox[{"WorkingPrecision", "\[Rule]", "wp"}]}], "]"}]}], 
               ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", " ", 
             RowBox[{"save", " ", 
              RowBox[{"{", 
