Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"getSingTableIndexes", "[", 
    RowBox[{"singTable_", ",", "annulus_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "singMembers", ",", "singIndexes", ",", "annulusIndex", ",", "return"}],
       "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"annulus", ">", 
          RowBox[{"Length", "@", "theAnnuli"}]}], " ", "||", " ", 
         RowBox[{"annulus", "<", "0"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"Style", "[", 
           RowBox[{"\"\<Annulus number out of range!\>\"", ",", "Red"}], 
           "]"}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"return", "=", 
          RowBox[{"-", "1"}]}], ";"}], "\[IndentingNewLine]", ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"annulusIndex", "=", 
          RowBox[{"annularTableAnnularIndexes", "[", 
           RowBox[{"[", "annulus", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"annulus", "==", 
            RowBox[{"Length", "@", "theAnnuli"}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"singIndexes", "=", 
             RowBox[{"{", 
              RowBox[{"-", "1"}], "}"}]}], ";"}], "\[IndentingNewLine]", ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"singMembers", "=", 
             RowBox[{"ringMemberSingularIndexes", "[", 
              RowBox[{"[", "annulus", "]"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"singIndexes", "=", 
             RowBox[{"annularTableSingularIndexes", "[", 
              RowBox[{"[", "singMembers", "]"}], "]"}]}], ";"}]}], 
          "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"return", "=", 
          RowBox[{"{", 
           RowBox[{"annulusIndex", ",", "singIndexes"}], "}"}]}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", "return"}]}],
     "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]"}]], "Input",
