Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
   "get", " ", "differential", " ", "monodromy", " ", "around", " ", "a", " ",
     "singular", " ", "point"}], "\[IndentingNewLine]", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Options", "[", "getSingularMonodromy", "]"}], "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<nSolveWP\>\"", "->", "50"}], ",", 
       RowBox[{"\"\<integrateWP\>\"", "->", "50"}], ",", 
       RowBox[{"\"\<polishWP\>\"", "->", "20"}], ",", 
       RowBox[{"\"\<diagFlag\>\"", "->", "False"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"getSingularMonodromy", "[", 
     RowBox[{"theSingularPoint_", ",", "rNorm_", ",", 
      RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "z0", ",", "singularRoots", ",", "wArray", ",", "branchVals", ",", 
        "polishedVals", ",", "pArray", ",", "theCycles", ",", "theLinks", ",",
         "oneCycles", ",", "finalCycles"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"\"\<nSolveWP: \>\"", ",", 
         RowBox[{"OptionValue", "[", "\"\<nSolveWP\>\"", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"z0", "=", 
        RowBox[{"theSingularPoint", "+", 
         RowBox[{"rNorm", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"I", " ", "$thetaV"}], "]"}]}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<z0: \>\"", ",", 
         RowBox[{"z0", "//", "N"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"singularRoots", "=", 
        RowBox[{"Sort", "[", 
         RowBox[{"w", "/.", 
          RowBox[{"NSolve", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"$theFunction", "==", "0"}], "/.", 
             RowBox[{"z", "->", "z0"}]}], ",", "w", ",", 
            RowBox[{"WorkingPrecision", "->", 
             RowBox[{"OptionValue", "[", "\"\<nSolveWP\>\"", "]"}]}]}], 
           "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"wArray", "=", 
        RowBox[{"MapThread", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"#1", ",", "#2"}], "}"}], "&"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Range", "[", 
             RowBox[{"Length", "@", "singularRoots"}], "]"}], ",", 
            "singularRoots"}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", " ", 
       RowBox[{"branchVals", "=", 
        RowBox[{"integrateOverSheet", "[", 
         RowBox[{
         "z0", ",", "theSingularPoint", ",", "$thetaV", ",", "wArray", ",", 
          "rNorm", ",", "False", ",", 
          RowBox[{"OptionValue", "[", "\"\<integrateWP\>\"", "]"}]}], "]"}]}],
        ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"polishedVals", "=", 
        RowBox[{"polishBranchTerms", "[", 
         RowBox[{"z0", ",", "branchVals", ",", 
          RowBox[{"OptionValue", "[", "\"\<polishWP\>\"", "]"}]}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"OptionValue", "[", "\"\<diagFlag\>\"", "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"\"\<polishedVals: \>\"", ",", 
            RowBox[{
             RowBox[{"polishedVals", "//", "N"}], "//", "MatrixForm"}]}], 
           "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"pArray", "=", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Position", "[", 
