     RowBox[{"I", " ", "t"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"wVals", "=", 
   RowBox[{"NSolveValues", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"$theFunction", "==", "0"}], "/.", 
      RowBox[{"z", "->", 
