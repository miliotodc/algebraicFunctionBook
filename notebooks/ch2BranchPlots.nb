Cell[CellGroupData[{

Cell["strictPolynomialQ", "Subsection",
 CellChangeTimes->{{3.8893602934364414`*^9, 
  3.8893602965138407`*^9}},ExpressionUUID->"19f55e87-c087-4ea0-a847-\
ea5e112ab1be"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"strictPolynomialQ", "[", 
     RowBox[{"myPoly_", ",", 
      RowBox[{"{", 
       RowBox[{"x_", ",", "y_"}], "}"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"levels", ",", "cList", ",", "finalList", ",", "return"}], 
       "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"PolynomialQ", "[", 
          RowBox[{"myPoly", ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", "y"}], "}"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"levels", "=", 
           RowBox[{"Level", "[", 
            RowBox[{"myPoly", ",", 
             RowBox[{"{", 
              RowBox[{"-", "1"}], "}"}], ",", 
             RowBox[{"Heads", "->", "True"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Length", "@", 
               RowBox[{"Position", "[", 
                RowBox[{"levels", ",", "x"}], "]"}]}], ">", "0"}], " ", "&&", 
             " ", 
             RowBox[{
              RowBox[{"Length", "@", 
               RowBox[{"Position", "[", 
                RowBox[{"levels", ",", "y"}], "]"}]}], ">", "0"}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"cList", "=", 
              RowBox[{"Complement", "[", 
               RowBox[{"levels", ",", 
                RowBox[{"{", 
                 RowBox[{
                 "Plus", ",", "Power", ",", "Times", ",", "x", ",", "y"}], 
                 "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"finalList", "=", 
              RowBox[{"Complement", "[", 
               RowBox[{"cList", ",", 
                RowBox[{"Select", "[", 
                 RowBox[{"cList", ",", "NumberQ"}], "]"}]}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Length", "@", "finalList"}], ">", "0"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"Print", "[", 
                 RowBox[{
                  RowBox[{"Style", "[", 
                   RowBox[{
                   "\"\<expression is not strict polynomial in \>\"", ",", 
                    "Red"}], "]"}], ",", 
                  RowBox[{"Style", "[", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"x", ",", "y"}], "}"}], ",", "Red"}], "]"}]}], 
                 "]"}], ";", "\[IndentingNewLine]", 
                RowBox[{"return", "=", "False"}], ";"}], 
               "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"return", "=", "True"}], ";"}]}], 
              "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", ",",
             "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{
               RowBox[{"Style", "[", 
                RowBox[{
                "\"\<expression is not strict polynomial in \>\"", ",", 
                 "Red"}], "]"}], ",", 
               RowBox[{"Style", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"x", ",", "y"}], "}"}], ",", "Red"}], "]"}]}], 
              "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"return", "=", "False"}], ";"}]}], "\[IndentingNewLine]",
            "]"}], ";"}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"return", "=", "False"}], ";"}]}], "\[IndentingNewLine]", 
        "]"}], ";", "\[IndentingNewLine]", "return"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.8893602992317033`*^9, 3.8893603006690025`*^9}, {
  3.8893630345963316`*^9, 3.8893630418912425`*^9}, {3.894371500481982*^9, 
  3.8943715009192405`*^9}, {3.8970419131913157`*^9, 3.897041953096331*^9}},
 CellLabel->"In[42]:=",ExpressionUUID->"54c69829-8820-456f-8af5-972bd94c32bd"]
}, Closed]],

Cell[CellGroupData[{

Cell["getZeroIndexes", "Subsection",
 CellChangeTimes->{{3.894362768159027*^9, 3.894362771564473*^9}, {
  3.8943648054975176`*^9, 
  3.8943648076554794`*^9}},ExpressionUUID->"8ba0dea1-c034-4571-ac07-\
80d1cd7f406c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"getZeroIndexes", "[", 
     RowBox[{"theFunction_", ",", "theSingularList_", ",", 
      RowBox[{"diag_", ":", "False"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "wKeys", ",", "a0Rule", ",", "a1Rule", ",", "theZeroPoints", ",", 
        "zeroPrecision", ",", "duplicateError", ",", "zeroIndexes", ",", 
        "theZeroList", ",", "singPrecision", ",", "difTable", ",", "maxDif", 
        ",", "rootPrecisionTable"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"wKeys", "=", 
        RowBox[{"CoefficientRules", "[", 
         RowBox[{
         "theFunction", ",", "w", ",", "\"\<NegativeLexicographic\>\""}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"a0Rule", "=", 
        RowBox[{"Normal", "@", 
         RowBox[{"KeyTake", "[", 
          RowBox[{"wKeys", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", "0", "}"}], ",", "z"}], "}"}]}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"singPrecision", "=", 
        RowBox[{"Floor", "@", 
         RowBox[{"Precision", "@", "theSingularList"}]}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "@", "a0Rule"}], ">", "0"}], " ", ",", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{"found", " ", "a_", "0"}], " ", "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Exponent", "[", 
              RowBox[{
               RowBox[{"a0Rule", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "2"}], "]"}], "]"}], ",", "z"}], "]"}], 
             ">", "0"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"a1Rule", "=", 
              RowBox[{"Normal", "@", 
               RowBox[{"KeyTake", "[", 
                RowBox[{"wKeys", ",", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"{", "1", "}"}], ",", "z"}], "}"}]}], "]"}]}]}], 
             ";", "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Length", "@", "a1Rule"}], ">", "0"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"(*", " ", 
                RowBox[{
                "now", " ", "have", " ", "a0", " ", "and", " ", "a1", " ", 
                 "in", " ", "function"}], " ", "*)"}], "\[IndentingNewLine]", 
               
               RowBox[{
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Exponent", "[", 
                    RowBox[{
                    RowBox[{"a1Rule", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}], ",", "z"}], "]"}], 
                   ">", "0"}], ",", "\[IndentingNewLine]", 
                  RowBox[{"(*", " ", 
                   RowBox[{
                    RowBox[{
                    "a1", " ", "is", " ", "a", " ", "poly", " ", "degree"}], 
                    ">", "0"}], " ", "*)"}], "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"a0Rule", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}], "===", 
                    RowBox[{"a1Rule", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{"(*", " ", 
                    RowBox[{
                    RowBox[{"at", " ", "this", " ", "point", " ", "a0"}], "===", 
                    RowBox[{
                    RowBox[{"a1", " ", "poly", " ", "degree"}], ">", 
                    RowBox[{
                    "0", " ", "so", " ", "zero", " ", "terms", " ", "are", 
                    " ", "zeros", " ", "to", " ", "a0"}]}]}], " ", "*)"}], 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"theZeroPoints", "=", 
                    RowBox[{"Sort", "[", 
                    RowBox[{
                    RowBox[{"z", "/.", 
                    RowBox[{"NSolve", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Factor", "@", 
                    RowBox[{"a0Rule", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}]}], "\[Equal]", 
                    "0"}], ",", "z", ",", 
                    RowBox[{
                    "WorkingPrecision", "\[Rule]", "singPrecision"}]}], 
                    "]"}]}], ",", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "@", "#1"}], "<=", 
                    RowBox[{"Abs", "@", "#2"}]}], "&"}]}], "]"}]}], ";"}], 
                    "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
                    RowBox[{"(*", 
                    RowBox[{
                    RowBox[{"Print", "[", 
                    RowBox[{"Style", "[", 
                    RowBox[{
                    "\"\<No zero key singular points\>\"", ",", "Red"}], 
                    "]"}], "]"}], ";"}], "*)"}], "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"theZeroPoints", "=", 
                    RowBox[{"{", "}"}]}], ";"}]}], "\[IndentingNewLine]", 
                    "]"}], ";"}], "\[IndentingNewLine]", ",", 
                  "\[IndentingNewLine]", 
                  RowBox[{"(*", " ", 
                   RowBox[{
                   "if", " ", "a1", " ", "is", " ", "a", " ", "constant", " ",
                     "zero", " ", "set", " ", "is", " ", "null"}], " ", 
                   "*)"}], "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"theZeroPoints", "=", 
                    RowBox[{"{", "}"}]}], ";"}]}], "\[IndentingNewLine]", 
                 "]"}], ";"}], "\[IndentingNewLine]", ",", 
               "\[IndentingNewLine]", 
               RowBox[{"(*", " ", 
                RowBox[{
                "have", " ", "no", " ", "a1", " ", "at", " ", "this", " ", 
                 "point"}], " ", "*)"}], "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"theZeroPoints", "=", 
                 RowBox[{"Sort", "[", 
                  RowBox[{
                   RowBox[{"z", "/.", 
                    RowBox[{"NSolve", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Factor", "@", 
                    RowBox[{"a0Rule", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}]}], "\[Equal]", 
                    "0"}], ",", "z", ",", 
                    RowBox[{
                    "WorkingPrecision", "\[Rule]", "singPrecision"}]}], 
                    "]"}]}], ",", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "@", "#1"}], "<=", 
                    RowBox[{"Abs", "@", "#2"}]}], "&"}]}], "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"(*", "\[IndentingNewLine]", " ", 
                 RowBox[{"now", " ", "confirm", " ", "solutions"}], 
                 "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
                RowBox[{"difTable", "=", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{"a0Rule", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}], "/.", 
                    RowBox[{"z", "->", "#"}]}], "&"}], "/@", " ", 
                  "theZeroPoints"}]}], ";", "\[IndentingNewLine]", 
                RowBox[{"rootPrecisionTable", "=", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Precision", "@", "#"}], "&"}], "/@", " ", 
                  "difTable"}]}], ";", "\[IndentingNewLine]", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Min", "@", "rootPrecisionTable"}], ">", "10"}], 
                  ",", "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"maxDif", "=", 
                    RowBox[{"Max", "@", "difTable"}]}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"maxDif", ">", "$maxRootVerifyDifference"}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"Print", "[", 
                    RowBox[{"Style", "[", 
                    RowBox[{
                    "\"\<Verification of theZeroPoints roots exceeded the \
$maxRootVerifyDifference\>\"", ",", "Red", ",", "Bold"}], "]"}], "]"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"Print", "[", 
                    RowBox[{"\"\<   maxDif: \>\"", ",", 
                    RowBox[{"N", "[", 
                    RowBox[{"maxDif", ",", "20"}], "]"}]}], "]"}], ";"}]}], 
                    "\[IndentingNewLine]", "]"}], ";"}]}], 
                 "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
                RowBox[{"zeroPrecision", "=", 
                 RowBox[{"Floor", "@", 
                  RowBox[{"Precision", "@", "theZeroPoints"}]}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"duplicateError", "=", 
                 RowBox[{
                  RowBox[{"Min", "[", 
                   RowBox[{"zeroPrecision", ",", "singPrecision"}], "]"}], 
                  "-", "$accuracyComparisonFactor"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"theZeroList", "=", 
                 RowBox[{"DeleteDuplicates", "[", 
                  RowBox[{"theZeroPoints", ",", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "[", 
                    RowBox[{"#1", "-", "#2"}], "]"}], "<", 
                    RowBox[{"10", "^", 
                    RowBox[{"-", 
                    RowBox[{"(", "duplicateError", ")"}]}]}]}], "&"}]}], 
                  "]"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], 
            "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"theZeroPoints", "=", 
              RowBox[{"{", "}"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], 
          ";"}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"theZeroPoints", "=", 
           RowBox[{"{", "}"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{"diag", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"\"\<theZeroPoints: \>\"", ",", 
            RowBox[{"theZeroPoints", "//", "N"}]}], "]"}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "@", "theZeroPoints"}], ">", "0"}], ",", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"zeroPrecision", "=", 
           RowBox[{"Floor", "@", 
            RowBox[{"Precision", "@", "theZeroPoints"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"duplicateError", "=", 
           RowBox[{
            RowBox[{"Min", "[", 
             RowBox[{"zeroPrecision", ",", "singPrecision"}], "]"}], "-", 
            "$accuracyComparisonFactor"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"theZeroList", "=", 
           RowBox[{"DeleteDuplicates", "[", 
            RowBox[{"theZeroPoints", ",", 
             RowBox[{
              RowBox[{
               RowBox[{"Abs", "[", 
                RowBox[{"#1", "-", "#2"}], "]"}], "<", 
               RowBox[{"10", "^", 
                RowBox[{"-", 
                 RowBox[{"(", "duplicateError", ")"}]}]}]}], "&"}]}], "]"}]}],
           ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"zeroIndexes", "=", 
           RowBox[{"Flatten", "[", "\[IndentingNewLine]", 
            RowBox[{"Table", "[", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"dif", "=", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Abs", "[", 
                   RowBox[{
                    RowBox[{"theZeroList", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "-", "#"}], "]"}], "&"}], 
                 "/@", " ", "theSingularList"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"Position", "[", 
                 RowBox[{"dif", ",", 
                  RowBox[{"x_", "/;", 
                   RowBox[{"x", "==", 
                    RowBox[{"Min", "[", "dif", "]"}]}]}]}], "]"}], "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{"i", ",", "1", ",", 
                RowBox[{"Length", "@", "theZeroList"}]}], "}"}]}], 
             "\[IndentingNewLine]", "]"}], "]"}]}], ";"}], 
