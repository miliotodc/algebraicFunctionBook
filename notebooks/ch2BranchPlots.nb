Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "polishFunctionValue", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{"\"\<wp\>\"", "->", "MachinePrecision"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"  ", 
  RowBox[{
   RowBox[{"polishFunctionValue", "[", 
    RowBox[{"zVal_", ",", "wVal_", ",", "maxErrorTolerance_", ",", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "wVals", ",", "polishedValues", ",", "difTable", ",", "pos", ",", 
       "wValsPrec", ",", "termsPrec", ",", "w"}], "}"}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"termsPrec", "=", 
       RowBox[{"Floor", "@", 
        RowBox[{"Precision", "@", "wVal"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"wVals", "=", 
       RowBox[{"w", "/.", 
        RowBox[{"NSolve", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"$implicitF", "[", 
            RowBox[{"zVal", ",", "w"}], "]"}], "==", "0"}], ",", "w", ",", 
          RowBox[{"WorkingPrecision", "->", 
           RowBox[{"OptionValue", "[", "\"\<wp\>\"", "]"}]}]}], "]"}]}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"wVals", "=", 
         RowBox[{"w", "/.", 
          RowBox[{"NSolve", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"theFunction", "==", "0"}], "/.", 
             RowBox[{"z", "->", "zVal"}]}], ",", "w", ",", 
            RowBox[{"WorkingPrecision", "->", "25"}]}], "]"}]}]}], ";"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{"\"\<wVals: \>\"", ",", 
          RowBox[{"wVals", "//", "N"}]}], "]"}], ";"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"difTable", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"wVal", "-", "#"}], "]"}], "&"}], "/@", " ", "wVals"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"pos", "=", 
       RowBox[{
        RowBox[{"Position", "[", 
         RowBox[{"difTable", ",", 
          RowBox[{"Min", "@", "difTable"}]}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"wVals", "[", 
       RowBox[{"[", "pos", "]"}], "]"}]}]}], "\[IndentingNewLine]", 
    "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]"}], "Input",
