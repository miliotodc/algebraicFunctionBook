      RowBox[{"{", 
       RowBox[{
       "wVals", ",", "polishedValues", ",", "difTable", ",", "pos", ",", 
        "wValsPrec", ",", "seriesPrec"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"series", " ", "data", " ", 
         RowBox[{"format", ":", " ", "seriesValues"}]}], "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"indexJ", ",", "wValJ"}], "}"}], ",", "...", ",", 
          RowBox[{"{", 
           RowBox[{"indexN", ",", "wValN"}], "}"}]}], "}"}]}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"wValsPrec", "=", 
        RowBox[{"Floor", "@", 
