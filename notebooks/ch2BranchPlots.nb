            RowBox[{"Re", "@", 
             RowBox[{"theR", "[", "rStart", "]"}]}], ",", 
            RowBox[{"Im", "@", 
             RowBox[{"theR", "[", "rStart", "]"}]}], ",", 
            RowBox[{"Re", "@", 
             RowBox[{"solF2", "[", "rStart", "]"}]}]}], "}"}]}]}], "}"}]}]}], 
     ";"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"arrowPts", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
