Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{"integrate", " ", "G", 
     RowBox[{"(", "t", ")"}]}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"z", "^", 
       RowBox[{"(", 
        RowBox[{"1", "/", "3"}], ")"}]}], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", "z"}], ")"}], "^", 
       RowBox[{"(", 
        RowBox[{"2", "/", "3"}], ")"}]}], " ", "over", " ", "figure"}], "-", 
     RowBox[{"8", " ", "contour"}]}]}], "\[IndentingNewLine]", "*)"}], " ", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"tStart", "=", 
     RowBox[{"-", "Pi"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tEnd", "=", "Pi"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"fig8ContourF", "[", 
      RowBox[{"t_", ",", "a_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"a", " ", 
         RowBox[{"Sin", "[", "t", "]"}]}], "+", 
        RowBox[{"1", "/", "2"}]}], ")"}], "+", 
      RowBox[{"I", " ", "a", " ", 
       RowBox[{"Sin", "[", "t", "]"}], " ", 
       RowBox[{"Cos", "[", "t", "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wStart", "=", 
     RowBox[{"G", "[", 
      RowBox[{"fig8ContourF", "[", 
