    RowBox[{
     FractionBox["1", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{"2", " ", "Pi", " ", "I", 
         RowBox[{"(", 
          RowBox[{"1", "/", "3"}], ")"}]}], "]"}], "-", "1"}]], " ", 
