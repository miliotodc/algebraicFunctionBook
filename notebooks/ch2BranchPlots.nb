   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"$theFunction", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"2", "+", 
       RowBox[{"3", " ", "z"}], "-", 
       RowBox[{"z", "^", "2"}]}], ")"}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
