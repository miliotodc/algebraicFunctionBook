Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"set", " ", "up", " ", "contour"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"theZ", "[", "t_", "]"}], ":=", 
     RowBox[{
      RowBox[{"3", "/", "4"}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Sin", "[", "t", "]"}], " ", 
          RowBox[{"Cos", "[", "t", "]"}]}], ")"}], "+", 
        RowBox[{"I", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Sin", "[", "t", "]"}], "+", 
           RowBox[{"1", "/", "4"}]}], ")"}]}]}], ")"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
