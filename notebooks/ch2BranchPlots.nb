Cell[CellGroupData[{

Cell["\<\
Section 4.2:  Get singular monodromies from singular expansion files if \
previously computed\
\>", "Subsection",
 CellChangeTimes->{{3.9605529192269783`*^9, 3.960552928482279*^9}, {
   3.9819888748345222`*^9, 3.981988877670088*^9}, {3.986487541972501*^9, 
   3.986487559083276*^9}, 3.9938951621649337`*^9, {3.994085427833091*^9, 
   3.99408542805729*^9}, {3.994227989342698*^9, 3.994227989550763*^9}, {
   3.99474795753207*^9, 
   3.9947479609941263`*^9}},ExpressionUUID->"77e9a780-0e8f-4159-9df2-\
672f7337a2ea"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
   "search", " ", "for", " ", "singular", " ", "files", " ", "on", " ", 
    "disc"}], "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"fileList", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"FileExistsQ", "[", 
          RowBox[{"seriesFileName", "[", 
           RowBox[{"$theTestCase", ",", "sIndex"}], "]"}], "]"}], ",", 
         "\[IndentingNewLine]", "True", "\[IndentingNewLine]", ",", 
         "\[IndentingNewLine]", "False"}], "\[IndentingNewLine]", "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"sIndex", ",", "1", ",", 
         RowBox[{"Length", "@", "$theSingularList"}]}], "}"}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"MemberQ", "[", 
       RowBox[{"fileList", ",", "False"}], "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"Style", "[", 
         RowBox[{"\"\<One or more singular files not found\>\"", ",", "Red"}],
          "]"}], "]"}], ";"}], "\[IndentingNewLine]", ",", 
      "\[IndentingNewLine]", " ", 
      RowBox[{
       RowBox[{"reportFlag", "=", "False"}], ";", "\[IndentingNewLine]", " ", 
       RowBox[{"seriesBranchData", "=", 
        RowBox[{"Table", "[", "\[IndentingNewLine]", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"FileExistsQ", "[", 
              RowBox[{"seriesFileName", "[", 
               RowBox[{"$theTestCase", ",", "sIndex"}], "]"}], "]"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                "newSingularIndex", ",", "newSing", ",", "baseCycleMetric", 
                 ",", "basePoleList", ",", "newConjList", ",", 
                 "baseRemovableList", ",", "baseSeries", ",", 
                 "baseSheetLinks", ",", "baseSingSequence", ",", 
                 "baseBranchTypeArray", ",", "baseSeriesMIVPTable"}], "}"}], 
               "=", 
               RowBox[{"getSingularData", "[", 
                RowBox[{"$theTestCase", ",", "sIndex"}], "]"}]}], ";"}], 
             "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Print", "[", 
               RowBox[{"Style", "[", 
                RowBox[{
                 RowBox[{"\"\<Singular data file \>\"", "<>", 
                  RowBox[{"seriesFileName", "[", 
                   RowBox[{"$theTestCase", ",", "sIndex"}], "]"}], "<>", 
                  "\"\< not found\>\""}], ",", "Red"}], "]"}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"Abort", "[", "]"}], ";"}]}], "\[IndentingNewLine]", 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"monodromy", "=", 
            RowBox[{"baseSeriesMIVPTable", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "2", ",", "All", ",", "2"}], "]"}], "]"}]}],
            ";", "\[IndentingNewLine]", 
           RowBox[{"(*", "\[IndentingNewLine]", " ", 
            RowBox[{
            "place", " ", "monodromy", " ", "in", " ", "standard", " ", 
             "form"}], "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
           RowBox[{"monodromy", "=", 
            RowBox[{
             RowBox[{
              RowBox[{"RotateLeft", "[", 
               RowBox[{"#", ",", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"First", "@", 
                   RowBox[{"FirstPosition", "[", 
                    RowBox[{"#", ",", 
                    RowBox[{"Min", "@", "#"}]}], "]"}]}], ")"}], "-", "1"}]}],
                "]"}], "&"}], "/@", "monodromy"}]}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{"reportFlag", ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Print", "[", 
               RowBox[{"\"\<Monodromy: \>\"", ",", "monodromy"}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"Print", "[", 
               RowBox[{"\"\<basePoleList: \>\"", ",", "basePoleList"}], "]"}],
               ";", "\[IndentingNewLine]", 
              RowBox[{"Print", "[", 
               RowBox[{
               "\"\<baseSeriesMIVPTable: \>\"", ",", "baseSeriesMIVPTable"}], 
               "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"poleData", "=", 
            RowBox[{"Select", "[", 
             RowBox[{"basePoleList", ",", 
              RowBox[{
               RowBox[{
                RowBox[{"Length", "@", 
                 RowBox[{"#", "[", 
                  RowBox[{"[", "2", "]"}], "]"}]}], "!=", "0"}], "&"}]}], 
             "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"mivpEntry", "=", 
            RowBox[{"Flatten", "[", 
             RowBox[{
              RowBox[{"baseSeriesMIVPTable", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", "1"}], "]"}]}], 
           ";", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Length", "@", "poleData"}], "!=", "0"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Print", "[", 
               RowBox[{
               "\"\<Found pole at singular index \>\"", ",", "sIndex"}], 
               "]"}], ";", "\[IndentingNewLine]", 
              RowBox[{"poleSeriesIndex", "=", 
               RowBox[{"poleData", "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"(*", 
               RowBox[{
                RowBox[{"Print", "[", 
                 RowBox[{"\"\<  Pole series: \>\"", ",", "poleSeriesIndex"}], 
                 "]"}], ";"}], "*)"}], "\[IndentingNewLine]", 
              RowBox[{"(*", "\[IndentingNewLine]", " ", 
               RowBox[{"now", " ", "find", " ", "which", " ", "root"}], " ", 
               "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
              RowBox[{"roots", "=", 
               RowBox[{"mivpEntry", "[", 
                RowBox[{"[", 
                 RowBox[{"poleSeriesIndex", ",", "2"}], "]"}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"(*", 
               RowBox[{
                RowBox[{"Print", "[", 
                 RowBox[{"\"\<roots: \>\"", ",", 
                  RowBox[{"roots", "[", 
                   RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"Print", "[", 
                 RowBox[{"\"\<monodromy: \>\"", ",", "monodromy"}], "]"}], 
                ";"}], "*)"}], "\[IndentingNewLine]", 
              RowBox[{"pos", "=", 
               RowBox[{"Position", "[", 
                RowBox[{"monodromy", ",", 
                 RowBox[{"Alternatives", "@@", "roots"}]}], "]"}]}], ";", 
              "\n", "         ", 
              RowBox[{"coloredMonodromy", "=", 
               RowBox[{"MapIndexed", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{"MemberQ", "[", 
                    RowBox[{"pos", ",", "#2"}], "]"}], ",", 
                    RowBox[{"Style", "[", 
                    RowBox[{"#1", ",", "Red", ",", "Bold"}], "]"}], ",", 
                    RowBox[{"Style", "[", 
                    RowBox[{"#1", ",", "Blue", ",", "Bold"}], "]"}]}], "]"}], 
                  "&"}], ",", "monodromy", ",", 
                 RowBox[{"{", 
                  RowBox[{"1", ",", "2"}], "}"}]}], "]"}]}], ";"}], 
             "\[IndentingNewLine]", 
             RowBox[{"(*", 
              RowBox[{
               RowBox[{"Print", "[", 
                RowBox[{
                "\"\<coloredMonodromy: \>\"", ",", "coloredMonodromy"}], 
                "]"}], ";"}], "*)"}], "\[IndentingNewLine]", ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"coloredMonodromy", "=", 
               RowBox[{"Map", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Style", "[", 
                   RowBox[{"#1", ",", "Blue", ",", "Bold"}], "]"}], "&"}], 
                 ",", "monodromy"}], "]"}]}], ";"}]}], "\[IndentingNewLine]", 
            "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{
            "coloredMonodromy", ",", "monodromy", ",", "basePoleList", ",", 
             "baseBranchTypeArray", ",", "baseSeriesMIVPTable"}], "}"}]}], 
          ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"sIndex", ",", "1", ",", 
            RowBox[{"Length", "@", "$theSingularList"}]}], "}"}]}], 
         "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"singularMonodromies", "=", 
        RowBox[{"seriesBranchData", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"singularMonodromiesR", "=", 
        RowBox[{"seriesBranchData", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
       "Print", "[", "\"\<Retrieved monodromies from singular files: \>\"", 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", "singularMonodromies", "]"}], ";"}]}], 
     "\[IndentingNewLine]", "]"}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9605529010027757`*^9, 3.9605529107955256`*^9}, 
   3.9605530880297613`*^9, {3.9938948990366287`*^9, 3.993894899960338*^9}, {
   3.9938951221300373`*^9, 3.993895177532441*^9}, {3.993895517405755*^9, 
   3.993895541851356*^9}, {3.9938981541282606`*^9, 3.993898199674384*^9}, {
   3.9939026591608844`*^9, 3.993902676139208*^9}},
 CellLabel->
  "In[143]:=",ExpressionUUID->"69f09c06-c4f4-4c85-bb33-7304f107a1ed"],

Cell[BoxData[
 StyleBox["\<\"One or more singular files not found\"\>",
  StripOnInput->False,
  LineColor->RGBColor[1, 0, 0],
  FrontFaceColor->RGBColor[1, 0, 0],
  BackFaceColor->RGBColor[1, 0, 0],
  GraphicsColor->RGBColor[1, 0, 0],
