Cell[CellGroupData[{

Cell["polishTerms", "Subsection",
 CellChangeTimes->{{3.928749756452826*^9, 
  3.9287497581086235`*^9}},ExpressionUUID->"53d314df-722d-49d0-9dd5-\
fd5159a2609d"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"polishTerms", "[", 
     RowBox[{
     "zVal_", ",", "singPoint_", ",", "terms_", ",", "maxErrorTolerance_"}], 
     "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "wVals", ",", "polishedValues", ",", "difTable", ",", "pos", ",", 
        "wValsPrec", ",", "termsPrec"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"seriesValues", " ", 
        RowBox[{"format", ":", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"baseSeriesIndexK", ",", " ", "seriesValK"}], "}"}], 
            "..."}], 
           RowBox[{"{", 
            RowBox[{"baseSeriesIndexM", ",", "seriesValM"}], "}"}]}], 
          "}"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"termsPrec", "=", 
        RowBox[{"Floor", "@", 
         RowBox[{"Precision", "@", 
          RowBox[{"terms", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "2"}], "]"}], "]"}]}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"wVals", "=", 
        RowBox[{"w", "/.", 
         RowBox[{"NSolve", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"$theFunction", "==", "0"}], "/.", 
            RowBox[{"z", "->", "zVal"}]}], ",", "w", ",", 
           RowBox[{"WorkingPrecision", "->", "termsPrec"}]}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"polishedValues", "=", 
        RowBox[{"Table", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"difTable", "=", 
            RowBox[{
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{
                RowBox[{"terms", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", "2"}], "]"}], "]"}], "-", "#"}], "]"}], 
              "&"}], "/@", " ", "wVals"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"pos", "=", 
            RowBox[{
             RowBox[{"Position", "[", 
              RowBox[{"difTable", ",", 
               RowBox[{"Min", "@", "difTable"}]}], "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{"difTable", "[", 
                RowBox[{"[", "pos", "]"}], "]"}], "]"}], ">", 
              RowBox[{"10", "^", 
               RowBox[{"(", 
                RowBox[{"-", "maxErrorTolerance"}], ")"}]}]}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Print", "[", 
               RowBox[{
               "\"\<polishTerms error greater than $maxErrorTolerance: \>\"", 
                ",", 
                RowBox[{"N", "[", 
                 RowBox[{"10", "^", 
                  RowBox[{"-", "maxErrorTolerance"}]}], "]"}]}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"Print", "[", 
               RowBox[{"\"\<     difTable: \>\"", ",", 
                RowBox[{"difTable", "//", "N"}]}], "]"}], ";"}]}], 
            "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"terms", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", 
             RowBox[{"wVals", "[", 
              RowBox[{"[", "pos", "]"}], "]"}]}], "}"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{"Length", "@", "terms"}]}], "}"}]}], 
         "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"return", ":", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"seriesIndexK", ",", "polishedValK"}], "}"}], "..."}], 
           RowBox[{"{", 
            RowBox[{"seriesIndexM", ",", "polishedValM"}], "}"}]}], "}"}]}], 
        " ", "*)"}], "\[IndentingNewLine]", "polishedValues"}]}], 
     "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.9287450220802517`*^9, 3.9287450799260287`*^9}, {
   3.9287451275710382`*^9, 3.928745293438348*^9}, 3.9729269849321823`*^9, {
