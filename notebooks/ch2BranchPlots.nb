 TemplateBox[{
  "NDSolveValue", "precw", 
   "\"The precision of the differential equation (\\!\\(\\*RowBox[{\\\"{\\\", \
RowBox[{RowBox[{\\\"{\\\", RowBox[{RowBox[{RowBox[{SuperscriptBox[\\\"w\\\", \
\\\"\[Prime]\\\", Rule[MultilineFunction, None]], \\\"[\\\", \\\"x\\\", \\\"]\
\\\"}], \\\"\[Equal]\\\", FractionBox[RowBox[{\\\"\[ImaginaryI]\\\", \\\" \
\\\", SuperscriptBox[\\\"\[ExponentialE]\\\", RowBox[{\\\"\[ImaginaryI]\\\", \
\\\" \\\", \\\"x\\\"}]], \\\" \\\", RowBox[{\\\"(\\\", RowBox[{\\\"1\\\", \
\\\"-\\\", RowBox[{FractionBox[\\\"1\\\", \\\"2\\\"], \\\" \\\", \
SuperscriptBox[\\\"\[ExponentialE]\\\", RowBox[{\\\"Times\\\", \\\"[\\\", \
RowBox[{\\\"\[LeftSkeleton]\\\", \\\"2\\\", \\\"\[RightSkeleton]\\\"}], \\\"]\
\\\"}]]}]}], \\\")\\\"}]}], RowBox[{\\\"8\\\", \\\" \\\", RowBox[{\\\"w\\\", \
\\\"[\\\", \\\"x\\\", \\\"]\\\"}]}]]}], \\\",\\\", RowBox[{RowBox[{\\\"w\\\", \
\\\"[\\\", FractionBox[RowBox[{\\\"3\\\", \\\" \\\", \\\"\[Pi]\\\"}], \\\"2\\\
\"], \\\"]\\\"}], \\\"\[Equal]\\\", RowBox[{RowBox[{\\\"-\\\", \
\\\"0.40012129426490159646184151856235356999`19.515452852894743\\\"}], \
\\\"+\\\", \
RowBox[{\\\"0.31240526750906282130038781804816210951`19.516315974365252\\\", \
\\\" \\\", \\\"\[ImaginaryI]\\\"}]}]}]}], \\\"}\\\"}], \\\",\\\", \
RowBox[{\\\"{\\\", \\\"}\\\"}], \\\",\\\", RowBox[{\\\"{\\\", \\\"}\\\"}], \\\
\",\\\", RowBox[{\\\"{\\\", \\\"}\\\"}], \\\",\\\", RowBox[{\\\"{\\\", \
\\\"}\\\"}]}], \\\"}\\\"}]\\)) is less than WorkingPrecision \
(\\!\\(\\*RowBox[{\\\"20.`\\\"}]\\)).\"", 2, 952, 48, 22013480785205358369, 
