   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wVals1", "=", 
     RowBox[{"Sort", "@", 
      RowBox[{"NSolveValues", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"$theFunction", "==", "0"}], "/.", 
         RowBox[{"z", "->", 
          RowBox[{"theZ", "[", "tStart", "]"}]}]}], ",", "w", ",", 
        RowBox[{"WorkingPrecision", "->", "20"}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wStart1", "=", 
     RowBox[{"G", "[", 
      RowBox[{"1", "/", "2"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wDeriv", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"w", "'"}], "[", "t", "]"}], "\[Equal]", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            FractionBox[
             RowBox[{"D", "[", 
              RowBox[{"$theFunction", ",", "z"}], "]"}], 
             RowBox[{"D", "[", 
              RowBox[{"$theFunction", ",", "w"}], "]"}]], ")"}]}], " ", 
          RowBox[{"(", 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"theZ", "[", "t", "]"}], ",", "t"}], "]"}], ")"}]}], 
         ")"}], "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"w", "\[Rule]", 
           RowBox[{"w", "[", "t", "]"}]}], ",", 
          RowBox[{"z", "\[Rule]", 
           RowBox[{"theZ", "[", "t", "]"}]}]}], "}"}]}], ")"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"solFigure8", "=", 
     RowBox[{"NDSolveValue", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"wDeriv", ",", 
         RowBox[{
          RowBox[{"w", "[", "tStart", "]"}], "\[Equal]", "wStart1"}]}], "}"}],
        ",", "w", ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "tStart", ",", "tEnd"}], "}"}], ",", 
       RowBox[{"WorkingPrecision", "->", "20"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"intVal", "=", 
    RowBox[{"NIntegrate", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"solFigure8", "[", "t", "]"}], 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"theZ", "[", "t", "]"}], ",", "t"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "tStart", ",", "tEnd"}], "}"}], ",", 
      RowBox[{"WorkingPrecision", "->", "20"}]}], "]"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{"ppa", "=", 
    RowBox[{"ParametricPlot3D", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Re", "@", "z"}], ",", 
         RowBox[{"Im", "@", "z"}], ",", 
         RowBox[{"$reim", "@", 
          RowBox[{"solFigure8", "[", "t", "]"}]}]}], "}"}], "/.", 
       RowBox[{"z", "->", 
        RowBox[{"theZ", "[", "t", "]"}]}]}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "tStart", ",", "tEnd"}], "}"}], ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Thickness", "[", "0.005", "]"}], ",", "Black"}], "}"}]}]}], 
     "]"}]}], "\[IndentingNewLine]", 
