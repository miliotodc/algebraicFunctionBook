Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
   "first", " ", "extend", " ", "yellow", " ", "contour", " ", "start", " ", 
    "to", " ", "outer", " ", "radial", " ", "range"}], "\[IndentingNewLine]", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"rStart", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rEnd", "=", "2"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ClearAll", "[", "theR", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"theR", "[", "r_", "]"}], ":=", 
     RowBox[{"r", " ", 
      RowBox[{"Exp", "[", 
       RowBox[{"Pi", " ", 
        RowBox[{"I", "/", "6"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wStart2", "=", "wStart1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wDeriv2", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"w", "'"}], "[", "r", "]"}], "\[Equal]", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            FractionBox[
             RowBox[{"D", "[", 
              RowBox[{"$theFunction", ",", "z"}], "]"}], 
             RowBox[{"D", "[", 
              RowBox[{"$theFunction", ",", "w"}], "]"}]], ")"}]}], " ", 
          RowBox[{"(", 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"theR", "[", "r", "]"}], ",", "r"}], "]"}], ")"}]}], 
         ")"}], "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"w", "\[Rule]", 
           RowBox[{"w", "[", "r", "]"}]}], ",", 
          RowBox[{"z", "\[Rule]", 
           RowBox[{"theR", "[", "r", "]"}]}]}], "}"}]}], ")"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"solF2", "=", 
     RowBox[{"NDSolveValue", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"wDeriv2", ",", 
         RowBox[{
          RowBox[{"w", "[", "rStart", "]"}], "\[Equal]", "wStart2"}]}], "}"}],
        ",", "w", ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", "rStart", ",", "rEnd"}], "}"}], ",", 
       RowBox[{"WorkingPrecision", "->", "20"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"wAt2", "=", 
    RowBox[{"solF2", "[", "rEnd", "]"}]}]}]}]], "Input",
