  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{"integrate", " ", "f_", 
     RowBox[{"{", "39", "}"}], " ", "over", " ", "figure"}], "-", 
    RowBox[{"8", " ", "contour"}]}], "\[IndentingNewLine]", "*)"}], " ", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"tStart", "=", 
     RowBox[{"-", "Pi"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tEnd", "=", "Pi"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"theZ", "[", "t_", "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Sin", "[", "t", "]"}], "+", 
        RowBox[{"1", "/", "2"}]}], ")"}], "+", 
