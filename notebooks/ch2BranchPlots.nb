  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"theZ", "[", "t_", "]"}], ":=", 
   RowBox[{"3", 
    RowBox[{"Exp", "[", 
     RowBox[{"I", " ", "t"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"wVals", "=", 
   RowBox[{"NSolveValues", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"$theFunction", "==", "0"}], "/.", 
      RowBox[{"z", "->", 
       RowBox[{"theZ", "[", "tStart", "]"}]}]}], ",", "w", ",", 
     RowBox[{"WorkingPrecision", "->", "25"}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"wStart1", "=", 
   RowBox[{"wVals", "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"wDeriv", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"w", "'"}], "[", "t", "]"}], "\[Equal]", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"(", 
           FractionBox[
            RowBox[{"D", "[", 
             RowBox[{"$theFunction", ",", "z"}], "]"}], 
            RowBox[{"D", "[", 
             RowBox[{"$theFunction", ",", "w"}], "]"}]], ")"}]}], " ", 
         RowBox[{"(", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"theZ", "[", "t", "]"}], ",", "t"}], "]"}], ")"}]}], 
        ")"}], "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"w", "\[Rule]", 
          RowBox[{"w", "[", "t", "]"}]}], ",", 
         RowBox[{"z", "\[Rule]", 
          RowBox[{"theZ", "[", "t", "]"}]}]}], "}"}]}], ")"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"solF1", "=", 
   RowBox[{"NDSolveValue", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"wDeriv", ",", 
       RowBox[{
        RowBox[{"w", "[", "tStart", "]"}], "\[Equal]", "wStart1"}]}], "}"}], 
     ",", "w", ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "tStart", ",", "tEnd"}], "}"}], ",", 
     RowBox[{"WorkingPrecision", "->", "20"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"pp1", "=", 
