Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "evaluate", " ", "the", " ", "symbol", " ", "to", " ", "force", " ", 
    "autoloading"}], "*)"}], 
  RowBox[{
   RowBox[{"Convert`TeX`ExpressionToTeX", ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "modify", " ", "ExpressionToTeX", " ", "so", " ", "that", " ", "it", " ", 
     "blocks", " ", "$TeX", " ", "to", " ", "true"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"Unprotect", "[", "Convert`TeX`ExpressionToTeX", "]"}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Convert`TeX`ExpressionToTeX", "[", 
      RowBox[{"expr_", ",", 
       RowBox[{"o___", "?", "OptionQ"}]}], "]"}], "/;", 
     RowBox[{"!", 
      RowBox[{"TrueQ", "@", "$TeX"}]}]}], ":=", 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"$TeX", "=", "True"}], "}"}], ",", 
      RowBox[{"Convert`TeX`ExpressionToTeX", "[", 
       RowBox[{"expr", ",", "o"}], "]"}]}], "]"}]}], "\n", 
   RowBox[{
    RowBox[{"Protect", "[", "Convert`TeX`ExpressionToTeX", "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "modify", " ", "ordplus", " ", "to", " ", "reverse", " ", "the", " ", 
     "order", " ", "of", " ", "polynomials"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"TraditionalFormDump`ordplus", "[", 
      RowBox[{"x_", ",", "y_"}], "]"}], "/;", "$TeX"}], ":=", 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"$TeX", "=", "False"}], "}"}], ",", 
      RowBox[{"Reverse", "@", 
       RowBox[{"TraditionalFormDump`ordplus", "[", 
        RowBox[{"x", ",", "y"}], "]"}]}]}], "]"}]}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{
