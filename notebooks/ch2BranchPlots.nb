          RowBox[{"{", 
           RowBox[{"1", ",", " ", "1", ",", "1"}], "}"}]}], ",", 
         RowBox[{"ImageSize", "->", "400"}]}], "]"}]}]}], ",", 
     "\[IndentingNewLine]", 
