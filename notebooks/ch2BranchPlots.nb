RowBox[{\\\"1\\\", \\\"+\\\", RowBox[{\\\"Times\\\", \\\"[\\\", RowBox[{\\\"\
\[LeftSkeleton]\\\", \\\"2\\\", \\\"\[RightSkeleton]\\\"}], \\\"]\\\"}]}], \\\
\")\\\"}]}]}], \\\")\\\"}]}], RowBox[{\\\"8\\\", \\\" \\\", \
RowBox[{\\\"w\\\", \\\"[\\\", \\\"x\\\", \\\"]\\\"}]}]]}], \\\",\\\", \
RowBox[{RowBox[{\\\"w\\\", \\\"[\\\", RowBox[{\\\"-\\\", \
FractionBox[\\\"\[Pi]\\\", \\\"2\\\"]}], \\\"]\\\"}], \\\"\[Equal]\\\", \
RowBox[{\\\"0.40012129465363550241566397945200048901`19.697675241030343\\\", \
\\\"+\\\", \
RowBox[{\\\"0.31240526680398958044357411532215351868`19.62087068355795\\\", \
\\\" \\\", \\\"\[ImaginaryI]\\\"}]}]}]}], \\\"}\\\"}], \\\",\\\", \
RowBox[{\\\"{\\\", \\\"}\\\"}], \\\",\\\", RowBox[{\\\"{\\\", \\\"}\\\"}], \\\
\",\\\", RowBox[{\\\"{\\\", \\\"}\\\"}], \\\",\\\", RowBox[{\\\"{\\\", \
\\\"}\\\"}]}], \\\"}\\\"}]\\)) is less than WorkingPrecision \
(\\!\\(\\*RowBox[{\\\"20.`\\\"}]\\)).\"", 2, 921, 47, 22013480785205358369, 
