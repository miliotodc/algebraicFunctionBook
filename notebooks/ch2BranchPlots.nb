              RowBox[{"-", "1"}], ",", 
              RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], ",", 
         RowBox[{"Axes", "->", "True"}], ",", 
         RowBox[{"(*", 
          RowBox[{
