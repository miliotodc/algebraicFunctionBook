  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"theZ", "[", "x_", "]"}], ":=", 
     RowBox[{"x", "-", 
      RowBox[{
       RowBox[{"1", "/", "4"}], " ", "I"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"xStart", "=", 
     RowBox[{"8", "/", "10"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"xEnd", "=", "0"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wStart", "=", "leg5WStart"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wDeriv", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"w", "'"}], "[", "x", "]"}], "\[Equal]", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            FractionBox[
             RowBox[{"D", "[", 
              RowBox[{"$theFunction", ",", "z"}], "]"}], 
             RowBox[{"D", "[", 
              RowBox[{"$theFunction", ",", "w"}], "]"}]], ")"}]}], " ", 
          RowBox[{"(", 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"theZ", "[", "x", "]"}], ",", "x"}], "]"}], ")"}]}], 
         ")"}], "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"w", "\[Rule]", 
           RowBox[{"w", "[", "x", "]"}]}], ",", 
          RowBox[{"z", "\[Rule]", 
           RowBox[{"theZ", "[", "x", "]"}]}]}], "}"}]}], ")"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"leg5SolF", "=", 
     RowBox[{"NDSolveValue", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"wDeriv", ",", 
         RowBox[{
          RowBox[{"w", "[", "xStart", "]"}], "\[Equal]", "wStart"}]}], "}"}], 
       ",", "w", ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "xStart", ",", "xEnd"}], "}"}], ",", 
       RowBox[{"WorkingPrecision", "->", "20"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"leg6WStart", "=", 
     RowBox[{"leg5SolF", "[", "xEnd", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"leg5Plot", "=", 
     RowBox[{"ParametricPlot3D", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Re", "@", "z"}], ",", 
          RowBox[{"Im", "@", "z"}], ",", 
          RowBox[{"$reim", "@", 
           RowBox[{"leg5SolF", "[", "x", "]"}]}]}], "}"}], "/.", 
        RowBox[{"z", "->", 
         RowBox[{"theZ", "[", "x", "]"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "xStart", ",", "xEnd"}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Thickness", "[", "0.01", "]"}], ",", "Red"}], "}"}]}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Show", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "difPlot", ",", "leg1Plot", ",", "leg2Plot", ",", "leg3PlotA", ",", 
       "leg3PlotB", ",", "leg4PlotA", ",", "leg4PlotB", ",", "leg5Plot"}], 
      "}"}], ",", 
     RowBox[{"PlotRange", "->", "All"}]}], "]"}], 
   "\[IndentingNewLine]"}]}]], "Input",
