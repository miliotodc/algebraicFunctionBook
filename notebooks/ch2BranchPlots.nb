Cell[CellGroupData[{

Cell["\<\
Section 9.4:  Create Pochhammer contour over testCase0017 s_2 and s_3 and use \
the integral over this contour to estimate the integral over the function \
between s_2 and s_3\
\>", "Subsection",
 CellChangeTimes->{{3.9516623216166615`*^9, 3.951662340391353*^9}, {
  3.9818026210307426`*^9, 3.9818026234059105`*^9}, {3.9818027261950293`*^9, 
  3.981802726359844*^9}, {3.9881047598562007`*^9, 
  3.9881047916012692`*^9}},ExpressionUUID->"2e1cc1b0-dbd1-43a1-b3ad-\
cc1e56696da0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{"blue", " ", "contour"}], "\[IndentingNewLine]", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"sing1", "=", 
    RowBox[{
     RowBox[{"$theSingularList", "[", 
      RowBox[{"[", "2", "]"}], "]"}], "//", "N"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"blueZ", "[", "t_", "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "1"}], "/", "4"}], "-", 
        RowBox[{
         RowBox[{"1", "/", "2"}], " ", "I"}]}], ")"}], 
      RowBox[{"(", 
       RowBox[{"1", "-", "t"}], ")"}]}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "1"}], "/", "4"}], "+", 
        RowBox[{
         RowBox[{"1", "/", "2"}], " ", "I"}]}], ")"}], "t"}]}]}], 
   "\[IndentingNewLine]", 
   RowBox[{"wVals", "=", 
    RowBox[{"Sort", "[", 
     RowBox[{"w", "/.", 
      RowBox[{"NSolve", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"$theFunction", "==", "0"}], "/.", 
         RowBox[{"z", "->", 
          RowBox[{"blueZ", "[", "0", "]"}]}]}], ",", "w"}], "]"}]}], "]"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{"wStart", "=", 
    RowBox[{"wVals", "[", 
     RowBox[{"[", "1", "]"}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wDeriv", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"w", "'"}], "[", "t", "]"}], "\[Equal]", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            FractionBox[
             RowBox[{"D", "[", 
              RowBox[{"$theFunction", ",", "z"}], "]"}], 
             RowBox[{"D", "[", 
              RowBox[{"$theFunction", ",", "w"}], "]"}]], ")"}]}], " ", 
          RowBox[{"(", 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"blueZ", "[", "t", "]"}], ",", "t"}], "]"}], ")"}]}], 
         ")"}], "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"w", "\[Rule]", 
           RowBox[{"w", "[", "t", "]"}]}], ",", 
          RowBox[{"z", "\[Rule]", 
           RowBox[{"blueZ", "[", "t", "]"}]}]}], "}"}]}], ")"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tStart", "=", "0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tEnd", "=", "1"}], ";"}], "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{"blueContourF", "=", 
     RowBox[{"NDSolveValue", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"wDeriv", ",", 
         RowBox[{
          RowBox[{"w", "[", "tStart", "]"}], "\[Equal]", "wStart"}]}], "}"}], 
       ",", "w", ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "tStart", ",", "tEnd"}], "}"}], ",", 
       RowBox[{"MaxSteps", "\[Rule]", "totalIntegrationSteps"}], ",", 
       RowBox[{"MaxStepSize", "\[Rule]", "maxStepSize"}]}], "]"}]}], ";"}], 
   " ", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"purpleStartW", "=", 
     RowBox[{"blueContourF", "[", "tEnd", "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pp1", "=", 
     RowBox[{"ParametricPlot3D", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Re", "@", "z"}], ",", 
          RowBox[{"Im", "@", "z"}], ",", 
          RowBox[{"$reim", "@", 
           RowBox[{"blueContourF", "[", "t", "]"}]}]}], "}"}], "/.", 
        RowBox[{"z", "->", 
         RowBox[{"blueZ", "[", "t", "]"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "tStart", ",", "tEnd"}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", "Blue"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"difPlot", "=", 
    RowBox[{"Show", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"plotTable", ",", "pp1"}], "}"}], ",", 
      RowBox[{"AxesEdge", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", 
           RowBox[{"-", "1"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", 
           RowBox[{"-", "1"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", 
           RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], ",", 
      RowBox[{"Axes", "->", "True"}], ",", 
      RowBox[{"FaceGrids", "->", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "0", ",", 
            RowBox[{"-", "1"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"xGrids", ",", "yGrids"}], "}"}]}], "}"}], "}"}]}], ",", 
      RowBox[{"AxesLabel", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{"\"\<Re(z)\>\"", ",", "12", ",", "Bold", ",", "Black"}], 
          "]"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{"\"\<Im(z)\>\"", ",", "12", ",", "Bold", ",", "Black"}], 
          "]"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ToString", "@", "$reim"}], "<>", "\"\<(w)\>\""}], ",", 
           "12", ",", "Bold", ",", "Black"}], "]"}]}], "}"}]}], ",", 
      RowBox[{"FaceGridsStyle", "\[Rule]", 
       RowBox[{"Directive", "[", 
        RowBox[{"Black", ",", "Dotted"}], "]"}]}], ",", 
      RowBox[{"BoxRatios", "->", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "1", ",", "1"}], "}"}]}], ",", 
      RowBox[{"If", "[", 
       RowBox[{"$plotLabel", ",", 
        RowBox[{"PlotLabel", "->", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{"$reim", ",", "Bold", ",", "12", ",", "Black"}], "]"}], 
            ",", "\"\< \>\"", ",", 
            RowBox[{"Style", "[", 
             RowBox[{
              SubscriptBox["s", "currentSingIndex"], ",", "12", ",", "Bold", 
              ",", "Black"}], "]"}], ",", 
            RowBox[{"Style", "[", 
             RowBox[{"\"\<: \>\"", ",", "12", ",", "Bold", ",", "Black"}], 
             "]"}], ",", 
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"ToString", "@", "singularMonodromy"}], ",", "12", ",", 
              "Bold", ",", "Black"}], "]"}]}], "}"}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"PlotLabel", "->", "\"\<\>\""}]}], "\[IndentingNewLine]", 
       "]"}], ",", 
      RowBox[{"PlotRange", "->", "All"}], 
      RowBox[{"(*", "plotRange", "*)"}], ",", 
      RowBox[{"ImageSize", "->", "500"}]}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{"blueVal", "=", 
    RowBox[{"NIntegrate", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"blueContourF", "[", "t", "]"}], " ", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"blueZ", "[", "t", "]"}], ",", "t"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", "1"}], "}"}]}], "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.9514916220728865`*^9, 3.9514916220885572`*^9}, {
   3.951657891073964*^9, 3.951657894947561*^9}, {3.951657972944461*^9, 
   3.951657981568804*^9}, {3.9516582542609515`*^9, 3.9516583543401804`*^9}, {
   3.9516583894125576`*^9, 3.9516585227601647`*^9}, 3.9516585609175377`*^9, {
   3.951658610567134*^9, 3.951658696820171*^9}, {3.951658767748062*^9, 
   3.951658776431028*^9}, {3.9516590837346783`*^9, 3.9516590898577323`*^9}, {
   3.9516591313299265`*^9, 3.9516591339107046`*^9}, {3.9516603086879015`*^9, 
   3.951660357384531*^9}, {3.951660628808463*^9, 3.9516606406849933`*^9}, {
   3.9516611692331676`*^9, 3.9516611808815117`*^9}, {3.951662598315178*^9, 
   3.9516626119716144`*^9}, {3.951662650553423*^9, 3.9516626758903537`*^9}, {
