       RowBox[{"polishedValues", "=", 
        RowBox[{"Table", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"difTable", "=", 
            RowBox[{
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{
                RowBox[{"seriesValues", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", "2"}], "]"}], "]"}], "-", "#"}], "]"}], 
              "&"}], "/@", " ", "wVals"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"pos", "=", 
