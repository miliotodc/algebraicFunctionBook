    RowBox[{"wDeriv2", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"w", "'"}], "[", "r", "]"}], "\[Equal]", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", 
