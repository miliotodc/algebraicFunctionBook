      RowBox[{
       RowBox[{"MapAt", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"Negative", "[", "#", "]"}], ",", "\"\<-\>\"", ",", 
              "\"\<+\>\""}], "]"}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"MakeBoxes", "[", "#", "]"}], "&"}], "@", 
             RowBox[{"Abs", "@", "#"}]}]}], "}"}], "&"}], ",", 
         RowBox[{"2", ";;"}]}], "]"}], "@", "assoc"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"\[PlusMinus]", "1"}], " ", "are", " ", "specials", " ", 
      "cases"}], ";", 
     RowBox[{"no", " ", "zero", " ", "coeffs"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"toMonomialBoxes", "[", 
