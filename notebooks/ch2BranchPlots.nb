Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"randomPolynomial", "[", 
     RowBox[{"z_", ",", "n_", ",", 
      RowBox[{"coeffRange_", ":", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "10"}], ",", "10"}], "}"}]}]}], "]"}], ":=", 
    RowBox[{
     RowBox[{"RandomInteger", "[", 
      RowBox[{"coeffRange", ",", 
       RowBox[{"n", "+", "1"}]}], "]"}], ".", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"z", "^", "i"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "0", ",", "n"}], "}"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"$theFunction", "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"z", "-", "1"}], ")"}], "^", "4"}], " ", 
      RowBox[{"randomPolynomial", "[", 
       RowBox[{"z", ",", "6", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "5"}], ",", "5"}], "}"}]}], "]"}]}], "-", 
     RowBox[{"w", "^", "9"}]}]}], "\n", 
   RowBox[{
    RowBox[{"$theFunction", "=", 
     RowBox[{
      RowBox[{"w", "^", "2"}], "-", 
      RowBox[{"z", "^", "3"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wExp", "=", 
     RowBox[{"Exponent", "[", 
      RowBox[{"$theFunction", ",", "w", ",", "List"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"functionDegree", "=", 
     RowBox[{"Last", "@", "wExp"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"aForm", "[", "$theFunction", "]"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"$theTestCase", "=", "\"\<tempTestCase0001\>\""}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"subDirectory", "=", "$theTestCase"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"!", 
       RowBox[{"TrueQ", "@", 
        RowBox[{"FileExistsQ", "@", 
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{"dataDir", ",", "subDirectory"}], "}"}], "]"}]}]}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"CreateDirectory", "[", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{"dataDir", ",", "subDirectory"}], "}"}], "]"}], "]"}], 
       ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Function: \>\"", ",", 
