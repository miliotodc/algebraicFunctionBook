Cell[CellGroupData[{

Cell["\<\
Section 9.3:  Create the general Pochhammer contour  over butterfly plot of \
testCase0017 (see Sec. 7)\
\>", "Subsection",
 CellChangeTimes->{{3.950343834585603*^9, 3.9503438410775733`*^9}, 
   3.950344400105214*^9, {3.950944188255266*^9, 3.950944195653516*^9}, {
   3.950948134445342*^9, 3.9509481555595837`*^9}, 3.950948562327368*^9, {
   3.9509494492267523`*^9, 3.9509494517676744`*^9}, {3.950949544406133*^9, 
   3.950949545337508*^9}, {3.97835925148588*^9, 3.9783592583977633`*^9}, {
   3.981802610720764*^9, 3.981802617179279*^9}, {3.9818027232885075`*^9, 
   3.981802723448635*^9}, {3.9920823613029566`*^9, 3.992082370776223*^9}, {
   3.994263265621068*^9, 3.994263271347374*^9}, {3.9942633120956917`*^9, 
   3.994263315796423*^9}},ExpressionUUID->"e6c251a4-b2d7-4230-b15e-\
f5e5b13e2776"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"(*", "\[IndentingNewLine]", "  ", 
   RowBox[{"general", " ", "pochhammer", " ", "contour"}], 
   "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"contourArray", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pocR1", "=", 
     RowBox[{"1", "/", "3"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pocR2", "=", 
     RowBox[{"1", "/", "2"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{"do", " ", "blue", " ", "contour"}], "\[IndentingNewLine]", 
    "*)"}], "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"blueContourF", "[", "t_", "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"pocR2", " ", "I"}], ")"}], 
       RowBox[{"(", 
        RowBox[{"1", "-", "t"}], ")"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"pocR2", " ", "I"}]}], ")"}], " ", "t"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"blueStartT", "=", "0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"blueEndT", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"blueArrowG", "=", 
     RowBox[{"Graphics", "@", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Arrowheads", "[", "0.025", "]"}], ",", 
        RowBox[{"Arrow", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"ReIm", "@", 
            RowBox[{"blueContourF", "[", "0.1", "]"}]}], ",", 
           RowBox[{"ReIm", "@", 
            RowBox[{"blueContourF", "[", "0.15", "]"}]}]}], "}"}], "]"}]}], 
       "}"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"blueContourPlot", "=", 
     RowBox[{"ParametricPlot", "[", 
      RowBox[{
       RowBox[{"ReIm", "@", 
        RowBox[{"blueContourF", "[", "t", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "blueStartT", ",", "blueEndT"}], "}"}], ",", 
       RowBox[{"AxesOrigin", "->", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}]}], ",", 
       RowBox[{"PlotRange", "->", "1.5"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Thickness", "[", "0.0025", "]"}], ",", "Blue"}], "}"}]}]}],
       "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"AppendTo", "[", 
     RowBox[{"contourArray", ",", 
      RowBox[{"{", 
       RowBox[{"blueContourF", ",", "blueStartT", ",", "blueEndT"}], "}"}]}], 
     "]"}], ";"}], "\[IndentingNewLine]", "  ", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{"do", " ", "purple", " ", "contour"}], "\[IndentingNewLine]", 
    "*)"}], "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"purpleContourF", "[", "t_", "]"}], ":=", 
     RowBox[{"1", "+", 
      RowBox[{"pocR2", " ", 
       RowBox[{"Exp", "[", 
        RowBox[{"I", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Pi", "/", "2"}], 
            RowBox[{"(", 
             RowBox[{"1", "-", "t"}], ")"}]}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "Pi"}], "/", "2"}], ")"}], " ", "t"}]}], ")"}]}], 
        "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"purpleStartT", "=", "0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"purpleEndT", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"purpleContourPlot", "=", 
     RowBox[{"ParametricPlot", "[", 
      RowBox[{
       RowBox[{"ReIm", "@", 
        RowBox[{"purpleContourF", "[", "t", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "purpleStartT", ",", "purpleEndT"}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Thickness", "[", "0.0025", "]"}], ",", "Purple"}], "}"}]}],
        ",", 
       RowBox[{"PlotRange", "->", "2"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", " ", 
   RowBox[{"(*", " ", "\[IndentingNewLine]", " ", 
    RowBox[{"green", " ", "contour"}], "\[IndentingNewLine]", "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"greenStartT", "=", "0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"greenEndT", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"greenContourF", "[", "t_", "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"pocR2", " ", "I"}]}], ")"}], 
       RowBox[{"(", 
        RowBox[{"1", "-", "t"}], ")"}]}], "+", 
      RowBox[{"pocR1", " ", "I", " ", "t"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"greenArrowG", "=", 
     RowBox[{"Graphics", "@", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Arrowheads", "[", "0.025", "]"}], ",", 
        RowBox[{"Arrow", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"ReIm", "@", 
            RowBox[{"greenContourF", "[", "0.1", "]"}]}], ",", 
           RowBox[{"ReIm", "@", 
            RowBox[{"greenContourF", "[", "0.15", "]"}]}]}], "}"}], "]"}]}], 
       "}"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"greenContourPlot", "=", 
     RowBox[{"ParametricPlot", "[", 
      RowBox[{
       RowBox[{"ReIm", "@", 
        RowBox[{"greenContourF", "[", "t", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "greenStartT", ",", "greenEndT"}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Thickness", "[", "0.0025", "]"}], ",", 
          RowBox[{"Darker", "@", "Green"}]}], "}"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{"do", " ", "red", " ", "contour"}], "\[IndentingNewLine]", "*)"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"redContourF", "[", "t_", "]"}], ":=", 
     RowBox[{"pocR1", " ", 
      RowBox[{"Exp", "[", 
       RowBox[{"I", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Pi", "/", "2"}], 
           RowBox[{"(", 
            RowBox[{"1", "-", "t"}], ")"}]}], "+", 
          RowBox[{"3", " ", 
           RowBox[{"Pi", "/", "2"}], " ", "t"}]}], ")"}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"redStartT", "=", "0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"redEndT", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"redContourPlot", "=", 
     RowBox[{"ParametricPlot", "[", 
      RowBox[{
       RowBox[{"ReIm", "@", 
        RowBox[{"redContourF", "[", "t", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "redStartT", ",", "redEndT"}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Thickness", "[", "0.0025", "]"}], ",", "Red"}], "}"}]}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{"do", " ", "black", " ", "contour"}], "\[IndentingNewLine]", 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"blackContourF", "[", "t_", "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "pocR1"}], " ", "I", 
       RowBox[{"(", 
        RowBox[{"1", "-", "t"}], ")"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"pocR1", " ", "I"}]}], ")"}], " ", "t"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"blackStartT", "=", "0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"blackEndT", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"blackArrowG", "=", 
     RowBox[{"Graphics", "@", 
      RowBox[{"{", 
       RowBox[{"Black", ",", 
        RowBox[{"Arrowheads", "[", "0.025", "]"}], ",", 
        RowBox[{"Arrow", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"ReIm", "@", 
            RowBox[{"blackContourF", "[", "0.1", "]"}]}], ",", 
           RowBox[{"ReIm", "@", 
            RowBox[{"blackContourF", "[", "0.2", "]"}]}]}], "}"}], "]"}]}], 
       "}"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"blackContourPlot", "=", 
     RowBox[{"ParametricPlot", "[", 
      RowBox[{
       RowBox[{"ReIm", "@", 
        RowBox[{"blackContourF", "[", "t", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "blackStartT", ",", "blackEndT"}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Thickness", "[", "0.0025", "]"}], ",", "Black"}], 
         "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{"do", " ", "yellow", " ", "contour"}], "\[IndentingNewLine]", 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"yellowContourF", "[", "t_", "]"}], ":=", 
     RowBox[{"1", "+", 
      RowBox[{"pocR1", " ", 
       RowBox[{"Exp", "[", 
        RowBox[{"I", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"-", "Pi"}], "/", "2"}], 
            RowBox[{"(", 
             RowBox[{"1", "-", "t"}], ")"}]}], "+", 
           RowBox[{
            RowBox[{"Pi", "/", "2"}], " ", "t"}]}], ")"}]}], "]"}]}]}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"yellowStartT", "=", "0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"yellowEndT", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"yellowContourPlot", "=", 
     RowBox[{"ParametricPlot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Re", "@", "z"}], ",", 
          RowBox[{"Im", "@", "z"}]}], "}"}], "/.", 
        RowBox[{"z", "->", 
         RowBox[{"yellowContourF", "[", "t", "]"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "yellowStartT", ",", "yellowEndT"}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Thickness", "[", "0.0025", "]"}], ",", 
          RowBox[{"Darker", "@", "Yellow"}]}], "}"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{"do", " ", "orange", " ", "contour"}], "\[IndentingNewLine]", 
    "*)"}], "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{"orangeContourF", "[", "t_", "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"pocR1", " ", "I"}]}], ")"}], 
      RowBox[{"(", 
       RowBox[{"1", "-", "t"}], ")"}]}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "pocR2"}], " ", "I"}], ")"}], "t"}]}]}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"orangeStartT", "=", "0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"orangeEndT", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"orangeArrowG", "=", 
     RowBox[{"Graphics", "@", 
      RowBox[{"{", 
       RowBox[{"Black", ",", 
        RowBox[{"Arrowheads", "[", "0.025", "]"}], ",", 
        RowBox[{"Arrow", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"ReIm", "@", 
            RowBox[{"orangeContourF", "[", "0.1", "]"}]}], ",", 
           RowBox[{"ReIm", "@", 
            RowBox[{"orangeContourF", "[", "0.15", "]"}]}]}], "}"}], "]"}]}], 
       "}"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"orangeContourF", "[", "x_", "]"}], ":=", 
      RowBox[{
       RowBox[{"theSlope", 
        RowBox[{"(", 
         RowBox[{"x", "-", 
          RowBox[{"ptSol", "[", 
           RowBox[{"[", 
            RowBox[{"ptIndex", ",", "1"}], "]"}], "]"}]}], ")"}]}], "+", 
       RowBox[{"ptSol", "[", 
        RowBox[{"[", 
         RowBox[{"ptIndex", ",", "2"}], "]"}], "]"}]}]}], ";"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"orangeContourPlot", "=", 
     RowBox[{"ParametricPlot", "[", 
      RowBox[{
       RowBox[{"ReIm", "@", 
        RowBox[{"orangeContourF", "[", "t", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "orangeStartT", ",", "orangeEndT"}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Thickness", "[", "0.0025", "]"}], ",", "Orange"}], 
         "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{"do", " ", "brown", " ", "contour"}], "\[IndentingNewLine]", 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"brownStartT", "=", "0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"brownEndT", "=", "1"}], ";"}], "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"brownContourF", "[", "t_", "]"}], ":=", 
     RowBox[{"pocR2", " ", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"3", 
           RowBox[{"Pi", "/", "2"}]}], ")"}], " ", "I", 
         RowBox[{"(", 
          RowBox[{"1", "-", "t"}], ")"}]}], "+", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Pi", "/", "2"}], " ", "I", 
          RowBox[{"(", "t", ")"}]}], ")"}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"brownContourPlot", "=", 
