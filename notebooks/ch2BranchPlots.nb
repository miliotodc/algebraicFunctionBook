        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"at", "=", 
         RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"dataTable", "=", 
            RowBox[{"Table", "[", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
