Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
     "do", " ", "blue", " ", "contour", " ", "from", " ", "mrp", " ", "to", 
      " ", "r"}], "=", "2"}], ";"}], "\[IndentingNewLine]", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"rStart", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rEnd", "=", "2"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"theR", "[", "r_", "]"}], ":=", 
     RowBox[{"r", " ", 
      RowBox[{"Exp", "[", 
       RowBox[{"Pi", " ", 
        RowBox[{"I", "/", "6"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wStart3", "=", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{"2", " ", "Pi", " ", "I", 
        RowBox[{"(", 
         RowBox[{"5", "/", "7"}], ")"}]}], "]"}], " ", 
      RowBox[{"theF", "[", 
       RowBox[{"theR", "[", "rStart", "]"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wDeriv3", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"w", "'"}], "[", "r", "]"}], "\[Equal]", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            FractionBox[
             RowBox[{"D", "[", 
              RowBox[{"$theFunction", ",", "z"}], "]"}], 
             RowBox[{"D", "[", 
              RowBox[{"$theFunction", ",", "w"}], "]"}]], ")"}]}], " ", 
          RowBox[{"(", 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"theR", "[", "r", "]"}], ",", "r"}], "]"}], ")"}]}], 
         ")"}], "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"w", "\[Rule]", 
           RowBox[{"w", "[", "r", "]"}]}], ",", 
          RowBox[{"z", "\[Rule]", 
           RowBox[{"theR", "[", "r", "]"}]}]}], "}"}]}], ")"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"solF3", "=", 
     RowBox[{"NDSolveValue", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"wDeriv3", ",", 
         RowBox[{
          RowBox[{"w", "[", "rStart", "]"}], "\[Equal]", "wStart3"}]}], "}"}],
        ",", "w", ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", "rStart", ",", "rEnd"}], "}"}], ",", 
       RowBox[{"WorkingPrecision", "->", "20"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"blueInt", "=", 
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"solF3", "[", "r", "]"}], " ", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"theR", "[", "r", "]"}], ",", "r"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", "rStart", ",", "rEnd"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pp3", "=", 
     RowBox[{"ParametricPlot3D", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Re", "@", "z"}], ",", 
          RowBox[{"Im", "@", "z"}], ",", 
          RowBox[{"Re", "@", 
           RowBox[{"solF3", "[", "r", "]"}]}]}], "}"}], "/.", 
        RowBox[{"z", "->", 
         RowBox[{"theR", "[", "r", "]"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", 
         RowBox[{"rStart", "+", "0.075"}], ",", 
         RowBox[{"rEnd", "-", "0.075"}]}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Thickness", "[", "0.01", "]"}], ",", "Blue"}], "}"}]}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"orangePt", "=", 
     RowBox[{"Graphics3D", "@", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"PointSize", "[", "0.025", "]"}], ",", "Orange", ",", 
        RowBox[{"Point", "@", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Re", "@", 
            RowBox[{"theR", "[", "rEnd", "]"}]}], ",", 
           RowBox[{"Im", "@", 
            RowBox[{"theR", "[", "rEnd", "]"}]}], ",", 
           RowBox[{"Re", "@", 
            RowBox[{"solF3", "[", "rEnd", "]"}]}]}], "}"}]}]}], "}"}]}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"blueArrowPts", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Re", "@", "z"}], ",", 
          RowBox[{"Im", "@", "z"}], ",", 
          RowBox[{"Re", "@", 
