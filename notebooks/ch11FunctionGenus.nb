Cell[CellGroupData[{

Cell[TextData[StyleBox["identifyPolygonZeros",
 FontColor->RGBColor[1, 0, 1]]], "Subsection",
 InitializationGroup->True,
 CellChangeTimes->{{3.926331455446807*^9, 3.926331458118205*^9}, 
   3.9370412858484354`*^9},ExpressionUUID->"31ef6208-2f13-41ad-9563-\
34e029e84d10"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"identifyPolygonZeros", "[", 
    RowBox[{"f_", ",", "cVal_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "f2", ",", "wTerms", ",", "theCTerms", ",", "cTermVals", ",", 
       "theZeroList", ",", "cTemp", ",", "cKey", ",", "cKeyValue", ",", "i", 
       ",", "j", ",", "adjustedTolerance", ",", "zeroTermList", ",", 
       "posList", ",", "newF", ",", "zeroTermListExp", ",", "toleranceLimit", 
       ",", "minExpList", ",", "zList", ",", "zListExp"}], "}"}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{"$saveFIterateFlag", ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
         "Print", "[", "\"\<     appending fIterate to $fIterates...\>\"", 
          "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"$fIterates", ",", 
           RowBox[{"{", 
            RowBox[{"cVal", ",", "f"}], "}"}]}], "]"}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"adjustedTolerance", "=", 
         RowBox[{
          RowBox[{"Floor", "[", 
           RowBox[{"Accuracy", "@", "cVal"}], "]"}], "-", "20"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"adjustedTolerance", "<", "$minCharRootAccuracy"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"Style", "[", 
             RowBox[{
             "\"\<c-Removal routine: root adjusted tolerance less than \
$minCharRootAccuracy\>\"", ",", "Red"}], "]"}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<cVal accuracy: \>\"", ",", "adjustedTolerance"}], 
            "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], 
       "\[IndentingNewLine]", "\[IndentingNewLine]", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"wTerms", "=", 
       RowBox[{"CoefficientRules", "[", 
        RowBox[{"f", ",", 
         RowBox[{"{", 
          RowBox[{"w", ",", "z"}], "}"}], ",", 
         "\"\<NegativeLexicographic\>\""}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{"$printCResidueKeyFlag", ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"AppendTo", "[", 
          RowBox[{"wTermsSave", ",", "wTerms"}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"cValSave", ",", "cVal"}], "]"}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"zeroTermList", "=", 
       RowBox[{"wTerms", "/.", 
        RowBox[{"c", "->", "cVal"}]}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"toleranceLimit", "=", "$pzf"}], ";"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Floor", "@", 
          RowBox[{"Accuracy", "@", "cVal"}]}], "<", " ", "$pzf"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"Style", "[", 
           RowBox[{
           "\"\<Accuracy of cVal less than $pzf!\>\"", ",", "Red", ",", 
            "14"}], "]"}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Abort", "[", "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], 
      ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{"$printCResidueKeyFlag", ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"\"\<cVal Accuracy: \>\"", ",", 
           RowBox[{"Accuracy", "@", "cVal"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{"\"\<zeroTermList accuracy: \>\"", ",", 
           RowBox[{"Accuracy", "@", 
            RowBox[{"zeroTermList", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "2"}], "]"}], "]"}]}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{
           RowBox[{"Style", "[", 
            RowBox[{"\"\<toleranceLimit: \>\"", ",", "Red"}], "]"}], ",", 
           "$pzf"}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{"\"\<zeroTermVals: \>\"", ",", 
           RowBox[{"N", "[", 
            RowBox[{
             RowBox[{"zeroTermList", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", "10"}], "]"}]}], 
          "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"zeroTermSave", "=", "zeroTermList"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"wTermsSave", "=", "wTerms"}], ";", "\[IndentingNewLine]", 
         RowBox[{"cValSave", "=", "cVal"}], ";"}]}], "\[IndentingNewLine]", 
       "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{"$printCResidueKeyFlag", ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"Style", "[", 
           RowBox[{
           "\"\<identifyPolygonZeros stats: \>\"", ",", "Red", ",", "14"}], 
           "]"}], "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"zeroTermListExp", "=", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"Flatten", "[", 
             RowBox[{
              RowBox[{"MantissaExponent", "@", 
               RowBox[{"ReIm", "@", 
                RowBox[{"zeroTermList", "[", 
                 RowBox[{"[", 
                  RowBox[{"All", ",", "2"}], "]"}], "]"}]}]}], ",", "1"}], 
             "]"}], ")"}], "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"zList", "=", 
          RowBox[{"MantissaExponent", "@", 
           RowBox[{"ReIm", "@", 
            RowBox[{"zeroTermList", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "2"}], "]"}], "]"}]}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"zListExp", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", "2"}], "]"}], "]"}], ",", 
              RowBox[{"#", "[", 
               RowBox[{"[", 
                RowBox[{"2", ",", "2"}], "]"}], "]"}]}], "}"}], "&"}], "/@", 
           " ", "zList"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{
           RowBox[{"Style", "[", 
            RowBox[{"\"\<     Exponents in zeroTermList: \>\"", ",", "Red"}], 
            "]"}], ",", "zListExp"}], "]"}], ";"}]}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"minExpList", "=", 
          RowBox[{"Select", "[", 
           RowBox[{"zeroTermListExp", ",", 
            RowBox[{
             RowBox[{"#", "<", 
              RowBox[{"-", "toleranceLimit"}]}], "&"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{
           RowBox[{"Style", "[", 
            RowBox[{
            "\"\<     negative exp list less than tolerance limit: \>\"", ",",
              "Red"}], "]"}], ",", "minExpList"}], "]"}], ";"}], "*)"}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"posList", "=", 
       RowBox[{
        RowBox[{"Position", "[", 
         RowBox[{
          RowBox[{"zeroTermList", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
          RowBox[{"z_", "/;", 
           RowBox[{
            RowBox[{"Abs", "[", "z", "]"}], "<", 
            RowBox[{"10", "^", 
             RowBox[{"-", 
              RowBox[{"(", "$pzf", ")"}]}]}]}]}]}], "]"}], "//", 
        "Flatten"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"posList", "=", 
         RowBox[{
          RowBox[{"Position", "[", 
           RowBox[{
            RowBox[{"zeroTermList", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
            RowBox[{"z_", "/;", 
             RowBox[{
              RowBox[{"Abs", "[", "z", "]"}], "<", 
              RowBox[{"10", "^", 
               RowBox[{"-", 
                RowBox[{"(", "500", ")"}]}]}]}]}]}], "]"}], "//", 
          "Flatten"}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"newF", "=", 
       RowBox[{
        RowBox[{"FromCoefficientRules", "[", 
         RowBox[{
          RowBox[{"wTerms", "[", 
           RowBox[{"[", 
            RowBox[{"Complement", "[", 
             RowBox[{
              RowBox[{"Range", "[", 
               RowBox[{"Length", "@", "wTerms"}], "]"}], ",", "posList"}], 
             "]"}], "]"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"w", ",", "z"}], "}"}]}], "]"}], "/.", 
        RowBox[{"c", "->", "cVal"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{"$printCResidueKeyFlag", ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"\"\<zero list indexes: \>\"", ",", "posList"}], "]"}], 
         ";"}]}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"\"\<   zero terms: \>\"", ",", 
           RowBox[{"N", "[", 
            RowBox[{
             RowBox[{"zeroTermList", "[", 
              RowBox[{"[", 
               RowBox[{"posList", ",", "2"}], "]"}], "]"}], ",", "10"}], 
            "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{"\"\<newF: \>\"", ",", 
           RowBox[{"aForm", "[", 
            RowBox[{"N", "[", 
             RowBox[{"newF", ",", "10"}], "]"}], "]"}]}], "]"}], ";"}], 
        "*)"}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"posList", ",", "newF"}], "}"}]}]}], "\[IndentingNewLine]", 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 InitializationGroup->True,
