  RowBox[{
   RowBox[{"computeGenus", "[", 
    RowBox[{"infPuiseuxTable_", ",", "finiteRHSum_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "infRam", ",", "infiniteList", ",", "infiniteRamifiedIndexes", ",", 
       "tList", ",", "fList", ",", "sList", ",", "infiniteRHSum", ",", 
       "genus", ",", "i"}], "}"}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", " ", 
     RowBox[{
      RowBox[{"infRam", "=", 
       RowBox[{"infPuiseuxTable", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "3"}], "}"}]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"infRam", "=", 
       RowBox[{"Table", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Reverse", "@", "#"}], "&"}], "/@", 
            RowBox[{"infRam", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "1"}], "]"}], "]"}]}], ",", 
           RowBox[{"infRam", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "2"}], "]"}], "]"}]}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", 
           RowBox[{"Length", "@", "infRam"}]}], "}"}]}], 
        "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Compute", " ", "RH", " ", "sum", " ", "at", " ", "infinity"}],
        " ", "*)"}], "\[IndentingNewLine]", "  ", 
      RowBox[{"infiniteList", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "3"}], "]"}], "]"}], "&"}], "/@", 
        RowBox[{"infPuiseuxTable", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"infiniteRamifiedIndexes", "=", 
       RowBox[{"Flatten", "@", 
        RowBox[{"Position", "[", 
         RowBox[{"infiniteList", ",", 
          RowBox[{"x_List", "/;", 
           RowBox[{"MemberQ", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"GreaterThan", "[", "2", "]"}], "/@", " ", "x"}], ",", 
             "True"}], "]"}]}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Ramification at infinity: \>\"", ",", "infRam"}], "]"}],
         ";"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", " ", 
      RowBox[{"tList", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Tally", "[", "#", "]"}], "&"}], "/@", " ", 
        "infiniteList"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"fList", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{"tList", ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"sList", "=", 
       RowBox[{"Select", "[", 
        RowBox[{"fList", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ">=", "2"}], "&"}]}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"infiniteRHSum", "=", 
       RowBox[{"(", 
        RowBox[{"Plus", "@@", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "/", 
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], ")"}], 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "-", "1"}], ")"}]}], "&"}], "/@",
            " ", "sList"}], ")"}]}], ")"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{"\"\<infinite sum: \>\"", ",", "infiniteRHSum"}], "]"}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<infiniteRHSum: \>\"", ",", "infiniteRHSum"}], "]"}], 
        ";"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", 
        "**"}], "  ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", "   ", 
       RowBox[{"compute", " ", "genus"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{
        "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", 
         "**"}], "*"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"genus", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"finiteRHSum", "+", "infiniteRHSum"}], ")"}], "/", "2"}], 
        "-", "functionDegree", "+", "1"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"infRam", ",", "genus"}], "}"}]}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.948036157294115*^9, 3.948036297480171*^9}, {
  3.9480363296443577`*^9, 3.9480363364708796`*^9}, {3.9480363692451625`*^9, 
