        "\[IndentingNewLine]", 
        RowBox[{"zeroCycleCode", "=", 
         RowBox[{
          RowBox[{"getFiniteRamifications", "[", 
           RowBox[{"finiteRam", ",", "zeroIndexesSave", ",", 
            SubscriptBox["zeroLabel", 
             RowBox[{"Length", "@", "zeroIndexesSave"}]]}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"1", ";;", "2"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"infinityCycleCode", "=", 
         RowBox[{
          RowBox[{"getInfinityRamification", "[", 
           RowBox[{
           "\"\<\!\(\*SubscriptBox[\(s\), \(\[Infinity]\)]\)\>\"", ",", 
            RowBox[{"infRam", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "1"}], "]"}], "]"}]}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"1", ";;", "2"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"Labeled", "[", 
         RowBox[{
          RowBox[{"Grid", "[", 
           RowBox[{
            RowBox[{"Prepend", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
               "genericCycleCode", ",", "poleCycleCode", ",", "zeroCycleCode",
                 ",", "infinityCycleCode"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"\"\<Type\>\"", ",", "\"\<Cycles\>\""}], "}"}]}], 
             "]"}], ",", 
            RowBox[{"Alignment", "->", 
             RowBox[{"{", 
              RowBox[{"Center", ",", "Left"}], "}"}]}], ",", 
            RowBox[{"Spacings", "->", 
             RowBox[{"{", 
              RowBox[{"2", ",", "0.5"}], "}"}]}], ",", 
            RowBox[{"Dividers", "\[Rule]", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"{", "True", "}"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"True", ",", "True", ",", 
                 RowBox[{"{", "False", "}"}], ",", "True"}], "}"}]}], 
              "}"}]}]}], "]"}], ",", 
          RowBox[{"Style", "[", "\"\<Ramifiation Report\>\"", "]"}], ",", 
          "Top"}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
   "\[IndentingNewLine]"}]}]], "Input",
