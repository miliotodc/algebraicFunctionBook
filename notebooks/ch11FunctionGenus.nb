Cell[CellGroupData[{

Cell["polishCharRoots", "Subsection",
 InitializationGroup->True,
 CellChangeTimes->{{3.937896172562049*^9, 
  3.937896175077077*^9}},ExpressionUUID->"afb5de3a-3c84-419e-bca6-\
a7d7f0c80ab7"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"polishCharRoots", "[", 
     RowBox[{"eqnArray_", ",", "tallyArray_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "theTally", ",", "newRootArray", ",", "tally", ",", "currentTallyData",
         ",", "root", ",", "currentTally", ",", "multiplicity", ",", " ", 
        "newX", ",", "tallyRootAcc", ",", "rootPos", ",", "newRoot", ",", 
        "netArray", ",", "rootPosArray", ",", "multiRootPrec", ",", 
        "rootTallyPrec", ",", "difTable", ",", "altPos", ",", "altPosArray"}],
        "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"theTally", "=", 
        RowBox[{"MapThread", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"#1", ",", "#2"}], "}"}], "&"}], ",", 
          RowBox[{"{", 
           RowBox[{"eqnArray", ",", "tallyArray"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"netArray", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"tally", "=", "1"}], ",", 
         RowBox[{"tally", "<=", 
          RowBox[{"Length", "@", "theTally"}]}], ",", 
         RowBox[{"tally", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"currentTallyData", "=", 
           RowBox[{"theTally", "[", 
            RowBox[{"[", "tally", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{"$printPolishRootFlag", ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{"\"\<polishCharRoot: currentTallyData: \>\"", ",", 
               RowBox[{"currentTallyData", "//", "N"}]}], "]"}], ";"}]}], 
           "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"newRootArray", "=", 
           RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"root", "=", "1"}], ",", 
            RowBox[{"root", "<=", 
             RowBox[{"Length", "@", 
              RowBox[{"currentTallyData", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}]}], ",", 
            RowBox[{"root", "++"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"currentTally", "=", 
              RowBox[{"currentTallyData", "[", 
               RowBox[{"[", 
                RowBox[{"2", ",", "root"}], "]"}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{"$printPolishRootFlag", ",", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"Print", "[", 
                 RowBox[{"\"\<polishCharRoot: currentTally: \>\"", ",", 
                  RowBox[{"currentTally", "//", "N"}]}], "]"}], ";"}]}], 
              "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"multiplicity", "=", 
              RowBox[{"currentTally", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"currentTally", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], ">", "1"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"If", "[", 
                 RowBox[{"$printPolishRootFlag", ",", "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"Print", "[", 
                    RowBox[{"\"\<     currentTally: \>\"", ",", 
                    RowBox[{"N", "[", 
                    RowBox[{"currentTally", ",", "10"}], "]"}]}], "]"}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"Print", "[", 
                    RowBox[{
                    RowBox[{"Style", "[", 
                    RowBox[{"\"\<Detected multiple roots: \>\"", ",", "Red"}],
                     "]"}], ",", 
                    RowBox[{"currentTally", "//", "N"}]}], "]"}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"Print", "[", 
                    RowBox[{"\"\<     tally eqn: \>\"", ",", 
                    RowBox[{
                    RowBox[{"currentTallyData", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "//", "N"}]}], "]"}], ";",
                    "\[IndentingNewLine]", 
                   RowBox[{"Print", "[", 
                    RowBox[{"\"\<     tally eqn prec: \>\"", ",", 
                    RowBox[{"Precision", "@", 
                    RowBox[{"currentTallyData", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}]}], "]"}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"Print", "[", 
                    RowBox[{"\"\<     tally root: \>\"", ",", 
                    RowBox[{
                    RowBox[{"currentTally", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "//", "N"}]}], "]"}], ";",
                    "\[IndentingNewLine]", 
                   RowBox[{"Print", "[", 
                    RowBox[{"\"\<     tally root prec: \>\"", ",", 
                    RowBox[{"Precision", "@", 
                    RowBox[{"currentTally", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}]}], "]"}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"Print", "[", 
                    RowBox[{
                    "\"\<     multiplicity: \>\"", ",", "multiplicity"}], 
                    "]"}], ";", "\[IndentingNewLine]", 
                   RowBox[{
                   "Print", "[", "\"\<     Running derivative root eqn: \>\"",
                     "]"}], ";", "\[IndentingNewLine]", 
                   RowBox[{"Print", "[", 
                    RowBox[{
                    "\"\<     Precision of derivative equation: \>\"", ",", 
                    RowBox[{"Precision", "@", 
                    RowBox[{"D", "[", 
                    RowBox[{
                    RowBox[{"currentTallyData", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"x", ",", 
                    RowBox[{"multiplicity", "-", "1"}]}], "}"}]}], "]"}]}]}], 
                    "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"multiRootPrec", "=", 
                 RowBox[{"Floor", "@", 
                  RowBox[{"Precision", "@", 
                   RowBox[{"currentTallyData", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}]}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"(*", 
                 RowBox[{
                  RowBox[{"Print", "[", 
                   RowBox[{
                    RowBox[{"Style", "[", 
                    RowBox[{"\"\<multiRoot equation Prec: \>\"", ",", "Red"}],
                     "]"}], ",", "multiRootPrec"}], "]"}], ";"}], "*)"}], 
                "\[IndentingNewLine]", 
                RowBox[{"newX", "=", 
                 RowBox[{"x", "/.", 
                  RowBox[{"NSolve", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"D", "[", 
                    RowBox[{
                    RowBox[{"currentTallyData", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"x", ",", 
                    RowBox[{"multiplicity", "-", "1"}]}], "}"}]}], "]"}], "==",
                     "0"}], ",", "x"}], 
                   RowBox[{"(*", 
                    RowBox[{",", 
                    RowBox[{"WorkingPrecision", "->", 
                    RowBox[{"(", "multiRootPrec", ")"}]}]}], "*)"}], 
                   "]"}]}]}], ";", "\[IndentingNewLine]", 
                RowBox[{"If", "[", 
                 RowBox[{"$printPolishRootFlag", ",", "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"Print", "[", 
                    RowBox[{"\"\<Roots from derivative NSolve: \>\"", ",", 
                    RowBox[{"newX", "//", "N"}]}], "]"}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"Print", "[", 
                    RowBox[{
                    "\"\<Precision of roots from derivative NSolve: \>\"", 
                    ",", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Precision", "@", "#"}], "&"}], "/@", " ", 
                    "newX"}]}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], 
                ";", "\[IndentingNewLine]", 
                RowBox[{"(*", "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"find", " ", "tally", " ", "root", " ", "in", " ", 
                   RowBox[{"newX", ":", " ", "newX"}]}], ",", "tallyRootAcc", 
                  ",", "rootPos", ",", "newRoot"}], "\[IndentingNewLine]", 
                 "*)"}], "\[IndentingNewLine]", 
                RowBox[{"tallyRootAcc", "=", 
                 RowBox[{"Floor", "@", 
                  RowBox[{"Accuracy", "@", 
                   RowBox[{"currentTally", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}]}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"rootTallyPrec", "=", 
                 RowBox[{"Min", "@", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"Floor", "@", 
                    RowBox[{"Precision", "@", 
                    RowBox[{"currentTally", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}]}], ",", 
                    RowBox[{"Floor", "@", 
                    RowBox[{"Precision", "@", "newX"}]}]}], "}"}]}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"(*", 
                 RowBox[{
                  RowBox[{"Print", "[", 
                   RowBox[{
                    RowBox[{"Style", "[", 
                    RowBox[{"\"\<rootTallyPrec: \>\"", ",", "Red"}], "]"}], 
                    ",", "rootTallyPrec"}], "]"}], ";"}], "*)"}], 
                "\[IndentingNewLine]", 
                RowBox[{"difTable", "=", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Abs", "[", 
                    RowBox[{"#", "-", 
                    RowBox[{"currentTally", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "&"}], "/@", " ",
                   "newX"}]}], ";", "\[IndentingNewLine]", 
                RowBox[{"(*", 
                 RowBox[{
                  RowBox[{"Print", "[", 
                   RowBox[{
                    RowBox[{"Style", "[", 
                    RowBox[{"\"\<multi root difTable: \>\"", ",", "Red"}], 
                    "]"}], ",", 
                    RowBox[{"N", "[", 
                    RowBox[{"difTable", ",", "10"}], "]"}]}], "]"}], ";"}], 
                 "*)"}], "\[IndentingNewLine]", 
                RowBox[{"altPosArray", "=", 
                 RowBox[{"Position", "[", 
                  RowBox[{"difTable", ",", 
                   RowBox[{"Min", "[", "difTable", "]"}]}], "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"(*", 
                 RowBox[{
                  RowBox[{"Print", "[", 
                   RowBox[{
                    RowBox[{"Style", "[", 
                    RowBox[{"\"\<alt root pos: \>\"", ",", "Red"}], "]"}], 
                    ",", "altPos"}], "]"}], ";", "\[IndentingNewLine]", 
                  RowBox[{"Print", "[", 
                   RowBox[{
                    RowBox[{"Style", "[", 
                    RowBox[{"\"\<     altRoot: \>\"", ",", "Red"}], "]"}], 
                    ",", 
                    RowBox[{"N", "[", 
                    RowBox[{
                    RowBox[{"newX", "[", 
                    RowBox[{"[", "altPos", "]"}], "]"}], ",", "10"}], "]"}]}],
                    "]"}], ";"}], "\[IndentingNewLine]", "*)"}], 
                "\[IndentingNewLine]", 
                RowBox[{"(*", 
                 RowBox[{
                  RowBox[{"rootPosArray", "=", 
                   RowBox[{"Position", "[", 
                    RowBox[{"newX", ",", 
                    RowBox[{"x_", "/;", 
                    RowBox[{
                    RowBox[{"Abs", "[", 
                    RowBox[{"x", "-", 
                    RowBox[{"currentTally", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "<", 
                    RowBox[{"10", "^", 
                    RowBox[{"-", 
                    RowBox[{"(", 
                    RowBox[{"rootTallyPrec", "-", "50"}], ")"}]}]}]}]}]}], 
                    "]"}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Length", "@", "altPosArray"}], "==", "0"}], ",", 
                  "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"Print", "[", 
                    RowBox[{"Style", "[", 
                    RowBox[{
                    "\"\<polishCharRoot: Position error!\>\"", ",", "12", ",",
                     "Red"}], "]"}], "]"}], ";", "\[IndentingNewLine]", 
                   RowBox[{"Print", "[", 
                    RowBox[{"\"\<altPos: \>\"", ",", "altPosArray"}], "]"}], 
                   ";", "\[IndentingNewLine]", 
                   RowBox[{"Abort", "[", "]"}], ";"}]}], 
                 "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
                RowBox[{"(*", 
                 RowBox[{
                  RowBox[{"rootPos", "=", 
                   RowBox[{"rootPosArray", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";"}], 
                 "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
                RowBox[{"altPos", "=", 
                 RowBox[{"altPosArray", "[", 
                  RowBox[{"[", 
                   RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"If", "[", 
                 RowBox[{"$printPolishRootFlag", ",", "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"Print", "[", 
                    RowBox[{"\"\<tallyRootAcc: \>\"", ",", "tallyRootAcc"}], 
                    "]"}], ";", "\[IndentingNewLine]", 
                   RowBox[{"Print", "[", 
                    RowBox[{"\"\<root dif: \>\"", ",", 
                    RowBox[{"N", "[", 
                    RowBox[{
                    RowBox[{"Abs", "[", 
                    RowBox[{"newX", "-", 
                    RowBox[{"currentTally", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ",", "20"}], 
                    "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
                   RowBox[{"Print", "[", 
                    RowBox[{"\"\<     root position: \>\"", ",", "altPos"}], 
                    "]"}], ";", "\[IndentingNewLine]", 
                   RowBox[{"Print", "[", 
                    RowBox[{"\"\<     newX vals: \>\"", ",", 
                    RowBox[{
                    RowBox[{"newX", "[", 
                    RowBox[{"[", "altPos", "]"}], "]"}], "//", "N"}]}], "]"}],
                    ";", "\[IndentingNewLine]", 
                   RowBox[{"Print", "[", 
                    RowBox[{"\"\<     Prec of newX vals: \>\"", ",", 
                    RowBox[{"Precision", "@", 
                    RowBox[{"newX", "[", 
                    RowBox[{"[", "altPos", "]"}], "]"}]}]}], "]"}], ";"}]}], 
                 "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
                RowBox[{"(*", "\[IndentingNewLine]", " ", 
                 RowBox[{
                  RowBox[{
                  "now", " ", "replace", " ", "root", " ", "with", " ", 
                   "higher"}], "-", 
                  RowBox[{"precision", " ", "version"}]}], 
                 "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
                RowBox[{"(*", 
                 RowBox[{
                  RowBox[{"newRoot", "=", 
                   RowBox[{"newX", "[", 
                    RowBox[{"[", "rootPos", "]"}], "]"}]}], ";"}], "*)"}], 
                "\[IndentingNewLine]", 
                RowBox[{"newRoot", "=", 
                 RowBox[{"newX", "[", 
                  RowBox[{"[", "altPos", "]"}], "]"}]}], ";"}], 
               "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"newRoot", "=", 
                 RowBox[{"currentTally", "[", 
                  RowBox[{"[", "1", "]"}], "]"}]}], ";"}]}], 
              "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"AppendTo", "[", 
              RowBox[{"newRootArray", ",", 
               RowBox[{"{", 
                RowBox[{"newRoot", ",", "multiplicity"}], "}"}]}], "]"}], 
             ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"netArray", ",", "newRootArray"}], "]"}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       "netArray"}]}], "\[IndentingNewLine]", "]"}]}], ";"}]}]], "Input",
 InitializationGroup->True,
 CellChangeTimes->{{3.93789616378286*^9, 3.9378961642204742`*^9}, {
   3.937896362268013*^9, 3.9378964401869664`*^9}, {3.938189737931316*^9, 
   3.938189775248083*^9}, {3.9381898985840425`*^9, 3.9381899275124693`*^9}, {
