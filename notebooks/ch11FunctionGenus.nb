Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{"rNormArray", " ", "is", " ", 
    RowBox[{"1", "/", "2"}], " ", "distance", " ", "to", " ", "either", " ", 
    "nearest", " ", "singular", " ", "point", " ", "or", " ", "outer", " ", 
    "annular", " ", "value"}], "\[IndentingNewLine]", "*)"}], "\n", 
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{"$minRadiusArray", " ", "is", " ", 
    RowBox[{"1", "/", "3"}], " ", "distance", " ", "to", " ", "either", " ", 
    "nearest", " ", "singular", " ", "point", " ", "or", " ", "outer", " ", 
    "annular", " ", "value"}], "\[IndentingNewLine]", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Options", "[", "getSingularPoints", "]"}], "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<diag\>\"", "->", "False"}], ",", 
       RowBox[{"\"\<workingPrecision\>\"", "->", "1000"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"getSingularPoints", "[", 
      RowBox[{"theFunction_", ",", 
       RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "i", ",", "theSingularSet", ",", "theSingularList", ",", "wExpList", 
         ",", "poleFuntion", ",", "pExp", ",", "poleIndexes", ",", 
         "poleFunction", ",", "polePositions", ",", "singularReport", ",", 
         "theArgList", ",", "nearestSing", ",", "nearestDistArray", ",", 
         "minRadiusArray", ",", "thePoleList", ",", "theReturn", ",", 
         "singAccuracy", ",", "poleAccuracy", ",", "thePoleSet", ",", "poleF",
          ",", "res", ",", "at1", ",", "at2", ",", "zeroIndexes", ",", 
         "originCheck", ",", "rNormArray"}], "\[IndentingNewLine]", "}"}], 
       ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"OptionValue", "[", "\"\<workingPrecision\>\"", "]"}], "<",
            "1000"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"Style", "[", 
             RowBox[{
             "\"\<WorkingPrecision must be greater than or equal to 1000\>\"",
               ",", "Red"}], "]"}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"theReturn", "=", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", 
              RowBox[{"-", "1"}], ",", 
              RowBox[{"-", "1"}], ",", 
              RowBox[{"-", "1"}], ",", 
              RowBox[{"-", "1"}], ",", 
              RowBox[{"-", "1"}], ",", 
              RowBox[{"-", "1"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
          ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"!", 
              RowBox[{"strictPolynomialQ", "[", 
               RowBox[{"theFunction", ",", 
                RowBox[{"{", 
                 RowBox[{"z", ",", "w"}], "}"}]}], "]"}]}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Print", "[", 
               RowBox[{"Style", "[", 
                RowBox[{
                "\"\<Function not a strict polynomial with rational \
coefficients in z and w\>\"", ",", "Red"}], "]"}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"theReturn", "=", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "1"}], ",", 
                 RowBox[{"-", "1"}], ",", 
                 RowBox[{"-", "1"}], ",", 
                 RowBox[{"-", "1"}], ",", 
                 RowBox[{"-", "1"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
             ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"!", 
                 RowBox[{
                 "IrreduciblePolynomialQ", "[", "theFunction", "]"}]}], ",", 
                "\[IndentingNewLine]", 
                RowBox[{"{", "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"Print", "[", 
                   RowBox[{
                    RowBox[{"Style", "[", 
                    RowBox[{"\"\<Function is reducible:  \>\"", ",", "Red"}], 
                    "]"}], ",", 
                    RowBox[{"Style", "[", 
                    RowBox[{
                    RowBox[{"Factor", "[", "theFunction", "]"}], ",", "Red"}],
                     "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
                  RowBox[{"theReturn", "=", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"-", "1"}], ",", 
                    RowBox[{"-", "1"}], ",", 
                    RowBox[{"-", "1"}], ",", 
                    RowBox[{"-", "1"}], ",", 
                    RowBox[{"-", "1"}], ",", 
                    RowBox[{"-", "1"}], ",", 
                    RowBox[{"-", "1"}]}], "}"}]}], ";"}], 
                 "\[IndentingNewLine]", "}"}], "\[IndentingNewLine]", ",", 
                "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"at1", "=", 
                  RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"res", "=", 
                    RowBox[{"Resultant", "[", 
                    RowBox[{"theFunction", ",", 
                    RowBox[{"D", "[", 
                    RowBox[{"theFunction", ",", "w"}], "]"}], ",", "w"}], 
                    "]"}]}], ";"}], "\[IndentingNewLine]", "]"}]}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{"OptionValue", "[", "\"\<diag\>\"", "]"}], ",", 
                   "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"Print", "[", 
                    RowBox[{"\"\<Time to compute resultant: \>\"", ",", 
                    RowBox[{"at1", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ";"}]}], 
                  "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
                 RowBox[{"at2", "=", 
                  RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"theSingularSet", "=", 
                    RowBox[{"Sort", "[", 
                    RowBox[{
                    RowBox[{"z", "/.", 
                    RowBox[{"NSolve", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Simplify", "@", "res"}], "\[Equal]", "0"}], ",", 
                    "z", ",", 
                    RowBox[{"WorkingPrecision", "\[Rule]", 
                    RowBox[{
                    "OptionValue", "[", "\"\<workingPrecision\>\"", "]"}]}]}],
                     "]"}]}], ",", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "@", "#1"}], "<=", " ", 
                    RowBox[{"Abs", "@", "#2"}]}], "&"}]}], "]"}]}], ";"}], 
                   "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{"OptionValue", "[", "\"\<diag\>\"", "]"}], ",", 
                   "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"Print", "[", 
                    RowBox[{"\"\<Time to compute singular points: \>\"", ",", 
                    RowBox[{"at2", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ";"}]}], 
                  "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
                 RowBox[{"singAccuracy", "=", 
                  RowBox[{"Floor", "@", 
                   RowBox[{"Accuracy", "@", "theSingularSet"}]}]}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    RowBox[{"Length", "@", "theSingularSet"}], "==", "0"}], 
                    " ", "||", " ", 
                    RowBox[{"singAccuracy", "<", "900"}]}], ",", 
                   "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"Print", "[", 
                    RowBox[{"Style", "[", 
                    RowBox[{
                    "\"\<No singular points found or sing accuracy<900\>\"", 
                    ",", "Red"}], "]"}], "]"}], ";", "\[IndentingNewLine]", 
                    RowBox[{"theReturn", "=", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"-", "1"}], ",", 
                    RowBox[{"-", "1"}], ",", 
                    RowBox[{"-", "1"}], ",", 
                    RowBox[{"-", "1"}], ",", 
                    RowBox[{"-", "1"}], ",", 
                    RowBox[{"-", "1"}], ",", 
                    RowBox[{"-", "1"}]}], "}"}]}], ";"}], 
                   "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"theSingularList", "=", 
                    RowBox[{"DeleteDuplicates", "[", 
                    RowBox[{"theSingularSet", ",", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "[", 
                    RowBox[{"#1", "-", "#2"}], "]"}], "<", 
                    RowBox[{"10", "^", 
                    RowBox[{"-", 
                    RowBox[{"(", 
                    RowBox[{"singAccuracy", "-", "$acf"}], ")"}]}]}]}], 
                    "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
                    RowBox[{"(*", "\[IndentingNewLine]", " ", 
                    RowBox[{
                    RowBox[{
                    "now", " ", "get", " ", "zero", " ", "points", " ", "a_", 
                    "0", 
                    RowBox[{"(", "z", ")"}]}], "=", 
                    RowBox[{
                    RowBox[{"0", " ", "when", " ", "either", " ", "$a_", "1", 
                    RowBox[{"(", "z", ")"}]}], "=", 
                    RowBox[{
                    RowBox[{"0", " ", "or", " ", "$a_", "0"}], "=", 
                    RowBox[{"a_", "1"}]}]}]}], "\[IndentingNewLine]", "*)"}], 
                    "\[IndentingNewLine]", 
                    RowBox[{"zeroIndexes", "=", 
                    RowBox[{"getZeroIndexes", "[", 
                    RowBox[{
                    "theFunction", ",", "theSingularList", ",", "False"}], 
                    "]"}]}], ";", "\[IndentingNewLine]", 
                    RowBox[{"(*", 
                    RowBox[{
                    RowBox[{"Print", "[", 
                    RowBox[{"\"\<zeroIndexes: \>\"", ",", "zeroIndexes"}], 
                    "]"}], ";"}], "*)"}], "\[IndentingNewLine]", 
                    RowBox[{"(*", "\[IndentingNewLine]", 
                    RowBox[{"get", " ", "poles"}], "\[IndentingNewLine]", 
                    "*)"}], "\[IndentingNewLine]", 
                    RowBox[{"poleIndexes", "=", 
                    RowBox[{"getPoles", "[", 
                    RowBox[{
                    "theFunction", ",", "theSingularList", ",", "False"}], 
                    "]"}]}], ";", "\[IndentingNewLine]", 
                    "\[IndentingNewLine]", 
                    RowBox[{"(*", "\[IndentingNewLine]", " ", 
                    RowBox[{
                    RowBox[{
                    "compute", " ", "minArray", " ", "of", " ", "integration",
                     " ", "region", " ", "around", " ", "each", " ", 
                    "singular", " ", "point", " ", "if", " ", "total"}], " ", 
                    ">", " ", "1"}], " ", "\[IndentingNewLine]", "*)"}], 
                    "\[IndentingNewLine]", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Length", "@", "theSingularList"}], ">", "1"}], 
                    ",", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"nearestSing", "=", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"NearestTo", "[", 
