Cell[CellGroupData[{

Cell["genericAtOrigin", "Subsection",
 CellChangeTimes->{{3.948274583063485*^9, 3.948274586078577*^9}, {
  3.9482746683718243`*^9, 3.9482746706523395`*^9}, {3.966528893030776*^9, 
  3.966528895503276*^9}},ExpressionUUID->"df55338f-b273-42fb-8e17-\
0518f3a51f3f"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"genericAtOrigin", "[", "theF_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "value", ",", "fVals", ",", "fAcc", ",", "dVals", ",", "dAcc", ",", 
        "minAcc", ",", "return", ",", "wRules", ",", "wKeys", ",", 
        "anValues"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"wRules", "=", 
        RowBox[{"CoefficientRules", "[", 
         RowBox[{"theF", ",", "w", ",", "\"\<NegativeLexicographic\>\""}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"wKeys", "=", 
        RowBox[{"Keys", "[", "wRules", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"anValues", "=", 
        RowBox[{"Values", "[", "wRules", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", "\[IndentingNewLine]", " ", 
        RowBox[{"first", " ", "check", " ", "for", " ", "poles"}], 
        "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"return", "=", "False"}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"anValues", "[", 
             RowBox[{"[", 
              RowBox[{"-", "1"}], "]"}], "]"}], "/.", 
            RowBox[{"z", "->", "0"}]}], ")"}], "===", "0"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", "\"\<Detected pole\>\"", "]"}], ";"}], 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"return", "=", "True"}], ";"}], "*)"}], 
         "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
         RowBox[{"(*", "\[IndentingNewLine]", " ", 
          RowBox[{
           RowBox[{"next", " ", "check", " ", "for", " ", "q"}], "-", 
           RowBox[{"points", " ", "if", " ", "now", " ", 
            RowBox[{"w", "^", "1"}], " ", "term"}]}], "\[IndentingNewLine]", 
          "*)"}], "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"!", 
              RowBox[{"MemberQ", "[", 
               RowBox[{
                RowBox[{"Flatten", "[", "wKeys", "]"}], ",", "1"}], "]"}]}], 
             " ", "&&", " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"anValues", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "/.", 
                RowBox[{"z", "->", "0"}]}], ")"}], "===", "0"}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Print", "[", "\"\<Detected q-point\>\"", "]"}], ";"}], 
            "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{"return", "=", "True"}], ";"}], "*)"}], 
            "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
            RowBox[{"(*", "\[IndentingNewLine]", 
             RowBox[{
             "now", " ", "check", " ", "if", " ", "the", " ", "origin", " ", 
              "is", " ", "a", " ", "generic", " ", "singular", " ", "point"}],
              "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"value", "=", 
              RowBox[{"theF", "/.", 
               RowBox[{"z", "->", "0"}]}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"Print", "[", "\"\<test\>\"", "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"!", 
                RowBox[{"NumberQ", "[", "value", "]"}]}], ",", 
               "\[IndentingNewLine]", " ", 
               RowBox[{
                RowBox[{"fVals", "=", 
                 RowBox[{"Sort", "[", 
                  RowBox[{"w", "/.", 
                   RowBox[{"NSolve", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"theF", "==", "0"}], "/.", 
                    RowBox[{"z", "->", "0"}]}], ",", "w", ",", 
                    RowBox[{"WorkingPrecision", "->", "25"}]}], "]"}]}], 
                  "]"}]}], ";", "\[IndentingNewLine]", 
                RowBox[{"(*", 
                 RowBox[{
                  RowBox[{"Print", "[", 
                   RowBox[{"\"\<fVals: \>\"", ",", 
                    RowBox[{
                    RowBox[{"Sort", "@", "fVals"}], "//", "N"}]}], "]"}], 
                  ";"}], "*)"}], "\[IndentingNewLine]", 
                RowBox[{"fAcc", "=", 
                 RowBox[{"Floor", "@", 
                  RowBox[{"Accuracy", "[", "fVals", "]"}]}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"(*", "\[IndentingNewLine]", " ", 
                 RowBox[{
                 "first", " ", "check", " ", "if", " ", "f_w", " ", "is", " ",
                   "not", " ", "zero"}], "\[IndentingNewLine]", "*)"}], 
                "\[IndentingNewLine]", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"D", "[", 
                    RowBox[{"theF", ",", "w"}], "]"}], "/.", 
                    RowBox[{"z", "->", "0"}]}], ")"}], "===", "0"}], ",", 
                  "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"Print", "[", 
                    RowBox[{"Style", "[", 
                    RowBox[{
                    "\"\<Cannot determine singularity at zero with \
derivatives: \!\(\*SubscriptBox[\(f\), \(w\)]\) at zero is zero!\>\"", ",", 
                    "Red"}], "]"}], "]"}], ";", "\[IndentingNewLine]", 
                   RowBox[{"return", "=", "\"\<error\>\""}], ";"}], 
                  "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"dVals", "=", 
                    RowBox[{"Sort", "[", 
                    RowBox[{"w", "/.", 
                    RowBox[{"NSolve", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"D", "[", 
                    RowBox[{"theF", ",", "w"}], "]"}], "==", "0"}], "/.", 
                    RowBox[{"z", "->", "0"}]}], ",", "w", ",", 
                    RowBox[{"WorkingPrecision", "->", "25"}]}], "]"}]}], 
                    "]"}]}], ";", "\[IndentingNewLine]", 
                   RowBox[{"dAcc", "=", 
                    RowBox[{"Floor", "@", 
                    RowBox[{"Accuracy", "[", "dVals", "]"}]}]}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"minAcc", "=", 
                    RowBox[{
                    RowBox[{"Min", "[", 
                    RowBox[{"fAcc", ",", "dAcc"}], "]"}], "-", "5"}]}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"(*", 
                    RowBox[{
                    RowBox[{"Print", "[", 
                    RowBox[{"\"\<dVals: \>\"", ",", 
                    RowBox[{"Sort", "@", "dVals"}]}], "]"}], ";"}], "*)"}], 
                   "\[IndentingNewLine]", 
                   RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Length", "@", 
                    RowBox[{"Intersection", "[", 
                    RowBox[{"fVals", ",", "dVals", ",", 
                    RowBox[{"SameTest", "->", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "[", 
                    RowBox[{"#1", "-", "#2"}], "]"}], "<", 
                    RowBox[{"10", "^", 
                    RowBox[{"-", "10"}]}]}], "&"}], ")"}]}]}], "]"}]}], "!=", 
                    "0"}], ",", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"return", "=", "True"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"Print", "[", 
                    RowBox[{"Style", "[", 
                    RowBox[{
                    "\"\<Detected generic singular point at origin\>\"", ",", 
                    "Purple"}], "]"}], "]"}], ";"}], "\[IndentingNewLine]", 
                    ",", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"return", "=", "False"}], ";"}]}], 
                    "\[IndentingNewLine]", "]"}], ";"}]}], 
                 "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
               ",", "\[IndentingNewLine]", 
               RowBox[{"(*", "\[IndentingNewLine]", " ", 
                RowBox[{
                 RowBox[{"fVal", "/", "z"}], "->", " ", 
                 RowBox[{"is", " ", "a", " ", "number", " ", "only"}]}], 
                "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"Print", "[", 
                 RowBox[{"Style", "[", 
                  RowBox[{
                  "\"\<Cannot determine singularity at zero with this \
routine.  Function at zero is a number\>\"", ",", "Red"}], "]"}], "]"}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"return", "=", "\"\<error\>\""}], ";"}]}], 
              "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", 
           "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
       "\[IndentingNewLine]", "return"}]}], "\[IndentingNewLine]", "]"}]}], 
   ";"}]}]], "Input",
 CellChangeTimes->{{3.9482793954246254`*^9, 3.9482794898870125`*^9}, {
  3.9482798779692163`*^9, 3.948279887716935*^9}, {3.948282243799096*^9, 
