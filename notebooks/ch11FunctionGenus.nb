Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "getFiniteRHSum", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{"\"\<diag\>\"", "->", "False"}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"getFiniteRHSum", "[", 
    RowBox[{
    "puiseuxTable_", ",", "theSingularList_", ",", "poleIndexes_", ",", 
     "functionDegree_", ",", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "singularFlag", ",", "poleIndexTally", ",", "finiteRam", ",", "segNum", 
       ",", "singIndex", ",", "cycleList", ",", "poleData", ",", "netExpList",
        ",", "finiteList", ",", "higherRamifiedIndexes", ",", 
       "unRamifiedPoleIndexes", ",", "poleTruth", ",", 
       "minimalRamifiedIndexes", ",", "tList", ",", "fList", ",", "sList", 
       ",", "finiteRHSum"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", "\[IndentingNewLine]", 
      RowBox[{
      "now", " ", "check", " ", "ramifications", " ", "and", " ", "poles"}], 
      "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"singularFlag", "=", "True"}], ";", "\[IndentingNewLine]", 
      RowBox[{"poleIndexTally", "=", "0"}], ";", "\[IndentingNewLine]", 
      RowBox[{"finiteRam", "=", 
       RowBox[{"puiseuxTable", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "3"}], "}"}]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"finiteRam", "=", 
       RowBox[{"Table", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Reverse", "@", "#"}], "&"}], "/@", 
            RowBox[{"finiteRam", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "1"}], "]"}], "]"}]}], ",", 
           RowBox[{"finiteRam", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "2"}], "]"}], "]"}]}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", 
           RowBox[{"Length", "@", "finiteRam"}]}], "}"}]}], 
        "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]",
       "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"segNum", "=", "1"}], ",", 
        RowBox[{"segNum", "<=", 
         RowBox[{"Length", "@", "puiseuxTable"}]}], ",", 
        RowBox[{"segNum", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"singIndex", "=", 
          RowBox[{"puiseuxTable", "[", 
           RowBox[{"[", 
            RowBox[{"segNum", ",", "3"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", " ", 
         RowBox[{"cycleList", "=", 
          RowBox[{"puiseuxTable", "[", 
           RowBox[{"[", 
            RowBox[{"segNum", ",", "2", ",", "All", ",", "3"}], "]"}], 
           "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{
            RowBox[{
            "first", " ", "check", " ", "if", " ", "have", " ", "all", " ", 
             "1"}], "-", 
            RowBox[{
            "cycles", " ", "at", " ", "this", " ", "singular", " ", 
             "point"}]}], ",", " ", 
           RowBox[{
           "then", " ", "must", " ", "have", " ", "at", " ", "least", " ", 
            "one", " ", "pole"}]}], " ", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Length", "@", 
              RowBox[{"Cases", "[", 
               RowBox[{"cycleList", ",", 
                RowBox[{"x_", "/;", 
                 RowBox[{"x", ">", "1"}]}]}], "]"}]}], "==", "0"}], " ", "&&",
             " ", 
            RowBox[{"!", 
             RowBox[{"MemberQ", "[", 
              RowBox[{"poleIndexes", ",", "singIndex"}], "]"}]}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Print", "[", 
             RowBox[{
              RowBox[{"Style", "[", 
               RowBox[{
               "\"\<Found only 1-cycles with no pole at singular index: \>\"",
                 ",", "Red"}], "]"}], ",", "singIndex", ",", 
              "\"\<sing point: \>\"", ",", 
              RowBox[{
               RowBox[{"theSingularList", "[", 
                RowBox[{"[", "singIndex", "]"}], "]"}], "//", "N"}]}], "]"}], 
            ";", "\[IndentingNewLine]", 
            RowBox[{"singularFlag", "=", "False"}], ";"}]}], 
          "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", "\[IndentingNewLine]", " ", 
          RowBox[{
           RowBox[{"confirm", " ", "if", " ", "all", " ", "1"}], "-", 
           RowBox[{
           "cycle", " ", "and", " ", "pole", " ", "index", " ", "that", " ", 
            "have", " ", "negative", " ", "exponents"}]}], " ", 
          "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"MemberQ", "[", 
            RowBox[{"poleIndexes", ",", "singIndex"}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"poleData", "=", 
             RowBox[{"puiseuxTable", "[", 
              RowBox[{"[", 
               RowBox[{"segNum", ",", "2", ",", "All", ",", 
                RowBox[{"{", 
                 RowBox[{"4", ",", "5"}], "}"}]}], "]"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"netExpList", "=", 
             RowBox[{"Flatten", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"FoldList", "[", 
                  RowBox[{"Plus", ",", 
                   RowBox[{"#1", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "-", 
                 RowBox[{"#", "[", 
                  RowBox[{"[", "2", "]"}], "]"}]}], "&"}], " ", "/@", " ", 
               "poleData"}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"AnyTrue", "[", 
               RowBox[{"netExpList", ",", "Negative"}], "]"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"(*", 
               RowBox[{
                RowBox[{"Print", "[", 
                 RowBox[{
                  RowBox[{"Style", "[", 
                   RowBox[{
                   "\"\<Pole confirmed at singular index \>\"", ",", "Red"}], 
                   "]"}], ",", 
                  RowBox[{"Style", "[", 
                   RowBox[{"singIndex", ",", "Red"}], "]"}]}], "]"}], ";"}], 
               "*)"}], "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"poleIndexTally", "++"}], ";"}], "\[IndentingNewLine]",
               ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"Print", "[", 
                RowBox[{
                 RowBox[{"Style", "[", 
                  RowBox[{
                  "\"\<Did not find pole at expected singular point\>\"", ",",
                    "Red", ",", "14"}], "]"}], ",", 
                 RowBox[{"Style", "[", 
