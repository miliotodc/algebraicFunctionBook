Cell[CellGroupData[{

Cell["getZeroIndexes", "Subsection",
 InitializationGroup->True,
 CellChangeTimes->{{3.894362768159027*^9, 3.894362771564473*^9}, {
  3.8943648054975176`*^9, 
  3.8943648076554794`*^9}},ExpressionUUID->"d66efa6b-f362-49a6-ac55-\
d3f88e2d6982"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"getZeroIndexes", "[", 
     RowBox[{"theFunction_", ",", "theSingularList_", ",", 
      RowBox[{"diag_", ":", "False"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "wKeys", ",", "a0Rule", ",", "a1Rule", ",", "theZeroPoints", ",", 
        "zeroPrecision", ",", "duplicateError", ",", "zeroIndexes", ",", 
        "theZeroList", ",", "singPrecision", ",", "difTable", ",", "maxDif", 
        ",", "rootPrecisionTable", ",", "dif"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"wKeys", "=", 
        RowBox[{"CoefficientRules", "[", 
         RowBox[{
         "theFunction", ",", "w", ",", "\"\<NegativeLexicographic\>\""}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"a0Rule", "=", 
        RowBox[{"Normal", "@", 
         RowBox[{"KeyTake", "[", 
          RowBox[{"wKeys", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", "0", "}"}], ",", "z"}], "}"}]}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"singPrecision", "=", 
        RowBox[{"Floor", "@", 
         RowBox[{"Precision", "@", "theSingularList"}]}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "@", "a0Rule"}], ">", "0"}], " ", ",", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{"found", " ", "a_", "0"}], " ", "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Exponent", "[", 
              RowBox[{
               RowBox[{"a0Rule", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "2"}], "]"}], "]"}], ",", "z"}], "]"}], 
             ">", "0"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"a1Rule", "=", 
              RowBox[{"Normal", "@", 
               RowBox[{"KeyTake", "[", 
                RowBox[{"wKeys", ",", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"{", "1", "}"}], ",", "z"}], "}"}]}], "]"}]}]}], 
             ";", "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Length", "@", "a1Rule"}], ">", "0"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"(*", " ", 
                RowBox[{
                "now", " ", "have", " ", "a0", " ", "and", " ", "a1", " ", 
                 "in", " ", "function"}], " ", "*)"}], "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Exponent", "[", 
                    RowBox[{
                    RowBox[{"a1Rule", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}], ",", "z"}], "]"}], 
                   ">", "0"}], ",", "\[IndentingNewLine]", 
                  RowBox[{"(*", " ", 
                   RowBox[{
                    RowBox[{
                    "a1", " ", "is", " ", "a", " ", "poly", " ", "degree"}], 
                    ">", "0"}], " ", "*)"}], "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"a0Rule", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}], "===", 
                    RowBox[{"a1Rule", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{"(*", " ", 
                    RowBox[{
                    RowBox[{"at", " ", "this", " ", "point", " ", "a0"}], "===", 
                    RowBox[{
                    RowBox[{"a1", " ", "poly", " ", "degree"}], ">", 
                    RowBox[{
                    "0", " ", "so", " ", "zero", " ", "terms", " ", "are", 
                    " ", "zeros", " ", "to", " ", "a0"}]}]}], " ", "*)"}], 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"theZeroPoints", "=", 
                    RowBox[{"Sort", "[", 
                    RowBox[{
                    RowBox[{"z", "/.", 
                    RowBox[{"NSolve", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Factor", "@", 
                    RowBox[{"a0Rule", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}]}], "\[Equal]", 
                    "0"}], ",", "z", ",", 
                    RowBox[{
                    "WorkingPrecision", "\[Rule]", "singPrecision"}]}], 
                    "]"}]}], ",", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "@", "#1"}], "<=", 
                    RowBox[{"Abs", "@", "#2"}]}], "&"}]}], "]"}]}], ";"}], 
                    "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
                    RowBox[{"(*", 
                    RowBox[{
                    RowBox[{"Print", "[", 
                    RowBox[{"Style", "[", 
                    RowBox[{
                    "\"\<No zero key singular points\>\"", ",", "Red"}], 
                    "]"}], "]"}], ";"}], "*)"}], "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"theZeroPoints", "=", 
                    RowBox[{"{", "}"}]}], ";"}]}], "\[IndentingNewLine]", 
                    "]"}], ";"}], "\[IndentingNewLine]", ",", 
                  "\[IndentingNewLine]", 
                  RowBox[{"(*", " ", 
                   RowBox[{
                   "if", " ", "a1", " ", "is", " ", "a", " ", "constant", " ",
                     "zero", " ", "set", " ", "is", " ", "null"}], " ", 
                   "*)"}], "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"theZeroPoints", "=", 
                    RowBox[{"{", "}"}]}], ";"}]}], "\[IndentingNewLine]", 
                 "]"}], ";"}], "\[IndentingNewLine]", ",", 
               "\[IndentingNewLine]", 
               RowBox[{"(*", " ", 
                RowBox[{
                "have", " ", "no", " ", "a1", " ", "at", " ", "this", " ", 
                 "point"}], " ", "*)"}], "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"theZeroPoints", "=", 
                 RowBox[{"Sort", "[", 
                  RowBox[{
                   RowBox[{"z", "/.", 
                    RowBox[{"NSolve", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Factor", "@", 
                    RowBox[{"a0Rule", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}]}], "\[Equal]", 
                    "0"}], ",", "z", ",", 
                    RowBox[{
                    "WorkingPrecision", "\[Rule]", "singPrecision"}]}], 
                    "]"}]}], ",", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "@", "#1"}], "<=", 
                    RowBox[{"Abs", "@", "#2"}]}], "&"}]}], "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"(*", "\[IndentingNewLine]", " ", 
                 RowBox[{"now", " ", "confirm", " ", "solutions"}], 
                 "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
                RowBox[{"difTable", "=", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{"a0Rule", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}], "/.", 
                    RowBox[{"z", "->", "#"}]}], "&"}], "/@", " ", 
                  "theZeroPoints"}]}], ";", "\[IndentingNewLine]", 
                RowBox[{"rootPrecisionTable", "=", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Precision", "@", "#"}], "&"}], "/@", " ", 
                  "difTable"}]}], ";", "\[IndentingNewLine]", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Min", "@", "rootPrecisionTable"}], ">", "10"}], 
                  ",", "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"maxDif", "=", 
                    RowBox[{"Max", "@", "difTable"}]}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"maxDif", ">", "$maxRootVerifyDifference"}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"Print", "[", 
                    RowBox[{"Style", "[", 
                    RowBox[{
                    "\"\<Verification of theZeroPoints roots exceeded the \
$maxRootVerifyDifference\>\"", ",", "Red", ",", "Bold"}], "]"}], "]"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"Print", "[", 
                    RowBox[{"\"\<   maxDif: \>\"", ",", 
                    RowBox[{"N", "[", 
                    RowBox[{"maxDif", ",", "20"}], "]"}]}], "]"}], ";"}]}], 
                    "\[IndentingNewLine]", "]"}], ";"}]}], 
                 "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
                RowBox[{"zeroPrecision", "=", 
                 RowBox[{"Floor", "@", 
                  RowBox[{"Precision", "@", "theZeroPoints"}]}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"duplicateError", "=", 
                 RowBox[{
                  RowBox[{"Min", "[", 
                   RowBox[{"zeroPrecision", ",", "singPrecision"}], "]"}], 
                  "-", "$acf"}]}], ";", "\[IndentingNewLine]", 
                RowBox[{"theZeroList", "=", 
                 RowBox[{"DeleteDuplicates", "[", 
                  RowBox[{"theZeroPoints", ",", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "[", 
                    RowBox[{"#1", "-", "#2"}], "]"}], "<", 
                    RowBox[{"10", "^", 
                    RowBox[{"-", 
                    RowBox[{"(", "duplicateError", ")"}]}]}]}], "&"}]}], 
                  "]"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], 
            "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"theZeroPoints", "=", 
              RowBox[{"{", "}"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], 
          ";"}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"theZeroPoints", "=", 
           RowBox[{"{", "}"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{"diag", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"\"\<theZeroPoints: \>\"", ",", 
            RowBox[{"theZeroPoints", "//", "N"}]}], "]"}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "@", "theZeroPoints"}], ">", "0"}], ",", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"zeroPrecision", "=", 
           RowBox[{"Floor", "@", 
            RowBox[{"Precision", "@", "theZeroPoints"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"duplicateError", "=", 
           RowBox[{
            RowBox[{"Min", "[", 
             RowBox[{"zeroPrecision", ",", "singPrecision"}], "]"}], "-", 
            "$acf"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"theZeroList", "=", 
           RowBox[{"DeleteDuplicates", "[", 
            RowBox[{"theZeroPoints", ",", 
             RowBox[{
              RowBox[{
               RowBox[{"Abs", "[", 
                RowBox[{"#1", "-", "#2"}], "]"}], "<", 
               RowBox[{"10", "^", 
                RowBox[{"-", 
                 RowBox[{"(", "duplicateError", ")"}]}]}]}], "&"}]}], "]"}]}],
           ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"zeroIndexes", "=", 
           RowBox[{"Flatten", "[", "\[IndentingNewLine]", 
            RowBox[{"Table", "[", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"dif", "=", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Abs", "[", 
                   RowBox[{
                    RowBox[{"theZeroList", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "-", "#"}], "]"}], "&"}], 
                 "/@", " ", "theSingularList"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"Position", "[", 
                 RowBox[{"dif", ",", 
                  RowBox[{"x_", "/;", 
                   RowBox[{"x", "==", 
                    RowBox[{"Min", "[", "dif", "]"}]}]}]}], "]"}], "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{"i", ",", "1", ",", 
                RowBox[{"Length", "@", "theZeroList"}]}], "}"}]}], 
             "\[IndentingNewLine]", "]"}], "]"}]}], ";"}], 
         "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"zeroIndexes", "=", 
           RowBox[{"{", "}"}]}], ";"}]}], "\[IndentingNewLine]", 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       "zeroIndexes"}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}]], "Input",
