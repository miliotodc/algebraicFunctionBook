Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{
   RowBox[{"getNormalVals", "[", "theFunction_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "wExp", ",", "functionDegree", ",", "wCoef", ",", "orderList", ",", 
       "theLambda", ",", "theMu", ",", "lambdaList", ",", "theReturn"}], 
      "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"wExp", "=", 
       RowBox[{"Exponent", "[", 
        RowBox[{"theFunction", ",", "w", ",", "List"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"functionDegree", "=", 
       RowBox[{"Last", "@", "wExp"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"wCoef", "=", 
       RowBox[{"CoefficientRules", "[", 
        RowBox[{
        "theFunction", ",", "w", ",", "\"\<NegativeLexicographic\>\""}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "@", "wCoef"}], "<", "3"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"Style", "[", 
           RowBox[{
           "\"\<Function needs more than three terms to use \
getNormalVals!\>\"", ",", "Red", ",", "Bold"}], "]"}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"theReturn", "=", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", 
            RowBox[{"-", "1"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"orderList", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", "1"}], "]"}], "]"}], ",", 
              RowBox[{
               RowBox[{"Exponent", "[", 
                RowBox[{
                 RowBox[{"#", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], ",", "z", ",", "List"}], 
                "]"}], "//", "First"}]}], "}"}], "&"}], "/@", " ", 
           "wCoef"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"\"\<orderList: \>\"", ",", 
             RowBox[{"orderList", "[", 
              RowBox[{"[", 
               RowBox[{"2", ";;", 
                RowBox[{"-", "2"}]}], "]"}], "]"}]}], "]"}], ";"}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"lambdaList", "=", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             FractionBox[
              RowBox[{
               RowBox[{"orderList", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"-", "1"}], ",", "2"}], "]"}], "]"}], "-", 
               RowBox[{"#", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], 
              RowBox[{
               RowBox[{"orderList", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"-", "1"}], ",", "1"}], "]"}], "]"}], "-", 
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}]], "&"}], "/@", " ", 
            RowBox[{"orderList", "[", 
             RowBox[{"[", 
              RowBox[{"2", ";;", 
               RowBox[{"-", "2"}]}], "]"}], "]"}]}], ")"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{"\"\<Lambda list: \>\"", ",", "lambdaList"}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"theLambda", "=", 
          RowBox[{"Max", "[", 
           RowBox[{"Ceiling", "@", "lambdaList"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"theMu", "=", 
          RowBox[{
           RowBox[{"theLambda", " ", "functionDegree"}], "-", 
           RowBox[{"orderList", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"-", "1"}], ",", "2"}], "]"}], "]"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"theReturn", "=", 
          RowBox[{"{", 
           RowBox[{"theLambda", ",", "theMu"}], "}"}]}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      "theReturn"}]}], "\[IndentingNewLine]", "]"}]}]}]], "Input",
 InitializationGroup->True,
