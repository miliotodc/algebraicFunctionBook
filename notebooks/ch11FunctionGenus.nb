   RowBox[{
    RowBox[{
     RowBox[{"getSingularRange", "[", 
      RowBox[{"y_", ",", "z_", ",", "theSingularList_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "return", "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
