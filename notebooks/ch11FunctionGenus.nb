Cell[CellGroupData[{

Cell["getPoles", "Subsection",
 InitializationGroup->True,
 CellChangeTimes->{{3.8943662356980977`*^9, 
  3.8943662371510544`*^9}},ExpressionUUID->"87b288c3-d6b2-4439-8841-\
01f7892bc9e4"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"getPoles", "[", 
    RowBox[{"theFunction_", ",", "theSingularList_", ",", 
     RowBox[{"diag_", ":", "False"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "wExpList", ",", "poleFunction", ",", "pExp", ",", "singPrecision", ",",
        "thePoles", ",", "polePrecision", ",", "thePoleList", ",", "poleF", 
       ",", "poleIndexes", ",", "difTable", ",", "maxDif", ",", 
       "duplicateError", ",", "pTable", ",", "rootPrecisionTable"}], "}"}], 
     ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"wExpList", "=", 
       RowBox[{"Exponent", "[", 
        RowBox[{"theFunction", ",", "w", ",", "List"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"poleFunction", "=", 
       RowBox[{"Coefficient", "[", 
        RowBox[{"theFunction", ",", "w", ",", 
         RowBox[{"Max", "@", "wExpList"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"pExp", "=", 
       RowBox[{"Exponent", "[", 
        RowBox[{"poleFunction", ",", "z", ",", "List"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"check", " ", "if", " ", "a_n", 
         RowBox[{"(", "z", ")"}], " ", "is", " ", "a", " ", "polynomial", " ",
          "of", " ", "degree"}], ">", "0"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"singPrecision", "=", 
       RowBox[{"Floor", "@", 
        RowBox[{"Precision", "@", "theSingularList"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Last", "@", "pExp"}], ">", "0"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"thePoles", "=", 
          RowBox[{"Sort", "[", 
           RowBox[{
            RowBox[{"z", "/.", 
             RowBox[{"NSolve", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Factor", "@", "poleFunction"}], "\[Equal]", "0"}], 
               ",", "z", ",", 
               RowBox[{"WorkingPrecision", "\[Rule]", "singPrecision"}]}], 
              "]"}]}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"Abs", "@", "#1"}], "<=", 
              RowBox[{"Abs", "@", "#2"}]}], "&"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", "\[IndentingNewLine]", " ", 
          RowBox[{"now", " ", "confirm", " ", "solutions"}], 
          "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"difTable", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"poleFunction", "/.", 
             RowBox[{"z", "->", "#"}]}], "&"}], "/@", " ", "thePoles"}]}], 
         ";", "\[IndentingNewLine]", 
         RowBox[{"rootPrecisionTable", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"Precision", "@", "#"}], "&"}], "/@", " ", "difTable"}]}],
          ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Min", "@", "rootPrecisionTable"}], ">", "10"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"maxDif", "=", 
             RowBox[{"Max", "@", "difTable"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"maxDif", ">", "$maxRootVerifyDifference"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"Print", "[", 
                RowBox[{"Style", "[", 
                 RowBox[{
                 "\"\<Verification of theZeroPoints roots exceeded the \
$maxRootVerifyDifference\>\"", ",", "Red", ",", "Bold"}], "]"}], "]"}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"Print", "[", 
                RowBox[{"\"\<   maxDif: \>\"", ",", 
                 RowBox[{"N", "[", 
                  RowBox[{"maxDif", ",", "20"}], "]"}]}], "]"}], ";"}]}], 
             "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", 
          "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"polePrecision", "=", 
          RowBox[{"Floor", "@", 
           RowBox[{"Precision", "@", "thePoles"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"duplicateError", "=", 
          RowBox[{
           RowBox[{"Min", "[", 
            RowBox[{"polePrecision", ",", "singPrecision"}], "]"}], "-", 
           "$acf"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"thePoleList", "=", 
          RowBox[{"DeleteDuplicates", "[", 
           RowBox[{"thePoles", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{"#1", "-", "#2"}], "]"}], "<", 
              RowBox[{"10", "^", 
               RowBox[{"-", 
                RowBox[{"(", "duplicateError", ")"}]}]}]}], "&"}]}], "]"}]}], 
         ";"}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"thePoleList", "=", 
          RowBox[{"{", "}"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"poleF", "[", "a_", "]"}], ":=", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"#", "-", "a"}], "]"}], "&"}], "/@", " ", 
         "theSingularList"}], ")"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"poleIndexes", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Position", "[", 
           RowBox[{
            RowBox[{"poleF", "[", "#", "]"}], ",", 
            RowBox[{"Min", "[", 
             RowBox[{"poleF", "[", "#", "]"}], "]"}]}], "]"}], "&"}], "/@", 
         " ", "thePoleList"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "poleIndexes"}]}], "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 InitializationGroup->True,
 CellChangeTimes->{{3.894365959024037*^9, 3.894366220801469*^9}, {
   3.8943901200342073`*^9, 3.8943901283291583`*^9}, {3.896423333964148*^9, 
   3.896423341837122*^9}, {3.896423409665063*^9, 3.896423441407426*^9}, {
   3.902928831468609*^9, 3.902928832093462*^9}, 3.936947623939025*^9},
 CellLabel->"In[50]:=",ExpressionUUID->"79110ab0-9598-4216-919a-a5e0d570f60b"]
}, Open  ]],

