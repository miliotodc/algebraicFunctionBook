Cell[CellGroupData[{

Cell["Manual mode of computing finite RH sum", "Subsubsection",
 CellChangeTimes->{{3.948023861862896*^9, 
  3.948023869517331*^9}},ExpressionUUID->"d6fbd50e-016e-4db4-abc6-\
3023cde71c47"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"$myPuiseuxSave", "=", "$puiseuxSaveTable"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"diagFlag", "=", "True"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", "\[IndentingNewLine]", 
    RowBox[{
    "now", " ", "check", " ", "ramifications", " ", "and", " ", "poles"}], 
    "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"singularFlag", "=", "True"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"poleIndexTally", "=", "0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"finiteRam", "=", 
     RowBox[{"$puiseuxSaveTable", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "3"}], "}"}]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"finiteRam", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Reverse", "@", "#"}], "&"}], "/@", 
          RowBox[{"finiteRam", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "1"}], "]"}], "]"}]}], ",", 
         RowBox[{"finiteRam", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "2"}], "]"}], "]"}]}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "@", "finiteRam"}]}], "}"}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"segNum", "=", "1"}], ",", 
      RowBox[{"segNum", "<=", 
       RowBox[{"Length", "@", "$puiseuxSaveTable"}]}], ",", 
      RowBox[{"segNum", "++"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"singIndex", "=", 
        RowBox[{"$puiseuxSaveTable", "[", 
         RowBox[{"[", 
          RowBox[{"segNum", ",", "3"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", " ", 
       RowBox[{"cycleList", "=", 
        RowBox[{"$puiseuxSaveTable", "[", 
         RowBox[{"[", 
          RowBox[{"segNum", ",", "2", ",", "All", ",", "3"}], "]"}], "]"}]}], 
       ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{
          RowBox[{
          "first", " ", "check", " ", "if", " ", "have", " ", "all", " ", 
           "1"}], "-", 
          RowBox[{
          "cycles", " ", "at", " ", "this", " ", "singular", " ", "point"}]}],
          ",", " ", 
         RowBox[{
         "then", " ", "must", " ", "have", " ", "at", " ", "least", " ", 
          "one", " ", "pole"}]}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Length", "@", 
            RowBox[{"Cases", "[", 
             RowBox[{"cycleList", ",", 
              RowBox[{"x_", "/;", 
               RowBox[{"x", ">", "1"}]}]}], "]"}]}], "==", "0"}], " ", "&&", 
          " ", 
          RowBox[{"!", 
           RowBox[{"MemberQ", "[", 
            RowBox[{"$poleIndexes", ",", "singIndex"}], "]"}]}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{
             "\"\<Found only 1-cycles with no pole at singular index: \>\"", 
              ",", "Red"}], "]"}], ",", "singIndex", ",", 
            "\"\<sing point: \>\"", ",", 
            RowBox[{
             RowBox[{"$theSingularList", "[", 
              RowBox[{"[", "singIndex", "]"}], "]"}], "//", "N"}]}], "]"}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"singularFlag", "=", "False"}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", "\[IndentingNewLine]", " ", 
        RowBox[{
         RowBox[{"confirm", " ", "if", " ", "all", " ", "1"}], "-", 
         RowBox[{
         "cycle", " ", "and", " ", "pole", " ", "index", " ", "that", " ", 
          "have", " ", "negative", " ", "exponents"}]}], 
        "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"MemberQ", "[", 
          RowBox[{"$poleIndexes", ",", "singIndex"}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"poleData", "=", 
           RowBox[{"$puiseuxSaveTable", "[", 
            RowBox[{"[", 
             RowBox[{"segNum", ",", "2", ",", "All", ",", 
              RowBox[{"{", 
               RowBox[{"4", ",", "5"}], "}"}]}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"netExpList", "=", 
           RowBox[{"Flatten", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"FoldList", "[", 
                RowBox[{"Plus", ",", 
                 RowBox[{"#1", "[", 
                  RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "-", 
               RowBox[{"#", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], "&"}], " ", "/@", " ", 
             "poleData"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"AnyTrue", "[", 
             RowBox[{"netExpList", ",", "Negative"}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{"Print", "[", 
               RowBox[{
                RowBox[{"Style", "[", 
                 RowBox[{
                 "\"\<Pole confirmed at singular index \>\"", ",", "Red"}], 
                 "]"}], ",", 
                RowBox[{"Style", "[", 
                 RowBox[{"singIndex", ",", "Red"}], "]"}]}], "]"}], ";"}], 
             "*)"}], "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"poleIndexTally", "++"}], ";"}], "\[IndentingNewLine]", 
            ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{
               RowBox[{"Style", "[", 
                RowBox[{
                "\"\<Did not find pole at expected singular point\>\"", ",", 
                 "Red", ",", "14"}], "]"}], ",", 
               RowBox[{"Style", "[", 
                RowBox[{"singIndex", ",", "Red", ",", "14"}], "]"}]}], "]"}], 
             ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "now", " ", "confirm", " ", "that", " ", "number", " ", "of", " ", 
     "poles", " ", "found", " ", "in", " ", "puiseuxSaveTable", " ", "is", 
     " ", "equal", " ", "to", " ", "the", " ", "degree", " ", "of", " ", 
     "a_n", 
     RowBox[{"(", "z", ")"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"poleIndexTally", "==", 
        RowBox[{"Length", "@", "$poleIndexes"}]}], " ", "&&", " ", 
       RowBox[{
        RowBox[{"Length", "@", "$poleIndexes"}], ">", "1"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Print", "[", "\"\<All poles confirmed\>\"", "]"}], ";"}]}], 
     "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{"diagFlag", ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Precision", "@", "$puiseuxSaveTable"}], "<", "900"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{"\"\<puiseuxSaveTable precision: \>\"", ",", 
           RowBox[{"Precision", "@", "$puiseuxSaveTable"}]}], "]"}]}], "]"}], 
       ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**"}], 
    "  ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "   ", 
    RowBox[{"now", " ", "compute", " ", "finite", " ", "RH", " ", "sum"}], 
    " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**"}],
      "*"}], " ", "*)"}], "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{"finiteList", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"#", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "3"}], "]"}], "]"}], "&"}], "/@", " ", 
      RowBox[{"$puiseuxSaveTable", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "2"}], "]"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"higherRamifiedIndexes", "=", 
     RowBox[{"Flatten", "@", 
      RowBox[{"Position", "[", 
       RowBox[{"finiteList", ",", 
        RowBox[{"x_List", "/;", 
         RowBox[{"MemberQ", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"GreaterThan", "[", "2", "]"}], "/@", " ", "x"}], ",", 
           "True"}], "]"}]}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"unRamifiedPoleIndexes", "=", 
     RowBox[{"Flatten", "@", 
      RowBox[{"Position", "[", 
       RowBox[{"finiteList", ",", 
        RowBox[{"x_List", "/;", 
         RowBox[{"x", "==", 
          RowBox[{"Table", "[", 
           RowBox[{"1", ",", 
            RowBox[{"{", "functionDegree", "}"}]}], "]"}]}]}]}], "]"}]}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{"diagFlag", ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{
        "\"\<unRamifiedPoleIndexes: \>\"", ",", "unRamifiedPoleIndexes"}], 
        "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{
    "check", " ", "if", " ", "all", " ", "unramified", " ", "singular", " ", 
     "points", " ", "are", " ", "poles"}], "\[IndentingNewLine]", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"poleTruth", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"MemberQ", "[", 
        RowBox[{"$poleIndexes", ",", "#"}], "]"}], "&"}], "/@", " ", 
      "unRamifiedPoleIndexes"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"MemberQ", "[", 
       RowBox[{"poleTruth", ",", "False"}], "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"Style", "[", 
         RowBox[{
         "\"\<Found unramified singular points which are not poles!\>\"", ",",
           "Red"}], "]"}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{
     RowBox[{"now", " ", "find", " ", "minimially"}], "-", 
     RowBox[{"ramified", " ", "singular", " ", "points"}]}], 
    "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"minimalRamifiedIndexes", "=", 
     RowBox[{"Length", "@", 
      RowBox[{"Select", "[", 
       RowBox[{"finiteList", ",", 
        RowBox[{
         RowBox[{"AnyTrue", "[", 
          RowBox[{"#", ",", 
           RowBox[{
            RowBox[{"#", ">", "1"}], "&"}]}], "]"}], "&"}]}], "]"}]}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{"diagFlag", ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{
        "\"\<Number of minimally ramified singular points: \>\"", ",", 
         "minimalRamifiedIndexes"}], "]"}], ";"}]}], "\[IndentingNewLine]", 
     "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{
     RowBox[{"find", " ", "all", " ", "higher"}], "-", 
     RowBox[{"ramified", " ", "singular", " ", "points"}]}], 
    "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"higherRamifiedIndexes", "=", 
     RowBox[{"Flatten", "@", 
      RowBox[{"Position", "[", 
       RowBox[{"finiteList", ",", 
        RowBox[{"x_List", "/;", 
         RowBox[{"MemberQ", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"GreaterThan", "[", "2", "]"}], "/@", " ", "x"}], ",", 
           "True"}], "]"}]}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{"diagFlag", ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{
        "\"\<Higher ramified indexes: \>\"", ",", "higherRamifiedIndexes"}], 
        "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], 
   "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{"tList", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Tally", "[", "#", "]"}], "&"}], "/@", " ", "finiteList"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fList", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{"tList", ",", "1"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sList", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"fList", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ">=", "2"}], "&"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"finiteRHSum", "=", 
     RowBox[{"(", 
      RowBox[{"Plus", "@@", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
