Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Options", "[", "getReformedFunctionTable", "]"}], "=", 
     RowBox[{"{", 
      RowBox[{"\"\<diag\>\"", "->", "False"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "    ", 
   RowBox[{
    RowBox[{"getReformedFunctionTable", "[", 
     RowBox[{
     "theFunction_", ",", "reformedWRules_", ",", "theReformedIndexes_", ",", 
      RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "functionCoeffRules", ",", "functionCoeffRulesLen", ",", "diagA", ",", 
        "diagB", ",", "diagC", ",", "reformedFunctionTable", ",", 
        "currentSingIndex", ",", "newWRules", ",", "wKey", ",", "keyValue", 
        ",", "zTerms", ",", "currentReformedRule", ",", "removeIndexes", ",", 
        "reformedKeyRule", ",", "zTermLen", ",", "reformedFunction"}], "}"}], 
      ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"functionCoeffRules", "=", 
        RowBox[{"CoefficientRules", "[", 
         RowBox[{
          RowBox[{"Expand", "[", 
           RowBox[{"theFunction", "/.", 
            RowBox[{"z", "->", 
             RowBox[{"z", "+", "s"}]}]}], "]"}], ",", "w", ",", 
          "\"\<NegativeLexicographic\>\""}], " ", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"functionCoeffRulesLen", "=", 
        RowBox[{"Length", "@", "functionCoeffRules"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{
          "\"\<function coeff rules length: \>\"", ",", 
           "functionCoeffRulesLen"}], "]"}], ";"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"OptionValue", "[", "\"\<diag\>\"", "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"Style", "[", 
            RowBox[{
            "\"\<Creating reformedFunctionTable ...\>\"", ",", "16", ",", 
             "Bold", ",", "Purple"}], "]"}], "]"}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"reformedFunctionTable", "=", 
        RowBox[{"Table", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"currentSingIndex", "=", 
            RowBox[{"theReformedIndexes", "[", 
             RowBox[{"[", "rIndex", "]"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"OptionValue", "[", "\"\<diag\>\"", "]"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Print", "[", 
               RowBox[{
                RowBox[{"Style", "[", 
                 RowBox[{
                 "\"\<     Processing singular index: \>\"", ",", "Red", ",", 
                  "14", ",", "Bold"}], "]"}], ",", "currentSingIndex"}], 
               "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"MemberQ", "[", 
              RowBox[{"theReformedIndexes", ",", "currentSingIndex"}], "]"}], 
             ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"newWRules", "=", 
               RowBox[{
               "Table", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{
                  RowBox[{"wKey", "=", 
                   RowBox[{"functionCoeffRules", "[", 
                    RowBox[{"[", 
                    RowBox[{"wValIndex", ",", "1"}], "]"}], "]"}]}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{"OptionValue", "[", "\"\<diag\>\"", "]"}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"Print", "[", 
                    RowBox[{
                    RowBox[{"Style", "[", 
                    RowBox[{
                    "\"\<      Processing wKey: \>\"", ",", "Bold", ",", 
                    "Black"}], "]"}], ",", "wKey"}], "]"}], ";"}]}], 
                   "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
                  "\[IndentingNewLine]", 
                  RowBox[{"keyValue", "=", 
                   RowBox[{"functionCoeffRules", "[", 
                    RowBox[{"[", 
                    RowBox[{"wValIndex", ",", "2"}], "]"}], "]"}]}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"zTerms", "=", 
                   RowBox[{"CoefficientRules", "[", 
                    RowBox[{
                    "keyValue", ",", "z", ",", 
                    "\"\<NegativeLexicographic\>\""}], " ", "]"}]}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{"OptionValue", "[", "\"\<diag\>\"", "]"}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"Print", "[", 
                    RowBox[{"\"\<       zTerms: \>\"", ",", "zTerms"}], "]"}],
                     ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"currentReformedRule", "=", 
                   RowBox[{"reformedWRules", "[", 
                    RowBox[{"[", "wValIndex", "]"}], "]"}]}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{"OptionValue", "[", "\"\<diag\>\"", "]"}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"Print", "[", 
                    RowBox[{
                    "\"\<       Reformed rule: \>\"", ",", 
                    "currentReformedRule"}], "]"}], ";"}]}], 
                   "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
                  RowBox[{"removeIndexes", "=", 
                   RowBox[{"Select", "[", 
                    RowBox[{
                    RowBox[{"currentReformedRule", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], ",", 
                    RowBox[{
                    RowBox[{"MemberQ", "[", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], ",", "currentSingIndex"}],
                     "]"}], "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
                  "\[IndentingNewLine]", 
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{"OptionValue", "[", "\"\<diag\>\"", "]"}], " ", 
                    ",", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"Print", "[", 
                    RowBox[{
                    RowBox[{"Style", "[", 
                    RowBox[{"\"\<       removeIndexes: \>\"", ",", 
                    RowBox[{"Darker", "@", "Green"}], ",", "Bold", ",", 
                    "14"}], "]"}], ",", 
                    RowBox[{"removeIndexes", "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", "1"}], "]"}], "]"}]}], "]"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"Print", "[", 
                    RowBox[{"\"\<       kept indexes: \>\"", ",", 
                    RowBox[{"Complement", "[", 
                    RowBox[{
                    RowBox[{"Range", "[", 
                    RowBox[{"Length", "@", "zTerms"}], "]"}], ",", 
                    "removeIndexes"}], "]"}]}], "]"}], ";"}]}], 
                   "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
                  RowBox[{"reformedKeyRule", "=", 
                   RowBox[{"FromCoefficientRules", "[", 
                    RowBox[{
                    RowBox[{"zTerms", "[", 
                    RowBox[{"[", 
                    RowBox[{"Complement", "[", 
                    RowBox[{
                    RowBox[{"Range", "[", 
                    RowBox[{"Length", "@", "zTerms"}], "]"}], ",", 
                    RowBox[{"removeIndexes", "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", "1"}], "]"}], "]"}]}], "]"}], "]"}], 
                    "]"}], ",", "z"}], "]"}]}], ";", "\[IndentingNewLine]", 
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{"OptionValue", "[", "\"\<diag\>\"", "]"}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"Print", "[", 
                    RowBox[{
                    RowBox[{"Style", "[", 
                    RowBox[{
                    "\"\<       Reformed coefficient: \>\"", ",", "Red"}], 
                    "]"}], ",", "reformedKeyRule"}], "]"}], ";"}]}], 
                   "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
                  RowBox[{"zTermLen", "=", 
                   RowBox[{"Length", "@", "zTerms"}]}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"wKey", "->", "reformedKeyRule"}]}], ",", 
                 "\[IndentingNewLine]", 
                 RowBox[{"{", 
                  RowBox[{
                  "wValIndex", ",", "1", ",", "functionCoeffRulesLen"}], 
                  "}"}]}], "\[IndentingNewLine]", "]"}]}], ";", 
              "\[IndentingNewLine]", "\[IndentingNewLine]", 
              RowBox[{"reformedFunction", "=", 
               RowBox[{"FromCoefficientRules", "[", 
                RowBox[{"newWRules", ",", "w"}], "]"}]}], ";"}], 
             "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"OptionValue", "[", "\"\<diag\>\"", "]"}], ",", 
                "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{
                 "Print", "[", "\"\<Using unreformed function ...\>\"", "]"}],
                  ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"reformedFunction", "=", "theFunction"}], ";"}]}], 
            "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"currentSingIndex", ",", "reformedFunction"}], "}"}]}], 
          ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"rIndex", ",", "1", ",", 
            RowBox[{"Length", "@", "theReformedIndexes"}]}], "}"}]}], 
         "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
       "reformedFunctionTable"}]}], "\[IndentingNewLine]", "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]"}]}]], "Input",
 InitializationGroup->True,
