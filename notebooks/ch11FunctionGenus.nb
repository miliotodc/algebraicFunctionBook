Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
   "read", " ", "in", " ", "singular", " ", "and", " ", "reformed", " ", 
    "data"}], "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"functionSave", "=", "$theFunction"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Reading in singular and reformed data\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"FileExistsQ", "[", 
       RowBox[{"singularDataFileName", "[", "$theTestCase", "]"}], "]"}], ",",
       "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Importing \>\"", "<>", 
         RowBox[{"singularDataFileName", "[", "$theTestCase", "]"}]}], "]"}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "$theSingularList", ",", "$poleIndexes", ",", "$minRadiusArray", ",",
           "res", ",", "$zeroIndexes", ",", "$nearestDistArray", ",", 
          "rNormArray"}], "}"}], "=", 
        RowBox[{"Import", "[", 
         RowBox[{"singularDataFileName", "[", "$theTestCase", "]"}], "]"}]}], 
       ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"poleIndexesSave", "=", "$poleIndexes"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"zeroIndexesSave", "=", "$zeroIndexes"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"theSingularListSave", "=", "$theSingularList"}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"reformedWRules", ",", "theReformedIndexes"}], "}"}], "=", 
          RowBox[{"getReformedIndexes", "[", 
           RowBox[{
           "$theFunction", ",", "$theSingularList", ",", "$zeroIndexes", ",", 
            "$poleIndexes"}], "]"}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"singularIndex", ",", 
         RowBox[{"reformedFunction", "  ", "returned"}]}], " ", "*)"}], 
       "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"reformedFunctionTable", "=", 
          RowBox[{"getReformedFunctionTable", "[", 
           RowBox[{
           "$theFunction", ",", "reformedWRules", ",", "theReformedIndexes", 
            ",", "reformFlags"}], "]"}]}], ";"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"FileExistsQ", "[", 
          RowBox[{"reformedFunctionTableFileName", "[", "$theTestCase", "]"}],
           "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"\"\<Importing \>\"", "<>", 
            RowBox[{
            "reformedFunctionTableFileName", "[", "$theTestCase", "]"}]}], 
           "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"reformedFunctionTable", "=", 
           RowBox[{"Import", "[", 
            RowBox[{
            "reformedFunctionTableFileName", "[", "$theTestCase", "]"}], 
            "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"genericIndexes", ",", "returnedNonGenerics"}], "}"}], 
           "=", 
           RowBox[{"getGenericList", "[", 
            RowBox[{"$theFunction", ",", "$theSingularList"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"genericIndexesSave", "=", "genericIndexes"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"genericAtOrigin", "=", "False"}], ";", "\n", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"genericIndexes", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "==", "1"}], " ", "&&", " ", 
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{"$theSingularList", "[", 
                RowBox[{"[", 
                 RowBox[{"genericIndexes", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], "]"}], "<", 
              RowBox[{"10", "^", 
               RowBox[{"-", "100"}]}]}]}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{"Style", "[", 
               RowBox[{
               "\"\<Found generic singular point at origin\>\"", ",", "Red"}],
                "]"}], "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"genericAtOrigin", "=", "True"}], ";"}]}], 
           "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
              "reformedFunctionTableFileName", "[", "$theTestCase", "]"}], 
              "<>", "\"\< not found during import.\>\""}], ",", "Red"}], 
            "]"}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], 
      "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
      RowBox[{
