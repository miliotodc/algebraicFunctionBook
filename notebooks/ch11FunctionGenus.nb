Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"convertToNormalFormNew", "[", "theF_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "wRules", ",", "theWKeys", ",", "theATerms", ",", "aTermOrders", ",", 
        "wPowers", ",", "orderArray", ",", "deletedOrderArray", ",", 
        "normalEqn", ",", "normalConstraints", ",", "minData", ",", "thepoly",
         ",", "currentmu", ",", "mylambda"}], "}"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"wRules", "=", 
        RowBox[{"CoefficientRules", "[", 
         RowBox[{"theF", ",", "w", ",", "\"\<NegativeLexicographic\>\""}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"theWKeys", "=", 
        RowBox[{"Keys", "[", "wRules", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"theATerms", "=", 
        RowBox[{"Values", "[", "wRules", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"aTermOrders", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"Min", "@", "#"}], "&"}], "/@", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Exponent", "[", 
             RowBox[{"#", ",", "z", ",", "List"}], "]"}], "&"}], "/@", " ", 
           "theATerms"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"wPowers", "=", 
        RowBox[{"Flatten", "[", "theWKeys", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"orderArray", "=", 
        RowBox[{"MapThread", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"#1", ",", "#2"}], "}"}], "&"}], ",", 
          RowBox[{"{", 
           RowBox[{"aTermOrders", ",", "wPowers"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"deletedOrderArray", "=", 
        RowBox[{"DeleteCases", "[", 
         RowBox[{"orderArray", ",", 
          RowBox[{"{", 
           RowBox[{"_", ",", "0"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"normalEqn", "=", 
        RowBox[{
         RowBox[{"\[Mu]", "+", 
          RowBox[{"deletedOrderArray", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"-", "1"}], ",", "1"}], "]"}], "]"}]}], "==", 
         RowBox[{"functionDegree", " ", "\[Lambda]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"normalConstraints", "=", 
        RowBox[{"Table", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"\[Mu]", "+", 
            RowBox[{"deletedOrderArray", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "1"}], "]"}], "]"}]}], ">=", 
           RowBox[{
            RowBox[{"deletedOrderArray", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "2"}], "]"}], "]"}], " ", "\[Lambda]"}]}], 
          ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{
             RowBox[{"Length", "@", "deletedOrderArray"}], "-", "1"}]}], 
           "}"}]}], "\[IndentingNewLine]", "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"minData", "=", 
        RowBox[{"Minimize", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\[Lambda]", ",", 
            RowBox[{"normalEqn", " ", "&&", 
             RowBox[{"(", 
              RowBox[{"And", "@@", "normalConstraints"}], ")"}], "&&", " ", 
             RowBox[{"Element", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"\[Mu]", ",", "\[Lambda]"}], "}"}], ",", 
               "PositiveIntegers"}], "]"}]}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"\[Mu]", ",", "\[Lambda]"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"currentmu", ",", "mylambda"}], "}"}], "=", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\[Mu]", ",", "\[Lambda]"}], "}"}], "/.", 
         RowBox[{"minData", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<currentmu: \>\"", ",", "currentmu"}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<mylambda: \>\"", ",", "mylambda"}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"thepoly", "=", 
        RowBox[{"Expand", "[", 
         RowBox[{
          RowBox[{"z", "^", "currentmu"}], 
          RowBox[{"(", 
           RowBox[{"theF", "/.", 
            RowBox[{"w", "\[Rule]", 
             RowBox[{"w", "/", 
              RowBox[{"(", 
               RowBox[{"z", "^", "mylambda"}], ")"}]}]}]}], ")"}]}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<normal poly: \>\"", ",", 
         RowBox[{"thepoly", "//", "N"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"thepoly", ",", "mylambda", ",", "currentmu"}], "}"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.948119414621991*^9, 3.9481194465363946`*^9}, {
