Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"getCharRoots", "[", 
     RowBox[{
     "theLegArray_", ",", "thePolygonPoints_", ",", "theRotatedPoints_", ",", 
      "theSingularList_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "charEqns", ",", "pointIndexes", ",", "charRootList", ",", "rootAcc", 
        ",", "nonZeroRootList", ",", "rootTallyList", ",", 
        "slopeInterceptList", ",", "charEqnsPrecision", ",", "netTolerance", 
        ",", "wp", ",", "attempts", ",", "charRootPrecision", ",", "difTable",
         ",", "charEqnsAccuracy", ",", "charRootAccuracy", ",", 
        "newRootTallyList"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{"$getCharRootFlag", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"Style", "[", 
            RowBox[{
            "\"\<Entering getCharRoots\>\"", ",", "Red", ",", "14", ",", 
             "Bold"}], "]"}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<     theLegArray: \>\"", ",", 
            RowBox[{"theLegArray", "//", "N"}]}], "]"}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{"$getCharRootFlag", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{
             "\"\<thePolygonPoints G= \>\"", ",", "Black", ",", "Bold"}], 
             "]"}], ",", 
            RowBox[{"thePolygonPoints", "//", "N"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{
             "\"\<characteristic points C= \>\"", ",", "Black", ",", "Bold"}],
              "]"}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{"#", "[", 
                  RowBox[{"[", "3", "]"}], "]"}], "//", "N"}], ",", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "1", "]"}], "]"}]}], "}"}], "&"}], "/@", " ", 
             "theRotatedPoints"}]}], "]"}], ";"}]}], "\[IndentingNewLine]", 
        "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"charEqns", "=", 
        RowBox[{"Table", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Length", "@", 
               RowBox[{"theLegArray", "[", 
                RowBox[{"[", "legIndex", "]"}], "]"}]}], "==", "1"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"pointIndexes", "=", 
               RowBox[{"theLegArray", "[", 
                RowBox[{"[", 
                 RowBox[{"legIndex", ",", "1", ",", 
                  RowBox[{"{", 
                   RowBox[{"1", ",", "2"}], "}"}]}], "]"}], "]"}]}], ";"}], 
             "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"pointIndexes", "=", 
               RowBox[{"DeleteDuplicates", "@", 
                RowBox[{"Flatten", "@", 
                 RowBox[{"theLegArray", "[", 
                  RowBox[{"[", 
                   RowBox[{"legIndex", ",", "All", ",", 
                    RowBox[{"{", 
                    RowBox[{"1", ",", "2"}], "}"}]}], "]"}], "]"}]}]}]}], ";",
               "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{"$getCharRootFlag", ",", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"Print", "[", 
                  RowBox[{
                  "\"\<       Deleted duplicates: \>\"", ",", 
                   "pointIndexes"}], "]"}], ";"}]}], "\[IndentingNewLine]", 
               "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{"$getCharRootFlag", ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Print", "[", 
               RowBox[{
                RowBox[{"Style", "[", 
                 RowBox[{
                 "\"\<pointIndexes: \>\"", ",", "Purple", ",", "Bold"}], 
                 "]"}], ",", 
                RowBox[{"pointIndexes", "//", "N"}]}], "]"}], ";"}]}], 
            "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"Plus", "@@", 
            RowBox[{"Table", "[", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"theRotatedPoints", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"pointIndexes", "[", 
                   RowBox[{"[", "pIndex", "]"}], "]"}], ",", "3"}], "]"}], 
                "]"}], " ", 
               RowBox[{"x", "^", 
                RowBox[{"theRotatedPoints", "[", 
                 RowBox[{"[", 
                  RowBox[{
                   RowBox[{"pointIndexes", "[", 
                    RowBox[{"[", "pIndex", "]"}], "]"}], ",", "1"}], "]"}], 
                 "]"}]}]}], ",", "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{"pIndex", ",", 
                RowBox[{"Length", "@", "pointIndexes"}]}], "}"}]}], 
             "\[IndentingNewLine]", "]"}]}]}], ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"legIndex", ",", "1", ",", 
            RowBox[{"Length", "@", "theLegArray"}]}], "}"}]}], 
         "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"charEqnsPrecision", "=", 
        RowBox[{"Floor", "@", 
         RowBox[{"Precision", "@", "charEqns"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"charEqnsAccuracy", "=", 
        RowBox[{"Floor", "@", 
         RowBox[{"Accuracy", "@", "charEqns"}]}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{"$getCharRootFlag", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{
             "\"\<char eqns: \>\"", ",", "Purple", ",", "Bold", ",", "14"}], 
             "]"}], ",", 
            RowBox[{"charEqns", "//", "N"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<charEqnsPrecision: \>\"", ",", "charEqnsPrecision"}], 
           "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"charEqnsPrecision", "\[Equal]", "\[Infinity]"}], " ", ",",
            "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"charEqnsPrecision", "=", 
             RowBox[{"Floor", "@", 
              RowBox[{"Precision", "@", "theSingularList"}]}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{"$getCharRootFlag", ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"Print", "[", 
                RowBox[{
                "\"\<Reducing infinite precision of char eqns to \>\"", ",", 
                 "charEqnsPrecision"}], "]"}], ";"}]}], "\[IndentingNewLine]",
              "]"}], ";", "\[IndentingNewLine]", 
            RowBox[{"charEqns", "=", 
             RowBox[{"SetPrecision", "[", 
              RowBox[{"charEqns", ",", "charEqnsPrecision"}], "]"}]}], 
            ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{
         "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**",
           "**", "**"}], "*"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"charEqnsPrecision", "==", "\[Infinity]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"charEqnsPrecision", "=", 
           RowBox[{"Floor", "@", 
            RowBox[{"Precision", "@", "theSingularList"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"charEqnsPrecision", "==", "\[Infinity]"}], ",", 
            "\[IndentingNewLine]", 
