Cell[CellGroupData[{

Cell["getGenericList", "Subsection",
 CellChangeTimes->{{3.9483672326038485`*^9, 
  3.9483672351969776`*^9}},ExpressionUUID->"d81bb8fc-afa2-406b-8f52-\
e0262ec3a758"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Options", "[", "getGenericList", "]"}], "=", 
     RowBox[{"{", 
      RowBox[{"\"\<diag\>\"", "->", "False"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"getGenericList", "[", 
      RowBox[{"theF_", ",", "theS_", ",", 
       RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "singularPrecision", ",", "singularAccuracy", ",", "wRules", ",", 
         "wKeys", ",", "anValues", ",", "anTable", ",", "wKeyIndex", ",", 
         "currentAn", ",", "wp", ",", "aRoots", ",", "aPrec", ",", "aAcc", 
         ",", "theZeroPos", ",", "anLabel", ",", "nonGenerics", ",", 
         "aRootList", ",", "rootAcc", ",", "rootPrec", ",", "kStart", ",", 
         "kEnd", ",", "workingRootPrecision", ",", "theGenerics"}], "}"}], 
       ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"singularPrecision", "=", 
         RowBox[{"Precision", "@", "theS"}]}], ";", " ", 
        "\[IndentingNewLine]", 
        RowBox[{"singularAccuracy", "=", 
         RowBox[{"Accuracy", "@", "theS"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"wRules", "=", 
         RowBox[{"CoefficientRules", "[", 
          RowBox[{"theF", ",", "w", ",", "\"\<NegativeLexicographic\>\""}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"wKeys", "=", 
         RowBox[{"Keys", "[", "wRules", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"anValues", "=", 
         RowBox[{"Values", "[", "wRules", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"anTable", "=", 
         RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"anLabel", "=", "\"\<a\>\""}], ";", "\[IndentingNewLine]", 
        RowBox[{"kStart", "=", "1"}], ";", "\[IndentingNewLine]", 
        RowBox[{"kEnd", "=", 
         RowBox[{"Length", "@", "wKeys"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"wKeyIndex", "=", "kStart"}], ",", 
          RowBox[{"wKeyIndex", "<=", "kEnd"}], ",", 
          RowBox[{"wKeyIndex", "++"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"currentAn", "=", 
            RowBox[{"anValues", "[", 
             RowBox[{"[", "wKeyIndex", "]"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"OptionValue", "[", "\"\<diag\>\"", "]"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Print", "[", 
               RowBox[{"\"\<currentAn: \>\"", ",", "currentAn"}], "]"}], 
              ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"!", 
              RowBox[{"NumberQ", "[", "currentAn", "]"}]}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"workingRootPrecision", "=", "singularPrecision"}], ";",
               "\[IndentingNewLine]", "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"OptionValue", "[", "\"\<diag\>\"", "]"}], ",", 
                "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"Print", "[", 
                  RowBox[{
                   RowBox[{"Style", "[", 
                    RowBox[{
                    "\"\<    Precision of zero rule: \>\"", ",", "Bold"}], 
                    "]"}], ",", "wp"}], "]"}], ";"}]}], "\[IndentingNewLine]",
                "]"}], ";", "\[IndentingNewLine]", 
              RowBox[{"aRootList", "=", 
               RowBox[{"z", "/.", 
                RowBox[{"NSolve", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Factor", "@", "currentAn"}], "==", "0"}], ",", 
                  "z", ",", 
                  RowBox[{
                  "WorkingPrecision", "->", "workingRootPrecision"}]}], 
                 "]"}]}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"rootPrec", "=", 
               RowBox[{"Floor", "[", 
                RowBox[{
                 RowBox[{"7", "/", "10"}], " ", 
                 RowBox[{"Precision", "@", "aRootList"}]}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"rootPrec", "==", "\[Infinity]"}], ",", 
                "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"rootPrec", "=", 
                  RowBox[{"Floor", "[", 
                   RowBox[{
                    RowBox[{"7", "/", "8"}], " ", "workingRootPrecision"}], 
                   "]"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"rootPrec", "<", 
                 RowBox[{"100", "+", "$rcf"}]}], ",", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"Print", "[", 
                  RowBox[{"Style", "[", 
                   RowBox[{"\"\<Root precision<100+$rcf\>\"", ",", "Red"}], 
                   "]"}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
              "\[IndentingNewLine]", "\[IndentingNewLine]", 
              RowBox[{"aRoots", "=", 
               RowBox[{"DeleteDuplicates", "[", 
                RowBox[{"aRootList", ",", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Abs", "[", 
                    RowBox[{"#1", "-", "#2"}], "]"}], "<", 
                   RowBox[{"10", "^", 
                    RowBox[{"-", 
                    RowBox[{"(", 
                    RowBox[{"rootPrec", "-", "$rcf"}], ")"}]}]}]}], "&"}]}], 
                "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"OptionValue", "[", "\"\<diag\>\"", "]"}], ",", 
                "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"Print", "[", 
                  RowBox[{"\"\<aRoots: \>\"", ",", 
                   RowBox[{"aRoots", "//", "N"}]}], "]"}], ";"}]}], 
               "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
              "\[IndentingNewLine]", 
              RowBox[{"theZeroPos", "=", 
               RowBox[{"Sort", "@", 
                RowBox[{"DeleteDuplicates", "[", 
                 RowBox[{"Flatten", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"Position", "[", 
                    RowBox[{"theS", ",", 
                    RowBox[{"x_", "/;", 
                    RowBox[{
                    RowBox[{"Abs", "[", 
                    RowBox[{"x", "-", 
                    RowBox[{"aRoots", "[", 
                    RowBox[{"[", "#", "]"}], "]"}]}], "]"}], "<", 
                    RowBox[{"10", "^", 
                    RowBox[{"-", 
                    RowBox[{"(", 
                    RowBox[{"rootPrec", "-", "$rcf"}], ")"}]}]}]}]}]}], "]"}],
                     "&"}], "/@", 
                   RowBox[{"Range", "[", 
                    RowBox[{"Length", "@", "aRoots"}], "]"}]}], "]"}], 
                 "]"}]}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"OptionValue", "[", "\"\<diag\>\"", "]"}], ",", 
                "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"Print", "[", 
                  RowBox[{"\"\<theZeroPos: \>\"", ",", "theZeroPos"}], "]"}], 
                 ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
              "\[IndentingNewLine]", "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Length", "@", "theZeroPos"}], "==", "0"}], ",", 
                "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{"OptionValue", "[", "\"\<diag\>\"", "]"}], ",", 
                   "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"Print", "[", 
                    RowBox[{"\"\<Roots of \>\"", ",", 
                    SubscriptBox["anLabel", 
                    RowBox[{"wKeys", "[", 
                    RowBox[{"[", 
                    RowBox[{"wKeyIndex", ",", "1"}], "]"}], "]"}]], ",", 
                    RowBox[{"Style", "[", 
                    RowBox[{"\"\< are not singular\>\"", ",", "Blue"}], 
                    "]"}]}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], 
                 ";"}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{"OptionValue", "[", "\"\<diag\>\"", "]"}], ",", 
                   "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"Print", "[", "\"\<found roots\>\"", "]"}], 
                    ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"AppendTo", "[", 
                  RowBox[{"anTable", ",", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"wKeys", "[", 
                    RowBox[{"[", 
                    RowBox[{"wKeyIndex", ",", "1"}], "]"}], "]"}], ",", 
                    RowBox[{
                    RowBox[{"theS", "[", 
                    RowBox[{"[", "theZeroPos", "]"}], "]"}], "//", "N"}], ",",
                     "theZeroPos"}], "}"}]}], "]"}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{"OptionValue", "[", "\"\<diag\>\"", "]"}], ",", 
                   "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"Print", "[", 
                    RowBox[{"\"\<Roots of \>\"", ",", 
                    SubscriptBox["anLabel", 
                    RowBox[{"wKeys", "[", 
                    RowBox[{"[", "wKeyIndex", "]"}], "]"}]], ",", 
                    RowBox[{"Style", "[", 
                    RowBox[{"\"\< are singular\>\"", ",", "Red"}], "]"}]}], 
                    "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]}], 
               "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", 
            "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"nonGenerics", "=", 
         RowBox[{"Sort", "@", 
          RowBox[{"DeleteDuplicates", "@", 
           RowBox[{"Flatten", "[", 
            RowBox[{"anTable", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "3"}], "]"}], "]"}], "]"}]}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"theGenerics", "=", 
         RowBox[{"Complement", "[", 
          RowBox[{
           RowBox[{"Range", "[", 
            RowBox[{"Length", "@", "theS"}], "]"}], ",", "nonGenerics"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"theGenerics", ",", "nonGenerics"}], "}"}]}]}], 
      "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]"}]}]], "Input",
