Cell[CellGroupData[{

Cell["getCommonDenom(k,lambda)", "Subsection",
 InitializationCell->True,
 InitializationGroup->True,
 CellChangeTimes->{{3.5610144613727565`*^9, 
  3.5610144809507904`*^9}},ExpressionUUID->"c91f6f1f-af09-4917-a091-\
fae804c7ade3"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"getCommonDenom", "[", 
     RowBox[{"k_", ",", "lam_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "mylambdas", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"mylambdas", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"lam", "[", 
           RowBox[{"[", "i", "]"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", "k"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"i", "=", "1"}], ",", 
         RowBox[{"i", "\[LessEqual]", 
          RowBox[{"Length", "[", "mylambdas", "]"}]}], ",", 
         RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"mylambdas", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "\[Equal]", "0"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"mylambdas", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "=", "1"}], ";"}]}], 
           "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Apply", "[", 
        RowBox[{"LCM", ",", 
         RowBox[{"Denominator", "[", "mylambdas", "]"}]}], "]"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}]], "Input",
 InitializationCell->True,
 InitializationGroup->True,
 CellChangeTimes->{{3.5608696380378585`*^9, 3.5608696491864963`*^9}, 
   3.5610144941952133`*^9, {3.8769065641115274`*^9, 3.876906566220559*^9}},
 CellLabel->"In[99]:=",ExpressionUUID->"e3e473ba-1b71-4b1c-ae81-f3dcdf1e0a9b"]
}, Closed]],

