Cell["Section 2.2:  Create singular point summary", "Subsection",
 CellChangeTimes->{{3.983196868023493*^9, 3.983196899162054*^9}, {
  3.983197150881979*^9, 
  3.983197156730303*^9}},ExpressionUUID->"cf212dbf-e076-43cf-af8e-\
cf720aea1af2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{
    "remove", " ", "from", " ", "the", " ", "$zeroIndexes", " ", "list"}], 
    ",", " ", 
    RowBox[{
    "singular", " ", "points", " ", "which", " ", "are", " ", "also", " ", 
     "poles"}]}], "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"$zeroIndexes", "=", 
     RowBox[{"Complement", "[", 
      RowBox[{"$zeroIndexes", ",", "$poleIndexes"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{"now", " ", "identify", " ", "generics"}], "\[IndentingNewLine]", 
    "*)"}], "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"genericIndexes", ",", "returnedNonGenerics"}], "}"}], "=", 
     RowBox[{"getGenericList", "[", 
      RowBox[{"$theFunction", ",", "$theSingularList"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"genericAtOrigin", "=", "False"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Length", "@", "genericIndexes"}], ">", "0"}], " ", "&&", " ", 
       RowBox[{
        RowBox[{"genericIndexes", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "==", "1"}], " ", "&&", " ", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"$theSingularList", "[", 
          RowBox[{"[", 
           RowBox[{"genericIndexes", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], "]"}], "<", 
        RowBox[{"10", "^", 
         RowBox[{"-", "100"}]}]}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"Style", "[", 
         RowBox[{
         "\"\<Found generic singular point at origin\>\"", ",", "Red", ",", 
          "Bold"}], "]"}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"genericAtOrigin", "=", "True"}], ";"}], "\[IndentingNewLine]",
       ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"Style", "[", 
         RowBox[{
         "\"\<Did not find generic singular point at origin\>\"", ",", "Blue",
           ",", "Bold"}], "]"}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}],
     ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Total singular points: \>\"", ",", 
      RowBox[{"Length", "@", "$theSingularList"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Total \!\(\*SubscriptBox[\(s\), \(z\)]\) points: \>\"", ",", 
      RowBox[{"Length", "@", "$zeroIndexes"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{
     "\"\<Total \!\(\*SubscriptBox[\(s\), \(p\)]\) points : \>\"", ",", 
      RowBox[{"Length", "@", "$poleIndexes"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Total \!\(\*SubscriptBox[\(s\), \(g\)]\) points: \>\"", ",", 
      RowBox[{"Length", "@", "genericIndexes"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fValsList", "=", 
     RowBox[{"NSolve", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"$theFunction", "==", "0"}], "/.", 
        RowBox[{"z", "->", "0"}]}], ",", "w", ",", 
       RowBox[{"WorkingPrecision", "->", "25"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dValsList", "=", 
     RowBox[{"NSolve", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{"$theFunction", ",", "w"}], "]"}], "==", "0"}], "/.", 
        RowBox[{"z", "->", "0"}]}], ",", "w", ",", 
       RowBox[{"WorkingPrecision", "->", "25"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Length", "@", "fValsList"}], ">", "0"}], " ", "&&", " ", 
       RowBox[{
        RowBox[{"Length", "@", "dValsList"}], ">", "0"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"fVals", "=", 
        RowBox[{"Sort", "[", 
         RowBox[{"w", "/.", 
          RowBox[{"NSolve", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"$theFunction", "==", "0"}], "/.", 
             RowBox[{"z", "->", "0"}]}], ",", "w", ",", 
            RowBox[{"WorkingPrecision", "->", "25"}]}], "]"}]}], "]"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"dVals", "=", 
        RowBox[{"Sort", "[", 
         RowBox[{"w", "/.", 
          RowBox[{"NSolve", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"D", "[", 
               RowBox[{"$theFunction", ",", "w"}], "]"}], "==", "0"}], "/.", 
             RowBox[{"z", "->", "0"}]}], ",", "w", ",", 
            RowBox[{"WorkingPrecision", "->", "25"}]}], "]"}]}], "]"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"fValsPrec", "=", 
        RowBox[{"Precision", "@", "fVals"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "@", 
           RowBox[{"Intersection", "[", 
            RowBox[{"fVals", ",", "dVals", ",", 
             RowBox[{"SameTest", "->", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"EuclideanDistance", "[", 
                  RowBox[{"#1", ",", " ", "#2"}], "]"}], " ", "<", " ", 
                 RowBox[{"10", "^", 
                  RowBox[{"(", 
                   RowBox[{"-", "5"}], ")"}]}]}], " ", "&"}], ")"}]}]}], 
            "]"}]}], "!=", "0"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"Style", "[", 
            RowBox[{"\"\<Origin is a singular point!\>\"", ",", "Red"}], 
            "]"}], "]"}], ";"}], "\[IndentingNewLine]", ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"Style", "[", 
            RowBox[{"\"\<Origin is not a singular point\>\"", ",", "Blue"}], 
            "]"}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]}], 
     "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"singPrec", "=", 
     RowBox[{"Floor", "@", 
      RowBox[{"Precision", "@", "$theSingularList"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"$theSingularList", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}], "<", 
        RowBox[{"10", "^", 
         RowBox[{"(", 
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{"singPrec", "-", "$acf"}], ")"}]}], ")"}]}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{"Style", "[", 
          RowBox[{
          "\"\<Zero is a singular point\>\"", ",", "Bold", ",", "Red"}], 
          "]"}], "]"}], ";"}], "\[IndentingNewLine]", ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{"Style", "[", 
          RowBox[{"\"\<Origin is not a singular point.\>\"", ",", "Blue"}], 
          "]"}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<s_1: \>\"", ",", 
          RowBox[{
           RowBox[{"$theSingularList", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "//", "N"}]}], "]"}], ";"}]}], 
      "\[IndentingNewLine]", "]"}], ";"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "@", "$theSingularList"}], ">", "1"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"minSingSeparation", "=", 
        RowBox[{
         RowBox[{"3", 
          RowBox[{"Min", "@", "$minRadiusArray"}]}], "//", "N"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"minSingAccFactor", "=", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{
           RowBox[{"MantissaExponent", "[", "minSingSeparation", "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], "+", "5"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<minSingAccFactor: \>\"", ",", "minSingAccFactor"}], 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{"$theSingularList", "[", 
          RowBox[{"[", 
           RowBox[{"1", ";;", "2"}], "]"}], "]"}], ",", "20"}], "]"}], 
       ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", " ", "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.9665239051265626`*^9, 3.9665239062142873`*^9}, {
