Cell[CellGroupData[{

Cell["\<\
Section 2.3:  Search for dual roots (roots of a_0 that are roots of a_n)\
\>", "Subsection",
 CellChangeTimes->{{3.9883713681549716`*^9, 3.9883713896627593`*^9}, {
  3.989581385646846*^9, 
  3.9895814114623384`*^9}},ExpressionUUID->"dcb5710b-2d2c-489b-8a4e-\
851e6d9a9065"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"a", " ", "search", " ", "for", " ", "dual", " ", "zero"}], "-", 
     RowBox[{"pole", " ", "points"}]}], ",", " ", 
    RowBox[{
    "and", " ", "determine", " ", "if", " ", "zero", " ", "root", " ", "is", 
     " ", "also", " ", "a", " ", "root", " ", "in", " ", "next", " ", "a_i", 
     " ", "coefficient"}]}], "\[IndentingNewLine]", "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{"new", " ", "format"}], "\[IndentingNewLine]", "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"wRules", "=", 
     RowBox[{"CoefficientRules", "[", 
      RowBox[{
      "$theFunction", ",", "w", ",", "\"\<NegativeLexicographic\>\""}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"theWKeys", "=", 
    RowBox[{"Keys", "[", "wRules", "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"theAICoef", "=", 
     RowBox[{"Values", "[", "wRules", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"theA0Coef", "=", 
     RowBox[{"theAICoef", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"theANCoef", "=", 
     RowBox[{"theAICoef", "[", 
      RowBox[{"[", 
       RowBox[{"-", "1"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{"find", " ", "roots", " ", "of", " ", "a_", "0"}], 
    "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"a0Roots", "=", 
     RowBox[{"NSolveValues", "[", 
      RowBox[{
       RowBox[{"theA0Coef", "==", "0"}], ",", "z", ",", 
       RowBox[{"WorkingPrecision", "->", "$workingPrecision"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"a0Roots", "=", 
     RowBox[{"DeleteDuplicates", "[", "a0Roots", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<a0Roots: \>\"", ",", 
      RowBox[{"a0Roots", "//", "N"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{
    "now", " ", "determine", " ", "if", " ", "root", " ", "from", " ", "a_", 
     "0", " ", "is", " ", "a", " ", "root", " ", "in", " ", "next", " ", 
     "sequential", " ", "a_i"}], "\[IndentingNewLine]", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"index", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"flag", "=", "False"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"While", "[", " ", 
    RowBox[{
     RowBox[{"index", "<", 
      RowBox[{"Length", "@", "theWKeys"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"index", "++"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<searching for dual roots in coefficient \>\"", ",", 
        RowBox[{"theWKeys", "[", 
         RowBox[{"[", "index", "]"}], "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"aiRoots", "=", 
       RowBox[{"NSolveValues", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"theAICoef", "[", 
           RowBox[{"[", "index", "]"}], "]"}], "==", "0"}], ",", "z", ",", 
         RowBox[{"WorkingPrecision", "->", "$workingPrecision"}]}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"aiRoots", "=", 
       RowBox[{"DeleteDuplicates", "[", "aiRoots", "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "@", 
          RowBox[{"Intersection", "[", 
           RowBox[{"a0Roots", ",", "aiRoots", ",", 
            RowBox[{"SameTest", "->", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"EuclideanDistance", "[", 
                 RowBox[{"#1", ",", " ", "#2"}], "]"}], " ", "<", " ", 
                RowBox[{"10", "^", 
                 RowBox[{"(", 
                  RowBox[{"-", "20"}], ")"}]}]}], " ", "&"}], ")"}]}]}], 
           "]"}]}], "!=", "0"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"\"\<Found same a_0 root in coefficient \>\"", ",", 
           RowBox[{"theWKeys", "[", 
            RowBox[{"[", "index", "]"}], "]"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"intersectionRoots", "=", 
          RowBox[{"Intersection", "[", 
           RowBox[{"a0Roots", ",", "aiRoots", ",", 
            RowBox[{"SameTest", "->", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"EuclideanDistance", "[", 
                 RowBox[{"#1", ",", " ", "#2"}], "]"}], " ", "<", " ", 
                RowBox[{"10", "^", 
                 RowBox[{"(", 
                  RowBox[{"-", "10"}], ")"}]}]}], " ", "&"}], ")"}]}]}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{"\"\<Intersection roots: \>\"", ",", 
           RowBox[{"intersectionRoots", "//", "N"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"index", "==", 
            RowBox[{"Length", "@", "theWKeys"}]}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Print", "[", "\"\<Found dual s_0-s_n roots\>\"", "]"}], 
            ";"}]}], "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
        ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"flag", "=", "True"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{"\"\<Did not find a_0 roots in coefficient \>\"", ",", 
           RowBox[{"theWKeys", "[", 
            RowBox[{"[", "index", "]"}], "]"}]}], "]"}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"poleIndexesSave", "=", "$poleIndexes"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"zeroIndexesSave", "=", "$zeroIndexes"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"theSingularListSave", "=", "$theSingularList"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"genericIndexesSave", "=", "genericIndexes"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"singularListLength", "=", 
     RowBox[{"Length", "@", "$theSingularList"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9895814995678916`*^9, 3.9895815041832547`*^9}, {
   3.9895818522023706`*^9, 3.9895818631692815`*^9}, {3.9895819861664457`*^9, 
