Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"singularAtOrigin", "[", "theF_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "value", ",", "fVals", ",", "fAcc", ",", "dVals", ",", "dAcc", ",", 
       "minAcc", ",", "return"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"value", "=", 
       RowBox[{"theF", "/.", 
        RowBox[{"z", "->", "0"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"first", " ", "check", " ", "if", " ", 
         RowBox[{"theF", "/", "z"}]}], "->", 
        RowBox[{
        "0", " ", "is", " ", "a", " ", "polynomial", " ", "with", " ", "z", 
         " ", "and", " ", "or", " ", "w"}]}], " ", "\[IndentingNewLine]", 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"NumberQ", "[", "value", "]"}]}], ",", "\[IndentingNewLine]",
         " ", 
        RowBox[{
         RowBox[{"fVals", "=", 
          RowBox[{"Sort", "[", 
           RowBox[{"w", "/.", 
            RowBox[{"NSolve", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"theF", "==", "0"}], "/.", 
               RowBox[{"z", "->", "0"}]}], ",", "w"}], "]"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"\"\<fVals: \>\"", ",", 
             RowBox[{
              RowBox[{"Sort", "@", "fVals"}], "//", "N"}]}], "]"}], ";"}], 
          "*)"}], "\[IndentingNewLine]", 
         RowBox[{"fAcc", "=", 
          RowBox[{"Floor", "@", 
           RowBox[{"Accuracy", "[", "fVals", "]"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", "\[IndentingNewLine]", " ", 
          RowBox[{
          "first", " ", "check", " ", "if", " ", "f_w", " ", "is", " ", "not",
            " ", "zero"}], "\[IndentingNewLine]", "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"D", "[", 
               RowBox[{"theF", ",", "w"}], "]"}], "/.", 
              RowBox[{"z", "->", "0"}]}], ")"}], "!=", "0"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Print", "[", "\"\<test1\>\"", "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"dVals", "=", 
             RowBox[{"Sort", "[", 
              RowBox[{"w", "/.", 
               RowBox[{"NSolve", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"D", "[", 
                    RowBox[{"theF", ",", "w"}], "]"}], "==", "0"}], "/.", 
                  RowBox[{"z", "->", "0"}]}], ",", "w"}], "]"}]}], "]"}]}], 
            ";", "\[IndentingNewLine]", 
            RowBox[{"dAcc", "=", 
             RowBox[{"Floor", "@", 
              RowBox[{"Accuracy", "[", "dVals", "]"}]}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"minAcc", "=", 
             RowBox[{
              RowBox[{"Min", "[", 
               RowBox[{"fAcc", ",", "dAcc"}], "]"}], "-", "5"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{"Print", "[", 
               RowBox[{"\"\<dVals: \>\"", ",", 
                RowBox[{"Sort", "@", "dVals"}]}], "]"}], ";"}], "*)"}], 
            "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Length", "@", 
                RowBox[{"Intersection", "[", 
                 RowBox[{"fVals", ",", "dVals", ",", 
                  RowBox[{"SameTest", "->", 
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "[", 
                    RowBox[{"#1", "-", "#2"}], "]"}], "<", 
                    RowBox[{"10", "^", 
                    RowBox[{"-", "minAcc"}]}]}], "&"}], ")"}]}]}], "]"}]}], "!=",
                "0"}], ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"return", "=", "True"}], ";", "\[IndentingNewLine]", 
               RowBox[{"Print", "[", 
                RowBox[{"Style", "[", 
                 RowBox[{
                 "\"\<Detected generic singular point at origin\>\"", ",", 
                  "Purple"}], "]"}], "]"}], ";"}], "\[IndentingNewLine]", ",",
               "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"return", "=", "False"}], ";"}]}], 
             "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Print", "[", 
             RowBox[{"Style", "[", 
              RowBox[{
              "\"\<Cannot determine singularity at zero with derivatives: \
\!\(\*SubscriptBox[\(f\), \(w\)]\) at zero is zero!\>\"", ",", "Red"}], "]"}],
              "]"}], ";", "\[IndentingNewLine]", 
            RowBox[{"return", "=", "\"\<error\>\""}], ";"}]}], 
          "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", ",", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", "\[IndentingNewLine]", " ", 
         RowBox[{
          RowBox[{"fVal", "/", "z"}], "->", " ", 
          RowBox[{"is", " ", "a", " ", "number", " ", "only"}]}], 
         "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"Style", "[", 
           RowBox[{
           "\"\<Cannot determine singularity at zero with this routine.  \
Function at zero is a number\>\"", ",", "Red"}], "]"}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"return", "=", "\"\<error\>\""}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", "return"}]}],
     "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9482742611535683`*^9, 3.948274387342903*^9}, {
  3.948274432004276*^9, 3.948274449109659*^9}, {3.9482746629043694`*^9, 
