Cell[CellGroupData[{

Cell["Set up file names", "Subsection",
 InitializationGroup->True,
 CellChangeTimes->{{3.9466196496782036`*^9, 
  3.9466196529892282`*^9}},ExpressionUUID->"c412034f-04ca-4194-92b5-\
51c96cf9f33f"],

Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"singularDataFileName", "[", "testCase_", "]"}], ":=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{"dataDir", ",", "testCase", ",", "\"\<singularData.m\>\""}], 
       "}"}], "]"}]}], " ", ";"}], "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"resultantFileName", "[", "testCase_", "]"}], ":=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{"dataDir", ",", "testCase", ",", "\"\<resultant.m\>\""}], " ", 
       "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"seriesFileName", "[", 
      RowBox[{"testCase_String", ",", "k_Integer"}], "]"}], ":=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{"dataDir", ",", 
        RowBox[{
         RowBox[{"StringTemplate", "[", 
          RowBox[{"\"\<`1`\\\\\>\"", "<>", "\"\<`2`series.m\>\""}], "]"}], 
         "[", 
         RowBox[{"testCase", ",", 
          RowBox[{"ToString", "@", "k"}]}], "]"}]}], "}"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"reformedFunctionTableFileName", "[", "testCase_", "]"}], ":=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{
       "dataDir", ",", "testCase", ",", "\"\<reformedFunctions.m\>\""}], " ", 
       "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
