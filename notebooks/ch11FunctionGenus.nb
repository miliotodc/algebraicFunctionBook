  3.948275949960557*^9, 3.948275954055977*^9}, {3.9482760472399297`*^9, 
  3.94827605119341*^9}, {3.9482760955924807`*^9, 3.9482761015528207`*^9}, {
  3.948276285588502*^9, 3.948276295548287*^9}, {3.948276327308919*^9, 
  3.948276372792618*^9}, {3.9482765156078663`*^9, 3.9482766813513107`*^9}, {
  3.948279028526315*^9, 3.948279036055685*^9}, {3.9482792221995764`*^9, 
