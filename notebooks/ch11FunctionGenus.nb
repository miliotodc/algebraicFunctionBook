Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"getFiniteRamifications", "[", 
     RowBox[{"finiteRam_", ",", "genIndexes_", ",", "typeID_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "ramRecords", ",", "cData", ",", "ramCycleData", ",", "theIndex", ",", 
