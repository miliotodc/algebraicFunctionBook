                RowBox[{
                 RowBox[{"return", "=", 
                  RowBox[{"{", "y", "}"}]}], ";"}], "\[IndentingNewLine]", 
                ",", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"return", "=", 
                  RowBox[{"Range", "[", 
                   RowBox[{"y", ",", "z"}], "]"}]}], ";"}]}], 
               "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", 
