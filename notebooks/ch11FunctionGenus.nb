Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Original f: \>\"", ",", 
    RowBox[{"aForm", "[", "functionSave", "]"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{"cList", "=", 
    RowBox[{"CoefficientList", "[", 
     RowBox[{"functionSave", ",", "w"}], "]"}]}], 
   ";"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"maxZ", "=", 
   RowBox[{"Max", "@", 
    RowBox[{"Flatten", "@", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"Exponent", "[", 
         RowBox[{"#", ",", "z", ",", "List"}], "]"}], "&"}], "/@", " ", 
       "cList"}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"$theFunction", "=", 
    RowBox[{"Expand", "[", 
     RowBox[{
      RowBox[{"z", "^", "maxZ"}], 
      RowBox[{"(", 
       RowBox[{"functionSave", "/.", 
        RowBox[{"z", "->", 
         RowBox[{"1", "/", "z"}]}]}], ")"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Infinity function: \>\"", ",", 
    RowBox[{"aForm", "[", "$theFunction", "]"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"fVals", "=", 
  RowBox[{"Sort", "[", 
   RowBox[{"NSolveValues", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"$theFunction", "==", "0"}], "/.", 
      RowBox[{"z", "->", "0"}]}], ",", "w", ",", 
     RowBox[{"WorkingPrecision", "->", "25"}]}], "]"}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"dVals", "=", 
  RowBox[{"Sort", "[", 
   RowBox[{"NSolveValues", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{"$theFunction", ",", "w"}], "]"}], "==", "0"}], "/.", 
      RowBox[{"z", "->", "0"}]}], ",", "w", ",", 
     RowBox[{"WorkingPrecision", "->", "25"}]}], "]"}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<test\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fValsPrec", "=", 
   RowBox[{"Precision", "@", "fVals"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Length", "@", 
       RowBox[{"Intersection", "[", 
        RowBox[{"fVals", ",", "dVals", ",", 
         RowBox[{"SameTest", "->", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"EuclideanDistance", "[", 
              RowBox[{"#1", ",", " ", "#2"}], "]"}], " ", "<", " ", 
             RowBox[{"10", "^", 
              RowBox[{"(", 
               RowBox[{"-", "5"}], ")"}]}]}], " ", "&"}], ")"}]}]}], "]"}]}], 
      "!=", "0"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Print", "[", 
       RowBox[{"Style", "[", 
        RowBox[{"\"\<Origin is a singular point!\>\"", ",", "Red"}], "]"}], 
       "]"}], ";"}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Print", "[", 
       RowBox[{"Style", "[", 
        RowBox[{"\"\<Origin is not a singular point\>\"", ",", "Blue"}], 
        "]"}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"aForm", "[", "$theFunction", "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"reformedWRules", ",", "theReformedIndexes"}], "}"}], "=", 
    RowBox[{"getReformedInfinityIndexes", "[", 
     RowBox[{"$theFunction", ",", 
      RowBox[{"{", "0", "}"}], ",", "$zeroIndexes", ",", "$poleIndexes"}], 
     "]"}]}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{"use", " ", "\"\<diag\>\""}], "->", 
    RowBox[{"True", " ", "for", " ", "diagnostics"}]}], "\[IndentingNewLine]",
    "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"reformedFunctionTable", "=", 
   RowBox[{"getReformedFunctionTableInfinity", "[", 
    RowBox[{
    "$theFunction", ",", "reformedWRules", ",", "theReformedIndexes"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", "reformedFunctionTable", "\
\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"reformedFunctionAtInfinity", "=", 
   RowBox[{
    RowBox[{"reformedFunctionTable", "[", 
     RowBox[{"[", 
      RowBox[{"1", ",", "2"}], "]"}], "]"}], "/.", 
    RowBox[{"s", "->", "0"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
