Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"generateRamificationReport", "[", 
      RowBox[{
      "finiteRam_", ",", "infRam_", ",", "genericIndexesSave_", ",", 
       "poleIndexesSave_", ",", "zeroIndexesSave_", ",", "labelArray_"}], 
      "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "genericLabel", ",", "poleLabel", ",", "zeroLabel", ",", 
         "genericCycleCode", ",", "poleCycleCode", ",", "zeroCycleCode", ",", 
         "infinityCycleCode"}], "}"}], ",", "\[IndentingNewLine]", " ", 
       "\[IndentingNewLine]", " ", 
       RowBox[{
        RowBox[{"genericCycleCode", "=", 
         RowBox[{
          RowBox[{"getFiniteRamifications", "[", 
           RowBox[{"finiteRam", ",", "genericIndexesSave", ",", 
            SubscriptBox[
             RowBox[{"labelArray", "[", 
              RowBox[{"[", "1", "]"}], "]"}], 
             RowBox[{"Length", "@", "genericIndexesSave"}]]}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"1", ";;", "2"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"poleCycleCode", "=", 
         RowBox[{
          RowBox[{"getFiniteRamifications", "[", 
           RowBox[{"finiteRam", ",", "poleIndexesSave", ",", 
            SubscriptBox[
             RowBox[{"labelArray", "[", 
              RowBox[{"[", "2", "]"}], "]"}], 
             RowBox[{"Length", "@", "poleIndexesSave"}]]}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"1", ";;", "2"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"zeroCycleCode", "=", 
         RowBox[{
          RowBox[{"getFiniteRamifications", "[", 
           RowBox[{"finiteRam", ",", "zeroIndexesSave", ",", 
            SubscriptBox[
             RowBox[{"labelArray", "[", 
              RowBox[{"[", "3", "]"}], "]"}], 
             RowBox[{"Length", "@", "zeroIndexesSave"}]]}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"1", ";;", "2"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"infinityCycleCode", "=", 
         RowBox[{
          RowBox[{"getInfinityRamification", "[", 
           RowBox[{
            RowBox[{"labelArray", "[", 
             RowBox[{"[", "4", "]"}], "]"}], ",", 
            RowBox[{"infRam", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "1"}], "]"}], "]"}]}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"1", ";;", "2"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"Labeled", "[", 
         RowBox[{
          RowBox[{"Grid", "[", 
           RowBox[{
            RowBox[{"Prepend", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
               "genericCycleCode", ",", "poleCycleCode", ",", "zeroCycleCode",
                 ",", "infinityCycleCode"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"\"\<Type\>\"", ",", "\"\<Cycles\>\""}], "}"}]}], 
             "]"}], ",", 
            RowBox[{"Alignment", "->", 
             RowBox[{"{", 
              RowBox[{"Center", ",", "Left"}], "}"}]}], ",", 
            RowBox[{"Spacings", "->", 
             RowBox[{"{", 
              RowBox[{"2", ",", "0.5"}], "}"}]}], ",", 
            RowBox[{"Dividers", "\[Rule]", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"{", "True", "}"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"True", ",", "True", ",", 
                 RowBox[{"{", "False", "}"}], ",", "True"}], "}"}]}], 
              "}"}]}]}], "]"}], ",", 
          RowBox[{"Style", "[", "\"\<Ramifiation Report\>\"", "]"}], ",", 
          "Top"}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.9482700068712125`*^9, 3.948270207137447*^9}, 
   3.9482702376146603`*^9, {3.9482702848066072`*^9, 3.9482702851191835`*^9}},
 CellLabel->
  "In[108]:=",ExpressionUUID->"01cc214a-eb3f-4d32-adda-74f96dc059ec"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"generateRamificationReportOld", "[", 
      RowBox[{
      "finiteRam_", ",", "infRam_", ",", "genericIndexesSave_", ",", 
       "poleIndexesSave_", ",", "zeroIndexesSave_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "genericLabel", ",", "poleLabel", ",", "zeroLabel", ",", 
         "genericCycleCode", ",", "poleCycleCode", ",", "zeroCycleCode", ",", 
         "infinityCycleCode"}], "}"}], ",", "\[IndentingNewLine]", " ", 
       RowBox[{
        RowBox[{
        "genericLabel", "=", 
         "\"\<{\!\(\*TemplateBox[<|\\\"boxes\\\" -> \
FormBox[OverscriptBox[StyleBox[\\\"s\\\", \\\"TI\\\"], \\\"_\\\"], \
TraditionalForm], \\\"errors\\\" -> {}, \\\"input\\\" -> \
\\\"\\\\\\\\overline{s}\\\", \\\"state\\\" -> \
\\\"Boxes\\\"|>,\\\"TeXAssistantTemplate\\\"]\)}\>\""}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
        "poleLabel", "=", "\"\<{\!\(\*SubscriptBox[\(s\), \(p\)]\)}\>\""}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{
        "zeroLabel", "=", "\"\<{\!\(\*SubscriptBox[\(s\), \(q\)]\)}\>\""}], 
        ";", "\[IndentingNewLine]", " ", 
        RowBox[{"genericCycleCode", "=", 
         RowBox[{
          RowBox[{"getFiniteRamifications", "[", 
           RowBox[{"finiteRam", ",", "genericIndexesSave", ",", 
            SubscriptBox["genericLabel", 
             RowBox[{"Length", "@", "genericIndexesSave"}]]}], "]"}], "[", 
