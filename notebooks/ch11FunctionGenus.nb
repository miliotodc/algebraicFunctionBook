                    RowBox[{"nearestDistArray", "=", 
                    RowBox[{"{", "4", "}"}]}], ";", "\[IndentingNewLine]", 
                    RowBox[{"rNormArray", "=", 
                    RowBox[{"{", "2", "}"}]}]}]}], "\[IndentingNewLine]", 
                    "]"}], ";", "\[IndentingNewLine]", 
                    RowBox[{"theReturn", "=", 
                    RowBox[{"{", 
                    RowBox[{
                    "theSingularList", ",", "poleIndexes", ",", 
                    "minRadiusArray", ",", "res", ",", "zeroIndexes", ",", 
                    "nearestDistArray", ",", "rNormArray"}], "}"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"OptionValue", "[", "\"\<diag\>\"", "]"}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"Print", "[", 
                    RowBox[{"\"\<Total singular points: \>\"", ",", 
                    RowBox[{"Length", "@", "theSingularList"}]}], "]"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"Print", "[", 
                    RowBox[{"\"\<Precision of singular points: \>\"", ",", 
                    RowBox[{"Precision", "@", "theSingularList"}]}], "]"}], 
                    ";", "\[IndentingNewLine]", 
                    RowBox[{"Print", "[", 
                    RowBox[{"\"\<Total poles: \>\"", ",", 
                    RowBox[{"Length", "@", "poleIndexes"}]}], "]"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"Print", "[", 
                    RowBox[{
                    RowBox[{"Style", "[", 
                    RowBox[{"\"\<Pole indexes: \>\"", ",", "Red"}], "]"}], 
                    ",", 
                    RowBox[{"Style", "[", 
                    RowBox[{"poleIndexes", ",", "Red"}], "]"}]}], "]"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"Print", "[", 
                    RowBox[{"\"\<Total zero points: \>\"", ",", 
                    RowBox[{"Length", "@", "zeroIndexes"}]}], "]"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"Print", "[", 
                    RowBox[{
                    RowBox[{"Style", "[", 
                    RowBox[{"\"\<Zero indexes: \>\"", ",", "Blue"}], "]"}], 
                    ",", 
                    RowBox[{"Style", "[", 
                    RowBox[{"zeroIndexes", ",", "Blue"}], "]"}]}], "]"}], ";",
                     "\[IndentingNewLine]", 
                    RowBox[{"Print", "[", 
                    RowBox[{"\"\<Min singular perimeter: \>\"", ",", 
                    RowBox[{
                    RowBox[{"Min", "@", "minRadiusArray"}], "//", "N"}]}], 
                    "]"}], ";", "\[IndentingNewLine]", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Length", "@", "theSingularList"}], ">", "1"}], 
                    ",", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"Print", "[", 
                    RowBox[{"\"\<Smallest singular points: \>\"", ",", 
                    RowBox[{
                    RowBox[{"theSingularList", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ";;", "2"}], "]"}], "]"}], "//", "N"}]}], 
                    "]"}], ";"}], "\[IndentingNewLine]", ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"Print", "[", 
                    RowBox[{"\"\<Singular point: \>\"", ",", 
                    RowBox[{
                    RowBox[{"theSingularList", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "//", "N"}]}], "]"}], 
                    ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]}], 
                    "\[IndentingNewLine]", "]"}], ";"}]}], 
                  "\[IndentingNewLine]", "]"}], ";"}]}], 
               "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", 
            "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", "theReturn"}]}], 
