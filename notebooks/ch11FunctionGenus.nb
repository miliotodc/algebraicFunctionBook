 RowBox[{" ", 
  RowBox[{
   RowBox[{"g1", "=", 
    RowBox[{"Prepend", "[", 
     RowBox[{"reformedWRules", ",", 
      RowBox[{"{", 
       RowBox[{"\"\<wCoef\>\"", ",", "\"\<Indexes\>\""}], "}"}]}], "]"}]}], 
   ";"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g2", "=", 
   RowBox[{"Prepend", "[", 
    RowBox[{"g1", ",", 
     RowBox[{"{", 
      RowBox[{"\"\<Zero coefficient indexes\>\"", ",", "SpanFromLeft"}], 
