Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Options", "[", "getReformedInfinityIndexes", "]"}], "=", 
     RowBox[{"{", 
      RowBox[{"\"\<diag\>\"", "->", "False"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "   ", 
   RowBox[{
    RowBox[{"getReformedInfinityIndexes", "[", 
     RowBox[{
     "theFunction_", ",", "theSingularList_", ",", "zIndexes_", ",", 
      "pIndexes_", ",", 
      RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "diag1", ",", "diag2", ",", "diag3", ",", "singularPrecision", ",", 
        "functionCoeffRules", ",", "functionCoeffRulesLen", ",", 
        "reformedWRules", ",", "wKey", ",", "keyValue", ",", "zTerms", ",", 
        "zTermLen", ",", "wp", ",", "zeroTable", ",", "zKey", ",", 
        "zKeyValue", ",", "zeroRule", ",", "aRoots", ",", "aPrec", ",", 
        "theZeroPos", ",", "return", ",", "removalKeys", ",", 
        "theReformedIndexes", ",", "i", ",", "singularAccuracy", ",", 
        "aAcc"}], "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"OptionValue", "[", "\"\<diag\>\"", "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"\"\<Function: \>\"", ",", 
            RowBox[{"polyForm", "[", 
             RowBox[{"theFunction", ",", "w"}], "]"}]}], "]"}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"singularPrecision", "=", 
        RowBox[{"Floor", "@", 
         RowBox[{"Precision", "@", "theSingularList"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"singularPrecision", "=", "1000"}], ";", "\[IndentingNewLine]", 
       RowBox[{"singularAccuracy", "=", 
        RowBox[{"Floor", "@", 
         RowBox[{"Accuracy", "@", "theSingularList"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"singularAccuracy", "=", "900"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"functionCoeffRules", "=", 
        RowBox[{"CoefficientRules", "[", 
         RowBox[{
          RowBox[{"Expand", "[", 
           RowBox[{"theFunction", "/.", 
            RowBox[{"z", "->", 
             RowBox[{"z", "+", "s"}]}]}], "]"}], ",", "w", ",", 
          "\"\<NegativeLexicographic\>\""}], " ", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"functionCoeffRulesLen", "=", 
        RowBox[{"Length", "@", "functionCoeffRules"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{
          "\"\<function coeff rules length: \>\"", ",", 
           "functionCoeffRulesLen"}], "]"}], ";"}], "*)"}], 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"reformedWRules", "=", 
        RowBox[{"Table", "[", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"\"\<wVal term: \>\"", ",", 
             RowBox[{"functionCoeffRules", "[", 
              RowBox[{"[", "wValIndex", "]"}], "]"}]}], "]"}], ";"}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"wKey", "=", 
            RowBox[{"functionCoeffRules", "[", 
             RowBox[{"[", 
              RowBox[{"wValIndex", ",", "1"}], "]"}], "]"}]}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{
               RowBox[{"Style", "[", 
                RowBox[{
                "\"\<Processing wKey: \>\"", ",", "Bold", ",", "Blue"}], 
                "]"}], ",", "wKey"}], "]"}], ";"}], "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"wKey", "==", 
                RowBox[{"{", "0", "}"}]}], ",", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"Print", "[", "\"\<Processing zero key\>\"", "]"}], 
                ";"}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"wKey", "==", 
                   RowBox[{"{", "functionDegree", "}"}]}], ",", 
                  "\[IndentingNewLine]", 
                  RowBox[{
