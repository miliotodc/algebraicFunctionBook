  RowBox[{
   RowBox[{
    RowBox[{"$theFunction", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"z", "^", 
         RowBox[{"(", "30", ")"}]}], "+", 
