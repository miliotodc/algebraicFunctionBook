Cell[CellGroupData[{

Cell["Section 5:  Computing reformed function at infinity", "Section",
 CellChangeTimes->{{3.948098482303713*^9, 3.94809849186403*^9}, {
  3.9749787482890787`*^9, 3.974978750188939*^9}, {3.9831829594002485`*^9, 
