  RowBox[{
   RowBox[{
    RowBox[{"$theFunction", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"z", "^", "2"}]}], ")"}], "-", 
      RowBox[{"w", "^", "2"}]}]}], ";"}], "\[IndentingNewLine]", 
