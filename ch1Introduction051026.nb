Cell[CellGroupData[{

Cell["\<\
Section 6.6:  Manually conjugate generator series for the 5-cycle branch and \
plot the sheets\
\>", "Subsection",
 CellChangeTimes->{{3.9874163663174243`*^9, 
  3.9874163923886237`*^9}},ExpressionUUID->"074003e9-5c71-43aa-b362-\
7167c999c960"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{
    "manually", " ", "conjugate", " ", "the", " ", "generator", " ", "series",
      " ", "for", " ", "the", " ", "5"}], "-", 
    RowBox[{"cycle", " ", "branch"}]}], "\[IndentingNewLine]", "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"$reim", "=", "Re"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"theSeries", "=", 
     RowBox[{"pSeries", "[", 
      RowBox[{"[", "pIndex", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"expList", "=", 
     RowBox[{"Exponent", "[", 
      RowBox[{"theSeries", ",", "z", ",", "List"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"coefList", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Coefficient", "[", 
        RowBox[{"theSeries", ",", "z", ",", "#"}], "]"}], "&"}], "/@", " ", 
      "expList"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"conj1", "=", 
     RowBox[{"Plus", "@@", 
      RowBox[{"MapThread", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"#1", " ", 
          RowBox[{"z", "^", "#2"}], " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"2", " ", "Pi", " ", "I", " ", "#2"}], "]"}]}], "&"}], ",", 
        RowBox[{"{", 
         RowBox[{"coefList", ",", "expList"}], "}"}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"conjSet", "[", "j_", "]"}], ":=", 
     RowBox[{"Plus", "@@", 
      RowBox[{"MapThread", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"#1", " ", 
          RowBox[{"z", "^", "#2"}], " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"2", " ", "Pi", " ", "I", " ", "j", " ", "#2"}], "]"}]}], 
         "&"}], ",", 
        RowBox[{"{", 
         RowBox[{"coefList", ",", "expList"}], "}"}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.987409222087494*^9, 3.9874092225664387`*^9}, {
  3.9874092821587734`*^9, 3.9874093853421183`*^9}, {3.9874095073987703`*^9, 
  3.9874095579126606`*^9}, {3.987411242503069*^9, 3.987411267375814*^9}, {
  3.987411539434372*^9, 3.987411569938759*^9}},
 CellLabel->
  "In[249]:=",ExpressionUUID->"2b2e57c1-3c85-4054-8849-0710681e015a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
   "plot", " ", "the", " ", "full", " ", "set", " ", "of", " ", "conjugate", 
    " ", "series"}], "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"theColors", "=", 
     RowBox[{"{", 
      RowBox[{
      "Red", ",", "Blue", ",", "Green", ",", "Yellow", ",", "Purple", ",", 
       "Orange"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"conjPlots", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"ParametricPlot3D", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Re", "@", "z"}], ",", 
            RowBox[{"Im", "@", "z"}], ",", 
            RowBox[{"Re", "@", 
             RowBox[{"conjSet", "[", "j", "]"}]}]}], "}"}], "/.", 
          RowBox[{"z", "->", 
           RowBox[{"r", " ", 
            RowBox[{"Exp", "[", 
             RowBox[{"I", " ", "t"}], "]"}]}]}]}], ",", 
         RowBox[{"{", 
          RowBox[{"r", ",", "0", ",", 
           RowBox[{"1", "/", "10"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", 
           RowBox[{"-", "Pi"}], ",", "Pi"}], "}"}], ",", 
         RowBox[{"BoxRatios", "->", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "1", ",", " ", "1"}], "}"}]}], ",", 
         RowBox[{"PlotStyle", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Opacity", "[", "0.3", "]"}], ",", "Blue"}], "}"}]}]}], 
        "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
