Cell[CellGroupData[{

Cell["Section 5.1:  Compute power expansions at the origin", "Subsection",
 CellChangeTimes->{{3.981554336002059*^9, 3.981554356235561*^9}, {
  3.981555244734826*^9, 3.9815552576664605`*^9}, {3.981712096813266*^9, 
  3.9817121526125607`*^9}, {3.98171232549159*^9, 
