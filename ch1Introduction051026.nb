Cell["\<\
Section 6.4:  Use root test to estimate radius of convergence of series \
\>", "Subsection",
 CellChangeTimes->{{3.987408790560483*^9, 
  3.987408826359234*^9}},ExpressionUUID->"5619b541-226a-4a17-9d2e-\
46e233fb11b5"],

Cell["\<\
This section uses the root test to estimate the radius of convergence of the \
1-cycle series of testCase0002 at the origin.  Since AsymptoticSolve uses \
exact arithmetic, the process takes times to create even a  small number of \
terms giving a rough estimate of R.  In Chapter 3, a numeric method is used \
to generate a larger number of terms quickly and to obtain a more precise \
estimate.\
\>", "Text",
 CellChangeTimes->{{3.987408835472743*^9, 
  3.987409003165275*^9}},ExpressionUUID->"b1730450-ed07-45db-a76f-\
1a0a0c54662b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"create", " ", "root", " ", "test", " ", "points"}], "  ", "*)"}], 
  "\[IndentingNewLine]", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"testSeries", "=", 
     RowBox[{"pSeries", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], ";"}], " ", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"expList", "=", 
     RowBox[{"Exponent", "[", 
      RowBox[{"testSeries", ",", "z", ",", "List"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"coefList", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Coefficient", "[", 
        RowBox[{"testSeries", ",", "z", ",", "#"}], "]"}], "&"}], "/@", " ", 
      "expList"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"theLCM", "=", 
     RowBox[{"LCM", "@@", 
      RowBox[{"(", 
       RowBox[{"Denominator", "@", "expList"}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<LCM: \>\"", ",", "theLCM"}], "]"}], ";"}], 
   "\[IndentingNewLine]", " ", 
   RowBox[{"numerators", "=", 
    RowBox[{"theLCM", " ", "expList"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rootTestTable", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "/", 
          RowBox[{"numerators", "[", 
           RowBox[{"[", "k", "]"}], "]"}]}], ",", 
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{"1", "/", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{"coefList", "[", 
                RowBox[{"[", "k", "]"}], "]"}], "]"}], "^", 
              RowBox[{"(", 
               RowBox[{"theLCM", "/", 
                RowBox[{"numerators", "[", 
                 RowBox[{"[", "k", "]"}], "]"}]}], ")"}]}], ")"}]}], ",", 
           "25"}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"k", ",", "2", ",", 
         RowBox[{"Length", "@", "coefList"}]}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"plot", " ", "root", " ", "test", " ", "points"}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"lp1", "=", 
    RowBox[{"ListPlot", "[", 
     RowBox[{"rootTestTable", ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"{", 
        RowBox[{"PointSize", "[", "0.01", "]"}], "}"}]}], ",", 
      RowBox[{"Frame", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"True", ",", "False"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"True", ",", "False"}], "}"}]}], "}"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"FrameLabel", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{
           TemplateBox[<|"boxes" -> FormBox[
               SubscriptBox[
                StyleBox["y", "TI"], 
                StyleBox["i", "TI"]], TraditionalForm], "errors" -> {}, 
             "input" -> "y_i", "state" -> "Boxes"|>,
            "TeXAssistantTemplate"], ",", "14", ",", "Bold", ",", "Black"}], 
          "]"}], ",", 
         RowBox[{"Rotate", "[", 
          RowBox[{
