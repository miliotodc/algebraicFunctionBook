       RowBox[{
        RowBox[{"-", "1"}], ",", "1"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"plotXEnd", "=", 
     RowBox[{"rootTestTable", "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"endTerms", "=", 
     RowBox[{"Length", "@", "rootTestTable"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"linearLine", "=", 
     RowBox[{
      RowBox[{"c0", "+", 
       RowBox[{"c1", " ", "x"}]}], "/.", " ", 
      RowBox[{
       RowBox[{"NMinimize", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Total", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], "-", 
                RowBox[{"(", 
                 RowBox[{"c0", "+", 
                  RowBox[{"c1", " ", 
                   RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}]}], ")"}]}], ")"}], "&"}],
              "/@", "dataVals"}], "]"}], ",", 
           RowBox[{"And", "@@", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"c0", "+", 
                   RowBox[{"c1", " ", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}]}], ")"}], "<=", 
                 RowBox[{"#", "[", 
                  RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "&"}], "/@", " ", 
              "dataVals"}], ")"}]}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"c0", ",", "c1"}], "}"}], ",", 
         RowBox[{"WorkingPrecision", "->", "MachinePrecision"}]}], "]"}], "[", 
       RowBox[{"[", "2", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Estimated radius of convergence: \>\"", ",", 
     RowBox[{"linearLine", "/.", 
      RowBox[{"x", "->", "0"}]}]}], "]"}], "\[IndentingNewLine]", 
   "linearLine", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"linearPlot", "=", 
     RowBox[{"Plot", "[", 
      RowBox[{"linearLine", ",", 
       RowBox[{"{", 
