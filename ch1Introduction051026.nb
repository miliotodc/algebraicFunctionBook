Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"functionA", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"z", "^", "2"}]}], ")"}], "+", 
