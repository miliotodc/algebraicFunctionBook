Cell["\<\
Section 6.3:  Construct the monodromy reference table entry for the selected \
series generator\
\>", "Subsection",
 CellChangeTimes->{{3.9874080127376547`*^9, 
  3.9874080328727837`*^9}},ExpressionUUID->"758a42cf-44f3-4ccc-a9d7-\
d4db8692bb6a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
   "construct", " ", "the", " ", "monodromy", " ", "reference", " ", "table", 
    " ", "entry", " ", "for", " ", "the", " ", "selected", " ", "power", " ", 
    "expansion", " ", "relating", " ", "the", " ", "Puiseux", " ", "series", 
    " ", "index", " ", "of", " ", "the", " ", "series", " ", "to", " ", "the",
     " ", "mrp", " ", "root"}], "\[IndentingNewLine]", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"mrpPoint", "=", 
     RowBox[{
      RowBox[{"1", "/", "20"}], " ", 
      RowBox[{"Exp", "[", 
       RowBox[{"Pi", " ", 
        RowBox[{"I", "/", "6"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"testVal", "=", 
     RowBox[{"cycleF", "[", "mrpPoint", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"wVals", "=", 
    RowBox[{"NSolveValues", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"$theFunction", "==", "0"}], "/.", 
       RowBox[{"z", "->", "mrpPoint"}]}], ",", "w"}], "]"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"difTable", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"#", "-", "testVal"}], "]"}], "&"}], "/@", " ", "wVals"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"pos", "=", 
    RowBox[{
     RowBox[{"Position", "[", 
      RowBox[{"difTable", ",", 
       RowBox[{"Min", "@", "difTable"}]}], "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"1", ",", "1"}], "]"}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"difTable", "[", 
     RowBox[{"[", "pos", "]"}], "]"}], "//", "N"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"format", " ", "is", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"cycle", " ", "size"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Puiseux", " ", "series", " ", "index"}], ",", " ", 
         RowBox[{"root", " ", "index"}]}], "}"}]}], "}"}]}], " ", "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"mrpEntry", "=", 
    RowBox[{"{", 
     RowBox[{"cycleSize", ",", 
      RowBox[{"{", 
       RowBox[{"pIndex", ",", "pos"}], "}"}]}], "}"}]}], 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{
