Cell[CellGroupData[{

Cell["\<\
Section 5.3:  Set up data for Root Test for 120 terms of aSeries and display \
results\
\>", "Subsection",
 CellChangeTimes->{{3.9761835740471277`*^9, 3.9761835799368987`*^9}, {
  3.9783516824564085`*^9, 3.9783517001008654`*^9}, {3.981554489408202*^9, 
  3.9815544918623548`*^9}, {3.9815553122816033`*^9, 3.9815553187739773`*^9}, {
  3.98162519809888*^9, 3.981625198497386*^9}, {3.981712882016734*^9, 
  3.9817128824858103`*^9}},ExpressionUUID->"7a695c32-c120-4960-b93a-\
8d0b520e50f4"],

Cell["\<\
The Root Test data is set up in the following code and note how the lim Sup \
of points are tending to 1 as the points become closer to the y-axis.  This \
limiting case is the radius of convergence of the series.  Note in this case \
since expansion center is the origin, pSeries=aSeries.\
\>", "Text",
 CellChangeTimes->{
  3.987405595852831*^9},ExpressionUUID->"348d434a-5d58-4f1c-bc7c-\
08b1ef6f981a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"testSeries", "=", 
     RowBox[{"pSeries", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], ";"}], " ", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"expList", "=", 
     RowBox[{"Exponent", "[", 
      RowBox[{"testSeries", ",", "z", ",", "List"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"coefList", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Coefficient", "[", 
        RowBox[{"testSeries", ",", "z", ",", "#"}], "]"}], "&"}], "/@", " ", 
      "expList"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"theLCM", "=", 
     RowBox[{"LCM", "@@", 
      RowBox[{"(", 
       RowBox[{"Denominator", "@", "expList"}], ")"}]}]}], ";"}], "\n", " ", 
   RowBox[{"numerators", "=", 
    RowBox[{"theLCM", " ", "expList"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rootTestTable", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "/", 
          RowBox[{"numerators", "[", 
           RowBox[{"[", "k", "]"}], "]"}]}], ",", 
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{"1", "/", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{"coefList", "[", 
                RowBox[{"[", "k", "]"}], "]"}], "]"}], "^", 
              RowBox[{"(", 
               RowBox[{"4", "/", 
                RowBox[{"numerators", "[", 
                 RowBox[{"[", "k", "]"}], "]"}]}], ")"}]}], ")"}]}], ",", 
           "25"}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"k", ",", "15", ",", 
         RowBox[{"Length", "@", "coefList"}]}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"lp1", "=", 
    RowBox[{"ListPlot", "[", 
     RowBox[{"rootTestTable", ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"{", 
        RowBox[{"PointSize", "[", "0.005", "]"}], "}"}]}], ",", 
      RowBox[{"AxesOrigin", "->", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}]}]}], "]"}]}], 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.981625092081875*^9, 3.9816250931450453`*^9}},
 CellLabel->
  "In[287]:=",ExpressionUUID->"86621bdd-dc0a-4718-b60c-0ba339a5a99f"],

