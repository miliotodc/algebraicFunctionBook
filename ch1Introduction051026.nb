Cell[CellGroupData[{

Cell[" Section 1.5.2:  Create contour over imag surfaace", "Subsubsection",
 CellChangeTimes->{{3.981099736039405*^9, 3.9810997429943037`*^9}, 
   3.98129770046778*^9, {3.981653555648945*^9, 
   3.9816535765339785`*^9}},ExpressionUUID->"c4097c28-7f8b-4f46-b25a-\
77e1f2e49951"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"theFunction", "=", 
     RowBox[{
      RowBox[{"-", "z"}], "+", 
      RowBox[{"w", "^", "2"}]}]}], ";"}], "\n", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{"start", " ", "the", " ", "contour", " ", "at", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"1", "/", "2"}], " ", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"1", "/", "2"}], "]"}]}], ")"}]}], "\[IndentingNewLine]", 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"z0", "=", 
     RowBox[{
      RowBox[{"3", "/", "2"}], " ", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "Pi"}], "/", "2"}], " ", "I"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"w0", "=", 
     RowBox[{"-", 
      RowBox[{"Sqrt", "[", "z0", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{
    "revolve", " ", "around", " ", "the", " ", "branch", " ", "sheets", " ", 
     "4", " ", "Pi"}], "\[IndentingNewLine]", "*)"}], "\n", 
   RowBox[{
    RowBox[{"tStart", "=", 
     RowBox[{
      RowBox[{"-", "Pi"}], "/", "2"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"tEnd", "=", 
     RowBox[{"tStart", "+", 
      RowBox[{"4", "  ", "Pi"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{"create", " ", "z", 
     RowBox[{"(", "t", ")"}]}], "\[IndentingNewLine]", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Z", "[", "t_", "]"}], ":=", 
     RowBox[{
      RowBox[{"3", "/", "2"}], " ", 
      RowBox[{"Exp", "[", 
       RowBox[{"I", " ", "t"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{"solve", " ", "IVP"}], "\[IndentingNewLine]", "*)"}], "\n", 
   RowBox[{
    RowBox[{"wDeriv", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"w", "'"}], "[", "t", "]"}], "==", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"D", "[", 
              RowBox[{"theFunction", ",", "z"}], "]"}], "/", 
             RowBox[{"D", "[", 
              RowBox[{"theFunction", ",", "w"}], "]"}]}], ")"}]}], " ", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"Z", "[", "t", "]"}], ",", "t"}], "]"}]}], ")"}], "/.", 
        " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"w", "->", 
           RowBox[{"w", "[", "t", "]"}]}], ",", 
          RowBox[{"z", "->", 
           RowBox[{"Z", "[", "t", "]"}]}]}], "}"}]}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"theSol", "=", 
     RowBox[{"NDSolveValue", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"wDeriv", ",", 
         RowBox[{
          RowBox[{"w", "[", "tStart", "]"}], "==", "w0"}]}], "}"}], ",", "w", 
       ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "tStart", ",", "tEnd"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"mPlot", "=", 
     RowBox[{"ParametricPlot3D", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Re", "@", "z"}], ",", 
          RowBox[{"Im", "@", "z"}], ",", 
          RowBox[{"Im", "@", 
           RowBox[{"theSol", "[", "t", "]"}]}]}], "}"}], "/.", " ", 
        RowBox[{"z", "->", 
         RowBox[{"Z", "[", "t", "]"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", 
         RowBox[{"tStart", "+", "0.05"}], ",", 
         RowBox[{"tEnd", "-", "0.05"}]}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Thickness", "[", "0.005", "]"}], ",", "Black"}], "}"}]}]}],
       "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"startZ2", "=", 
     RowBox[{"Z", "[", "tStart", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"startZG2", "=", 
     RowBox[{"Graphics3D", "@", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"PointSize", "[", "0.025", "]"}], ",", "Green", ",", 
        RowBox[{"Point", "@", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Re", "@", "startZ2"}], ",", 
           RowBox[{"Im", "@", "startZ2"}], ",", 
           RowBox[{"-", 
            RowBox[{"Im", "@", 
             RowBox[{"Sqrt", "[", "startZ2", "]"}]}]}]}], "}"}]}]}], 
       "}"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"arrowPts2", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Re", "@", "z"}], ",", 
          RowBox[{"Im", "@", "z"}], ",", 
          RowBox[{"-", 
           RowBox[{"Im", "@", 
            RowBox[{"Sqrt", "[", "z", "]"}]}]}]}], "}"}], "/.", 
        RowBox[{"z", "->", 
         RowBox[{
          RowBox[{"3", "/", "2"}], 
          RowBox[{"Exp", "[", 
           RowBox[{"I", " ", "t"}], "]"}]}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", 
         RowBox[{"tEnd", "-", "1"}], ",", 
         RowBox[{"tEnd", "-", "0.05"}], ",", "0.01"}], "}"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"arrow3D2", "=", 
     RowBox[{"Graphics3D", "@", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Arrowheads", "[", "0.04", "]"}], ",", 
        RowBox[{"Arrow", "[", 
         RowBox[{"BezierCurve", "[", "arrowPts2", "]"}], "]"}]}], "}"}]}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"Show", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "imag1", ",", "imag2", ",", "mPlot", ",", "arrow3D2", ",", "startZG2"}],
       "}"}], ",", 
     RowBox[{"AxesEdge", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", 
          RowBox[{"-", "1"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"-", "1"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", 
          RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], ",", 
     RowBox[{"FaceGrids", "->", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", 
           RowBox[{"-", "1"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1"}], ",", 
             RowBox[{"-", "0.5"}], ",", "0", ",", "0.5", ",", "1"}], "}"}], 
           ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1"}], ",", 
             RowBox[{"-", "0.5"}], ",", "0", ",", "0.5", ",", "1"}], "}"}]}], 
          "}"}]}], "}"}], "}"}]}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{"\"\<x\>\"", ",", "14", ",", "Bold", ",", "Black"}], "]"}], 
        ",", 
        RowBox[{"Style", "[", 
         RowBox[{"\"\<y\>\"", ",", "14", ",", "Bold", ",", "Black"}], "]"}], 
        ",", 
        RowBox[{"Style", "[", 
         RowBox[{"\"\<Im(w)\>\"", ",", "14", ",", "Bold", ",", "Black"}], 
         "]"}]}], "}"}]}], ",", 
     RowBox[{"FaceGridsStyle", "->", 
      RowBox[{"Directive", "[", 
       RowBox[{"Black", ",", "Dotted"}], "]"}]}], ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"BoxRatios", "->", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "1", ",", " ", "1"}], "}"}]}]}], 
    "]"}]}]}]], "Input",
