Cell["\<\
Section 6.5:  Create a branch plot of the 5-cycle branch by manually \
conjugating a generator series\
\>", "Subsection",
 CellChangeTimes->{{3.9874090259926996`*^9, 3.9874090366083813`*^9}, {
  3.9874113935423317`*^9, 
  3.98741140182302*^9}},ExpressionUUID->"8dc69568-b889-4bbb-98d2-\
842f1c6dd5d1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
     "generate", " ", "branch", " ", "sheet", " ", "plot", " ", "of", " ", 
      "5"}], "-", 
     RowBox[{"cycle", " ", "branch"}]}], ",", " ", 
    RowBox[{
    "distance", " ", "to", " ", "nearest", " ", "singular", " ", "point", " ",
      "is", " ", "about", " ", "0.16", " ", "so", " ", "set", " ", "plot", 
     " ", "range", " ", "at", " ", "0.1"}]}], "\[IndentingNewLine]", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
