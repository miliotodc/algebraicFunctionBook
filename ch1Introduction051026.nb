Cell[CellGroupData[{

Cell["\<\
Section 6.7:  Create a contour around the 5-cycle branch and overlay over \
branch sheets\
\>", "Subsection",
 CellChangeTimes->{{3.987416410271784*^9, 
  3.9874164360697603`*^9}},ExpressionUUID->"048c963d-7a23-4223-bb4e-\
7dd8204af682"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{"create", " ", "contour", " ", "around", " ", "5"}], "-", 
    RowBox[{
    "cycle", " ", "branch", " ", "of", " ", "testCase0002", " ", "at", " ", 
     "the", " ", "origin"}]}], "\[IndentingNewLine]", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Z", "[", "t_", "]"}], ":=", 
     RowBox[{
      RowBox[{"1", "/", "20"}], " ", 
      RowBox[{"Exp", "[", 
       RowBox[{"I", " ", "t"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{"solve", " ", "IVP"}], "\[IndentingNewLine]", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{"start", " ", "the", " ", "contour", " ", "at", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"1", "/", "2"}], " ", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"1", "/", "2"}], "]"}]}], ")"}]}], "\[IndentingNewLine]", 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tStart", "=", 
     RowBox[{"Pi", "/", "6"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tEnd", "=", 
     RowBox[{"tStart", "+", 
      RowBox[{"10", "Pi"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"z0", "=", 
     RowBox[{"Z", "[", "tStart", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{"start", " ", "contour", " ", "on", " ", 
     RowBox[{"pSeries", "[", 
      RowBox[{"[", "12", "]"}], "]"}]}], "\[IndentingNewLine]", "*)"}], "\n", 
   RowBox[{
    RowBox[{"w0", "=", 
     RowBox[{
      RowBox[{"pSeries", "[", 
       RowBox[{"[", "12", "]"}], "]"}], "/.", 
      RowBox[{"z", "->", "z0"}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wDeriv", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"w", "'"}], "[", "t", "]"}], "==", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"D", "[", 
              RowBox[{"case0002F", ",", "z"}], "]"}], "/", 
             RowBox[{"D", "[", 
              RowBox[{"case0002F", ",", "w"}], "]"}]}], ")"}]}], " ", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"Z", "[", "t", "]"}], ",", "t"}], "]"}]}], ")"}], "/.", 
        " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"w", "->", 
           RowBox[{"w", "[", "t", "]"}]}], ",", 
          RowBox[{"z", "->", 
           RowBox[{"Z", "[", "t", "]"}]}]}], "}"}]}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"theSol", "=", 
     RowBox[{"NDSolveValue", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"wDeriv", ",", 
         RowBox[{
          RowBox[{"w", "[", "tStart", "]"}], "==", "w0"}]}], "}"}], ",", "w", 
       ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "tStart", ",", "tEnd"}], "}"}]}], "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"mPlot", "=", 
    RowBox[{"ParametricPlot3D", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Re", "@", "z"}], ",", 
         RowBox[{"Im", "@", "z"}], ",", 
         RowBox[{"Re", "@", 
          RowBox[{"theSol", "[", "t", "]"}]}]}], "}"}], "/.", " ", 
       RowBox[{"z", "->", 
        RowBox[{"Z", "[", "t", "]"}]}]}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", 
        RowBox[{"tStart", "+", "0.1"}], ",", 
        RowBox[{"tEnd", "-", "0.1"}]}], "}"}], ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Thickness", "[", "0.005", "]"}], ",", "Yellow"}], "}"}]}], 
      ",", 
      RowBox[{"BoxRatios", "->", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "1", ",", " ", "1"}], "}"}]}]}], "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Show", "[", 
    RowBox[{"{", 
     RowBox[{"conjPlots", ",", "mPlot"}], "}"}], "]"}], "\[IndentingNewLine]",
    "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.9816293904508348`*^9, 3.981629512593865*^9}, {
  3.981629551352441*^9, 3.981629647115848*^9}, {3.9874116189351625`*^9, 
  3.987411621262907*^9}},
 CellLabel->
