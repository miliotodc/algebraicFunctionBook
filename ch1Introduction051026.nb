Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{
   RowBox[{
    RowBox[{"theFunction", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"z", "^", "2"}]}], ")"}], "-", 
      RowBox[{"w", "^", "2"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{"create", " ", "z", 
     RowBox[{"(", "t", ")"}]}], "\[IndentingNewLine]", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Z", "[", "t_", "]"}], ":=", 
     RowBox[{
      RowBox[{"-", "1"}], "+", 
      RowBox[{
       RowBox[{"2", "/", "3"}], " ", 
       RowBox[{"Exp", "[", 
        RowBox[{"I", " ", "t"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{"solve", " ", "IVP"}], "\[IndentingNewLine]", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{"start", " ", "the", " ", "contour", " ", "at", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"1", "/", "2"}], " ", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"1", "/", "2"}], "]"}]}], ")"}]}], "\[IndentingNewLine]", 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tStart", "=", 
     RowBox[{"Pi", "/", "4"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tEnd", "=", 
     RowBox[{"tStart", "+", 
      RowBox[{"4", "Pi"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"z0", "=", 
     RowBox[{"Z", "[", "tStart", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"w0", "=", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"1", "-", 
       RowBox[{"z0", "^", "2"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wDeriv2", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"w", "'"}], "[", "t", "]"}], "==", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"D", "[", 
              RowBox[{"theFunction", ",", "z"}], "]"}], "/", 
             RowBox[{"D", "[", 
              RowBox[{"theFunction", ",", "w"}], "]"}]}], ")"}]}], " ", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"Z", "[", "t", "]"}], ",", "t"}], "]"}]}], ")"}], "/.", 
        " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"w", "->", 
           RowBox[{"w", "[", "t", "]"}]}], ",", 
          RowBox[{"z", "->", 
           RowBox[{"Z", "[", "t", "]"}]}]}], "}"}]}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"theSol2", "=", 
     RowBox[{"NDSolveValue", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"wDeriv2", ",", 
         RowBox[{
          RowBox[{"w", "[", "tStart", "]"}], "==", "w0"}]}], "}"}], ",", "w", 
       ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "tStart", ",", "tEnd"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"mPlot2", "=", 
     RowBox[{"ParametricPlot3D", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Re", "@", "z"}], ",", 
          RowBox[{"Im", "@", "z"}], ",", 
          RowBox[{"Re", "@", 
           RowBox[{"theSol2", "[", "t", "]"}]}]}], "}"}], "/.", " ", 
        RowBox[{"z", "->", 
         RowBox[{"Z", "[", "t", "]"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", 
         RowBox[{"tStart", "+", "0.1"}], ",", 
         RowBox[{"tEnd", "-", "0.1"}]}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Thickness", "[", "0.005", "]"}], ",", "Red"}], "}"}]}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"startZ3", "=", 
     RowBox[{"Z", "[", "tStart", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"startZG3", "=", 
     RowBox[{"Graphics3D", "@", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"PointSize", "[", "0.025", "]"}], ",", "Blue", ",", 
        RowBox[{"Point", "@", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Re", "@", "startZ3"}], ",", 
           RowBox[{"Im", "@", "startZ3"}], ",", 
           RowBox[{"Re", "@", 
            RowBox[{"Sqrt", "[", 
             RowBox[{"1", "-", 
              RowBox[{"startZ3", "^", "2"}]}], "]"}]}]}], "}"}]}]}], 
       "}"}]}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"arrowPts3", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Re", "@", "z"}], ",", 
          RowBox[{"Im", "@", "z"}], ",", 
          RowBox[{"Re", "@", 
           RowBox[{"theSol2", "[", "t", "]"}]}]}], "}"}], "/.", 
        RowBox[{"z", "->", 
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          RowBox[{
           RowBox[{"2", "/", "3"}], 
           RowBox[{"Exp", "[", 
            RowBox[{"I", " ", "t"}], "]"}]}]}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", 
         RowBox[{"Pi", "+", "1"}], ",", 
         RowBox[{"Pi", "+", "2"}], ",", "0.01"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"arrow3D3", "=", 
     RowBox[{"Graphics3D", "@", 
      RowBox[{"{", 
       RowBox[{"Thick", ",", "Red", ",", 
        RowBox[{"Arrowheads", "[", "0.04", "]"}], ",", 
        RowBox[{"Arrow", "[", 
         RowBox[{"BezierCurve", "[", "arrowPts3", "]"}], "]"}]}], "}"}]}]}], 
    ";"}], "\[IndentingNewLine]"}]}]], "Input",
