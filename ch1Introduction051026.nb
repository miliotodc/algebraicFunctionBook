Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"theFunction", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"z", "^", "2"}]}], ")"}], "-", 
      RowBox[{"w", "^", "2"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{"start", " ", "the", " ", "contour", " ", "at", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"1", "/", "2"}], " ", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"1", "/", "2"}], "]"}]}], ")"}]}], "\[IndentingNewLine]", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"z0", "=", 
     RowBox[{
      RowBox[{"3", "/", "2"}], " ", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"Pi", "/", "4"}], " ", "I"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"w0", "=", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"1", "-", 
       RowBox[{"z0", "^", "2"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{
    "revolve", " ", "around", " ", "the", " ", "branch", " ", "sheets", " ", 
     "4", " ", "Pi"}], "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tStart", "=", 
     RowBox[{"Pi", "/", "4"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"tEnd", "=", 
     RowBox[{"tStart", "+", 
      RowBox[{"2", "  ", "Pi"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{"create", " ", "z", 
     RowBox[{"(", "t", ")"}]}], "\[IndentingNewLine]", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Z", "[", "t_", "]"}], ":=", 
     RowBox[{
      RowBox[{"3", "/", "2"}], " ", 
      RowBox[{"Exp", "[", 
       RowBox[{"I", " ", "t"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{"(*", "\[IndentingNewLine]", " ", 
    RowBox[{"solve", " ", "IVP"}], "\[IndentingNewLine]", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wDeriv", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"w", "'"}], "[", "t", "]"}], "==", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"D", "[", 
              RowBox[{"theFunction", ",", "z"}], "]"}], "/", 
             RowBox[{"D", "[", 
              RowBox[{"theFunction", ",", "w"}], "]"}]}], ")"}]}], " ", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"Z", "[", "t", "]"}], ",", "t"}], "]"}]}], ")"}], "/.", 
        " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"w", "->", 
           RowBox[{"w", "[", "t", "]"}]}], ",", 
          RowBox[{"z", "->", 
           RowBox[{"Z", "[", "t", "]"}]}]}], "}"}]}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"theSol", "=", 
     RowBox[{"NDSolveValue", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"wDeriv", ",", 
         RowBox[{
          RowBox[{"w", "[", "tStart", "]"}], "==", "w0"}]}], "}"}], ",", "w", 
       ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "tStart", ",", "tEnd"}], "}"}]}], "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"mPlot", "=", 
     RowBox[{"ParametricPlot3D", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Re", "@", "z"}], ",", 
          RowBox[{"Im", "@", "z"}], ",", 
          RowBox[{"Re", "@", 
           RowBox[{"theSol", "[", "t", "]"}]}]}], "}"}], "/.", " ", 
        RowBox[{"z", "->", 
         RowBox[{"Z", "[", "t", "]"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", 
         RowBox[{"tStart", "+", "0.05"}], ",", 
         RowBox[{"tEnd", "-", "0.05"}]}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Thickness", "[", "0.005", "]"}], ",", "Blue"}], "}"}]}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"startZ2", "=", 
     RowBox[{"Z", "[", "tStart", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"startZG2", "=", 
     RowBox[{"Graphics3D", "@", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"PointSize", "[", "0.025", "]"}], ",", "Green", ",", 
        RowBox[{"Point", "@", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Re", "@", "startZ2"}], ",", 
           RowBox[{"Im", "@", "startZ2"}], ",", 
           RowBox[{"Re", "@", 
            RowBox[{"Sqrt", "[", 
             RowBox[{"1", "-", 
              RowBox[{"startZ2", "^", "2"}]}], "]"}]}]}], "}"}]}]}], 
       "}"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"arrowPts2", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Re", "@", "z"}], ",", 
          RowBox[{"Im", "@", "z"}], ",", 
          RowBox[{"Re", "@", 
           RowBox[{"Sqrt", "[", 
            RowBox[{"1", "-", 
             RowBox[{"z", "^", "2"}]}], "]"}]}]}], "}"}], "/.", 
        RowBox[{"z", "->", 
         RowBox[{
          RowBox[{"3", "/", "2"}], 
          RowBox[{"Exp", "[", 
           RowBox[{"I", " ", "t"}], "]"}]}]}]}], ",", 
