Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "  ", 
   RowBox[{"define", " ", "function"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"theConst", "=", 
     RowBox[{
      RowBox[{"2", "/", "3"}], "+", 
      RowBox[{"\[ImaginaryI]", "/", "4"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"function23", "=", 
     RowBox[{
      RowBox[{"z", " ", 
       RowBox[{"w", "^", "4"}], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"theConst", 
          RowBox[{"(", 
           RowBox[{"1", "-", 
            RowBox[{
             RowBox[{
              RowBox[{"theConst", "\[Conjugate]"}], "^", "2"}], " ", 
             RowBox[{"w", "^", "2"}]}]}], ")"}]}], ")"}], "^", "4"}]}], "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"theConst", "\[Conjugate]"}], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"theConst", "^", "2"}], "-", 
           RowBox[{"w", "^", "2"}]}], ")"}]}], ")"}], "^", "4"}]}]}], ";"}], 
   " ", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pSeries", "=", 
     RowBox[{"w", "/.", 
      RowBox[{"AsymptoticSolve", "[", 
       RowBox[{
        RowBox[{"function23", "==", "0"}], ",", "w", ",", 
        RowBox[{"{", 
         RowBox[{"z", ",", "0", ",", "30"}], "}"}]}], "]"}]}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9761804736419764`*^9, 3.976180501805928*^9}, {
  3.9783515025125303`*^9, 3.9783515067847133`*^9}, {3.9815307079111533`*^9, 
  3.9815307256113496`*^9}, {3.981540644034034*^9, 3.981540663822258*^9}, {
  3.9815529147603865`*^9, 3.981552959674613*^9}, {3.981712451959846*^9, 
  3.981712515462105*^9}},ExpressionUUID->"ac1141d5-9d5c-4a36-b9c3-\
8109047e7cf5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "finding", " ", "which", " ", "pSeries", " ", "corresponds", " ", "to", 
    " ", "which", " ", "root", " ", "of", " ", "f", 
    RowBox[{"(", 
     RowBox[{"z", ",", "w"}], ")"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  " ", 
  RowBox[{
   RowBox[{
    RowBox[{"zTest", "=", 
     RowBox[{
      RowBox[{"1", "/", "3"}], " ", 
      RowBox[{"Exp", "[", 
       RowBox[{"Pi", " ", 
        RowBox[{"I", "/", "6"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"pResults", "=", 
    RowBox[{
     RowBox[{"pSeries", "/.", 
      RowBox[{"z", "->", "zTest"}]}], "//", "N"}]}], "\[IndentingNewLine]", 
   RowBox[{"wVals", "=", 
    RowBox[{"NSolveValues", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"function23", "==", "0"}], "/.", 
       RowBox[{"z", "->", "zTest"}]}], ",", "w"}], "]"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rootIndex", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"difTable", "=", 
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "-", 
         RowBox[{"wVals", "[", 
          RowBox[{"[", "rootIndex", "]"}], "]"}]}], "&"}], "/@", " ", 
       "pResults"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pos", "=", 
     RowBox[{
      RowBox[{"Position", "[", 
       RowBox[{"difTable", ",", 
        RowBox[{"Min", "@", "difTable"}]}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{
    "\"\<Root index \>\"", ",", "rootIndex", ",", 
     "\"\< is associated with expansion \>\"", ",", "pos"}], "]"}], 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.9761804736419764`*^9, 3.976180501805928*^9}, {
