Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"c1", "=", 
     RowBox[{"ParametricPlot3D", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Re", "@", "z"}], ",", 
          RowBox[{"Im", "@", "z"}], ",", 
          RowBox[{"Re", "@", 
           RowBox[{"theF", "[", "z", "]"}]}]}], "}"}], "/.", 
        RowBox[{"z", "->", 
         RowBox[{
          RowBox[{"3", "/", "2"}], " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"I", " ", "t"}], "]"}]}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", 
         RowBox[{
          RowBox[{"Pi", "/", "4"}], "+", "0.05"}], ",", 
         RowBox[{
          RowBox[{"9", 
           RowBox[{"Pi", "/", "4"}]}], "-", "0.05"}]}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", "Black"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"theZ", "[", "t_", "]"}], ":=", 
     RowBox[{
      RowBox[{"3", "/", "2"}], " ", 
      RowBox[{"Exp", "[", 
       RowBox[{"I", " ", "t"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"startZ2", "=", 
     RowBox[{"Z", "[", 
      RowBox[{"Pi", "/", "4"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tStart", "=", 
     RowBox[{"Pi", "/", "4"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tEnd", "=", 
     RowBox[{"tStart", "+", 
      RowBox[{"2", " ", "Pi"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"startZG2", "=", 
     RowBox[{"Graphics3D", "@", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"PointSize", "[", "0.025", "]"}], ",", "Green", ",", 
        RowBox[{"Point", "@", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Re", "@", "startZ2"}], ",", 
           RowBox[{"Im", "@", "startZ2"}], ",", 
           RowBox[{"Re", "@", 
            RowBox[{"Sqrt", "[", 
             RowBox[{"1", "-", 
              RowBox[{"startZ2", "^", "2"}]}], "]"}]}]}], "}"}]}]}], 
       "}"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"arrowPts2", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Re", "@", "z"}], ",", 
          RowBox[{"Im", "@", "z"}], ",", 
          RowBox[{"Re", "@", 
           RowBox[{"Sqrt", "[", 
            RowBox[{"1", "-", 
             RowBox[{"z", "^", "2"}]}], "]"}]}]}], "}"}], "/.", 
        RowBox[{"z", "->", 
         RowBox[{
          RowBox[{"3", "/", "2"}], 
          RowBox[{"Exp", "[", 
           RowBox[{"I", " ", "t"}], "]"}]}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", 
         RowBox[{"tStart", "+", "0.2"}], ",", 
         RowBox[{"tStart", "+", 
          RowBox[{"Pi", "/", "4"}]}], ",", "0.01"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"arrow3D2", "=", 
     RowBox[{"Graphics3D", "@", 
      RowBox[{"{", 
       RowBox[{"Thick", ",", 
        RowBox[{"Arrowheads", "[", "0.04", "]"}], ",", 
        RowBox[{"Arrow", "[", 
         RowBox[{"BezierCurve", "[", "arrowPts2", "]"}], "]"}]}], "}"}]}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Show", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"p1", ",", "p2"}], "}"}], ",", 
     RowBox[{"PlotRange", "->", "All"}]}], "]"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Show", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"p1", ",", "p2", ",", "c1", ",", "startZG2", ",", "arrow3D2"}], 
      "}"}], ",", 
     RowBox[{"PlotRange", "->", "2.2"}], ",", 
     RowBox[{"ImageSize", "->", "300"}], ",", 
     RowBox[{"ViewPoint", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"1.8027796685821182`", ",", 
        RowBox[{"-", "2.233730535848765`"}], ",", "1.7917682215520347`"}], 
       "}"}]}]}], "]"}]}]}]], "Input",
