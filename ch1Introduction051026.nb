 RowBox[{" ", 
  RowBox[{
   RowBox[{"testSeries", "=", 
    RowBox[{"pSeries", "[", 
     RowBox[{"[", "1", "]"}], "]"}]}], ";"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"expList", "=", 
