Cell[CellGroupData[{

Cell["\<\
Section 1.5:  Creating analytically-continuous contour over z^{1/2}\
\>", "Subsection",
 CellChangeTimes->{{3.972747243051778*^9, 3.9727472645104938`*^9}, {
  3.975861471911723*^9, 3.97586147446621*^9}, {3.975861694143978*^9, 
  3.9758617013677883`*^9}, {3.97616517212846*^9, 3.9761651802654734`*^9}, {
  3.976176640846918*^9, 3.9761766577706914`*^9}, {3.978351312028084*^9, 
  3.9783513181188107`*^9}, {3.9810975757235136`*^9, 3.981097588978243*^9}, {
  3.9810976994934196`*^9, 3.981097700322856*^9}, {3.9810986877548046`*^9, 
  3.981098692088911*^9}, {3.981653367004427*^9, 3.9816533861989126`*^9}, {
  3.9816534844663486`*^9, 
  3.98165351596832*^9}},ExpressionUUID->"3b242734-1aab-4224-bbe5-\
0e8ce8c7ad50"],

Cell[CellGroupData[{

Cell["Section 1.5.1:  Create contour over real surface", "Subsubsection",
 CellChangeTimes->{{3.9816535224166703`*^9, 3.9816535322080584`*^9}, 
   3.9816535635263014`*^9},ExpressionUUID->"576edc9d-9c54-4807-86aa-\
4b1be144af36"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"theFunction", "=", 
    RowBox[{
     RowBox[{"-", "z"}], "+", 
     RowBox[{"w", "^", "2"}]}]}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{"start", " ", "the", " ", "contour", " ", "at", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"1", "/", "2"}], " ", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"1", "/", "2"}], "]"}]}], ")"}]}], "\[IndentingNewLine]", 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"z0", "=", 
   RowBox[{
    RowBox[{"3", "/", "2"}], " ", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "Pi"}], "/", "2"}], " ", "I"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"w0", "=", 
    RowBox[{"-", 
     RowBox[{"Sqrt", "[", "z0", "]"}]}]}], ";"}], "\n", 
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
   "revolve", " ", "around", " ", "the", " ", "branch", " ", "sheets", " ", 
    "4", " ", "Pi"}], "\[IndentingNewLine]", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tStart", "=", 
   RowBox[{
    RowBox[{"-", "Pi"}], "/", "2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"tEnd", "=", 
    RowBox[{"tStart", "+", 
     RowBox[{"4", "  ", "Pi"}]}]}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{"create", " ", "z", 
    RowBox[{"(", "t", ")"}]}], "\[IndentingNewLine]", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Z", "[", "t_", "]"}], ":=", 
    RowBox[{
     RowBox[{"3", "/", "2"}], " ", 
     RowBox[{"Exp", "[", 
      RowBox[{"I", " ", "t"}], "]"}]}]}], ";"}], "\n", 
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{"solve", " ", "IVP"}], "\[IndentingNewLine]", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"wDeriv", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"w", "'"}], "[", "t", "]"}], "==", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{"theFunction", ",", "z"}], "]"}], "/", 
           RowBox[{"D", "[", 
            RowBox[{"theFunction", ",", "w"}], "]"}]}], ")"}]}], " ", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"Z", "[", "t", "]"}], ",", "t"}], "]"}]}], ")"}], "/.", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"w", "->", 
         RowBox[{"w", "[", "t", "]"}]}], ",", 
        RowBox[{"z", "->", 
         RowBox[{"Z", "[", "t", "]"}]}]}], "}"}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"theSol", "=", 
    RowBox[{"NDSolveValue", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"wDeriv", ",", 
        RowBox[{
         RowBox[{"w", "[", "tStart", "]"}], "==", "w0"}]}], "}"}], ",", "w", 
      ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "tStart", ",", "tEnd"}], "}"}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"mPlot", "=", 
    RowBox[{"ParametricPlot3D", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Re", "@", "z"}], ",", 
         RowBox[{"Im", "@", "z"}], ",", 
         RowBox[{"Re", "@", 
          RowBox[{"theSol", "[", "t", "]"}]}]}], "}"}], "/.", " ", 
       RowBox[{"z", "->", 
        RowBox[{"Z", "[", "t", "]"}]}]}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", 
        RowBox[{"tStart", "+", "0.05"}], ",", 
        RowBox[{"tEnd", "-", "0.05"}]}], "}"}], ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Thickness", "[", "0.005", "]"}], ",", "Black"}], "}"}]}]}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"startZ2", "=", 
   RowBox[{"Z", "[", "tStart", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"startZG2", "=", 
   RowBox[{"Graphics3D", "@", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"PointSize", "[", "0.025", "]"}], ",", "Green", ",", 
      RowBox[{"Point", "@", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Re", "@", "startZ2"}], ",", 
         RowBox[{"Im", "@", "startZ2"}], ",", 
         RowBox[{"-", 
          RowBox[{"Re", "@", 
           RowBox[{"Sqrt", "[", "startZ2", "]"}]}]}]}], "}"}]}]}], "}"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"arrowPts2", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Re", "@", "z"}], ",", 
        RowBox[{"Im", "@", "z"}], ",", 
        RowBox[{"-", 
         RowBox[{"Re", "@", 
          RowBox[{"Sqrt", "[", "z", "]"}]}]}]}], "}"}], "/.", 
      RowBox[{"z", "->", 
       RowBox[{
        RowBox[{"3", "/", "2"}], 
        RowBox[{"Exp", "[", 
         RowBox[{"I", " ", "t"}], "]"}]}]}]}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", 
       RowBox[{"tEnd", "-", "1"}], ",", 
       RowBox[{"tEnd", "-", "0.05"}], ",", "0.01"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"arrow3D2", "=", 
    RowBox[{"Graphics3D", "@", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Arrowheads", "[", "0.04", "]"}], ",", 
       RowBox[{"Arrow", "[", 
        RowBox[{"BezierCurve", "[", "arrowPts2", "]"}], "]"}]}], "}"}]}]}], 
   ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]",
   "\[IndentingNewLine]", "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
    "real1", ",", "real2", ",", "mPlot", ",", "arrow3D2", ",", "startZG2"}], 
    "}"}], ",", 
   RowBox[{"AxesEdge", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", 
        RowBox[{"-", "1"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", 
        RowBox[{"-", "1"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", 
        RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], ",", 
   RowBox[{"FaceGrids", "->", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", 
         RowBox[{"-", "1"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", 
           RowBox[{"-", "0.5"}], ",", "0", ",", "0.5", ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", 
           RowBox[{"-", "0.5"}], ",", "0", ",", "0.5", ",", "1"}], "}"}]}], 
        "}"}]}], "}"}], "}"}]}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Style", "[", 
       RowBox[{"\"\<x\>\"", ",", "14", ",", "Bold", ",", "Black"}], "]"}], 
      ",", 
      RowBox[{"Style", "[", 
       RowBox[{"\"\<y\>\"", ",", "14", ",", "Bold", ",", "Black"}], "]"}], 
      ",", 
      RowBox[{"Style", "[", 
       RowBox[{"\"\<Re(w)\>\"", ",", "14", ",", "Bold", ",", "Black"}], 
       "]"}]}], "}"}]}], ",", 
   RowBox[{"FaceGridsStyle", "->", 
    RowBox[{"Directive", "[", 
     RowBox[{"Black", ",", "Dotted"}], "]"}]}], ",", 
   RowBox[{"PlotRange", "->", "All"}], ",", 
   RowBox[{"BoxRatios", "->", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "1", ",", " ", "1"}], "}"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9513218377657285`*^9, 3.9513218377657285`*^9}, {
