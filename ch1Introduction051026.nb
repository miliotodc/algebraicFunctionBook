Cell[CellGroupData[{

Cell["Create real sheets", "Subsubsection",
 CellChangeTimes->{{3.9816528138934307`*^9, 
  3.9816528238854284`*^9}},ExpressionUUID->"6d377134-2097-4b5d-9068-\
6deacfdc5402"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"real1", "=", " ", 
     RowBox[{"ParametricPlot3D", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Re", "@", "z"}], ",", 
          RowBox[{"Im", "@", "z"}], ",", 
          RowBox[{"Re", "[", 
           RowBox[{"f1", "[", "z", "]"}], "]"}]}], "}"}], "/.", 
        RowBox[{"z", "->", 
         RowBox[{"r", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"I", " ", "t"}], "]"}]}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", "0", ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", 
         RowBox[{"-", "Pi"}], ",", "Pi"}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Opacity", "[", "0.3", "]"}], ",", "Blue"}], "}"}]}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"real2", "=", " ", 
     RowBox[{"ParametricPlot3D", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Re", "@", "z"}], ",", 
          RowBox[{"Im", "@", "z"}], ",", 
          RowBox[{"-", 
           RowBox[{"Re", "[", 
            RowBox[{"z", "^", 
             RowBox[{"{", 
              RowBox[{"1", "/", "2"}], "}"}]}], "]"}]}]}], "}"}], "/.", 
        RowBox[{"z", "->", 
         RowBox[{"r", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"I", " ", "t"}], "]"}]}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", "0", ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", 
         RowBox[{"-", "Pi"}], ",", "Pi"}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Opacity", "[", "0.3", "]"}], ",", "Red"}], "}"}]}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", " ", 
   RowBox[{"Show", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"real1", ",", "real2"}], "}"}], ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"AxesEdge", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", 
          RowBox[{"-", "1"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"-", "1"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", 
          RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], ",", 
     RowBox[{"FaceGrids", "->", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", 
           RowBox[{"-", "1"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1"}], ",", 
             RowBox[{"-", "0.5"}], ",", "0", ",", "0.5", ",", "1"}], "}"}], 
           ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1"}], ",", 
             RowBox[{"-", "0.5"}], ",", "0", ",", "0.5", ",", "1"}], "}"}]}], 
          "}"}]}], "}"}], "}"}]}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{"\"\<x\>\"", ",", "14", ",", "Bold", ",", "Black"}], "]"}], 
        ",", 
        RowBox[{"Style", "[", 
         RowBox[{"\"\<y\>\"", ",", "14", ",", "Bold", ",", "Black"}], "]"}], 
        ",", 
        RowBox[{"Style", "[", 
         RowBox[{"\"\<Re(w)\>\"", ",", "14", ",", "Bold", ",", "Black"}], 
         "]"}]}], "}"}]}], ",", 
