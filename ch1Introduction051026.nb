 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
   "determine", " ", "the", " ", "cycle", " ", "size", " ", "as", " ", "the", 
    " ", "smallest", " ", "number", " ", "divisible", " ", "by", " ", "all", 
    " ", "denominators", " ", "of", " ", "powers", " ", "of", " ", "z"}], " ",
    "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"pIndex", "=", "2"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"cycleF", "[", "z_", "]"}], "=", " ", 
     RowBox[{"pSeries", "[", 
      RowBox[{"[", "pIndex", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"eList", "=", 
    RowBox[{"Exponent", "[", 
     RowBox[{
      RowBox[{"cycleF", "[", "z", "]"}], ",", "z", ",", "List"}], "]"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{"theCycleSize", "=", 
    RowBox[{"LCM", "@@", 
     RowBox[{"(", 
      RowBox[{"Denominator", "@", "eList"}], ")"}]}]}]}]}]], "Input",
