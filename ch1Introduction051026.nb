Cell[CellGroupData[{

Cell["\<\
Section 5.2:  Conjugate a series manually and identify it in the list of \
AsymptoticSolve series\
\>", "Subsection",
 CellChangeTimes->{{3.981554465443387*^9, 3.981554472108848*^9}, {
  3.9815552658313723`*^9, 3.9815552936745605`*^9}, {3.9816240144087324`*^9, 
  3.9816240162696915`*^9}, {3.9817128784532967`*^9, 
  3.981712879348279*^9}},ExpressionUUID->"47ae8f4b-48f4-4487-b4be-\
da7b761a6cbc"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"theConst", "=", 
   RowBox[{
    RowBox[{"2", "/", "3"}], "+", 
    RowBox[{"\[ImaginaryI]", "/", "4"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"tempF", "=", 
    RowBox[{
     RowBox[{"z", " ", 
      RowBox[{"w", "^", "4"}], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"theConst", 
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{
            RowBox[{
             RowBox[{"theConst", "\[Conjugate]"}], "^", "2"}], " ", 
            RowBox[{"w", "^", "2"}]}]}], ")"}]}], ")"}], "^", "4"}]}], "-", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"theConst", "\[Conjugate]"}], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"theConst", "^", "2"}], "-", 
          RowBox[{"w", "^", "2"}]}], ")"}]}], ")"}], "^", "4"}]}]}], ";"}], 
  " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pSeries2", "=", 
   RowBox[{"w", "/.", 
    RowBox[{"AsymptoticSolve", "[", 
     RowBox[{
      RowBox[{"tempF", "==", "0"}], ",", "w", ",", 
      RowBox[{"{", 
       RowBox[{"z", ",", "0", ",", "2"}], "}"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"expList", "=", 
  RowBox[{"Exponent", "[", 
   RowBox[{
    RowBox[{"pSeries2", "[", 
     RowBox[{"[", "1", "]"}], "]"}], ",", "z", ",", "List"}], "]"}]}], "\n", 
 RowBox[{
  RowBox[{"coefList", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Coefficient", "[", 
      RowBox[{
       RowBox[{"pSeries2", "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", "z", ",", "#"}], "]"}], "&"}], "/@",
     "expList"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"theN", "=", "2"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"conjSeries", "=", 
   RowBox[{
    RowBox[{"Plus", " ", "@@", 
     RowBox[{"MapThread", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"#1", " ", 
         RowBox[{"z", "^", "#2"}], " ", 
         RowBox[{"Exp", "[", 
          RowBox[{"2", " ", "theN", " ", "Pi", " ", "I", " ", "#2"}], "]"}]}],
         "&"}], ",", 
       RowBox[{"{", 
        RowBox[{"coefList", ",", "expList"}], "}"}]}], "]"}]}], "//", "N"}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{"Style", "[", 
  RowBox[{"conjSeries", ",", "10"}], "]"}]}], "Input",
 CellChangeTimes->{{3.9815536763496084`*^9, 3.981553773908063*^9}, {
  3.981553864918575*^9, 3.981553890605504*^9}, {3.9815539284036307`*^9, 
  3.981553965648175*^9}, {3.9815540015184703`*^9, 3.981554041066123*^9}, {
  3.981554171187539*^9, 3.981554171798453*^9}, {3.981556453872609*^9, 
  3.9815564587449026`*^9}},
 CellLabel->
  "In[293]:=",ExpressionUUID->"f250f1a5-f23f-4d12-9346-1bef11706802"],

