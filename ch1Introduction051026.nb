Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "use", " ", "NMinimize", " ", "to", " ", "construct", " ", "lim", " ", 
    "inf", " ", "curve", " ", "and", " ", "estimate", " ", "R"}], " ", "*)"}],
   "\[IndentingNewLine]", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"dataVals", "=", 
     RowBox[{"rootTestTable", "[", 
      RowBox[{"[", 
       RowBox[{"5", ";;"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"plotXStart", "=", 
