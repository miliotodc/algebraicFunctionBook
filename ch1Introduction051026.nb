Cell[CellGroupData[{

Cell["Section 3.1:  Absolute  and relative study of (1-z^2)-w^2", "Subsection",
 CellChangeTimes->{{3.981543894945816*^9, 3.981543908586727*^9}, {
  3.9817090826728497`*^9, 
  3.9817090828645477`*^9}},ExpressionUUID->"e7132cbc-2ccc-40e8-a82d-\
082c7276692e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{"define", " ", "function"}], "\[IndentingNewLine]", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"theFunction", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"z", "^", "2"}]}], ")"}], "-", 
      RowBox[{"w", "^", "2"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "aSeries", " ", "is", " ", "in", " ", "terms", " ", "of", " ", "absolute",
      " ", "coordinate", " ", "z"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"aSeries", "=", 
     RowBox[{"w", "/.", 
      RowBox[{"AsymptoticSolve", "[", 
       RowBox[{
        RowBox[{"theFunction", "==", "0"}], ",", "w", ",", 
        RowBox[{"{", 
         RowBox[{"z", ",", "1", ",", "100"}], "}"}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"aSeries", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", 
       RowBox[{"1", ";;", "5"}]}], "]"}], "]"}], "//", "N"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"zTest", "=", 
     RowBox[{"1", "+", 
      RowBox[{
       RowBox[{"3", "/", "2"}], " ", 
       RowBox[{"Exp", "[", 
        RowBox[{"Pi", " ", 
         RowBox[{"I", "/", "6"}]}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"zTest", "=", 
     RowBox[{"5", "/", "2"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<aSeries vals: \>\"", ",", 
     RowBox[{"Sort", "[", 
      RowBox[{
       RowBox[{"aSeries", "/.", 
        RowBox[{"z", "->", "zTest"}]}], "//", "N"}], "]"}]}], "]"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wVals", "=", 
     RowBox[{"NSolveValues", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"theFunction", "==", "0"}], "/.", 
        RowBox[{"z", "->", "zTest"}]}], ",", "w"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Roots: \>\"", ",", 
      RowBox[{"wVals", "//", "N"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "now", " ", "simulate", " ", "a", " ", "relative", " ", "power", " ", 
     "expansion", " ", "computed", " ", "by", " ", "Newton", " ", "polygons", 
     " ", "and", " ", 
     RowBox[{"Laurent", "'"}], "s", " ", "theorem"}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pSeries", "=", 
     RowBox[{"aSeries", "/.", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "z"}], ")"}], "->", "z"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pSeries", "[", 
     RowBox[{"[", 
      RowBox[{"1", ",", 
       RowBox[{"1", ";;", "5"}]}], "]"}], "]"}], "//", "N"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"zr", "=", 
     RowBox[{"zTest", "-", "1"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<pSeries vals: \>\"", ",", 
     RowBox[{"Sort", "[", 
      RowBox[{
       RowBox[{"pSeries", "/.", 
        RowBox[{"z", "->", "zr"}]}], "//", "N"}], "]"}]}], "]"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.9815306850562077`*^9, 3.981530699621853*^9}, {
  3.981530746647708*^9, 3.9815308574205317`*^9}, {3.981530920737583*^9, 
